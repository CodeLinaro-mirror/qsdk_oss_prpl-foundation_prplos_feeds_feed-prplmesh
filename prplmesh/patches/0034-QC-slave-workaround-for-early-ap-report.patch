From 463d4df438d4296ae9f4d5824c28f253d2851580 Mon Sep 17 00:00:00 2001
From: Praveen Babu <pravbabu@qti.qualcomm.com>
Date: Tue, 24 Jun 2025 20:20:13 +0530
Subject: [PATCH] QC-slave-workaround-for-early-ap-report

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 320b5eb9a..9cc27f6b8 100755
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -1059,10 +1059,10 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_response(
     // We are sending the search message multiple times to support diffrent Profiles Controllers.
     // As a result we might get several responses. If we already completed the discovery return
     // right away to prevent redundant processing and log printing.
-    auto discovery_status_it = m_discovery_status.find(freq_type);
+    /* auto discovery_status_it = m_discovery_status.find(freq_type);
     if (discovery_status_it != m_discovery_status.end() && discovery_status_it->second.completed) {
         return;
-    }
+    } */
     m_discovery_status[freq_type].completed = true;
 
     LOG(DEBUG) << "received ap_autoconfiguration response for " << band_name << " band";
-- 
2.34.1

