From 654be8e39772602e2119defb2738ad4f8e332dbd Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Sun, 26 Oct 2025 14:47:10 +0530
Subject: [PATCH] [NL HAL] Adopting to not remove primary bss of a radio as
 host support is not available

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 52 ++++++++++++++-----
 .../bwl/nl80211/base_wlan_hal_nl80211.cpp     | 15 ++++--
 2 files changed, 49 insertions(+), 18 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 25b8ff1fa..299eaea72 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1482,6 +1482,13 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 if (bss_it.teardown) {
                     // BSS is flagged for teardown
                     LOG(DEBUG) << "Disabling VAP " << vap_id;
+                    if (m_radio_info.iface_name == vap_info.bss) {
+                        //CR 4331885 Removing bss[0] is bringing down all vaps in that radio
+                        // After having above CR fixed, rename the bss[1] section as interface in hostapd.conf
+                        LOG(ERROR) << "Can't remove management vap which is bss[0]";
+                        continue;
+                    }
+
                     conf.remove_bss_config(vap_id);
                 } else {
 
@@ -1539,12 +1546,22 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                             LOG(WARNING) << "num_links not found or empty in result";
                         }
                         if (bss_it.teardown) {
+                            LOG(DEBUG) << "m_radio_info.iface_name : " << m_radio_info.iface_name << " vap_info.bss: " << vap_info.bss;
+                            if (m_radio_info.iface_name == vap_info.bss) {
+                                //CR 4331885 Removing bss[0] is bringing down all vaps in that radio
+                                LOG(ERROR) << "Can't remove management vap which is bss[0]";
+                                continue;
+                            }
                             if (links_present > 1) {
                                 LOG(ERROR) << "Hit remove link " << bss_it.bssid;
+                                // Check if mld link to be removed is not management vap link
                                 remove_mld_link(vap_info.bss, bss_it.bssid);
                             } else {
-                                LOG(ERROR) << "Hit remove bss " << bss_it.bssid;
-                                remove_bss(vap_info.bss, bss_it.bssid);
+                                // To check if bss to be removed is not bss[0] or base vap of that radio
+                                std::string base_iface;
+                                extractLinkBaseInterface(vap_info.bss, base_iface);
+                                LOG(ERROR) << "Hit remove bss. BSSID: " << bss_it.bssid << " BSS name: " << base_iface;
+                                remove_bss(base_iface);
                             }
                         } else {
                             if(links_present > 1)
@@ -2315,35 +2332,44 @@ int ap_wlan_hal_nl80211::add_bss(std::string &ifname, son::wireless_utils::sBssI
 }
 
 bool ap_wlan_hal_nl80211::remove_mld_link(std::string &link_iface_name, sMacAddr &link_mac) {
+    std::string link_mac_string = tlvf::mac_to_string(link_mac);
+
+    if (link_iface_name.empty() || (link_mac_string == "00:00:00:00:00:00")) {
+        LOG(ERROR) << __func__ << ": Invalid arguments"; 
+        return false;
+    }
+/* For sanity check to remove link : Start */
     int8_t link_id = -1;
     std::string base_iface;
     extractLinkBaseInterface(link_iface_name, base_iface);
-    std::string link_mac_string;
     LOG(DEBUG) << "Base iface " << base_iface ;
-    link_mac_string = tlvf::mac_to_string(link_mac);
+
     if (!m_nl80211_client->get_bss_link_id(base_iface, link_mac_string, link_id)) {
         LOG(ERROR) << " get_bss_link_id failed " ;
         return false;
     }
-    LOG(DEBUG) << "link id " << link_id;
+    // base_iface will be again populated with link_iface_name
+    if (base_iface.compare(link_iface_name) == 0) {
+        LOG(DEBUG) << "Valid link to remove :" << link_iface_name;
+    } else {
+        LOG(ERROR) << "Not a valid link to remove: " << link_iface_name;
+        return false;
+    }
+/* For sanity check to remove link : End */
+
     std::stringstream remove_cmd;
-    remove_cmd << "LINK_REMOVE -l " << static_cast<int>(link_id);
+    remove_cmd << "LINK_REMOVE 45";
     LOG(DEBUG) << "CMD framed : " << remove_cmd.str();
-    if (!wpa_ctrl_send_msg(remove_cmd.str(), base_iface)) {
-        LOG(ERROR) << "Failed to remove link: " << link_id << " of " <<base_iface;
+    if (!wpa_ctrl_send_msg(remove_cmd.str(), link_iface_name)) {
+        LOG(ERROR) << "Failed to remove link: " << link_id << " of " << link_iface_name;
         return false;
     }
     // remove the fd for this link iface
     base_wlan_hal_nl80211::remove_interface(link_iface_name);
-    base_wlan_hal_nl80211::remove_interface(base_iface);
     return true;
 
 }
 
-bool ap_wlan_hal_nl80211::remove_bss(std::string &iface_name, sMacAddr &iface_mac) {
-	return true;
-}
-
 bool ap_wlan_hal_nl80211::add_mld_link(std::string &new_iface,std::string &prev_iface,son::wireless_utils::sBssInfoConf &bss_conf,
                                        std::string bridge)
 {
diff --git a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
index 7d8f8909c..5debfa5e0 100644
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -1284,15 +1284,20 @@ int base_wlan_hal_nl80211::add_interface(const std::string &interface)
         return beerocks::net::FileDescriptor::invalid_descriptor;
     }
 
+    std::string base_iface_name;
+
+    extractLinkBaseInterface(interface, base_iface_name);
+
+    LOG(DEBUG) << "Interface :" << interface << " base_iface_name: " << base_iface_name;
     // get vap interface index if not yet retrieved
-    if (m_iface_index.find(interface) == m_iface_index.end()) {
-        int iface_index = if_nametoindex(interface.c_str());
-        if ((iface_index == 0) && (interface.find("_link") == std::string::npos)) {
-            LOG(ERROR) << "Failed reading the index of interface " << interface << ": "
+    if (m_iface_index.find(base_iface_name) == m_iface_index.end()) {
+        int iface_index = if_nametoindex(base_iface_name.c_str());
+        if (iface_index == 0) {
+            LOG(ERROR) << "Failed reading the index of interface " << base_iface_name  << ": "
                        << strerror(errno);
             return beerocks::net::FileDescriptor::invalid_descriptor;
         }
-        m_iface_index.emplace(interface, iface_index);
+        m_iface_index.emplace(base_iface_name, iface_index);
     }
 
     return event_socket->fd();
-- 
2.34.1

