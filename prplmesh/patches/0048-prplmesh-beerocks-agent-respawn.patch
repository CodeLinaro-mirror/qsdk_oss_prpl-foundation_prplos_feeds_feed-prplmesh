From 3351d9612ad9154ff73d84c632b404cb5b2f0e6a Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Thu, 28 Aug 2025 11:02:00 +0530
Subject: [PATCH] Prplmesh beerocks-agent respawn logic

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 common/beerocks/scripts/prplmesh_utils.sh.in | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/common/beerocks/scripts/prplmesh_utils.sh.in b/common/beerocks/scripts/prplmesh_utils.sh.in
index afc81d130..0c740436c 100755
--- a/common/beerocks/scripts/prplmesh_utils.sh.in
+++ b/common/beerocks/scripts/prplmesh_utils.sh.in
@@ -232,18 +232,18 @@ start_function() {
         CA | ca)
             prplmesh_platform_db_init "Multi-AP-Controller-and-Agent"
             prplmesh_controller_start
-            prplmesh_agent_start
+            /etc/init.d/prplmesh-agent start
             prplmesh_vendor_message_start
             ;;
         C | c)
             prplmesh_platform_db_init "Multi-AP-Controller"
             prplmesh_controller_start
             # Dummy agent configures transport layer
-            prplmesh_agent_start
+            /etc/init.d/prplmesh-agent start
             ;;
         A | a)
             prplmesh_platform_db_init "Multi-AP-Agent" "WDS-Repeater"
-            prplmesh_agent_start
+            /etc/init.d/prplmesh-agent start
             prplmesh_vendor_message_start
             ;;
         * ) err "unsupported mode: $PRPLMESH_MODE"; usage; exit 1 ;;
@@ -256,7 +256,7 @@ stop_function() {
 
     # shellcheck disable=SC2050
     [ "@BWL_TYPE@" = "DUMMY" ] && [ "$PLATFORM_INIT" = "true" ] && platform_deinit
-    prplmesh_agent_stop
+    /etc/init.d/prplmesh-agent stop
     prplmesh_controller_stop
     prplmesh_framework_deinit
     prplmesh_vendor_message_stop
@@ -352,7 +352,7 @@ status_function() {
         [ -L "$main_agent_log" ] || return
 
         grep -q "[^[:print:]]" "$main_agent_log" && err "$main_agent_log contains non-printable characters!"
-	radios=$(grep -a 'fronthaul_iface=' "$main_agent_log" | head -n 3 | sed -n 's/.*fronthaul_iface=\([^ ]*\).*/\1/p')
+	    radios=$(grep -a 'fronthaul_iface=' "$main_agent_log" | head -n 3 | sed -n 's/.*fronthaul_iface=\([^ ]*\).*/\1/p')
         for radio in $radios ; do
             report "$radio radio agent operational" radio_agent_operational "$LOGS_PATH" "$radio"
         done
-- 
