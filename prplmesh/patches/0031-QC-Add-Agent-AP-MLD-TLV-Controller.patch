+bool Controller::add_agent_ap_mld_configuration_tlv(ieee1905_1::CmduMessageTx &cmdu_tx, std::shared_ptr<Agent> &agent)
+{
+    auto agent_ap_mld_configuration_tlv = cmdu_tx.addClass<wfa_map::tlvAgentApMldConfiguration>();
+    if (!agent_ap_mld_configuration_tlv) {
+        LOG(ERROR) << "No tlvAgentApMldConfiguration added";
+        return false;
+    }
+
+    for (auto mld_conf : agent->configured_ap_mlds) {
+        auto ap_mld_config = agent_ap_mld_configuration_tlv->create_ap_mld();
+        if (ap_mld_config) {
+            uint8_t mld_mode = mld_conf.second.mld_info.mld_mode;
+            ap_mld_config->ap_mld_mac_addr_valid().is_valid = false;
+            ap_mld_config->modes().str = Agent::sMLDInfo::mode(mld_mode | Agent::sMLDInfo::mode::STR);
+            ap_mld_config->modes().nstr = Agent::sMLDInfo::mode(mld_mode | Agent::sMLDInfo::mode::NSTR);
+            ap_mld_config->modes().emlsr = Agent::sMLDInfo::mode(mld_mode | Agent::sMLDInfo::mode::EMLSR);
+            ap_mld_config->modes().emlmr = Agent::sMLDInfo::mode(mld_mode | Agent::sMLDInfo::mode::EMLMR);
+            ap_mld_config->set_ssid(mld_conf.second.mld_info.mld_ssid);
+
+	    for (auto affiliated_conf : agent->configured_ap_mlds[mld_conf.first].affiliated_aps) {
+                auto afAp = ap_mld_config->create_affiliated_ap();
+                if (afAp) {
+                    afAp->affiliated_ap_fields_valid().affiliated_ap_mac_addr_valid = false;
+                    afAp->affiliated_ap_fields_valid().linkid_valid = false;
+                    afAp->ruid() = affiliated_conf.second.ruid;
+
+                    ap_mld_config->add_affiliated_ap(afAp);
+                } else {
+                    LOG(ERROR) << "Affiliated AP creation failed";
+                    return false;
+                }
+            }
+            agent_ap_mld_configuration_tlv->add_ap_mld(ap_mld_config);
+        } else {
+            LOG(ERROR) << "AP MLD creation failed";
+            return false;
+        }
+    }
+
+    return true;
+}
+
 /**
  * @brief Parse AP-Autoconfiguration WSC which should include one AP Radio Basic Capabilities
  *        TLV and one WSC TLV containing M1. If this is Intel agent, it will also have vendor specific tlv.
@@ -1350,6 +1392,10 @@ bool Controller::handle_cmdu_1905_autoconfiguration_WSC(const sMacAddr &src_mac,
                                                                       m1->mac_addr());
     }
 
+    if (!add_agent_ap_mld_configuration_tlv(cmdu_tx, agent)) {
+        return false;
+    }
+
     auto beerocks_header = beerocks::message_com::parse_intel_vs_message(cmdu_rx);
     if (beerocks_header) {
         LOG(INFO) << "Intel radio agent join (al_mac=" << al_mac << " ruid=" << ruid;
@@ -4819,6 +4865,58 @@ bool Controller::handle_ap_capability_report(const sMacAddr &src_mac,
                    << " with profile enum " << agent->profile;
     }
 
+    if (early) {
+        auto &mld_info_confs = database.get_mld_info_configuration();
+
+        for (auto mld_info_conf : mld_info_confs) {
+            for (auto bss_info_conf : mld_info_conf.second.affiliated_aps_list) {
+                for (auto radio_tlv : cmdu_rx.getClassList<wfa_map::tlvApRadioBasicCapabilities>()) {
+                    auto ruid = radio_tlv->radio_uid();
+                    auto radio = agent->radios.get(ruid);
+                    int8_t mld_id = mld_info_conf.first;
+                    if (son_actions::has_matching_operating_class(*radio_tlv, bss_info_conf)) {
+                        auto configured_ap_mld = agent->configured_ap_mlds.find(mld_id);
+                        if (configured_ap_mld == agent->configured_ap_mlds.end()) {
+                            agent->configured_ap_mlds[mld_id] = Agent::sAPMLD();
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_ssid = bss_info_conf.ssid;
+
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.str_support | Agent::sMLDInfo::mode::STR);
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.nstr_support | Agent::sMLDInfo::mode::NSTR);
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.emlsr_support | Agent::sMLDInfo::mode::EMLSR);
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.emlmr_support | Agent::sMLDInfo::mode::EMLMR);
+                        }
+                        else {
+                            // AND all supported mld modes for now. Need to be reviewed later.
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.str_support & Agent::sMLDInfo::mode::STR);
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.nstr_support & Agent::sMLDInfo::mode::NSTR);
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.emlsr_support & Agent::sMLDInfo::mode::EMLSR);
+                            agent->configured_ap_mlds[mld_id].mld_info.mld_mode =
+                                                     Agent::sMLDInfo::mode(radio->wifi7_capabilities.ap_role.emlmr_support & Agent::sMLDInfo::mode::EMLMR);
+                        }
+
+                        auto configured_aff_ap = agent->configured_ap_mlds[mld_id].affiliated_aps.find(ruid);
+                        if (configured_aff_ap == agent->configured_ap_mlds[mld_id].affiliated_aps.end()) {
+                            agent->configured_ap_mlds[mld_id].affiliated_aps[ruid] = Agent::sAPMLD::sAffiliatedAP();
+                            agent->configured_ap_mlds[mld_id].affiliated_aps[ruid].ruid = ruid;
+                        }
+                        else {
+                            LOG(ERROR) << "Found duplicate link on same ruid" << ruid;
+                            return false;
+                        }
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
     return all_radio_capabilities_saved_successfully;
 }
 
