From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 23 Jul 2025 14:31:12 +0530
Subject: [PATCH 2/3] prplmesh NLHAL uci configuration updates

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 framework/platform/bpl/cfg/uci/bpl.cpp        |  4 ++--
 framework/platform/bpl/cfg/uci/bpl_cfg.cpp    |  5 -----
 framework/platform/bpl/cfg/vendor/bpl_cfg.cpp | 15 ++++++++++++++-
 3 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/framework/platform/bpl/cfg/uci/bpl.cpp b/framework/platform/bpl/cfg/uci/bpl.cpp
index ccc052506..8d0863670 100644
--- a/framework/platform/bpl/cfg/uci/bpl.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl.cpp
@@ -22,9 +22,9 @@ int bpl_init()
     // Do nothing
     return 0;
 }
-
+#ifdef ENABLE_NBAPI
 void set_ambiorix_impl_ptr(const std::shared_ptr<beerocks::nbapi::Ambiorix> &ptr) {}
-
+#endif
 void bpl_close()
 {
     // Do nothing
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
index 43fc98285..88914f0ac 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
@@ -149,11 +149,6 @@ int cfg_get_dcs_channel_pool(const BPL_WLAN_IFACE &iface,
         return RETURN_ERR;
     }
 
-    if (radio_num < 0) {
-        MAPF_ERR("invalid input: radio_num < 0");
-        return RETURN_ERR;
-    }
-
     return cfg_get_prplmesh_radio_param(iface.radio_num, "dcs_channel_pool", channel_pool,
                                         BPL_DCS_CHANNEL_POOL_LEN);
 }
diff --git a/framework/platform/bpl/cfg/vendor/bpl_cfg.cpp b/framework/platform/bpl/cfg/vendor/bpl_cfg.cpp
index 1da54c9d6..46ad8b6bf 100644
--- a/framework/platform/bpl/cfg/vendor/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/vendor/bpl_cfg.cpp
@@ -5,8 +5,9 @@
  * This code is subject to the terms of the BSD+Patent license.
  * See LICENSE file for more details.
  */
-
+#ifdef USE_PRPLMESH_WHM
 #include "bpl_cfg_pwhm.h"
+#endif
 #include <bcl/beerocks_version.h>
 #include <bpl/bpl_cfg.h>
 #include <mapf/common/utils.h>
@@ -16,6 +17,7 @@ using namespace mapf;
 namespace beerocks {
 namespace bpl {
 
+#ifdef USE_PRPLMESH_WHM
 bool get_string_value_dm(std::string attr, std::string &value)
 {
     std::string dm       = "DeviceInfo.";
@@ -32,19 +34,26 @@ bool get_string_value_dm(std::string attr, std::string &value)
 
     return true;
 }
+#endif
 
 bool get_serial_number(std::string &serial_number)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "SerialNumber";
 
     if (!get_string_value_dm(attr, serial_number)) {
         serial_number.assign("prplmesh12345");
     }
     return true;
+#endif
+    LOG(ERROR) << "Assigning dummy to serial_number due to Ambiorix dependency";
+    serial_number = "01010101";
+    return true;
 }
 
 bool get_software_version(std::string &software_version)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "SoftwareVersion";
 
     if (!get_string_value_dm(attr, software_version)) {
@@ -52,6 +61,10 @@ bool get_software_version(std::string &software_version)
         software_version.assign(version_string);
     }
     return true;
+#endif
+    LOG(ERROR) << "Assigning dummy to software version due to Ambiorix dependency";
+    software_version = "01010101";
+    return true;
 }
 
 bool get_ruid_chipset_vendor(const sMacAddr &ruid, std::string &chipset_vendor)
