+void base_wlan_hal::extractLinkBaseInterface(const std::string &interface_name, std::string &base_interface) {
+    size_t pos = interface_name.find("_link");
+    if (pos != std::string::npos) {
+        base_interface = interface_name.substr(0, pos);
+    } else {
+        size_t pos1 = interface_name.find("##");
+        if (pos1 != std::string::npos) {
+            base_interface = interface_name.substr(0, pos1);
+        } else {
+            base_interface = interface_name; // fallback if "_link" not found
+        }
+   }
+}
+
+void base_wlan_hal::extractLinkId(const std::string &interface_name, int &link_id) {
+    link_id = -1;
+    size_t pos_link = interface_name.find("_link");
+    if (pos_link != std::string::npos && pos_link + 5 < interface_name.length()) {
+        link_id = std::stoi(interface_name.substr(pos_link + 5));
+    }
+}
+    
+void base_wlan_hal::extractRadioId(const std::string &interface_name, int &radio_id) {
+    radio_id = -1;
+    size_t pos_hash = interface_name.find("##");
+    if (pos_hash != std::string::npos && pos_hash + 2 < interface_name.length()) {
+ 	radio_id = std::stoi(interface_name.substr(pos_hash + 2));
+    }
+}
+
 } // namespace bwl
