+bool nl80211_client_impl::get_iface_with_link_idx(const std::string &iface_rad_idxd, std::string &iface_link_idxd)
+{
+    int  radio_idx;
+    std::string base_interface;
+    bwl::base_wlan_hal::extractLinkBaseInterface(iface_rad_idxd, base_interface);
+    bwl::base_wlan_hal::extractRadioId(iface_rad_idxd, radio_idx);
+    int link_id = 0;
+
+    LOG(INFO) << "iface_rad_idxd: " << iface_rad_idxd << " radio:" << radio_idx <<  "base_interface: " << base_interface;
+    if (!m_socket) {
+            LOG(ERROR) << "Socket is NULL!";
+            return false;
+    }
+
+    int iface_index = if_nametoindex(base_interface.c_str());
+    if (0 == iface_index) {
+            LOG(ERROR) << "Failed to read the index of interface " << iface_rad_idxd << "base_interface:" << base_interface << ": "
+                    << strerror(errno);
+            return false;
+    }
+    LOG(INFO) << "iface_index: " << iface_index;
+
+    return m_socket.get()->send_receive_msg(
+    NL80211_CMD_GET_INTERFACE, 0,
+    [&](struct nl_msg *msg) -> bool {
+    nla_put_u32(msg, NL80211_ATTR_IFINDEX, iface_index);
+    return true;
+    },
+    [&](struct nl_msg *msg) {
+    struct nlattr *tb[NL80211_ATTR_MAX + 1];
+    struct genlmsghdr *gnlh = (struct genlmsghdr *)nlmsg_data(nlmsg_hdr(msg));
+
+    // Parse the netlink message
+    if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
+                            NULL)) {
+    LOG(ERROR) << "Failed to parse netlink message!";
+    return;
+    }
+
+    if ((tb[NL80211_ATTR_MLO_LINKS])) {
+            LOG(INFO) << "MLO supported and MLO links attr present";
+        int ret = 0;
+        struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
+        nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
+                nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
+                if (link[NL80211_ATTR_WIPHY_FREQ]) {
+                    int freq = nla_get_u32(link[NL80211_ATTR_WIPHY_FREQ]);
+
+                    LOG(INFO) << "freq: " << freq ;
+                    bool match = false;
+                    switch (radio_idx) {
+                            case RADIOIDX_2G: match = (freq >= 2400 && freq <= 2500); break;
+                            case RADIOIDX_5G: match = (freq >= 4900 && freq <= 5900); break;
+                            case RADIOIDX_6G: match = (freq >= 5925 && freq <= 7125); break;
+                            default: LOG(ERROR) << "Invalid radio_type"; break;
+                    }
+
+                    if (!match) {
+                            LOG(INFO) << "Skipping MLO link with freq " << freq << " not matching radio_type: " << radio_idx;
+                            continue;
+                    }
+                    link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
+                    LOG(INFO) << "link_id : " << link_id;
+                }
+        }
+        iface_link_idxd = base_interface + "_link" + std::to_string(link_id);
+        LOG(INFO) << "iface_link_idxd : " << iface_link_idxd;
+        return;
+    } else {
+            iface_link_idxd = base_interface;
+            LOG(ERROR) << "iface_link_idxd : " << iface_link_idxd;
+            return;
+    }
+
+    });
+}
+
+bool nl80211_client_impl::getMLDLinkIfaceMacAddr(std::string &interface_name, std::string &mac_out) {
+    LOG(INFO) <<"INSIDE get_mld_mac_for_interface";
+
+    int  link_idx;
+    std::string base_interface;
+    bwl::base_wlan_hal::extractLinkBaseInterface(interface_name, base_interface);
+    bwl::base_wlan_hal::extractLinkId(interface_name, link_idx);
+
+    LOG(INFO) << "Interface value is " << base_interface << "radio is: " << link_idx;
+
+    if (!m_socket) {
+        LOG(ERROR) << "Socket is NULL!";
+        return false;
+    }
+
+    // Get the interface index for given interface name
+    int iface_index = if_nametoindex(base_interface.c_str());
+    if (0 == iface_index) {
+        LOG(ERROR) << "Failed to read the index of interface " << base_interface << ": "
+                   << strerror(errno);
+
+        return false;
+    }
+
+    bool mac_found = false;
+    return m_socket.get()->send_receive_msg(
+        NL80211_CMD_GET_INTERFACE, 0,
+        [&](struct nl_msg *msg) -> bool {
+            nla_put_u32(msg, NL80211_ATTR_IFINDEX, iface_index);
+
+            return true;
+        },
+        [&](struct nl_msg *msg) {
+            struct nlattr *tb[NL80211_ATTR_MAX + 1];
+            struct genlmsghdr *gnlh = (struct genlmsghdr *)nlmsg_data(nlmsg_hdr(msg));
+
+            // Parse the netlink message
+            if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
+                          NULL)) {
+                LOG(ERROR) << "Failed to parse netlink message!";
+                return false;
+            }
+            int ret = 0;
+            struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
+            nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
+                nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
+                if (link[NL80211_ATTR_MLO_LINK_ID] && (nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]) == link_idx)) {
+                    if (link[NL80211_ATTR_MAC]) {
+                        const uint8_t *link_addr = static_cast<const uint8_t *>(nla_data(link[NL80211_ATTR_MAC]));
+                        mac_out = tlvf::mac_to_string(link_addr);
+                        LOG(INFO) << "Matched MAC for link index " << link_idx << ": " << mac_out;
+                        mac_found = true;
+                        return true;
+                    }
+                }
+            }
+            if (!mac_found) {
+                LOG(WARNING) << "No matching MAC found for link index " << link_idx << " on interface " << base_interface;
+            }
+            return mac_found;
+        }
+    );
+}
