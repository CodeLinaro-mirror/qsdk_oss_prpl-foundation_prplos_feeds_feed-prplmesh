+void ApAutoConfigurationTask::handle_vs_get_mld_neighbor_bss_config_response(
+     ieee1905_1::CmduMessageRx &cmdu_rx, int fd, std::shared_ptr<beerocks_header> beerocks_header)
+{
+    LOG(DEBUG) << "Received ACTION_APMANAGER_GET_MLD_NEIGHBOR_BSS_CONFIG_RESPONSE message";
+    auto response = beerocks_header
+            ->addClass<beerocks_message::cACTION_APMANAGER_GET_MLD_NEIGHBOR_BSS_CONFIG_RESPONSE>();
+    if (!response) {
+        LOG(ERROR) << "addClass cACTION_APMANAGER_GET_MLD_NEIGHBOR_BSS_CONFIG_RESPONSE failed";
+        return;
+    }
+
+    WSC::configData::config config;
+    config.mld_id = response->bss_info_conf().mld_id;
+
+    char ssid[beerocks::message::WIFI_SSID_MAX_LENGTH] = "";
+    string_utils::copy_string(ssid, response->bss_info_conf().ssid, beerocks::message::WIFI_SSID_MAX_LENGTH);
+    config.ssid = ssid;
+
+    char network_key[beerocks::message::WIFI_PASS_MAX_LENGTH] = "";
+    string_utils::copy_string(network_key, response->bss_info_conf().network_key, beerocks::message::WIFI_PASS_MAX_LENGTH);
+    config.network_key = network_key;
+
+    config.auth_type = WSC::eWscAuth(response->bss_info_conf().authentication_type);
+    config.encr_type = WSC::eWscEncr(response->bss_info_conf().encryption_type);
+    config.bss_type = 0;
+    if (response->bss_info_conf().fronthaul) {
+        config.bss_type |= WSC::eWscVendorExtSubelementBssType::FRONTHAUL_BSS;
+    }
+    if (response->bss_info_conf().backhaul) {
+        config.bss_type |= WSC::eWscVendorExtSubelementBssType::BACKHAUL_BSS;
+    }
+    if (response->bss_info_conf().profile1_backhaul_sta_association_disallowed) {
+        config.bss_type |= WSC::eWscVendorExtSubelementBssType::PROFILE1_BACKHAUL_STA_ASSOCIATION_DISALLOWED;
+    }
+    if (response->bss_info_conf().profile2_backhaul_sta_association_disallowed) {
+        config.bss_type |= WSC::eWscVendorExtSubelementBssType::PROFILE2_BACKHAUL_STA_ASSOCIATION_DISALLOWED;
+    }
+    config.hidden_ssid = response->bss_info_conf().hidden_ssid;
+
+    std::vector<WSC::configData::config> configs;
+    configs.push_back(config);
+
+    auto db    = AgentDB::get();
+    auto ruid = response->tgt_ruid();
+    auto radio = db->get_radio_by_mac(ruid, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(ERROR) << "No radio with ruid '" << ruid << "' found!";
+        return;
+    }
+
+    // Send AP BSS Config
+    send_ap_bss_configuration_message(radio->front.iface_name, configs);
+    return;
+}
