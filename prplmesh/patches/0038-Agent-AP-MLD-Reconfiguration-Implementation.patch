+bool ApAutoConfigurationTask::send_affiliated_ap_add_request(const sMacAddr &mld_mac, const sMacAddr &ruid)
+{
+    auto db = AgentDB::get();
+
+    WSC::configData::config config;
+    bool found_apmld = 0;
+    bool found_neighbor_ruid = 0;
+    sMacAddr neighbor_ruid;
+    uint8_t mld_id = -1;
+    // Get the MLD to retrieve SSID and mld_id
+    for (auto db_apmld : db->ap_mld_configurations) {
+	// Check for MLD MAC match
+        if (mld_mac == db_apmld.mld_config.mld_mac) {
+            mld_id = db_apmld.mld_config.mld_unit;
+            for (auto affiliated_ap : db_apmld.affiliated_aps) {
+                if (affiliated_ap.ruid != ruid) {
+                    found_neighbor_ruid = 1;
+                    neighbor_ruid = affiliated_ap.ruid;
+                    LOG(DEBUG) << "Neighbor for RUID: " << tlvf::mac_to_string(ruid) << " is "
+                               << tlvf::mac_to_string(neighbor_ruid) << " with mld_id: " << mld_id;
+                    break;
+		}
+	    }
+            found_apmld = 1;
+            break;
+        }
+    }
+
+    if (!found_apmld) {
+        LOG(DEBUG) << "APMLD with mld_mac: " << tlvf::mac_to_string(mld_mac) << " not found";
+        return false;
+    }
+
+    if (!found_neighbor_ruid) {
+        LOG(DEBUG) << "Neighbor Affiliated AP for RUID: " << tlvf::mac_to_string(ruid) << " not found";
+        return false;
+    }
+
+    auto radio = db->get_radio_by_mac(neighbor_ruid, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(ERROR) << "Failed to find ruid " << tlvf::mac_to_string(neighbor_ruid) << " in the Agent";
+        return true;
+    }
+
+    // Fetch bss config info from other HAL
+    // Create Affiliated AP remove request message
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_APMANAGER_GET_MLD_NEIGHBOR_BSS_CONFIG_REQUEST>(m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "Failed building cACTION_APMANAGER_GET_MLD_NEIGHBOR_BSS_CONFIG_REQUEST message!";
+        return false;
+    }
+
+    request->mld_id() = mld_id;
+    request->tgt_ruid() = ruid;
+
+    // Send the message to appropriate HAL
+    LOG(DEBUG) << "Sending ACTION_APMANAGER_GET_MLD_NEIGHBOR_BSS_CONFIG_REQUEST message to HAL with RUID: "
+               << tlvf::mac_to_string(neighbor_ruid) << " and Target RUID: " << tlvf::mac_to_string(ruid);
+    auto ap_manager_fd = m_btl_ctx.get_ap_manager_fd(radio->front.iface_name);
+    m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
+    return true;
+}
+
+
+bool ApAutoConfigurationTask::send_affiliated_ap_remove_request(const sMacAddr &ruid, const sMacAddr &bssid)
+{
+    auto db = AgentDB::get();
+
+    auto radio = db->get_radio_by_mac(ruid, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(ERROR) << "Failed to find ruid " << ruid << " in the Agent";
+        return false;
+    }
+
+    // Create Affiliated AP remove request message
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_APMANAGER_AFFILIATED_AP_REMOVE_REQUEST>(m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "Failed building cACTION_APMANAGER_AFFILIATED_AP_REMOVE_REQUEST message!";
+        return false;
+    }
+
+    // BSSID of Affiliated AP to be removed
+    request->bssid() = bssid;
+
+    // Send the message to appropriate HAL
+    LOG(DEBUG) << "Sending ACTION_APMANAGER_AFFILIATED_AP_REMOVE_REQUEST message to HAL with RUID: "
+               << tlvf::mac_to_string(ruid) << " for bssid: " << tlvf::mac_to_string(bssid);
+    auto ap_manager_fd = m_btl_ctx.get_ap_manager_fd(radio->front.iface_name);
+    m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
+    return true;
+}
