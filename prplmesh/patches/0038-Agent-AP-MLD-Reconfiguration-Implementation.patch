+bool ApAutoConfigurationTask::handle_ap_mld_configuration_request(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto db = AgentDB::get();
+    auto mid = cmdu_rx.getMessageId();
+    LOG(DEBUG) << "Received AP_MLD_CONFIGURATION_REQUEST_MESSAGE, mid=" << std::hex << int(mid);
+
+    // send ACK_MESSAGE back to the controller
+    if (!m_cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE)) {
+        LOG(ERROR) << "cmdu creation of type ACK_MESSAGE, has failed";
+        return false;
+    }
+    LOG(DEBUG) << "Sending ACK message to the originator, mid=" << std::hex << mid;
+    m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+
+    // Handle Agent AP MLD Configuration TLV
+    // Here, only addition/removal of Affiliated link is allowed
+    auto agent_ap_mld_configuration(cmdu_rx.getClass<wfa_map::tlvAgentApMldConfiguration>());
+    if (!agent_ap_mld_configuration) {
+        LOG(DEBUG) << "No tlvAgentApMldConfiguration TLV received";
+        return true;
+    }
+
+    // Check number of MLDs in DB and TLV
+    if (agent_ap_mld_configuration->num_ap_mld() != db->ap_mld_configurations.size()) {
+        LOG(ERROR) << "Mismatch in Number of MLDs in TLV and DB";
+	return false;
+    }
+
+    for (auto &db_apmld : db->ap_mld_configurations) {
+        bool apmld_found     = 0;
+        uint8_t tlv_apmld_it = 0;
+        auto mld_mac         = db_apmld.mld_config.mld_mac;
+        for (tlv_apmld_it = 0; tlv_apmld_it < agent_ap_mld_configuration->num_ap_mld(); ++tlv_apmld_it) {
+            // Get AgentApMld config from TLV
+            std::tuple<bool, wfa_map::cApMld &> ap_mld_tuple(agent_ap_mld_configuration->ap_mld(tlv_apmld_it));
+            if (std::get<0>(ap_mld_tuple)) {
+                wfa_map::cApMld &ap_mld = std::get<1>(ap_mld_tuple);
+
+                // SSID
+                std::string ssid(ap_mld.ssid_str());
+                if (ssid.empty()) {
+                    LOG(ERROR) << "SSID is empty in tlvAgentApMldConfiguration";
+                    return false;
+                }
+
+                // MLD MAC
+                if (!ap_mld.ap_mld_mac_addr_valid().is_valid) {
+                    LOG(ERROR) << "MLD MAC is invalid in tlvAgentApMldConfiguration";
+                    return false;
+                }
+
+                // Check for MLD MAC match
+                if (mld_mac == ap_mld.ap_mld_mac_addr()) {
+                    apmld_found = 1;
+                    break;
+                }
+            } else {
+                LOG(ERROR) << "Couldn't get AP MLD from tlvAgentApMldConfiguration";
+                return false;
+	    }
+        }
+        // Check for valid ApMld
+        if (!apmld_found) {
+            LOG(ERROR) << "MLD is removed. Not expected in AP_MLD_CONFIGURATION_REQUEST_MESSAGE";
+	    return false;
+        } else {
+
+            std::tuple<bool, wfa_map::cApMld &> ap_mld_tuple(agent_ap_mld_configuration->ap_mld(tlv_apmld_it));
+            if (std::get<0>(ap_mld_tuple)) {
+                wfa_map::cApMld &ap_mld = std::get<1>(ap_mld_tuple);
+
+		// Link Removal
+                for (uint8_t db_affl_ap_it = 0; db_affl_ap_it < db_apmld.affiliated_aps.size(); db_affl_ap_it++) {
+                    auto &db_affl_ap = db_apmld.affiliated_aps[db_affl_ap_it];
+                    auto ruid = db_affl_ap.ruid;
+                    bool afflap_found       = 0;
+                    for (uint8_t tlv_affl_ap_it = 0; tlv_affl_ap_it < ap_mld.num_affiliated_ap(); ++tlv_affl_ap_it) {
+                        // Get AffiliatedAp config from TLV
+                        std::tuple<bool, wfa_map::cAffiliatedAp &> affiliated_ap_tuple(ap_mld.affiliated_ap(tlv_affl_ap_it));
+                        if (std::get<0>(affiliated_ap_tuple)) {
+                            // Check RUID match
+                            if (ruid == std::get<1>(affiliated_ap_tuple).ruid()) {
+                                afflap_found = 1;
+                                break;
+                            }
+                        }
+                    }
+                    // Link to be removed
+                    if (!afflap_found) {
+                        // Remove Affiliated Ap
+                        if (send_affiliated_ap_remove_request(ruid, db_affl_ap.bssid)) {
+                            // Remove Database entry
+                            db_apmld.affiliated_aps.erase(db_apmld.affiliated_aps.begin() + db_affl_ap_it);
+                            LOG(DEBUG) << "Removed Affiliated AP with ruid: " << ruid << " from ApMld with MLD MAC: " << mld_mac;
+                        }
+                    }
+                }
+
+                // Link Addition
+                for (uint8_t tlv_affl_ap_it = 0; tlv_affl_ap_it < ap_mld.num_affiliated_ap(); ++tlv_affl_ap_it) {
+                    std::tuple<bool, wfa_map::cAffiliatedAp &> affiliated_ap_tuple(ap_mld.affiliated_ap(tlv_affl_ap_it));
+                    if (std::get<0>(affiliated_ap_tuple)) {
+                        auto ruid = std::get<1>(affiliated_ap_tuple).ruid();
+                        bool afflap_found       = 0;
+                        for (uint8_t db_affl_ap_it = 0; db_affl_ap_it < db_apmld.affiliated_aps.size(); db_affl_ap_it++) {
+                            auto db_affl_ap = db_apmld.affiliated_aps[db_affl_ap_it];
+                            // Check RUID match
+                            if (db_affl_ap.ruid == ruid) {
+                                afflap_found = 1;
+                                break;
+                            }
+                        }
+                        // Link to be added
+                        if (!afflap_found) {
+                            // Add Affiliated Ap
+                            if (send_affiliated_ap_add_request(mld_mac, ruid)) {
+                                // Add Database entry
+                                AgentDB::sAPMLDConfiguration::sAffiliatedAP affiliated_conf = {};
+                                affiliated_conf.ruid = ruid;
+                                db_apmld.affiliated_aps.push_back(affiliated_conf);
+                                LOG(DEBUG) << "Added Affiliated AP with ruid: " << ruid << " to ApMld with MLD MAC: " << mld_mac;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // Set flag to indicate AP MLD Reconfig pending to send out Response later
+    apmld_reconfig_pending = 1;
+
+    return true;
+}
