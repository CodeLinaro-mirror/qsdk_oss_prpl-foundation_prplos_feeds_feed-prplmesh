+bool ap_wlan_hal_whm::remove_affiliated_ap(const sMacAddr &bss_id)
+{
+    // Remove Affiliated AP
+
+    // BSSID
+    auto bssid = tlvf::mac_to_string(bss_id);
+
+    // VAP ID
+    int vap_id = get_vap_id_with_mac(bssid);
+
+    // Interface name
+    auto &vap_info = m_radio_info.available_vaps[vap_id];
+    auto ifname    = vap_info.bss;
+
+    auto vap_it    = m_vapsExtInfo.find(ifname);
+    vap_it->second.teardown = true;
+    LOG(INFO) << "BSS " << bssid << " flagged for tear down.";
+
+    if (vap_it == m_vapsExtInfo.end()) {
+        LOG(ERROR) << "Failed to get ifname of " << bssid;
+        return false;
+    }
+
+    // Change MLDUnit to -1 to indicate Affiliated AP Removal
+    AmbiorixVariant new_obj(AMXC_VAR_ID_HTABLE);
+    new_obj.add_child("MLDUnit", -1);
+    if (m_ambiorix_cl.update_object(vap_it->second.ssid_path, new_obj)) {
+        LOG(DEBUG) << "Set MLDUnit to -1 for BSSID: " << bssid << " to remove Affiliated AP";
+    } else {
+        LOG(ERROR) << "Failed to set MLDUnit to -1 for " << ifname << " BSSID: " << bssid;
+	return false;
+    }
+
+    return true;
+}
+
+bool ap_wlan_hal_whm::get_mld_neighbor_bss_config(son::wireless_utils::sBssInfoConf &bss_config, int8_t mld_id)
+{
+    if (mld_id < 0) {
+        LOG(ERROR) << "MLD id is invalid";
+        return false;
+    }
+
+    // Find neighbor
+    int vap_id = -1;
+    for (auto &it : m_radio_info.available_vaps) {
+        if (it.second.mld_id == mld_id) {
+            vap_id = it.first;
+            LOG(DEBUG) << "Found a neighbor bss config for mld_id: " << mld_id << ". VAP id of neighbor is " << vap_id;
+	    break;
+        }
+    }
+
+    if (vap_id == -1) {
+        LOG(ERROR) << "Neighbor bss config for mld_id: " << mld_id << " not found";
+        return false;
+    }
+    auto &vap_info = m_radio_info.available_vaps[vap_id];
+    auto vap_it    = m_vapsExtInfo.find(vap_info.bss);
+    if (vap_it == m_vapsExtInfo.end()) {
+        LOG(ERROR) << "fail to get ifname of " << vap_info.bss;
+        return false;
+    }
+    auto wifi_vap_path  = vap_it->second.path;
+    auto wifi_ssid_path = vap_it->second.ssid_path;
+    // Get BSS Config of neighbor
+    // ssid, mld_id, fronthaul, backhaul --> updated from pWHM DM in refresh_vap_info
+    bss_config.ssid = vap_info.ssid;
+    bss_config.mld_id = vap_info.mld_id;
+    bss_config.fronthaul = vap_info.fronthaul;
+    bss_config.backhaul = vap_info.backhaul;
+
+    // Might be stale value --> No pWHM DM
+    bss_config.profile1_backhaul_sta_association_disallowed = vap_info.profile1_backhaul_sta_association_disallowed;
+    bss_config.profile2_backhaul_sta_association_disallowed = vap_info.profile2_backhaul_sta_association_disallowed;
+
+    // authentication_type, encryption_type, network_key, hidden_ssid --> Fetch from pWHM DM
+    std::string authentication_type;
+    m_ambiorix_cl.get_param(authentication_type, wifi_vap_path + "Security.", "ModeEnabled");
+    bss_config.authentication_type = wbapi_utils::security_mode_from_string(authentication_type);
+
+    std::string encryption_type;
+    m_ambiorix_cl.get_param(encryption_type, wifi_vap_path + "Security.", "EncryptionMode");
+    bss_config.encryption_type = wbapi_utils::encryption_type_from_string(encryption_type);
+
+    m_ambiorix_cl.get_param(bss_config.network_key, wifi_vap_path + "Security.", "KeyPassPhrase");
+
+    bool ssid_adv_en;
+    m_ambiorix_cl.get_param(ssid_adv_en, wifi_vap_path, "SSIDAdvertisementEnabled");
+    bss_config.hidden_ssid = !ssid_adv_en;
+
+    return true;
+}
+
