+    LOG(TRACE) << __func__ << " dwell_time=" << dwell_time_msec
+               << " channels=" << channel_pool.size()
+               << " cert_mode=" << cert_mode;
+
+    bool ret = send_nl80211_msg(
+        NL80211_CMD_TRIGGER_SCAN, 0,
+        [&](struct nl_msg *msg) -> bool {
+            // Request scan for all SSIDs
+            if (nla_put(msg, NL80211_ATTR_SCAN_SSIDS, 0, "") < 0) {
+                LOG(ERROR) << "Failed to add SCAN_SSIDS attribute";
+                return false;
+            }
+            // Add scan frequencies from channel_pool
+            if (!channel_pool.empty()) {
+                struct nlattr *freqs = nla_nest_start(msg, NL80211_ATTR_SCAN_FREQUENCIES);
+                if (!freqs) {
+                    LOG(ERROR) << "Failed to start SCAN_FREQUENCIES nest";
+                    return false;
+                }
+
+                for (auto channel : channel_pool) {
+                    int freq = son::wireless_utils::channel_to_freq(channel);
+                    if (freq > 0) {
+                        if (nla_put_u32(msg, 0, freq) < 0) {
+                            LOG(ERROR) << "Failed to add frequency " << freq;
+                            return false;
+                        }
+                        LOG(DEBUG) << "Added scan frequency: " << freq << " MHz (channel " << channel << ")";
+                    }
+                }
+                nla_nest_end(msg, freqs);
+            }
+
+            // Optional dwell time
+            if (dwell_time_msec > 0) {
+                if (nla_put_u16(msg, NL80211_ATTR_MEASUREMENT_DURATION,
+                                (uint16_t)dwell_time_msec) < 0) {
+                    LOG(ERROR) << "Failed to add MEASUREMENT_DURATION attribute";
+                    return false;
+                }
+            }
+            return true;
+        },
+        [&](struct nl_msg *) -> bool {
+            LOG(INFO) << "NL80211_CMD_TRIGGER_SCAN accepted for " << get_iface_name();
+            return true;
+        });
+
+    if (!ret) {
+        LOG(ERROR) << "Failed to trigger scan on " << get_iface_name();
+        return false;
+    }
+    event_queue_push(Event::Channel_Scan_Triggered);
+    LOG(INFO) << "Scan request sent to kernel for " << get_iface_name();
+    return true;
 }
 
