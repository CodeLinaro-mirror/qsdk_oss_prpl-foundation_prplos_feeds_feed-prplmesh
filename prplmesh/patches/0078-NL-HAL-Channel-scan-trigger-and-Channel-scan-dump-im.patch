+bool mon_wlan_hal_nl80211::test_nl_event(struct nl_msg *msg,void *arg)
+{
+    LOG(INFO) << "test_nl_event called";
+
+    struct nlmsghdr *nlh = nlmsg_hdr(msg);
+    if (!nlh) {
+        LOG(ERROR) << "Invalid nlmsghdr in test_nl_event";
+        return false;
+    }
+
+    struct genlmsghdr *gnlh = (struct genlmsghdr *)nlmsg_data(nlh);
+    if (!gnlh) {
+        LOG(ERROR) << "Invalid genlmsghdr in test_nl_event";
+        return false;
+    }
+
+    std::string iface_name;
+
+    struct nlattr *tb[NL80211_ATTR_MAX + 1] = {};
+    nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+              genlmsg_attrlen(gnlh, 0), nullptr);
+
+    if (tb[NL80211_ATTR_IFINDEX]) {
+        auto index = nla_get_u32(tb[NL80211_ATTR_IFINDEX]);
+        iface_name = beerocks::net::network_utils::linux_get_iface_name(index);
+    }
+
+    int cmd = gnlh->cmd;
+    auto event = nl80211_to_bwl_event(cmd);
+
+    switch (event) {
+
+    case Event::Channel_Scan_Dump_Result:
+        LOG(INFO) << "NL80211_CMD_NEW_SCAN_RESULTS event received on " << get_iface_name();
+        event_queue_push(Event::Channel_Scan_New_Results_Ready);
+        if (!channel_scan_dump_results()) {
+            LOG(ERROR) << "channel_scan_dump_results failed for " << get_iface_name();
+            return false;
+    }
+    break;
+
+    default:
+        LOG(DEBUG) << "Mapped but unhandled nl80211 event: " << static_cast<int>(event)
+                   << " (cmd=" << cmd << ")";
+    break;
+    }
+    return true;
 }
 
