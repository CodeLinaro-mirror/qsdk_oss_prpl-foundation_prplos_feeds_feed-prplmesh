 bool base_wlan_hal_nl80211::process_nl_events()
 {
-    LOG(ERROR) << __func__ << "not implemented";
-    return false;
+    LOG(INFO) << "process_nl_events called for interface: " << get_iface_name();
+
+    if (!m_nl80211_sock || !m_nl80211_sock.get()) {
+        LOG(ERROR) << "Invalid Netlink socket used for nl events (m_nl80211_sock == nullptr)";
+        return false;
+    }
+
+    int fd = nl_socket_get_fd(m_nl80211_sock.get());
+    if (fd <= 0) {
+        LOG(ERROR) << "Invalid socket fd=" << fd;
+        return false;
+    }
+
+    LOG(DEBUG) << "Processing nl80211 events on fd=" << fd << ", family_id=" << m_nl80211_id; 
+    static thread_local std::function<bool(struct nl_msg *, void *)> nl_handler_cb_wrapper;
+    nl_handler_cb_wrapper = [this](struct nl_msg *msg, void *arg) -> bool {
+        if (!test_nl_event(msg, arg)) {
+            LOG(ERROR) << "test_nl_event failed!";
+            return false;
+        }
+        return true;
+    };
+
+    auto nl_handler_cb = [](struct nl_msg *msg, void *arg) -> int {
+        return nl_handler_cb_wrapper(msg, arg) ? NL_OK : NL_STOP;
+    };
+
+    // No sequence checking callback - CRITICAL for multicast messages
+    auto no_seq_check = [](struct nl_msg *msg, void *arg) -> int {
+        return NL_OK;
+    };
+
+    // Error callback
+    auto nl_error_cb = [](struct sockaddr_nl *nla, struct nlmsgerr *err, void *arg) -> int {
+        LOG(ERROR) << "Netlink error: " << strerror(-err->error);
+        return NL_STOP;
+    };
+
+    // Allocate callback structure
+    struct nl_cb *cb = nl_cb_alloc(NL_CB_DEFAULT);
+    if (!cb) {
+        LOG(ERROR) << "nl_cb_alloc failed";
+        return false;
+    }
+    nl_cb_set(cb, NL_CB_SEQ_CHECK, NL_CB_CUSTOM, no_seq_check, nullptr);
+    nl_cb_set(cb, NL_CB_VALID, NL_CB_CUSTOM, nl_handler_cb, this);
+    nl_cb_err(cb, NL_CB_CUSTOM, nl_error_cb, nullptr);
+
+    // Process events
+    int err = nl_recvmsgs(m_nl80211_sock.get(), cb);
+    if (err < 0) {
+        LOG(ERROR) << "nl_recvmsgs failed: " << nl_geterror(err) << " (" << err << ")";
+        nl_cb_put(cb);
+        return false;
+    }
+
+    LOG(DEBUG) << "nl_recvmsgs completed successfully, processed messages";
+    nl_cb_put(cb);
+    return true;
+
 }
 
