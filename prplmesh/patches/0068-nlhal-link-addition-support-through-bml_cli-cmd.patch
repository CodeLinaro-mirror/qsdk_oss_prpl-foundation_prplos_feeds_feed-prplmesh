@@ -2627,8 +2638,69 @@ bool ap_wlan_hal_nl80211::remove_affiliated_ap(const sMacAddr &bssid)
 
 bool ap_wlan_hal_nl80211::get_mld_neighbor_bss_config(son::wireless_utils::sBssInfoConf &bss_config, int8_t mld_id)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return false;
+    LOG(TRACE) << __func__;
+
+    if (mld_id < 0) {
+        LOG(ERROR) << "MLD id is invalid";
+        return false;
+    }
+
+    // Find neighbor
+    int vap_id = -1;
+    for (auto &it : m_radio_info.available_vaps) {
+        if (it.second.mld_id == mld_id) {
+            vap_id = it.first;
+            LOG(DEBUG) << "Found a neighbor bss config for mld_id: " << mld_id << ". VAP id of neighbor is " << vap_id;
+            break;
+        }
+    }
+
+    if (vap_id == -1) {
+        LOG(ERROR) << "Neighbor bss config for mld_id: " << mld_id << " not found";
+        return false;
+    }
+    auto &vap_info = m_radio_info.available_vaps[vap_id];
+
+    // Get BSS Config of neighbor
+    // ssid, mld_id, fronthaul, backhaul --> updated from pWHM DM in refresh_vap_info
+    bss_config.ssid = vap_info.ssid;
+    bss_config.mld_id = vap_info.mld_id;
+    bss_config.fronthaul = vap_info.fronthaul;
+    bss_config.backhaul = vap_info.backhaul;
+
+    // Might be stale value --> No pWHM DM
+    bss_config.profile1_backhaul_sta_association_disallowed = vap_info.profile1_backhaul_sta_association_disallowed;
+    bss_config.profile2_backhaul_sta_association_disallowed = vap_info.profile2_backhaul_sta_association_disallowed;
+
+    // authentication_type, encryption_type, network_key, hidden_ssid --> Fetch from mld_entries
+     
+    // update mld_id
+    
+    bool config_found = false;
+    for (const auto& entry : m_radio_info.mld_entries) {
+        if (entry.first == mld_id) {
+            bss_config.authentication_type = static_cast<WSC::eWscAuth>(entry.second.authentication_type);
+            bss_config.encryption_type     = static_cast<WSC::eWscEncr>(entry.second.encryption_type);
+            bss_config.network_key         = entry.second.network_key;
+            config_found = true;
+            break;
+        }
+    }
+
+#if 0
+    bool ssid_adv_en;
+    m_ambiorix_cl.get_param(ssid_adv_en, wifi_vap_path, "SSIDAdvertisementEnabled");
+    bss_config.hidden_ssid = !ssid_adv_en;
+#endif
+    if (!config_found) {
+        LOG(ERROR) << " Failed to found mld_id: " <<mld_id << " in mld_entries";
+        return false;
+    } else {
+        LOG(DEBUG) << "BSS_CONFIG For mld_id: " << mld_id << " auth_type: " << bss_config.authentication_type 
+                   << " enc_type: " << bss_config.encryption_type << " key: " << bss_config.network_key;
+
+        return true;
+    }
 }
 
 bool ap_wlan_hal_nl80211::reload_all_ap_vaps()
@@ -2765,6 +2837,52 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
     return true;
 }
 
+void ap_wlan_hal_nl80211::add_mld_entries(son::wireless_utils::sBssInfoConf bss_it, std::string mlo_iface) 
+{
+    LOG(DEBUG) << "ADD_MLD_ENTRIES FOR: " << mlo_iface << " with mld_id: " << bss_it.mld_id;
+
+    for (auto& entry : m_radio_info.mld_entries) {
+        if (entry.first == bss_it.mld_id) {
+            LOG(DEBUG) << "DUPLICATE MLD_ENTRY FOR: " << mlo_iface << " with mld_id: " << bss_it.mld_id;
+            return;
+        }
+    }
+    // Add new entry
+    m_radio_info.mld_entries.emplace_back(
+                    bss_it.mld_id, 
+                    MLD_Authinfo{
+                        mlo_iface, 
+                        static_cast<uint16_t>(bss_it.authentication_type),
+                        static_cast<uint16_t>(bss_it.encryption_type),
+                        bss_it.network_key
+                    }
+    );
+
+}
+
+bool ap_wlan_hal_nl80211::process_reconfig_complete_event(const bool &result)
+{
+    // Push the event
+    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(bool));
+    auto msg = reinterpret_cast<bool *>(msg_buff.get());
+    LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+
+    // Initialize the message
+    memset(msg_buff.get(), 0, sizeof(bool));
+
+    *msg = result;
+
+    LOG(DEBUG) << "Push Event:MLD_Reconfig_Complete_Notification to ApManager with result: " << (result ? "success" : "fail");
+    bool push_success = event_queue_push(Event::MLD_Reconfig_Complete_Notification, msg_buff);
+
+    if (!push_success) {
+        LOG(ERROR) << "Failed to push MLD_Reconfig_Complete_Notification event";
+    }
+
+    return push_success;
+}
+
+
 
 } // namespace nl80211
 
