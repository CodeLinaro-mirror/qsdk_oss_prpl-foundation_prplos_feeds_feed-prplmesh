 }
 
+bool nl80211_client_impl::create_new_interface(std::string &vap_name)
+{
+    LOG(ERROR) << "Create new interface: " << vap_name;
+    if (!m_socket) {
+        LOG(ERROR) << "Socket is NULL!";
+        return false;
+    }
+
+    // Get the interface index for given interface name
+    int iface_index = if_nametoindex(vap_name.c_str());
+    if (0 != iface_index) {
+        LOG(DEBUG) << "Interface " << vap_name << " is already present with iface_index: " << iface_index ;
+        return true;
+    }
+
+    return m_socket.get()->send_receive_msg(
+        NL80211_CMD_NEW_INTERFACE, 0,
+        [&](struct nl_msg *msg) -> bool {
+            if(nla_put_string(msg, NL80211_ATTR_IFNAME,vap_name.c_str()) < 0){
+                LOG(ERROR) << "Failed to set interface name!";
+                return false;
+            }
+            if(nla_put_u32(msg, NL80211_ATTR_IFTYPE,NL80211_IFTYPE_AP) < 0){ //mBm
+                LOG(ERROR) << "Failed to set interface type!";
+                return false;
+            }
+            if(nla_put_u32(msg, NL80211_ATTR_WIPHY,0) < 0){ //mBm
+                LOG(ERROR) << "Failed to set wiphy attr!";
+                return false;
+            }
+            return true;
+        },
+        [&](struct nl_msg *msg) {
+            struct nlattr *tb[NL80211_ATTR_MAX + 1];
+
+            struct genlmsghdr *gnlh = static_cast<genlmsghdr *>(nlmsg_data(nlmsg_hdr(msg)));
+
+            // Parse the netlink message
+            if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
+                          NULL)) {
+                LOG(ERROR) << "Failed to parse netlink message!";
+                return;
+            }
+                LOG(ERROR) << "Success parse netlink message!";
+
+        });
+}
+
 } // namespace bwl
