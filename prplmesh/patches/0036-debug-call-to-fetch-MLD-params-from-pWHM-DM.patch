From ab10863190cd700afbabac5dfbb13dbe77f69aab Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Fri, 11 Jul 2025 01:53:00 +0530
Subject: [PATCH 1/3] debug call to fetch MLD params from pWHM DM

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/base_wlan_hal_whm.cpp | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
index 9804f461f..2e80e5b43 100755
--- a/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
@@ -986,7 +986,10 @@ bool base_wlan_hal_whm::refresh_vap_info(int id, const AmbiorixVariant &ap_obj)
             (mac != beerocks::net::network_utils::ZERO_MAC_STRING)) {
             vap_element.bss = ifname;
             vap_element.mac = mac;
+            // ssid
             ssid_obj->read_child(vap_element.ssid, "SSID");
+            // mld_id
+            ssid_obj->read_child(vap_element.mld_id, "MLDUnit");
             // This is to be aligned with NL80211 backend implementation, if ACCESSPOINT is disabled, SSID shall be null
             // in practice, setting SSID to null is not accepted by whm/hostapd.
             bool ap_enabled(false);
@@ -1010,6 +1013,68 @@ bool base_wlan_hal_whm::refresh_vap_info(int id, const AmbiorixVariant &ap_obj)
             m_ambiorix_cl.resolve_path(wifi_ssid_path, vap_extInfo.ssid_path);
             vap_extInfo.status = wbapi_utils::get_ap_status(ap_obj);
             LOG(INFO) << "status for " << ifname << " " << vap_extInfo.status;
+
+	    // Use debug call to retrieve MLD MAC address and Link ID
+	    AmbiorixVariant result;
+	    AmbiorixVariant args(AMXC_VAR_ID_HTABLE);
+	    args.add_child("op","nl80211IfaceInfo");
+	    if (m_ambiorix_cl.call(vap_extInfo.path, "debug", args, result))
+	    {
+                auto debug_results_list = result.read_children<AmbiorixVariantListSmartPtr>();
+                if (!debug_results_list) {
+	            LOG(ERROR) << "Failed reading debug_results!";
+	            return false;
+                }
+                if (debug_results_list->empty()) {
+	            LOG(ERROR) << "debug_results are empty";
+	            return false;
+                }
+
+                auto debug_map = debug_results_list->front().read_children<AmbiorixVariantMapSmartPtr>();
+                auto data_map = *debug_map;
+
+                // MLD MAC
+                std::string ap_mld_mac;
+                if (data_map.find("mac") != data_map.end()) {
+	            data_map["mac"].get(ap_mld_mac);
+                    vap_element.ap_mld_mac = ap_mld_mac;
+                }
+
+                // LinkID
+                // Based on nMloLinks get the LinkID
+                if (data_map.find("nMloLinks") != data_map.end()) {
+                    uint32_t nMloLinks = 0;
+                    uint8_t linkId = -1;
+                    data_map["nMloLinks"].get(nMloLinks);
+                    LOG(DEBUG) << "nMloLinks: " << nMloLinks;
+                    // Fetch LinkID only if we have valid MloLinks
+                    if (nMloLinks > 0) {
+                        if (data_map.find("mloLinks") != data_map.end()) {
+                            // Read children of mloLinks (list)
+                            auto mloLinks_list = data_map["mloLinks"].read_children<AmbiorixVariantListSmartPtr>();
+                            for (auto &mloLinks_map : *mloLinks_list) {
+                                // Read per child of mloLinks List (htable)
+                                auto mloLink_map = mloLinks_map.read_children<AmbiorixVariantMapSmartPtr>();
+                                auto &map = *mloLink_map;
+                                if (map.find("linkMac") != map.end()) {
+                                    std::string linkMac;
+                                    map["linkMac"].get(linkMac);
+                                    // Ensure linkMac is in lower case
+                                    std::transform(linkMac.begin(), linkMac.end(), linkMac.begin(), ::tolower);
+                                    if (linkMac == vap_element.mac) {
+                                        if (map.find("linkId") != map.end()) {
+                                            map["linkId"].get(linkId);
+                                            break;
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        vap_element.link_id = linkId;
+                        LOG(DEBUG) << "LinkId for " << vap_element.mac << " is " << vap_element.link_id;
+                    }
+                }
+            }
         }
     }
 
@@ -1051,6 +1116,9 @@ bool base_wlan_hal_whm::refresh_vap_info(int id, const AmbiorixVariant &ap_obj)
     }
 
     mapped_vap_element.mac    = vap_element.mac;
+    mapped_vap_element.ap_mld_mac = vap_element.ap_mld_mac;
+    mapped_vap_element.link_id    = vap_element.link_id;
+    mapped_vap_element.mld_id    = vap_element.mld_id;
     mapped_vap_extInfo.status = vap_extInfo.status;
 
     return true;
-- 
