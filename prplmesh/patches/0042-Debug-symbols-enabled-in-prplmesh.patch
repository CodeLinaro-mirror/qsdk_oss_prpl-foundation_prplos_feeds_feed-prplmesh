From bd6a9b8c70f46c61a11bee6061ec0a2869be584c Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Tue, 12 Aug 2025 17:31:05 +0530
Subject: [PATCH] Debug symbols enabled in prplmesh

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 CMakeLists.txt                               | 3 ++-
 framework/platform/bpl/cfg/uci/bpl_cfg_uci.h | 1 -
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7dfa95ecc..6923d447a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -118,7 +118,7 @@ endif()
 
 # Default Compiler flags
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Werror -pthread -Wno-comment -Wno-unused-parameter -Wno-missing-field-initializers -fno-exceptions")
-set(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} -s -O2 -Wformat -Wformat-security -Wl,-S -fPIC -fPIE -fno-exceptions")
+set(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} -Wformat -Wformat-security -fPIC -fPIE -fno-exceptions")
 
 # Compiler specific flags
 if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER 9.1)
@@ -131,6 +131,7 @@ endif()
 # Release flags
 set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS} ${CMAKE_CXX_FLAGS}")
 set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} ${CMAKE_C_FLAGS_RELEASE}")
+set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_RELEASE} -g3 -O0 -DDEBUG")
 
 # Linker Options
 # - Setting the "rpath-link" linker variable to help the linker resolve secondery dependecies
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_uci.h b/framework/platform/bpl/cfg/uci/bpl_cfg_uci.h
index 47e7e0a93..c0fc87abc 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_uci.h
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_uci.h
@@ -40,7 +40,6 @@
 #define ERROR(fmt, args...) LOGF_LOG_ERROR(fmt, ##args)
 #define WARN(fmt, args...) LOGF_LOG_WARN(fmt, ##args)
 #define INFO(fmt, args...) LOGF_LOG_INFO(fmt, ##args)
-#define DEBUG(fmt, args...) LOGF_LOG_DEBUG(fmt, ##args)
 
 #define MAX_UCI_BUF_LEN 128
 
-- 
2.34.1

