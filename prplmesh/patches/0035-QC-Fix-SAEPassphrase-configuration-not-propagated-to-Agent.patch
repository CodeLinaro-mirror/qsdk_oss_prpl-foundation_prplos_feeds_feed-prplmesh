From 8871b9af00f2336adcb92dc37c8e0e0abda8b0b7 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 24 Jul 2025 23:16:28 +0530
Subject: [PATCH] 
 0035-QC-Fix-SAEPassphrase-configuration-not-propagated-to-Agent

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index b1f8488e1..0814ed4f7 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -663,10 +663,17 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         new_obj.add_child("ModeEnabled", security_mode);
         if (security_mode == "None") {
             new_obj.add_child("EncryptionMode", "Default");
+        } else if (security_mode == "WPA3-Personal" || security_mode == "WPA3-Personal-Transition") {
+            new_obj.add_child("EncryptionMode", encryption_mode);
+            new_obj.add_child("KeyPassPhrase", bss_info_conf.network_key);
+            new_obj.add_child("SAEPassphrase", bss_info_conf.network_key);
         } else {
             new_obj.add_child("EncryptionMode", encryption_mode);
             new_obj.add_child("KeyPassPhrase", bss_info_conf.network_key);
-        }
+            if (security_mode == "WPA3-Personal" || security_mode == "WPA2-WPA3-Personal")  {
+	      new_obj.add_child("SAEPassphrase", bss_info_conf.network_key);
+	}
+		}
         ret = m_ambiorix_cl.update_object(wifi_ap_sec_path, new_obj);
 
         if (!ret) {
