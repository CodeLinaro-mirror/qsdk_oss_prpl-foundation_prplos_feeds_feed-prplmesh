Subject: [PATCH] QC-Add-AKM-Suite-Capabilities-TLV

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 .../slave/tasks/capability_reporting_task.cpp |  5 ++
 agent/src/beerocks/slave/tlvf_utils.cpp       | 78 ++++++++++++++++++-
 agent/src/beerocks/slave/tlvf_utils.h         |  1 +
 3 files changed, 83 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
index 727c3054b..4a9fcf1b3 100644
--- a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
+++ b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
@@ -572,6 +572,11 @@ bool CapabilityReportingTask::prepare_ap_capability_message(bool early)
         return false;
     }
 
+    if (!tlvf_utils::add_akm_suite_capabilities(m_cmdu_tx)) {
+        LOG(ERROR) << "Error filling AKM_SUITE_CAPABILITIES";
+        return false;
+    }
+
     if (!early) {
         // 2.1 radio dependent tlvs
         // Add channel scan capabilities
diff --git a/agent/src/beerocks/slave/tlvf_utils.cpp b/agent/src/beerocks/slave/tlvf_utils.cpp
index 007786181..3ec1925d4 100644
--- a/agent/src/beerocks/slave/tlvf_utils.cpp
+++ b/agent/src/beerocks/slave/tlvf_utils.cpp
@@ -13,7 +13,7 @@
 #include <bcl/beerocks_utils.h>
 #include <bcl/son/son_wireless_utils.h>
 #include <easylogging++.h>
-
+#include <tlvf/wfa_map/tlvAkmSuiteCapabilities.h>
 #include <tlvf/wfa_map/tlvApRadioBasicCapabilities.h>
 #include <tlvf/wfa_map/tlvOperatingChannelReport.h>
 #include <tlvf/wfa_map/tlvSpatialReuseReport.h>
@@ -370,3 +370,79 @@ bool tlvf_utils::create_operating_channel_report(ieee1905_1::CmduMessageTx &cmdu
     LOG(DEBUG) << "Created Operating Channel Report TLV";
     return true;
 }
+
+bool tlvf_utils::add_akm_suite_capabilities(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto akm_suite_caps_tlv = cmdu_tx.addClass<wfa_map::tlvAkmSuiteCapabilities>();
+    if (!akm_suite_caps_tlv) {
+        LOG(ERROR) << "Error creating TLV_AKM_SUITE_CAPABILITIES";
+        return false;
+    }
+
+    auto db = AgentDB::get();
+
+    int radio_count = 0;
+    for (auto radio : db->get_radios_list()) {
+        if (radio)
+            radio_count++;
+    }
+
+    if (!akm_suite_caps_tlv->alloc_backhaul_bss_akm_suite_selectors(radio_count)) {
+        LOG(ERROR) << "Error unable to allocate " << radio_count << " backhaul suite selectors";
+    }
+
+    if (!akm_suite_caps_tlv->alloc_fronthaul_bss_akm_suite_selectors(radio_count)) {
+        LOG(ERROR) << "Error unable to allocate " << radio_count << " fronthaul suite selectors";
+    }
+
+    for (int idx = 0; idx < radio_count; idx++) {
+        auto bh_selector = akm_suite_caps_tlv->backhaul_bss_akm_suite_selectors(idx);
+        auto fh_selector = akm_suite_caps_tlv->fronthaul_bss_akm_suite_selectors(idx);
+
+        bool bh_ret = std::get<0>(bh_selector);
+        if (!bh_ret) {
+            LOG(ERROR) << "Error failed to get backhaul bss akm suite for idx " << idx;
+        }
+
+        bool fh_ret = std::get<0>(fh_selector);
+        if (!fh_ret) {
+            LOG(ERROR) << "Error failed to get fronthaul bss akm suite for idx " << idx;
+        }
+        if (bh_ret && fh_ret) {
+            auto &bh_suite_selector = std::get<1>(bh_selector);
+            auto &fh_suite_selector = std::get<1>(fh_selector);
+                switch (idx) {
+                case 0:
+
+                bh_suite_selector.oui = sVendorOUI(wfa_map::tlvAkmSuiteCapabilities::eAkmSuiteOUI::IEEE80211);
+                bh_suite_selector.oui.struct_swap();
+                bh_suite_selector.akm_suite_type = 0x02;
+                fh_suite_selector.oui = sVendorOUI(wfa_map::tlvAkmSuiteCapabilities::eAkmSuiteOUI::IEEE80211);
+                fh_suite_selector.oui.struct_swap();
+                fh_suite_selector.akm_suite_type = 0x02;
+                break;
+
+                case 1:
+
+                bh_suite_selector.oui = sVendorOUI(wfa_map::tlvAkmSuiteCapabilities::eAkmSuiteOUI::IEEE80211);
+                bh_suite_selector.oui.struct_swap();
+                bh_suite_selector.akm_suite_type = 0x08;
+                fh_suite_selector.oui = sVendorOUI(wfa_map::tlvAkmSuiteCapabilities::eAkmSuiteOUI::IEEE80211);
+                fh_suite_selector.oui.struct_swap();
+                fh_suite_selector.akm_suite_type = 0x08;
+                break;
+
+                case 2:
+
+                bh_suite_selector.oui = sVendorOUI(wfa_map::tlvAkmSuiteCapabilities::eAkmSuiteOUI::WEC);
+                bh_suite_selector.oui.struct_swap();
+                bh_suite_selector.akm_suite_type = 0x02;
+                fh_suite_selector.oui = sVendorOUI(wfa_map::tlvAkmSuiteCapabilities::eAkmSuiteOUI::WEC);
+                fh_suite_selector.oui.struct_swap();
+                fh_suite_selector.akm_suite_type = 0x02;
+                break;
+                }
+        }
+    }
+    return true;
+}
diff --git a/agent/src/beerocks/slave/tlvf_utils.h b/agent/src/beerocks/slave/tlvf_utils.h
index bfb55ea9f..17933aaf8 100644
--- a/agent/src/beerocks/slave/tlvf_utils.h
+++ b/agent/src/beerocks/slave/tlvf_utils.h
@@ -29,6 +29,7 @@ public:
                                                 const sMacAddr &ruid);
     static bool create_operating_channel_report(ieee1905_1::CmduMessageTx &cmdu_tx,
                                                 const sMacAddr &radio_mac);
+    static bool add_akm_suite_capabilities(ieee1905_1::CmduMessageTx &cmdu_tx); 
 };
 
 } // namespace beerocks
