From 9140e9a326da3aaa37377c52950fdadff8b7ccf7 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Tue, 11 Nov 2025 16:45:15 +0530
Subject: [PATCH] added timer to remove wpa_ctrl_socket for removing interface

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bcl/include/bcl/son/son_wireless_utils.h  |  2 +
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       |  2 +-
 .../bwl/nl80211/base_wlan_hal_nl80211.cpp     | 40 ++++++++++++++++++-
 3 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
index b8fff6e46..374bd6975 100644
--- a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
+++ b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
@@ -79,6 +79,8 @@ constexpr uint32_t BAND_6G_MAX_FREQ  = 7125U;
 #define OPCLASS_6GHZ_EXCEPTION 136
 #define OPCLASS_6GHZ_USING_CENTER_CHANNEL_LAST 137
 
+#define HOST_MIN_ML_RECONF_COUNT 5
+
 namespace son {
 class wireless_utils {
 public:
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index eda3529ec..5985c7310 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -2433,7 +2433,7 @@ bool ap_wlan_hal_nl80211::remove_mld_link(std::string &link_iface_name, sMacAddr
 /* For sanity check to remove link : End */
 
     std::stringstream remove_cmd;
-    remove_cmd << "LINK_REMOVE 45";
+    remove_cmd << "LINK_REMOVE " << HOST_MIN_ML_RECONF_COUNT;
     LOG(DEBUG) << "CMD framed : " << remove_cmd.str();
     if (!wpa_ctrl_send_msg(remove_cmd.str(), link_iface_name)) {
         LOG(ERROR) << "Failed to remove link: " << link_id << " of " << link_iface_name;
diff --git a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
index 23f7017e8..d15435ed0 100644
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -1027,6 +1027,7 @@ bool base_wlan_hal_nl80211::refresh_vaps_info(int id)
         }
     }
     LOG(DEBUG) << " active bss count present in STATUS for iface " << m_radio_info.iface_name << " : " << bss_count;
+
     // Try reading values of the requested VAP
     for (int bss_idx = 0; bss_idx < bss_count; bss_idx++) {
 	auto &vap_element = m_radio_info.available_vaps[vap_id];
@@ -1492,7 +1493,44 @@ bool base_wlan_hal_nl80211::remove_interface(const std::string &interface)
         LOG(WARNING) << "Failed to remove interface " << interface;
         return false;
     }
-    return true;
+
+    int retry_count = 30; // e.g., retry for 3 seconds (30 * 100ms)
+    std::string socket_path = "/var/run/hostapd/" + interface;
+    
+    auto start_time = std::chrono::steady_clock::now();
+
+   do {
+       retry_count--;
+       if (!beerocks::os_utils::wpa_ctrl_skt_exists(socket_path)) {
+           auto end_time = std::chrono::steady_clock::now();
+           auto diff_ms = std::chrono::duration_cast<std::chrono::milliseconds>(end_time - start_time).count();
+           LOG(DEBUG) << "Socket for interface " << interface << " removed from " << socket_path
+                      << " after " << diff_ms << " ms";
+           break;
+       } else {
+           LOG(DEBUG) << "Socket for interface " << interface << " still exists at " << socket_path;
+           std::this_thread::sleep_for(std::chrono::milliseconds(100));
+           if (retry_count <= 0) {
+               LOG(ERROR) << "Timeout waiting for socket removal!";
+               return false;
+           }
+       }
+   } while (retry_count > 0);
+
+   // Remove interface from active_bss list
+   auto &active_BSSs = m_radio_info.active_BSSs; 
+   
+   if (std::find(active_BSSs.begin(), active_BSSs.end(),interface) != active_BSSs.end()) {
+       active_BSSs.erase(
+           std::remove(active_BSSs.begin(), active_BSSs.end(),interface),
+           active_BSSs.end()
+       );
+       LOG(DEBUG) << interface << " removed from active_BSSs";
+   } else {
+       LOG(ERROR) << interface << " not found in active_BSSs";
+   }
+
+   return true;
 }
 
 const std::string base_wlan_hal_nl80211::get_iface_from_fd(int fd)
-- 
2.34.1

