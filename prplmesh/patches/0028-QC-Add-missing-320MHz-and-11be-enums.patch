From e725f18b7d07dd459fb4f91faa1fb30ffb8ecc83 Mon Sep 17 00:00:00 2001
From: Praveen Babu <pravbabu@qti.qualcomm.com>
Date: Mon, 9 Jun 2025 15:32:23 +0530
Subject: [PATCH] Add missing 320MHz and 11be enums

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 agent/src/beerocks/slave/tasks/channel_scan_task.cpp           | 2 ++
 common/beerocks/bcl/source/beerocks_utils.cpp                  | 1 +
 common/beerocks/bwl/include/bwl/mon_wlan_hal_types.h           | 2 ++
 common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp                 | 3 +++
 .../include/beerocks/tlvf/beerocks_message_common.h            | 1 +
 .../tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml       | 1 +
 controller/src/beerocks/master/db/db.cpp                       | 2 ++
 7 files changed, 12 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/channel_scan_task.cpp b/agent/src/beerocks/slave/tasks/channel_scan_task.cpp
index c3dedf236..f5eb88834 100644
--- a/agent/src/beerocks/slave/tasks/channel_scan_task.cpp
+++ b/agent/src/beerocks/slave/tasks/channel_scan_task.cpp
@@ -1380,6 +1380,8 @@ bool ChannelScanTask::send_channel_scan_report_to_controller(
                 return "80+80MHz";
             case beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_160MHz:
                 return "160MHz";
+            case beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_320MHz:
+                return "320MHz";
             case beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_NA:
             default:
                 LOG(DEBUG) << "Unknown BW value, setting 20MHz";
diff --git a/common/beerocks/bcl/source/beerocks_utils.cpp b/common/beerocks/bcl/source/beerocks_utils.cpp
index 7181397e5..dfc689907 100644
--- a/common/beerocks/bcl/source/beerocks_utils.cpp
+++ b/common/beerocks/bcl/source/beerocks_utils.cpp
@@ -293,6 +293,7 @@ std::string utils::convert_channel_ext_above_to_string(bool channel_ext_above_se
     case beerocks::BANDWIDTH_80:
     case beerocks::BANDWIDTH_80_80:
     case beerocks::BANDWIDTH_160:
+    case beerocks::BANDWIDTH_320:
     case beerocks::BANDWIDTH_320_1:
     case beerocks::BANDWIDTH_320_2:
         if (channel_ext_above_secondary) {
diff --git a/common/beerocks/bwl/include/bwl/mon_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/mon_wlan_hal_types.h
index 272b25828..953b73540 100644
--- a/common/beerocks/bwl/include/bwl/mon_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/mon_wlan_hal_types.h
@@ -352,6 +352,7 @@ enum class eChannelScanResultStandards : uint8_t {
     eStandard_802_11n  = 0x4,
     eStandard_802_11ac = 0x5,
     eStandard_802_11ax = 0x6,
+    eStandard_802_11be = 0x7,
 };
 
 enum class eChannelScanResultChannelBandwidth : uint8_t {
@@ -361,6 +362,7 @@ enum class eChannelScanResultChannelBandwidth : uint8_t {
     eChannel_Bandwidth_80MHz  = 0x3,
     eChannel_Bandwidth_160MHz = 0x4,
     eChannel_Bandwidth_80_80  = 0x5,
+    eChannel_Bandwidth_320MHz = 0x6,
 };
 
 typedef struct sChannelScanResults {
diff --git a/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp
index d51bb555d..8c5f61d19 100644
--- a/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp
@@ -148,6 +148,9 @@ get_scan_result_operating_standards_from_str(const std::string &standards_str)
     if (all_standards.find("ax") != all_standards.end()) {
         supported_standards.push_back(bwl::eChannelScanResultStandards::eStandard_802_11ax);
     }
+    if (all_standards.find("be") != all_standards.end()) {
+        supported_standards.push_back(bwl::eChannelScanResultStandards::eStandard_802_11be);
+    }
     return supported_standards;
 }
 
diff --git a/common/beerocks/tlvf/AutoGenerated/include/beerocks/tlvf/beerocks_message_common.h b/common/beerocks/tlvf/AutoGenerated/include/beerocks/tlvf/beerocks_message_common.h
index 81f578d3e..359311d05 100644
--- a/common/beerocks/tlvf/AutoGenerated/include/beerocks/tlvf/beerocks_message_common.h
+++ b/common/beerocks/tlvf/AutoGenerated/include/beerocks/tlvf/beerocks_message_common.h
@@ -1301,6 +1301,7 @@ enum eChannelScanResultChannelBandwidth: uint8_t {
     eChannel_Bandwidth_80MHz = 0x3,
     eChannel_Bandwidth_160MHz = 0x4,
     eChannel_Bandwidth_80_80 = 0x5,
+    eChannel_Bandwidth_320MHz = 0x6,
 };
 
 typedef struct sChannelScanResults {
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml
index fec8b105c..02b226701 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml
@@ -938,6 +938,7 @@ eChannelScanResultChannelBandwidth:
   eChannel_Bandwidth_80MHz: 3
   eChannel_Bandwidth_160MHz: 4
   eChannel_Bandwidth_80_80: 5
+  eChannel_Bandwidth_320MHz: 6
 
 sChannelScanResults:
   _type: struct
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 816332b79..d8f40e492 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -3965,6 +3965,8 @@ bool db::add_channel_report(const sMacAddr &RUID, const uint8_t &operating_class
             return beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_80_80;
         } else if (bw == "160Mz") {
             return beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_160MHz;
+        } else if (bw == "320Mz") {
+            return beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_320MHz;
         } else {
             return beerocks_message::eChannelScanResultChannelBandwidth::eChannel_Bandwidth_NA;
         }
-- 
2.34.1

