From 9294aae4cf59e64cde8f08a5e9314c3b42db478c Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 11 Aug 2025 14:10:32 +0530
Subject: [PATCH] UCI persist enable for wireless configs

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../bcl/include/bcl/son/son_wireless_utils.h  |  2 +
 common/beerocks/bwl/CMakeLists.txt            |  2 +-
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 45 ++++++++++--
 .../bwl/nl80211/ap_wlan_hal_nl80211.h         |  1 +
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 68 ++++++++++++++++++-
 5 files changed, 108 insertions(+), 10 deletions(-)

diff --git a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
index d7f03eb31..b1dc4ac8f 100644
--- a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
+++ b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
@@ -129,6 +129,8 @@ public:
         bool bSTA                                         = false;
         std::string backhaul_wps_ssid;
         std::string backhaul_wps_passphrase;
+        int freq_band                                     = -1;
+        std::string multi_ap;
     } sBssInfoConf;
 
     typedef struct {
diff --git a/common/beerocks/bwl/CMakeLists.txt b/common/beerocks/bwl/CMakeLists.txt
index c74da78fd..a03b9713c 100644
--- a/common/beerocks/bwl/CMakeLists.txt
+++ b/common/beerocks/bwl/CMakeLists.txt
@@ -204,7 +204,7 @@ endif()
 add_library(${PROJECT_NAME} ${bwl_common_sources} ${bwl_platform_sources})
 set_target_properties(${PROJECT_NAME} PROPERTIES LINK_FLAGS "-Wl,-z,defs")
 set_target_properties(${PROJECT_NAME} PROPERTIES VERSION ${prplmesh_VERSION} SOVERSION ${prplmesh_VERSION_MAJOR})
-target_link_libraries(${PROJECT_NAME} bcl elpp ${BWL_LIBS})
+target_link_libraries(${PROJECT_NAME} bcl elpp bpl ${BWL_LIBS})
 target_include_directories(${PROJECT_NAME}
     PRIVATE
         ${PLATFORM_INCLUDE_DIR}
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index a82268a42..a2454efb8 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -956,12 +956,34 @@ bool ap_wlan_hal_nl80211::sta_bss_steer(int8_t vap_id, const std::string &mac,
     return true;
 }
 
+void set_wifi_credentials_from_vap(const std::string &vap_id,
+                                   const son::wireless_utils::sBssInfoConf &bss_conf,
+                                   prplmesh::hostapd::Configuration &conf)
+{
+    // In the hostapd config file, the first VAP uses the key "interface", while additional VAPs use the key "bss"
+    const std::vector<std::string> bss_check = {"interface", "bss"};
+
+    for (const auto &key : bss_check) {
+        std::string bss = conf.get_vap_value(vap_id, key);
+        if (!bss.empty()) {
+            LOG(INFO) << "bss is: " << bss;
+            beerocks::bpl::bpl_cfg_set_wifi_credentials(bss, bss_conf);
+            LOG(INFO) << key << " found, UCI is set";
+            return;
+        } else {
+            LOG(INFO) << key << " not found";
+        }
+    }
+
+    LOG(ERROR) << "Neither 'interface' nor 'bss' found for VAP ID: " << vap_id;
+}
+
 bool ap_wlan_hal_nl80211::update_vap_credentials(
     std::list<son::wireless_utils::sBssInfoConf> &bss_info_conf_list,
     const std::string &backhaul_wps_ssid, const std::string &backhaul_wps_passphrase,
     const std::string &bridge_ifname)
 {
-    LOG(INFO) << "Update vap credentials: " << m_radio_info.iface_name;
+    LOG(INFO) << "Update vap credentials: " << m_radio_info.iface_name<<" freq of radio is: " << m_radio_info.frequency_band;
     // Load hostapd config for the radio
     prplmesh::hostapd::Configuration base_conf = load_hostapd_config(m_radio_info.iface_name,"");
     if (!base_conf) {
@@ -998,6 +1020,12 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
 
     for (auto &bss_it : bss_info_conf_list) {
         auto conf_bssid = tlvf::mac_to_string(bss_it.bssid);
+        bss_it.freq_band = m_radio_info.frequency_band;
+
+        if (bss_it.fronthaul && !backhaul_wps_ssid.empty()) {
+            bss_it.backhaul_wps_ssid = backhaul_wps_ssid;
+            bss_it.backhaul_wps_passphrase = backhaul_wps_passphrase;
+        }
 
         if (conf_bssid == beerocks::net::network_utils::WILD_MAC_STRING) {
             
@@ -1019,10 +1047,6 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
             new_vap_index++;
             bss_it.bssid = new_bssid;
             std::string bridge = "br-lan"; 
-            if (bss_it.fronthaul && !backhaul_wps_ssid.empty()) {
-                bss_it.backhaul_wps_ssid = backhaul_wps_ssid;
-                bss_it.backhaul_wps_passphrase = backhaul_wps_passphrase;
-            }
 
             if (!add_bss(new_vap_name,bss_it,bridge,false)) {
                 LOG(ERROR) << " Add bss failed for " << new_vap_name ;
@@ -1126,7 +1150,8 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 }
             }
             conf.set_create_vap_value(vap_id, "multi_ap", multi_ap);
-
+            //required to update uci wireless
+            bss_it.multi_ap = multi_ap;
             // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
             // quoted, while wpa_passphrase does not...
             if (bss_it.fronthaul && !backhaul_wps_ssid.empty()) {
@@ -1194,7 +1219,10 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 }
             }
             LOG(DEBUG) << "Autoconfiguration: done:\n" << conf;
+            //set uci persist for the particular vapid 
+            set_wifi_credentials_from_vap(vap_id, bss_it, conf);
         }
+
     }
 
     if (abort) {
@@ -1843,7 +1871,8 @@ int ap_wlan_hal_nl80211::add_bss(std::string &ifname, son::wireless_utils::sBssI
         }
     }
     conf.set_create_vap_value(vap_id, "multi_ap", multi_ap);
-
+    //required to update uci wireless
+    bss_conf.multi_ap = multi_ap;
     // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
     // quoted, while wpa_passphrase does not...
     if (bss_conf.fronthaul && !bss_conf.backhaul_wps_ssid.empty()) {
@@ -1887,6 +1916,8 @@ int ap_wlan_hal_nl80211::add_bss(std::string &ifname, son::wireless_utils::sBssI
         LOG(DEBUG) << "Failed to register and connect the new BSS interface!";
         return false;
     }
+    //set uci persist for the particular vapid
+    set_wifi_credentials_from_vap(vap_id, bss_conf, conf);
     return fd;
 }
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index 26312776a..23e187c4e 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -11,6 +11,7 @@
 
 #include "base_wlan_hal_nl80211.h"
 #include <bwl/ap_wlan_hal.h>
+#include <bpl/bpl_cfg.h>
 
 namespace bwl {
 namespace nl80211 {
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 2c4c80cbe..2cd31a1ff 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -391,8 +391,21 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
     }
 
     if (section_name.empty()) {
-        LOG(ERROR) << "Configuration for interface " << iface << " not found";
-        return false;
+        LOG(INFO) << "Section not found for interface " << iface << ", creating new section";
+        int iface_index = 0;
+        
+        // Generate a unique section name for the interface configuration
+        // Start with "iface_wlan" followed by an incrementing index (e.g., iface_wlan0, iface_wlan1, ...)
+        // Continue incrementing until a section name is found that does not already exist in the uci wireless file
+        do {
+            section_name = "iface_wlan" + std::to_string(iface_index++);
+        } while (uci_section_exists(package_name, section_type, section_name));
+
+        if (!uci_add_section(package_name, section_type, section_name, true)) {
+            LOG(ERROR) << "Failed to add new section for interface " << iface;
+            return false;
+        }
+        LOG(INFO)<<"uci_add_section added successfully";
     }
 
     // Overwrite UCI configuration with wireless credentials for the given interface
@@ -416,7 +429,58 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
     options["encryption"] =
         get_encryption(configuration.authentication_type, configuration.encryption_type);
 
+    // Set sae_pwe if encryption is SAE
+    if (options["encryption"] == "sae") {
+        options["sae_pwe"] = "2";
+    }
+
     options["key"] = configuration.network_key;
+    options["ifname"] = iface;
+    options["mode"] = "ap";
+    options["network"] = "lan";
+    if(!configuration.multi_ap.empty()) {
+    	options["multi_ap"] = configuration.multi_ap;
+        //wps_pushbutton for FH and bSTA
+        if ((configuration.multi_ap == "2" || configuration.multi_ap == "3")) {
+                options["wps_pushbutton"] = "1";
+        }
+    }
+    else {
+	    options["wds"] = "1"; //wds enabled only when multi_ap not present
+    }
+    if (!configuration.backhaul_wps_ssid.empty() && !configuration.backhaul_wps_passphrase.empty()) {
+    	options["multi_ap_backhaul_ssid"] = configuration.backhaul_wps_ssid;
+    	options["multi_ap_backhaul_key"]  = configuration.backhaul_wps_passphrase;
+    }
+    
+    //Get radio name using the frequency using already available frequency band
+    std::string band;
+    switch(configuration.freq_band) {
+	case 0:
+		band = "2g";
+		break;
+	case 1:
+		band = "5g";
+		break;
+	case 2:
+	case 3:
+	case 4:
+		band = "6g";
+		break;
+	default:
+		LOG(ERROR) << "Unknown frequency band: " << configuration.freq_band;
+		
+    }
+
+    std::string device_section;
+    
+    if (!band.empty() &&
+    	uci_find_section_by_option("wireless", "wifi-device", "band", band, device_section)) {
+        LOG(INFO) << "Found device section for band " << band << ": " << device_section;
+        options["device"] = device_section;
+    } else {
+    	LOG(ERROR) << "No matching wifi-device section found for band: " << band;
+    }
 
     // Write UCI options in the "wireless.wifi-iface" section for the given interface.
     if (!uci_set_section(package_name, section_type, section_name, options, true)) {
-- 
