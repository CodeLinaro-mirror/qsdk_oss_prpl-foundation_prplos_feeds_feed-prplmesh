From 9d5a2c5d6a5fd7920f559ad076f91c7dbd4f6ee9 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 23 Jul 2025 14:28:25 +0530
Subject: [PATCH 1/3] prplmesh NLHAL CMakList changes for NLHAL compilation and
 enable USE_PRPLMESH_NLHAL Macro

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 CMakeLists.txt                                |  3 +-
 .../beerocks/fronthaul_manager/CMakeLists.txt |  4 +++
 agent/src/beerocks/slave/CMakeLists.txt       |  4 +++
 common/beerocks/multi_vendor/CMakeLists.txt   |  4 +++
 controller/src/beerocks/master/CMakeLists.txt |  4 +++
 framework/platform/bpl/CMakeLists.txt         | 29 ++++++++++++++-----
 vendor_message/CMakeLists.txt                 |  4 +++
 7 files changed, 44 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index db4c8bcc3..7dfa95ecc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,7 +9,7 @@ if(NOT DEFINED TARGET_PLATFORM)
     set(TARGET_PLATFORM "linux")
 endif()
 
-option(KEEP_UCI_GENERAL_OPTIONS "Use UCI for management and certification mode" ON)
+option(KEEP_UCI_GENERAL_OPTIONS "Use UCI for management and certification mode" OFF)
 if (KEEP_UCI_GENERAL_OPTIONS)
     add_definitions(-DKEEP_UCI_GENERAL_OPTIONS)
 endif()
@@ -71,6 +71,7 @@ option (ENABLE_NBAPI "Build the northbound (high-level) API" ON)
 option (ENABLE_VBSS "Build with Virtual BSS support" ON)
 
 option(USE_PRPLMESH_WHM "Use prplMesh Wireless Hardware Manager" ON)
+option(USE_PRPLMESH_NLHAL "Use prplMesh NLHAL" ON)
 
 ## Generic checks and defaults
 
diff --git a/agent/src/beerocks/fronthaul_manager/CMakeLists.txt b/agent/src/beerocks/fronthaul_manager/CMakeLists.txt
index 0ed113c31..1c98c374d 100644
--- a/agent/src/beerocks/fronthaul_manager/CMakeLists.txt
+++ b/agent/src/beerocks/fronthaul_manager/CMakeLists.txt
@@ -29,6 +29,10 @@ if (USE_PRPLMESH_WHM)
     list(APPEND LIBS wbapi)
 endif()
 
+if (USE_PRPLMESH_NLHAL)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_NLHAL")
+endif()
+
 #FEATURE_PRE_ASSOCIATION_STEERING
 list(FIND FEATURES "FEATURE_PRE_ASSOCIATION_STEERING" _feature_pre_association_steering_index)
 if(${_feature_pre_association_steering_index} GREATER -1)
diff --git a/agent/src/beerocks/slave/CMakeLists.txt b/agent/src/beerocks/slave/CMakeLists.txt
index 6c611e562..e475767c5 100755
--- a/agent/src/beerocks/slave/CMakeLists.txt
+++ b/agent/src/beerocks/slave/CMakeLists.txt
@@ -26,6 +26,10 @@ if (USE_PRPLMESH_WHM)
     list(APPEND LIBS wbapi)
 endif()
 
+if (USE_PRPLMESH_NLHAL)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_NLHAL")
+endif()
+
 # UGW
 if (TARGET_PLATFORM STREQUAL "ugw")
 
diff --git a/common/beerocks/multi_vendor/CMakeLists.txt b/common/beerocks/multi_vendor/CMakeLists.txt
index 25e48fca9..a39eddef5 100644
--- a/common/beerocks/multi_vendor/CMakeLists.txt
+++ b/common/beerocks/multi_vendor/CMakeLists.txt
@@ -29,6 +29,10 @@ else ()
     list(APPEND multi_vendor_sources ${MODULE_PATH}/dummy/tlvf_airties_utils_dummy.cpp)
 endif()
 
+if (USE_PRPLMESH_NLHAL)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_NLHAL")
+endif()
+
 # Build the library
 add_library(${PROJECT_NAME} ${multi_vendor_sources})
 
diff --git a/controller/src/beerocks/master/CMakeLists.txt b/controller/src/beerocks/master/CMakeLists.txt
index 3de0c34a7..febbd3701 100644
--- a/controller/src/beerocks/master/CMakeLists.txt
+++ b/controller/src/beerocks/master/CMakeLists.txt
@@ -60,6 +60,10 @@ if (USE_PRPLMESH_WHM)
     list(APPEND LINKED_LIBS wbapi)
 endif()
 
+if (USE_PRPLMESH_NLHAL)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_NLHAL")
+endif()
+
 if (ENABLE_VBSS)
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DENABLE_VBSS")
 endif()
diff --git a/framework/platform/bpl/CMakeLists.txt b/framework/platform/bpl/CMakeLists.txt
index f6a045b28..9cd61d438 100644
--- a/framework/platform/bpl/CMakeLists.txt
+++ b/framework/platform/bpl/CMakeLists.txt
@@ -104,13 +104,24 @@ if (TARGET_PLATFORM STREQUAL "openwrt")
           ${MODULE_PATH}/arp/linux/*.c*
           ${MODULE_PATH}/dhcp/luci_rpc/*.c*
           ${MODULE_PATH}/db/uci/*.c*
-          ${MODULE_PATH}/cfg/dm/*.c*
           ${MODULE_PATH}/cfg/vendor/*.c*
           ${MODULE_PATH}/common/uci/*.c*
           ${MODULE_PATH}/board/system_ubus/*.c*
           ${MODULE_PATH}/service_prioritization/tc/service_prio_utils_tc.cpp
         )
 
+        if(USE_PRPLMESH_NLHAL)
+            file(GLOB_RECURSE uci_sources
+                ${MODULE_PATH}/cfg/uci/*.c*
+            )
+            list(APPEND bpl_platform_sources ${uci_sources})
+        else()
+            file(GLOB_RECURSE bpl_cfg_dm_sources
+                ${MODULE_PATH}/cfg/dm/*.c*
+            )
+            list(APPEND bpl_platform_sources ${dm_sources})
+        endif()
+
         if(KEEP_UCI_GENERAL_OPTIONS) 
             file(GLOB_RECURSE bpl_cfg_uci_sources
                 ${MODULE_PATH}/cfg/uci/*.c*
@@ -211,11 +222,13 @@ if (USE_PRPLMESH_WHM)
 
     list(APPEND BPL_LIBS wbapi)
 else ()
-    file(GLOB_RECURSE bpl_platform_sources
-        ${MODULE_PATH}/*/linux/*.c*
-	    ${MODULE_PATH}/service_prioritization/dummy/service_prio_utils_dummy.c*
-        ${MODULE_PATH}/cfg/dummy/*.c*
-    )
+    if(NOT DEFINED USE_PRPLMESH_NLHAL)
+        file(GLOB_RECURSE bpl_platform_sources
+            ${MODULE_PATH}/*/linux/*.c*
+                ${MODULE_PATH}/service_prioritization/dummy/service_prio_utils_dummy.c*
+            ${MODULE_PATH}/cfg/dummy/*.c*
+        )
+    endif()
 endif()
 
 # BPL configuration via nbapi
@@ -239,7 +252,9 @@ if (USE_PRPLMESH_WHM)
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_WHM")
     target_link_libraries(${PROJECT_NAME} PUBLIC wbapi)
 endif()
-
+if (USE_PRPLMESH_NLHAL)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_NLHAL")
+endif()
 # Install
 target_include_directories(${PROJECT_NAME}
     PUBLIC
diff --git a/vendor_message/CMakeLists.txt b/vendor_message/CMakeLists.txt
index dd9293113..b3150866a 100755
--- a/vendor_message/CMakeLists.txt
+++ b/vendor_message/CMakeLists.txt
@@ -26,6 +26,10 @@ else()
     )
 endif()
 
+if (USE_PRPLMESH_NLHAL)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PRPLMESH_NLHAL")
+endif()
+
 add_executable(${PROJECT_NAME} ${beerocks_vendor_message_sources})
 set_target_properties(${PROJECT_NAME} PROPERTIES LINK_FLAGS "-Wl,-z,defs")
 target_link_libraries(${PROJECT_NAME} bcl btl tlvf btlvf bwl bpl nbapi ${LIBS})
-- 
