From 8e11ef32b1f13d0fb07d8ede13746b7471d9a7b4 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Wed, 13 Aug 2025 02:59:05 +0530
Subject: [PATCH] [NLHAL] Wi-Fi 7 Agent capabilities TLV support

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../beerocks/bwl/include/bwl/nl80211_client.h | 13 +++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 14 ++++++
 .../bwl/shared/nl80211_client_impl.cpp        | 50 +++++++++++++++++--
 .../beerocks/bwl/shared/nl80211_client_impl.h |  8 +++
 4 files changed, 82 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/include/bwl/nl80211_client.h b/common/beerocks/bwl/include/bwl/nl80211_client.h
index dbbc388be..5ffc61dca 100644
--- a/common/beerocks/bwl/include/bwl/nl80211_client.h
+++ b/common/beerocks/bwl/include/bwl/nl80211_client.h
@@ -341,6 +341,17 @@ public:
         }
     };
 
+    struct eht_info {
+	    bool eht_supported = false;
+	    struct sMloModesSupport {
+		    bool str_support;
+		    bool nstr_support;
+		    bool emlsr_support;
+		    bool emlmr_support;
+	    } ap_modes_support, bsta_modes_support;
+
+    };
+
     /**
      * @brief Radio information
      *
@@ -353,8 +364,10 @@ public:
          * Bands included in this radio (obtained from NL80211_ATTR_WIPHY_BANDS)
          */
         std::vector<band_info> bands;
+	struct eht_info eht_cfg;
     };
 
+
     /**
      * @brief Station information
      *
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index a2454efb8..e5adeb43e 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -598,6 +598,20 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
         return false;
     }
 
+    if (radio_info.eht_cfg.eht_supported) {
+               m_radio_info.eht_supported = radio_info.eht_cfg.eht_supported;
+               m_radio_info.ap_modes_support.emlmr_support = radio_info.eht_cfg.ap_modes_support.emlmr_support;
+               m_radio_info.ap_modes_support.emlsr_support = radio_info.eht_cfg.ap_modes_support.emlsr_support;
+               m_radio_info.ap_modes_support.nstr_support = radio_info.eht_cfg.ap_modes_support.emlsr_support;
+               m_radio_info.ap_modes_support.str_support = radio_info.eht_cfg.ap_modes_support.emlsr_support;
+
+               m_radio_info.bsta_modes_support.emlmr_support = radio_info.eht_cfg.bsta_modes_support.emlmr_support;
+               m_radio_info.bsta_modes_support.emlsr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
+               m_radio_info.bsta_modes_support.nstr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
+               m_radio_info.bsta_modes_support.str_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
+    }
+
+
     return base_wlan_hal_nl80211::refresh_radio_info();
 } // namespace nl80211
 
diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index cc154b824..05bab2b9d 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -335,9 +335,7 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
             }
 #endif
 
-            if (!tb[NL80211_ATTR_WIPHY_BANDS]) {
-                return;
-            }
+          if (tb[NL80211_ATTR_WIPHY_BANDS]) {
 
             struct nlattr *nl_band;
             int rem_band;
@@ -724,6 +722,52 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
                     band.supported_channels[channel.number] = channel;
                 }
             }
+	  }
+
+	  if (tb[NL80211_ATTR_IFTYPE_EXT_CAPA]) {
+		  radio_info.eht_cfg.eht_supported = 1;
+		  struct nlattr* nl_ext_capa;
+		  int rem_band;
+		  const struct nlattr* nla = tb[NL80211_ATTR_IFTYPE_EXT_CAPA];
+
+		  nla_for_each_attr(nl_ext_capa, static_cast<struct nlattr*>(nla_data(nla)), nla_len(nla), rem_band) {
+			  struct nlattr* tb_ext_capa[NL80211_ATTR_MAX + 1];
+
+			  if (nla_parse(tb_ext_capa, NL80211_ATTR_MAX,
+						  static_cast<struct nlattr*>(nla_data(nl_ext_capa)),
+						  nla_len(nl_ext_capa), NULL)) {
+				  LOG(ERROR) << "Failed to parse Ext capability";
+				  return;
+			  }
+
+			  uint32_t nlIfType = 0;
+			  if (tb_ext_capa[NL80211_ATTR_IFTYPE]) {
+				  nlIfType = nla_get_u32(tb_ext_capa[NL80211_ATTR_IFTYPE]);
+			  } else {
+				  LOG(ERROR) << "tb_ext_capa[NL80211_ATTR_IFTYPE] not available";
+			  }
+
+			  if (tb_ext_capa[NL80211_ATTR_EML_CAPABILITY]) {
+				  ehtEmlCapInfo_t emlCapInfo = {};
+				  uint16_t eml_cap = nla_get_u16(tb_ext_capa[NL80211_ATTR_EML_CAPABILITY]);
+				  memcpy(&emlCapInfo, static_cast<const void*> (&eml_cap), sizeof(emlCapInfo));
+				  if (nlIfType == NL80211_IFTYPE_AP) {
+					  radio_info.eht_cfg.ap_modes_support.emlsr_support = emlCapInfo.emlsr_support;
+					  radio_info.eht_cfg.ap_modes_support.emlmr_support = emlCapInfo.emlmr_support;
+					  LOG(DEBUG) << "radio_info.eht_cfg.ap_modes_support.emlsr_support :" << radio_info.eht_cfg.ap_modes_support.emlsr_support << "\n";
+					  LOG(DEBUG) << "radio_info.eht_cfg.ap_modes_support.emlmr_support :" << radio_info.eht_cfg.ap_modes_support.emlmr_support << "\n";
+				  } else if (nlIfType == NL80211_IFTYPE_STATION) {
+					  radio_info.eht_cfg.bsta_modes_support.emlsr_support = emlCapInfo.emlsr_support;
+					  radio_info.eht_cfg.bsta_modes_support.emlmr_support = emlCapInfo.emlmr_support;
+					  LOG(DEBUG) << "radio_info.eht_cfg.bsta_modes_support.emlsr_support :" << radio_info.eht_cfg.bsta_modes_support.emlsr_support << "\n";
+					  LOG(DEBUG) << "radio_info.eht_cfg.bsta_modes_support.emlmr_support :" << radio_info.eht_cfg.bsta_modes_support.emlmr_support << "\n";
+				  }
+			  } else {
+				  LOG(ERROR) << "tb_ext_capa[NL80211_ATTR_EML_CAPABILITY] not available";
+			  }
+		  }
+	  }
+
         });
 }
 
diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.h b/common/beerocks/bwl/shared/nl80211_client_impl.h
index da692ed2e..768425379 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.h
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.h
@@ -182,6 +182,14 @@ public:
 
     virtual bool create_new_interface(std::string &vap_name) override;
 
+    struct ehtEmlCapInfo_t {
+	    uint16_t emlsr_support:1;
+	    uint16_t b_1_6:6;
+	    uint16_t emlmr_support:1;
+	    uint16_t b_8_15:8;
+    } __attribute__((packed));
+
+
 private:
     /**
      * NL80211 socket to send messages and receive responses to/from the WiFi driver.
-- 
2.34.1

