From e6d0ca0bd7884e1933312a2ba8d71e6c68a19c8b Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Fri, 22 Aug 2025 09:32:17 +0530
Subject: [PATCH 1/2] fetch-mld-id-from-platform

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 2cd31a1ff..86bf5416c 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -73,6 +73,31 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
 
     configuration.network_key = options["key"];
 
+    
+    auto get_mld_id = [&](const std::string &mld) {
+	if (mld.empty()) {
+	    return -1;
+	}
+	std::string mld_index_str;
+	for (char ch : mld) {
+	    if (isdigit(ch)) {
+	        mld_index_str += ch;
+	    }
+	}
+	if (mld_index_str.empty()) {
+	    return -1;
+	}
+	int mld_index = std::stoi(mld_index_str);
+	MAPF_DBG("Section_name:" << section_name << " mld_index: " << mld_index);
+	return mld_index;
+    };
+
+    if (options.find("mld") == options.end()) {
+	    MAPF_DBG("Section_name: " << section_name << " - No MLD option in this bss conf section");
+    } else {
+	    configuration.mld_id = get_mld_id(options["mld"]);
+    }
+
     return true;
 }
 
