+
 sSonConfig:
   _type: struct
   monitor_total_ch_load_notification_lo_th_percent: uint8_t
@@ -260,6 +267,8 @@ sNodeHostap:
     _type: uint8_t
     _length: ["beerocks::message::HE_MCS_SET_SIZE"]
