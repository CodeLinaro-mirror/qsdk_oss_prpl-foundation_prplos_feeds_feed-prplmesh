From 5d42d20691c92926110ef0358bd4f59c0df4aa86 Mon Sep 17 00:00:00 2001
From: Praveen Babu <pravbabu@qti.qualcomm.com>
Date: Mon, 23 Jun 2025 13:26:34 +0530
Subject: [PATCH] QC-Add-Agent-AP-MLD-TLV-MLDUnit-HAL-changes

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp                | 1 +
 agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp | 1 +
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp                  | 2 ++
 3 files changed, 4 insertions(+)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index b8f6e0f13..5a9568383 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -2046,6 +2046,7 @@ bool slave_thread::handle_cmdu_backhaul_manager_message(
                 wifi_credentials->set_network_key("");
                 wifi_credentials->authentication_type_attr().data = WSC::eWscAuth::WSC_AUTH_INVALID;
                 wifi_credentials->encryption_type_attr().data     = WSC::eWscEncr::WSC_ENCR_INVALID;
+                wifi_credentials->mld_id()                        = -1; // reset MLDUnit
                 request_out->add_wifi_credentials(wifi_credentials);
             }
             send_cmdu(radio_manager.ap_manager_fd, cmdu_tx);
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 642610ad0..650d8c696 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2531,6 +2531,7 @@ bool ApAutoConfigurationTask::send_ap_bss_configuration_message(
            << "- Key: " << config.network_key << std::endl
            << "- Auth: " << std::hex << int(config.auth_type) << std::endl
            << "- Encr: " << std::hex << int(config.encr_type) << std::endl
+           << "- MLDUnit: " << int(config.mld_id) << std::endl
            << "- Hidden_SSID: " << config.hidden_ssid << std::endl;
 
         c->set_ssid(config.ssid);
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 0f0cf1a6d..b1f8488e1 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -623,6 +623,7 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         }
 
         LOG(DEBUG) << "Autoconfiguration for ssid: " << bss_info_conf.ssid
+                   << " mld_id: " << bss_info_conf.mld_id
                    << " auth_type: " << auth_type << " encr_type: " << enc_type
                    << " network_key: " << bss_info_conf.network_key
                    << " fronthaul: " << bss_info_conf.fronthaul
@@ -644,6 +645,7 @@ bool ap_wlan_hal_whm::update_vap_credentials(
 
         new_obj.set_type(AMXC_VAR_ID_HTABLE);
         new_obj.add_child("SSID", bss_info_conf.ssid);
+        new_obj.add_child("MLDUnit", bss_info_conf.mld_id);
         ret = m_ambiorix_cl.update_object(wifi_ssid_path, new_obj);
 
         if (!ret) {
-- 
