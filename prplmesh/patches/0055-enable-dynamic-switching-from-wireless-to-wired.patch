@@ -529,6 +529,24 @@ void sta_wlan_hal_nl80211::update_status(const ConnectionStatus &connection_stat
 
 bool sta_wlan_hal_nl80211::clear_non_associated_devices() { return true; }
 
+bool sta_wlan_hal_nl80211::disconnect_backhaul_sta() { return wpa_ctrl_send_msg("DISCONNECT"); }
+
+bool sta_wlan_hal_nl80211::reconnect_backhaul_sta() { return wpa_ctrl_send_msg("RECONNECT"); }
+
+bool sta_wlan_hal_nl80211::is_disconnected()
+{
+    ConnectionStatus connection_status;
+    constexpr int max_retries = 10;
+    int retry                 = 0;
+    while ((!read_status(connection_status)) && (retry++ < max_retries)) {
+        LOG(ERROR) << "Failed to read connection status, retry: " << retry;
+        usleep(1000);
+    }
+
+    return (connection_status.wpa_state.compare("DISCONNECTED") == 0);
+}
+
