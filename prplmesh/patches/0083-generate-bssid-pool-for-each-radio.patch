+void ap_wlan_hal_nl80211::generate_bssid_pool()
+{
+    VAPElement vap_element;
 
+    parsed_obj_map_t reply;
+
+    int mbssid = 0;
+
+    int mbssid_group_size = 0;
+
+    sMacAddr mask;
+
+    std::string type;
+
+    std::string base_mask = "ff:ff:ff:ff:ff:ff";
+
+    mask = tlvf::mac_from_string(base_mask);
+
+    sMacAddr base_mac;
+            
+    sMacAddr new_bssid;
+
+    if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
+        mbssid = 3;
+        mbssid_group_size = 4;
+    }
+
+
+    if (wpa_ctrl_send_msg("STATUS", reply)) {
+        LOG(INFO) << __func__ << " STATUS Success";
+
+        // Try reading values of base bss mac
+        vap_element.mac  = reply["bssid[" + std::to_string(0) + "]"];
+
+        base_mac = tlvf::mac_from_string(vap_element.mac);
+
+        LOG(INFO) << "Base BSS Mac: " << vap_element.mac;
+        m_radio_info.bssid_pool[vap_element.mac] = true;
+    } else {
+        LOG(ERROR) << __func__ << " STATUS Failed";
+        return;
+    }
+
+    
+    // Generate BSSID based on maximum BSS support (1 For STA Vap + 15 AP Vap) on the radio
+    for (int idx = 1; idx < m_radio_info.radio_max_bss_supported; idx++) {
+
+        int bss_idx = idx;
+     
+        // first assign base mac as new_bssid
+        new_bssid = base_mac;
+
+        //int num_global = 0;
+        int use_global = 0;
+
+        int maxbssid_ind = 0;
+
+        int num_bss_nontx = 0;
+
+        int maxbssid = 0;
+
+        if (mbssid) {
+            num_bss_nontx = mbssid_group_size - 1;
+            while (num_bss_nontx > 0) {
+                    maxbssid_ind++;
+                    num_bss_nontx >>= 1;
+            }
+        }
+        maxbssid = std::pow(2,maxbssid_ind);
+        if (mbssid && bss_idx >= maxbssid) {
+            new_bssid.oct[5] = ((new_bssid.oct[5] >> maxbssid_ind) << maxbssid_ind);
+            new_bssid.oct[5] = new_bssid.oct[5] + (bss_idx / maxbssid) * maxbssid;
+            bss_idx = bss_idx % maxbssid;
+        }
+
+        if (mbssid){
+            type = "b5";
+        } else if (use_global) {
+            type = "add";
+        } else if (mask.oct[0] > 0) {
+            type = "b1";
+        } else if (mask.oct[5] < 0xff){
+            type = "b5";
+        } else {
+            type = "add";
+        }
+        LOG(INFO) << "type: " << type;
+
+        if (type == "b1") {
+            if (!(new_bssid.oct[0] & 2)){
+                bss_idx--;
+            }
+            new_bssid.oct[0] |= 2;
+            new_bssid.oct[0] ^= bss_idx << 2;
+        } else if (type == "b5") {
+            if (mbssid) {
+                new_bssid.oct[0] |= 2;
+                int size = maxbssid;
+                int B = new_bssid.oct[5] % size;
+                int loct = new_bssid.oct[5];
+                new_bssid.oct[5] = loct - B + ((B+bss_idx) % size);
+            } else {
+                new_bssid.oct[5] ^= bss_idx;
+            }
+        } else {
+            for (int i = 5; i > 0; i--) {
+                new_bssid.oct[i] += bss_idx;
+                new_bssid.oct[i] %= 256;
+            }
+        }
+        LOG(INFO) << "generated new_bssid: " << new_bssid << " idx: " << idx; 
+        std::string bssid = tlvf::mac_to_string(new_bssid);  
+        m_radio_info.bssid_pool[bssid] = false;
+    }
+
+    // check for STA vap bssid in radio
+    int radio_id = 0;
+    switch (m_radio_info.frequency_band) {
+        case beerocks::FREQ_24G: radio_id = 0; break;
+        case beerocks::FREQ_5G: radio_id = 1;  break;
+        case beerocks::FREQ_6G: radio_id = 2;  break;
+        default: break;
+    }
+
+    char sta_iface[BPL_IFNAME_LEN] = "";
+    if (beerocks::bpl::cfg_get_sta_iface_with_radio_id(radio_id,sta_iface) < 0) {
+        LOG(ERROR) << " Failed to get latest sta iface" ;
+        return;
+    }
+    std::string updated_iface(sta_iface);
+    std::string sta_mac;
+    if (!beerocks::net::network_utils::linux_iface_exists(updated_iface)) {
+        LOG(DEBUG) << "sta_iface " << updated_iface << " is not present";
+        return;
+    } else {
+        LOG(DEBUG) << "sta_iface " << updated_iface << " is present - get bssid";
+        //TODO: [NLHAL] - Needs to handle MLD BSTA case
+        if (m_nl80211_client->get_sta_iface_mac(updated_iface,sta_mac)) {
+            LOG(DEBUG) << " STA_IFACE: " << updated_iface << " STA_MAC: " << sta_mac;
+            m_radio_info.bssid_pool[sta_mac] = true;
+        }
+
+    }
+
+}
 
 
 } // namespace nl80211
