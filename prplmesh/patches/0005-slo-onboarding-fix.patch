+void ap_wlan_hal_nl80211::generate_new_bssid(uint16_t new_vap_index,sMacAddr &new_bssid)
+{
+    LOG(INFO) << "vap index: " << new_vap_index;
+    VAPElement vap_element;
+
+    parsed_obj_map_t reply;
+
+    int mbssid = 0;
+
+    int mbssid_group_size = 0;
+
+    //int num_global = 0;
+    int use_global = 0;
+
+    int maxbssid_ind = 0;
+
+    int num_bss_nontx = 0;
+
+    int maxbssid = 0;
+
+    sMacAddr mask;
+
+    std::string type;
+
+    std::string base_mask = "ff:ff:ff:ff:ff:ff";
+
+    mask = tlvf::mac_from_string(base_mask);
+
+    if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
+        mbssid = 3;
+        mbssid_group_size = 4;
+    }
+
+    if (m_radio_info.sta_enabled) {
+        new_vap_index += 1;
+        LOG(INFO) << "STA intreface is present in " << m_radio_info.iface_name << " new_vap index: " << new_vap_index;
+    }
+
+    if (wpa_ctrl_send_msg("STATUS", reply)) {
+        LOG(INFO) << __func__ << " STATUS Success";
+
+        // Try reading values of base bss mac
+        vap_element.mac  = reply["bssid[" + std::to_string(0) + "]"];
+
+        new_bssid = tlvf::mac_from_string(vap_element.mac);
+
+        LOG(INFO) << "Base BSS Mac: " << vap_element.mac;
+
+        if (mbssid) {
+            num_bss_nontx = mbssid_group_size - 1;
+            while (num_bss_nontx > 0) {
+                    maxbssid_ind++;
+                    num_bss_nontx >>= 1;
+            }
+        }
+        maxbssid = std::pow(2,maxbssid_ind);
+        if (mbssid && new_vap_index >= maxbssid) {
+            new_bssid.oct[5] = ((new_bssid.oct[5] >> maxbssid_ind) << maxbssid_ind);
+            new_bssid.oct[5] = new_bssid.oct[5] + (new_vap_index / maxbssid) * maxbssid;
+            new_vap_index = new_vap_index % maxbssid;
+        }
+
+        if (mbssid){
+            type = "b5";
+        } else if (use_global) {
+            type = "add";
+        } else if (mask.oct[0] > 0) {
+            type = "b1";
+        } else if (mask.oct[5] < 0xff){
+            type = "b5";
+        } else {
+            type = "add";
+        }
+        LOG(INFO) << "type: " << type;
+
+        if (type == "b1") {
+            if (!(new_bssid.oct[0] & 2)){
+                new_vap_index--;
+            }
+            new_bssid.oct[0] |= 2;
+            new_bssid.oct[0] ^= new_vap_index << 2;
+        } else if (type == "b5") {
+            if (mbssid) {
+                new_bssid.oct[0] |= 2;
+                int size = maxbssid;
+                int B = new_bssid.oct[5] % size;
+                int loct = new_bssid.oct[5];
+                new_bssid.oct[5] = loct - B + ((B+new_vap_index) % size);
+            } else {
+                new_bssid.oct[5] ^= new_vap_index;
+            }
+        } else {
+            for (int i = 5; i > 0; i--) {
+                new_bssid.oct[i] += new_vap_index;
+                new_bssid.oct[i] %= 256;
+            }
+        }
+    } else {
+        LOG(ERROR) << __func__ << " STATUS Failed";
+    }
+    LOG(INFO) << "new_bssid: " << new_bssid;
+}
+
