+}
+
+void Configuration::remove_bss_config(const std::string &vap_name)
+{
+
+     m_hostapd_config_vaps.erase(
+        std::remove_if(
+            m_hostapd_config_vaps.begin(),
+            m_hostapd_config_vaps.end(),
+            [&vap_name] (const std::pair<std::string,std::vector<std::string>>&item){
+                return item.first == vap_name;
+            }
+        ),
+        m_hostapd_config_vaps.end()
+    );
+}
