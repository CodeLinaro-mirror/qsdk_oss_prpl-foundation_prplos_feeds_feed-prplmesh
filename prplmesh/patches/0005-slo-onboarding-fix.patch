@@ -637,6 +639,79 @@ bool Monitor::monitor_fsm()
                     notification->vap_id() = beerocks::IFACE_RADIO_ID;
                     send_cmdu(cmdu_tx);
                     return true;
+#else
+                    // Try to reattach hostapd
+                    auto reattach_timeout = std::chrono::steady_clock::now() + std::chrono::seconds(HOSTAP_REATTACH_TIMEOUT_SEC);
+                    bool hostapd_reattach = false;
+                    while ((std::chrono::steady_clock::now() < reattach_timeout) && (!hostapd_reattach))  {
+                        UTILS_SLEEP_MSEC(500);
+                        std::string remove_iface = mon_wlan_hal->get_radio_info().iface_name;
+                        LOG(DEBUG) << "Removing monitor wpa ctrl socket for " << remove_iface;
+                        for (auto &fd : m_mon_hal_ext_events) {
+                              if (fd > 0) {
+                                  m_event_loop->remove_handlers(fd);
+                              }
+                        }
+
+                        m_mon_hal_ext_events = {beerocks::net::FileDescriptor::invalid_descriptor};
+
+                        if (!mon_wlan_hal->remove_ctrl_skt(remove_iface)) {
+                            LOG(ERROR) << "Failed to remove the BSS!";
+                            return false;
+                        }
+
+                        hostapd_reattach = mon_wlan_hal->create_wpa_ctrl_skt(remove_iface);
+                    }
+                   
+                    if( (!hostapd_reattach) || (!mon_wlan_hal->refresh_vaps_info()))  { 
+                        auto notification = message_com::create_vs_message<
+                            beerocks_message::cACTION_MONITOR_HOSTAP_AP_DISABLED_NOTIFICATION>(cmdu_tx);
+                        if (notification == nullptr) {
+                            LOG(ERROR) << "Failed building "
+                                          "cACTION_MONITOR_HOSTAP_AP_DISABLED_NOTIFICATION message!";
+                            return false;
+                        }
+
+                        notification->vap_id() = beerocks::IFACE_RADIO_ID;
+                        send_cmdu(cmdu_tx);
+                        return true;
+                    } else {
+
+                        // link specific socket creation to connect hostapd
+                        const auto &active_vaps = mon_wlan_hal->get_radio_info().available_vaps;
+
+                        int vap_count = active_vaps.size();
+                        LOG(DEBUG) << "Active vap_count: " << vap_count;
+
+                        for (int vap_id = 0; vap_id < vap_count; vap_id++) {
+                            const auto &mapped_vap_element = active_vaps.at(vap_id);
+                            if (!mapped_vap_element.bss.empty()) {
+                                if(mapped_vap_element.num_links != -1) {
+                                    int8_t num_links = mapped_vap_element.num_links;
+                                    for (int it = 0; it < num_links; it++) {
+                                        std::string link_sock = mapped_vap_element.bss + "_link" + std::to_string(it);
+                                        mon_wlan_hal->create_wpa_ctrl_skt(link_sock);
+                                    }
+                                }
+                            }
+                        }
+
+                        // external event registration for all vaps
+                        m_mon_hal_ext_events = mon_wlan_hal->get_ext_events_fds();
+                        if (!m_mon_hal_ext_events.empty()) {
+                            for (auto &ext_event_fd : m_mon_hal_ext_events) {
+                                if (ext_event_fd < 0) {
+                                    ext_event_fd = beerocks::net::FileDescriptor::invalid_descriptor;
+                                    continue;
+                                }
+                                LOG(DEBUG) << "After hostapd reattach vap External events queue with fd = " << ext_event_fd;
+                                if (!register_ext_events_handlers(ext_event_fd)) {
+                                    LOG(DEBUG) << "External events queue with fd = " << ext_event_fd << " is already registered ";               
+                                }
+                            }
+                        }
+                    }
+#endif
                 }
             }
 
@@ -2404,3 +2479,46 @@ void Monitor::send_steering_return_status(beerocks_message::eActionOp_MONITOR Ac
     return;
 }
 #endif //FEATURE_PRE_ASSOCIATION_STEERING
+
+bool Monitor::register_ext_events_handlers(int fd)
+{
+    beerocks::EventLoop::EventHandlers ext_events_handlers{
+        .name = "mon_hal_ext_events",
+        .on_read =
+            [&](int fd, EventLoop &loop) {
+                if (!mon_wlan_hal->process_ext_events(fd)) {
+                    LOG(ERROR) << "process_ext_events(" << fd << " failed!";
+                    return false;
+                }
+                return true;
+            },
+        .on_write = nullptr,
+        .on_disconnect =
+            [&](int fd, EventLoop &loop) {
+                LOG(ERROR) << "mon_hal_ext_events disconnected! on fd " << fd;
+                auto it = std::find(m_mon_hal_ext_events.begin(),
+                                    m_mon_hal_ext_events.end(), fd);
+                if (it != m_mon_hal_ext_events.end()) {
+                    *it = beerocks::net::FileDescriptor::invalid_descriptor;
+                }
+                return false;
+            },
+        .on_error =
+            [&](int fd, EventLoop &loop) {
+                LOG(ERROR) << "mon_hal_ext_events error! on fd " << fd;
+                auto it = std::find(m_mon_hal_ext_events.begin(),
+                                    m_mon_hal_ext_events.end(), fd);
+                if (it != m_mon_hal_ext_events.end()) {
+                    *it = beerocks::net::FileDescriptor::invalid_descriptor;
+                }
+                return false;
+            },
+    };
+    if (!m_event_loop->register_handlers(fd, ext_events_handlers)) {
+        LOG(ERROR) << "Unable to register handlers for external events fd "
+                   << fd;
+        return false;
+    }
+
+     return true;
+}
