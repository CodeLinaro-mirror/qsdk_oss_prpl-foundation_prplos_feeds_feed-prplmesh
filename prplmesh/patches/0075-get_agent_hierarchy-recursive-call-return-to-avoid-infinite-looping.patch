From 59ccab49ae301a1af579a6baa6198b92f095a323 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Tue, 28 Oct 2025 10:31:55 +0530
Subject: [PATCH] get_agent_hierarchy recursive call return to avoid infinity
 looping

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 controller/src/beerocks/master/db/db.cpp      | 38 ++++++++++++++++---
 controller/src/beerocks/master/db/db.h        |  2 +-
 .../tasks/ire_network_optimization_task.cpp   |  1 +
 3 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 962496370..752111fbc 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -1088,19 +1088,37 @@ std::vector<std::shared_ptr<Agent>> db::get_all_connected_agents()
 
 std::set<std::string> db::get_backhauls_from_hierarchy(int hierarchy)
 {
-    std::set<std::string> result;
+    LOG(INFO) << "=== AGENT RELATIONSHIPS DEBUG ===";
+    
+    for (const auto &agent_pair : m_agents) {
+        auto &agent = agent_pair.second;
+        auto parent = agent->backhaul.parent_agent.lock();
+        
+        LOG(INFO) << "Agent: " << agent->al_mac 
+                  << " | Is Gateway: " << agent->is_gateway
+                  << " | Parent: " << (parent ? parent->al_mac : network_utils::ZERO_MAC)
+                  << " | Parent MAC string: " << agent->parent_mac;
+    }
 
+    LOG(INFO) << "=== END DEBUG ===";
+
+    std::set<std::string> result;
+    LOG(INFO) << "get_backhauls_from_hierarchy: " << hierarchy;
     if (hierarchy < 0 || hierarchy >= HIERARCHY_MAX) {
         LOG(ERROR) << "invalid hierarchy";
         return result;
     }
 
     for (const auto &agent : m_agents) {
-        if (get_agent_hierarchy(agent.first) == hierarchy) {
+        int agent_hierarchy = get_agent_hierarchy(agent.first);
+        LOG(DEBUG) << "Agent " << agent.first << " hierarchy: " << agent_hierarchy;
+        if (agent_hierarchy == hierarchy) {
+            LOG(INFO) << "Adding agnet " << agent.first << " parent: " << agent.second->parent_mac;
             result.insert(tlvf::mac_to_string(agent.second->parent_mac));
+            LOG(INFO) << "result has been inserted";
         }
     }
-
+    LOG(DEBUG) << "Found " << result.size() << " backhauls for hierarchy " << hierarchy;
     return result;
 }
 
@@ -6011,16 +6029,26 @@ bool db::dm_set_sta_link_metrics(const sMacAddr &sta_mac, uint32_t downlink_est_
 // PRIVATE FUNCTIONS
 //   must be used from a thread safe context
 //
-int db::get_agent_hierarchy(const sMacAddr &al_mac)
+int db::get_agent_hierarchy(const sMacAddr &al_mac, int depth)
 {
+    if(depth >= HIERARCHY_MAX){
+        LOG(ERROR) << "Loop exceeding, terminating recursive call";
+        return -1;
+    }
+
+    LOG(INFO) << "get_agent_hierarchy: " << "al_mac: " << tlvf::mac_to_string(al_mac);
     std::shared_ptr<Agent> agent = get_agent(al_mac);
     if (!agent) {
+        LOG(ERROR) << "Agent not found for MAC: " << tlvf::mac_to_string(al_mac);
         return -1;
     } else {
         std::shared_ptr<Agent> parent_agent = agent->backhaul.parent_agent.lock();
         if (parent_agent) {
-            return get_agent_hierarchy(parent_agent->al_mac) + 1;
+            std::string parent_mac_str = tlvf::mac_to_string(parent_agent->al_mac);
+            LOG(INFO) << "Parent agent found: " << parent_mac_str;
+            return get_agent_hierarchy(parent_agent->al_mac, depth + 1) + 1;
         } else {
+            LOG(INFO) << "No parent agent for MAC: " << tlvf::mac_to_string(al_mac);
             return 0;
         }
     }
diff --git a/controller/src/beerocks/master/db/db.h b/controller/src/beerocks/master/db/db.h
index 5cc7506c5..33bcd4502 100644
--- a/controller/src/beerocks/master/db/db.h
+++ b/controller/src/beerocks/master/db/db.h
@@ -1112,7 +1112,7 @@ public:
     //
     // DB node functions (get only)
     //
-    int get_agent_hierarchy(const sMacAddr &al_mac);
+    int get_agent_hierarchy(const sMacAddr &al_mac, int depth = 0);
     std::set<std::string> get_stations();
     std::set<std::string> get_active_radios();
     std::vector<std::shared_ptr<Agent>> get_all_connected_agents();
diff --git a/controller/src/beerocks/master/tasks/ire_network_optimization_task.cpp b/controller/src/beerocks/master/tasks/ire_network_optimization_task.cpp
index 473d7094e..4b673991e 100644
--- a/controller/src/beerocks/master/tasks/ire_network_optimization_task.cpp
+++ b/controller/src/beerocks/master/tasks/ire_network_optimization_task.cpp
@@ -55,6 +55,7 @@ void ire_network_optimization_task::work()
     case ITERATION: {
         while (current_ire_it != ires.end() &&
                database.get_sta_state(*current_ire_it) != beerocks::STATE_CONNECTED) {
+                LOG(INFO) << "Skipping non connected clients";
             ++current_ire_it;
         }
 
-- 
2.34.1

