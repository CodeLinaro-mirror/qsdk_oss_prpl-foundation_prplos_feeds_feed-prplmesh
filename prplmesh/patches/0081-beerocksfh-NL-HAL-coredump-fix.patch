From edee17dff45325f4cdeac4d5bbfe35f3d15f8f26 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Tue, 11 Nov 2025 11:00:40 +0530
Subject: [PATCH] beerocksfh NL HAL coredump fix

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../fronthaul_manager/monitor/monitor.cpp     |  1 +
 .../bwl/shared/nl80211_client_impl.cpp        | 68 ++++++++++---------
 2 files changed, 38 insertions(+), 31 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
index 9a68dcc68..65ac16cba 100644
--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
@@ -244,6 +244,7 @@ bool Monitor::thread_init()
             if (link_id >= 0 && link_id <= 2) {
                 if(!mon_wlan_hal->get_mld_interface_mac(monitor_iface, interface_mld_mac)) {
                     LOG(ERROR) << "get_mld_interface_mac call FAILED";
+                    return false;
                 }
                 LOG(INFO) << "MLD MAC retrieved from nl hal: " << interface_mld_mac;
 
diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index 797208928..df72a7043 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -223,17 +223,21 @@ bool nl80211_client_impl::getMLDLinkIfaceMacAddr(std::string &interface_name, st
                 LOG(ERROR) << "Failed to parse netlink message!";
                 return false;
             }
-            int ret = 0;
-            struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
-            nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
-                nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
-                if (link[NL80211_ATTR_MLO_LINK_ID] && (nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]) == link_idx)) {
-                    if (link[NL80211_ATTR_MAC]) {
-                        const uint8_t *link_addr = static_cast<const uint8_t *>(nla_data(link[NL80211_ATTR_MAC]));
-                        mac_out = tlvf::mac_to_string(link_addr);
-                        LOG(INFO) << "Matched MAC for link index " << link_idx << ": " << mac_out;
-                        mac_found = true;
-                        return true;
+            if ((tb[NL80211_ATTR_MLO_LINKS]))
+            {
+                LOG(INFO) << "MLO supported and MLO links attr present";
+                int ret = 0;
+                struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
+                nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
+                    nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
+                    if (link[NL80211_ATTR_MLO_LINK_ID] && (nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]) == link_idx)) {
+                        if (link[NL80211_ATTR_MAC]) {
+                            const uint8_t *link_addr = static_cast<const uint8_t *>(nla_data(link[NL80211_ATTR_MAC]));
+                            mac_out = tlvf::mac_to_string(link_addr);
+                            LOG(INFO) << "Matched MAC for link index " << link_idx << ": " << mac_out;
+                            mac_found = true;
+                            return true;
+                        }
                     }
                 }
             }
@@ -1859,27 +1863,29 @@ bool nl80211_client_impl::get_radio_idx_from_link_id(const std::string &interfac
                 LOG(ERROR) << "Failed to parse netlink message!";
                 return false;
             }
-
-            int ret = 0;
-            struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
-            nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
-                nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
-
-                if (link[NL80211_ATTR_MLO_LINK_ID] && link[NL80211_ATTR_WIPHY_FREQ]) {
-                    int current_link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
-                    if (current_link_id == link_id) {
-                        int freq = nla_get_u32(link[NL80211_ATTR_WIPHY_FREQ]);
-                        LOG(INFO) <<"FREQUNCY IS: "<< freq;
-                        if (freq >= 2400 && freq <= 2500) {
-                            radio_idx = RADIOIDX_2G;
-                        } else if (freq >= 4900 && freq <= 5900) {
-                            radio_idx = RADIOIDX_5G;
-                        } else if (freq >= 5925 && freq <= 7125) {
-                            radio_idx = RADIOIDX_6G;
-                        } else {
-                                LOG(ERROR) << "Unknown frequency band: " << freq;
+            if (tb[NL80211_ATTR_MLO_LINKS]) {
+                LOG(INFO) << " MLO LINK PRESENT ";
+                int ret = 0;
+                struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
+                nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
+                    nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
+
+                    if (link[NL80211_ATTR_MLO_LINK_ID] && link[NL80211_ATTR_WIPHY_FREQ]) {
+                        int current_link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
+                        if (current_link_id == link_id) {
+                            int freq = nla_get_u32(link[NL80211_ATTR_WIPHY_FREQ]);
+                            LOG(INFO) <<"FREQUNCY IS: "<< freq;
+                            if (freq >= 2400 && freq <= 2500) {
+                                radio_idx = RADIOIDX_2G;
+                            } else if (freq >= 4900 && freq <= 5900) {
+                                radio_idx = RADIOIDX_5G;
+                            } else if (freq >= 5925 && freq <= 7125) {
+                                radio_idx = RADIOIDX_6G;
+                            } else {
+                                    LOG(ERROR) << "Unknown frequency band: " << freq;
+                            }
+                            return true; //return once match is found
                         }
-                        return true; //return once match is found
                     }
                 }
             }
-- 
2.34.1

