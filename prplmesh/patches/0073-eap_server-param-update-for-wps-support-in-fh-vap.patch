From ec0fb08bc5ec9eba03e5b2052a59201aa429e3ab Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 23 Oct 2025 16:21:10 +0530
Subject: [PATCH] eap_server param update for wps support in fh vap

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index a2f4b733f..25b8ff1fa 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1390,6 +1390,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     conf.set_create_vap_value(vap_id, "wps_state", bss_it.fronthaul ? "2" : "");
                     conf.set_create_vap_value(vap_id, "wps_independent", bss_it.fronthaul ? "1" : "");
                     conf.set_create_vap_value(vap_id, "config_methods","push_button");
+                    conf.set_create_vap_value(vap_id, "eap_server","1");
                     bss_it.wps_pushbutton = true;
                     LOG(INFO) << "wps_pushbutton set to: " << bss_it.wps_pushbutton;
                     m_radio_info.wps_pushbutton_configured=true;
@@ -2839,6 +2840,7 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
         conf.set_create_vap_value(vap_id, "wps_state", bss_conf.fronthaul ? "2" : "");
         conf.set_create_vap_value(vap_id, "wps_independent", bss_conf.fronthaul ? "1" : "");
         conf.set_create_vap_value(vap_id, "config_methods","push_button");
+        conf.set_create_vap_value(vap_id, "eap_server","1");
         bss_conf.wps_pushbutton = true;
         LOG(INFO) << "wps_pushbutton set to: " << bss_conf.wps_pushbutton;
         m_radio_info.wps_pushbutton_configured=true;
-- 
2.34.1

