From b7c2738255371654545aabeec97f48aca40554bc Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 16 Oct 2025 11:36:49 +0530
Subject: [PATCH] topology_update_for_link_addition and reload_config_bss
 support

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 11 ++++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 38 ++++++++++++++-----
 .../bwl/nl80211/base_wlan_hal_nl80211.cpp     | 15 ++++++++
 3 files changed, 54 insertions(+), 10 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index dd6921451..f0b2c9468 100755
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2508,6 +2508,17 @@ void ApAutoConfigurationTask::handle_vs_reconfig_complete_notification(
 
         LOG(DEBUG) << "Sending AP_MLD_CONFIGURATION_RESPONSE_MESSAGE message";
         m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+
+        //send vap list notification
+        for (const auto& radio_conf : m_radios_conf_params) {
+            const std::string& radio_iface = radio_conf.first;
+            if (!radio_iface.empty()) {
+                LOG(DEBUG) << "send update vap list request for " << radio_iface;
+                if (!send_ap_bss_info_update_request(radio_iface)) {
+                    LOG(ERROR) << "send_ap_bss_info_update_request has failed on " << radio_iface;
+                }
+            }
+        }
     }
 }
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 7b941359f..a2f4b733f 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1252,11 +1252,13 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
             }
             //to update uci with whatever update name we get
             bss_it.old_iface_name = new_vap_name;
-            if (!m_nl80211_client->create_new_interface(new_vap_name)) {
-                LOG(ERROR) << "Unable to create new interface ";
-                continue;
-            }
 
+            if ((bss_it.mld_id < 0) || ((bss_it.mld_id >= 0) && (bss_name_changed == false))) {
+                if (!m_nl80211_client->create_new_interface(new_vap_name)) {
+                    LOG(ERROR) << "Unable to create new interface ";
+                    continue;
+                }
+            }
             new_vap_index++;
 
             bss_it.bssid = new_bssid;
@@ -1552,6 +1554,12 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                                     continue;
                                 }
                                 LOG(INFO) << "STOP_MLD successful";
+                                const std::string cmd_2("RELOAD_CONFIG");
+                                if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
+                                    LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
+                                    continue;
+                                }
+                                LOG(INFO) << "RELOAD_CONFIG successful";
                             } else {
                                 const std::string cmd("STOP_AP");
                                 if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
@@ -1559,13 +1567,23 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                                     continue;
                                 }
                                 LOG(INFO) << "STOP_AP successful";
+
+                                std::stringstream reload_bss;
+                                std::string conf_path =
+                                    std::string(bwl::nl80211::base_ctrl_path) + "hostapd-" + m_radio_info.phy_name + ".conf";
+                                reload_bss << "RELOAD_CONFIG_BSS bss_config=" <<conf_path;
+                                if (!wpa_ctrl_send_msg(reload_bss.str(),vap_info.bss)) {
+                                    LOG(ERROR) << reload_bss.str() << " command to hostapd has failed - send reload_config";
+
+                                    const std::string cmd_2("RELOAD_CONFIG");
+                                    if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
+                                        LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
+                                        continue;
+                                    }
+                                    LOG(INFO) << "RELOAD_CONFIG successful";
+                                }
+
                             }
-                            const std::string cmd_2("RELOAD_CONFIG");
-                            if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
-                                LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
-                                continue;
-                            }
-                            LOG(INFO) << "RELOAD_CONFIG successful";
                         }
                     }
                 }
diff --git a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
index 7d8f8909c..6ef625aae 100644
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -1196,6 +1196,21 @@ bool base_wlan_hal_nl80211::register_wpa_ctrl_interface(const std::string &inter
                 }
             }
         }while(retry_count > 0);
+    } else {
+        // Create wpa_ctrl socket for base_iface
+        size_t link_pos = interface.find("_link");
+        if (link_pos != std::string::npos) {
+            std::string base_radio_iface_name = interface.substr(0, link_pos);
+            auto pos = wpa_ctrl_path.find_last_of("/");
+            if (pos != std::string::npos) {
+                pos += 1;
+            }
+            wpa_ctrl_path = wpa_ctrl_path.substr(0, pos) + base_radio_iface_name;
+            LOG(DEBUG) << "Built wpa_ctrl_path " << wpa_ctrl_path << " for base interface " << base_radio_iface_name;
+            if (!m_wpa_ctrl_client.add_interface(base_radio_iface_name, wpa_ctrl_path, m_fds_ext_events)) {
+                LOG(ERROR) << "Failed to add " << wpa_ctrl_path << " for base interface " << base_radio_iface_name;
+            }
+        }
     }
     LOG(DEBUG) << "Built wpa_ctrl_path " << wpa_ctrl_path << " for interface " << interface;
     if (!m_wpa_ctrl_client.add_interface(interface, wpa_ctrl_path, m_fds_ext_events)) {
-- 
