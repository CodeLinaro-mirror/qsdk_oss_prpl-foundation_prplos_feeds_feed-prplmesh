From 0cb51873832f272e406d01511b8ae316bd3115fa Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Fri, 31 Oct 2025 21:56:45 +0530
Subject: [PATCH] 72nd patch status fix

CONFIGURED check in radio agent

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 common/beerocks/scripts/prplmesh_utils.sh.in | 99 +++++++++++++++++++-
 1 file changed, 96 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/scripts/prplmesh_utils.sh.in b/common/beerocks/scripts/prplmesh_utils.sh.in
index e1f4104d1..1fbbe45eb 100755
--- a/common/beerocks/scripts/prplmesh_utils.sh.in
+++ b/common/beerocks/scripts/prplmesh_utils.sh.in
@@ -279,15 +279,108 @@ execute_beerocks_command() {
 # Therefore added "($|[[:blank:]])" to the end of the regex expression which means the end of the
 # line ($) or blank character ([[:blank:]])
 
+
+main_agent_flag=1     # assume failure
+radio_agent_flag=1
+
 main_agent_operational() {
-    pgrep -fl beerocks_agent  > /dev/null 2>&1 || return 1
-    grep -q ' --> OPERATIONAL' "$1/beerocks_backhaul.log"
+    log_dir="$1"
+
+    log_files=$(ls -1t "$log_dir"/beerocks_backhaul.*.log 2>/dev/null)
+    pgrep -fl beerocks_agent > /dev/null 2>&1 || { main_agent_flag=1; return 1; }
+
+    for file in $log_files; do
+        op_line=$(grep -n ' --> OPERATIONAL' "$file" | tail -n1 | cut -d: -f1)
+        if [ -n "$op_line" ]; then
+            if ( tail -n +"$((op_line + 1))" "$file" 2>/dev/null | grep -q "Caught signal 'Terminated'" ); then
+                main_agent_flag=1
+                return 1
+            fi
+
+            if ( tail -n +"$((op_line + 1))" "$file" 2>/dev/null | grep -q "OPERATIONAL -->" ); then
+                main_agent_flag=1
+                return 1
+            fi
+
+            start_checking=0
+            for next_file in $log_files; do
+                if [ "$start_checking" -eq 0 ]; then
+                    [ "$next_file" = "$file" ] && start_checking=1
+                    continue
+                fi
+                if grep -q "Caught signal 'Terminated'" "$next_file"; then
+                    main_agent_flag=1
+                    return 1
+                fi
+                if grep -q "OPERATIONAL -->" "$next_file"; then
+                    main_agent_flag=1
+                    return 1
+                fi
+            done
+
+            # Found OPERATIONAL with no termination or transition after — success
+            main_agent_flag=0
+            return 0
+        fi
+    done
+
+    # No valid OPERATIONAL entry found — return based on flag
+    if [ "$main_agent_flag" -eq 0 ]; then
+        return 0
+    else
+        return 1
+    fi
 }
 
 radio_agent_operational() {
-    grep -q "$2 FSM: .* --> CONFIGURED" "$1/beerocks_agent@BEEROCKS_LOG_FILES_SUFFIX@"
+    log_dir="$1"
+    radio="$2"
+
+    log_files=$(ls -1t "$log_dir"/beerocks_agent.*.log 2>/dev/null)
+    [ -z "$log_files" ] && { radio_agent_flag=1; return $radio_agent_flag; }
+
+    for file in $log_files; do
+        config_line=$(grep -n "$radio FSM: .* --> CONFIGURED" "$file" | tail -n1 | cut -d: -f1)
+        if [ -n "$config_line" ]; then
+                agent_started=$(tail -n +"$((config_line + 1))" "$file" 2>/dev/null | grep -q "Agent Started"; echo $?)
+                if [ "$agent_started" -eq 0 ]; then
+                        radio_agent_flag=1
+                        return $radio_agent_flag
+                fi
+                if ( tail -n +"$((config_line + 1))" "$file" 2>/dev/null | grep -q "$radio FSM: CONFIGURED -->" ); then
+                        radio_agent_flag=1
+                        return $radio_agent_flag
+                fi
+            start_checking=0
+            for next_file in $log_files; do
+                if [ "$start_checking" -eq 0 ]; then
+                    [ "$next_file" = "$file" ] && start_checking=1
+                    continue
+                fi
+                grep -q "Agent Started" "$next_file" && { radio_agent_flag=1; return $radio_agent_flag; }
+
+                if grep -q "$radio FSM: CONFIGURED -->" "$next_file"; then
+                    radio_agent_flag=1
+                    return $radio_agent_flag
+                fi
+            done
+            # CONFIGURED found and no Agent Started after ... success
+            radio_agent_flag=0
+            return $radio_agent_flag
+        fi
+    done
+
+    # No CONFIGURED found
+
+    if [ "$radio_agent_flag" -eq 0 ]; then
+        return 0
+    else
+        return 1
+    fi
+
 }
 
+
 report() {
     msg="$1"; shift
     if "$@"; then
-- 
