From f754c5713636f30b43daf0f031bfaa37b13590f0 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Fri, 10 Oct 2025 15:44:56 +0530
Subject: [PATCH] BML CLI trigger for ML Reconfig

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../tlvf/beerocks_message_action.yaml         |  1 +
 .../beerocks/tlvf/beerocks_message_bml.yaml   |  7 +++++
 controller/src/beerocks/bml/bml.cpp           | 14 +++++++++
 controller/src/beerocks/bml/bml.h             |  3 ++
 .../beerocks/bml/internal/bml_internal.cpp    | 24 +++++++++++++++
 .../src/beerocks/bml/internal/bml_internal.h  |  4 +++
 .../src/beerocks/cli/beerocks_cli_bml.cpp     | 22 ++++++++++++++
 .../src/beerocks/cli/beerocks_cli_bml.h       |  3 ++
 .../src/beerocks/master/son_management.cpp    | 29 +++++++++++++++++++
 9 files changed, 107 insertions(+)

diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
index 41be13561..b7ee2b82e 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
@@ -468,6 +468,7 @@ eActionOp_BML:
   ACTION_BML_UNREGISTER_TOPOLOGY_QUERY: 194
   ACTION_BML_TRIGGER_CHANNEL_SELECTION_REQUEST: 195
   ACTION_BML_TRIGGER_CHANNEL_SELECTION_RESPONSE: 196
+  ACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST: 197
 
   ACTION_BML_CHANNEL_SCAN_SET_CONTINUOUS_PARAMS_REQUEST: 200
   ACTION_BML_CHANNEL_SCAN_SET_CONTINUOUS_PARAMS_RESPONSE: 201
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_bml.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_bml.yaml
index 090752a95..fa0cdc14a 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_bml.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_bml.yaml
@@ -382,6 +382,13 @@ cACTION_BML_TRIGGER_CHANNEL_SELECTION_REQUEST:
   bandwidth: beerocks::eWiFiBandwidth
   csa_count: uint8_t
 
+cACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST:
+  _type: class
+  al_mac: sMacAddr
+  mld_mac: sMacAddr
+  ruid: sMacAddr
+  add_link: uint8_t
+
 cACTION_BML_TRIGGER_CHANNEL_SELECTION_RESPONSE:
   _type: class
   code:
diff --git a/controller/src/beerocks/bml/bml.cpp b/controller/src/beerocks/bml/bml.cpp
index 8976b2725..7d0059b07 100644
--- a/controller/src/beerocks/bml/bml.cpp
+++ b/controller/src/beerocks/bml/bml.cpp
@@ -649,6 +649,20 @@ int bml_channel_selection(BML_CTX ctx, const char *radio_mac, uint8_t channel, u
                                    bandwidth, csa_count);
 }
 
+int bml_reconfig_apmld(BML_CTX ctx, const char *al_mac, const char *mld_mac, const char* ruid,
+                          uint8_t add_link)
+{
+    // Validate input parameters
+    if (!ctx) {
+        return (-BML_RET_INVALID_ARGS);
+    }
+
+    bml_internal *pBML = static_cast<bml_internal *>(ctx);
+
+    return pBML->reconfig_apmld(tlvf::mac_from_string(std::string(al_mac)), tlvf::mac_from_string(std::string(mld_mac)),
+                                tlvf::mac_from_string(std::string(ruid)), add_link);
+}
+
 int bml_set_selection_channel_pool(BML_CTX ctx, const char *radio_mac, unsigned int *channel_pool,
                                    int channel_pool_size)
 {
diff --git a/controller/src/beerocks/bml/bml.h b/controller/src/beerocks/bml/bml.h
index 5f204f06a..26b61706d 100644
--- a/controller/src/beerocks/bml/bml.h
+++ b/controller/src/beerocks/bml/bml.h
@@ -560,6 +560,9 @@ int bml_trigger_topology_discovery(BML_CTX ctx, const char *al_mac);
 int bml_channel_selection(BML_CTX ctx, const char *radio_mac, uint8_t channel, uint8_t bandwidth,
                           uint8_t csa_count);
 
+int bml_reconfig_apmld(BML_CTX ctx, const char *al_mac, const char *mld_mac, const char* ruid,
+                          uint8_t add_link);
+
 /**
  * Set the dynamic channel pool, used by the Auto Channel Selection flow.
  *
diff --git a/controller/src/beerocks/bml/internal/bml_internal.cpp b/controller/src/beerocks/bml/internal/bml_internal.cpp
index bd6511d18..c19af5d37 100644
--- a/controller/src/beerocks/bml/internal/bml_internal.cpp
+++ b/controller/src/beerocks/bml/internal/bml_internal.cpp
@@ -4127,6 +4127,30 @@ int bml_internal::channel_selection(const sMacAddr &radio_mac, uint8_t channel,
     return BML_RET_OK;
 }
 
+int bml_internal::reconfig_apmld(const sMacAddr &al_mac, const sMacAddr &mld_mac, const sMacAddr &ruid,
+                                 uint8_t add_link)
+{
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST>(cmdu_tx);
+
+    if (request == nullptr) {
+        LOG(ERROR) << "Failed building ACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST message!";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    request->al_mac() = al_mac;
+    request->mld_mac() = mld_mac;
+    request->ruid() = ruid;
+    request->add_link() = add_link;
+
+    if (!message_com::send_cmdu(m_sockMaster, cmdu_tx)) {
+        LOG(ERROR) << "Failed sending ACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST message";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    return BML_RET_OK;
+}
+
 int bml_internal::set_selection_channel_pool(const sMacAddr &radio_mac,
                                              const unsigned int *channel_pool,
                                              const int channel_pool_size)
diff --git a/controller/src/beerocks/bml/internal/bml_internal.h b/controller/src/beerocks/bml/internal/bml_internal.h
index 275cdce2a..161fb05f3 100644
--- a/controller/src/beerocks/bml/internal/bml_internal.h
+++ b/controller/src/beerocks/bml/internal/bml_internal.h
@@ -189,6 +189,10 @@ public:
     int channel_selection(const sMacAddr &radio_mac, uint8_t channel, uint8_t bandwidth,
                           uint8_t csa_count = 5);
 
+    // triggers reconfig apmld on specific Agent
+    int reconfig_apmld(const sMacAddr &al_mac, const sMacAddr &mld_mac, const sMacAddr &ruid,
+                       uint8_t add_link);
+
     // Set the channel pool for the Auto Channel Selection
     int set_selection_channel_pool(const sMacAddr &radio_mac, const unsigned int *channel_pool,
                                    const int channel_pool_size);
diff --git a/controller/src/beerocks/cli/beerocks_cli_bml.cpp b/controller/src/beerocks/cli/beerocks_cli_bml.cpp
index de8f6c247..18d1e42b4 100644
--- a/controller/src/beerocks/cli/beerocks_cli_bml.cpp
+++ b/controller/src/beerocks/cli/beerocks_cli_bml.cpp
@@ -494,6 +494,11 @@ void cli_bml::setFunctionsMapAndArray()
                        "trigger channel selection procedure",
                        static_cast<pFunction>(&cli_bml::bml_channel_selection_caller), 3, 4,
                        STRING_ARG, INT_ARG, INT_ARG, INT_ARG);
+    insertCommandToMap("bml_trigger_reconfig_apmld",
+                       "<al mac> <mld mac> <ruid> <add link>",
+                       "trigger reconfig apmld",
+                       static_cast<pFunction>(&cli_bml::bml_reconfig_apmld_caller), 4, 4,
+                       STRING_ARG, STRING_ARG, STRING_ARG, INT_ARG);
     insertCommandToMap(
         "bml_set_selection_channel_pool", "<mac> <channel pool>",
         "Set the Channel-Selection's channel pool for the Auto Channel Selection. channels are "
@@ -1251,6 +1256,15 @@ int cli_bml::bml_channel_selection_caller(int numOfArgs)
     return -1;
 }
 
+int cli_bml::bml_reconfig_apmld_caller(int numOfArgs)
+{
+    if (numOfArgs == 4) {
+        return reconfig_apmld(args.stringArgs[0], args.stringArgs[1], args.stringArgs[2],
+                                 args.intArgs[3]);
+    }
+    return -1;
+}
+
 int cli_bml::bml_set_selection_channel_pool_caller(int numOfArgs)
 {
     if (numOfArgs == 2) {
@@ -2045,6 +2059,14 @@ int cli_bml::channel_selection(const std::string &radio_mac, uint8_t channel, ui
     return 0;
 }
 
+int cli_bml::reconfig_apmld(const std::string &al_mac, const std::string &mld_mac,
+                            const std::string &ruid, uint8_t add_link)
+{
+    int ret = bml_reconfig_apmld(ctx, al_mac.c_str(), mld_mac.c_str(), ruid.c_str(), add_link);
+    printBmlReturnVals("reconfig_apmld", ret);
+    return 0;
+}
+
 int cli_bml::set_selection_pool(const std::string &radio_mac, const std::string &channel_pool)
 {
     auto channels      = string_utils::str_split(channel_pool, ',');
diff --git a/controller/src/beerocks/cli/beerocks_cli_bml.h b/controller/src/beerocks/cli/beerocks_cli_bml.h
index 81f16ddd9..be47c7f52 100644
--- a/controller/src/beerocks/cli/beerocks_cli_bml.h
+++ b/controller/src/beerocks/cli/beerocks_cli_bml.h
@@ -142,6 +142,7 @@ private:
     int get_slave_restricted_channels_caller(int numOfArgs);
     int bml_trigger_topology_discovery_caller(int numOfArgs);
     int bml_channel_selection_caller(int numOfArgs);
+    int bml_reconfig_apmld_caller(int numOfArgs);
     int bml_set_selection_channel_pool_caller(int numOfArgs);
     int bml_get_selection_channel_pool_caller(int numOfArgs);
 #ifdef FEATURE_PRE_ASSOCIATION_STEERING
@@ -209,6 +210,8 @@ private:
     int topology_discovery(const std::string &al_mac);
     int channel_selection(const std::string &radio_mac, uint8_t channel, uint8_t bw,
                           uint8_t csa_count = 5);
+    int reconfig_apmld(const std::string &al_mac, const std::string &mld_mac, const std::string &ruid,
+                          uint8_t add_link);
     int set_selection_pool(const std::string &radio_mac, const std::string &channel_pool);
     int get_selection_pool(const std::string &radio_mac);
 #ifdef FEATURE_PRE_ASSOCIATION_STEERING
diff --git a/controller/src/beerocks/master/son_management.cpp b/controller/src/beerocks/master/son_management.cpp
index a8b1df452..fb2d52999 100644
--- a/controller/src/beerocks/master/son_management.cpp
+++ b/controller/src/beerocks/master/son_management.cpp
@@ -1780,6 +1780,35 @@ void son_management::handle_bml_message(int sd, std::shared_ptr<beerocks_header>
             &new_event);
         break;
     }
+
+    case beerocks_message::ACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST: {
+        LOG(TRACE) << "ACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST";
+
+        auto request = beerocks_header
+                ->addClass<beerocks_message::cACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST failed";
+            break;
+        }
+
+	auto al_mac = request->al_mac();
+	auto mld_mac = request->mld_mac();
+	auto ruid = request->ruid();
+	auto add_link = request->add_link();
+
+        LOG(INFO) << "ACTION_BML_TRIGGER_RECONFIG_APMLD_REQUEST "
+                  << ", al_mac=" << al_mac << ", mld_mac=" << mld_mac
+                  << ", ruid=" << ruid << ", add_link=" << add_link;
+
+	if (!controller_ctx->reconfig_apmld(al_mac, mld_mac, ruid, add_link)) {
+            LOG(ERROR) << "Failed to reconfig apmld from NBAPI for Agent: " << al_mac
+                       << " on MLD MAC: " << mld_mac << " with ruid: " << ruid
+                       << " with operation " << (add_link ? "add_link" : "remove_link");
+            return;
+        }
+        break;
+    }
+
     case beerocks_message::ACTION_BML_CHANNEL_SCAN_SET_CONTINUOUS_PARAMS_REQUEST: {
         LOG(TRACE) << "ACTION_BML_CHANNEL_SCAN_SET_CONTINUOUS_PARAMS_REQUEST";
 
-- 
