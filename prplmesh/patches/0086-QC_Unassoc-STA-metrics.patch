+/* Unassoc sta metrics Implementation */
+
+/**
+ * @brief Writes data to a debugfs file using system() call.
+ * This is a utility function for interacting with the Linux debugfs filesystem,
+ */
+bool mon_wlan_hal_nl80211::write_debugfs_file(const std::string &path, const std::string &data)
+{
+    std::string sys_cmd = "echo \"" + data + "\" > " + path;
+    int ret = system(sys_cmd.c_str());
+
+    if (ret != 0) {
+        LOG(ERROR) << "Failed to write to " << path << " with command: " << sys_cmd
+            << " Return code: " << ret;
+        return false;
+    }
+    LOG(DEBUG) << "Successfully wrote to " << path << " with data: " << data;
+    return true;
+}
+
+/**
+ * @brief Reads data from a debugfs file.
+ */
+bool mon_wlan_hal_nl80211::read_debugfs_file(const std::string &path, std::string &output)
+{
+    std::ifstream file(path);
+    if (!file.is_open()) {
+        LOG(ERROR) << "Failed to open " << path;
+        return false;
+    }
+    std::stringstream buffer;
+    buffer << file.rdbuf();
+    output = buffer.str();
+    return true;
+}
+
+/**
+
+ * @brief Adds an unassociated STA to the ath12k driver's peer neighbor list.
+ */
+bool mon_wlan_hal_nl80211::add_peer_neighbor(const std::string &mac_address)
+{
+    // Compose correct debugfs path based on phy_name and hw index
+    std::string phy_name = m_radio_info.phy_name;
+    size_t dot_pos       = phy_name.find('.');
+    if (dot_pos == std::string::npos) {
+        LOG(ERROR) << "phy_name missing hw index: " << phy_name;
+        return false;
+    }
+    std::string phy_base = phy_name.substr(0, dot_pos);
+    std::string hw_idx   = phy_name.substr(dot_pos + 1);
+
+    std::string debugfs_path =
+        "/sys/kernel/debug/ieee80211/" + phy_base + "/ath12k_hw" + hw_idx + "/neighbor_peer";
+    std::string command = "add," + mac_address;
+
+    LOG(DEBUG) << "add_peer_neighbor: phy_name=" << phy_name
+        << " phy_base=" << phy_base
+        << " hw_idx=" << hw_idx
+        << " debugfs_path=" << debugfs_path
+        << " command=" << command;
+
+    // Use write_debugfs_file to write the command
+    if (!write_debugfs_file(debugfs_path, command)) {
+        LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+        return false;
+    }
+
+    LOG(INFO) << "Successfully added neighbor " << mac_address << " via " << debugfs_path;
+    return true;
+}
+
+
+/**
+  * @brief Removes an unassociated STA from the ath12k driver's peer neighbor list.
+  * The command format written to debugfs is: "del,<mac_address>"
+  */
+bool mon_wlan_hal_nl80211::remove_peer_neighbor(const std::string &mac_address)
+{
+    std::string phy_name = m_radio_info.phy_name;
+    size_t dot_pos       = phy_name.find('.');
+    if (dot_pos == std::string::npos) {
+        LOG(ERROR) << "phy_name missing hw index: " << phy_name;
+        return false;
+    }
+    std::string phy_base = phy_name.substr(0, dot_pos);
+    std::string hw_idx   = phy_name.substr(dot_pos + 1);
+    std::string debugfs_path =
+        "/sys/kernel/debug/ieee80211/" + phy_base + "/ath12k_hw" + hw_idx + "/neighbor_peer";
+    std::string command = "del," + mac_address;
+
+    LOG(DEBUG) << "remove_peer_neighbor: phy_name=" << phy_name << " phy_base=" << phy_base
+        << " hw_idx=" << hw_idx << " debugfs_path=" << debugfs_path
+        << " command=" << command;
+    // Use write_debugfs_file to write the command
+    if (!write_debugfs_file(debugfs_path, command)) {
+        LOG(ERROR) << "Failed to remove peer neighbor: " << mac_address;
+        return false;
+    }
+    LOG(INFO) << "Successfully removed neighbor " << mac_address << " via " << debugfs_path;
+    return true;
+}
+
+/**
+ * @brief Reads the RSSI value for a specific unassociated STA from the ath12k driver.
+ */
+bool mon_wlan_hal_nl80211::read_peer_neighbor_rssi(const std::string &mac_address, int8_t &rssi)
+{
+    // Parse phy_name and hw_idx similar to remove_peer_neighbor
+    std::string phy_name = m_radio_info.phy_name;
+    size_t dot_pos       = phy_name.find('.');
+    if (dot_pos == std::string::npos) {
+        LOG(ERROR) << "phy_name missing hw index: " << phy_name;
+        return false;
+    }
+    std::string phy_base = phy_name.substr(0, dot_pos);
+    std::string hw_idx   = phy_name.substr(dot_pos + 1);
+
+    // Path: /sys/kernel/debug/ieee80211/<phy_base>/ath12k_hw<hw_idx>/nrp_rssi/<mac>
+    std::string rssi_path = "/sys/kernel/debug/ieee80211/" + phy_base + "/ath12k_hw" + hw_idx +
+        "/nrp_rssi/" + mac_address;
+
+    std::string output;
+    if (!read_debugfs_file(rssi_path, output)) {
+        LOG(ERROR) << "Failed to read debugfs file: " << rssi_path;
+        return false;
+    }
+    std::istringstream iss(output);
+    std::string line;
+    // Skip the header
+    if (!std::getline(iss, line))
+        return false;
+    // Read the first data line
+    if (!std::getline(iss, line))
+        return false;
+    // Split by whitespace
+    std::istringstream fieldss(line);
+    std::string mac_str, rssi_str, time_str;
+    if (!(fieldss >> mac_str >> rssi_str >> time_str))
+        return false;
+    // Remove exception handling (no exceptions in prplMesh build).
+    char *endptr  = nullptr;
+    long rssi_val = std::strtol(rssi_str.c_str(), &endptr, 10);
+    if (endptr == rssi_str.c_str() || *endptr != '\0' || rssi_val < -128 || rssi_val > 127)
+        return false;
+    rssi = static_cast<int8_t>(rssi_val);
+    return true;
+}
+
+/**
+ * @brief Triggers a Remain-on-Channel (ROC) scan using NL80211.
+ */
+#include <chrono>
+#include <thread>
+
+bool mon_wlan_hal_nl80211::trigger_roc_scan(uint8_t channel, uint32_t duration_ms)
+{
+    LOG(DEBUG) << "Triggering ROC scan on channel " << int(channel) << " for " << duration_ms
+        << "ms";
+
+    std::string interface_name = get_iface_name();
+    std::string base_interface;
+    extractBase1Interface(interface_name, base_interface);
+
+    // Get the interface index required for the NL80211 command
+    int iface_index = if_nametoindex(base_interface.c_str());
+    if (0 == iface_index) {
+        LOG(ERROR) << "Failed to read the index of interface " << interface_name
+            << " base_interface: " << base_interface << ": " << strerror(errno);
+        return false;
+    }
+
+    // Get radio info to determine the frequency for the given channel
+    auto &radio_info = get_radio_info();
+
+    // Find the channel in the supported channels list to convert channel number to frequency
+    uint32_t freq = 0;
+    // Calculate frequency from channel number and band
+    freq = son::wireless_utils::channel_to_freq(channel, radio_info.frequency_band);
+
+    if (freq == 0) {
+        LOG(ERROR) << "Channel " << int(channel) << " is not supported by interface "
+            << interface_name;
+        return false;
+    }
+
+    LOG(DEBUG) << "Requesting remain-on-channel on interface " << interface_name << " (idx "
+        << iface_index << ") for " << duration_ms << "ms on channel " << int(channel)
+        << " (freq " << freq << " MHz)";
+
+    // Send the NL80211_CMD_REMAIN_ON_CHANNEL command to the kernel
+    auto ret = send_nl80211_msg(
+            NL80211_CMD_REMAIN_ON_CHANNEL, 0,
+            // Lambda to populate the netlink message with necessary attributes
+            [&](struct nl_msg *msg) -> bool {
+            nla_put_u32(msg, NL80211_ATTR_IFINDEX, iface_index);
+            nla_put_u32(msg, NL80211_ATTR_WIPHY_FREQ, freq);
+            nla_put_u32(msg, NL80211_ATTR_DURATION, duration_ms);
+            return true;
+            },
+            // No response is expected for a successful command, only an error on failure.
+            // This callback is a placeholder.
+            [&](struct nl_msg *msg) -> bool { return true; }, base_interface);
+
+    if (!ret) {
+        LOG(ERROR) << "Failed to send NL80211_CMD_REMAIN_ON_CHANNEL command";
+        return false;
+    }
+
+    // -----------------------------------------------
+    // Workaround: create a sleeper thread to trigger ROC event manually
+    // -----------------------------------------------
+    std::thread([this, duration_ms]() {
+            constexpr uint32_t buffer_period_ms = 500;
+            LOG(DEBUG) << "[ROC] Sleeper thread started for " << duration_ms << "ms + buffer "
+            << buffer_period_ms << "ms";
+            std::this_thread::sleep_for(std::chrono::milliseconds(duration_ms + buffer_period_ms));
+            LOG(INFO) << "[ROC] Sleeper thread expired after " << (duration_ms + buffer_period_ms)
+            << "ms. Triggering process_roc_expired_event().";
+            this->process_roc_expired_event();
+            }).detach();
+    // -----------------------------------------------
+
+    return true;
+}
+
+/**
+ * @brief Processes the ROC (Remain-on-Channel) expired event.
+ */
+/**
+ * @brief Utility function to convert RSSI in dB to dBm.
+ */
+static inline int rssi_db_to_dbm(int rssi_db, int noise_floor_to_chanwidth = 94)
+{
+    return rssi_db - noise_floor_to_chanwidth;
+}
+
+bool mon_wlan_hal_nl80211::process_roc_expired_event()
+{
+    LOG(DEBUG) << "ROC expired, reading RSSI values";
+
+    sUnassociatedStationsStats stats_out;
+
+    // Iterate through all STAs that were pending measurement
+    for (auto &measurement : m_pending_unassoc_measurements) {
+        int8_t rssi = 0;
+        if (read_peer_neighbor_rssi(measurement.mac_address, rssi)) {
+            sUnassociatedStationStats new_stat;
+            new_stat.mac_adress = tlvf::mac_from_string(measurement.mac_address);
+
+            // Convert RSSI-dB to dBm (using noise_floor_to_chanwidth = 94)
+            int rssi_dbm = rssi_db_to_dbm(rssi, 94);
+
+            // Convert to RCPI: RCPI = (RSSI_dBm + 110) * 2
+            new_stat.signal_strength = (rssi_dbm + 110) * 2;
+            new_stat.channel         = measurement.channel;
+
+            // Note: operating_class is no longer stored in UnassocMeasurementContext
+            // It should be derived from the channel if needed by the caller
+
+            // Calculate time elapsed since measurement was initiated
+            auto time_delta = std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::steady_clock::now() - measurement.start_time);
+            new_stat.time_stamp = time_delta.count();
+
+            stats_out.un_stations_stats.push_back(new_stat);
+
+            LOG(DEBUG) << "STA " << measurement.mac_address << " RSSI(raw dB): " << int(rssi)
+                << " RSSI[dBm]: " << rssi_dbm << " RCPI: " << int(new_stat.signal_strength)
+                << ", channel: " << int(new_stat.channel);
+        } else {
+            LOG(ERROR) << "Failed to read RSSI for STA: " << measurement.mac_address;
+        }
+        // Clean up by removing the peer from the debugfs list
+        remove_peer_neighbor(measurement.mac_address);
+    }
+    // Clear the pending measurements list
+    m_pending_unassoc_measurements.clear();
+
+    // Allocate buffer for the event data
+    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(stats_out));
+    if (!msg_buff) {
+        LOG(FATAL) << "Memory allocation failed for sUnassociatedStationsStats!";
+        return false;
+    }
+    auto msg = reinterpret_cast<sUnassociatedStationsStats *>(msg_buff.get());
+    memset(msg_buff.get(), 0, sizeof(stats_out));
+    *msg = stats_out;
+
+    // Push the stats to the event queue
+    event_queue_push(Event::Unassociation_Stations_Stats, msg_buff);
+
+    LOG(DEBUG) << "Pushed Unassociation_Stations_Stats event with "
+        << stats_out.un_stations_stats.size() << " entries";
+
+    // All timerfd-based ROC cleanup removed; rely only on kernel event.
+
+    return true;
+}
+
+/**
+ * @brief Initiates RSSI measurement for a list of unassociated STAs.
+ */
 bool mon_wlan_hal_nl80211::sta_unassoc_rssi_measurement(
-    std::unordered_map<std::string, uint8_t> &new_list)
+        std::unordered_map<std::string, uint8_t> &new_list)
 {
-    new_list.clear();
-    LOG(DEBUG) << __func__ << " - NOT IMPLEMENTED";
+    LOG(DEBUG) << "sta_unassoc_rssi_measurement: Starting measurement for " << new_list.size()
+        << " STAs";
+    if (new_list.empty()) {
+        return true;
+    }
+
+    uint8_t first_channel = 0;
+
+    // Prepare all STAs for measurement
+    for (auto &sta : new_list) {
+        const std::string &mac_address = sta.first;
+        uint8_t channel                = sta.second;
+
+        // Validate channel number
+        if (channel == 0) {
+            LOG(ERROR) << "Invalid channel (0) for STA: " << mac_address;
+            continue;
+        }
+
+        // Add STA to the driver's debugfs list for monitoring
+        if (!add_peer_neighbor(mac_address)) {
+            LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+            continue;
+        }
+
+        // Use the channel of the first valid STA for the ROC scan
+        if (first_channel == 0) {
+            first_channel = channel;
+        }
+
+        // Store context for this measurement
+        UnassocMeasurementContext ctx;
+        ctx.mac_address = mac_address;
+        ctx.channel     = channel;
+        ctx.start_time  = std::chrono::steady_clock::now();
+        m_pending_unassoc_measurements.push_back(ctx);
+    }
+
+    if (m_pending_unassoc_measurements.empty()) {
+        LOG(ERROR) << "No valid STAs to measure";
+        return false;
+    }
+
+    // Trigger a single ROC scan. All measurements will be based on this scan.
+    uint32_t roc_duration_ms = 100;
+    if (!trigger_roc_scan(first_channel, roc_duration_ms)) {
+        LOG(ERROR) << "Failed to trigger ROC scan on channel " << int(first_channel);
+        // Clean up all pending measurements if ROC scan fails
+        for (auto &measurement : m_pending_unassoc_measurements) {
+            remove_peer_neighbor(measurement.mac_address);
+        }
+        m_pending_unassoc_measurements.clear();
+        return false;
+    }
+
+    LOG(DEBUG) << "Triggered ROC scan on channel " << int(first_channel) << " for "
+        << roc_duration_ms << "ms";
+
     return true;
 }
 
