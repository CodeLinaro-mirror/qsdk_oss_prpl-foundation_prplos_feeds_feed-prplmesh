From c5e67a0b763ffa9865f7c8a2ca9ba2fbdc1b23d3 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Thu, 6 Nov 2025 16:54:48 +0530
Subject: [PATCH] Country code fetch error fix

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 63610de06..209b6ac99 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -511,8 +511,17 @@ bool slave_thread::read_platform_configuration()
     for (const auto &radio_manager : m_radio_managers.get()) {
         const auto &fronthaul_iface = radio_manager.first;
         bpl::BPL_WLAN_PARAMS params;
-        if (bpl::cfg_get_wifi_params(fronthaul_iface.c_str(), &params) < 0) {
-            LOG(ERROR) << "Failed reading '" << fronthaul_iface << "' parameters!";
+
+        std::string base_radio_iface_name = fronthaul_iface;
+        size_t link_pos = fronthaul_iface.find("_link");
+        if (link_pos != std::string::npos) {
+            base_radio_iface_name = fronthaul_iface.substr(0, link_pos);
+        }
+
+        LOG(INFO) << "Interface checking: " << base_radio_iface_name;
+
+        if (bpl::cfg_get_wifi_params(base_radio_iface_name.c_str(), &params) < 0) {
+            LOG(ERROR) << "Failed reading '" << base_radio_iface_name << "' parameters!";
             return false;
         }
 
@@ -524,6 +533,9 @@ bool slave_thread::read_platform_configuration()
         current_country[0] = params.country_code[0];
         current_country[1] = params.country_code[1];
 
+        // take the latest
+        db->device_conf.country_code = current_country;
+
         bool db_country_code_empty =
             (db->device_conf.country_code[0] == 0) && (db->device_conf.country_code[1] == 0);
 
@@ -532,8 +544,6 @@ bool slave_thread::read_platform_configuration()
                        << current_country[0] << current_country[1] << " and "
                        << db->device_conf.country_code[0] << db->device_conf.country_code[1];
         }
-        // take the latest
-        db->device_conf.country_code = current_country;
 
         LOG(DEBUG) << "wlan settings " << fronthaul_iface << ":";
         LOG(DEBUG) << "band_enabled=" << params.enabled;
-- 
2.34.1

