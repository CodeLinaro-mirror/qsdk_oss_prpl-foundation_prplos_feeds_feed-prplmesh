From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Wed, 29 Oct 2025 14:39:03 +0530
Subject: [PATCH] mld_id fix for autorenew case

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 controller/src/beerocks/master/controller.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index e2c4b214b..854f4fd7c 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -5070,8 +5070,8 @@ bool Controller::handle_ap_capability_report(const sMacAddr &src_mac,
                             agent->configured_ap_mlds[mld_id].affiliated_aps[ruid].ruid = ruid;
                         }
                         else {
-                            LOG(ERROR) << "Found duplicate link on same ruid" << ruid;
-                            return false;
+                            LOG(DEBUG) << "Affiliated AP link already present for MLD ID " << static_cast<int>(mld_id)
+                                    << " on RUID: " << ruid;
                         }
                         break;
                     }
