From dbd127fc2c5e218f9fb7666014da0a6ad7a6bc9a Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 6 Aug 2025 19:44:53 +0530
Subject: [PATCH] update controller database for autoconfig renew

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../src/beerocks/master/son_management.cpp       | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/controller/src/beerocks/master/son_management.cpp b/controller/src/beerocks/master/son_management.cpp
index 6fc4be991..a8b1df452 100644
--- a/controller/src/beerocks/master/son_management.cpp
+++ b/controller/src/beerocks/master/son_management.cpp
@@ -32,6 +32,8 @@
 #include <bcl/beerocks_utils.h>
 #include <bcl/beerocks_wifi_channel.h>
 #include <easylogging++.h>
+#include <bpl/bpl_cfg.h>
+
 using namespace beerocks;
 using namespace net;
 using namespace son;
@@ -1368,6 +1370,20 @@ void son_management::handle_bml_message(int sd, std::shared_ptr<beerocks_header>
             return;
         }
 
+        database.clear_bss_info_configuration();
+
+        std::list<son::wireless_utils::sBssInfoConf> wireless_settings;
+        if (beerocks::bpl::bpl_cfg_get_wireless_settings(wireless_settings)) {
+            for (const auto &configuration : wireless_settings) {
+                database.add_bss_info_configuration(configuration);
+                if (configuration.mld_id > -1) {
+                database.add_mld_info_configuration(configuration);
+                }
+            }
+        } else {
+            LOG(DEBUG) << "failed to read wireless settings";
+        }
+
         ret = son_actions::send_ap_config_renew_msg(cmdu_tx, database);
         if (!ret) {
             LOG(ERROR) << "Failed son_actions::send_ap_config_renew_msg ! ";
-- 
2.34.1

