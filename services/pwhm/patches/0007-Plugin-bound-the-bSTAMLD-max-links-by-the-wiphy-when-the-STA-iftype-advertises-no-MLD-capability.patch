From f634ea2703ce8a006ea980034721454838893a16 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Petr=20=C5=A0tetiar?= <petr.stetiar@prplfoundation.org>
Date: Fri, 25 Sep 2026 08:45:25 +0200
Subject: [PATCH] Plugin: bound the bSTAMLD max links by the wiphy when the STA
 iftype advertises no MLD capability
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On a wiphy whose driver lists only the AP iftype in
NL80211_ATTR_IFTYPE_EXT_CAPA the generic backend reports
Radio.*.Capabilities.bSTAMLDMaxLinks=0 while APMLDMaxLinks is filled.
mac80211_hwsim with mlo=1 is such a driver: mac80211_hwsim_iftypes_ext_capa[]
has a single NL80211_IFTYPE_AP entry (EMLSR|EMLMR, max_num_simul_links 14),
so on the Wi-Fi 7 / MLO QEMU board APMLDMaxLinks=15 and bSTAMLDMaxLinks=0.

s_parseIfTypeExtCapa() sets extCapas.mloSupport[iftype] only for an ext-capa
entry carrying both NL80211_ATTR_EML_CAPABILITY and
NL80211_ATTR_MLD_CAPA_AND_OPS, and wifiGen_rad_supports() initialises the EP
MLD group capacity only under mloSupport[STATION]. Without a STATION entry the
whole branch is skipped, including its existing "max links unknown, use
min(maxEps, AP links)" fallback, so the EP group keeps its zeroed capacity,
wld_mld_commitMldCapa() exports 0 and MaxNumMLDs is summed from the AP group
alone.

A missing STATION ext-capa entry is not a negative capability. The same wiphy
sets NL80211_ATTR_MLO_SUPPORT, lists STATION in the supported iftypes and
carries EHT capabilities in the STATION iftype data of every band. mac80211
associates as an MLD station from exactly that state
(ieee80211_assoc_add_ml_elem() starts from zero EML/MLD ops when no entry
exists) and wpa_supplicant derives WPA_DRIVER_FLAGS2_MLO from the global flag
alone. The only thing the wiphy does not tell us is the STA link ceiling.

Fill that gap with a bounded configuration capacity instead of pretending the
driver reported one:

- the band parser records, per band, whether the STATION iftype data carries
  EHT capabilities; nl80211 emits NL80211_BAND_IFTYPE_ATTR_EHT_CAP_* only when
  the driver flags has_eht for that iftype, so their presence is the test;
- when the wiphy supports MLO, the operating band supports EHT STA links, the
  STA iftype has no MLD capability entry and the AP MLD ceiling is known,
  wifiGen_rad_supports() sets the EP group capacity to maxEps MLDs of
  min(bands with EHT STA support, maxEps, APMLDMaxLinks) links.

An explicit STATION entry keeps the existing path untouched. The fallback
leaves the STA EML mode capabilities (EMLSR/EMLMR/STR/NSTR) unset since
nothing was advertised; in particular it does not reuse the AP EML modes the
explicit branch assumes for EMLSR. Under the suppMlo gate,
!mloSupport[STATION] does mean "no STATION entry": nl80211 emits both the EML
and the MLD attrs for every listed entry once WIPHY_FLAG_SUPPORTS_MLO is set,
so no separate presence flag is needed. Wiphys without an AP MLD ceiling
(STA-only MLO devices) are left out on purpose; they need their own policy.

On the hwsim prototype (one wiphy, 2.4/5/6 GHz, mlo=1) this yields
bSTAMLDMaxLinks=3 = min(3 STA EHT bands, 3 EPs, 15 AP links) and MaxNumMLDs
4 + 3 = 7. APMLDMaxLinks stays 15: that is the decoded hwsim advertisement,
not a defect.

Signed-off-by: Petr Štetiar <petr.stetiar@prplfoundation.org>
---
 include/wld/wld_nl80211_types.h  |  1 +
 src/Plugin/wifiGen_rad.c         | 22 ++++++++++++++++++++++
 src/nl80211/wld_nl80211_parser.c | 21 +++++++++++++++++++++
 3 files changed, 44 insertions(+)

diff --git a/include/wld/wld_nl80211_types.h b/include/wld/wld_nl80211_types.h
index 9c316e795813..59d083901584 100644
--- a/include/wld/wld_nl80211_types.h
+++ b/include/wld/wld_nl80211_types.h
@@ -204,6 +204,7 @@ typedef struct {
     swl_80211_ehtcap_phyCapInfo_t ehtPhyCapabilities;                       /* EHT(Extremely High Throughput) 802.11be capabilities*/
     swl_mcs_t mcsStds[SWL_MCS_STANDARD_MAX];                                //support mcs standards (each indexed on its relative enum)
     swl_mcs_legacyIndex_m supportedDataTransmitRates;                       //supported data transmit rates
+    bool staEhtSupported;                                                   //EHT capabilities advertised for the STATION iftype on this band
 } wld_nl80211_bandDef_t;
 
 typedef struct {
diff --git a/src/Plugin/wifiGen_rad.c b/src/Plugin/wifiGen_rad.c
index 447686a344ef..59e8bdcd1caf 100644
--- a/src/Plugin/wifiGen_rad.c
+++ b/src/Plugin/wifiGen_rad.c
@@ -767,6 +767,28 @@ int wifiGen_rad_supports(T_Radio* pRad, char* buf _UNUSED, int bufsize _UNUSED)
                 bStaMldcapa.maxNumLinksPerMLD = SWL_MIN(wld_getMaxNrEPs(), apMldCapa.maxNumLinksPerMLD);
             }
 
+            wld_mld_updateMldCapa(pMldMgr, WLD_SSID_TYPE_EP, &bStaMldcapa);
+        } else if(wiphyInfo.suppEp && pOperBand->staEhtSupported && (apMldCapa.maxNumLinksPerMLD > 1)) {
+            /*
+             * The wiphy supports MLO and EHT STA links on this band, but the driver
+             * advertises no STATION entry in NL80211_ATTR_IFTYPE_EXT_CAPA (e.g. mac80211_hwsim
+             * only lists the AP iftype). That is missing optional detail, not a negative
+             * capability: nl80211 emits the EML/MLD attrs for every listed entry as soon as
+             * the wiphy flags MLO support. Bound the bSTAMLD configuration capacity by what
+             * the wiphy can carry (one EHT STA link per band, one EP per link) and by the
+             * APMLD ceiling, and leave the STA EML modes unset: nothing was advertised.
+             */
+            uint32_t nStaEhtBands = 0;
+            for(uint32_t i = 0; i < SWL_ARRAY_SIZE(wiphyInfo.bands); i++) {
+                if((wiphyInfo.bands[i].nChans > 0) && wiphyInfo.bands[i].staEhtSupported) {
+                    nStaEhtBands++;
+                }
+            }
+            bStaMldcapa.maxNumMLDs = wld_getMaxNrEPs();
+            bStaMldcapa.maxNumLinksPerMLD = SWL_MIN(SWL_MIN(nStaEhtBands, wld_getMaxNrEPs()), apMldCapa.maxNumLinksPerMLD);
+            SAH_TRACEZ_INFO(ME, "%s: no STA MLD capa advertised, assume bSTAMLD maxLinks %d (staEhtBands %d, maxEps %d, apMaxLinks %d)",
+                            pRad->Name, bStaMldcapa.maxNumLinksPerMLD, nStaEhtBands, wld_getMaxNrEPs(), apMldCapa.maxNumLinksPerMLD);
+
             wld_mld_updateMldCapa(pMldMgr, WLD_SSID_TYPE_EP, &bStaMldcapa);
         }
     }
diff --git a/src/nl80211/wld_nl80211_parser.c b/src/nl80211/wld_nl80211_parser.c
index a69d1fc89aba..e8bb9ffbedb9 100644
--- a/src/nl80211/wld_nl80211_parser.c
+++ b/src/nl80211/wld_nl80211_parser.c
@@ -787,6 +787,18 @@ static void s_parseEhtCapMcsSet(const struct nlattr* tbIfType, wld_nl80211_bandD
     pBand->nSSMax = SWL_MAX(pBand->nSSMax, pMcsStd->numberOfSpatialStream);
 }
 
+static bool s_hasNlIfType(struct nlattr* tbIfType, int nlIfType) {
+    struct nlattr* ift = NULL;
+    int rem = 0;
+    ASSERTS_NOT_NULL(tbIfType, false, ME, "NULL");
+    nla_for_each_nested(ift, tbIfType, rem) {
+        if(nla_type(ift) == nlIfType) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static swl_rc_ne s_parseEhtAttrs(struct nlattr* tbBand[], wld_nl80211_bandDef_t* pBand) {
     ASSERTS_NOT_NULL(tbBand, SWL_RC_INVALID_PARAM, ME, "NULL");
     ASSERTS_NOT_NULL(pBand, SWL_RC_INVALID_PARAM, ME, "NULL");
@@ -799,6 +811,15 @@ static swl_rc_ne s_parseEhtAttrs(struct nlattr* tbBand[], wld_nl80211_bandDef_t*
         if(!s_isSupportedNlIfType(tbIfType[NL80211_BAND_IFTYPE_ATTR_IFTYPES])) {
             continue;
         }
+        /*
+         * nl80211 only emits the EHT capability attributes of an iftype data entry
+         * when the driver flags EHT support for it (has_eht), so their presence in a
+         * STATION entry tells that this band can carry an EHT (hence MLO) STA link.
+         */
+        if((tbIfType[NL80211_BAND_IFTYPE_ATTR_EHT_CAP_PHY] != NULL) &&
+           s_hasNlIfType(tbIfType[NL80211_BAND_IFTYPE_ATTR_IFTYPES], NL80211_IFTYPE_STATION)) {
+            pBand->staEhtSupported = true;
+        }
         s_parseEhtCapPhy(tbIfType[NL80211_BAND_IFTYPE_ATTR_EHT_CAP_PHY], pBand);
         s_parseEhtCapMcsSet(tbIfType[NL80211_BAND_IFTYPE_ATTR_EHT_CAP_MCS_SET], pBand);
     }
