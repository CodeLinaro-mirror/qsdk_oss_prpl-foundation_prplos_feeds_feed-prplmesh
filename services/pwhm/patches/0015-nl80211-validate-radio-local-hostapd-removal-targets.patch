+/** @brief Does an unresolved socket carry evidence requiring the 0004 guard? */
+bool wld_hostapd_mayBelongToRadio(const wld_hostapd_sock_t* pSock, T_Radio* pRad) {
+    if(pSock->nonBss) {
+        return false;
+    }
+    if(swl_str_matches(pSock->phy, pRad->Name) || s_radioMatches(pSock, pRad)) {
+        return true;
+    }
+    bool knownRadio = false;
+    T_Radio* pOther = NULL;
+    wld_for_eachRad(pOther) {
+        knownRadio |= swl_str_matches(pSock->phy, pOther->Name) || s_radioMatches(pSock, pOther);
+    }
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        wld_wpaCtrlInterface_t* pIface = pAP->wpaCtrlInterface;
+        if((pAP->pSSID == NULL) || (pIface == NULL)) {
+            continue;
+        }
+        if(!swl_mac_binIsNull(&pSock->bssid) &&
+           (!memcmp(pAP->pSSID->BSSID, &pSock->bssid, 6) ||
+            !memcmp(pIface->loadedBssid, &pSock->bssid, 6))) {
+            return true;
+        }
+        if(!knownRadio && swl_str_matches(pSock->name, wld_wpaCtrlInterface_getConnectionSockName(pIface))) {
+            return true;
+        }
+    }
+    return false;
+}
