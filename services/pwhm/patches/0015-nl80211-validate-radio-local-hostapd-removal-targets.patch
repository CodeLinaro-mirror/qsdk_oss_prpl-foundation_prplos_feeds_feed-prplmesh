-/* control socket name of a hostapd BSS: "<ifname>" or "<ifname>_link<N>" */
-#define HAPD_BSS_SOCK_NAME_LEN (IFNAMSIZ + 16)
-
-/**
- * @brief rebuild the control socket name of the N-th BSS listed in a "STATUS" reply
- *
- * hostapd names the control socket of a BSS after its configured interface
- * name (bss[N]= in the reply), suffixed with "_link<mld_link_id[N]>" for an
- * AP MLD link BSS (hostapd_set_ctrl_sock_iface(), src/ap/hostapd.c).
- *
- * @param reply "STATUS" reply
- * @param idx index N of the BSS in the reply
- * @param skname output buffer for the socket name
- * @param sknameSize size of the output buffer
- *
- * @return SWL_RC_OK when the N-th BSS is listed, SWL_RC_ERROR otherwise
- */
-static swl_rc_ne s_getStatusBssSockName(const char* reply, uint32_t idx, char* skname, size_t sknameSize) {
-    char key[32] = {0};
-    char ifname[IFNAMSIZ + 1] = {0};
-    snprintf(key, sizeof(key), "bss[%u]", idx);
-    swl_rc_ne rc = wld_wpaCtrl_getInReplyParamValStr(reply, key, ifname, sizeof(ifname));
-    ASSERTS_TRUE(swl_rc_isOk(rc), SWL_RC_ERROR, ME, "no %s", key);
-    char linkId[8] = {0};
-    snprintf(key, sizeof(key), "mld_link_id[%u]", idx);
-    rc = wld_wpaCtrl_getInReplyParamValStr(reply, key, linkId, sizeof(linkId));
-    if(swl_rc_isOk(rc) && !swl_str_isEmpty(linkId)) {
-        snprintf(skname, sknameSize, "%s_link%s", ifname, linkId);
-    } else {
-        swl_str_copy(skname, sknameSize, ifname);
-    }
-    return SWL_RC_OK;
-}
