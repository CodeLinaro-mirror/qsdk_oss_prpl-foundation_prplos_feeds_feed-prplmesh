+/* Shared control-traffic generation; consumers discard observations when it
+ * changes. Events and transport failures affect all daemon managers.
+ */
+static uint64_t s_controlEpoch;
+
+uint64_t wld_wpaCtrlConnection_getControlEpoch(void) {
+    return s_controlEpoch;
+}
+
+void wld_wpaCtrlConnection_advanceControlEpoch(void) {
+    s_controlEpoch++;
+}
+
+static bool s_isReadOnly(const char* cmd) {
+    static const char* const reads[] = {"GET_CONFIG", "STATUS", "PING", "LINKID 0 PING"};
+    for(size_t i = 0; i < sizeof(reads) / sizeof(reads[0]); i++) {
+        if(swl_str_matches(cmd, reads[i])) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void s_noteCommand(const char* cmd) {
+    /* Attachment success cannot change identity; attachment failures still
+     * advance the epoch. Unknown/vendor commands are potential mutations.
+     */
+    if(!s_isReadOnly(cmd) && !swl_str_matches(cmd, "ATTACH") && !swl_str_matches(cmd, "DETACH")) {
+        wld_wpaCtrlConnection_advanceControlEpoch();
+    }
+}
+
+static void s_noteReplyFailure(wpaCtrlConnection_t* pConn, const char* cmd) {
+    /* Even a read rejection can invalidate a previously enabled BSS. Bare
+     * MLD endpoints reject reads too, without affecting unrelated sockets.
+     */
+    if(s_isReadOnly(cmd)) {
+        wld_hostapd_invalidateSockPath(s_getConnSrvPath(pConn));
+    } else {
+        wld_wpaCtrlConnection_advanceControlEpoch();
+    }
+}
+
 swl_rc_ne wld_wpaCtrlConnection_sendCmd(wpaCtrlConnection_t* pConn, const char* cmd) {
     ASSERTS_NOT_NULL(pConn, SWL_RC_INVALID_PARAM, ME, "NULL");
+    s_noteCommand(cmd);
     int fd = pConn->wpaPeer;
+    if(fd <= 0) {
+        wld_wpaCtrlConnection_advanceControlEpoch();
+    }
     ASSERTS_TRUE(fd > 0, SWL_RC_INVALID_STATE, ME, "fd <= 0");
 
     const char* srvPath = s_getConnSrvPath(pConn);
     size_t len = strlen(cmd);
     ssize_t ret = send(fd, cmd, len, 0);
     SAH_TRACEZ_INFO(ME, "send cmd (%s) to (%s)", cmd, srvPath);
+    if(ret != (ssize_t) len) {
+        wld_wpaCtrlConnection_advanceControlEpoch();
+    }
     ASSERT_EQUALS(ret, (ssize_t) len, SWL_RC_ERROR, ME, "Failed to send cmd (%s) to (%s): ret(%d), err(%d:%s)",
                   cmd, srvPath,
                   (int32_t) ret, errno, strerror(errno));
@@ -263,7 +314,7 @@
     return SWL_RC_OK;
 }
 
-swl_rc_ne wld_wpaCtrlConnection_sendCmdSyncedExt(wpaCtrlConnection_t* pConn, const char* cmd, char* reply, size_t replyLen, uint32_t tmOutMSec) {
