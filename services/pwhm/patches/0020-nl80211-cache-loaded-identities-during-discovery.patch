+/* Re-evaluate current/remembered BSSIDs on every hit; retain no AP pointers. */
+static swl_rc_ne s_matchAP(const char* dir, wld_hostapd_sock_t* pSock) {
+    pSock->ap = NULL;
+    pSock->resolved = false;
+    T_AccessPoint* pCurrent = NULL;
+    T_AccessPoint* pOld = NULL;
+    unsigned int currentCount = 0, oldCount = 0;
+    T_Radio* pRad = NULL;
+    wld_for_eachRad(pRad) {
+        if((pRad->hostapd == NULL) || !s_radioMatches(pSock, pRad) ||
+           !swl_str_matches(dir, wld_wpaCtrlMngr_getCtrlIfaceDirPath(wld_secDmn_getWpaCtrlMgr(pRad->hostapd)))) {
+            continue;
+        }
+        T_AccessPoint* pAP = NULL;
+        wld_rad_forEachAp(pAP, pRad) {
+            if((pAP->pSSID == NULL) || (pAP->wpaCtrlInterface == NULL)) {
+                continue;
+            }
+            if(!memcmp(pAP->pSSID->BSSID, &pSock->bssid, 6)) {
+                pCurrent = pAP;
+                currentCount++;
+            } else if(!memcmp(pAP->wpaCtrlInterface->loadedBssid, &pSock->bssid, 6)) {
+                pOld = pAP;
+                oldCount++;
+            }
+        }
+    }
+    ASSERTI_TRUE((currentCount == 1) || ((currentCount == 0) && (oldCount == 1)),
+                 SWL_RC_ERROR, ME, "unknown or ambiguous AP: %s", pSock->name);
+    pSock->ap = currentCount ? pCurrent : pOld;
+    pSock->resolved = true;
+    return SWL_RC_OK;
+}
+
+typedef struct {
+    unsigned int fresh;
+    unsigned int cached;
+    uint64_t slowestMs;
+} hostapdDiscoveryStats_t;
+
+/* Time individual identity requests, including failed queries, only for
+ * discovery. Fresh counts attempted socket resolutions, cached counts hits.
+ */
+static swl_rc_ne s_identityQuery(const char* dir, const char* name, const char* cmd,
+                                 char* reply, size_t len, hostapdDiscoveryStats_t* stats) {
+    struct timespec before, after;
+    bool timed = stats && (clock_gettime(CLOCK_MONOTONIC, &before) == 0);
+    swl_rc_ne rc = wld_wpaCtrl_queryToSock(dir, name, cmd, reply, len);
+    if(timed && (clock_gettime(CLOCK_MONOTONIC, &after) == 0)) {
+        int64_t ns = ((int64_t) after.tv_sec - before.tv_sec) * 1000000000 + after.tv_nsec - before.tv_nsec;
+        uint64_t ms = (ns > 0) ? (uint64_t) ns / 1000000 : 0;
+        if(ms > stats->slowestMs) {
+            stats->slowestMs = ms;
+        }
+    }
+    return rc;
+}
