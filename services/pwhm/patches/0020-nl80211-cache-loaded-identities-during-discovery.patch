+/* Bounded, shared by the managers of a grouped daemon. No retained FDs or
+ * pointers to AP/manager/process objects. Unresolved and MLD endpoints are
+ * deliberately not cached: the 0018 discriminator must remain positive.
+ */
+#define HAPD_IDENTITY_CACHE_SIZE 64
+/* Non-sliding upper bound for missed events or out-of-band reconfiguration.
+ * Destructive decisions always bypass this discovery cache.
+ */
+#define HAPD_IDENTITY_CACHE_MS 5000
+
+typedef struct {
+    char path[sizeof(((struct sockaddr_un*) 0)->sun_path)];
+    struct stat st;
+    pid_t pid;
+    uint32_t restarts;
+    time_t failHint; /* failDate tracks initialization/last failure, not start time. */
+    uint64_t expires;
+    wld_hostapd_sock_t sock;
+} hostapdIdentityCache_t;
+
+static hostapdIdentityCache_t s_identityCache[HAPD_IDENTITY_CACHE_SIZE];
+static unsigned int s_cacheSlot;
+static uint64_t s_cacheEpoch;
+
+static void s_invalidateCache(void) {
+    memset(s_identityCache, 0, sizeof(s_identityCache));
+    s_cacheEpoch = wld_wpaCtrlConnection_getControlEpoch();
+}
+
+void wld_hostapd_invalidateSockPath(const char* path) {
+    for(size_t i = 0; i < HAPD_IDENTITY_CACHE_SIZE; i++) {
+        if(swl_str_matches(path, s_identityCache[i].path)) {
+            memset(&s_identityCache[i], 0, sizeof(s_identityCache[i]));
+        }
+    }
+}
+
+static bool s_sameSocket(const struct stat* a, const struct stat* b) {
+    return S_ISSOCK(b->st_mode) && (a->st_dev == b->st_dev) && (a->st_ino == b->st_ino) &&
+           (a->st_ctim.tv_sec == b->st_ctim.tv_sec) && (a->st_ctim.tv_nsec == b->st_ctim.tv_nsec);
+}
+
+static bool s_hasIdentityEvents(const char* dir, const wld_hostapd_sock_t* pSock) {
+    wld_wpaCtrlInterface_t* iface = pSock->ap->wpaCtrlInterface;
+    return wld_wpaCtrlInterface_isReady(iface) && (iface->serverInode == pSock->inode) &&
+           swl_str_matches(pSock->name, wld_wpaCtrlInterface_getConnectionSockName(iface)) &&
+           swl_str_matches(dir, wld_wpaCtrlInterface_getConnectionDirPath(iface));
+}
+
+static swl_rc_ne s_cachedSock(wld_wpaCtrlMngr_t* pMgr, const char* name, wld_hostapd_sock_t* pSock, hostapdDiscoveryStats_t* stats) {
+    if(s_cacheEpoch != wld_wpaCtrlConnection_getControlEpoch()) {
+        s_invalidateCache();
+    }
+    /* The directory also contains other managers' sockets. The scanning
+     * manager supplies a conservative generation hint; live AP matching and
+     * the matched AP's event client must vouch for every stored/hit identity.
+     */
+    const char* dir = wld_wpaCtrlMngr_getCtrlIfaceDirPath(pMgr);
+    wld_process_t* proc = pMgr->pSecDmn ? pMgr->pSecDmn->dmnProcess : NULL;
+    pid_t pid = (proc && proc->process) ? amxp_subproc_get_pid(proc->process->proc) : 0;
+    char path[sizeof(s_identityCache[0].path)];
+    struct stat before, after;
+    struct timespec ts;
+    int len = snprintf(path, sizeof(path), "%s/%s", dir, name);
+    if((pid <= 0) || (len < 0) || ((size_t) len >= sizeof(path)) ||
+       (stat(path, &before) != 0) || !S_ISSOCK(before.st_mode) ||
+       (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)) {
+        s_invalidateCache();
+        stats->fresh++;
+        return s_resolveSock(dir, name, pSock, stats);
+    }
+    uint64_t now = ((uint64_t) ts.tv_sec * 1000) + ts.tv_nsec / 1000000;
+    for(size_t i = 0; i < HAPD_IDENTITY_CACHE_SIZE; i++) {
+        hostapdIdentityCache_t* entry = &s_identityCache[i];
+        if(!swl_str_matches(path, entry->path)) {
+            continue;
+        }
+        if((entry->pid == pid) && (entry->restarts == proc->totalRestarts) &&
+           (entry->failHint == proc->failDate) && (now < entry->expires) &&
+           s_sameSocket(&entry->st, &before)) {
+            *pSock = entry->sock;
+            /* A disconnected event client cannot vouch for cached state. */
+            if(swl_rc_isOk(s_matchAP(dir, pSock)) && s_hasIdentityEvents(dir, pSock)) {
+                stats->cached++;
+                return SWL_RC_OK;
+            }
+        }
+        memset(entry, 0, sizeof(*entry));
+    }
+    uint64_t epoch = wld_wpaCtrlConnection_getControlEpoch();
+    stats->fresh++;
+    swl_rc_ne rc = s_resolveSock(dir, name, pSock, stats);
+    if(swl_rc_isOk(rc) && s_hasIdentityEvents(dir, pSock) && (epoch == wld_wpaCtrlConnection_getControlEpoch()) &&
+       (stat(path, &after) == 0) && s_sameSocket(&before, &after)) {
+        hostapdIdentityCache_t* entry = &s_identityCache[s_cacheSlot++ % HAPD_IDENTITY_CACHE_SIZE];
+        memset(entry, 0, sizeof(*entry));
+        swl_str_copy(entry->path, sizeof(entry->path), path);
+        entry->st = after;
+        entry->pid = pid;
+        entry->restarts = proc->totalRestarts;
+        entry->failHint = proc->failDate;
+        entry->expires = now + HAPD_IDENTITY_CACHE_MS;
+        entry->sock = *pSock;
+        entry->sock.ap = NULL;
+        entry->sock.next = NULL;
+    }
+    return rc;
+}
+
 /** @brief Collect independent results, including unresolved local evidence. */
-swl_rc_ne wld_hostapd_snapshot(wld_wpaCtrlMngr_t* pMgr, wld_hostapd_sock_t** socks) {
+static swl_rc_ne s_snapshot(wld_wpaCtrlMngr_t* pMgr, wld_hostapd_sock_t** socks, bool cached) {
+    hostapdDiscoveryStats_t stats = {0};
     *socks = NULL;
     const char* dir = wld_wpaCtrlMngr_getCtrlIfaceDirPath(pMgr);
     struct dirent** names = NULL;
@@ -288,7 +436,7 @@
             rc = SWL_RC_ERROR;
             break;
         }
-        if(!swl_rc_isOk(wld_hostapd_resolveSock(dir, name, pSock))) {
+        if(!swl_rc_isOk(cached ? s_cachedSock(pMgr, name, pSock, &stats) : wld_hostapd_resolveSock(dir, name, pSock))) {
             SAH_TRACEZ_INFO(ME, "exclude unresolved BSS socket %s", name);
         }
         pSock->next = *socks;
@@ -301,7 +449,20 @@
     if(!swl_rc_isOk(rc)) {
         wld_hostapd_freeSnapshot(socks);
     }
+    /* Keep ordinary warm/small scans quiet at the saved WARNING log level. */
+    if(cached && (stats.fresh > 3) && (stats.slowestMs > 200)) {
+        SAH_TRACEZ_WARNING(ME, "discovery %s: fresh=%u cached=%u slowest=%llu ms",
+                           dir, stats.fresh, stats.cached, (unsigned long long) stats.slowestMs);
+    }
     return rc;
+}
+
+swl_rc_ne wld_hostapd_snapshot(wld_wpaCtrlMngr_t* pMgr, wld_hostapd_sock_t** socks) {
+    return s_snapshot(pMgr, socks, false);
+}
+
+swl_rc_ne wld_hostapd_discoverySnapshot(wld_wpaCtrlMngr_t* pMgr, wld_hostapd_sock_t** socks) {
+    return s_snapshot(pMgr, socks, true);
 }
 
