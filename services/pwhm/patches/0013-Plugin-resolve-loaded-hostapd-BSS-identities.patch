+/* A hostapd unpark can recreate a server without any netdev event. */
+static void s_refreshConnection(wld_wpaCtrlInterface_t* pIface) {
+    if((pIface == NULL) || !pIface->isReady) {
+        return;
+    }
+    uint64_t inode = wld_wpaCtrlInterface_getConnectionInode(pIface);
+    if(inode && pIface->serverInode && (inode != pIface->serverInode)) {
+        wld_wpaCtrlInterface_close(pIface);
+        wld_wpaCtrlInterface_open(pIface);
+    }
+}
