+#define ME "hapdSock"
+
+static uint64_t s_inode(const char* dir, const char* name) {
+    char path[PATH_MAX];
+    struct stat st;
+    snprintf(path, sizeof(path), "%s/%s", dir, name);
+    return ((stat(path, &st) == 0) && S_ISSOCK(st.st_mode)) ? st.st_ino : 0;
+}
+
+/* Match complete reply keys: a vendor-prefixed key is not the requested key. */
+static bool s_value(const char* reply, const char* key, char* value, size_t len) {
+    size_t keyLen = strlen(key);
+    for(const char* line = reply; *line; ) {
+        const char* end = strchr(line, '\n');
+        if(end == NULL) {
+            end = line + strlen(line);
+        }
+        if(((size_t) (end - line) > keyLen) && !strncmp(line, key, keyLen) && (line[keyLen] == '=')) {
+            size_t n = end - line - keyLen - 1;
+            if(n >= len) {
+                return false;
+            }
+            memcpy(value, line + keyLen + 1, n);
+            value[n] = 0;
+            return true;
+        }
+        line = *end ? end + 1 : end;
+    }
+    return false;
+}
+
+static bool s_bssName(const char* reply, unsigned int i, char* name, size_t len) {
+    char key[32], iface[IFNAMSIZ + 1] = {0}, value[32] = {0};
+    snprintf(key, sizeof(key), "bss[%u]", i);
+    if(!s_value(reply, key, iface, sizeof(iface))) {
+        return false;
+    }
+    snprintf(key, sizeof(key), "mld_link_id[%u]", i);
+    if(s_value(reply, key, value, sizeof(value)) && (atoi(value) >= 0)) {
+        snprintf(name, len, "%s_link%d", iface, atoi(value));
+    } else {
+        swl_str_copy(name, len, iface);
+    }
+    return true;
+}
+
+static bool s_radioMatches(const wld_hostapd_sock_t* pSock, T_Radio* pRad) {
+    bool label = swl_str_matches(pSock->phy, pRad->Name);
+    return (label || swl_str_matches(pSock->phy, pRad->wiphyName)) &&
+           (!pSock->hasBand || (pSock->chspec.band == pRad->operatingFrequencyBand)) &&
+           (label || pSock->hasBand || (wld_rad_countWiphyRads(pRad->wiphy) == 1));
+}
+
+/**
+ * @brief Resolve one loaded BSS without adopting desired MLD metadata.
+ * Keep partial evidence on failure for radio-local removal preflight.
+ */
+swl_rc_ne wld_hostapd_resolveSock(const char* dir, const char* name, wld_hostapd_sock_t* pSock) {
+    ASSERT_NOT_NULL(pSock, SWL_RC_INVALID_PARAM, ME, "NULL");
+    memset(pSock, 0, sizeof(*pSock));
+    ASSERTI_TRUE(swl_str_len(name) < sizeof(pSock->name), SWL_RC_ERROR, ME, "long socket name %s", name);
+    swl_str_copy(pSock->name, sizeof(pSock->name), name);
+    pSock->inode = s_inode(dir, name);
+    ASSERTI_TRUE(pSock->inode != 0, SWL_RC_ERROR, ME, "missing socket %s", name);
+    char reply[wld_wpaCtrl_getMaxMsgLen()];
+    char value[128] = {0};
+    memset(reply, 0, sizeof(reply));
+    swl_rc_ne rc = wld_wpaCtrl_queryToSock(dir, name, "GET_CONFIG", reply, sizeof(reply));
+    bool hasBssid = swl_rc_isOk(rc) && s_value(reply, "bssid", value, sizeof(value)) &&
+                    swl_typeMacBin_fromChar(&pSock->bssid, value) && !swl_mac_binIsNull(&pSock->bssid);
+    /* STATUS can still identify a local candidate if GET_CONFIG timed out. */
+    memset(reply, 0, sizeof(reply));
+    rc = wld_wpaCtrl_queryToSock(dir, name, "STATUS", reply, sizeof(reply));
+    ASSERTI_TRUE(swl_rc_isOk(rc), SWL_RC_ERROR, ME, "STATUS unavailable: %s", name);
+    pSock->enabled = s_value(reply, "state", value, sizeof(value)) && swl_str_matches(value, "ENABLED");
+    s_value(reply, "phy", pSock->phy, sizeof(pSock->phy));
+    pSock->hasBand = s_value(reply, "freq", value, sizeof(value)) && (atoi(value) > 0) &&
+                     swl_rc_isOk(swl_chanspec_channelFromMHz(&pSock->chspec, atoi(value)));
+    ASSERTI_TRUE(s_bssName(reply, 0, pSock->owner, sizeof(pSock->owner)), SWL_RC_ERROR, ME, "no owner: %s", name);
+    bool self = false, redirect = false;
+    char bssName[WLD_HAPD_SOCK_NAME_LEN];
+    for(unsigned int i = 0; s_bssName(reply, i, bssName, sizeof(bssName)); i++) {
+        char key[32], base[IFNAMSIZ + 1] = {0};
+        snprintf(key, sizeof(key), "bss[%u]", i);
+        s_value(reply, key, base, sizeof(base));
+        if(swl_str_matches(base, name) && !swl_str_matches(bssName, name)) {
+            redirect = true;
+        }
+        if(!swl_str_matches(bssName, name)) {
+            continue;
+        }
+        swl_macBin_t mac = SWL_MAC_BIN_NEW();
+        snprintf(key, sizeof(key), "bssid[%u]", i);
+        ASSERTI_TRUE(hasBssid && s_value(reply, key, value, sizeof(value)) &&
+                     swl_typeMacBin_fromChar(&mac, value) && !memcmp(&mac, &pSock->bssid, sizeof(mac)),
+                     SWL_RC_ERROR, ME, "inconsistent BSSID: %s", name);
+        ASSERTI_FALSE(self, SWL_RC_ERROR, ME, "duplicate self entry: %s", name);
+        self = true;
+    }
+    /* Positive STATUS evidence, never directory sort order, identifies redirects. */
+    pSock->nonBss = !self && redirect;
+    ASSERTI_TRUE(self, SWL_RC_ERROR, ME, "not a BSS socket: %s", name);
+    T_AccessPoint* pCurrent = NULL;
+    T_AccessPoint* pOld = NULL;
+    unsigned int currentCount = 0, oldCount = 0;
+    T_Radio* pRad = NULL;
+    wld_for_eachRad(pRad) {
+        if((pRad->hostapd == NULL) || !s_radioMatches(pSock, pRad) ||
+           !swl_str_matches(dir, wld_wpaCtrlMngr_getCtrlIfaceDirPath(wld_secDmn_getWpaCtrlMgr(pRad->hostapd)))) {
+            continue;
+        }
+        T_AccessPoint* pAP = NULL;
+        wld_rad_forEachAp(pAP, pRad) {
+            if((pAP->pSSID == NULL) || (pAP->wpaCtrlInterface == NULL)) {
+                continue;
+            }
+            if(!memcmp(pAP->pSSID->BSSID, &pSock->bssid, 6)) {
+                pCurrent = pAP;
+                currentCount++;
+            } else if(!memcmp(pAP->wpaCtrlInterface->loadedBssid, &pSock->bssid, 6)) {
+                pOld = pAP;
+                oldCount++;
+            }
+        }
+    }
+    ASSERTI_TRUE((currentCount == 1) || ((currentCount == 0) && (oldCount == 1)),
+                 SWL_RC_ERROR, ME, "unknown or ambiguous AP: %s", name);
+    ASSERTI_TRUE(pSock->inode == s_inode(dir, name), SWL_RC_ERROR, ME, "socket replaced: %s", name);
+    pSock->ap = currentCount ? pCurrent : pOld;
+    pSock->resolved = true;
+    return SWL_RC_OK;
+}
+
+swl_rc_ne wld_hostapd_getSock(wld_wpaCtrlMngr_t* pMgr, const char* name, wld_hostapd_sock_t* pSock) {
+    return wld_hostapd_resolveSock(wld_wpaCtrlMngr_getCtrlIfaceDirPath(pMgr), name, pSock);
+}
+
+void wld_hostapd_rememberBssid(T_AccessPoint* pAP) {
+    if((pAP != NULL) && (pAP->pSSID != NULL) && (pAP->wpaCtrlInterface != NULL) &&
+       swl_mac_binIsNull((swl_macBin_t*) pAP->wpaCtrlInterface->loadedBssid)) {
+        memcpy(pAP->wpaCtrlInterface->loadedBssid, pAP->pSSID->BSSID, 6);
+    }
+}
