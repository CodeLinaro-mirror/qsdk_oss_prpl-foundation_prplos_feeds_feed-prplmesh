+#ifndef WLD_HOSTAPD_SOCK_H
+#define WLD_HOSTAPD_SOCK_H
+
+#include "wld/wld.h"
+#include "wld/wld_wpaCtrlMngr.h"
+
+#define WLD_HAPD_SOCK_NAME_LEN (IFNAMSIZ + 16)
+
+/* One entry per loaded BSS instance, including old/new overlap for one AP. */
+typedef struct wld_hostapd_sock {
+    struct wld_hostapd_sock* next;
+    T_AccessPoint* ap;
+    char name[WLD_HAPD_SOCK_NAME_LEN];
+    char owner[WLD_HAPD_SOCK_NAME_LEN];
+    swl_macBin_t bssid;
+    uint64_t inode;
+    bool enabled;
+    bool resolved;
+    bool nonBss;
+    char phy[128];
+    swl_chanspec_t chspec;
+    bool hasBand;
+} wld_hostapd_sock_t;
+
+/* Read-only: neither desired MLD metadata nor saved associations are changed. */
+swl_rc_ne wld_hostapd_resolveSock(const char* dir, const char* name, wld_hostapd_sock_t* sock);
+swl_rc_ne wld_hostapd_getSock(wld_wpaCtrlMngr_t* mgr, const char* name, wld_hostapd_sock_t* sock);
+void wld_hostapd_rememberBssid(T_AccessPoint* ap);
+
+#endif
