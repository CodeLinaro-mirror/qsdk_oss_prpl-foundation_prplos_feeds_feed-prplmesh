+ bool ap_wlan_hal_nl80211::remove_affiliated_ap(const sMacAddr &bssid)
+ {
+    std::list<son::wireless_utils::sBssInfoConf> bss_info_conf_list;
+    son::wireless_utils::sBssInfoConf bss_info_conf;
+    bss_info_conf.bssid = bssid;
+    bss_info_conf.teardown = true;
+    bss_info_conf_list.push_back(bss_info_conf);
+    /* framing for removing this bssid */
+    update_vap_credentials(bss_info_conf_list, "", "", "");
+    return true;
+ }
