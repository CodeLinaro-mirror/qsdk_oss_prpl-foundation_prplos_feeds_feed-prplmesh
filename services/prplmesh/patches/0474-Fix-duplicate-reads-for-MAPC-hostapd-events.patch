From 9fc0b13205caa8f8c7924185514fd1b61673e34c Mon Sep 17 00:00:00 2001
From: Anurag Sethi <anurseth@qti.qualcomm.com>
Date: Tue, 29 Sep 2026 11:53:03 -0700
Subject: [PATCH] Fix duplicate reads for MAPC hostapd events

Signed-off-by: Anurag Sethi <anurseth@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index b2458b315..68fd642d6 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -7915,6 +7915,12 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         if (from_global_sock) {
             return true;
         }
+    } else if (event == Event::MAPC_Negotiation_Status || event == Event::MAPC_Discovery_Report) {
+        if (from_global_sock) {
+            LOG(DEBUG) << "Ignoring " << opcode << " on global socket for " << interface
+                       << " (per-VAP socket already delivers this event)";
+            return true;
+        }
     }
 
     auto vap_id    = get_vap_id_with_bss(interface);
-- 
2.34.1

