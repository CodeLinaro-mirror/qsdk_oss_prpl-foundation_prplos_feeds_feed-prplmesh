From 6f57a695fa3a51b9b472bc8c896e22d1aab65e4e Mon Sep 17 00:00:00 2001
From: mpaluri <mpaluri@qti.qualcomm.com>
Date: Sun, 27 Sep 2026 19:32:00 -0700
Subject: [PATCH] Set cotdma hostapd conf only on one front haul vap

Set mapc_cotdma_enable and mapc_negotiation_mode to 1 on only one front
haul vap per radio. Also set deferred_scs to 1 on all the vaps

Signed-off-by: Manaswini Paluri <mpaluri@qti.qulacomm.com>

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 354136d43..ea3dd6c5a 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -5118,6 +5118,9 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     [](const son::wireless_utils::sBssInfoConf &b) { return b.teardown; });
 
     int bss_iterator = 0;
+    // True if MAPC params are already written on any FH VAP — either from a prior
+    // update_vap_credentials pass, or on an earlier FH VAP in this pass.
+    bool cotdma_set_on_fh_vap = is_mapc_cotdma_set_on_any_fh_vap();
 
     //variables to check if interface of radio and the bss is same or different
     bool new_radio_iface_name_update_req = true;
@@ -5621,28 +5624,32 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 if (bss_it.fronthaul) {
                     conf.set_create_vap_value(vap_id, "notify_mgmt_frames", "1");
                     /* Enable MAPC negotiation on fronthaul VAPs so hostapd participates in
-                     * EasyMesh coordinated TDMA discovery and capability exchange. */
-                    if (get_hal_conf().enable_cotdma &&
-                        conf.get_vap_value(vap_id, "mapc_cotdma_enable") != "1") {
-                        if (conf.set_create_vap_value(vap_id, "mapc_cotdma_enable", "1")) {
-                            LOG(INFO) << "update_vap_credentials: set mapc_cotdma_enable=1 "
-                                      << "in hostapd config for " << m_radio_info.iface_name;
-                        } else {
-                            LOG(WARNING) << "update_vap_credentials: failed to set "
-                                         << "mapc_cotdma_enable in hostapd config for "
-                                         << m_radio_info.iface_name;
+                     * EasyMesh coordinated TDMA discovery and capability exchange.
+                     * Only set on the first FH VAP encountered — cotdma_set_on_fh_vap tracks
+                     * both prior passes (seeded from is_mapc_cotdma_set_on_any_fh_vap()) and
+                     * earlier entries in the current batch. */
+                    if (!cotdma_set_on_fh_vap && get_hal_conf().enable_cotdma) {
+                        if (conf.get_vap_value(vap_id, "mapc_cotdma_enable") != "1") {
+                            if (conf.set_create_vap_value(vap_id, "mapc_cotdma_enable", "1")) {
+                                LOG(INFO) << "update_vap_credentials: set mapc_cotdma_enable=1 "
+                                          << "in hostapd config for " << m_radio_info.iface_name;
+                            } else {
+                                LOG(WARNING) << "update_vap_credentials: failed to set "
+                                             << "mapc_cotdma_enable in hostapd config for "
+                                             << m_radio_info.iface_name;
+                            }
                         }
-                    }
-                    if (get_hal_conf().enable_cotdma &&
-                        conf.get_vap_value(vap_id, "mapc_negotiation_mode") != "1") {
-                        if (conf.set_create_vap_value(vap_id, "mapc_negotiation_mode", "1")) {
-                            LOG(INFO) << "update_vap_credentials: set mapc_negotiation_mode=1 "
-                                      << "in hostapd config for " << m_radio_info.iface_name;
-                        } else {
-                            LOG(WARNING) << "update_vap_credentials: failed to set "
-                                         << "mapc_negotiation_mode in hostapd config for "
-                                         << m_radio_info.iface_name;
+                        if (conf.get_vap_value(vap_id, "mapc_negotiation_mode") != "1") {
+                            if (conf.set_create_vap_value(vap_id, "mapc_negotiation_mode", "1")) {
+                                LOG(INFO) << "update_vap_credentials: set mapc_negotiation_mode=1 "
+                                          << "in hostapd config for " << m_radio_info.iface_name;
+                            } else {
+                                LOG(WARNING) << "update_vap_credentials: failed to set "
+                                             << "mapc_negotiation_mode in hostapd config for "
+                                             << m_radio_info.iface_name;
+                            }
                         }
+                        cotdma_set_on_fh_vap = true;
                     }
                     if (get_hal_conf().certification_mode) {
                         // MBO and Interworking must be enabled on every fronthaul VAP so that
@@ -5665,6 +5672,16 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 }
                 // Enable hostapd reporting of connection failures
                 conf.set_create_vap_value(vap_id, "report_connection_failures", "1");
+                if (get_hal_conf().enable_cotdma && conf.get_vap_value(vap_id, "deferred_scs") != "1") {
+                    if (conf.set_create_vap_value(vap_id, "deferred_scs", "1")) {
+                        LOG(INFO) << "update_vap_credentials: set deferred_scs=1 "
+                                  << "in hostapd config for " << m_radio_info.iface_name;
+                    } else {
+                        LOG(WARNING) << "update_vap_credentials: failed to set "
+                                     << "deferred_scs in hostapd config for "
+                                     << m_radio_info.iface_name;
+                    }
+                }
 
                 // If this BSS config's AKM is DPP (or the DPP-equivalent OUI), configure
                 // hostapd's native DPP-over-TCP relay for this VAP — needed in both gateway
@@ -7628,6 +7645,27 @@ bool ap_wlan_hal_nl80211::get_bss_uses_rsna_cached(const std::string &bssid_str)
     return uses_rsna;
 }
 
+bool ap_wlan_hal_nl80211::is_mapc_cotdma_set_on_any_fh_vap()
+{
+    for (const auto &vap : m_radio_info.available_vaps) {
+        if (!vap.second.fronthaul) {
+            continue;
+        }
+        prplmesh::hostapd::Configuration conf = load_hostapd_config(vap.second.mac);
+        if (!conf) {
+            continue;
+        }
+        const auto &vap_id = conf.get_vap_by_bssid(vap.second.mac);
+        if (vap_id.empty()) {
+            continue;
+        }
+        if (conf.get_vap_value(vap_id, "mapc_cotdma_enable") == "1") {
+            return true;
+        }
+    }
+    return false;
+}
+
 bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
 {
     // Filter out empty events
@@ -9788,8 +9826,7 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
         conf.set_create_vap_value(vap_id, "notify_mgmt_frames", "1");
         /* Enable MAPC negotiation on fronthaul VAPs so hostapd participates in
          * EasyMesh coordinated TDMA discovery and capability exchange. */
-        if (get_hal_conf().enable_cotdma &&
-            conf.get_vap_value(vap_id, "mapc_cotdma_enable") != "1") {
+        if (get_hal_conf().enable_cotdma && !is_mapc_cotdma_set_on_any_fh_vap()) {
             if (conf.set_create_vap_value(vap_id, "mapc_cotdma_enable", "1")) {
                 LOG(INFO) << "create_new_hostapd_conf_file: set mapc_cotdma_enable=1 "
                           << "in hostapd config for " << m_radio_info.iface_name;
@@ -9798,9 +9835,6 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
                              << "mapc_cotdma_enable in hostapd config for "
                              << m_radio_info.iface_name;
             }
-        }
-        if (get_hal_conf().enable_cotdma &&
-            conf.get_vap_value(vap_id, "mapc_negotiation_mode") != "1") {
             if (conf.set_create_vap_value(vap_id, "mapc_negotiation_mode", "1")) {
                 LOG(INFO) << "create_new_hostapd_conf_file: set mapc_negotiation_mode=1 "
                           << "in hostapd config for " << m_radio_info.iface_name;
@@ -9832,6 +9866,10 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
 
     //Enable hostapd reporting of connection failures
     conf.set_create_vap_value(vap_id, "report_connection_failures", "1");
+    if (get_hal_conf().enable_cotdma) {
+        conf.set_create_vap_value(vap_id, "deferred_scs", "1");
+        LOG(INFO) << "create_new_hostapd_conf_file: set deferred_scs=1 for " << ifname;
+    }
 
     std::string multi_ap;
     if (bss_conf.fronthaul) {
