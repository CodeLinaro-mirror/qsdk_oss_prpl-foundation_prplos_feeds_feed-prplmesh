+void db::dm_trigger_cotdma_failure_event(uint64_t incident_id, const std::string &detected_by,
+                                         const sMacAddr &sharing_bssid,
+                                         const sMacAddr &shared_bssid, const std::string &stage,
+                                         const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    std::string sharing_bssid_str = tlvf::mac_to_string(sharing_bssid);
+    std::string shared_bssid_str  = tlvf::mac_to_string(shared_bssid);
+
+    std::string dm_path;
+    auto owning_agent_mac = get_bss_parent_agent(sharing_bssid);
+    if (owning_agent_mac != beerocks::net::network_utils::ZERO_MAC) {
+        auto agent = get_agent(owning_agent_mac);
+        if (agent) {
+            dm_path = agent->dm_path;
+        }
+    }
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress",   sharing_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",       dm_path.c_str());
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID",   incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy",   detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "SharingBSSID", sharing_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "SharedBSSID",  shared_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Stage",        stage.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason",       reason.c_str());
+
+    const std::string vendor_event_obj = DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.CotdmaFailure";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_cotdma_failure_event: failed to trigger CotdmaFailure"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " sharing_bssid=" << sharing_bssid_str
+                   << " shared_bssid=" << shared_bssid_str << " stage=" << stage
+                   << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_cotdma_failure_event: triggered CotdmaFailure"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " sharing_bssid=" << sharing_bssid_str
+                   << " shared_bssid=" << shared_bssid_str << " stage=" << stage
+                   << " reason=" << reason;
+    }
+#else // !ENABLE_NBAPI
+    (void)incident_id;
+    (void)detected_by;
+    (void)sharing_bssid;
+    (void)shared_bssid;
+    (void)stage;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
