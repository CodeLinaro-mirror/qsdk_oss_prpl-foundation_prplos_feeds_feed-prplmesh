+    case eEvent::COTDMA_FAILURE: {
+        auto event = static_cast<const sCotdmaFailureEvent *>(event_obj);
+        if (!event) {
+            LOG(ERROR) << "HEALTH_MONITORING: COTDMA_FAILURE event_obj is nullptr";
+            break;
+        }
+
