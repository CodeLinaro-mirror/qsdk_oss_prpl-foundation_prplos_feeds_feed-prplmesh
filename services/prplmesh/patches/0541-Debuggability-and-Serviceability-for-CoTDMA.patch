index afc71e805..56d8e7d2c 100644
--- a/agent/src/beerocks/slave/agent_db.cpp
+++ b/agent/src/beerocks/slave/agent_db.cpp
@@ -689,4 +689,57 @@ void AgentDB::dm_trigger_fronthaul_restart_event(uint64_t incident_id,
 #endif // ENABLE_NBAPI
 }
 
+void AgentDB::dm_trigger_cotdma_failure_event(uint64_t incident_id,
+                                              const std::string &detected_by,
+                                              const sMacAddr &local_bssid,
+                                              const sMacAddr &peer_bssid,
+                                              const std::string &stage,
+                                              const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    LOG_IF(!m_ambiorix_datamodel, FATAL) << "m_ambiorix_datamodel not set";
+
+    const std::string controller_id  = tlvf::mac_to_string(controller_info.bridge_mac);
+    const std::string local_bssid_str = tlvf::mac_to_string(local_bssid);
+    const std::string peer_bssid_str  = tlvf::mac_to_string(peer_bssid);
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", controller_id.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",     AGENT_ROOT_DM ".QCOM_Vendor.");
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID", incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy", detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "LocalBSSID", local_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "PeerBSSID",  peer_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Stage",      stage.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason",     reason.c_str());
+
+    const std::string vendor_event_obj = AGENT_ROOT_DM ".QCOM_Vendor.CotdmaFailure";
+    const bool ok = m_ambiorix_datamodel->trigger_event_with_data(
+        vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_cotdma_failure_event: failed to trigger CotdmaFailure"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " local_bssid=" << local_bssid_str << " peer_bssid=" << peer_bssid_str
+                   << " stage=" << stage << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_cotdma_failure_event: triggered CotdmaFailure"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " local_bssid=" << local_bssid_str << " peer_bssid=" << peer_bssid_str
+                   << " stage=" << stage << " reason=" << reason;
+    }
+#else
+    (void)incident_id;
+    (void)detected_by;
+    (void)local_bssid;
+    (void)peer_bssid;
+    (void)stage;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
+
 } // namespace beerocks
