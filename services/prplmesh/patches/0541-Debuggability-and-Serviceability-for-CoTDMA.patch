+                          << sharing_bssid << " shared_bssid=" << shared_bssid
+                          << " stage=" << stage << " reason=" << reason << ")";
+        return;
+    }
+
+    HealthMonitoringTask::sCotdmaFailureEvent event;
+    event.sharing_bssid = sharing_bssid;
+    event.shared_bssid  = shared_bssid;
+    event.stage         = stage;
+    event.reason        = reason;
+
+    tasks.push_event(health_task_id,
+                     static_cast<int>(HealthMonitoringTask::eEvent::COTDMA_FAILURE), &event);
+}
