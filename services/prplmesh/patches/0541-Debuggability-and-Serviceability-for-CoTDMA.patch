     ~HealthMonitoringTask() {}
 
-    enum class eEvent : uint8_t { AGENT_RESTARTING, FRONTHAUL_STARTED };
+    enum class eEvent : uint8_t {
+        AGENT_RESTARTING,
+        FRONTHAUL_STARTED,
+        /**
+         * @brief Generic Co-TDMA failure event, covering any failure encountered while
+         * processing/propagating a Co-TDMA (MAPC) related message on the agent side
+         * (Discovery Report processing, Sharing/Shared AP Configuration apply, QMID/E2E
+         * config apply, or Negotiation Status report to controller).
+         *
+         * event_obj: const sCotdmaFailureEvent *
+         */
+        COTDMA_FAILURE,
+    };
+
+    /**
+     * @brief Payload for eEvent::COTDMA_FAILURE.
+     *
+     * `stage` differentiates the failing step for the Debug Agent/cloud consumer, e.g.:
+     *   "COTDMA_PEER_EXCHANGES"    - MAPC Discovery Report processing (agent -> controller report)
+     *   "COTDMA_CONFIG_APPLY"      - Sharing/Shared AP Configuration apply (set_mapc_sta)
+     *   "COTDMA_QMID_CONFIG"       - DL SCS MSDU forwarding / E2E QMID configuration apply
+     *   "COTDMA_NEGOTIATION_REPORT"- Negotiation Status report-to-controller failure
+     */
+    struct sCotdmaFailureEvent {
+        sMacAddr local_bssid;
+        sMacAddr peer_bssid;
+        std::string stage;
+        std::string reason;
+    };
 
     bool handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
                      const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
