+void CoordinatedTdmaTask::notify_cotdma_failure(const sMacAddr &local_bssid,
+                                                const sMacAddr &peer_bssid,
+                                                const std::string &stage,
+                                                const std::string &reason)
+{
+    HealthMonitoringTask::sCotdmaFailureEvent event;
+    event.local_bssid = local_bssid;
+    event.peer_bssid  = peer_bssid;
+    event.stage       = stage;
+    event.reason      = reason;
+
+    m_btl_ctx.task_pool_try_send_event(
+        eTaskType::HEALTH_MONITORING, static_cast<uint8_t>(HealthMonitoringTask::eEvent::COTDMA_FAILURE),
+        &event);
+}
