+void HealthMonitoringTask::handle_cotdma_peer_setup(const sMacAddr &sharing_bssid,
+                                                    const sMacAddr &shared_bssid)
+{
+    const bool was_empty = m_pending_cotdma_negotiations.empty();
+
+    m_pending_cotdma_negotiations[sharing_bssid].insert(shared_bssid);
+    LOG(DEBUG) << "HEALTH_MONITORING: COTDMA_PEER_SETUP tracking sharing_bssid=" << sharing_bssid
+               << " shared_bssid=" << shared_bssid << " (pending sharing bssids="
+               << m_pending_cotdma_negotiations.size() << ")";
+
+    if (was_empty) {
+        // First tracked Co-TDMA negotiation pair, system-wide, just became pending --
+        // notify the Debug Agent to enable Co-TDMA related logging on all nodes in the mesh.
+        LOG(DEBUG) << "HEALTH_MONITORING: first Co-TDMA negotiation pending, notifying Debug "
+                      "Agent to start Co-TDMA logging";
+        const std::string detected_by = tlvf::mac_to_string(m_database.get_local_bridge_mac());
+        m_database.dm_trigger_cotdma_logging_start_event(generate_incident_id(), detected_by);
+    }
+}
+
+void HealthMonitoringTask::handle_cotdma_negotiation_resolved(const sMacAddr &sharing_bssid,
+                                                              const sMacAddr &shared_bssid)
+{
+    auto it = m_pending_cotdma_negotiations.find(sharing_bssid);
+    if (it != m_pending_cotdma_negotiations.end()) {
+        it->second.erase(shared_bssid);
+        if (it->second.empty()) {
+            m_pending_cotdma_negotiations.erase(it);
+        }
+    }
+
+    LOG(DEBUG) << "HEALTH_MONITORING: COTDMA_NEGOTIATION_RESOLVED sharing_bssid=" << sharing_bssid
+               << " shared_bssid=" << shared_bssid << " (pending sharing bssids="
+               << m_pending_cotdma_negotiations.size() << ")";
+
+    if (m_pending_cotdma_negotiations.empty()) {
+        LOG(DEBUG) << "HEALTH_MONITORING: all Co-TDMA negotiations resolved, notifying Debug "
+                      "Agent to stop Co-TDMA logging";
+        const std::string detected_by = tlvf::mac_to_string(m_database.get_local_bridge_mac());
+        m_database.dm_trigger_cotdma_logging_stop_event(generate_incident_id(), detected_by);
+    }
+}
+
+void HealthMonitoringTask::handle_cotdma_failure(const sMacAddr &sharing_bssid,
+                                                 const sMacAddr &shared_bssid,
+                                                 const std::string &stage,
+                                                 const std::string &reason)
+{
+    auto incident_id = generate_incident_id();
+    const std::string detected_by = tlvf::mac_to_string(m_database.get_local_bridge_mac());
+
+    LOG(DEBUG) << "HEALTH_MONITORING: firing CotdmaFailure event, sharing_bssid=" << sharing_bssid
+               << " shared_bssid=" << shared_bssid << " stage=" << stage << " reason=" << reason
+               << " incident_id=" << incident_id;
+
+    m_database.dm_trigger_cotdma_failure_event(incident_id, detected_by, sharing_bssid,
+                                               shared_bssid, stage, reason);
+}
