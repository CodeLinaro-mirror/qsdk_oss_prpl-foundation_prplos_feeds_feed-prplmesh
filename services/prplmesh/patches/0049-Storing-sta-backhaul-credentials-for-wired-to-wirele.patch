+bool sta_wlan_hal_nl80211::add_new_network(son::wireless_utils::sBssInfoConf bSta_conf)
+{
+    std::string sta_iface = get_iface_name();
+
+    LOG(INFO) << "Add a new network for interface: " << sta_iface;
+    // Add a new network
+    auto network_id = add_network();
+    if (network_id < 0) {
+        LOG(ERROR) << "Failed (" << network_id
+                   << ") adding new network to interface: " << sta_iface;
+        return false;
+    }
+    // Set SSID
+    if (!set_network(network_id, "ssid", "\"" + bSta_conf.ssid + "\"")) {
+        LOG(ERROR) << "Failed setting ssid on interface " << sta_iface;
+        return false;
+    }
+
+    // Security and Password
+    std::string key_mgmt = "";
+    std::string psk = "";
+    std::string group = "CCMP";
+    std::string pairwise = "CCMP";
+
+    if (bSta_conf.authentication_type == WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
+        key_mgmt = "WPA-PSK";
+        psk = "psk";
+    } else if (bSta_conf.authentication_type == WSC::eWscAuth::WSC_AUTH_SAE) {
+        key_mgmt = "SAE";
+        psk = "sae_password";
+        if (!set_network(network_id, "ieee80211w", "2")) {
+            LOG(ERROR) << "Failed setting ieee80211w on interface " << sta_iface;
+            return false;
+        }
+        if (!set_network(network_id, "sae_pwe", "1")) {
+            LOG(ERROR) << "Failed setting sae_pwe on interface " << sta_iface;
+            return false;
+        }
+    } else if (bSta_conf.authentication_type == WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK|WSC::eWscAuth::WSC_AUTH_SAE)) {
+        key_mgmt = "WPA-PSK SAE";
+        psk = "sae_password";
+        if (!set_network(network_id, "ieee80211w", "2")) {
+            LOG(ERROR) << "Failed setting ieee80211w on interface " << sta_iface;
+            return false;
+        }
+        if (!set_network(network_id, "sae_pwe", "1")) {
+            LOG(ERROR) << "Failed setting sae_pwe on interface " << sta_iface;
+            return false;
+        }
+    } else {
+        LOG(ERROR) << " Unsupported auth type: " << bSta_conf.authentication_type;
+        return false;
+    }
+
+    if (!set_network(network_id, "key_mgmt", key_mgmt)) {
+        LOG(ERROR) << "Failed setting key_mgmt on interface " << sta_iface;
+        return false;
+    }
+
+    if ((!bSta_conf.network_key.empty()) && (!set_network(network_id, "psk", "\"" + bSta_conf.network_key + "\""))) {
+        LOG(ERROR) << "Failed setting psk on interface " << sta_iface;
+        return false;
+    }
+
+    if (!set_network(network_id, "pairwise",pairwise)) {
+        LOG(ERROR) << "Failed setting pairwise on interface " << sta_iface;
+        return false;
+    }
+    if (!set_network(network_id, "group",group)) {
+        LOG(ERROR) << "Failed setting group on interface " << sta_iface;
+        return false;
+    }
+
+    if (!set_network(network_id, "multi_ap_backhaul_sta","1")) {
+        LOG(ERROR) << "Failed setting multi_ap_backhaul_sta on interface " << sta_iface;
+        return false;
+    }
+
+
+    // Enable the network
+    if (!enable_network(network_id)) {
+        LOG(ERROR) << "Failed enabling network id = " << network_id
+                   << " on interface: " << sta_iface;
+        return false;
+    }
+
+    // select the network
+    const std::string cmd = "SELECT_NETWORK " + std::to_string(network_id);
+    if (!wpa_ctrl_send_msg(cmd)) {
+        LOG(ERROR) << "WPA command '" << cmd << "' failed";
+        return false;
+    }
+
+
+    LOG(DEBUG) << "Network with id " << network_id << " has been added and enabled on interface "
+               << sta_iface;
+
+    beerocks::bpl::bpl_cfg_set_sta_vap_bh_credentials(sta_iface,bSta_conf);
+
+    return true;
+}
