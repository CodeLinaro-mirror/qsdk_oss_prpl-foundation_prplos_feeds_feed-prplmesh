     }
 }
 
-bool BackhaulManager::resolve_gateway_ip(std::string &gw_ip)
+bool BackhaulManager::resolve_gateway_ip(const std::string &iface, std::string &gw_ip)
 {
     // Use BPL function to get gateway IP
     // For PrplOS: retrieves from Device.DHCPv4.Client.*.DHCPServer
     // For OpenWrt: uses ip route command
-    if (!beerocks::bpl::cfg_get_dhcp_gateway_ip(gw_ip)) {
+    if (!beerocks::bpl::cfg_get_dhcp_gateway_ip(iface, gw_ip)) {
         LOG(WARNING) << "Could not resolve gateway IP";
         return false;
     }
@@ -5443,9 +5443,12 @@ bool BackhaulManager::is_gateway_reachable_via_interface(const std::string &ifac
         return true;
     }
 
-    // Resolve gateway IP
+    // Resolve gateway IP. The DHCP-installed default route lives on the bridge
+    // device (e.g. br-lan), not on the individual enslaved port - a bridge member
+    // port such as eth0 never carries its own default route, so the lookup must
+    // be scoped to the bridge, not to the physical port passed in as `iface`.
     std::string gw_ip;
-    if (!resolve_gateway_ip(gw_ip)) {
+    if (!resolve_gateway_ip(bridge_iface, gw_ip)) {
         LOG(WARNING) << "Could not resolve gateway IP, treating " << iface
                      << " as not gateway reachable (non-certification mode)";
         return false;
