      * @param[out] gw_ip The resolved gateway IP address.
      * @return true if gateway IP was resolved successfully, false otherwise.
      */
-    bool resolve_gateway_ip(std::string &gw_ip);
+    bool resolve_gateway_ip(const std::string &iface, std::string &gw_ip);
 
     /**
      * @brief Confirms gateway reachability using ARP ping (arping).
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
index 117dc004b..04bcb4e81 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
@@ -731,8 +731,13 @@ bool cfg_set_wifi_iface_multi_ap_vlanid(const std::string &iface_name, uint16_t
     return true;
 }
 
-bool cfg_get_dhcp_gateway_ip(std::string &gw_ip)
+bool cfg_get_dhcp_gateway_ip(const std::string &iface, std::string &gw_ip)
 {
+    if (iface.empty()) {
+        MAPF_ERR("cfg_get_dhcp_gateway_ip: interface name is empty");
+        return false;
+    }
+
     // Resolve all Device.DHCPv4.Client.* instance paths
     std::vector<std::string> client_paths;
     if (!m_ambiorix_cl_ubus.resolve_path_multi("Device.DHCPv4.Client.*", client_paths)) {
@@ -745,10 +750,29 @@ bool cfg_get_dhcp_gateway_ip(std::string &gw_ip)
         return false;
     }
 
-    // Iterate through all DHCPv4.Client instances to find enabled one with gateway IP
+    // Iterate through all DHCPv4.Client instances to find the one bound to the
+    // requested interface, enabled, and with a resolved gateway IP. Filtering by
+    // Interface prevents an unrelated interface's DHCP lease (e.g. a guest network)
+    // from being mistaken for the WAN gateway.
     for (const auto &client_path : client_paths) {
         MAPF_DBG("cfg_get_dhcp_gateway_ip: Checking client path: " << client_path);
 
+        std::string client_iface;
+        if (!m_ambiorix_cl_ubus.get_param(client_iface, client_path, "Interface")) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Failed to read Interface for " << client_path);
+            continue;
+        }
+
+        // Exact match required: a substring check here (e.g. client_iface.find(iface))
+        // would false-positive when iface is a suffix of an unrelated interface name,
+        // such as requested iface "lan" matching client_iface "wlan0".
+        if (client_iface != iface) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Client "
+                      << client_path << " Interface " << client_iface
+                      << " does not match requested iface " << iface);
+            continue;
+        }
+
         // Check if Enable parameter is true
         bool enabled = false;
         if (!m_ambiorix_cl_ubus.get_param(enabled, client_path, "Enable")) {
