+namespace {
+
+/**
+ * Resolve the persistent UCI network for a VAP without making an
+ * unclassified VAP fall back to the primary network when an existing
+ * assignment is already available.
+ *
+ * The order is intentional:
+ *   1. effective_bridge, when traffic-separation/AP-manager already resolved it
+ *   2. explicit guest VAP classification
+ *   3. existing UCI assignment for an unclassified VAP
+ *   4. private network for known non-guest/backhaul VAPs
+ */
+static bool resolve_wifi_network(const std::string &section_name,
+                                 const son::wireless_utils::sBssInfoConf &configuration,
+                                 std::string &network_name)
+{
+    const auto network_from_bridge = [&](const std::string &bridge_name) {
+        return !bridge_name.empty() &&
+               cfg_get_network_name_for_bridge(bridge_name, network_name);
+    };
+
+    if (network_from_bridge(configuration.effective_bridge)) {
+        return true;
+    }
+
+    if (!configuration.backhaul && configuration.vap_type == eVapType::GUEST) {
+        std::string guest_bridge;
+        if (cfg_get_guest_bridge_iface(guest_bridge) &&
+            network_from_bridge(guest_bridge)) {
+            return true;
+        }
+
+        LOG(WARNING) << "Unable to resolve guest network for wireless section "
+                     << section_name;
+        return false;
+    }
+
+    // During initial configuration the traffic-separation database may not yet
+    // contain ssid_vlan_mapping. Preserve an existing assignment in that case.
+    if (configuration.vap_type == eVapType::OTHER) {
+        std::string existing_network;
+        if (uci_get_option("wireless", "wifi-iface", section_name, "network",
+                           existing_network) &&
+            !existing_network.empty()) {
+            network_name = existing_network;
+            return true;
+        }
+    }
+
+    std::string private_bridge;
+    if (cfg_get_private_bridge_iface(private_bridge) &&
+        network_from_bridge(private_bridge)) {
+        return true;
+    }
+
+    LOG(WARNING) << "Unable to resolve private network for wireless section "
+                 << section_name;
+    return false;
+}
+
+static void add_resolved_network_option(
+    const std::string &section_name,
+    const son::wireless_utils::sBssInfoConf &configuration,
+    OptionsUnorderedMap &options)
+{
+    std::string network_name;
+    if (resolve_wifi_network(section_name, configuration, network_name)) {
+        options["network"] = network_name;
+    } else {
+        // Do not overwrite an existing network with a guessed value.
+        options.erase("network");
+    }
+}
