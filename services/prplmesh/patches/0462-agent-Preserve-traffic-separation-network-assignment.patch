+/**
+ * @brief Determine whether a BSS configuration belongs to the guest bridge.
+ *
+ * Backhaul BSSes always use the private bridge. For an untyped BSS, use the
+ * traffic-separation SSID-to-secondary-VLAN mapping as a fallback.
+ */
+inline bool is_guest_bss(const son::wireless_utils::sBssInfoConf &bss,
+                         const AgentDB::sTrafficSeparation &ts_db)
+{
+    if (bss.backhaul) {
+        return false;
+    }
+
+    if (bss.vap_type == eVapType::GUEST) {
+        return true;
+    }
+
+    if (bss.vap_type == eVapType::OTHER && !bss.ssid.empty()) {
+        const auto it = ts_db.ssid_vid_mapping.find(bss.ssid);
+        return it != ts_db.ssid_vid_mapping.end() &&
+               ts_db.secondary_vlans_ids.count(it->second) != 0;
+    }
+
+    return false;
+}
+
 } // namespace beerocks
 
