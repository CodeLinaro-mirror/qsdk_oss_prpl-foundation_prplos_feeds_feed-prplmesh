-std::string get_ifname_wrt_mld_grp(int mld_id, std::string cur_ifname) {
+int modify_mld_grp(int mld_id, std::string new_ifname, std::string new_ssid) {
+    std::string filename = MLD_PAIR_ENTRANT_FILE;
+
+    int fd = open(filename.c_str(), O_RDWR | O_CREAT, 0666);
+    if (fd == -1) {
+        perror("open");
+        return -1;
+    }
+
+    struct flock lock = { F_WRLCK, SEEK_SET, 0, 0, 0 };
+    if (fcntl(fd, F_SETLKW, &lock) == -1) {
+        perror("fcntl - lock");
+        close(fd);
+        return -1;
+    }
+
+    std::ifstream infile(filename);
+    std::vector<std::string> lines;
+    std::string line;
+    bool modified = false;
+
+    while (std::getline(infile, line)) {
+        std::istringstream iss(line);
+        std::string id_str, ifname_str, ssid_str;
+
+        if (std::getline(iss, id_str, ',') &&
+            std::getline(iss, ifname_str, ',') &&
+            std::getline(iss, ssid_str)) {
+            
+            if (std::stoi(id_str) == mld_id) {
+                lines.push_back(std::to_string(mld_id) + "," + new_ifname + "," + new_ssid);
+                modified = true;
+                continue;
+            }
+            
+        }
+        lines.push_back(line);
+    }
+    infile.close();
+
+    std::ofstream outfile(filename, std::ios::trunc);
+    for (const auto& l : lines) {
+        outfile << l << "\n";
+    }
+    outfile.close();
+
+    lock.l_type = F_UNLCK;
+    fcntl(fd, F_SETLK, &lock);
+    close(fd);
+
+    return modified ? 0 : -1;
+}
+
+
+std::string get_ifname_wrt_mld_grp(int mld_id, std::string cur_ifname,std::string ssid) {
        std::string mld_grp_primary_ifname;
-       fetch_mld_id_pair(mld_id, mld_grp_primary_ifname);
+       std::string mld_grp_ssid;
+       fetch_mld_id_pair(mld_id, mld_grp_primary_ifname,mld_grp_ssid);
        if (mld_grp_primary_ifname.empty()) {
-               update_mld_grp_primary_ifname(mld_id, cur_ifname);
+               update_mld_grp_primary_ifname(mld_id, cur_ifname,ssid);
                return cur_ifname;
        } else {
-               return mld_grp_primary_ifname;
+               // First check SSID match for MLO link pair
+               if (ssid == mld_grp_ssid) {
+                   return mld_grp_primary_ifname;
+               } else {
+                   modify_mld_grp(mld_id, cur_ifname,ssid);
+                   return cur_ifname;
+               }
        }
 
 }
