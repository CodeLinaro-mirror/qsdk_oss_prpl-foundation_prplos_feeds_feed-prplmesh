From 459ec9579521352af22fdd4ef88392b643059af0 Mon Sep 17 00:00:00 2001
From: Dhivya <dsankar@qti.qualcomm.com>
Date: Mon, 2 Mar 2026 11:10:36 +0530
Subject: [PATCH] bpl_cfg: update controller timeout defaults for better
 stability

Adjusted the default timeout values used during controller discovery and
message handling. This improves responsiveness and ensures credentials
propagate correctly across chained RE nodes.

Signed-off-by: Dhivya <dsankar@qti.qualcomm.com>
---
 framework/platform/bpl/include/bpl/bpl_cfg.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/framework/platform/bpl/include/bpl/bpl_cfg.h b/framework/platform/bpl/include/bpl/bpl_cfg.h
index ffb7cae..e8f13bc 100644
--- a/framework/platform/bpl/include/bpl/bpl_cfg.h
+++ b/framework/platform/bpl/include/bpl/bpl_cfg.h
@@ -196,9 +196,9 @@ constexpr bool DEFAULT_CHECK_CONNECTIVITY_TO_CONTROLLER_ENABLE = true;
 // Default value in enabling checking indirect controller connectivity
 constexpr bool DEFAULT_CHECK_INDIRECT_CONNECTIVITY_TO_CONTROLLER_ENABLE = true;
 // Default value for controller discovery timeout in controller connectivity task
-constexpr std::chrono::seconds DEFAULT_CONTROLLER_DISCOVERY_TIMEOUT_SEC{120};
+constexpr std::chrono::seconds DEFAULT_CONTROLLER_DISCOVERY_TIMEOUT_SEC{30};
 // Default value for controller message timeout in controller connectivity task
-constexpr std::chrono::seconds DEFAULT_CONTROLLER_MESSAGE_TIMEOUT_SEC{70};
+constexpr std::chrono::seconds DEFAULT_CONTROLLER_MESSAGE_TIMEOUT_SEC{30};
 // Default value for heartbeat state timeout in controller connectivity task
 constexpr std::chrono::seconds DEFAULT_CONTROLLER_HEARTBEAT_STATE_TIMEOUT_SEC{30};
 
-- 
2.34.1

