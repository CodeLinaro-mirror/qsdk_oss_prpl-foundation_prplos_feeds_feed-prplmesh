From 6a80ac4f322cb1ce9809d9bc0fa16e0356a07d1d Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Mon, 9 Mar 2026 01:37:51 +0530
Subject: [PATCH] Toggle m_backhaul_switch either on successful reconnection or
 network addition Store BSTA credentials at the time of config receive state
 itself rather than while applying to have config persistency at unfavoured
 situations of process or system restart

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     |  85 ++++++++++--
 .../platform/bpl/cfg/dm/bpl_cfg_wifi.cpp      |  65 ++++++++++
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 121 +++++++++++++++---
 3 files changed, 244 insertions(+), 27 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index eb03ec726..da36740bd 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1059,14 +1059,35 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
                                 if (radio_info->added_network_status) {
                                     radio_info->sta_wlan_hal->reconnect_backhaul_sta();
                                 } else {
-                                    // Add network credentials if not already added
-                                    if (radio_info->sta_wlan_hal->add_new_network(radio_info->bSta_conf)) {
-                                        LOG(DEBUG) << "ADD NETWORK completed for " << radio_info->sta_iface;
-                                        radio_info->added_network_status = true;
-                                        radio_info->sta_wlan_hal->reconnect_backhaul_sta();
-                                    } else {
-                                        LOG(ERROR) << "Failed to add network for " << radio_info->sta_iface;
-                                    }
+                        // Check if bSta_conf has valid credentials, if not retrieve from UCI config
+                        if (radio_info->bSta_conf.ssid.empty() || radio_info->bSta_conf.network_key.empty()) {
+                            LOG(INFO) << "bSta_conf credentials are invalid for " << radio_info->sta_iface 
+                                     << ", retrieving from UCI config";
+                            
+                            son::wireless_utils::sBssInfoConf retrieved_config;
+                            if (beerocks::bpl::bpl_cfg_get_wifi_credentials(radio_info->sta_iface, retrieved_config)) {
+                                radio_info->bSta_conf.ssid = retrieved_config.ssid;
+                                radio_info->bSta_conf.authentication_type = retrieved_config.authentication_type;
+                                radio_info->bSta_conf.encryption_type = retrieved_config.encryption_type;
+                                radio_info->bSta_conf.network_key = retrieved_config.network_key;
+                                
+                                LOG(DEBUG) << "Retrieved credentials from UCI for " << radio_info->sta_iface
+                                          << " - SSID: " << radio_info->bSta_conf.ssid
+                                          << ", auth: " << radio_info->bSta_conf.authentication_type
+                                          << ", encr: " << radio_info->bSta_conf.encryption_type;
+                            } else {
+                                LOG(ERROR) << "Failed to retrieve credentials from UCI config for " << radio_info->sta_iface;
+                            }
+                        }
+                        
+                        // Add network credentials if not already added
+                        if (radio_info->sta_wlan_hal->add_new_network(radio_info->bSta_conf)) {
+                            LOG(DEBUG) << "ADD NETWORK completed for " << radio_info->sta_iface;
+                            radio_info->added_network_status = true;
+                            radio_info->sta_wlan_hal->reconnect_backhaul_sta();
+                        } else {
+                            LOG(ERROR) << "Failed to add network for " << radio_info->sta_iface;
+                        }
                                 }
                             }
                         }
@@ -1389,22 +1410,52 @@ bool BackhaulManager::backhaul_fsm_wireless(bool &skip_select)
             for (auto &radio_info : m_radios_info) {
                 std::string iface = radio_info->sta_iface;
                 if (radio_info->sta_iface.empty()) {
+                    LOG(DEBUG) << " Skipping radio as sta_iface is empty";
                     continue;
                 }
                 // reconnect backhaul sta if backhaul switching is happened already  
                 if (m_backhaul_switch || radio_info->sta_wlan_hal->is_disconnected()) {
                     // already wireless connection established
                     if (radio_info->added_network_status) {
-                        radio_info->sta_wlan_hal->reconnect_backhaul_sta();
+                        LOG(DEBUG) << "Trying to reconnect";
+                        if (radio_info->sta_wlan_hal->reconnect_backhaul_sta()) {
+                            m_backhaul_switch = false;
+                        } else {
+                            LOG(DEBUG) << "Failed to reconnect";
+                        }
                     } else {
                         // wired to wireless switching - add bh credentials
+                        // Check if bSta_conf has valid credentials, if not retrieve from UCI config
+                        if (radio_info->bSta_conf.ssid.empty() || radio_info->bSta_conf.network_key.empty()) {
+                            LOG(INFO) << "bSta_conf credentials are invalid for " << radio_info->sta_iface 
+                                     << ", retrieving from UCI config";
+                            
+                            son::wireless_utils::sBssInfoConf retrieved_config;
+                            if (beerocks::bpl::bpl_cfg_get_wifi_credentials(radio_info->sta_iface, retrieved_config)) {
+                                radio_info->bSta_conf.ssid = retrieved_config.ssid;
+                                radio_info->bSta_conf.authentication_type = retrieved_config.authentication_type;
+                                radio_info->bSta_conf.encryption_type = retrieved_config.encryption_type;
+                                radio_info->bSta_conf.network_key = retrieved_config.network_key;
+                                
+                                LOG(DEBUG) << "Retrieved credentials from UCI for " << radio_info->sta_iface
+                                          << " - SSID: " << radio_info->bSta_conf.ssid
+                                          << ", auth: " << radio_info->bSta_conf.authentication_type
+                                          << ", encr: " << radio_info->bSta_conf.encryption_type;
+                            } else {
+                                LOG(ERROR) << "Failed to retrieve credentials from UCI config for " << radio_info->sta_iface;
+                            }
+                        }
+                        
                         // Todo: radio_info->sta_wlan_hal->remove_current_networks();
+                        LOG(DEBUG) << "Trying to add network";
                         if ( radio_info->sta_wlan_hal->add_new_network(radio_info->bSta_conf)) {
                             LOG(DEBUG) << " ADD NETWORK Completed ";
                             radio_info->added_network_status = true;
+                            m_backhaul_switch = false;
+                        } else {
+                            LOG(DEBUG) << "Failed to add network";
                         }
                     }
-                    m_backhaul_switch = false;
                 } else if (!roam_flag && radio_info->sta_wlan_hal->is_connected()) {
                     for (const auto &sta_iface : slave_sta_ifaces) {
                         auto sta_iface_hal = get_wireless_hal(sta_iface);
@@ -2086,6 +2137,20 @@ bool BackhaulManager::handle_slave_backhaul_message(int fd, ieee1905_1::CmduMess
                         LOG(DEBUG) << "BACKHUAL_MANAGER: Received For radio: " << radio_mac << " BSTA Cred: SSID-" << radio_info->bSta_conf.ssid
                                    << " auth:" << radio_info->bSta_conf.authentication_type
                                    << " encr:" << radio_info->bSta_conf.encryption_type;
+
+/* Only needed to save BSTA vap creds earlier for NLHAL variant as this is a fix to hold BSTA credentials earlier 
+ * whenever received before the backhaul FSM actually sets this to platform, because at some instances, 
+ * ie., SLO to MLO grouping of primary vaps or vaps used to manage fronthaul manager launch, 
+ * agent process ends up in restart thereby loosing  all received BSTA credentials during onboarding.
+ */
+#ifdef USE_PRPLMESH_NLHAL
+                        // Write credentials to /etc/config/wireless for persistency
+                        if (!beerocks::bpl::bpl_cfg_set_sta_vap_bh_credentials(radio_info->sta_iface, radio_info->bSta_conf)) {
+                            LOG(WARNING) << "Failed to write backhaul credentials to wireless config for " << radio_info->sta_iface;
+                        } else {
+                            LOG(DEBUG) << "Successfully wrote backhaul credentials to wireless config for " << radio_info->sta_iface;
+                        }
+#endif                        
                     }
                 }
             }
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
index b31daab3d..c6b6dbc9e 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
@@ -381,5 +381,70 @@ bool bpl_cfg_get_hostapd_ctrl_path(const std::string &iface, std::string &hostap
     return true;
 }
 
+/* Enable this API only if needed 
+ * Right now adding this abstract to have similar implementation as NL HAL
+ * But this is needed to be called from backhaul manager only if credentials are to be saved earlier
+ * Because required to call this from backhaul manager because agent process got restarted in certain scenerios,
+ * leading to received credentials loss, So there arise the need to save bsta credentials earlier in NLHAL variant.
+ */
+/*
+bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
+                                        const son::wireless_utils::sBssInfoConf &configuration)
+{
+    // For DM/WHM implementation, update the WiFi data model with backhaul credentials
+    std::string wifi_ssid_path = wbapi_utils::search_path_ssid_by_iface(iface);
+    AmbiorixVariant new_obj(AMXC_VAR_ID_HTABLE);
