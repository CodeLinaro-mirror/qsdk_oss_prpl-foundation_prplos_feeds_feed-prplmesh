 } // namespace bpl
 } // namespace beerocks
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index ca2b2403b..ebe03df21 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -897,23 +897,18 @@ bool bpl_cfg_get_monitored_BSSs_by_radio_iface(const std::string &iface,
 bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
                                         const son::wireless_utils::sBssInfoConf &configuration)
 {
-    // Find the "wireless.wifi-iface" section in UCI configuration for the given interface
+    // Find all "wireless.wifi-iface" sections in UCI configuration
     const std::string package_name = "wireless";
     const std::string section_type = "wifi-iface";
-    const std::string option_name  = "ifname";
-    std::string section_name;
-    if (!uci_find_section_by_option(package_name, section_type, option_name, iface, section_name)) {
-	LOG(ERROR) << "Failed to find configuration section for interface " << iface;
-        return false;
-    }
-    if (section_name.empty()) {
-	LOG(ERROR) << "section_name is empty for interface " << iface;
+    
+    // Get all wifi-iface sections
+    std::vector<std::string> all_sections;
+    if (!uci_get_all_sections(package_name, section_type, all_sections)) {
+        LOG(ERROR) << "Failed to get all wifi-iface sections";
         return false;
     }
-    // Overwrite UCI configuration with wireless credentials for the given interface
-    OptionsUnorderedMap options;
-    options["ssid"] = configuration.ssid;
     
+    // Lambda to get encryption string
     auto get_encryption = [](WSC::eWscAuth authentication_type, WSC::eWscEncr encryption_type) {
             std::string encryption = "none";
             if (authentication_type == WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
@@ -930,6 +925,10 @@ bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
             }
             return encryption;
     };
+    
+    // Prepare options to write
+    OptionsUnorderedMap options;
+    options["ssid"] = configuration.ssid;
     options["encryption"] = get_encryption(configuration.authentication_type, configuration.encryption_type);
 
     // Set sae_pwe if encryption is SAE
@@ -941,13 +940,101 @@ bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
                 options["sae_pwe"] = "2";
     }
     options["key"] = configuration.network_key;
-    // Write UCI options in the "wireless.wifi-iface" section for the given interface.
-    if (!uci_set_section(package_name, section_type, section_name, options, true)) {
-        LOG(ERROR) << "Failed to set wireless configuration for interface " << iface << " at section " << section_name;
+    
+    // Track if we updated at least one section
+    bool updated_any = false;
+    int sections_updated = 0;
+    
+    // Iterate through all sections and update those that match our criteria
+    for (const auto &section_name : all_sections) {
+        std::string mode_value;
+        std::string ifname_value;
+        
+        // Get mode option
+        if (!uci_get_option(package_name, section_type, section_name, "mode", mode_value)) {
+            LOG(DEBUG) << "Failed to get 'mode' from section " << section_name;
+            continue;
+        }
+        
+        // Get ifname option
+        if (!uci_get_option(package_name, section_type, section_name, "ifname", ifname_value)) {
+            LOG(DEBUG) << "Failed to get 'ifname' from section " << section_name;
+            continue;
+        }
+        
+        // Check if this section matches our criteria: mode=sta and ifname matches
+        if (mode_value == "sta" && ifname_value == iface) {
+            // Write UCI options in this matching section
+            if (!uci_set_section(package_name, section_type, section_name, options, true)) {
+                LOG(ERROR) << "Failed to set wireless configuration for interface " << iface 
+                          << " at section " << section_name;
+                continue;
+            }
+            
+            LOG(DEBUG) << "Successfully updated bh credentials for sta interface " << iface 
+                      << " (ifname=" << ifname_value << ") at section " << section_name;
+            updated_any = true;
+            sections_updated++;
+        }
+    }
+    
+    if (!updated_any) {
+        LOG(WARNING) << "No matching wifi-iface sections found for interface " << iface 
+                    << " with mode=sta";
         return false;
     }
-
-    LOG(DEBUG) << "Successfully added the bh  credentials for sta interface " << iface << " at section " << section_name;
+    
+    LOG(INFO) << "Successfully updated " << sections_updated 
+              << " wifi-iface section(s) with bh credentials for sta interface " << iface;
+    
+    // Now update wifi-mld sections that match the ifname
+    const std::string mld_section_type = "wifi-mld";
+    std::vector<std::string> all_mld_sections;
+    if (!uci_get_all_sections(package_name, mld_section_type, all_mld_sections)) {
+        LOG(DEBUG) << "Failed to get all wifi-mld sections or no wifi-mld sections exist";
+        // Not a critical error, wifi-mld sections may not exist
+        return true;
+    }
+    
+    // Prepare options for wifi-mld (no encryption field in mld section)
+    OptionsUnorderedMap mld_options;
+    mld_options["ssid"] = configuration.ssid;
+    mld_options["key"] = configuration.network_key;
+    
+    int mld_sections_updated = 0;
+    
+    // Iterate through all mld sections and update those that match the ifname
+    for (const auto &mld_section_name : all_mld_sections) {
+        std::string mld_ifname_value;
+        
+        // Get ifname option
+        if (!uci_get_option(package_name, mld_section_type, mld_section_name, "ifname", mld_ifname_value)) {
+            LOG(DEBUG) << "Failed to get 'ifname' from mld section " << mld_section_name;
+            continue;
+        }
+        
+        // Check if this mld section matches our ifname
+        if (mld_ifname_value == iface) {
+            // Write UCI options in this matching mld section
+            if (!uci_set_section(package_name, mld_section_type, mld_section_name, mld_options, true)) {
+                LOG(ERROR) << "Failed to set wireless configuration for interface " << iface 
+                          << " at mld section " << mld_section_name;
+                continue;
+            }
+            
+            LOG(DEBUG) << "Successfully updated bh credentials for mld section " << mld_section_name
+                      << " (ifname=" << mld_ifname_value << ")";
+            mld_sections_updated++;
+        }
+    }
+    
+    if (mld_sections_updated > 0) {
+        LOG(INFO) << "Successfully updated " << mld_sections_updated 
+                  << " wifi-mld section(s) with bh credentials for interface " << iface;
+    } else {
+        LOG(DEBUG) << "No matching wifi-mld sections found for interface " << iface;
+    }
+    
     return true;
 }
 #endif
