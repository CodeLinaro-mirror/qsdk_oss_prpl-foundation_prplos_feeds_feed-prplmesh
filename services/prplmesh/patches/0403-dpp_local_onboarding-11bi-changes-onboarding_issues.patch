+            trigger_bss_config_request(controller_mac);
+            m_bss_config_request_sent = true;
+        }
+        return;
+    }
+
+    if (db->peer_1905_security.count(controller_mac)) {
+        return; // Peer Discovery already completed with the Controller
+    }
+
+    LOG(INFO) << "DPP: 1905 credentials ready — initiating Peer Discovery over 1905 Direct Encap";
+    initiate_peer_discovery(controller_mac);
+}
