+
+    std::string value;
+    json_object *field_obj = nullptr;
+    if (json_object_object_get_ex(root, field_name.c_str(), &field_obj)) {
+        const char *str = json_object_get_string(field_obj);
+        if (str) {
+            value = str;
+        }
+    }
+    json_object_put(root);
+    return value;
+}
