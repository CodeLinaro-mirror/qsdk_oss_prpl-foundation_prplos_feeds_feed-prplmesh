+void BackhaulManager::reset_1905_security_for_connection_switch(bool switching_to_wired)
+{
+    auto db = AgentDB::get();
+    if (db->dpp_extender_config.onboarding_type != AgentDB::OnboardingType::DPP) {
+        return;
+    }
+
+    auto controller_mac = db->controller_info.bridge_mac;
+    if (controller_mac != beerocks::net::network_utils::ZERO_MAC) {
+        db->peer_1905_security.erase(controller_mac);
+        if (m_broker_client) {
+            m_broker_client->install_security_key(controller_mac, {}, {}, 0, false);
+        }
+    }
+
+    if (switching_to_wired) {
+        // Clear the one-way latch so the wired chirp-inclusion gate (dpp_onboarding_active)
+        // can re-arm for this medium. sDpp1905Credentials owns a raw EVP_PKEY* and is
+        // non-copyable, so fields are reset individually rather than via `= {}`.
+        if (db->dpp_1905_credentials.nak_pkey) {
+            EVP_PKEY_free(db->dpp_1905_credentials.nak_pkey);
+            db->dpp_1905_credentials.nak_pkey = nullptr;
+        }
+        db->dpp_1905_credentials.connector.clear();
+        db->dpp_1905_credentials.nak_private_der.clear();
+        db->dpp_1905_credentials.c_sign_key_der.clear();
+        db->dpp_1905_credentials.c_sign_key_jwk.clear();
+        db->dpp_1905_credentials.pp_key_jwk.clear();
+        db->dpp_1905_credentials.initialized = false;
+    }
+
+    LOG(INFO) << "DPP: connection type switched to " << (switching_to_wired ? "Wired" : "Wireless")
+              << " — cleared stale 1905 security state";
+
+    if (m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+        auto notify = message_com::create_vs_message<
+            beerocks_message::cACTION_BACKHAUL_CONNECTION_TYPE_CHANGED_NOTIFICATION>(cmdu_tx);
+        if (notify) {
+            send_cmdu(m_agent_fd, cmdu_tx);
+        } else {
+            LOG(ERROR) << "Failed building cACTION_BACKHAUL_CONNECTION_TYPE_CHANGED_NOTIFICATION";
+        }
+    }
+}
