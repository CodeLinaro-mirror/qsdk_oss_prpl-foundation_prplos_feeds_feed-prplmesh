+// Public: on_1905_credentials_ready — called from ApAutoConfigurationTask the moment
+// it parses an AP-Autoconfig Response and finds 1905 credentials already available
+// (wireless bSTA DPP via wpa_supplicant events, or restored across reboot). Decides,
+// from the just-parsed 0xA9 TLV presence, whether to skip straight to BSS Config
+// Request or kick off 1905 Peer Discovery.
+// ---------------------------------------------------------------------------
+
+void DppAgentTask::on_1905_credentials_ready(const sMacAddr &controller_mac,
+                                              bool controller_requires_1905_security)
+{
+    auto db = AgentDB::get();
+
+    if (!controller_requires_1905_security) {
+        // Mirrors the live-exchange shortcut at the bottom of handle_dpp_wired_gas_response()
+        // below: no 0xA9 TLV means the 1905 layer doesn't need Peer Discovery+EAPOL, so go
+        // straight to BSS Config Request.
