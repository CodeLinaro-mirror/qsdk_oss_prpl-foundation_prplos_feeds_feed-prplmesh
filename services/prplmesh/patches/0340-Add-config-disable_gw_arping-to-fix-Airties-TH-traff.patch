From 5a4f48496b83a04cf109a6caa49909e207205de9 Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Fri, 14 Aug 2026 15:44:38 +0530
Subject: [PATCH] Add config disable_gw_arping to fix Airties TH traffic stats
 issue

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 agent/config/beerocks_agent.conf.in                          | 1 +
 agent/src/beerocks/slave/agent_db.h                          | 2 ++
 .../src/beerocks/slave/backhaul_manager/backhaul_manager.cpp | 5 +++++
 agent/src/beerocks/slave/beerocks_agent_main.cpp             | 2 ++
 common/beerocks/bcl/include/bcl/beerocks_config_file.h       | 1 +
 common/beerocks/bcl/source/beerocks_config_file.cpp          | 1 +
 6 files changed, 12 insertions(+)

diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index 4d9aeb0a2..7a92c6583 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -13,6 +13,7 @@ vendor=Intel
 model=prplMesh
 ucc_listener_port=8002 # 0 - disabled
 enable_arp_monitor=0
+disable_gw_arping=0 # 0 - arping enabled (default), 1 - skip arping gateway reachability check (rely on link status only)
 bridge_iface=@BEEROCKS_BRIDGE_IFACE@
 enable_system_hang_test=0 # 0 - disabled
 monitor_polling_rate_msec=@BEEROCKS_MONITOR_POLLING_RATE_MSEC@
diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index fc66e608a..9c94a12d4 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -188,6 +188,8 @@ public:
         uint8_t ap_maximum_links     = 0;
         uint8_t bsta_maximum_links   = 0;
         bool enable_auto_chansel_handling;
+        // When set, is_gateway_reachable_via_interface() skips the arping call.
+        bool disable_gw_arping = false;
         // Active ACS channel selection. Effective only when enable_auto_chansel_handling
         // is also true. When set, build_acs_list() blocks (all radio channels - preferred) and
         // nl80211 start_platform_acs() drives the driver ACS: acs clear_block_chan_list +
diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index be2a79096..f7ab3d216 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -4698,6 +4698,11 @@ bool BackhaulManager::is_gateway_reachable_via_interface(const std::string &ifac
     // Store the resolved gateway IP in the member variable
     m_gateway_ip = gw_ip;
 
+    if (db->device_conf.disable_gw_arping) {
+        LOG(DEBUG) << "disable_gw_arping is set, skipping arping check on " << iface;
+        return true;
+    }
+
     // Use arping for determining gateway reachability on both platforms
     return arping_confirm_gateway(iface, bridge_iface, gw_ip);
 }
diff --git a/agent/src/beerocks/slave/beerocks_agent_main.cpp b/agent/src/beerocks/slave/beerocks_agent_main.cpp
index d2b79b1bc..b8ca9c273 100644
--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -605,6 +605,8 @@ static int run_beerocks_slave(beerocks::config_file::sConfigSlave &beerocks_slav
                           "used (PREFERRED_DWELLTIME_MS)";
         }
 
+        db->device_conf.disable_gw_arping = beerocks_slave_conf.disable_gw_arping == "1";
+
         db->device_conf.enable_auto_chansel_handling =
             beerocks_slave_conf.enable_auto_chansel_handling == "1";
         // Active ACS channel selection. Only effective when enable_auto_chansel_handling
diff --git a/common/beerocks/bcl/include/bcl/beerocks_config_file.h b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
index f0c65eb12..090c39982 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_config_file.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
@@ -109,6 +109,7 @@ public:
         std::string model;
         std::string ucc_listener_port;
         std::string enable_arp_monitor;
+        std::string disable_gw_arping;
         std::string bridge_iface;
         std::string backhaul_preferred_bssid;
         std::string enable_system_hang_test;
diff --git a/common/beerocks/bcl/source/beerocks_config_file.cpp b/common/beerocks/bcl/source/beerocks_config_file.cpp
index 712d6eda9..7ac01fb5c 100644
--- a/common/beerocks/bcl/source/beerocks_config_file.cpp
+++ b/common/beerocks/bcl/source/beerocks_config_file.cpp
@@ -173,6 +173,7 @@ bool config_file::read_slave_config_file(const std::string &config_file_path, sC
             std::make_tuple("model=", &conf.model, mandatory_slave),
             std::make_tuple("ucc_listener_port=", &conf.ucc_listener_port, mandatory_slave),
             std::make_tuple("enable_arp_monitor=", &conf.enable_arp_monitor, mandatory_slave),
+            std::make_tuple("disable_gw_arping=", &conf.disable_gw_arping, 0),
             std::make_tuple("bridge_iface=", &conf.bridge_iface, 0),
             std::make_tuple("enable_system_hang_test=", &conf.enable_system_hang_test, 0),
             std::make_tuple("monitor_polling_rate_msec=", &conf.monitor_polling_rate_msec, 0),
-- 
2.34.1

