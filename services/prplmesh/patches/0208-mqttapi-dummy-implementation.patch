+ */
+
+#pragma once
+
+#include "mqtt_client.h"
+#include <mosquitto.h>
+#include <atomic>
+#include <easylogging++.h>
+
+namespace beerocks {
+namespace mqttapi {
+
+class MQTTClientImpl : public MQTTClient {
+public:
+    MQTTClientImpl();
+    ~MQTTClientImpl() override;
+
+    int init(const std::string& id, const std::string& host, int port, MessageCallback callback) override;
+    int get_fd() const override;
+    void process() override;
+    void cleanup() override;
+    void ping() override;
+    int publish(const std::string& topic, const void* payload, int payload_len, int qos, bool retain) override;
+    int subscribe(const std::string& topic, int qos) override;
+    void unsubscribe(const std::string& topic) override;
+
+private:
+    static void on_connect_static(struct mosquitto* mosq, void* obj, int rc);
+    static void on_message_static(struct mosquitto* mosq, void* obj, const struct mosquitto_message* msg);
+
+    void on_connect(int rc);
+    void on_message(const struct mosquitto_message* msg);
+
+    struct mosquitto* mosq;
+    int mqtt_fd;
+    MessageCallback mqtt_callback;
+};
