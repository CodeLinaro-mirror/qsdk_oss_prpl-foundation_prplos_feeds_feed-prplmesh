+ */
+
+#include "mqtt_client_dummy.h"
+
+namespace beerocks {
+namespace mqttapi {
+
+MQTTClientDummy::MQTTClientDummy() : mqtt_fd(-1), mqtt_callback(nullptr)
+{
+}
+
+MQTTClientDummy::~MQTTClientDummy()
+{
+    cleanup();
+}
+
+int MQTTClientDummy::init(const std::string& id, const std::string& host, int port, MessageCallback callback)
+{
+    mqtt_callback = callback;
+    mqtt_fd = -1; // Invalid file descriptor for dummy implementation
+    return mqtt_fd;
+}
+
+int MQTTClientDummy::get_fd() const
+{
+    return mqtt_fd;
+}
+
+void MQTTClientDummy::process()
+{
+    // No-op in dummy implementation
+}
+
+void MQTTClientDummy::cleanup()
+{
+    mqtt_fd = -1;
+}
+
+void MQTTClientDummy::ping()
+{
+    // No-op in dummy implementation
+}
+
+int MQTTClientDummy::publish(const std::string& topic, const void* payload, int payload_len, int qos, bool retain)
+{
+    return 0; // Success
+}
+
+int MQTTClientDummy::subscribe(const std::string& topic, int qos)
+{
+    return 0; // Success
+}
+
+void MQTTClientDummy::unsubscribe(const std::string& topic)
+{
+    // No-op in dummy implementation
+}
+
+std::unique_ptr<MQTTClient> mqtt_client_create()
+{
+    return std::make_unique<MQTTClientDummy>();
+}
+
+} // namespace mqttapi
+} // namespace beerocks
