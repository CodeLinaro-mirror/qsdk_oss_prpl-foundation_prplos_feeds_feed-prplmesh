From 5685703dc881fb72ab2278902f0673f285bcc181 Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Tue, 21 Jul 2026 12:14:34 +0530
Subject: [PATCH] Fix for wired to wireless BH switching failure

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../beerocks/slave/backhaul_manager/backhaul_manager.cpp   | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 31590c015..7a1db0ece 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -838,7 +838,8 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
             beerocks::net::network_utils::linux_get_iface_list_from_bridge(db->bridge.iface_name);
 
         std::string selected_eth_iface;
-        if(select_gateway_reachable_eth_interface(selected_eth_iface)) {
+        bool eth_gateway_reachable = select_gateway_reachable_eth_interface(selected_eth_iface);
+        if(eth_gateway_reachable) {
             db->ethernet.wan.iface_name = selected_eth_iface;
             LOG(DEBUG) << "Dynamically selected ETH interface " << db->ethernet.wan.iface_name << " for WIRED Backhaul";
         } else {
@@ -855,7 +856,9 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
                 LOG(WARNING) << "wan_mon.initialize() failed, skip wired link establishment";
             }
         }
-        if ((wired_link_state == wan_monitor::ELinkState::eUp) &&
+
+        // Only use wired backhaul if interface is UP AND gateway is reachable
+        if ((wired_link_state == wan_monitor::ELinkState::eUp) && eth_gateway_reachable &&
             (m_selected_backhaul.empty() || m_selected_backhaul == DEV_SET_ETH)) {
 
             auto it = std::find(ifaces.begin(), ifaces.end(), db->ethernet.wan.iface_name);
-- 
