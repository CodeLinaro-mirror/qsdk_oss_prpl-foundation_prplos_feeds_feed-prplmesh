+bool Monitor::schedule_channel_scan_trigger_retry()
+{
+    constexpr auto trigger_scan_retry_delay = std::chrono::milliseconds(300);
+
+    if (!mon_wlan_hal || !mon_wlan_hal->is_channel_scan_retry_pending()) {
+        return true;
+    }
+    if (m_channel_scan_trigger_retry_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "Channel scan retry timer is already armed";
+        return false;
+    }
+
+    m_channel_scan_trigger_retry_timer = m_timer_manager->add_timer(
+        "Channel Scan Trigger Retry", trigger_scan_retry_delay, std::chrono::milliseconds::zero(),
+        [this](int fd, beerocks::EventLoop &loop) {
+            m_timer_manager->remove_timer(fd);
+            m_channel_scan_trigger_retry_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+
+            if (!mon_wlan_hal || !mon_wlan_hal->is_channel_scan_retry_pending()) {
+                return true;
+            }
+
+            mon_wlan_hal->retry_pending_channel_scan_trigger();
+            if (mon_wlan_hal->is_channel_scan_retry_pending() &&
+                !schedule_channel_scan_trigger_retry()) {
+                LOG(ERROR) << "Failed to schedule channel scan retry";
+                mon_wlan_hal->channel_scan_abort();
+            }
+            return true;
+        });
+
+    if (m_channel_scan_trigger_retry_timer == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "Failed to create channel scan retry timer";
+        return false;
+    }
+    return true;
+}
+
+void Monitor::cancel_channel_scan_trigger_retry()
+{
+    if (m_channel_scan_trigger_retry_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        m_timer_manager->remove_timer(m_channel_scan_trigger_retry_timer);
+        m_channel_scan_trigger_retry_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+}
