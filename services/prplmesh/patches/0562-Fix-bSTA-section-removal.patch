From 3a67141b00255273c0e6ce113b312ff34cf8b583 Mon Sep 17 00:00:00 2001
From: Muthuchamy Kumar <muthucha@qti.qualcomm.com>
Date: Wed, 21 Oct 2026 16:37:47 +0530
Subject: [PATCH] Fix bSTA section removal

Signed-off-by: Muthuchamy Kumar <muthucha@qti.qualcomm.com>
---
 .../bwl/nl80211/base_wlan_hal_nl80211.cpp     |  9 ++-
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 78 ++++++++-----------
 2 files changed, 42 insertions(+), 45 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
index 23b62d7aa..516f90c1d 100644
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -801,8 +801,15 @@ bool base_wlan_hal_nl80211::wpa_ctrl_send_msg(const std::string &cmd,
 
     auto buffer = m_wpa_ctrl_buffer.get();
 
-    const bool request_ok =
+    bool request_ok =
         wpa_ctrl_cmd->request(cmd, buffer, m_wpa_ctrl_buffer_size, retry_max, timed_out);
+    const bool retry_safe = cmd.rfind("GET_", 0) == 0 || cmd == "STATUS" || cmd == "PING";
+    if (!request_ok && retry_safe && reconnect_wpa_ctrl_cmd_socket(iface_name)) {
+        auto retry_wpa_ctrl_cmd = m_wpa_ctrl_client.get_socket_cmd(iface_name);
+        request_ok = retry_wpa_ctrl_cmd &&
+                     retry_wpa_ctrl_cmd->request(cmd, buffer, m_wpa_ctrl_buffer_size, retry_max,
+                                                 timed_out);
+    }
     if (!request_ok) {
         LOG(ERROR) << "can't send wpa_ctrl_request";
         LOG(ERROR) << "failed cmd: " << cmd;
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 642fde842..554c573c5 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -3466,8 +3466,10 @@ eBstaSupplicantRestartStatus bpl_cfg_update_bsta_mld_grp(const std::string &radi
     // (mode=sta, multi_ap=BSS_TYPE_BACKHAUL, band matches radio_band).
     const std::string matched_section = find_bsta_iface_section(all_sections, radio_band);
 
-    // If mld_unit == -1, remove the bSTA section (or just its mld option when it is the
-    // only section referencing mld0).
+    // If mld_unit == -1, disable the bSTA MLD association but preserve the bSTA
+    // wifi-iface section.  The section contains the credentials and interface
+    // definition used by wpa_supplicant; deleting it leaves a runtime wlan STA
+    // without a corresponding wireless configuration entry.
     if (mld_unit == -1) {
         if (matched_section.empty()) {
             LOG(DEBUG) << "bpl_cfg_update_bsta_mld_grp: mld_unit=-1, no matching wifi-iface "
@@ -3475,15 +3477,15 @@ eBstaSupplicantRestartStatus bpl_cfg_update_bsta_mld_grp(const std::string &radi
             return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
         }
 
-        // If this section has mld="mld0", check whether it is the only such section.
-        // If it is the only one, delete the wifi-mld section and remove the mld option
-        // from the wifi-iface section instead of deleting the section itself.
+        // Remove only the MLD metadata.  Keep the wifi-iface section even when it
+        // has no mld option (the common non-MLO bSTA case).
         std::string current_mld_value;
         uci_get_option(package_name, section_type, matched_section, "mld", current_mld_value);
 
         if (current_mld_value == "mld0") {
-            // Count other wifi-iface sections with mld="mld0" AND mode="sta"
-            int mld0_sta_count = 0;
+            // Keep a shared wifi-mld section until all STA members have been
+            // detached from it.
+            bool other_mld0_sta_exists = false;
             for (const auto &other_sec : all_sections) {
                 if (other_sec == matched_section) {
                     continue;
@@ -3493,51 +3495,39 @@ eBstaSupplicantRestartStatus bpl_cfg_update_bsta_mld_grp(const std::string &radi
                     other_mode == "sta" &&
                     uci_get_option(package_name, section_type, other_sec, "mld", other_mld) &&
                     other_mld == "mld0") {
-                    mld0_sta_count++;
+                    other_mld0_sta_exists = true;
+                    break;
                 }
             }
 
-            if (mld0_sta_count == 0) {
-                LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: mld_unit=-1, section "
-                          << matched_section
-                          << " is the only wifi-iface with mld=mld0 and mode=sta; "
-                          << "removing wifi-mld section mld0 and mld option from wifi-iface";
-
-                if (uci_section_exists(package_name, mld_sect_type, "mld0")) {
-                    if (!uci_delete_section(package_name, mld_sect_type, "mld0", true)) {
-                        LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to delete "
-                                   << "wifi-mld section mld0";
-                        return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
-                    }
-                    LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: deleted wifi-mld section mld0";
-                }
-
-                // Remove the "mld" option by setting it to "" (uci_set_section removes it)
-                OptionsUnorderedMap remove_mld_opts;
-                remove_mld_opts["mld"] = "";
-                if (!uci_set_section(package_name, section_type, matched_section,
-                                     remove_mld_opts, true)) {
-                    LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to remove mld option "
-                               << "from section " << matched_section;
+            if (!other_mld0_sta_exists &&
+                uci_section_exists(package_name, mld_sect_type, "mld0")) {
+                if (!uci_delete_section(package_name, mld_sect_type, "mld0", true)) {
+                    LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to delete "
+                               << "wifi-mld section mld0";
                     return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
                 }
-                LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: removed mld option from "
-                          << "wifi-iface section " << matched_section;
-                return eBstaSupplicantRestartStatus::SUPP_RST_REQUIRED;
+                LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: deleted wifi-mld section mld0";
             }
-        }
 
-        // Delete the matching section (either it has no mld="mld0", or other sections
-        // with mld="mld0" and mode="sta" will remain after deletion).
-        LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: mld_unit=-1, deleting wifi-iface section "
-                  << matched_section << " for radio_band=" << radio_band;
-        if (!uci_delete_section(package_name, section_type, matched_section, true)) {
-            LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to delete section "
-                       << matched_section;
-            return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
+            // Remove the "mld" option by setting it to "" (uci_set_section removes it).
+            OptionsUnorderedMap remove_mld_opts;
+            remove_mld_opts["mld"] = "";
+            if (!uci_set_section(package_name, section_type, matched_section,
+                                 remove_mld_opts, true)) {
+                LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to remove mld option "
+                           << "from section " << matched_section;
+                return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
+            }
+            LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: removed mld option from "
+                      << "preserved wifi-iface section " << matched_section;
+            return eBstaSupplicantRestartStatus::SUPP_RST_REQUIRED;
         }
-        
-        return eBstaSupplicantRestartStatus::SUPP_RST_REQUIRED;
+
+        LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: mld_unit=-1, preserving bSTA wifi-iface "
+                  << matched_section << " for radio_band=" << radio_band
+                  << " (no MLD option present)";
+        return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
     }
 
     // bSTA MLD unit must be 0 for normal operation
-- 
2.34.1

