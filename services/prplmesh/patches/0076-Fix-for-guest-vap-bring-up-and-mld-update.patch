From c35a8d415bbba0a71183ef8eff574a3d5f415d86 Mon Sep 17 00:00:00 2001
From: Hemanth Krishna Srirama <hsrirama@qti.qualcomm.com>
Date: Wed, 11 Feb 2026 23:00:38 +0530
Subject: [PATCH 06/11] Fix for guest vap bring up and mldunit update

Signed-off-by: Hemanth Krishna Srirama <hsrirama@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 684a0b46e..55f01cdab 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -664,9 +664,28 @@ bool ap_wlan_hal_whm::update_vap_credentials(
                    << " authentication_type: " << bss_info_conf.authentication_type
                    << " mld_unit: " << mld_unit;
 
+        // Skip update if no changes for FronthaulBSS/BackhaulBSS
+        std::string current_ssid, current_password, current_mode;
+        int8_t current_mldID = -1;
+        bool params_retrieved = true;
+        params_retrieved &= m_ambiorix_cl.get_param(current_ssid, wifi_ssid_path, "SSID");
+        params_retrieved &= m_ambiorix_cl.get_param(current_password, wifi_vap_path + "Security.", "KeyPassPhrase");
+        params_retrieved &= m_ambiorix_cl.get_param(current_mode, wifi_vap_path + "Security.", "ModeEnabled");
+        params_retrieved &= m_ambiorix_cl.get_param(current_mldID, wifi_ssid_path, "MLDUnit");
+        if (params_retrieved &&
+            current_ssid == bss_info_conf.ssid && current_password == bss_info_conf.network_key &&
+            current_mode ==
+                wbapi_utils::security_mode_to_string(bss_info_conf.authentication_type) &&
+                current_mldID == mld_unit) {
+            LOG(DEBUG) << "No changes detected for " << ifname
+                       << ". Skipping update for VAP: " << wifi_vap_path;
+             continue; // Skip updating this VAP
+        }
+
         new_obj.set_type(AMXC_VAR_ID_HTABLE);
         new_obj.add_child("SSID", bss_info_conf.ssid);
         new_obj.add_child("MLDUnit", mld_unit);
+        new_obj.add_child("Enable", 1);
 
         ret = m_ambiorix_cl.update_object(wifi_ssid_path, new_obj);
 
-- 
