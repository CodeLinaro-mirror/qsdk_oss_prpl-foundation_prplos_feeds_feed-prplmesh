 common/beerocks/bwl/whm/base_wlan_hal_whm.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
index 5bd59448e6..553304103c 100755
--- a/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
@@ -911,6 +911,7 @@ bool base_wlan_hal_whm::refresh_vaps_info(int id)
             LOG(ERROR) << "can't find vap_id " << id;
         }
     } else {
+        // Copy to safely iterate while allowing modifications in the original map
         auto saved_vaps_copy = saved_vaps;
         for (const auto &vap : saved_vaps_copy) {
