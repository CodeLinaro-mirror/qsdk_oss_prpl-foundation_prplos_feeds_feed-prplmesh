+bool bpl_cfg_get_mld_ifname_by_ssid(const std::string &ssid, std::string &ifname)
+{
+    const std::string package_name     = "wireless";
+    const std::string mld_section_type = "wifi-mld";
+
+    // Get all wifi-mld sections
+    std::vector<std::string> all_mld_sections;
+    if (!uci_get_all_sections(package_name, mld_section_type, all_mld_sections)) {
+        LOG(DEBUG) << "bpl_cfg_get_mld_ifname_by_ssid: no wifi-mld sections found";
+        return false;
+    }
+
+    for (const auto &mld_sec : all_mld_sections) {
+        // Check if the ssid option of this section matches the target SSID
+        std::string ssid_val;
+        if (!uci_get_option(package_name, mld_section_type, mld_sec, "ssid", ssid_val)) {
+            continue;
+        }
+
+        if (ssid_val != ssid) {
+            continue;
+        }
+
+        // SSID matched - get the ifname option
+        std::string ifname_val;
+        if (!uci_get_option(package_name, mld_section_type, mld_sec, "ifname", ifname_val) ||
+            ifname_val.empty()) {
+            LOG(DEBUG) << "bpl_cfg_get_mld_ifname_by_ssid: wifi-mld section=" << mld_sec
+                       << " matched ssid=" << ssid << " but has no ifname";
+            continue;
+        }
+
+        // Check whether this ifname belongs to a "sta" or "ap" interface by looking
+        // at the wifi-iface section. If mode is "sta", skip this wifi-mld section.
+        {
+            const std::string iface_section_type = "wifi-iface";
+            std::vector<std::string> all_iface_sections;
+            if (uci_get_all_sections(package_name, iface_section_type, all_iface_sections)) {
+                bool is_sta = false;
+                for (const auto &iface_sec : all_iface_sections) {
+                    std::string iface_ifname_val;
+                    if (!uci_get_option(package_name, iface_section_type, iface_sec, "ifname",
+                                        iface_ifname_val)) {
+                        continue;
+                    }
+                    if (iface_ifname_val != ifname_val) {
+                        continue;
+                    }
+                    // Found the wifi-iface section for this ifname - check its mode
+                    std::string mode_val;
+                    if (uci_get_option(package_name, iface_section_type, iface_sec, "mode",
+                                       mode_val) &&
+                        mode_val == "sta") {
+                        LOG(DEBUG) << "bpl_cfg_get_mld_ifname_by_ssid: wifi-mld section="
+                                   << mld_sec << " ifname=" << ifname_val
+                                   << " belongs to a sta interface, skipping";
+                        is_sta = true;
+                    }
+                    break;
+                }
+                if (is_sta) {
+                    continue;
+                }
+            }
+        }
+
+        ifname = ifname_val;
+        LOG(INFO) << "bpl_cfg_get_mld_ifname_by_ssid: ssid=" << ssid
+                  << " found in wifi-mld section=" << mld_sec
+                  << " -> ifname=" << ifname;
+        return true;
+    }
+
+    LOG(DEBUG) << "bpl_cfg_get_mld_ifname_by_ssid: no wifi-mld section found for ssid=" << ssid;
+    return false;
+}
