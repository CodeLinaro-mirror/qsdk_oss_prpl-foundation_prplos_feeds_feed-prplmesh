+                   cur_ifname = mld_ifname_from_uci;
+               }
+               update_mld_grp_primary_ifname(mld_id, cur_ifname, ssid);
+               result = cur_ifname;
        } else {
                // First check SSID match for MLO link pair
                if (ssid == mld_grp_ssid) {
-                   return mld_grp_primary_ifname;
+                   result = mld_grp_primary_ifname;
                } else {
-                   modify_mld_grp(mld_id, cur_ifname,ssid);
-                   return cur_ifname;
+                   modify_mld_grp(mld_id, cur_ifname, ssid);
+                   result = cur_ifname;
                }
        }
 
+       // Release the lock
+       if (lock_fd >= 0) {
+               lk.l_type = F_UNLCK;
