+std::string get_ifname_wrt_mld_grp(int mld_id, std::string cur_ifname, std::string ssid) {
+       // Acquire an exclusive lock on a dedicated lock file so that the
+       // read-check-write sequence (fetch → update/modify) is atomic with
+       // respect to concurrent callers from other radio processes.
+       int lock_fd = open("/var/lock/prplmesh-mld-grp.lock", O_CREAT | O_RDWR, 0644);
+       if (lock_fd < 0) {
+               LOG(ERROR) << "get_ifname_wrt_mld_grp: open lock failed: " << strerror(errno);
+       }
+
+       struct flock lk{};
+       lk.l_type   = F_WRLCK;
+       lk.l_whence = SEEK_SET;
+       lk.l_start  = 0;
+       lk.l_len    = 0;
+
+       if (lock_fd >= 0 && fcntl(lock_fd, F_SETLKW, &lk) < 0) {
+               LOG(ERROR) << "get_ifname_wrt_mld_grp: fcntl(F_SETLKW) failed: " << strerror(errno);
+               close(lock_fd);
+               lock_fd = -1;
+       }
+
        std::string mld_grp_primary_ifname;
        std::string mld_grp_ssid;
