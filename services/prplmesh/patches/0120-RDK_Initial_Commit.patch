+# SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+# SPDX-FileCopyrightText: 2022 the prplMesh contributors (see AUTHORS.md)
+#
+# This code is subject to the terms of the BSD+Patent license.
+# See LICENSE file for more details.
+
+# Set the library name
+set(ONEWIFI_LIBRARY_NAME "bwl_onewifi")
+
+# Create a list of the source files
+set(ONEWIFI_SOURCES
+    "base_wlan_hal_onewifi.cpp"
+    "ap_wlan_hal_onewifi.cpp"
+    "sta_wlan_hal_onewifi.cpp"
+    "mon_wlan_hal_onewifi.cpp"
+    "nl80211_client_factory_onewifi.cpp"
+)
+
+# Create a list of the header files
+set(ONEWIFI_HEADERS
+    "base_wlan_hal_onewifi.h"
+    "ap_wlan_hal_onewifi.h"
+    "sta_wlan_hal_onewifi.h"
+)
+
+# Create the library
+add_library(${ONEWIFI_LIBRARY_NAME} ${ONEWIFI_SOURCES} ${ONEWIFI_HEADERS})
+
+# Link libraries
+target_link_libraries(${ONEWIFI_LIBRARY_NAME}
+    PRIVATE
+        bpl
+        rbus # Placeholder, should be found by pkg-config
+)
+
+# Set the include path
+target_include_directories(${ONEWIFI_LIBRARY_NAME}
+    PUBLIC
+        "${CMAKE_CURRENT_SOURCE_DIR}/../include"
+        "${CMAKE_SOURCE_DIR}/framework/tlvf/AutoGenerated"
+        "${CMAKE_SOURCE_DIR}/framework/tlvf/AutoGenerated/include"
+        "${CMAKE_SOURCE_DIR}/framework/platform/bpl/include"
+        "${CMAKE_SOURCE_DIR}/framework/tlvf/src/include"
+        "${CMAKE_SOURCE_DIR}/common/beerocks/bcl/include"
+        "${CMAKE_SOURCE_DIR}/framework/external/easylogging"
+        "${ONEWIFI_SRC_DIR}/include"
+        "${ONEWIFI_SRC_DIR}/source/utils"
+    PRIVATE
+        "${CMAKE_CURRENT_SOURCE_DIR}"
+)
