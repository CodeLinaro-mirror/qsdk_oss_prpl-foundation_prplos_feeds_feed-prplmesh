From: ameya <phadke@qti.qualcomm.com>
Date: Thu, 16 Apr 2026 15:41:47 -0700
Subject: [PATCH 1/1] Qca Neighbor Information TLV yaml

Signed-off-by: ameya <phadke@qti.qualcomm.com>
---
 framework/tlvf/tlvf_conf.yaml                 |  1 +
 framework/tlvf/yaml/tlvf/qca/eQcaTLVId.yaml   |  1 +
 .../tlvf/qca/tlvQcaNeighborInformation.yaml   | 53 +++++++++++++++++++
 3 files changed, 55 insertions(+)
 create mode 100644 framework/tlvf/yaml/tlvf/qca/tlvQcaNeighborInformation.yaml

diff --git a/framework/tlvf/tlvf_conf.yaml b/framework/tlvf/tlvf_conf.yaml
index e8f79055a..61a3caa44 100644
--- a/framework/tlvf/tlvf_conf.yaml
+++ b/framework/tlvf/tlvf_conf.yaml
@@ -168,6 +168,7 @@ include_yaml_path: {
     "tlvf/qca/tlvQcaVersionInfo.yaml",
     "tlvf/qca/tlvQcaSmdCapabilities.yaml",
     "tlvf/qca/tlvQcaSmdPolicyConfig.yaml",
+    "tlvf/qca/tlvQcaNeighborInformation.yaml",
 }
 
 # Relative to tlvf.py src_path variable
diff --git a/framework/tlvf/yaml/tlvf/qca/eQcaTLVId.yaml b/framework/tlvf/yaml/tlvf/qca/eQcaTLVId.yaml
index 69e978652..ddc283d1d 100644
--- a/framework/tlvf/yaml/tlvf/qca/eQcaTLVId.yaml
+++ b/framework/tlvf/yaml/tlvf/qca/eQcaTLVId.yaml
@@ -8,3 +8,4 @@ eQcaTlVId:
   QCA_VERSION_INFO: 0x0001
   QCA_SMD_CAPABILITIES: 0x0002
   QCA_SMD_POLICY_CONFIG: 0x0003
+  QCA_NEIGHBOR_INFORMATION: 0x0004
diff --git a/framework/tlvf/yaml/tlvf/qca/tlvQcaNeighborInformation.yaml b/framework/tlvf/yaml/tlvf/qca/tlvQcaNeighborInformation.yaml
new file mode 100644
index 000000000..2b51710fc
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/qca/tlvQcaNeighborInformation.yaml
@@ -0,0 +1,53 @@
+#
+---
+
+_namespace: qca
+_include:
+  {
+    tlvf/ieee_1905_1/sVendorOUI.h,
+    tlvf/qca/eQcaTlvTypeMap.h,
+  }
+
+# Vendor Specific Neighbor Information TLV
+# Based on Wi-Fi EasyMesh Specification 6.1, Section 17.2.111, Table 134
+# Spec-defined TLV Type: 0xA4 (Neighbor Information TLV)
+# Sent as vendor-specific TLV (0x0B) for pre-spec implementation
+#
+# Wire format (tlvValue):
+#   - vendor_oui                         : 3 octets  - Qualcomm OUI
+#   - tlv_id                             : 2 octets  - QCA_NEIGHBOR_INFORMATION sub-type
+#   - num_neighbor_reports               : 1 octet   - Number of Neighbor Reports in this TLV
+#   - [repeated num_neighbor_reports times]:
+#       - neighbor_report_element_length : 2 octets  - Length of Neighbor Report Element in octets
+#       - neighbor_report_element        : variable  - Neighbor Report Element of the BSS
+
+tlvQcaNeighborInformation:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eQcaTlvTypeMap
+    _value_const: TLV_VENDOR_SPECIFIC
+  length: uint16_t
+  vendor_oui:
+    _type: sVendorOUI
+  tlv_id:
+    _type: uint16_t
+  num_neighbor_reports:
+    _type: uint8_t
+    _length_var: True
+    _comment: "Number of Neighbor Reports in this TLV"
+  neighbor_report_list:
+    _type: cQcaNeighborReport
+    _length: [ num_neighbor_reports ]
+    _comment: "Neighbor Report entries, repeated num_neighbor_reports times"
+
+cQcaNeighborReport:
+  _type: class
+  neighbor_report_element_length:
+    _type: uint16_t
+    _comment: "Length of the Neighbor Report Element in octets"
+  neighbor_report_element:
+    _type: uint8_t
+    _length: [ neighbor_report_element_length ]
+    _length_max: 512
+    _comment: "Neighbor Report Element of the BSS (see 9.4.2.35 of [1])"
-- 
