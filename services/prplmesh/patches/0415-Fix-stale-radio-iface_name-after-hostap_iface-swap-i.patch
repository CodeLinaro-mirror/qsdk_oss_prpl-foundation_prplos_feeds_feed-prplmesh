From 25fbcc8f8a34ebd6fe2ccb14aa678eaa502e8838 Mon Sep 17 00:00:00 2001
From: Aryan Khare <aryakhar@qti.qualcomm.com>
Date: Thu, 10 Sep 2026 08:36:06 +0530
Subject: [PATCH] Fix stale radio iface_name after hostap_iface swap in
 update_vap_credentials

update_vap_credentials() persists a new hostap_iface (e.g. wlan3->wlan2_1)
and deletes the superseded VAP, but never updated m_radio_info.iface_name
to match. Every subsequent unqualified wpa_ctrl_send_msg()/attach() call
kept targeting the deleted interface, causing repeated "No such device"
failures and an ap_manager crash-restart loop on that radio (CR 4529802).

Call update_default_iface_name() before the old VAP is removed, mirroring
the existing pattern used earlier in the same function.

Signed-off-by: Aryan Khare <aryakhar@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 5208a8d7a..f4a5db6fb 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -5754,6 +5754,11 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
     if (new_radio_iface_name_update_req != 0 && !new_radio_iface_name.empty() && (prpl_config_update != true)) {
 	    // Extract the suffix from the original iface name
 
+	    // Update our own working interface reference to the new VAP before persisting
+	    // and deleting the old one below, otherwise subsequent HAL calls keep targeting
+	    // the interface being removed.
+	    update_default_iface_name(new_radio_iface_name);
+
 	    //update prplmesh config file for persistance
 	    const std::string package_name = "prplmesh";
 	    const std::string section_type = "wifi-device";
-- 
