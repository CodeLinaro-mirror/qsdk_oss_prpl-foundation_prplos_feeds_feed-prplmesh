From 1db0a6d1fbc1fb7de2a5834f41c98d0badce791c Mon Sep 17 00:00:00 2001
From: Sandeep Tomer <stomer@qti.qualcomm.com>
Date: Tue, 13 Oct 2026 09:42:09 +0530
Subject: [PATCH] prplMesh: fix preset CMDU parse state

Keep a finalized preset CMDU in TX state when clearing its unicast relay flag. Calling load() switches the message to parse mode, preventing TX finalization and leaving multi-byte header fields in host byte order.

Signed-off-by: Sandeep Tomer <stomer@qti.qualcomm.com>
---
 common/beerocks/bcl/source/beerocks_ucc_listener.cpp | 17 ++++-------------
 1 file changed, 4 insertions(+), 13 deletions(-)

diff --git a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
index 8cc45a1..1f848f0 100644
--- a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
+++ b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
@@ -671,19 +671,10 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
         if (tlv_hex_list.empty() && m_cmdu_tx.is_finalized() &&
             m_cmdu_tx.getMessageType() == ieee1905_1::eMessageType(message_type)) {
             m_cmdu_tx.setMessageId(g_mid); // force mid
-            // For unicast, clear relay_indicator on the already-finalized CMDU header
-            // Loading a finalized CMDU puts it in parse mode. Only do that when the
-            // command explicitly requests unicast transmission; otherwise the
-            // finalized TX CMDU must remain in TX mode for serialization.
-            auto transmission_type_it = params.find("transmissiontype");
-            if (transmission_type_it != params.end()) {
-                auto transmission_type = transmission_type_it->second;
-                std::transform(transmission_type.begin(), transmission_type.end(),
-                               transmission_type.begin(), ::tolower);
-                if (transmission_type == "unicast") {
-                    apply_unicast_relay_flag(m_cmdu_tx.load());
-                }
-            }
+            // Keep the preset CMDU in TX/finalized state. load() resets the class list in parse
+            // mode, which prevents TX finalization and leaves multi-byte header fields in host
+            // byte order. The existing header can be modified directly without changing state.
+            apply_unicast_relay_flag(m_cmdu_tx.getCmduHeader());
             LOG(DEBUG) << "Send preset cmdu with mid " << std::hex << g_mid;
             if (!send_cmdu_to_destination(m_cmdu_tx, dest_alid)) {
                 LOG(ERROR) << "Failed to send CMDU";
-- 
