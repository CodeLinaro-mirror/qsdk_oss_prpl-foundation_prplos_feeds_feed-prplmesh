+
+#ifndef __QCA_VS_MSG_UTILS_H__
+#define __QCA_VS_MSG_UTILS_H__
+
+/**
+ * @file qca_vs_msg_utils.h
+ * @brief C-compatible header for QCA vendor-specific message utilities.
+ *
+ * Exposes selected qca::tlvf_qca_utils methods via C linkage wrappers so they
+ * can be called from C code and reused across threads and processes without
+ * C++ name-mangling issues.
+ *
+ * C++ callers should prefer the typed API directly:
+ *   qca::tlvf_qca_utils::is_qca_vs_msg(cmdu_rx)
+ *   qca::tlvf_qca_utils::add_qca_version_info_tlv(cmdu_tx)
+ *   qca::tlvf_qca_utils::add_qca_msg_type_tlv(cmdu_tx, msg_type)
+ *
+ * C callers or callers crossing ABI boundaries should use the wrappers below.
+ */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* -------------------------------------------------------------------------
+ * RX-side utilities
+ * ---------------------------------------------------------------------- */
+
+/**
+ * @brief Check if a received VENDOR_SPECIFIC_MESSAGE is a QCA vendor message.
+ *
+ * A QCA vendor message is identified by the presence of a tlvQcaMsgType TLV
+ * in the CMDU. This is a non-destructive check: it does not consume any TLV
+ * buffer bytes.
+ *
+ * Wraps qca::tlvf_qca_utils::is_qca_vs_msg() with C linkage.
+ *
+ * @param[in] cmdu_rx  Opaque pointer to ieee1905_1::CmduMessageRx.
+ *                     Must not be NULL. Must point to a fully parsed CMDU.
+ * @return 1 if the message is a QCA vendor message, 0 otherwise.
+ */
+int qca_is_vs_msg(void *cmdu_rx);
+
+/* -------------------------------------------------------------------------
+ * TX-side utilities
+ * ---------------------------------------------------------------------- */
+
+/**
+ * @brief C linkage wrapper for qca::tlvf_qca_utils::add_qca_version_info_tlv().
+ *
+ * Appends a QCA Version Info TLV to an outgoing CMDU.
+ *
+ * Wraps qca::tlvf_qca_utils::add_qca_version_info_tlv() with C linkage so it
+ * can be called from C code and reused across threads and processes.
+ *
+ * @param[in] cmdu_tx  Opaque pointer to ieee1905_1::CmduMessageTx.
+ *                     Must not be NULL.
+ * @return 1 on success, 0 on failure or NULL pointer.
+ */
+int qca_add_version_info_tlv(void *cmdu_tx);
+
+/**
+ * @brief C linkage wrapper for qca::tlvf_qca_utils::add_qca_msg_type_tlv().
+ *
+ * Prepends a QCA Message Type TLV to an outgoing VENDOR_SPECIFIC_MESSAGE CMDU.
+ * Must be called BEFORE adding any payload TLVs. Every QCA
+ * VENDOR_SPECIFIC_MESSAGE must start with this TLV so that the receiver can
+ * dispatch on message type without inspecting payload TLVs.
+ *
+ * Wraps qca::tlvf_qca_utils::add_qca_msg_type_tlv() with C linkage so it can
+ * be called from C code and reused across threads and processes.
+ *
+ * @param[in] cmdu_tx   Opaque pointer to ieee1905_1::CmduMessageTx.
+ *                      Must not be NULL.
+ * @param[in] msg_type  QCA message type value (eQcaMsgType cast to uint16_t).
+ * @return 1 on success, 0 on failure or NULL pointer.
+ */
+int qca_add_msg_type_tlv(void *cmdu_tx, uint16_t msg_type);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __QCA_VS_MSG_UTILS_H__ */
