+// SEND side: Add QCA message type TLV (must be first TLV in every QCA VENDOR_SPECIFIC_MESSAGE)
+bool tlvf_qca_utils::add_qca_msg_type_tlv(ieee1905_1::CmduMessageTx &cmdu_tx, uint16_t msg_type)
+{
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaMsgType>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to add QCA message type TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+
+    // Set TLV ID
+    tlv->tlv_id() = static_cast<uint16_t>(qca::eQcaTlVId::QCA_MSG_TYPE);
+
+    // Set message type
+    tlv->message_type() = msg_type;
+
+    LOG(DEBUG) << "Added QCA message type TLV: message_type=0x" << std::hex << msg_type;
+    return true;
+}
+
+// SEND side: Add QCA Neighbor Information TLV to outgoing VENDOR_SPECIFIC_MESSAGE
+bool tlvf_qca_utils::add_qca_neighbor_info_tlv(ieee1905_1::CmduMessageTx &cmdu_tx,
+                                               const std::vector<sQcaNeighborEntry> &entries)
+{
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaNeighborInformation>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to add QCA Neighbor Information TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+
+    // Set TLV ID
+    tlv->tlv_id() = static_cast<uint16_t>(qca::eQcaTlVId::QCA_NEIGHBOR_INFORMATION);
+
+    // Populate one cQcaNeighborReport per entry
+    for (const auto &entry : entries) {
+        auto report = tlv->create_neighbor_report_list();
+        if (!report) {
+            LOG(ERROR) << "Failed to create neighbor_report_list entry for agent "
+                       << tlvf::mac_to_string(entry.agent_alid);
+            return false;
+        }
+
+        report->neighbor_report_element_length() = static_cast<uint16_t>(entry.nre_bytes.size());
+
+        if (!entry.nre_bytes.empty()) {
+            if (!report->set_neighbor_report_element(entry.nre_bytes.data(),
+                                                     entry.nre_bytes.size())) {
+                LOG(ERROR) << "Failed to set neighbor_report_element for agent "
+                           << tlvf::mac_to_string(entry.agent_alid);
+                return false;
+            }
+        }
+
+        if (!tlv->add_neighbor_report_list(report)) {
+            LOG(ERROR) << "Failed to add neighbor_report_list entry for agent "
+                       << tlvf::mac_to_string(entry.agent_alid);
+            return false;
+        }
+    }
+
+    tlv->num_neighbor_reports() = static_cast<uint8_t>(entries.size());
+
+    LOG(INFO) << "Added QCA Neighbor Information TLV with " << entries.size() << " entries";
+    return true;
