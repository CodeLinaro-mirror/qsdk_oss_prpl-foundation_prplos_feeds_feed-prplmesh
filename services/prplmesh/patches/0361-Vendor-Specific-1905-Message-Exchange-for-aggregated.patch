@@ -0,0 +1,36 @@
+#
+---
+
+_namespace: qca
+_include:
+  {
+    tlvf/ieee_1905_1/sVendorOUI.h,
+    tlvf/qca/eQcaTlvTypeMap.h,
+    tlvf/qca/eQcaMsgType.h,
+  }
+
+# QCA Message Type TLV
+# The first TLV in every QCA VENDOR_SPECIFIC_MESSAGE.
+# Identifies the semantic message type so the receiver can dispatch
+# without inspecting the payload TLVs.
+#
+# Wire format (tlvValue):
+#   - vendor_oui   : 3 octets  - Qualcomm OUI (0x7f0300)
+#   - tlv_id       : 2 octets  - QCA_MSG_TYPE (0x0007)
+#   - message_type : 2 octets  - eQcaMsgType value
+
+tlvQcaMsgType:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eQcaTlvTypeMap
+    _value_const: TLV_VENDOR_SPECIFIC
+  length: uint16_t
+  vendor_oui:
+    _type: sVendorOUI
+  tlv_id:
+    _type: uint16_t
+    _comment: "Must be QCA_MSG_TYPE (0x0007)"
+  message_type:
+    _type: uint16_t
+    _comment: "QCA message type identifier (see eQcaMsgType)"
