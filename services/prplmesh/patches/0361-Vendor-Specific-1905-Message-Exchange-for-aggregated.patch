         }
 
         if (beerocks_header->action() != beerocks_message::ACTION_CONTROL) {
diff --git a/agent/src/beerocks/slave/tasks/neighbor_db_agent_task.cpp b/agent/src/beerocks/slave/tasks/neighbor_db_agent_task.cpp
index 53e7b5830..532103fd2 100644
