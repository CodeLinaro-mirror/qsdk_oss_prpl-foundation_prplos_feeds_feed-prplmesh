+++ b/agent/src/beerocks/slave/tasks/neighbor_db_agent_task.cpp
@@ -6,6 +6,9 @@
 
 #include <bcl/network/network_utils.h>
 #include <easylogging++.h>
+#include <tlvf/qca/eQcaMsgType.h>
+#include <tlvf/qca/tlvQcaMsgType.h>
+#include <tlvf/qca/tlvQcaNeighborInformation.h>
 
 using namespace beerocks;
 
@@ -54,14 +57,48 @@ bool NeighborDbAgentTask::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32
 {
     (void)iface_index;
     (void)dst_mac;
-    (void)src_mac;
     (void)fd;
     (void)beerocks_header;
 
-    // Agent-side Neighbor DB task currently does not consume any CMDUs.
-    // Retained for future use (e.g. if controller later sends aggregated neighbor info to agent).
-    (void)cmdu_rx;
-    return false;
+    switch (cmdu_rx.getMessageType()) {
+    case ieee1905_1::eMessageType::VENDOR_SPECIFIC_MESSAGE:
+        return handle_vendor_specific(cmdu_rx, src_mac);
+    default:
+        return false;
+    }
+}
+
+bool NeighborDbAgentTask::handle_vendor_specific(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                  const sMacAddr &src_mac)
+{
+    // The multi_vendor framework has already parsed all QCA TLVs. Use getClass<> directly.
+    auto msg_type_tlv = cmdu_rx.getClass<qca::tlvQcaMsgType>();
+    if (!msg_type_tlv) {
+        // Not a QCA message (no tlvQcaMsgType TLV present)
+        return false;
+    }
+
+    LOG(INFO) << "AP_DEBUG: NeighborDbAgentTask: received QCA VENDOR_SPECIFIC_MESSAGE"
+              << " from " << src_mac << " message_type=0x" << std::hex
+              << msg_type_tlv->message_type();
+
+    switch (static_cast<qca::eQcaMsgType>(msg_type_tlv->message_type())) {
+    case qca::eQcaMsgType::QCA_MSG_AGGREGATED_NEIGHBOR_INFO: {
+        auto neighbor_tlv = cmdu_rx.getClass<qca::tlvQcaNeighborInformation>();
+        if (!neighbor_tlv) {
+            LOG(ERROR) << "AP_DEBUG: NeighborDbAgentTask: missing QCA Neighbor Information TLV";
+            return false;
+        }
+        LOG(INFO) << "AP_DEBUG: NeighborDbAgentTask: received aggregated neighbor info with "
+                  << static_cast<int>(neighbor_tlv->num_neighbor_reports()) << " NRE entries";
+        // TODO: Process the neighbor report entries and update hostapd neighbor tables.
+        return true;
+    }
+    default:
+        LOG(DEBUG) << "AP_DEBUG: NeighborDbAgentTask: ignoring QCA message type 0x" << std::hex
+                   << msg_type_tlv->message_type();
+        return false;
+    }
 }
 
 std::vector<uint8_t> NeighborDbAgentTask::collect_local_neighbor_report()
