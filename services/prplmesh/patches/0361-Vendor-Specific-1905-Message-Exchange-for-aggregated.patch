+// RECEIVE side: Specific parser for QCA message type TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_msg_type_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaMsgType>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA message type TLV";
+        return nullptr;
+    }
+
+    LOG(DEBUG) << "Parsed QCA message type TLV: message_type=0x" << std::hex << tlv->message_type();
+    return tlv;
+}
+
+// RECEIVE side: Specific parser for QCA Neighbor Information TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_neighbor_info_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaNeighborInformation>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA Neighbor Information TLV";
+        return nullptr;
+    }
+
+    uint8_t count = tlv->num_neighbor_reports();
+    LOG(INFO) << "Parsed QCA Neighbor Information TLV: " << static_cast<int>(count)
+              << " neighbor report(s)";
+
+    for (uint8_t i = 0; i < count; i++) {
+        auto report_tuple = tlv->neighbor_report_list(i);
+        if (!std::get<0>(report_tuple)) {
+            LOG(ERROR) << "Failed to access neighbor_report_list[" << static_cast<int>(i) << "]";
+            continue;
+        }
+        auto &report = std::get<1>(report_tuple);
+        LOG(DEBUG) << "  NRE[" << static_cast<int>(i)
+                   << "]: " << report.neighbor_report_element_length() << " bytes";
+    }
+
+    return tlv;
+}
