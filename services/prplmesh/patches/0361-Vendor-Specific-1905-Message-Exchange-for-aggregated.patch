+// RECEIVE side: Check if a VENDOR_SPECIFIC_MESSAGE is a QCA vendor message
+bool tlvf_qca_utils::is_qca_vs_msg(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // A QCA VENDOR_SPECIFIC_MESSAGE always starts with a tlvQcaMsgType TLV.
+    // getClass<> is non-destructive: it looks up the already-parsed TLV list
+    // without consuming any buffer bytes.
+    return cmdu_rx.getClass<qca::tlvQcaMsgType>() != nullptr;
+}
+
+// C linkage wrappers — allow QCA utility functions to be called from C code and
+// reused across threads and processes without C++ name-mangling issues.
+extern "C" {
+
+int qca_is_vs_msg(void *cmdu_rx_ptr)
+{
+    if (!cmdu_rx_ptr) {
+        return 0;
+    }
+    return qca::tlvf_qca_utils::is_qca_vs_msg(
+               *static_cast<ieee1905_1::CmduMessageRx *>(cmdu_rx_ptr))
+               ? 1
+               : 0;
+}
+
+int qca_add_version_info_tlv(void *cmdu_tx_ptr)
+{
+    if (!cmdu_tx_ptr) {
+        return 0;
+    }
+    return qca::tlvf_qca_utils::add_qca_version_info_tlv(
+               *static_cast<ieee1905_1::CmduMessageTx *>(cmdu_tx_ptr))
+               ? 1
+               : 0;
+}
+
+int qca_add_msg_type_tlv(void *cmdu_tx_ptr, uint16_t msg_type)
+{
+    if (!cmdu_tx_ptr) {
+        return 0;
+    }
+    return qca::tlvf_qca_utils::add_qca_msg_type_tlv(
+               *static_cast<ieee1905_1::CmduMessageTx *>(cmdu_tx_ptr), msg_type)
+               ? 1
+               : 0;
+}
+
+} // extern "C"
