+                    /* TLV 0xe4 must carry bytes_sent()/bytes_received() in the
+                     * unit declared via this agent's Profile-2 ByteCounterUnits
+                     * (KIBIBYTES per spec) — the controller multiplies back up
+                     * by the same factor when writing the DM. */
+                    affiliated_sta_metrics_tlv->bytes_sent() =
+                        recalculate_byte_units(db->device_conf.byte_counter_units, link_tx_bytes);
+                    affiliated_sta_metrics_tlv->bytes_received() =
+                        recalculate_byte_units(db->device_conf.byte_counter_units, link_rx_bytes);
                     affiliated_sta_metrics_tlv->packets_sent()        = link_tx_packets;
                     affiliated_sta_metrics_tlv->packets_received()    = link_rx_packets;
                     affiliated_sta_metrics_tlv->packets_sent_errors() = link_tx_failed;
