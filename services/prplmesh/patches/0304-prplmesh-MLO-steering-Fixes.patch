+/**
+ * @brief Scale a raw byte count (as read from nl80211) down to the unit
+ *        declared in this agent's Profile-2 AP Capability (ByteCounterUnits),
+ *        mirroring monitor_stats::recalculate_byte_units(). TLV 0xe4 carries
+ *        bytes_sent()/bytes_received() in that declared unit, and the
+ *        controller multiplies back up by the same factor when writing the
+ *        DM (db::recalculate_attr_to_byte_units()) — skipping this on the
+ *        agent side causes the controller to inflate the value by 1024x
+ *        (or 1024x1024x for MEBIBYTES).
+ */
+static uint64_t recalculate_byte_units(wfa_map::tlvProfile2ApCapability::eByteCounterUnits units,
+                                       uint64_t bytes)
+{
+    if (units == wfa_map::tlvProfile2ApCapability::eByteCounterUnits::KIBIBYTES) {
+        return bytes / 1024;
+    } else if (units == wfa_map::tlvProfile2ApCapability::eByteCounterUnits::MEBIBYTES) {
+        return bytes / 1024 / 1024;
+    }
+    return bytes;
+}
+
 } // anonymous namespace
 
