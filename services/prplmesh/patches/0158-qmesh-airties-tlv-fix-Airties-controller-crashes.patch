From 760e70c93280fc1b9200b02006d70d61a4f1ee64 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Thu, 14 May 2026 17:13:40 +0530
Subject: [PATCH] [qmesh][airties tlv] fix Airties controller crashes due to
 qmeshagent send empty neighbour list

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 .../nl80211/src/tlvf_airties_utils_nl80211.cpp   | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
index e6c0916df..e6e4f5897 100644
--- a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
+++ b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
@@ -1038,8 +1038,16 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
             }
         }
 
+#ifdef BEEROCKS_RDKB
+        // Only add port if neighbors are not empty
+        if (num_neighbor > 0) {
+            tlvNeighborList->add_port_entries(port_entry);
+            ++added_ports;
+        }
+#else
         tlvNeighborList->add_port_entries(port_entry);
         ++added_ports;
+#endif
     }
 
     // Finalize TLV with total port count
@@ -1191,8 +1199,16 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
             }
         }
 
+#ifdef BEEROCKS_RDKB
+        // Only add port if neighbors are not empty
+        if (num_neighbor > 0) {
+            tlvNon1905->add_port_entries(port_entry);
+            ++added_ports;
+        }
+#else
         tlvNon1905->add_port_entries(port_entry);
         ++added_ports;
+#endif
     }
 
     // Finalize TLV with total port count
-- 
2.34.1

