+        // Fix: MLD lookup MUST happen BEFORE erase_client().
+        // erase_client(mld_mac) also removes from associated_sta_mlds, so the
+        // lookup would fail if called after erase_client.
+        // The driver sends the MLD MAC in disconnect events (same MAC for all links).
+        //
+        // Spec 17.2.6:
+        //   MLD client  -> LEAVE must carry Client MLD MAC + AP MLD MAC.
+        //                  Only send when ALL affiliated links have disconnected.
+        //   Non-MLD client -> LEAVE carries the link MAC + link BSSID (unchanged).
+        sMacAddr tlv_disc_client_mac = notification_in->params().mac;
+        sMacAddr tlv_disc_bssid      = notification_in->params().bssid;
+        bool send_leave    = true;
+        bool is_mld_client = false;
+
+        // Case A: notification MAC is the MLD MAC itself
+        //         (driver sends MLD MAC in AP-STA-DISCONNECTED events).
+        {
+            auto mld_it = db->associated_sta_mlds.find(notification_in->params().mac);
+            if (mld_it != db->associated_sta_mlds.end()) {
+                is_mld_client = true;
+                auto &mld_entry       = mld_it->second;
+                auto &affiliated_stas = mld_entry.affiliated_stas;
+
+                // Remove the disconnecting link from affiliated_stas using the link BSSID.
+                affiliated_stas.erase(
+                    std::remove_if(affiliated_stas.begin(), affiliated_stas.end(),
+                                   [&](const auto &a) {
+                                       return a.bssid == notification_in->params().bssid;
+                                   }),
+                    affiliated_stas.end());
+
+                if (affiliated_stas.empty()) {
+                    // All links gone — send MLD-level LEAVE and erase the entry.
+                    tlv_disc_client_mac = mld_it->first;
+                    tlv_disc_bssid      = mld_entry.mld_config.ap_mld_mac;
+                    LOG(DEBUG) << "MLO LEAVE (MLD MAC): all links disconnected,"
+                               << " STA MLD MAC=" << tlv_disc_client_mac
+                               << " AP MLD MAC=" << tlv_disc_bssid
+                               << " (disconnecting BSSID=" << notification_in->params().bssid << ")";
+                    db->associated_sta_mlds.erase(mld_it);
+                } else {
+                    // Some links still up — skip LEAVE, do NOT erase the MLD entry.
+                    send_leave = false;
+                    LOG(DEBUG) << "MLO LEAVE (MLD MAC): " << affiliated_stas.size()
+                               << " links still connected — skipping TOPOLOGY_NOTIFICATION"
+                               << " for MLD MAC=" << notification_in->params().mac;
+                }
+                // Do NOT call erase_client(mld_mac) — that removes the entire MLD entry.
+            }
+        }
+
+        // Case B: notification MAC is a link MAC (search affiliated_stas).
+        if (!is_mld_client) {
+            for (auto &sta_mld_entry : db->associated_sta_mlds) {
+                bool found = false;
+                for (const auto &aff : sta_mld_entry.second.affiliated_stas) {
+                    if (aff.affiliated_sta_mac == notification_in->params().mac) {
+                        found = true;
+                        break;
+                    }
+                }
+                if (!found) continue;
+
+                is_mld_client = true;
+                auto &mld_entry       = sta_mld_entry.second;
+                auto &affiliated_stas = mld_entry.affiliated_stas;
+
+                affiliated_stas.erase(
+                    std::remove_if(affiliated_stas.begin(), affiliated_stas.end(),
+                                   [&](const auto &a) {
+                                       return a.affiliated_sta_mac == notification_in->params().mac;
+                                   }),
+                    affiliated_stas.end());
+
+                if (affiliated_stas.empty()) {
+                    tlv_disc_client_mac = sta_mld_entry.first;
+                    tlv_disc_bssid      = mld_entry.mld_config.ap_mld_mac;
+                    LOG(DEBUG) << "MLO LEAVE (link MAC): all links disconnected,"
+                               << " STA MLD MAC=" << tlv_disc_client_mac
+                               << " AP MLD MAC=" << tlv_disc_bssid;
+                    db->associated_sta_mlds.erase(sta_mld_entry.first);
+                } else {
+                    send_leave = false;
+                    LOG(DEBUG) << "MLO LEAVE (link MAC): " << affiliated_stas.size()
+                               << " links still connected — skipping TOPOLOGY_NOTIFICATION";
+                }
+                break;
+            }
+        }
+
+        // For non-MLD clients: call erase_client to remove from radio->associated_clients.
+        // For MLD clients: do NOT call erase_client(mld_mac) — it removes associated_sta_mlds.
+        if (!is_mld_client) {
+            db->erase_client(client_mac);
+        }
 
         if (reconcile_ts_sta_ifaces) {
