@@ -1627,8 +1627,30 @@ bool ap_wlan_hal_nl80211::sta_bss_steer(const sBtmRequestParams &params)
     // Target BSSID
     cmd += std::string() + " neighbor=" + tlvf::mac_to_string(params.bssid) + "," + std::to_string(NEIGHBOR_REPORT_BSSID_INFO_EASYMESH) + "," + std::to_string(params.oper_class) + "," + std::to_string(params.chan) + ",0," + NEIGHBOR_REPORT_SUBELEM_CANDIDATE_PREF_MAX_HEX;
 
