+            // Fix B: MLO-aware DISASSOCIATE — skip if new and previous BSSIDs are affiliated
+            // APs of the same AP MLD on the same agent.
+            // Without this check, the controller treats each per-link JOIN notification as a
+            // "roam" and disassociates the previous link, causing an infinite join/leave loop
+            // for MLO clients (IEEE 802.11be §17.2.6).
+            bool is_mlo_partner_link = false;
+            auto new_agent_mac  = database.get_bss_parent_agent(tlvf::mac_from_string(new_hostap_mac));
+            auto prev_agent_mac = database.get_bss_parent_agent(tlvf::mac_from_string(previous_hostap_mac));
+            if (new_agent_mac == prev_agent_mac && new_agent_mac != network_utils::ZERO_MAC) {
+                auto agent = database.m_agents.get(new_agent_mac);
+                if (agent) {
+                    for (const auto &ap_mld_entry : agent->ap_mlds) {
+                        bool found_new = false, found_prev = false;
+                        for (const auto &affl_ap : ap_mld_entry.second.affiliated_aps) {
+                            auto bssid_str = tlvf::mac_to_string(affl_ap.second.bssid);
+                            if (bssid_str == new_hostap_mac)      found_new  = true;
+                            if (bssid_str == previous_hostap_mac) found_prev = true;
+                        }
+                        if (found_new && found_prev) {
+                            is_mlo_partner_link = true;
+                            LOG(DEBUG) << "MLO multi-link: skipping DISASSOCIATE for "
+                                       << previous_hostap_mac << " (MLO partner of "
+                                       << new_hostap_mac << ")";
+                            break;
+                        }
+                    }
+                }
+            }
+            if (!is_mlo_partner_link) {
+                disconnect_client(database, cmdu_tx, client_mac, previous_hostap_mac,
+                                  eDisconnect_Type_Disassoc, 0);
+            }
         }
 
