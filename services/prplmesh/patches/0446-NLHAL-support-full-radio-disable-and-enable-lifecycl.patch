+bool ap_wlan_hal_nl80211::set_wsi_bypass_device(bool enable)
+{
+    int radio_idx = 0;
+    if (!get_this_radio_idx(radio_idx)) {
+        LOG(ERROR) << "Unable to determine radio index for WSI bypass on iface "
+                   << get_iface_name();
+        return false;
+    }
+
+    // The WSI command uses one 5 GHz bucket. prplMesh distinguishes 5 GHz high
+    // from the regular 5 GHz bucket internally, but prplOS does not.
+    if (radio_idx == RADIOIDX_5GH) {
+        radio_idx = RADIOIDX_5G;
+    }
+
+    uint32_t wiphy = 0;
+    if (m_cached_wiphy_valid) {
+        wiphy = m_cached_wiphy;
+    } else {
+        // Bootstrap from the interface-independent GET_WIPHY dump. Do not use
+        // get_interface_info() here: all VAP netdevs may already be gone when powersave is
+        // enabled, while the wiphy and its radio index remain valid.
+        nl80211_client::radio_info radio_info;
+        if (!m_nl80211_client || !m_nl80211_client->get_radio_info({}, radio_info) ||
+            !radio_info.wiphy_valid) {
+            LOG(ERROR) << "Unable to obtain wiphy for WSI bypass from GET_WIPHY for phy "
+                       << m_hal_conf.phy_name;
+            return false;
+        }
+        wiphy               = radio_info.wiphy;
+        m_cached_wiphy       = wiphy;
+        m_cached_wiphy_valid = true;
+    }
+
+    const uint32_t bypass_value = enable ? WSI_VALUE0_BYPASS : WSI_VALUE0_READD;
+    LOG(INFO) << "Setting WSI bypass for phy=" << m_hal_conf.phy_name
+              << " wiphy=" << wiphy << " radio_idx=" << radio_idx
+              << " enable=" << enable << " bypass_value=" << bypass_value;
+
+    const auto msg_create = [=](struct nl_msg *msg) {
+        if (nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, WSI_QCA_VENDOR_ID) < 0 ||
+            nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD, WSI_BYPASS_SUBCMD) < 0 ||
+            nla_put_u32(msg, NL80211_ATTR_WIPHY, wiphy) < 0) {
+            return false;
+        }
+
+        auto *vendor_data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA);
+        if (!vendor_data) {
+            return false;
+        }
+
+        if (nla_put_u8(msg, WSI_ATTR_RADIO_IDX, static_cast<uint8_t>(radio_idx)) < 0 ||
+            nla_put_u32(msg, WSI_ATTR_DPARAM0, WSI_DPARAM0_WIFI_PARAMS) < 0 ||
+            nla_put_u32(msg, WSI_ATTR_DPARAM1, WSI_DPARAM1_WSI_BYPASS) < 0 ||
+            nla_put_u32(msg, WSI_ATTR_VALUE0, bypass_value) < 0) {
+            return false;
+        }
+
+        nla_nest_end(msg, vendor_data);
+        return true;
+    };
+
+    const bool success = send_nl80211_msg(
+        NL80211_CMD_VENDOR, 0, msg_create, [](struct nl_msg *) { return true; }, {}, false);
+    if (!success) {
+        LOG(ERROR) << "WSI bypass command failed for phy " << m_hal_conf.phy_name
+                   << " enable=" << enable;
+    }
+    return success;
+}
+
+bool ap_wlan_hal_nl80211::powersave_enable(bool allow_non_6g, bool force)
+{
+    (void)allow_non_6g;
+    LOG(DEBUG) << "ap_wlan_hal_nl80211::powersave_enable() called for radio iface="
+               << get_iface_name() << " force=" << force;
+    if (!set_wsi_bypass_device(true)) {
+        return false;
+    }
+
+    m_powersave_enabled = true;
+    return true;
+}
+
+bool ap_wlan_hal_nl80211::powersave_disable(bool allow_non_6g, bool force)
+{
+    (void)allow_non_6g;
+    LOG(DEBUG) << "ap_wlan_hal_nl80211::powersave_disable() called for radio iface="
+               << get_iface_name() << " force=" << force;
+    if (!force && !m_powersave_enabled) {
+        LOG(DEBUG) << "powersave_disable() skipped because powersave was not enabled for iface="
+                   << get_iface_name();
+        return true;
+    }
+
+    if (!set_wsi_bypass_device(false)) {
+        return false;
+    }
+
+    m_powersave_enabled = false;
+    return true;
+}
