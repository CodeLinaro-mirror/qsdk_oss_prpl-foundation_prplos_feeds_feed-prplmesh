+std::string ApManager::get_radio_uid_for_notification()
+{
+#ifdef USE_PRPLMESH_NLHAL
+    if (!m_radio_iface_mac.empty()) {
+        return m_radio_iface_mac;
+    }
+
+    // AgentDB stores the MAC from AP_MANAGER_JOINED_NOTIFICATION as front.iface_mac.
+    // Do not derive this from a later Linux/MLO link interface: subordinate MLO links can
+    // expose a different 02:03:... link MAC after hostapd has grouped the radios.
+#endif
+    auto radio_mac = ap_wlan_hal ? ap_wlan_hal->get_radio_mac()
+                                 : beerocks::net::network_utils::ZERO_MAC_STRING;
+#ifdef USE_PRPLMESH_NLHAL
+    if (!radio_mac.empty() && radio_mac != beerocks::net::network_utils::ZERO_MAC_STRING) {
+        m_radio_iface_mac = radio_mac;
+        LOG(DEBUG) << "Captured canonical radio MAC for notifications: " << m_radio_iface_mac;
+    }
+#endif
+    return radio_mac;
+}
