+
+    auto band = radio->band;
+    if (band == beerocks::FREQ_UNKNOWN || band == beerocks::FREQ_DISABLED) {
+        band = radio->wifi_channel.get_freq_type();
+    }
+    if (band == beerocks::FREQ_UNKNOWN || band == beerocks::FREQ_DISABLED) {
+        LOG(ERROR) << "Cannot set BSS state: frequency band is unknown for radio " << ruid;
+        return false;
+    }
+
+    bss_states[static_cast<uint8_t>(band)][vap_label] = enable;
+    LOG(INFO) << "Set band-wide BSS state: band=" << int(band)
+              << " vap_label=" << vap_label << " enable=" << enable
+              << " (source ruid=" << ruid << ")";
+    return true;
+}
+
+bool db::get_bss_state(const sMacAddr &ruid, const std::string &vap_label) const
+{
+    beerocks::eFreqType band = beerocks::FREQ_UNKNOWN;
+    for (const auto &agent_entry : m_agents) {
+        const auto &radios = agent_entry.second->radios;
+        auto radio_it       = radios.find(ruid);
+        if (radio_it == radios.end() || !radio_it->second) {
+            continue;
+        }
+
+        band = radio_it->second->band;
+        if (band == beerocks::FREQ_UNKNOWN || band == beerocks::FREQ_DISABLED) {
+            band = radio_it->second->wifi_channel.get_freq_type();
+        }
+        break;
+    }
+
+    if (band == beerocks::FREQ_UNKNOWN || band == beerocks::FREQ_DISABLED) {
+        return true;
+    }
+
+    auto band_state = bss_states.find(static_cast<uint8_t>(band));
+    if (band_state == bss_states.end()) {
+        return true;
+    }
+
+    auto bss_state = band_state->second.find(vap_label);
+    return bss_state == band_state->second.end() ? true : bss_state->second;
+}
