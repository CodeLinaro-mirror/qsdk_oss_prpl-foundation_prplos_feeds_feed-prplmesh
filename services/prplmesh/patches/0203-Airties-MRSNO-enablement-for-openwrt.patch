From bd2fc243d92dda1aa9450c81f26c830bb27b301f Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Fri, 5 Jun 2026 15:58:04 +0530
Subject: [PATCH] Airties MRSNO enablement for openwrt

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 120 ++++++-
 .../bcl/include/bcl/son/son_wireless_utils.h  |  16 +-
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 310 +++++++++++++++++-
 .../airties/src/tlvf_airties_utils.cpp        |   2 +-
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     |  81 +++++
 .../include/tlvf/airties/supported_features.h |   5 +-
 framework/tlvf/src/include/tlvf/WSC/m2.h      |  27 +-
 7 files changed, 545 insertions(+), 16 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 4f4cf5dd3..c30f019b1 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -1438,6 +1438,13 @@ bool ApAutoConfigurationTask::add_wsc_m1_tlv(const std::string &radio_iface)
               radio_conf_params.dh->nonce() + radio_conf_params.dh->nonce_length(),
               cfg.enrollee_nonce);
     copy_pubkey(*radio_conf_params.dh, cfg.pub_key);
+    // Airties flow: advertise auth types that Airties controller will use in M2
+    // 0x0001 = Open
+    // 0x0020 = WPA2-PSK
+    // 0x0040 = SAE with AKM8 (used in Airties WPA3 compatibility mode)
+    // 0x0100 = SAE with AKM24 (used in Airties WPA3 compatibility mode)
+    // Note: WSC_AUTH_RSN (0x0200) is NOT included because Airties flow does not use
+    // RSN Parameters Configuration TLV. Security is configured via M2 auth_type + BSS Profile bit5.
     cfg.auth_type_flags =
         WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_OPEN | WSC::eWscAuth::WSC_AUTH_WPA2PSK |
                       WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
@@ -2373,6 +2380,105 @@ bool ApAutoConfigurationTask::handle_wsc_m2_tlv(
 
         info.m2_config.hidden_ssid = m2.hidden_ssid();
 
+        uint8_t airties_bss_profile = 0;
+        const auto auth_type = info.payload_config.auth_type;
+        
+        LOG(DEBUG) << "MRSNO Flow: Checking Airties BSS Profile for SSID=" << info.payload_config.ssid
+                   << " auth_type=0x" << std::hex << int(auth_type) << std::dec;
+        
+        if (m2.airties_bss_profile(airties_bss_profile)) {
+            LOG(DEBUG) << "MRSNO Flow: Airties BSS Profile FOUND, value=0x" << std::hex 
+                       << int(airties_bss_profile) << std::dec;
+            
+            constexpr uint8_t AIRTIES_BSS_PROFILE_WPA3_COMPATIBILITY_MODE = 0x20; // bit 5
+            const bool airties_wpa3_compatibility_mode =
+                (airties_bss_profile & AIRTIES_BSS_PROFILE_WPA3_COMPATIBILITY_MODE) != 0;
+
+            LOG(DEBUG) << "MRSNO Flow: bit5=" << (airties_wpa3_compatibility_mode ? "1" : "0")
+                       << " (Compatibility=" << airties_wpa3_compatibility_mode 
+                       << ", Transition=" << !airties_wpa3_compatibility_mode << ")";
+
+            if (airties_wpa3_compatibility_mode) {
+                LOG(DEBUG) << "MRSNO Flow: Entering COMPATIBILITY MODE branch (bit5=1)";
+                // Bit 5 = 1: Compatibility Mode (RSN Override)
+                if (auth_type ==
+                    WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                  WSC::eWscAuth::WSC_AUTH_SAE)) {
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8;
+                    LOG(DEBUG) << "WPA3 compatibility mode: auth_type=0x0060 (bit5=1) -> AKM8";
+                } else if (auth_type ==
+                           WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                         WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM24;
+                    LOG(DEBUG) << "WPA3 compatibility mode: auth_type=0x0120 (bit5=1) -> AKM24";
+                } else if (auth_type ==
+                           WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                         WSC::eWscAuth::WSC_AUTH_SAE |
+                                         WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24;
+                    LOG(DEBUG) << "WPA3 compatibility mode: auth_type=0x0160 (bit5=1) -> AKM8+AKM24";
+                } else if (auth_type ==
+                           WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_SAE |
+                                         WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    // 6GHz: SAE + SAE-EXT without WPA2-PSK
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24;
+                    LOG(DEBUG) << "WPA3 compatibility mode (6GHz): auth_type=0x0140 (bit5=1) -> AKM8+AKM24";
+                } else if (auth_type == WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_SAE)) {
+                    // 6GHz: SAE only
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8;
+                    LOG(DEBUG) << "WPA3 compatibility mode (6GHz): auth_type=0x0100 (bit5=1) -> AKM8";
+                } else if (auth_type == WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    // 6GHz: SAE-EXT only
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM24;
+                    LOG(DEBUG) << "WPA3 compatibility mode (6GHz): auth_type=0x0040 (bit5=1) -> AKM24";
+                } else {
+                    LOG(WARNING) << "MRSNO Flow: COMPATIBILITY MODE - No matching auth_type! auth_type=0x" 
+                                 << std::hex << int(auth_type) << std::dec;
+                }
+                LOG(DEBUG) << "MRSNO Flow: COMPATIBILITY MODE result: additional_auth=" 
+                           << int(info.additional_auth);
+            } else {
+                LOG(DEBUG) << "MRSNO Flow: Entering TRANSITION MODE branch (bit5=0)";
+                // Bit 5 = 0: Transition Mode (both PSK and SAE in primary RSNE)
+                if (auth_type ==
+                    WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                  WSC::eWscAuth::WSC_AUTH_SAE)) {
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_TRANSITION_AKM8;
+                    LOG(DEBUG) << "WPA3 transition mode: auth_type=0x0060 (bit5=0) -> Transition AKM8";
+                } else if (auth_type == WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    // 6GHz: SAE-EXT only (WPA2-PSK not allowed on 6 GHz)
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_TRANSITION_AKM24;
+                    LOG(DEBUG) << "WPA3 transition mode (6GHz): auth_type=0x0040 (bit5=0) -> Transition AKM24";
+                } else if (auth_type ==
+                           WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                         WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_TRANSITION_AKM24;
+                    LOG(DEBUG) << "WPA3 transition mode: auth_type=0x0120 (bit5=0) -> Transition AKM24";
+                } else if (auth_type ==
+                           WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                         WSC::eWscAuth::WSC_AUTH_SAE |
+                                         WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+                    info.additional_auth =
+                        son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_TRANSITION_AKM8_AKM24;
+                    LOG(DEBUG) << "WPA3 transition mode: auth_type=0x0160 (bit5=0) -> Transition AKM8+AKM24";
+                } else {
+                    LOG(WARNING) << "MRSNO Flow: TRANSITION MODE - No matching auth_type! auth_type=0x" 
+                                 << std::hex << int(auth_type) << std::dec;
+                }
+                LOG(DEBUG) << "MRSNO Flow: TRANSITION MODE result: additional_auth=" 
+                           << int(info.additional_auth);
+            }
+        } 
+
         // EM_AP_CONTROLLER specific Vendor Extension Attributes
         if (db->em_ap_controller_found) {
             LOG(DEBUG) << "EM+ controller is found. Check for Hidden SSID parameters";
@@ -2400,9 +2506,13 @@ bool ApAutoConfigurationTask::handle_wsc_m2_tlv(
             bool(info.payload_config.bss_type & WSC::eWscVendorExtSubelementBssType::TEARDOWN);
 
         std::stringstream ss;
-        ss << "Parsed M2 info: " << std::endl;
+        ss << "Parsed M2 info (MRSNO FLOW Trace): " << std::endl;
         ss << "bssid: " << info.payload_config.bssid << std::endl;
         ss << "ssid: " << info.payload_config.ssid << std::endl;
+        ss << "auth_type: 0x" << std::hex << int(info.payload_config.auth_type) << std::dec << " (" << eWscAuth_str(info.payload_config.auth_type) << ")" << std::endl;
+        ss << "encr_type: 0x" << std::hex << int(info.payload_config.encr_type) << std::dec << " (" << eWscEncr_str(info.payload_config.encr_type) << ")" << std::endl;
+        ss << "bss_index: " << int(info.m2_config.bss_index) << std::endl;
+        ss << "additional_auth: " << int(info.additional_auth) << std::endl;
         ss << "fBSS: " << fBSS << std::endl;
         ss << "bBSS: " << bBSS << std::endl;
         ss << "teardown: " << teardown << std::endl;
@@ -2410,11 +2520,11 @@ bool ApAutoConfigurationTask::handle_wsc_m2_tlv(
         ss << "vap_type " << info.m2_config.vap_type << std::endl;
         ss << "vap_label " << info.m2_config.vap_label << std::endl;
         if (bBSS) {
-            ss << "profile1_backhaul_sta_association_disallowed: " << bBSS_p1_disallowed;
+            ss << "profile1_backhaul_sta_association_disallowed: " << bBSS_p1_disallowed << std::endl;
             ss << "profile2_backhaul_sta_association_disallowed: " << bBSS_p2_disallowed;
         }
 
-        LOG(DEBUG) << m2.manufacturer() << " " << ss.str();
+        LOG(INFO) << m2.manufacturer() << " " << ss.str();
 
         if (teardown) {
             LOG(DEBUG) << "BSSID: " << info.payload_config.bssid << " is flagged for teardown!";
@@ -3275,6 +3385,7 @@ bool ApAutoConfigurationTask::
             m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
             return true;
         }
+
     }
 
     return false;
@@ -3730,7 +3841,8 @@ bool ApAutoConfigurationTask::send_ap_bss_configuration_message(
            << "- Key: " << info.payload_config.network_key << std::endl
            << "- Auth: " << std::hex << int(info.payload_config.auth_type) << std::endl
            << "- Encr: " << std::hex << int(info.payload_config.encr_type) << std::endl
-           << "- Hidden_SSID: " << info.m2_config.hidden_ssid << std::endl;
+           << "- Hidden_SSID: " << info.m2_config.hidden_ssid << std::endl
+           << "- additional_auth: " << int(info.additional_auth) << std::endl;
 
         c->set_ssid(info.payload_config.ssid);
         c->set_network_key(info.payload_config.network_key);
diff --git a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
index 7d226a7aa..a52d8df81 100644
--- a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
+++ b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
@@ -260,8 +260,20 @@ class wireless_utils {
 public:
     enum eAdditionalAuth {
         NONE = 0,
-        // TODO: add future modes (PPM-3450)
-        WPA3_PERSONAL_COMPATIBILITY = 1
+        // WPA3 Personal Compatibility Mode (MSRNO) - wpa3-comp-8-24: SAE + SAE-EXT-KEY
+        // Used when auth_type = WSC_AUTH_RSN (0x0200) + RSN Parameters Configuration TLV
+        WPA3_PERSONAL_COMPATIBILITY = 1,
+        // Airties EM+ WPA3 Personal Compatibility Mode selected by AIRTIES_BSS_PROFILE bit 5 = 1.
+        // These preserve the AKM set requested in WSC M2 auth_type while telling the HAL to use
+        // Multi-RSN Override instead of legacy WPA3 transition mode.
+        AIRTIES_WPA3_COMPATIBILITY_AKM8 = 2,
+        AIRTIES_WPA3_COMPATIBILITY_AKM24 = 3,
+        AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24 = 4,
+        // Airties EM+ WPA3 Personal Transition Mode selected by AIRTIES_BSS_PROFILE bit 5 = 0.
+        // Both PSK and SAE AKMs are advertised in the primary RSNE (no RSN Override).
+        AIRTIES_WPA3_TRANSITION_AKM8 = 5,
+        AIRTIES_WPA3_TRANSITION_AKM24 = 6,
+        AIRTIES_WPA3_TRANSITION_AKM8_AKM24 = 7,
     };
 
     enum eEstimationStatus {
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 1b60e7211..4fe96d4c2 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -662,6 +662,11 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
                                         const std::string &vap_id,
                                         const son::wireless_utils::sBssInfoConf &bss)
 {
+    LOG(DEBUG) << "assign_auth_encr_parameters: VAP=" << vap_id
+               << " auth_type=0x" << std::hex << int(bss.authentication_type) << std::dec
+               << " encr_type=0x" << std::hex << int(bss.encryption_type) << std::dec
+               << " additional_auth=" << int(bss.additional_auth)
+               << " freq_band=" << int(bss.freq_band);
 
     // Hostapd "wpa" field.
     // This field is a bit field that can be used to enable WPA (IEEE 802.11i/D3.0)
@@ -759,16 +764,156 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
         okc.assign("0");
         wpa_disable_eapol_key_retries.assign("0");
     } else if (bss.authentication_type ==
-               WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE)) {
+                   WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE) &&
+               bss.additional_auth ==
+                   son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8) {
+        // WPA3 Personal Compatibility Mode (wpa3-comp-8):
+        // auth_type=0x0060 (WPA2-PSK + SAE AKM8) + AIRTIES_BSS_PROFILE bit5=1.
+        // 2.4/5 GHz: WPA2-PSK ONLY in primary RSNE + SAE in RSN Override IE 1.
+        // 6 GHz: SAE ONLY in primary RSNE (no WPA2-PSK, no RSN Override).
+        LOG(DEBUG) << "WPA3 AKM8 compatibility mode: VAP=" << vap_id
+                   << " freq_band=" << int(bss.freq_band);
         wpa = 0x2;
-        wpa_key_mgmt.assign("WPA-PSK SAE");
+        wpa_pairwise.assign("CCMP");
+
+        if (bss.encryption_type != WSC::eWscEncr::WSC_ENCR_AES) {
+            LOG(ERROR) << "Autoconfiguration:  " << vap_id << " CCMP(AES) is required for WPA3";
+            return false;
+        }
+
+        if (bss.network_key.length() < 8 || bss.network_key.length() > 64) {
+            LOG(ERROR) << "Autoconfiguration: " << vap_id << " invalid network key length "
+                       << bss.network_key.length();
+            return false;
+        }
+        wpa_passphrase.assign(bss.network_key);
+
+        if (bss.freq_band == beerocks::eFreqType::FREQ_6G) {
+            // 6 GHz: SAE ONLY in primary RSNE (no WPA2-PSK allowed on 6 GHz)
+            wpa_key_mgmt.assign("SAE");
+            ieee80211w.assign("2");
+        } else {
+            // 2.4/5 GHz: WPA2-PSK ONLY in primary RSNE + SAE in RSN Override
+            wpa_key_mgmt.assign("WPA-PSK");
+            ieee80211w.assign("1");
+            conf.set_create_value(vap_id, "rsn_override_key_mgmt", "SAE");
+            conf.set_create_value(vap_id, "rsn_override_pairwise", "CCMP");
+            conf.set_create_value(vap_id, "rsn_override_mfp", "1");
+        }
+
+        disable_pmksa_caching.assign("0");
+        okc.assign("1");
+        wpa_disable_eapol_key_retries.assign("0");
+        sae_pwe.assign("2");
+    } else if (bss.authentication_type ==
+                   WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                 WSC::eWscAuth::WSC_AUTH_SAE_AKM24) &&
+               bss.additional_auth ==
+                   son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM24) {
+        // WPA3 Personal Compatibility Mode (wpa3-comp-24):
+        // auth_type=0x0120 (WPA2-PSK + SAE AKM24) + AIRTIES_BSS_PROFILE bit5=1.
+        // 2.4/5 GHz: WPA2-PSK ONLY in primary RSNE + SAE-EXT-KEY in RSN Override IE 2.
+        // 6 GHz: SAE-EXT-KEY ONLY in primary RSNE (no WPA2-PSK, no RSN Override).
+        LOG(DEBUG) << "WPA3 AKM24 compatibility mode: VAP=" << vap_id
+                   << " freq_band=" << int(bss.freq_band);
+        wpa = 0x2;
+        wpa_pairwise.assign("CCMP");
 
         if (bss.encryption_type != WSC::eWscEncr::WSC_ENCR_AES) {
             LOG(ERROR) << "Autoconfiguration:  " << vap_id << " CCMP(AES) is required for WPA3";
             return false;
         }
+
+        if (bss.network_key.length() < 8 || bss.network_key.length() > 64) {
+            LOG(ERROR) << "Autoconfiguration: " << vap_id << " invalid network key length "
+                       << bss.network_key.length();
+            return false;
+        }
+        wpa_passphrase.assign(bss.network_key);
+
+        if (bss.freq_band == beerocks::eFreqType::FREQ_6G) {
+            // 6 GHz: SAE-EXT-KEY ONLY in primary RSNE (no WPA2-PSK allowed on 6 GHz)
+            wpa_key_mgmt.assign("SAE-EXT-KEY");
+            ieee80211w.assign("2");
+        } else {
+            // 2.4/5 GHz: WPA2-PSK ONLY in primary RSNE + SAE-EXT-KEY in RSN Override
+            wpa_key_mgmt.assign("WPA-PSK");
+            ieee80211w.assign("1");
+            conf.set_create_value(vap_id, "rsn_override_key_mgmt_2", "SAE-EXT-KEY");
+            conf.set_create_value(vap_id, "rsn_override_pairwise_2", "GCMP");
+            conf.set_create_value(vap_id, "rsn_override_mfp_2", "2");
+        }
+
+        disable_pmksa_caching.assign("0");
+        okc.assign("1");
+        wpa_disable_eapol_key_retries.assign("0");
+        sae_pwe.assign("2");
+    } else if (bss.authentication_type ==
+                   WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                 WSC::eWscAuth::WSC_AUTH_SAE |
+                                 WSC::eWscAuth::WSC_AUTH_SAE_AKM24) &&
+               bss.additional_auth ==
+                   son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24) {
+        // WPA3 Personal Compatibility Mode:
+        // auth_type=0x0160 (WPA2-PSK + SAE AKM8 + SAE AKM24) + bit5=1.
+        // 2.4/5 GHz: WPA2-PSK in primary RSNE + SAE in Override1 + SAE-EXT-KEY in Override2.
+        // 6 GHz/MLD: SAE in primary RSNE + SAE-EXT-KEY in Override2.
+        LOG(DEBUG) << "WPA3 AKM8+AKM24 compatibility mode: VAP=" << vap_id
+                   << " freq_band=" << int(bss.freq_band);
+        wpa = 0x2;
         wpa_pairwise.assign("CCMP");
 
+        if (bss.encryption_type != WSC::eWscEncr::WSC_ENCR_AES) {
+            LOG(ERROR) << "Autoconfiguration: " << vap_id
+                       << " CCMP(AES) is required for WPA3 compatibility";
+            return false;
+        }
+
+        if (bss.network_key.length() < 8 || bss.network_key.length() > 64) {
+            LOG(ERROR) << "Autoconfiguration: " << vap_id << " invalid network key length "
+                       << bss.network_key.length();
+            return false;
+        }
+        wpa_passphrase.assign(bss.network_key);
+
+        if (bss.freq_band == beerocks::eFreqType::FREQ_6G) {
+            // 6 GHz: SAE in primary RSNE + SAE-EXT-KEY in Override2 only
+            wpa_key_mgmt.assign("SAE");
+            ieee80211w.assign("2");
+            conf.set_create_value(vap_id, "rsn_override_key_mgmt_2", "SAE-EXT-KEY");
+            conf.set_create_value(vap_id, "rsn_override_pairwise_2", "GCMP-256");
+            conf.set_create_value(vap_id, "rsn_override_mfp_2", "2");
+        } else {
+            // 2.4/5 GHz: WPA2-PSK in primary RSNE + SAE in Override1 + SAE-EXT-KEY in Override2
+            wpa_key_mgmt.assign("WPA-PSK");
+            ieee80211w.assign("1");
+            conf.set_create_value(vap_id, "rsn_override_key_mgmt", "SAE");
+            conf.set_create_value(vap_id, "rsn_override_pairwise", "CCMP");
+            conf.set_create_value(vap_id, "rsn_override_mfp", "1");
+            conf.set_create_value(vap_id, "rsn_override_key_mgmt_2", "SAE-EXT-KEY");
+            conf.set_create_value(vap_id, "rsn_override_pairwise_2", "GCMP-256");
+            conf.set_create_value(vap_id, "rsn_override_mfp_2", "2");
+        }
+
+        disable_pmksa_caching.assign("0");
+        okc.assign("1");
+        wpa_disable_eapol_key_retries.assign("0");
+        sae_pwe.assign("2");
+    } else if (bss.authentication_type ==
+                   WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE) &&
+               bss.additional_auth ==
+                   son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_TRANSITION_AKM8) {
