From a0b92d0aefc518151e219d8aef802584cc457eb9 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:15:22 +0530
Subject: [PATCH 18/54] Added SAE security param and check for updating
 wps_independent in hostapd configuration

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp  | 9 +++++++--
 common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp | 5 ++++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index ad7f5f8f9..6b02d19be 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -405,6 +405,8 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
     // is similar to setting wpa_group_update_count=1 and
     std::string wpa_disable_eapol_key_retries;
 
+    std::string sae_pwe;
+
     // EasyMesh R1 only allows Open and WPA2 PSK auth&encryption methods.
     // Quote: A Multi-AP Controller shall set the Authentication Type attribute
     //        in M2 to indicate WPA2-Personal or Open System Authentication.
@@ -470,6 +472,7 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
         disable_pmksa_caching.assign("1");
         okc.assign("1");
         wpa_disable_eapol_key_retries.assign("0");
+        sae_pwe.assign("2");
     } else if (bss.authentication_type == WSC::eWscAuth::WSC_AUTH_SAE) {
         wpa = 0x2;
         wpa_key_mgmt.assign("SAE");
@@ -491,6 +494,7 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
         disable_pmksa_caching.assign("1");
         okc.assign("1");
         wpa_disable_eapol_key_retries.assign("0");
+        sae_pwe.assign("2");
     } else {
         LOG(ERROR) << "Autoconfiguration: " << vap_id << " invalid authentication type: "
                    << son::wireless_utils::wsc_to_bwl_authentication(bss.authentication_type,
@@ -507,6 +511,7 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
     conf.set_create_value(vap_id, "wpa_passphrase", wpa_passphrase);
     conf.set_create_value(vap_id, "disable_pmksa_caching", disable_pmksa_caching);
     conf.set_create_value(vap_id, "wpa_disable_eapol_key_retries", wpa_disable_eapol_key_retries);
+    conf.set_create_value(vap_id, "sae_pwe", sae_pwe);
     return true;
 }
 
@@ -1360,7 +1365,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
 
             conf.set_create_vap_value(vap_id, "ssid", bss_it.ssid);
             conf.set_create_vap_value(vap_id, "wps_state", bss_it.fronthaul ? "2" : "");
-            conf.set_create_vap_value(vap_id, "wps_independent", "0");
+            conf.set_create_vap_value(vap_id, "wps_independent", bss_it.fronthaul ? "1" : "");
             std::string multi_ap;
             if (bss_it.fronthaul) {
                 if (bss_it.backhaul) {
@@ -2211,7 +2216,7 @@ int ap_wlan_hal_nl80211::add_bss(std::string &ifname, son::wireless_utils::sBssI
     }
     conf.set_create_vap_value(vap_id, "wds_sta", "1");
     conf.set_create_vap_value(vap_id, "wps_state", bss_conf.fronthaul ? "2" : "");
-    conf.set_create_vap_value(vap_id, "wps_independent", "0");
+    conf.set_create_vap_value(vap_id, "wps_independent", bss_conf.fronthaul ? "1" : "");
     std::string multi_ap;
     if (bss_conf.fronthaul) {
         if (bss_conf.backhaul) {
diff --git a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
index 8d12792be..977e03c2a 100644
--- a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
@@ -151,6 +151,9 @@ bool mon_wlan_hal_nl80211::update_stations_stats(const std::string &vap_iface_na
                                                  const std::string &sta_mac, SStaStats &sta_stats,
                                                  bool is_read_unicast)
 {
+    std::string base_interface;
+    extractBase1Interface(vap_iface_name, base_interface);
+
     static struct nla_policy stats_policy[NL80211_STA_INFO_MAX + 1];
     stats_policy[NL80211_STA_INFO_INACTIVE_TIME] = {NLA_U32, 0, 0};
     stats_policy[NL80211_STA_INFO_RX_BYTES]      = {NLA_U32, 0, 0};
@@ -312,7 +315,7 @@ bool mon_wlan_hal_nl80211::update_stations_stats(const std::string &vap_iface_na
 
             return true;
         },
-        vap_iface_name);
+        base_interface);
 
     if (!ret) {
         LOG(ERROR) << "Failed updating stats for station: " << sta_mac;
-- 
