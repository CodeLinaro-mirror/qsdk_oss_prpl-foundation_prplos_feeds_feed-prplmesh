 controller/nbapi/odl/radio.odl.in             | 13 ++--
 controller/src/beerocks/master/db/db.cpp      | 62 ++++++++++++++-----
 controller/src/beerocks/master/db/db.h        |  3 +
 .../dynamic_channel_selection_r2_task.cpp     |  2 +
 5 files changed, 58 insertions(+), 26 deletions(-)

