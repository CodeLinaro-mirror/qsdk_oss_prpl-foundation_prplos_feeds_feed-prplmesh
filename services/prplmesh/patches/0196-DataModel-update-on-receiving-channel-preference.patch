                         }
+
+                        /* Vendor event: raised when channel preference report received */
+                        object OpClassPreference {
+                        }
                     }
 
                     /* Update all unassociated stations stats, from all agents and all radios */
diff --git a/controller/nbapi/odl/radio.odl.in b/controller/nbapi/odl/radio.odl.in
