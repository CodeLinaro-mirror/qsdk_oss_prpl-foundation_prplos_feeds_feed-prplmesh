--- a/controller/nbapi/odl/radio.odl.in
+++ b/controller/nbapi/odl/radio.odl.in
@@ -315,10 +315,10 @@
         }
 
         /* Channel preference reported by the agent for this radio */
-        %read-only object ChannelPreference [] {
-            counted with ChannelPreferenceNumberOfEntries;
+        %read-only object OpClassPreference [] {
+            counted with OpClassPreferenceNumberOfEntries;
 
-            %read-only uint32 OperatingClass = 0 {
+            %read-only uint32 OpClass = 0 {
                 on action validate call check_range [0, 255];
             }
             %read-only uint32 Preference = 0 {
@@ -328,12 +328,7 @@
                 on action validate call check_range [0, 15];
             }
 
-            %read-only object Channel [] {
-                counted with ChannelNumberOfEntries;
-                %read-only uint32 Channel = 0 {
-                    on action validate call check_range [0, 255];
-                }
-            }
+            %read-only string ChannelList = "";
         }
 
     }
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
