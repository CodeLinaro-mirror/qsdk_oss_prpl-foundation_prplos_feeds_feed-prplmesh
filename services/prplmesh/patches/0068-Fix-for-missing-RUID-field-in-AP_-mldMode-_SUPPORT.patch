From: Aryan Khare <aryakhar@qti.qualcomm.com>
Date: Fri, 6 Feb 2026 15:44:42 +0530
Subject: [PATCH 07/10] Fix for missing RUID field in AP_<mldMode>_SUPPORT
 field in Early AP Cap Report Message

Signed-off-by: Aryan Khare <aryakhar@qti.qualcomm.com>
---
 .../slave/tasks/capability_reporting_task.cpp    | 16 ++++------------
 1 file changed, 4 insertions(+), 12 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
index 3cbf66545..595e77950 100644
--- a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
+++ b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
@@ -286,9 +286,7 @@ bool CapabilityReportingTask::add_wifi7_agent_capabilities_tlv(ieee1905_1::CmduM
                     auto ap_str_config(radio_ap_capabilities->create_str_config());
 
                     ap_str_config->frequency_separation().freq_separation = 0;
-                    if (ap_str_config->frequency_separation().freq_separation) {
-                        ap_str_config->ruid() = radio2->front.iface_mac;
-                    }
+                    ap_str_config->ruid() = radio2->front.iface_mac;
 
                     if (!radio_ap_capabilities->add_str_config(ap_str_config)) {
                         LOG(ERROR) << "add_str_config() failed in tlvWifi7AgentCapabilities";
@@ -308,9 +306,7 @@ bool CapabilityReportingTask::add_wifi7_agent_capabilities_tlv(ieee1905_1::CmduM
                     auto ap_nstr_config(radio_ap_capabilities->create_nstr_config());
 
