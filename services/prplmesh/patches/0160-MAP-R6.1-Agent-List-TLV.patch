 #include <tlvf/wfa_map/tlvApExtendedMetrics.h>
@@ -1959,6 +1960,17 @@ bool Controller::handle_cmdu_1905_autoconfiguration_WSC(const sMacAddr &src_mac,
     agent->device_info.serial_number      = m1->serial_number();
     database.dm_set_profile1_device_info(*agent);
 
+    // Per EasyMesh R6.1 §17.2.77: after successful onboarding via 1905 PBC (WSC), the
+    // Controller shall send an Agent List message (0x8035) with the Agent List TLV (0xD5)
+    // to the newly enrolled agent and to all other existing agents.
+    // The entry for the newly onboarded agent carries:
+    //   - Multi-AP Profile: value from the Multi-AP Profile TLV received (or Profile-1 default)
+    //   - Security: 1905 Security not enabled
+    if (!son_actions::send_agent_list_to_all_agents(database, cmdu_tx, al_mac)) {
+        LOG(WARNING) << "Failed to send Agent List message after onboarding agent " << al_mac;
+        // Non-fatal: onboarding itself succeeded; continue.
+    }
+
     return true;
 }
 
