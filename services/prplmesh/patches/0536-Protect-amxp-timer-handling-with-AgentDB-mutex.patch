From 47146a8365a9835da44cf97b5df17838021f1295 Mon Sep 17 00:00:00 2001
From: Jain Roy <jambi@qti.qualcomm.com>
Date: Tue, 13 Oct 2026 09:55:51 +0530
Subject: [PATCH] Protect amxp timer handling with AgentDB mutex

Signed-off-by: Jain Roy <jambi@qti.qualcomm.com>
---
 agent/src/beerocks/slave/beerocks_agent_main.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/beerocks_agent_main.cpp b/agent/src/beerocks/slave/beerocks_agent_main.cpp
index 10c474be2..e7bcaa4db 100644
--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -95,11 +95,13 @@ static void handle_signal()
     }
 #ifdef ENABLE_NBAPI
     // Handle SIGALRM signal indicating that one of amxp's timers is expired.
-    case SIGALRM:
+    case SIGALRM: {
         LOG(INFO) << "LOG amxp Tik tak!";
+        std::lock_guard<std::recursive_mutex> lock(beerocks::AgentDB::mutex());
         amxp_timers_calculate();
         amxp_timers_check();
         break;
+    }
 #endif //ENABLE_NBAPI
     default:
         LOG(WARNING) << "Unhandled Signal: '" << strsignal(s_signal) << "' Ignoring...";
-- 
2.34.1

