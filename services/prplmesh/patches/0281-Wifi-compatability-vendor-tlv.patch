+#
+---
+_namespace: WSC
+
+eWscWifiCompatMode:
+  _type: enum_class
+  _enum_storage: uint8_t
+  _comment: |
+    WiFi Compatibility Mode carried in the Airties Vendor Extension of WSC M2.
+
+    Derived from the UCI wireless wifi-device option "disable_11be":
+      disable_11be = 1  ->  WIFI_COMPAT_MODE_11AX  (Wi-Fi 6 / 802.11ax)
+      disable_11be = 0  ->  WIFI_COMPAT_MODE_11BE  (Wi-Fi 7 / 802.11be)
+      option absent     ->  WIFI_COMPAT_MODE_UNSET  (not included in M2)
+  WIFI_COMPAT_MODE_11AX: 0x00
+  WIFI_COMPAT_MODE_11BE: 0x01
+  # 2-254 = UNSPECIFIED
+  WIFI_COMPAT_MODE_UNSET: 0xFF
