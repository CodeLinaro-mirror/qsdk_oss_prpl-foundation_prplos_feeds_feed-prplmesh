+// RECEIVE side: Parse QCA WiFi Compatibility Mode TLV.
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_wifi_compat_mode_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaWifiCompatMode>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA WiFi Compat Mode TLV";
+        return nullptr;
+    }
+
+    uint8_t num_bss = tlv->num_bss();
+    LOG(INFO) << "Parsed QCA WiFi Compat Mode TLV with " << int(num_bss) << " BSS entries";
+    for (size_t i = 0; i < num_bss; i++) {
+        auto bss_entry_tuple = tlv->bss_entries(i);
+        if (!std::get<0>(bss_entry_tuple)) {
+            LOG(ERROR) << "Failed to get BSS entry " << i;
+            continue;
+        }
+        qca::cQcaBssEntry &bss_entry = std::get<1>(bss_entry_tuple);
+        uint8_t wifi_mode = bss_entry.wifi_mode();
+        std::string ssid(bss_entry.ssid(), bss_entry.ssid_length());
+        const char *mode_str =
+            (wifi_mode == 0x00) ? "11ax (Wi-Fi 6)" :
+            (wifi_mode == 0x01) ? "11be (Wi-Fi 7)" : "unknown";
+        LOG(DEBUG) << "  QCA WiFi Compat Mode: SSID='" << ssid
+                   << "' wifi_mode=0x" << std::hex << int(wifi_mode) << std::dec
+                   << " (" << mode_str << ")";
+    }
+    return tlv;
+}
+
