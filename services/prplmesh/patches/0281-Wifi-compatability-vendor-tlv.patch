+bool ApAutoConfigurationTask::handle_wifi_compat_mode_tlv(
+    ieee1905_1::CmduMessageRx &cmdu_rx, std::vector<sBssConfig> &bss_infos,
+    const std::string &radio_iface)
+{
+    auto wifi_compat_tlv = cmdu_rx.getClass<qca::tlvQcaWifiCompatMode>();
+    if (!wifi_compat_tlv) {
+        LOG(DEBUG) << "No tlvQcaWifiCompatMode TLV in AP_AUTOCONFIGURATION_WSC_MESSAGE"
+                   << " for radio " << radio_iface;
+        return true;
+    }
+
+    uint8_t num_bss = wifi_compat_tlv->num_bss();
+    LOG(INFO) << "Received tlvQcaWifiCompatMode VS TLV with "
+              << static_cast<int>(num_bss) << " BSS entries for radio " << radio_iface;
+
+    for (size_t i = 0; i < num_bss; i++) {
+        auto bss_entry_tuple = wifi_compat_tlv->bss_entries(i);
+        if (!std::get<0>(bss_entry_tuple)) {
+            LOG(ERROR) << "Failed to get BSS entry " << i;
+            continue;
+        }
+        qca::cQcaBssEntry &bss_entry = std::get<1>(bss_entry_tuple);
+        uint8_t wifi_mode    = bss_entry.wifi_mode();
+        std::string ssid(bss_entry.ssid(), bss_entry.ssid_length());
+
+        const char *mode_str =
+            (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX))
+                ? "11ax (Wi-Fi 6)"
+            : (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE))
+                ? "11be (Wi-Fi 7)"
+                : "unknown";
+        LOG(INFO) << "  WiFi Compat Mode: SSID='" << ssid
+                  << "' wifi_mode=0x" << std::hex << int(wifi_mode) << std::dec
+                  << " (" << mode_str << ")";
+
+        // Update wifi_compat_mode in bss_infos for matching SSID
+        for (auto &bss_info : bss_infos) {
+            if (bss_info.payload_config.ssid == ssid) {
+                bss_info.wifi_compat_mode = static_cast<WSC::eWscWifiCompatMode>(wifi_mode);
+                LOG(DEBUG) << "Updated wifi_compat_mode for SSID '" << ssid
+                           << "' to " << mode_str;
+                break;
+            }
+        }
+    }
+    return true;
+}
