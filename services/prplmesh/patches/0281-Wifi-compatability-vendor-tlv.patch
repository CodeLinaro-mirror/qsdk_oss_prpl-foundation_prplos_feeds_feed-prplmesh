diff --git a/framework/tlvf/yaml/tlvf/qca/tlvQcaWifiCompatMode.yaml b/framework/tlvf/yaml/tlvf/qca/tlvQcaWifiCompatMode.yaml
new file mode 100644
index 000000000..f12c378e8
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/qca/tlvQcaWifiCompatMode.yaml
@@ -0,0 +1,51 @@
+#
+---
+
+_namespace: qca
+_include:
+  {
+    tlvf/ieee_1905_1/sVendorOUI.h,
+    tlvf/qca/eQcaTlvTypeMap.h,
+  }
+
+# WiFi Compatibility Mode VS TLV
+# Sent as a separate IEEE 1905.1 Vendor Specific TLV (type 0x0B) in the
+# AP_AUTOCONFIGURATION_WSC_MESSAGE CMDU alongside the WSC M2 TLV.
+#
+# The controller reads the UCI wireless wifi-device option "disable_11be" for each
+# configured BSS and includes all BSSes with a known wifi_mode in a single TLV:
+#   disable_11be = 1  ->  wifi_mode = 0x00 (WIFI_COMPAT_MODE_11AX, 802.11ax / Wi-Fi 6)
+#   disable_11be = 0  ->  wifi_mode = 0x01 (WIFI_COMPAT_MODE_11BE, 802.11be / Wi-Fi 7)
+#   option absent     ->  BSS is omitted from the TLV
+#
+# Wire format:
+#   type(1B) | length(2B) | vendor_oui(3B) | tlv_id(2B) | num_bss(1B) |
+#   [ wifi_mode(1B) | ssid_length(1B) | ssid(N) ] * num_bss
+
+tlvQcaWifiCompatMode:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eQcaTlvTypeMap
+    _value_const: TLV_VENDOR_SPECIFIC
+  length: uint16_t
+  vendor_oui:
+    _type: sVendorOUI
+  tlv_id:
+    _type: uint16_t
+  num_bss:
+    _type: uint8_t
+    _length_var: True
+  bss_entries:
+    _type: cQcaBssEntry
+    _length: [ num_bss ]
+
+cQcaBssEntry:
+  _type: class
+  wifi_mode: uint8_t
+  ssid_length:
+    _type: uint8_t
+    _length_var: True
+  ssid:
+    _type: char
+    _length: [ ssid_length ]
