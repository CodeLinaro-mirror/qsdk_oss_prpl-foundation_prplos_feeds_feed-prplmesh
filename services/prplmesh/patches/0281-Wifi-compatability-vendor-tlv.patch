+
+/**
+ * @brief C-linkage wrapper to set QCA WiFi Compat Mode entries before add_vs_tlv().
+ *
+ * Called by the controller before invoking add_vs_tlv() for AP_AUTOCONFIGURATION_WSC_MESSAGE
+ * so that add_qca_wifi_compat_mode_tlv() can include the correct BSS entries.
+ *
+ * @param ssids     Array of SSID strings (null-terminated)
+ * @param modes     Array of wifi_mode values (0x00=11ax, 0x01=11be)
+ * @param count     Number of entries
+ */
+extern "C" void set_qca_wifi_compat_entries(const char **ssids, const uint8_t *modes, size_t count)
+{
+    if (!ssids || !modes || count == 0) {
+        qca::tlvf_qca_utils::set_wifi_compat_entries({});
+        return;
+    }
+    std::vector<qca::tlvf_qca_utils::sWifiCompatEntry> entries;
+    entries.reserve(count);
+    for (size_t i = 0; i < count; i++) {
+        qca::tlvf_qca_utils::sWifiCompatEntry entry;
+        entry.ssid      = ssids[i] ? ssids[i] : "";
+        entry.wifi_mode = modes[i];
+        entries.push_back(entry);
+    }
+    qca::tlvf_qca_utils::set_wifi_compat_entries(entries);
+}
