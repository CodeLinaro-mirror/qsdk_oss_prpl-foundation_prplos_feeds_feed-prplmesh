+// Per-invocation WiFi Compat Mode entries.
+std::vector<qca::tlvf_qca_utils::sWifiCompatEntry> tlvf_qca_utils::s_wifi_compat_entries;
+
+void tlvf_qca_utils::set_wifi_compat_entries(const std::vector<sWifiCompatEntry> &entries)
+{
+    s_wifi_compat_entries = entries;
+    LOG(DEBUG) << "QCA WiFi Compat Mode entries set: " << s_wifi_compat_entries.size() << " entry(ies)";
+}
+
+// SEND side: Add QCA WiFi Compatibility Mode TLV to outgoing message
+bool tlvf_qca_utils::add_qca_wifi_compat_mode_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    if (s_wifi_compat_entries.empty()) {
+        LOG(DEBUG) << "Skipping QCA WiFi Compat Mode TLV: no entries";
+        return true;
+    }
+
+    auto wifi_compat_tlv = cmdu_tx.addClass<qca::tlvQcaWifiCompatMode>();
+    if (!wifi_compat_tlv) {
+        LOG(ERROR) << "Failed to add tlvQcaWifiCompatMode to CMDU";
+        s_wifi_compat_entries.clear();
+        return false;
+    }
+
+    // Set QCA OUI (7F:03:00) and TLV ID
+    wifi_compat_tlv->vendor_oui().upper  = 0x7F;
+    wifi_compat_tlv->vendor_oui().middle = 0x03;
+    wifi_compat_tlv->vendor_oui().lower  = 0x00;
+    wifi_compat_tlv->tlv_id() = static_cast<uint16_t>(qca::eQcaTlVId::QCA_WIFI_COMPAT_MODE);
+
+    for (const auto &entry : s_wifi_compat_entries) {
+        auto bss_entry = wifi_compat_tlv->create_bss_entries();
+        if (!bss_entry) {
+            LOG(ERROR) << "Failed to create BSS entry in QCA tlvQcaWifiCompatMode"
+                       << " ssid=" << entry.ssid;
+            continue;
+        }
+        bss_entry->wifi_mode() = entry.wifi_mode;
+        if (!bss_entry->set_ssid(entry.ssid.c_str(), entry.ssid.size())) {
+            LOG(ERROR) << "Failed to set SSID in QCA tlvQcaWifiCompatMode"
+                       << " ssid=" << entry.ssid;
+            continue;
+        }
+        if (!wifi_compat_tlv->add_bss_entries(bss_entry)) {
+            LOG(ERROR) << "Failed to add BSS entry to QCA tlvQcaWifiCompatMode"
+                       << " ssid=" << entry.ssid;
+        } else {
+            LOG(DEBUG) << "QCA WiFi Compat Mode TLV: added BSS ssid=" << entry.ssid
+                       << " wifi_mode=0x" << std::hex << int(entry.wifi_mode) << std::dec
+                       << " (" << (entry.wifi_mode == 0x00 ? "11ax" : "11be") << ")";
+        }
+    }
+
+    LOG(INFO) << "Added QCA WiFi Compat Mode TLV (OUI=7F:03:00) with "
+              << int(wifi_compat_tlv->num_bss()) << " BSS entries";
+    s_wifi_compat_entries.clear();
+    return true;
+}
