@@ -0,0 +1,46 @@
+#
+---
+_namespace: wfa_map
+
+# Neighbor Information Reporting Policy TLV
+# Wi-Fi EasyMesh Specification 6.1, Section 17.2.110, Table 133
+# TLV Type: 0xEA (TLV_WIFI8_NEIGHBOR_INFORMATION_REPORTING_POLICY)
+#
+# Wire format (tlvValue):
+#   - flags      : 1 octet
+#                    bit 7 = BSSID_valid (0=not valid, 1=valid)
+#                    bit 6 = report_neighbor_bBSS_info (0=disabled, 1=enabled)
+#                            valid only when BSSID_valid=0
+#                    bit 5 = report_neighbor_fBSS_info (0=disabled, 1=enabled)
+#                            valid only when BSSID_valid=0
+#                    bits 4-0 = reserved
+#   - num_bssid  : 1 octet  - Number of BSSIDs included (0 if BSSID_valid=0)
+#   - bssid_list : 6*N octets - BSSID entries (omitted if num_bssid=0)
+#
+# When BSSID_valid=0 (bit7=0):
+#   The reporting policy applies to all BSSes on the agent.
+#   num_bssid must be set to 0 and bssid_list is omitted.
+#   Bits 6 and 5 control whether bBSS and fBSS neighbor info is reported.
+#
+# When BSSID_valid=1 (bit7=1):
+#   The reporting policy applies only to the BSSes listed in bssid_list.
+#   Bits 6 and 5 are not valid (ignored).
+
+tlvWifi8NeighborInformationReportingPolicy:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_WIFI8_NEIGHBOR_INFORMATION_REPORTING_POLICY
+  length: uint16_t
+  flags:
+    _type: uint8_t
+    _comment: "bit7=BSSID_valid, bit6=report_neighbor_bBSS_info, bit5=report_neighbor_fBSS_info, bits4-0=reserved"
+  num_bssid:
+    _type: uint8_t
+    _length_var: True
+    _comment: "Number of BSSIDs included in this TLV. Set to 0 if BSSID_valid (bit7 of flags) = 0"
+  bssid_list:
+    _type: sMacAddr
+    _length: [ num_bssid ]
+    _comment: "BSSID entries, present num_bssid times. Field is omitted when num_bssid=0"
\ No newline at end of file
