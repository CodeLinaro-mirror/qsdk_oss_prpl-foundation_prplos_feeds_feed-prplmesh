From 42f436758c03aad192628cb6498bac29c099e335 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Fri, 6 Nov 2026 10:05:06 +0530
Subject: [PATCH] Fix for beerocks fronthaul crash in set powersaver mode

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index baf6d387d..1ed7bd054 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -3380,6 +3380,13 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             LOG(ERROR) << "addClass cACTION_APMANAGER_RADIO_POWERSAVE_ENABLE_REQUEST failed";
             return;
         }
+        // The HAL nl80211 socket is only created once the HAL is attached. Powersave is driven
+        // through nl80211, so a request arriving earlier (or after detach) cannot be served.
+        if (m_state != eApManagerState::ATTACHED && m_state != eApManagerState::OPERATIONAL) {
+            LOG(ERROR) << "Powersave enable request while HAL is not attached, state="
+                       << int(m_state.cur) << ", ignoring";
+            return;
+        }
         const bool force = request->force();
         LOG(DEBUG) << "Powersave enable request force=" << force;
         if (!ap_wlan_hal->powersave_enable(true, force)) {
@@ -3396,6 +3403,18 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             LOG(ERROR) << "addClass cACTION_APMANAGER_RADIO_POWERSAVE_DISABLE_REQUEST failed";
             return;
         }
+        // Deliberately NOT guarded with an "HAL attached" state check (unlike the enable path,
+        // which crashes in set_wsi_bypass_device -> send_nl80211_msg on a NULL nl80211 socket).
+        // Returning early here would also skip arming m_powersave_disable_wait_until
+        // below, i.e. the 15 second wait before the first VAP credential/create operation, and
+        // VAP creation would then race powersave-disable. The disable flow is also not part of
+        // the crash backtrace. Do not re-add the check below as a "crash hardening" fix:
+        //
+        // if (m_state != eApManagerState::ATTACHED && m_state != eApManagerState::OPERATIONAL) {
+        //     LOG(ERROR) << "Powersave disable request while HAL is not attached, state="
+        //                << int(m_state.cur) << ", ignoring";
+        //     return;
+        // }
         const bool force = request->force();
         LOG(DEBUG) << "Powersave disable request force=" << force;
         if (force || ap_wlan_hal->is_powersave_enabled()) {
-- 
2.34.1

