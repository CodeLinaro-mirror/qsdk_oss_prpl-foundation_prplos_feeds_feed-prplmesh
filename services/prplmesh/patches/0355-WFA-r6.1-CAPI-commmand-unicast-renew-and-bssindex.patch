From f94cd3d6ba782522ed8bcbb8510155069aa05cf0 Mon Sep 17 00:00:00 2001
From: athitia prakash <athiprak@qti.qualcomm.com>
Date: Thu, 20 Aug 2026 00:08:12 +0530
Subject: [PATCH] WFA-r6.1 CAPI commmand unicast renew and bssindex

Signed-off-by: athitia prakash <athiprak@qti.qualcomm.com>
---
 .../src/beerocks/slave/agent_ucc_listener.cpp | 33 +++++++++++++++++++
 .../bcl/source/beerocks_ucc_listener.cpp      | 25 +++++++++++++-
 2 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/agent_ucc_listener.cpp b/agent/src/beerocks/slave/agent_ucc_listener.cpp
index 021ccea08..30aaacf5d 100644
--- a/agent/src/beerocks/slave/agent_ucc_listener.cpp
+++ b/agent/src/beerocks/slave/agent_ucc_listener.cpp
@@ -137,6 +137,39 @@ bool agent_ucc_listener::handle_dev_get_param(std::unordered_map<std::string, st
 
         value = tlvf::mac_to_string(mac_value);
         return true;
+    }else if (parameter == "bss_index") {
+        // Returns the VAP index (0..IFACE_TOTAL_VAPS-1) of the BSS matching the given ruid
+        // and ssid. The index is the position in the radio's front.bssids[] array, which
+        // maps directly to the VAP interface index on the agent (e.g. wlan0.0, wlan0.1, ...).
+        if (params.find("ruid") == params.end()) {
+            value = "missing ruid";
+            return false;
+        }
+        if (params.find("ssid") == params.end()) {
+            value = "missing ssid";
+            return false;
+        }
+        auto ruid = tlvf::mac_from_string(params["ruid"]);
+        auto ssid = params["ssid"];
+
+        auto radio = db->get_radio_by_mac(ruid, AgentDB::eMacType::RADIO);
+        if (!radio) {
+            LOG(ERROR) << "No radio with ruid '" << params["ruid"] << "' found!";
+            value = "radio not found for ruid " + params["ruid"];
+            return false;
+        }
+
+        for (size_t idx = 0; idx < radio->front.bssids.size(); ++idx) {
+            if (radio->front.bssids[idx].ssid == ssid) {
+                value = std::to_string(idx);
+                return true;
+            }
+        }
+
+        LOG(ERROR) << "bssindex not found for ruid '" << params["ruid"] << "' ssid '" << ssid
+                   << "'";
+        value = "bssindex not found for ruid " + params["ruid"] + " ssid " + ssid;
+        return false;
     }
     value = "parameter " + parameter + " not supported";
     return false;
diff --git a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
index 9f6cee354..5a23e09ea 100644
--- a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
+++ b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
@@ -628,10 +628,29 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
             break;
         }
 
+        // Helper lambda: clear relay_indicator for unicast transmission
+        auto apply_unicast_relay_flag = [&](std::shared_ptr<ieee1905_1::cCmduHeader> hdr) {
+            if (!hdr) {
+                return;
+            }
+            auto it = params.find("transmissiontype");
+            if (it == params.end()) {
+                return;
+            }
+            std::string tx_type = it->second;
+            std::transform(tx_type.begin(), tx_type.end(), tx_type.begin(), ::tolower);
+            if (tx_type == "unicast") {
+                LOG(DEBUG) << "Unicast TransmissionType: clearing relay_indicator";
+                hdr->flags().relay_indicator = 0;
+            }
+        };
+
         // Check if CMDU message type has prepared CMDU which can be loaded
         if (tlv_hex_list.empty() && m_cmdu_tx.is_finalized() &&
             m_cmdu_tx.getMessageType() == ieee1905_1::eMessageType(message_type)) {
             m_cmdu_tx.setMessageId(g_mid); // force mid
+            // For unicast, clear relay_indicator on the already-finalized CMDU header
+            apply_unicast_relay_flag(m_cmdu_tx.load());
             LOG(DEBUG) << "Send preset cmdu with mid " << std::hex << g_mid;
             if (!send_cmdu_to_destination(m_cmdu_tx, dest_alid)) {
                 LOG(ERROR) << "Failed to send CMDU";
@@ -644,7 +663,8 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
             // CMDU was not loaded from prepared buffer, and need to be created manually, and
             // use TLV data from the command (if exists)
             m_cmdu_tx.reset();
-            if (!m_cmdu_tx.create(g_mid, ieee1905_1::eMessageType(message_type))) {
+            auto cmdu_header = m_cmdu_tx.create(g_mid, ieee1905_1::eMessageType(message_type));
+            if (!cmdu_header) {
                 LOG(ERROR) << "cmdu creation of type 0x" << message_type_str << ", has failed";
                 reply_ucc(fd, eWfaCaStatus::ERROR, err_internal);
                 break;
@@ -667,6 +687,9 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
                 break;
             }
 
+            // For unicast, clear relay_indicator before sending
+            apply_unicast_relay_flag(cmdu_header);
+
             LOG(INFO) << "Send TLV CMDU " << message_type << " with " << tlv_hex_list.size()
                       << " TLVs, length " << m_cmdu_tx.getMessageLength();
 
-- 
2.34.1

