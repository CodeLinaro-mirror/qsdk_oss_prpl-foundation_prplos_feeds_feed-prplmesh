@@ -2773,6 +2778,96 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
     switch (event) {
 
     case Event::AP_MGMT_FRAME_RECEIVED: {
+        // Handle BEACON-RESP-RX events (MLO case where AP-MGMT-FRAME-RECEIVED is not sent).
+        // In MLO mode, hostapd sends individual BEACON-RESP-RX events instead of a single
+        // AP-MGMT-FRAME-RECEIVED containing the full Radio Measurement Report frame.
+        // We reconstruct the 802.11 action frame body so the ap_manager MGMT_Frame handler
+        // can process it via the existing RADIO_MEASUREMENT_REPORT path.
+        if (opcode == "BEACON-RESP-RX") {
+            // After map_event_obj_parser, BEACON-RESP-RX fields are stored as:
+            //   _mac  = sta_mac
+            //   _arg0 = dialog_token
+            //   _arg1 = rep_mode (hex string, e.g. "00")
+            //   _arg2 = hex_data (op_class + channel + start_time(8) + duration(2) +
+            //                     phy_type + rcpi + rsni + bssid(6) + ant_id + parent_tsf(4))
+            auto sta_mac_it = parsed_obj.find(bwl::EVENT_KEYLESS_PARAM_MAC);
+            auto arg0_it    = parsed_obj.find("_arg0");
+            auto arg1_it    = parsed_obj.find("_arg1");
+            auto arg2_it    = parsed_obj.find("_arg2");
+
+            if (sta_mac_it == parsed_obj.end() || arg0_it == parsed_obj.end() ||
+                arg1_it == parsed_obj.end() || arg2_it == parsed_obj.end()) {
+                LOG(ERROR) << "BEACON-RESP-RX: missing required fields in parsed_obj";
+                return true; // non-fatal, skip this event
+            }
+
+            const std::string &sta_mac_str = sta_mac_it->second;
+            int dialog_token =
+                beerocks::string_utils::stoi(arg0_it->second);
+            uint8_t rep_mode =
+                static_cast<uint8_t>(std::stoi(arg1_it->second, nullptr, 16));
+            const std::string &hex_data = arg2_it->second;
+
+            // Decode hex_data to raw bytes
+            auto raw_data =
+                beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(hex_data);
+
+            // Minimum beacon report data:
+            //   op_class(1)+channel(1)+start_time(8)+duration(2)+phy_type(1)+
+            //   rcpi(1)+rsni(1)+bssid(6)+ant_id(1)+parent_tsf(4) = 26 bytes
+            constexpr size_t MIN_BEACON_DATA_LEN = 26;
+            if (raw_data.size() < MIN_BEACON_DATA_LEN) {
+                LOG(ERROR) << "BEACON-RESP-RX: hex_data too short (" << raw_data.size()
+                           << " bytes, need " << MIN_BEACON_DATA_LEN << ")";
+                return true;
+            }
+
+            // Reconstruct 802.11 Radio Measurement Report action frame body:
+            //   [category=5][code=1][dialog_token]       <- 3-byte action frame header
+            //   [element_id=39][element_length]          <- Measurement Report IE header
+            //   [meas_token=0][rep_mode][meas_type=5]    <- 3 bytes (Beacon type)
+            //   [raw_data]                               <- op_class...parent_tsf
+            std::vector<uint8_t> frame_body;
+            frame_body.reserve(3 + 2 + 3 + raw_data.size());
+
+            // Action frame header (Radio Measurement category=5, Measurement Report code=1)
+            frame_body.push_back(5); // category: Radio Measurement
+            frame_body.push_back(1); // action code: Measurement Report
+            frame_body.push_back(static_cast<uint8_t>(dialog_token));
+
+            // Measurement Report IE
+            frame_body.push_back(39); // element_id: Measurement Report (0x27)
+            frame_body.push_back(
+                static_cast<uint8_t>(3 + raw_data.size())); // element_length
+            frame_body.push_back(0);        // measurement_token
+            frame_body.push_back(rep_mode); // rep_mode from event
+            frame_body.push_back(5);        // measurement_type: Beacon
+            frame_body.insert(frame_body.end(), raw_data.begin(), raw_data.end());
+
+            // Build the MGMT_Frame notification
+            auto mgmt_frame  = std::make_shared<sMGMT_FRAME_NOTIFICATION>();
+            mgmt_frame->mac  = tlvf::mac_from_string(sta_mac_str);
+            mgmt_frame->type = eManagementFrameType::RADIO_MEASUREMENT_REPORT;
+            mgmt_frame->data = frame_body;
+
+            // Extract BSSID from raw_data at offset 15:
+            //   op_class(1)+channel(1)+start_time(8)+duration(2)+phy_type(1)+rcpi(1)+rsni(1) = 15
+            if (raw_data.size() >= 21) {
+                char bssid_buf[18];
+                snprintf(bssid_buf, sizeof(bssid_buf), "%02x:%02x:%02x:%02x:%02x:%02x",
+                         raw_data[15], raw_data[16], raw_data[17], raw_data[18], raw_data[19],
+                         raw_data[20]);
+                mgmt_frame->bssid = tlvf::mac_from_string(bssid_buf);
+            }
+
+            LOG(DEBUG) << "BEACON-RESP-RX: reconstructed RADIO_MEASUREMENT_REPORT"
+                       << " sta=" << sta_mac_str << " bssid=" << mgmt_frame->bssid
+                       << " dialog_token=" << dialog_token;
+
+            event_queue_push(Event::MGMT_Frame, mgmt_frame);
+            return true;
+        }
+
         if (parsed_obj.find("buf") == parsed_obj.end() || parsed_obj["buf"].empty()) {
             LOG(ERROR) << "Management frame without data!";
             return false;
