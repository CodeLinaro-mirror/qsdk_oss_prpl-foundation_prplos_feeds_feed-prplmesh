+bool db::dm_trigger_beacon_measurement_event(const sMacAddr &sta_mac,
+                                             const std::string &measurement_dm_path,
+                                             const sMacAddr &bss_mac, const sMacAddr &radio_mac,
+                                             const sMacAddr &agent_al_mac, const sMacAddr &target_bss,
+                                             uint8_t rcpi, uint8_t channel, uint8_t opClass)
+{
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    const std::string sta_mac_str    = tlvf::mac_to_string(sta_mac);
+    const std::string bss_mac_str    = tlvf::mac_to_string(bss_mac);
+    const std::string target_bss_str = tlvf::mac_to_string(target_bss);
+    const std::string radio_mac_str  = tlvf::mac_to_string(radio_mac);
+    const std::string al_mac_str     = tlvf::mac_to_string(agent_al_mac);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", sta_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", measurement_dm_path.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "BSSID", bss_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "RadioMAC", radio_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "ALMAC", al_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "TARGETBSS", target_bss_str.c_str());
+    amxc_var_add_key(uint32_t, &event_data, "RCPI", rcpi);
+    amxc_var_add_key(uint32_t, &event_data, "CHANNEL", channel);
+    amxc_var_add_key(uint32_t, &event_data, "OPCLASS", opClass);
+
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.BeaconMeasurement";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "Failed to trigger BeaconMeasurement at " << vendor_event_obj
+                   << " sta_mac=" << sta_mac_str << " dm_path=" << measurement_dm_path
+                   << " bss_mac=" << bss_mac_str << " radio_mac=" << radio_mac_str
+                   << " al_mac=" << al_mac_str;
+    } else {
+        LOG(DEBUG) << "Triggered BeaconMeasurement sta_mac=" << sta_mac_str
+                   << " dm_path=" << measurement_dm_path << " bss_mac=" << bss_mac_str
+                   << " radio_mac=" << radio_mac_str << " al_mac=" << al_mac_str;
+    }
+    amxc_var_clean(&event_data);
+    return ok;
+}
