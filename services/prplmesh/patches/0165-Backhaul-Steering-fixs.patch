     auto beacon_response_tlv = cmdu_rx.getClass<wfa_map::tlvBeaconMetricsResponse>();
     if (beacon_response_tlv) {
         auto sta_mac = beacon_response_tlv->associated_sta_mac();
-        LOG(DEBUG) << "Processing beacon metrics for STA " << sta_mac;
+        LOG(DEBUG) << "Processing beacon metrics for STA " << sta_mac
+                   << " num_reports=" << beacon_response_tlv->measurement_report_list_length();
+
+        // Use the message ID as a proxy for the dialog token so that back-to-back
+        // queries (each with a different mid) cause stale MeasurementReport instances
+        // to be cleared before new ones are written.  The 1905 Beacon Metrics Response
+        // TLV does not carry the 802.11 dialog token, so mid is the best available
+        // discriminator.  Ensure the value is never 0 (0 is the uninitialized default
+        // in m_dialog_tokens and would prevent the clear from ever firing).
+        uint8_t dialog_token = static_cast<uint8_t>(mid & 0xFF);
+        if (dialog_token == 0) {
+            dialog_token = 0xFF;
+        }
 
