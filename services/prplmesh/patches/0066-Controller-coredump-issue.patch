 .../src/beerocks/master/db/network_map.cpp    | 40 +++++++++++--------
 1 file changed, 23 insertions(+), 17 deletions(-)

diff --git a/controller/src/beerocks/master/db/network_map.cpp b/controller/src/beerocks/master/db/network_map.cpp
index 0a3533fc7..0891c59fe 100644
--- a/controller/src/beerocks/master/db/network_map.cpp
+++ b/controller/src/beerocks/master/db/network_map.cpp
@@ -159,6 +159,9 @@ void network_map::send_bml_network_map_message(db &database, int fd,
         }
     }
 
+    // vector to store agents data which have been inactive for more than 125 seconds
+    std::vector<sMacAddr> agents_to_remove;
+    
     // Fill the data for non-local agents
     for (const auto &agent_pair : database.m_agents) {
         const auto &agent = agent_pair.second;
@@ -173,9 +176,27 @@ void network_map::send_bml_network_map_message(db &database, int fd,
         }
 
         LOG(DEBUG) << "Processing Non-Local Agent: " << agent->al_mac;
+        // Check if agent should be removed
+        const auto agent_last_contacted = database.get_agent_last_contact_time(agent->al_mac);
+        const auto now = std::chrono::system_clock::now();
+        const auto inactive_duration = now - agent_last_contacted;
+        const auto inactive_threshold = std::chrono::seconds(125);
+
+        if (inactive_duration > inactive_threshold) {
+            LOG(INFO) << "Remove inactive data from database: " << agent->al_mac
+                << ", inactive for "
+                << std::chrono::duration_cast<std::chrono::seconds>(inactive_duration).count()
+                << " seconds";
+            agents_to_remove.push_back(agent->al_mac);
+        }
         process_agent(agent);
     }
 
+    for (const auto &mac : agents_to_remove) {
+        LOG(INFO) << "Removing inactive agent: " << mac;
+        database.remove_agent(mac);
+    }
+
     beerocks_header->actionhdr()->last() = 1;
     controller_ctx->send_cmdu(fd, cmdu_tx);
 }
@@ -315,23 +336,6 @@ std::ptrdiff_t network_map::fill_bml_agent_data(db &database, std::shared_ptr<Ag
         return 0;
     }
 
