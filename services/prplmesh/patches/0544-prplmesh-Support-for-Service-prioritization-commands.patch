+bool db::dm_set_service_prioritization(
+    const bool enabled,
+    const sMacAddr *target_al_mac,
+    const std::array<uint8_t, beerocks::message::DSCP_MAPPING_LIST_LENGTH> *dscp_mapping,
+    const wfa_map::tlvServicePrioritizationRule::sServicePrioritizationRule *bsp_rule,
+    const Agent::sServicePrioritization::sEnhancedSPRule *esp_rule,
+    const Agent::sServicePrioritization::sQSPRule *qsp_rule)
+{
+    if (!target_al_mac) {
+        return false;
+    }
+
+    const auto broadcast_al_mac = tlvf::mac_from_string(network_utils::WILD_MAC_STRING);
+    const bool is_network_wide = (*target_al_mac == broadcast_al_mac);
+
+    std::shared_ptr<Agent> agent;
+    if (!is_network_wide) {
+        agent = get_agent(*target_al_mac);
+        if (!agent) {
+            LOG(WARNING) << "No agent found matching target AL MAC";
+            return false;
+        }
+    }
+
+    auto &service_prioritization =
+        is_network_wide ? m_network_service_prioritization : agent->service_prioritization;
+
+    if (!enabled) {
+        if (bsp_rule) {
+            const auto existing_rule = service_prioritization.rules.find(bsp_rule->id);
+            if (existing_rule == service_prioritization.rules.end()) {
+                LOG(WARNING) << "Cannot delete unknown service prioritization rule id="
+                             << bsp_rule->id << " for target "
+                             << tlvf::mac_to_string(*target_al_mac);
+                return false;
+            }
+
+            // Keep the delete marker until the agent consumes it.
+            service_prioritization.rules[bsp_rule->id] = *bsp_rule;
+            service_prioritization.enhanced_rules.erase(bsp_rule->id);
+            service_prioritization.qsp_rules.erase(bsp_rule->id);
+        }
+        return true;
+    }
+
+    if (bsp_rule) {
+        // The supplied rule mode is authoritative. A BSP-only update must
+        // remove stale ESP/QSP extensions, and an ESP update must remove any
+        // stale QSP extension.
+        service_prioritization.rules[bsp_rule->id] = *bsp_rule;
+
+        if (!esp_rule) {
+            service_prioritization.enhanced_rules.erase(bsp_rule->id);
+        }
+        if (!qsp_rule) {
+            service_prioritization.qsp_rules.erase(bsp_rule->id);
+        }
+    }
+
+    if (esp_rule) {
+        if (!bsp_rule) {
+            LOG(ERROR) << "ESP rule provided without BSP rule";
+            return false;
+        }
+        if (service_prioritization.rules.count(bsp_rule->id) == 0) {
+            LOG(WARNING) << "Ignoring ESP rule id=" << bsp_rule->id
+                         << " because matching BSP rule was not configured";
+            return false;
+        }
+        service_prioritization.enhanced_rules[bsp_rule->id] = *esp_rule;
+    }
+
+    if (qsp_rule) {
+        if (!bsp_rule) {
+            LOG(ERROR) << "QSP rule provided without BSP rule";
+            return false;
+        }
+        if (service_prioritization.rules.count(bsp_rule->id) == 0) {
+            LOG(WARNING) << "Ignoring QSP rule id=" << bsp_rule->id
+                         << " because matching BSP rule was not configured";
+            return false;
+        }
+        service_prioritization.qsp_rules[bsp_rule->id] = *qsp_rule;
+    }
+
+    if (dscp_mapping) {
+        service_prioritization.dscp_mapping_table = *dscp_mapping;
+        service_prioritization.dscp_mapping_configured = true;
+    }
+
+    return true;
+}
+
+Agent::sServicePrioritization db::get_service_prioritization(const Agent &agent) const
+{
+    auto service_prioritization = agent.service_prioritization;
+
+    // Broadcast rules are applied to every agent. Network-wide entries are
+    // applied after agent-specific entries so the explicit broadcast scope wins
+    // if a rule ID is accidentally reused.
+    for (const auto &rule : m_network_service_prioritization.rules) {
+        service_prioritization.rules[rule.first] = rule.second;
+    }
+    for (const auto &rule : m_network_service_prioritization.enhanced_rules) {
+        service_prioritization.enhanced_rules[rule.first] = rule.second;
+    }
+    for (const auto &rule : m_network_service_prioritization.qsp_rules) {
+        service_prioritization.qsp_rules[rule.first] = rule.second;
+    }
+
+    if (m_network_service_prioritization.dscp_mapping_configured) {
+        service_prioritization.dscp_mapping_table =
+            m_network_service_prioritization.dscp_mapping_table;
+    }
+
+    return service_prioritization;
+}
+
+void db::clear_network_service_prioritization_removals()
+{
+    for (auto it = m_network_service_prioritization.rules.begin();
+         it != m_network_service_prioritization.rules.end();) {
+        if (!it->second.bits_field1.add_remove) {
+            m_network_service_prioritization.enhanced_rules.erase(it->first);
+            m_network_service_prioritization.qsp_rules.erase(it->first);
+            it = m_network_service_prioritization.rules.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void db::clear_agent_service_prioritization_removals(const sMacAddr &agent_al_mac)
+{
+    auto agent = get_agent(agent_al_mac);
+    if (!agent) {
+        return;
+    }
+
+    auto &service_prioritization = agent->service_prioritization;
+    for (auto it = service_prioritization.rules.begin();
+         it != service_prioritization.rules.end();) {
+        if (!it->second.bits_field1.add_remove) {
+            service_prioritization.enhanced_rules.erase(it->first);
+            service_prioritization.qsp_rules.erase(it->first);
+            it = service_prioritization.rules.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
