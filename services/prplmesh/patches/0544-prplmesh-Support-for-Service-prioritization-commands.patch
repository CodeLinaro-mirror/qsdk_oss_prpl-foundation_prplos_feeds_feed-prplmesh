+// RECEIVE side: Specific parser for Enhanced Service Prioritization TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_enhanced_sp_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaEnhancedSp>();
+    if (!tlv) {
+        LOG(ERROR) << "[SP][QCA][PARSE] Failed to parse QCA ESP TLV";
+        return nullptr;
+    }
+
+    LOG(DEBUG) << "[SP][QCA][PARSE] Parsed QCA ESP TLV rule_id=" << tlv->rule_id()
+               << " match_flags=0x"
+               << std::hex << get_flag_value(tlv->match_flags_0(), tlv->match_flags_1(),
+                                              tlv->match_flags_2(), tlv->match_flags_3())
+               << std::dec;
+    return tlv;
+}
+
+// RECEIVE side: Specific parser for QoS Service Prioritization TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_qsp_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaQSp>();
+    if (!tlv) {
+        LOG(ERROR) << "[SP][QCA][PARSE] Failed to parse QCA QSP TLV";
+        return nullptr;
+    }
+
+    LOG(DEBUG) << "[SP][QCA][PARSE] Parsed QCA QSP TLV rule_id=" << tlv->rule_id()
+               << " q_match_flags=0x"
+               << std::hex << get_flag_value(tlv->q_match_flags_0(), tlv->q_match_flags_1(),
+                                              tlv->q_match_flags_2(), tlv->q_match_flags_3())
+               << std::dec;
+    return tlv;
+}
