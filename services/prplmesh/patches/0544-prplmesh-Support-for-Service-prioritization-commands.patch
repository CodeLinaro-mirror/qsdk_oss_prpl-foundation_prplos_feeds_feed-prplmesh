+bool add_qca_esp_tlv(ieee1905_1::CmduMessageTx &cmdu_tx, uint32_t rule_id,
+                     const Agent::sServicePrioritization::sEnhancedSPRule &rule)
+{
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaEnhancedSp>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to add qca::tlvQcaEnhancedSp";
+        return false;
+    }
+
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+    tlv->tlv_id()     = static_cast<uint16_t>(qca::eQcaTlVId::QCA_ENHANCED_SP);
+    tlv->rule_id()    = rule_id;
+    const uint32_t match_flags = (rule.match_flags & ~ESP_ALWAYS_MATCH_BIT) |
+                                 (rule.always_match ? ESP_ALWAYS_MATCH_BIT : 0);
+    set_flag_bytes(match_flags, tlv->match_flags_0(), tlv->match_flags_1(),
+                   tlv->match_flags_2(), tlv->match_flags_3());
+
+    // extract individual bits to decide which optional fields to set
+    const bool match_up         = (rule.match_flags & ESP_MATCH_UP_BIT) != 0;
+    const bool match_source_mac = (rule.match_flags & ESP_MATCH_SOURCE_MAC_BIT) != 0;
+    const bool match_dst_mac    = (rule.match_flags & ESP_MATCH_DST_MAC_BIT) != 0;
+
+    if (match_up && !tlv->set_user_priority(rule.user_priority)) {
+      return false;
+    }
+    if (match_source_mac && !tlv->set_src_mac(rule.src_mac)) {
+      return false;
+    }
+    if (match_dst_mac && !tlv->set_dst_mac(rule.dst_mac)) {
+      return false;
+    }
+
+    return true;
+}
