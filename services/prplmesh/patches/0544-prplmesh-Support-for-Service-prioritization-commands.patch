+bool add_qca_qsp_tlv(ieee1905_1::CmduMessageTx &cmdu_tx, uint32_t rule_id,
+                     const Agent::sServicePrioritization::sQSPRule &rule)
+{
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaQSp>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to add qca::tlvQcaQSp";
+        return false;
+    }
+
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+    tlv->tlv_id()     = static_cast<uint16_t>(qca::eQcaTlVId::QCA_Q_SP);
+    tlv->rule_id()    = rule_id;
+    set_flag_bytes(rule.q_match_flags, tlv->q_match_flags_0(), tlv->q_match_flags_1(),
+                   tlv->q_match_flags_2(), tlv->q_match_flags_3());
+
+    // extract individual bits to decide which optional fields to set
+    const bool match_source_ipv4 =
+        (rule.q_match_flags & QSP_MATCH_SOURCE_IPV4_BIT) != 0;
+    const bool match_source_ipv6 =
+        (rule.q_match_flags & QSP_MATCH_SOURCE_IPV6_BIT) != 0;
+    const bool match_dst_ipv4 = (rule.q_match_flags & QSP_MATCH_DST_IPV4_BIT) != 0;
+    const bool match_dst_ipv6 = (rule.q_match_flags & QSP_MATCH_DST_IPV6_BIT) != 0;
+    const bool match_source_port =
+        (rule.q_match_flags & QSP_MATCH_SOURCE_PORT_BIT) != 0;
+    const bool match_dst_port = (rule.q_match_flags & QSP_MATCH_DST_PORT_BIT) != 0;
+    const bool match_protocol =
+        (rule.q_match_flags & QSP_MATCH_PROTOCOL_NUMBER_BIT) != 0;
+    const bool match_vlan_id = (rule.q_match_flags & QSP_MATCH_VLAN_ID_BIT) != 0;
+    const bool match_dscp = (rule.q_match_flags & QSP_MATCH_DSCP_BIT) != 0;
+
+    if (match_source_ipv4 && !tlv->set_source_ipv4_addr(rule.src_ipv4_addr)) {
+      return false;
+    }
+    if (match_source_ipv6 && !set_qca_qsp_source_ipv6_addr(*tlv, rule.src_ipv6_addr)) {
+      return false;
+    }
+    if (match_dst_ipv4 && !tlv->set_destination_ipv4_addr(rule.dst_ipv4_addr)) {
+      return false;
+    }
+    if (match_dst_ipv6 && !set_qca_qsp_destination_ipv6_addr(*tlv, rule.dst_ipv6_addr)) {
+      return false;
+    }
+    if (match_source_port && !tlv->set_source_port(rule.src_port)) {
+      return false;
+    }
+    if (match_dst_port && !tlv->set_destination_port(rule.dst_port)) {
+      return false;
+    }
+    if (match_protocol && !tlv->set_protocol_number(rule.protocol_number)) {
+      return false;
+    }
+    if (match_vlan_id && !tlv->set_vlan_id(rule.vlan_id)) {
+      return false;
+    }
+    if (match_dscp && !tlv->set_dscp(rule.dscp)) {
+      return false;
+    }
+
+    tlv->service_interval_dl() = rule.service_interval_dl;
+    tlv->service_interval_ul() = rule.service_interval_ul;
+    tlv->burst_size_dl()       = rule.burst_size_dl;
+    tlv->burst_size_ul()       = rule.burst_size_ul;
+
+    return true;
+}
