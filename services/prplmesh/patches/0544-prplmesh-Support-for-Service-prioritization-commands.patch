     auto dscp_mapping_table_tlv = cmdu_rx.getClass<wfa_map::tlvDscpMappingTable>();
@@ -364,6 +495,200 @@ void ServicePrioritizationTask::handle_service_prioritization_request(
                   db->service_prioritization.dscp_mapping_table.begin());
     }
 
+    std::unordered_set<uint32_t> esp_rules_in_request;
+    std::unordered_set<uint32_t> qsp_rules_in_request;
+
+    for (const auto &esp_tlv : cmdu_rx.getClassList<qca::tlvQcaEnhancedSp>()) {
+      if (!esp_tlv) {
+          continue;
+      }
+
+      const auto rule_id = esp_tlv->rule_id();
+      if (db->service_prioritization.rules.find(rule_id) ==
+          db->service_prioritization.rules.end()) {
+          LOG(WARNING) << "Ignoring QCA ESP TLV for unknown base SP rule id=" << rule_id;
+          continue;
+      }
+      if (remove_rule_ids.count(rule_id) != 0) {
+          LOG(DEBUG) << "Ignoring QCA ESP TLV because base SP rule is scheduled for removal, "
+                     << "rule id=" << rule_id;
+          continue;
+      }
+
+      AgentDB::sServicePrioritization::sEnhancedSPRule esp_rule;
+      const uint32_t flags  = get_flag_value(esp_tlv->match_flags_0(),
+                                             esp_tlv->match_flags_1(),
+                                             esp_tlv->match_flags_2(),
+                                             esp_tlv->match_flags_3());
+      esp_rule.match_flags  = flags;
+      esp_rule.always_match = (flags & ESP_ALWAYS_MATCH_BIT) != 0;
+
+      const bool match_up         = (flags & ESP_MATCH_UP_BIT) != 0;
+      const bool match_source_mac = (flags & ESP_MATCH_SOURCE_MAC_BIT) != 0;
+      const bool match_dst_mac    = (flags & ESP_MATCH_DST_MAC_BIT) != 0;
+
+      if (match_up) {
+        auto user_priority = esp_tlv->user_priority();
+        if (!user_priority) {
+          LOG(WARNING) << "QCA ESP TLV missing user_priority for rule id=" << rule_id;
+          continue;
+        }
+        esp_rule.user_priority = *user_priority;
+      }
+      if (match_source_mac) {
+        auto src_mac = esp_tlv->src_mac();
+        if (!src_mac) {
+          LOG(WARNING) << "QCA ESP TLV missing source MAC for rule id=" << rule_id;
+          continue;
+        }
+        esp_rule.src_mac = *src_mac;
+      }
+      if (match_dst_mac) {
+        auto dst_mac = esp_tlv->dst_mac();
+        if (!dst_mac) {
+          LOG(WARNING) << "QCA ESP TLV missing destination MAC for rule id=" << rule_id;
+          continue;
+        }
+        esp_rule.dst_mac = *dst_mac;
+      }
+
+      db->service_prioritization.enhanced_rules[rule_id] = esp_rule;
+      esp_rules_in_request.insert(rule_id);
+    }
+
+    for (const auto &qsp_tlv : cmdu_rx.getClassList<qca::tlvQcaQSp>()) {
+      if (!qsp_tlv) {
+        continue;
+      }
+
+      const auto rule_id = qsp_tlv->rule_id();
+      if (db->service_prioritization.rules.find(rule_id) ==
+          db->service_prioritization.rules.end()) {
+        LOG(WARNING) << "Ignoring QCA QSP TLV for unknown base SP rule id=" << rule_id;
+        continue;
+      }
+      if (remove_rule_ids.count(rule_id) != 0) {
+        LOG(DEBUG) << "Ignoring QCA QSP TLV because base SP rule is scheduled for removal, "
+                   << "rule id=" << rule_id;
+        continue;
+      }
+
+      AgentDB::sServicePrioritization::sQSPRule qsp_rule;
+      const uint32_t flags   = get_flag_value(qsp_tlv->q_match_flags_0(),
+                                              qsp_tlv->q_match_flags_1(),
+                                              qsp_tlv->q_match_flags_2(),
+                                              qsp_tlv->q_match_flags_3());
+      qsp_rule.q_match_flags = flags;
+
+      const bool match_source_ipv4 = (flags & QSP_MATCH_SOURCE_IPV4_BIT) != 0;
+      const bool match_source_ipv6 = (flags & QSP_MATCH_SOURCE_IPV6_BIT) != 0;
+      const bool match_dst_ipv4    = (flags & QSP_MATCH_DST_IPV4_BIT) != 0;
+      const bool match_dst_ipv6    = (flags & QSP_MATCH_DST_IPV6_BIT) != 0;
+      const bool match_source_port = (flags & QSP_MATCH_SOURCE_PORT_BIT) != 0;
+      const bool match_dst_port    = (flags & QSP_MATCH_DST_PORT_BIT) != 0;
+      const bool match_protocol    = (flags & QSP_MATCH_PROTOCOL_NUMBER_BIT) != 0;
+      const bool match_vlan_id     = (flags & QSP_MATCH_VLAN_ID_BIT) != 0;
+      const bool match_dscp        = (flags & QSP_MATCH_DSCP_BIT) != 0;
+
+      if (match_source_ipv4) {
+        auto source_ipv4_addr = qsp_tlv->source_ipv4_addr();
+        if (!source_ipv4_addr) {
+          LOG(WARNING) << "QCA QSP TLV missing source IPv4 for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.src_ipv4_addr = *source_ipv4_addr;
+      }
+      if (match_source_ipv6) {
+        if (!get_qca_qsp_source_ipv6_addr(*qsp_tlv, qsp_rule.src_ipv6_addr)) {
+          LOG(WARNING) << "QCA QSP TLV missing source IPv6 for rule id=" << rule_id;
+          continue;
+        }
+      }
+      if (match_dst_ipv4) {
+        auto destination_ipv4_addr = qsp_tlv->destination_ipv4_addr();
+        if (!destination_ipv4_addr) {
+          LOG(WARNING) << "QCA QSP TLV missing destination IPv4 for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.dst_ipv4_addr = *destination_ipv4_addr;
+      }
+      if (match_dst_ipv6) {
+        if (!get_qca_qsp_destination_ipv6_addr(*qsp_tlv, qsp_rule.dst_ipv6_addr)) {
+          LOG(WARNING) << "QCA QSP TLV missing destination IPv6 for rule id=" << rule_id;
+          continue;
+        }
+      }
+      if (match_source_port) {
+        auto source_port = qsp_tlv->source_port();
+        if (!source_port) {
+          LOG(WARNING) << "QCA QSP TLV missing source port for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.src_port = *source_port;
+      }
+      if (match_dst_port) {
+        auto destination_port = qsp_tlv->destination_port();
+        if (!destination_port) {
+          LOG(WARNING) << "QCA QSP TLV missing destination port for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.dst_port = *destination_port;
+      }
+      if (match_protocol) {
+        auto protocol_number = qsp_tlv->protocol_number();
+        if (!protocol_number) {
+          LOG(WARNING) << "QCA QSP TLV missing protocol number for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.protocol_number = *protocol_number;
+      }
+      if (match_vlan_id) {
+        auto vlan_id = qsp_tlv->vlan_id();
+        if (!vlan_id) {
+          LOG(WARNING) << "QCA QSP TLV missing VLAN ID for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.vlan_id = *vlan_id;
+      }
+      if (match_dscp) {
+        auto dscp = qsp_tlv->dscp();
+        if (!dscp) {
+          LOG(WARNING) << "QCA QSP TLV missing DSCP for rule id=" << rule_id;
+          continue;
+        }
+        qsp_rule.dscp = *dscp;
+      }
+
+      qsp_rule.service_interval_dl = qsp_tlv->service_interval_dl();
+      qsp_rule.service_interval_ul = qsp_tlv->service_interval_ul();
+      qsp_rule.burst_size_dl       = qsp_tlv->burst_size_dl();
+      qsp_rule.burst_size_ul       = qsp_tlv->burst_size_ul();
+
+      db->service_prioritization.qsp_rules[rule_id] = qsp_rule;
+      qsp_rules_in_request.insert(rule_id);
+    }
+
+    for (const auto &rule_id : base_rules_in_request) {
+        if (esp_rules_in_request.find(rule_id) == esp_rules_in_request.end()) {
+            db->service_prioritization.enhanced_rules.erase(rule_id);
+        }
+        if (qsp_rules_in_request.find(rule_id) == qsp_rules_in_request.end()) {
+            db->service_prioritization.qsp_rules.erase(rule_id);
+        }
+    }
+
+    // Request the SAL rule-classifier configuration via the AP manager
+    // for every changed base rule.
+    if (!request_sp_rule_config(base_rules_in_request)) {
+        LOG(WARNING) << "Failed requesting service prioritization rule configuration";
+    }
+
+    for (const auto &rule_id : remove_rule_ids) {
+        db->service_prioritization.rules.erase(rule_id);
+        db->service_prioritization.enhanced_rules.erase(rule_id);
+        db->service_prioritization.qsp_rules.erase(rule_id);
+    }
+
     if (!handle_qos_management_descriptors(cmdu_rx)) {
         LOG(ERROR) << "Failed handling QoS management descriptors";
     }
@@ -591,6 +916,101 @@ void ServicePrioritizationTask::gather_iface_details(
     }
 }
 
+bool ServicePrioritizationTask::request_sp_rule_config(
+    const std::unordered_set<uint32_t> &changed_rule_ids)
+{
+    if (changed_rule_ids.empty()) {
+        return true;
+    }
+
+    int ap_manager_fd = beerocks::net::FileDescriptor::invalid_descriptor;
+    auto &radio_managers = m_btl_ctx.m_radio_managers.get();
+    if (!radio_managers.empty()) {
+        ap_manager_fd = radio_managers.begin()->second.ap_manager_fd;
+    } else {
+        auto &zwdfs_radio = m_btl_ctx.m_radio_managers.get_zwdfs();
+        if (zwdfs_radio) {
+            ap_manager_fd = zwdfs_radio->second.ap_manager_fd;
+        }
+    }
+
+    if (ap_manager_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(WARNING) << "[SP][AGENT] No ap_manager connection available; skipping SAL rule "
+                     << "configuration for " << changed_rule_ids.size() << " rule(s)";
+        return false;
+    }
+
+    auto db = AgentDB::get();
+    for (const auto rule_id : changed_rule_ids) {
+        const auto base_rule_it = db->service_prioritization.rules.find(rule_id);
+        if (base_rule_it == db->service_prioritization.rules.end()) {
+            continue;
+        }
+        const auto &base = base_rule_it->second;
+
+        const auto esp_rule_it = db->service_prioritization.enhanced_rules.find(rule_id);
+        const auto qsp_rule_it = db->service_prioritization.qsp_rules.find(rule_id);
+        const auto *esp_rule =
+            (esp_rule_it != db->service_prioritization.enhanced_rules.end()) ? &esp_rule_it->second
+                                                                              : nullptr;
+        const auto *qsp_rule =
+            (qsp_rule_it != db->service_prioritization.qsp_rules.end()) ? &qsp_rule_it->second
+                                                                         : nullptr;
+
+        auto request = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_SP_RULE_CONFIG_REQUEST>(m_cmdu_tx);
+        if (!request) {
+            LOG(ERROR) << "[SP][AGENT] Failed building cACTION_APMANAGER_SP_RULE_CONFIG_REQUEST "
+                       << "for rule_id=" << rule_id;
+            continue;
+        }
+
+        request->rule_id()      = base.id;
+        request->add_del_rule() = base.bits_field1.add_remove;
+        request->precedence()   = base.precedence;
+        request->out_priority() = base.output;
+        request->always_match() = base.bits_field2.always_match ? 1 : 0;
+
+        request->has_esp() = esp_rule ? 1 : 0;
+        if (esp_rule) {
+            request->esp_match_flags() = esp_rule->match_flags;
+            request->user_priority()   = esp_rule->user_priority;
+            request->src_mac()         = esp_rule->src_mac;
+            request->dst_mac()         = esp_rule->dst_mac;
+        }
+
+        request->has_qsp() = qsp_rule ? 1 : 0;
+        if (qsp_rule) {
+            request->qsp_match_flags() = qsp_rule->q_match_flags;
+            request->src_ipv4_addr()   = qsp_rule->src_ipv4_addr;
+            request->dst_ipv4_addr()   = qsp_rule->dst_ipv4_addr;
+            std::copy_n(qsp_rule->src_ipv6_addr.data(), 16, request->src_ipv6_addr(0));
+            std::copy_n(qsp_rule->dst_ipv6_addr.data(), 16, request->dst_ipv6_addr(0));
+            request->src_port()            = qsp_rule->src_port;
+            request->dst_port()            = qsp_rule->dst_port;
+            request->protocol_number()     = qsp_rule->protocol_number;
+            request->vlan_id()             = qsp_rule->vlan_id;
+            request->dscp()                = qsp_rule->dscp;
+            request->service_interval_dl() = qsp_rule->service_interval_dl;
+            request->service_interval_ul() = qsp_rule->service_interval_ul;
+            request->burst_size_dl()       = qsp_rule->burst_size_dl;
+            request->burst_size_ul()       = qsp_rule->burst_size_ul;
+        }
+
+        LOG(DEBUG) << "[SP][AGENT] Sending SP_RULE_CONFIG_REQUEST rule_id=" << rule_id
+                  << " add_del_rule=" << static_cast<uint16_t>(base.bits_field1.add_remove)
+                  << " has_esp=" << (esp_rule != nullptr) << " has_qsp=" << (qsp_rule != nullptr);
+
+        if (!m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx)) {
+            LOG(WARNING) << "[SP][AGENT] Failed sending SP_RULE_CONFIG_REQUEST for rule_id="
+                         << rule_id;
+        }
+    }
+
+    return true;
+}
