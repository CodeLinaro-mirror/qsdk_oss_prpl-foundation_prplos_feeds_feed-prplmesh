+void set_flag_bytes(uint32_t flags, uint8_t &byte0, uint8_t &byte1, uint8_t &byte2,
+                    uint8_t &byte3)
+{
+    byte0 = static_cast<uint8_t>((flags >> 24) & 0xff);
+    byte1 = static_cast<uint8_t>((flags >> 16) & 0xff);
+    byte2 = static_cast<uint8_t>((flags >> 8) & 0xff);
+    byte3 = static_cast<uint8_t>(flags & 0xff);
+}
