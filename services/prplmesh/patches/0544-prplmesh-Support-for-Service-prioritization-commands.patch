+    case beerocks_message::ACTION_APMANAGER_SP_RULE_CONFIG_REQUEST: {
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_SP_RULE_CONFIG_REQUEST>();
