+           tlv.set_source_ipv6_addr_6(addr[6]) && tlv.set_source_ipv6_addr_7(addr[7]) &&
+           tlv.set_source_ipv6_addr_8(addr[8]) && tlv.set_source_ipv6_addr_9(addr[9]) &&
+           tlv.set_source_ipv6_addr_10(addr[10]) && tlv.set_source_ipv6_addr_11(addr[11]) &&
+           tlv.set_source_ipv6_addr_12(addr[12]) && tlv.set_source_ipv6_addr_13(addr[13]) &&
+           tlv.set_source_ipv6_addr_14(addr[14]) && tlv.set_source_ipv6_addr_15(addr[15]);
+}
+
+template <typename IPv6Address>
