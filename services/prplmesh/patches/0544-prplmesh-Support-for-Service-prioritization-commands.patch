+uint32_t get_flag_value(uint8_t byte0, uint8_t byte1, uint8_t byte2, uint8_t byte3)
+{
+    return (uint32_t(byte0) << 24) | (uint32_t(byte1) << 16) | (uint32_t(byte2) << 8) |
+           uint32_t(byte3);
+}
+
+// QCA ESP/QSP flags are vendor-wire flags, used to parse the TLVs received from the
+// Controller into AgentDB::service_prioritization.{enhanced_rules,qsp_rules}.
+constexpr uint32_t ESP_ALWAYS_MATCH_BIT           = 0x00000080;
+constexpr uint32_t ESP_MATCH_UP_BIT               = 0x00000020;
+constexpr uint32_t ESP_MATCH_UP_SENSE_BIT         = 0x00000010;
+constexpr uint32_t ESP_MATCH_SOURCE_MAC_BIT       = 0x00000008;
+constexpr uint32_t ESP_MATCH_SOURCE_MAC_SENSE_BIT = 0x00000004;
+constexpr uint32_t ESP_MATCH_DST_MAC_BIT          = 0x00000002;
+constexpr uint32_t ESP_MATCH_DST_MAC_SENSE_BIT    = 0x00000001;
+
+constexpr uint32_t QSP_MATCH_SOURCE_IPV4_BIT           = 0x80000000;
+constexpr uint32_t QSP_MATCH_SOURCE_IPV4_SENSE_BIT     = 0x40000000;
+constexpr uint32_t QSP_MATCH_DST_IPV4_BIT              = 0x20000000;
+constexpr uint32_t QSP_MATCH_DST_IPV4_SENSE_BIT        = 0x10000000;
+constexpr uint32_t QSP_MATCH_SOURCE_IPV6_BIT           = 0x08000000;
+constexpr uint32_t QSP_MATCH_SOURCE_IPV6_SENSE_BIT     = 0x04000000;
+constexpr uint32_t QSP_MATCH_DST_IPV6_BIT              = 0x02000000;
+constexpr uint32_t QSP_MATCH_DST_IPV6_SENSE_BIT        = 0x01000000;
+constexpr uint32_t QSP_MATCH_SOURCE_PORT_BIT           = 0x00800000;
+constexpr uint32_t QSP_MATCH_SOURCE_PORT_SENSE_BIT     = 0x00400000;
+constexpr uint32_t QSP_MATCH_DST_PORT_BIT              = 0x00200000;
+constexpr uint32_t QSP_MATCH_DST_PORT_SENSE_BIT        = 0x00100000;
+constexpr uint32_t QSP_MATCH_PROTOCOL_NUMBER_BIT       = 0x00080000;
+constexpr uint32_t QSP_MATCH_PROTOCOL_NUMBER_SENSE_BIT = 0x00040000;
+constexpr uint32_t QSP_MATCH_VLAN_ID_BIT               = 0x00020000;
+constexpr uint32_t QSP_MATCH_VLAN_ID_SENSE_BIT         = 0x00010000;
+constexpr uint32_t QSP_MATCH_DSCP_BIT                  = 0x00008000;
+constexpr uint32_t QSP_MATCH_DSCP_SENSE_BIT            = 0x00004000;
+
+  bool get_qca_qsp_source_ipv6_addr(qca::tlvQcaQSp &tlv, std::array<uint8_t, 16> &addr)
+  {
+    auto addr_0  = tlv.source_ipv6_addr_0();
+    auto addr_1  = tlv.source_ipv6_addr_1();
+    auto addr_2  = tlv.source_ipv6_addr_2();
+    auto addr_3  = tlv.source_ipv6_addr_3();
+    auto addr_4  = tlv.source_ipv6_addr_4();
+    auto addr_5  = tlv.source_ipv6_addr_5();
+    auto addr_6  = tlv.source_ipv6_addr_6();
+    auto addr_7  = tlv.source_ipv6_addr_7();
+    auto addr_8  = tlv.source_ipv6_addr_8();
+    auto addr_9  = tlv.source_ipv6_addr_9();
+    auto addr_10 = tlv.source_ipv6_addr_10();
+    auto addr_11 = tlv.source_ipv6_addr_11();
+    auto addr_12 = tlv.source_ipv6_addr_12();
+    auto addr_13 = tlv.source_ipv6_addr_13();
+    auto addr_14 = tlv.source_ipv6_addr_14();
+    auto addr_15 = tlv.source_ipv6_addr_15();
+
+    if (!addr_0 || !addr_1 || !addr_2 || !addr_3 || !addr_4 || !addr_5 || !addr_6 ||
+        !addr_7 || !addr_8 || !addr_9 || !addr_10 || !addr_11 || !addr_12 || !addr_13 ||
+        !addr_14 || !addr_15) {
+      return false;
+    }
+
+    addr[0]  = *addr_0;
+    addr[1]  = *addr_1;
+    addr[2]  = *addr_2;
+    addr[3]  = *addr_3;
+    addr[4]  = *addr_4;
+    addr[5]  = *addr_5;
+    addr[6]  = *addr_6;
+    addr[7]  = *addr_7;
+    addr[8]  = *addr_8;
+    addr[9]  = *addr_9;
+    addr[10] = *addr_10;
+    addr[11] = *addr_11;
+    addr[12] = *addr_12;
+    addr[13] = *addr_13;
+    addr[14] = *addr_14;
+    addr[15] = *addr_15;
+    return true;
+  }
+
+  bool get_qca_qsp_destination_ipv6_addr(qca::tlvQcaQSp &tlv, std::array<uint8_t, 16> &addr)
+  {
+    auto addr_0  = tlv.destination_ipv6_addr_0();
+    auto addr_1  = tlv.destination_ipv6_addr_1();
+    auto addr_2  = tlv.destination_ipv6_addr_2();
+    auto addr_3  = tlv.destination_ipv6_addr_3();
+    auto addr_4  = tlv.destination_ipv6_addr_4();
+    auto addr_5  = tlv.destination_ipv6_addr_5();
+    auto addr_6  = tlv.destination_ipv6_addr_6();
+    auto addr_7  = tlv.destination_ipv6_addr_7();
+    auto addr_8  = tlv.destination_ipv6_addr_8();
+    auto addr_9  = tlv.destination_ipv6_addr_9();
+    auto addr_10 = tlv.destination_ipv6_addr_10();
+    auto addr_11 = tlv.destination_ipv6_addr_11();
+    auto addr_12 = tlv.destination_ipv6_addr_12();
+    auto addr_13 = tlv.destination_ipv6_addr_13();
+    auto addr_14 = tlv.destination_ipv6_addr_14();
+    auto addr_15 = tlv.destination_ipv6_addr_15();
+
+    if (!addr_0 || !addr_1 || !addr_2 || !addr_3 || !addr_4 || !addr_5 || !addr_6 ||
+        !addr_7 || !addr_8 || !addr_9 || !addr_10 || !addr_11 || !addr_12 || !addr_13 ||
+        !addr_14 || !addr_15) {
+      return false;
+    }
+
+    addr[0]  = *addr_0;
+    addr[1]  = *addr_1;
+    addr[2]  = *addr_2;
+    addr[3]  = *addr_3;
+    addr[4]  = *addr_4;
+    addr[5]  = *addr_5;
+    addr[6]  = *addr_6;
+    addr[7]  = *addr_7;
+    addr[8]  = *addr_8;
+    addr[9]  = *addr_9;
+    addr[10] = *addr_10;
+    addr[11] = *addr_11;
+    addr[12] = *addr_12;
+    addr[13] = *addr_13;
+    addr[14] = *addr_14;
+    addr[15] = *addr_15;
+    return true;
+  }
+
+} //namespace
