+        cfg.rule_id       = request->rule_id();
+        cfg.add_del_rule  = request->add_del_rule();
+        cfg.precedence    = request->precedence();
+        cfg.out_priority  = request->out_priority();
+        cfg.always_match  = (request->always_match() != 0);
+
+        cfg.has_esp         = (request->has_esp() != 0);
+        cfg.esp_match_flags = request->esp_match_flags();
+        cfg.user_priority   = request->user_priority();
+        cfg.src_mac         = request->src_mac();
+        cfg.dst_mac          = request->dst_mac();
+
+        cfg.has_qsp         = (request->has_qsp() != 0);
+        cfg.qsp_match_flags = request->qsp_match_flags();
+        cfg.src_ipv4_addr   = request->src_ipv4_addr();
+        cfg.dst_ipv4_addr   = request->dst_ipv4_addr();
+        std::copy_n(request->src_ipv6_addr(0), cfg.src_ipv6_addr.size(),
+                   cfg.src_ipv6_addr.begin());
+        std::copy_n(request->dst_ipv6_addr(0), cfg.dst_ipv6_addr.size(),
+                   cfg.dst_ipv6_addr.begin());
+        cfg.src_port            = request->src_port();
+        cfg.dst_port            = request->dst_port();
+        cfg.protocol_number     = request->protocol_number();
+        cfg.vlan_id             = request->vlan_id();
+        cfg.dscp                = request->dscp();
+        cfg.service_interval_dl = request->service_interval_dl();
+        cfg.service_interval_ul = request->service_interval_ul();
+        cfg.burst_size_dl       = request->burst_size_dl();
+        cfg.burst_size_ul       = request->burst_size_ul();
+
+        LOG(DEBUG) << "SP_RULE_CONFIG: rule_id=" << cfg.rule_id
+                   << " add_del_rule=" << static_cast<uint16_t>(cfg.add_del_rule)
+                   << " has_esp=" << cfg.has_esp << " has_qsp=" << cfg.has_qsp;
+
+        if (!ap_wlan_hal->configure_sp_rule(cfg)) {
+            LOG(WARNING) << "configure_sp_rule failed for rule_id=" << cfg.rule_id;
+        }
+        break;
+    }
