+bool ApManager::should_send_beacon_metrics_response(const sBeaconMetricsResponse &response)
+{
+    // Always send if we have reports — any ap_manager that collected reports should send them
+    if (!response.beacon_report.empty()) {
+        return true;
+    }
+    // No reports: only the primary ap_manager sends the empty response (spec compliance)
+    // Non-primary ap_managers suppress the empty response to avoid duplicate 0-report responses
+    return response.is_primary;
+}
