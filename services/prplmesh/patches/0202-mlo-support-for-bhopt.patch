+void LinkMetricsCollectionTask::send_beacon_request_to_all_ap_managers(
+    const sMacAddr &sta_mac,
+    uint32_t timeout_ms,
+    const std::string &primary_iface_name)
+{
+    auto db = AgentDB::get();
+
+    LOG(DEBUG) << "send_beacon_request_to_all_ap_managers: sta_mac=" << sta_mac
+               << " timeout_ms=" << timeout_ms
+               << " primary_iface=" << primary_iface_name;
+
+    for (const auto radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        // Determine if this radio is the primary ap_manager (STA's serving link).
+        // The primary ap_manager sends the response even if no reports were collected.
+        // Non-primary ap_managers suppress empty responses to avoid duplicates.
+        const bool is_primary = (radio->front.iface_name == primary_iface_name);
+
+        auto request_out = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_MULTI_CHAN_BEACON_11K_REQUEST>(m_cmdu_tx);
+        if (request_out == nullptr) {
+            LOG(ERROR) << "Failed building cACTION_APMANAGER_MULTI_CHAN_BEACON_11K_REQUEST"
+                       << " for iface=" << radio->front.iface_name;
+            continue;
+        }
+
+        request_out->sta_mac()    = sta_mac;
+        request_out->timeout()    = static_cast<uint16_t>(timeout_ms);
+        request_out->is_primary() = is_primary ? 1 : 0;
+
+        LOG(DEBUG) << "send_beacon_request_to_all_ap_managers: sending to iface="
+                   << radio->front.iface_name
+                   << " is_primary=" << int(request_out->is_primary());
+
+        auto ap_manager_fd = m_btl_ctx.get_ap_manager_fd(radio->front.iface_name);
+        m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
+    }
+}
