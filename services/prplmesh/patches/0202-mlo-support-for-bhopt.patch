+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.h
@@ -345,6 +345,29 @@ private:
     bool beacon_metrics_query_cb(int fd);
     bool schedule_beacon_metrics_query(wfa_map::tlvBeaconMetricsQuery &beacon_metrics_query,
                                        uint16_t mid, const std::string &iface_name);
+
+    /**
+     * @brief Sends ACTION_APMANAGER_MULTI_CHAN_BEACON_11K_REQUEST to ALL ap_managers.
+     *
+     * In MLO setups, the monitor may send the REQ_BEACON on a different link interface than
+     * the STA's serving link. The BEACON-RESP-RX events come back on the link interface where
+     * REQ_BEACON was sent. By sending the request to all ap_managers, whichever one receives
+     * the BEACON-RESP-RX events will have an entry to store the reports.
+     *
+     * The primary ap_manager (the one for the STA's serving link, identified by primary_iface)
+     * is marked with is_primary=1. Non-primary ap_managers are marked with is_primary=0.
+     * This allows the ap_manager to suppress empty responses from non-primary instances,
+     * avoiding duplicate 0-report responses to the controller.
+     *
+     * All new logic is isolated in this standalone function.
+     *
+     * @param sta_mac MAC address of the STA for which beacon metrics are requested.
+     * @param timeout_ms Timeout in milliseconds for the beacon metrics response timer.
+     * @param primary_iface_name Interface name of the primary ap_manager (STA's serving link).
+     */
+    void send_beacon_request_to_all_ap_managers(const sMacAddr &sta_mac,
+                                                uint32_t timeout_ms,
+                                                const std::string &primary_iface_name);
 };
 
