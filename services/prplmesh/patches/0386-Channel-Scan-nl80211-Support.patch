 bool mon_wlan_hal_nl80211::channel_scan_trigger(int dwell_time_msec,
-                                                const std::vector<unsigned int> &channel_pool,
-                                                bool cert_mode)
+                                                 const std::vector<unsigned int> &channel_pool,
+                                                 bool cert_mode)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return false;
+    LOG(TRACE) << __func__ << " dwell_time=" << dwell_time_msec
+               << " channels=" << channel_pool.size() << " cert_mode=" << cert_mode;
+
+    const bool ret = send_nl80211_msg(
+        NL80211_CMD_TRIGGER_SCAN, 0,
+        [&](struct nl_msg *msg) -> bool {
+            // Discard stale scan-cache entries so GET_SCAN below only reports this pass.
+            if (nla_put_u32(msg, NL80211_ATTR_SCAN_FLAGS, NL80211_SCAN_FLAG_FLUSH) < 0) {
+                LOG(ERROR) << "Failed to add NL80211_ATTR_SCAN_FLAGS";
+                return false;
+            }
+
+            // A single zero-length SSID requests a wildcard (all-SSID) scan.
+            if (nla_put(msg, NL80211_ATTR_SCAN_SSIDS, 0, "") < 0) {
+                LOG(ERROR) << "Failed to add NL80211_ATTR_SCAN_SSIDS";
+                return false;
+            }
+
+            if (!channel_pool.empty()) {
+                auto *freqs = nla_nest_start(msg, NL80211_ATTR_SCAN_FREQUENCIES);
+                if (!freqs) {
+                    LOG(ERROR) << "Failed to start NL80211_ATTR_SCAN_FREQUENCIES";
+                    return false;
+                }
+
+                for (const auto channel : channel_pool) {
+                    const int freq = son::wireless_utils::channel_to_freq(channel);
+                    if (freq <= 0) {
+                        LOG(WARNING) << "Skipping invalid scan channel " << channel;
+                        continue;
+                    }
+                    if (nla_put_u32(msg, 0, freq) < 0) {
+                        LOG(ERROR) << "Failed to add scan frequency " << freq;
+                        return false;
+                    }
+                }
+                nla_nest_end(msg, freqs);
+            }
+
+            // Measurement duration is expressed in TUs by nl80211.
+            if (dwell_time_msec > 0) {
+                const auto duration_tu =
+                    static_cast<uint16_t>((dwell_time_msec * 1000) / 1024);
+                if (nla_put_u16(msg, NL80211_ATTR_MEASUREMENT_DURATION, duration_tu) < 0) {
+                    LOG(ERROR) << "Failed to add NL80211_ATTR_MEASUREMENT_DURATION";
+                    return false;
+                }
+            }
+            return true;
+        },
+        [&](struct nl_msg *) -> bool { return true; });
+
+    if (!ret) {
+        LOG(ERROR) << "Failed to trigger scan on " << get_iface_name();
+        return false;
+    }
+
+    if (!event_queue_push(Event::Channel_Scan_Triggered)) {
+        LOG(ERROR) << "Failed to queue Channel_Scan_Triggered";
+        channel_scan_abort();
+        return false;
+    }
+
+    m_scan_active.store(true);
+    LOG(INFO) << "NL80211 scan request sent for " << get_iface_name();
+    return true;
 }
 
