+                                LOG(WARNING) << "Failed to join nl80211 scan multicast group";
+                            } else {
+                                LOG(INFO) << "Subscribed to nl80211 scan multicast group";
+                            }
+                        } else {
+                            LOG(WARNING) << "No scan multicast group found on this kernel";
+                        }
+
+                        m_fd_nl_events = nl_socket_get_fd(m_nl80211_sock.get());
+                        if (m_fd_nl_events < 0) {
+                            LOG(ERROR) << "Failed to get nl80211 socket fd";
+                            return false;
+                        }
+                        LOG(INFO) << "nl80211 socket ready: family id=" << m_nl80211_id
+                                  << ", fd=" << m_fd_nl_events;
+                    }
+
                     // if_nametoindex requires a real Linux interface name; skip in no-VAP mode.
                     if (!get_iface_name().empty()) {
                         std::string iface_name = get_iface_name();
@@ -539,6 +667,7 @@ bool base_wlan_hal_nl80211::fsm_setup()
 
             // Init ext event FDS queue
             m_fds_ext_events = {-1};
+            m_fd_nl_events   = -1;
 
             // Re-register the global interface and the primary vap
             // entry to be ready for new FSM Attach. get_iface_name() already carries the
@@ -763,8 +892,60 @@ bool base_wlan_hal_nl80211::wpa_ctrl_send_msg_bufsize(const std::string &cmd, st
 
 bool base_wlan_hal_nl80211::process_nl_events()
 {
-    LOG(ERROR) << __func__ << "not implemented";
-    return false;
+    if (!m_nl80211_sock || !m_nl80211_sock.get()) {
+        LOG(ERROR) << "Invalid Netlink socket used for nl events (m_nl80211_sock == nullptr)";
+        return false;
+    }
+
+    int fd = nl_socket_get_fd(m_nl80211_sock.get());
+    if (fd <= 0) {
+        LOG(ERROR) << "Invalid socket fd=" << fd;
+        return false;
+    }
+
+    // Dispatch each received (multicast) message to the derived-class scan handler. A
+    // thread_local std::function wrapper is used so the C-style libnl callback can reach the
+    // instance's virtual process_scan_nl_event() without a captureful lambda.
+    static thread_local std::function<bool(struct nl_msg *, void *)> nl_handler_cb_wrapper;
+    nl_handler_cb_wrapper = [this](struct nl_msg *msg, void *arg) -> bool {
+        if (!process_scan_nl_event(msg, arg)) {
+            LOG(ERROR) << "process_scan_nl_event failed!";
+            return false;
+        }
+        return true;
+    };
+
+    auto nl_handler_cb = [](struct nl_msg *msg, void *arg) -> int {
+        return nl_handler_cb_wrapper(msg, arg) ? NL_OK : NL_STOP;
+    };
+
+    // No sequence checking - CRITICAL for multicast messages (they are not part of an
+    // ack-tracked request/response sequence).
+    auto no_seq_check = [](struct nl_msg *msg, void *arg) -> int { return NL_OK; };
+
+    auto nl_error_cb = [](struct sockaddr_nl *nla, struct nlmsgerr *err, void *arg) -> int {
+        LOG(ERROR) << "Netlink error: " << strerror(-err->error);
+        return NL_STOP;
+    };
+
+    struct nl_cb *cb = nl_cb_alloc(NL_CB_DEFAULT);
+    if (!cb) {
+        LOG(ERROR) << "nl_cb_alloc failed";
+        return false;
+    }
+    nl_cb_set(cb, NL_CB_SEQ_CHECK, NL_CB_CUSTOM, no_seq_check, nullptr);
+    nl_cb_set(cb, NL_CB_VALID, NL_CB_CUSTOM, nl_handler_cb, this);
+    nl_cb_err(cb, NL_CB_CUSTOM, nl_error_cb, nullptr);
+
+    int err = nl_recvmsgs(m_nl80211_sock.get(), cb);
+    if (err < 0) {
+        LOG(ERROR) << "nl_recvmsgs failed: " << nl_geterror(err) << " (" << err << ")";
+        nl_cb_put(cb);
+        return false;
+    }
+
+    nl_cb_put(cb);
+    return true;
 }
 
