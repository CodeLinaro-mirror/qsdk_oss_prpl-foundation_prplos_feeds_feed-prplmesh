+        NL80211_CMD_GET_SCAN, NLM_F_DUMP, [&](struct nl_msg *) -> bool { return true; },
+        [&](struct nl_msg *msg) -> bool {
+            auto *gnlh = static_cast<struct genlmsghdr *>(nlmsg_data(nlmsg_hdr(msg)));
+            struct nlattr *tb[NL80211_ATTR_MAX + 1] = {};
+            nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
+                      nullptr);
+
+            if (!tb[NL80211_ATTR_BSS]) {
+                return true;
+            }
+
+            struct nlattr *bss[NL80211_BSS_MAX + 1] = {};
+            if (nla_parse_nested(bss, NL80211_BSS_MAX, tb[NL80211_ATTR_BSS], nullptr)) {
+                LOG(ERROR) << "Failed to parse nested NL80211_ATTR_BSS";
+                return true;
+            }
+
+            auto notification = std::make_shared<sCHANNEL_SCAN_RESULTS_NOTIFICATION>();
+            if (!translate_nl_data_to_bwl_results(notification->channel_scan_results, bss)) {
+                LOG(WARNING) << "Skipping malformed NL80211 BSS scan result";
+                return true;
+            }
+
+            got_results = true;
+            ++result_count;
+            event_queue_push(Event::Channel_Scan_Dump_Result, notification);
+            return true;
+        });
+
+    if (!ret) {
+        LOG(ERROR) << "NL80211_CMD_GET_SCAN failed on " << get_iface_name();
+        return false;
+    }
+
+    LOG(INFO) << "Retrieved " << result_count << " scan result(s) for " << get_iface_name()
+              << (got_results ? "" : " (empty result set)");
+    return true;
+}
+
+bool mon_wlan_hal_nl80211::process_scan_nl_event(struct nl_msg *msg, void *arg)
+{
+    auto *nlh = nlmsg_hdr(msg);
+    if (!nlh) {
+        LOG(ERROR) << "Invalid nlmsghdr in scan event";
+        return false;
+    }
+
+    auto *gnlh = static_cast<struct genlmsghdr *>(nlmsg_data(nlh));
+    if (!gnlh) {
+        LOG(ERROR) << "Invalid genlmsghdr in scan event";
+        return false;
+    }
+
+    const auto event = nl80211_to_bwl_scan_event(gnlh->cmd);
+    switch (event) {
+    case Event::Channel_Scan_Dump_Result:
+        if (!m_scan_active.load()) {
+            LOG(DEBUG) << "Ignoring unsolicited NL80211 scan result event";
+            return true;
+        }
+        event_queue_push(Event::Channel_Scan_New_Results_Ready);
+        m_scan_active.store(false);
+        if (!channel_scan_dump_results()) {
+            return false;
+        }
+        event_queue_push(Event::Channel_Scan_Finished);
+        return true;
+
+    case Event::Channel_Scan_Finished:
+        if (m_scan_active.exchange(false)) {
+            LOG(WARNING) << "NL80211 scan aborted on " << get_iface_name();
+            event_queue_push(Event::Channel_Scan_Finished);
+        }
+        return true;
+
+    default:
+        // The subscribed nl80211 socket can receive unrelated multicast messages.
+        return true;
+    }
 }
 
