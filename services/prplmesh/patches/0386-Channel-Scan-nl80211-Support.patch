+static mon_wlan_hal::Event nl80211_to_bwl_scan_event(int cmd)
+{
+    switch (cmd) {
+    case NL80211_CMD_NEW_SCAN_RESULTS:
+        return mon_wlan_hal::Event::Channel_Scan_Dump_Result;
+    case NL80211_CMD_SCAN_ABORTED:
+        return mon_wlan_hal::Event::Channel_Scan_Finished;
+    default:
+        return mon_wlan_hal::Event::Invalid;
+    }
+}
+
+/**
+ * Translate one NL80211_ATTR_BSS nested object into the result representation
+ * consumed by ChannelScanTask. The kernel provides dBm*100 signal strength,
+ * beacon interval and raw IEs, which makes this a faithful on-demand scan
+ * result (unlike the QCA ACS neighbor-report cache).
+ */
+static bool translate_nl_data_to_bwl_results(sChannelScanResults &results,
+                                             struct nlattr **bss)
+{
+    if (!bss[NL80211_BSS_BSSID]) {
+        LOG(ERROR) << "Scan result lacks BSSID";
+        return false;
+    }
+    std::copy_n(static_cast<const uint8_t *>(nla_data(bss[NL80211_BSS_BSSID])),
+                sizeof(results.bssid.oct), results.bssid.oct);
+
+    if (bss[NL80211_BSS_FREQUENCY]) {
+        const int freq = nla_get_u32(bss[NL80211_BSS_FREQUENCY]);
+        results.channel = son::wireless_utils::freq_to_channel(freq);
+        switch (son::wireless_utils::which_freq_type(freq)) {
+        case beerocks::FREQ_24G:
+            results.operating_frequency_band =
+                eChannelScanResultOperatingFrequencyBand::eOperating_Freq_Band_2_4GHz;
+            break;
+        case beerocks::FREQ_5G:
+            results.operating_frequency_band =
+                eChannelScanResultOperatingFrequencyBand::eOperating_Freq_Band_5GHz;
+            break;
+        case beerocks::FREQ_6G:
+            results.operating_frequency_band =
+                eChannelScanResultOperatingFrequencyBand::eOperating_Freq_Band_6GHz;
+            break;
+        default:
+            LOG(WARNING) << "Unknown frequency band for scan frequency " << freq;
+            break;
+        }
+    }
+
+    if (bss[NL80211_BSS_BEACON_INTERVAL]) {
+        results.beacon_period_ms = nla_get_u16(bss[NL80211_BSS_BEACON_INTERVAL]);
+    }
+    if (bss[NL80211_BSS_SIGNAL_MBM]) {
+        results.signal_strength_dBm =
+            static_cast<int32_t>(nla_get_u32(bss[NL80211_BSS_SIGNAL_MBM])) / 100;
+    } else if (bss[NL80211_BSS_SIGNAL_UNSPEC]) {
+        results.signal_strength_dBm =
+            static_cast<int32_t>(nla_get_u8(bss[NL80211_BSS_SIGNAL_UNSPEC]));
+    }
+
+    results.operating_channel_bandwidth =
+        eChannelScanResultChannelBandwidth::eChannel_Bandwidth_20MHz;
+
+    // Parse only the IEs needed by the existing scan-result representation.
+    if (!bss[NL80211_BSS_INFORMATION_ELEMENTS]) {
+        return true;
+    }
+
+    const auto *ie =
+        static_cast<const uint8_t *>(nla_data(bss[NL80211_BSS_INFORMATION_ELEMENTS]));
+    const int ie_len = nla_len(bss[NL80211_BSS_INFORMATION_ELEMENTS]);
+    for (int pos = 0; pos + 1 < ie_len;) {
+        const int id  = ie[pos];
+        const int len = ie[pos + 1];
+        if (pos + 2 + len > ie_len) {
+            break;
+        }
+        const uint8_t *data = &ie[pos + 2];
+
+        switch (id) {
+        case 0: { // SSID
+            const int copy_len = std::min(len, static_cast<int>(sizeof(results.ssid) - 1));
+            if (copy_len > 0) {
+                std::copy_n(data, copy_len, results.ssid);
+                results.ssid[copy_len] = '\0';
+            }
+            break;
+        }
+        case 61: // HT Operation
+            if (len >= 2) {
+                results.operating_channel_bandwidth =
+                    (data[1] & 0x3)
+                        ? eChannelScanResultChannelBandwidth::eChannel_Bandwidth_40MHz
+                        : eChannelScanResultChannelBandwidth::eChannel_Bandwidth_20MHz;
+                results.supported_standards.push_back(
+                    eChannelScanResultStandards::eStandard_802_11n);
+                results.operating_standards = eChannelScanResultStandards::eStandard_802_11n;
+            }
+            break;
+        case 192: // VHT Operation
+            if (len >= 3) {
+                if (data[0] == 0x01) {
+                    results.operating_channel_bandwidth =
+                        data[2] ? eChannelScanResultChannelBandwidth::eChannel_Bandwidth_160MHz
+                                : eChannelScanResultChannelBandwidth::eChannel_Bandwidth_80MHz;
+                } else if (data[0] == 0x03) {
+                    results.operating_channel_bandwidth =
+                        eChannelScanResultChannelBandwidth::eChannel_Bandwidth_80_80;
+                }
+                if (results.operating_frequency_band ==
+                    eChannelScanResultOperatingFrequencyBand::eOperating_Freq_Band_5GHz) {
+                    results.supported_standards.push_back(
+                        eChannelScanResultStandards::eStandard_802_11ac);
+                    results.operating_standards = eChannelScanResultStandards::eStandard_802_11ac;
+                }
+            }
+            break;
+        default:
+            break;
+        }
+        pos += 2 + len;
+    }
+    return true;
+}
