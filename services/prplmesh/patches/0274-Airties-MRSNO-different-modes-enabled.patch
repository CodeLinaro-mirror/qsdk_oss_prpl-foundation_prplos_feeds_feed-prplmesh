From 7ae814eec31536756e59c16c3482e83dce2024d5 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Thu, 16 Jul 2026 12:50:57 +0530
Subject: [PATCH] Airties MRSNO different modes enabled

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 framework/platform/wbapi/wbapi_utils.cpp | 41 +++++++++++++++++-------
 1 file changed, 29 insertions(+), 12 deletions(-)

diff --git a/framework/platform/wbapi/wbapi_utils.cpp b/framework/platform/wbapi/wbapi_utils.cpp
index 276e58982..3c3d74c4d 100644
--- a/framework/platform/wbapi/wbapi_utils.cpp
+++ b/framework/platform/wbapi/wbapi_utils.cpp
@@ -94,6 +94,8 @@ const std::map<std::string, std::vector<WSC::eWscAuth>> wbapi_utils::security_mo
      {WSC::eWscAuth::WSC_AUTH_SAE, WSC::eWscAuth::WSC_AUTH_SAE_AKM24,
       WSC::eWscAuth(WSC::WSC_AUTH_SAE | WSC::WSC_AUTH_SAE_AKM24)}},
     {"WPA3-Personal-Compatibility", {WSC::eWscAuth::WSC_AUTH_RSN}},
+    {"WPA3-Personal-Compatibility-8", {WSC::eWscAuth::WSC_AUTH_RSN}},
+    {"WPA3-Personal-Compatibility-24", {WSC::eWscAuth::WSC_AUTH_RSN}},
 };
 
 const std::map<std::string, std::vector<son::wireless_utils::eAdditionalAuth>>
@@ -109,9 +111,19 @@ wbapi_utils::security_mode_to_string(const WSC::eWscAuth &security_mode,
                                      beerocks::eFreqType freq_band)
 {
     // Airties MRSNO (Multi-RSN Override) compatibility mode handling:
-    // For 6GHz: Only AKM8_AKM24 uses MRSNO flow (WPA3-Personal-Compatibility)
-    //           AKM8 and AKM24 alone should use normal flow
-    // For 2.4/5GHz: All three modes use MRSNO flow (WPA3-Personal-Compatibility)
+    // Three distinct MRSNO modes differ in which RSN overrides are applied per band:
+    //
+    // AKM8      (wpa3-com-8,    DM: "WPA3-Personal-Compatibility-8"):
+    //   RSN override 1 (SAE/AKM:8)         applied to 2.4 GHz and 5 GHz only
+    //   No RSN override applied to 6 GHz  -> fall through to normal flow
+    //
+    // AKM24     (wpa3-com-24,   DM: "WPA3-Personal-Compatibility-24"):
+    //   RSN override 2 (SAE-EXT-KEY/AKM:24) applied to 2.4 GHz and 5 GHz only
+    //   No RSN override applied to 6 GHz  -> fall through to normal flow
+    //
+    // AKM8_AKM24 (wpa3-com-8-24, DM: "WPA3-Personal-Compatibility"):
+    //   RSN overrides 1 and 2 applied to 2.4 GHz and 5 GHz
+    //   RSN override 2 applied to 6 GHz   -> always use MRSNO flow
     bool is_6ghz = (freq_band == beerocks::eFreqType::FREQ_6G);
     
     if (additional_auth ==
@@ -120,17 +132,22 @@ wbapi_utils::security_mode_to_string(const WSC::eWscAuth &security_mode,
             son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM24 ||
         additional_auth ==
             son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24) {
-        
-        // For 6GHz: Only AKM8_AKM24 should use MRSNO
-        if (is_6ghz) {
-            if (additional_auth == son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24) {
-                return "WPA3-Personal-Compatibility";
-            }
-            // Fall through to normal flow below for AKM8/AKM24 alone
-        } else {
-            // For 2.4/5GHz: All three modes use MRSNO
+
+        if (additional_auth ==
+            son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24) {
+            // AKM8_AKM24: MRSNO applies to all bands
             return "WPA3-Personal-Compatibility";
         }
+
+        // AKM8 / AKM24: MRSNO applies to 2.4 GHz and 5 GHz only; fall through for 6 GHz
+        if (!is_6ghz) {
+            if (additional_auth ==
+                son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8) {
+                return "WPA3-Personal-Compatibility-8";
+            }
+            return "WPA3-Personal-Compatibility-24";
+        }
+        // 6 GHz with AKM8 or AKM24 alone: fall through to normal flow below
     }
 
     if (security_mode != WSC::eWscAuth::WSC_AUTH_RSN) {
-- 
2.34.1

