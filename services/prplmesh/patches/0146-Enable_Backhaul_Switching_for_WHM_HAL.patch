 bool sta_wlan_hal_whm::disconnect_backhaul_sta()
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return true;
+LOG(DEBUG) << "disconnect_backhaul_sta(): m_active_profile_id : " << m_active_profile_id  << get_iface_name();
+
+    Endpoint ep;
+    if (!read_status(ep)) {
+
+        LOG(DEBUG) << "failed to read status, skip";
+        return true;
+    }
+    if (m_active_profile_id <= 0) {
+        LOG(DEBUG) << "set_profile_enable(): no active profile yet, skipping";
+        return true;
+    }
+
+        if (!set_profile_enable(false)) {
+            LOG(ERROR) << "failed to disable profile";
+        }
+
+    clear_conn_state();
+
+     return true;
 }

 bool sta_wlan_hal_whm::reconnect_backhaul_sta()
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return true;
+
+            // Re-enable profile before reassociation
+             set_profile_enable(true);
+            return reassociate();
 }

+
 bool sta_wlan_hal_whm::is_disconnected()
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return false;
+ Endpoint ep;
+           constexpr int max_retries = 10;
+            int retry = 0;
+
+            while ((!read_status(ep)) && (retry++ < max_retries))
+            {
+                LOG(ERROR) << "Failed to read endpoint status, retry: " << retry;
+                usleep(1000);
+            }
+            // Only "Connected" means link is up.
+            return (ep.connection_status != "Connected");
 }

+static WiFiSec wsc_to_wifi_sec(WSC::eWscAuth auth)
+        {
+            using W = WSC::eWscAuth;
+
+            if (auth == W::WSC_AUTH_OPEN)
+            {
+                return WiFiSec::None;
+            }
+            if (auth == W::WSC_AUTH_WPA2PSK)
+            {
+                return WiFiSec::WPA2_PSK;
+            }
+            if (auth == W::WSC_AUTH_SAE)
+            {
+                return WiFiSec::WPA3_PSK;
+            }
+            if (auth == WSC::eWscAuth(W::WSC_AUTH_WPA2PSK | W::WSC_AUTH_SAE))
+            {
+                return WiFiSec::WPA2_WPA3_PSK;
+            }
+
+            return WiFiSec::Invalid;
+ }
 bool sta_wlan_hal_whm::add_new_network(son::wireless_utils::sBssInfoConf bSta_conf)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return true;
+         if (bSta_conf.ssid.empty())
+            {
+                LOG(ERROR) << " add_new_network(): empty BSTA SSID";
+               return false;
+            }
+
+            WiFiSec sec = wsc_to_wifi_sec(bSta_conf.authentication_type);
+          if (sec == WiFiSec::Invalid)
+            {
+                LOG(ERROR) << "add_new_network(): invalid authentication type";
+                return false;
+            }
+           bool hidden_ssid = false;
+
+          if (bSta_conf.hidden_ssid != WSC::eWscVendorExtHiddenSsid::UNSET) {
+             hidden_ssid = static_cast<bool>(bSta_conf.hidden_ssid);
+              }
+
+            return connect(
+                bSta_conf.ssid,
+                bSta_conf.network_key,
+                sec,
+                false /* mem_only_psk */,
+                (bSta_conf.bssid == beerocks::net::network_utils::ZERO_MAC)
+                    ? std::string("")
+                    : tlvf::mac_to_string(bSta_conf.bssid),
+                ChannelFreqPair{0, eFreqType::FREQ_UNKNOWN},
+                hidden_ssid
+                       );
 }

