+bool sta_wlan_hal_whm::set_profile_enable(bool enable)
+{
+    LOG(DEBUG) << "set_profile_enable(): iface=" << get_iface_name()
+               << " active_profile_id=" << m_active_profile_id
+               << " enable=" << int(enable);
+    if (m_ep_path.empty()) {
+        LOG(ERROR) << "set_profile_enable(): no EP path for iface "
+                   << get_iface_name();
+        return false;
+    }

+    if (m_active_profile_id <= 0) {
+        LOG(DEBUG) << "set_profile_enable(): no active profile yet, skipping";
+        return true;
+    }
+       std::string profile_path =
+        m_ep_path + "Profile." +
+        std::to_string(m_active_profile_id) + ".";
+    AmbiorixVariant params(AMXC_VAR_ID_HTABLE);
+    params.add_child<bool>("Enable", enable);
+
+    if (!m_ambiorix_cl.update_object(profile_path, params)) {
+        LOG(ERROR) << "set_profile_enable(): failed to set Enable="
+                   << int(enable) << " on " << profile_path;
+        return false;
+    }
+
+    LOG(DEBUG) << "set_profile_enable(): success Enable="
+               << int(enable)
+               << " profile_id=" << m_active_profile_id
+               << " iface=" << get_iface_name();
+
+    return true;
+}
