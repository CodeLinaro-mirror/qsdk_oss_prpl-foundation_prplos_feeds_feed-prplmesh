From cf0473db70b237185b7fabb5964ad89a764e091a Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 19 Aug 2026 11:29:29 +0530
Subject: [PATCH] nl80211: fix 5G DFS radio stuck in autoconfiguration after
 CAC

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp       | 13 ++++++-------
 .../slave/tasks/ap_autoconfiguration_task.cpp       |  7 ++++++-
 2 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 79a1d4e23..b192960ec 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4963,16 +4963,15 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         // When CAC completes successfully, the DFS channel is now available.
         // Restart the autoconfiguration task so the controller can configure
         // the BSS on the newly available channel.
+        // Pass &fronthaul_iface so only the radio that completed CAC restarts
+        // its autoconfiguration. Without this, ALL radios (including already-
+        // CONFIGURED 2G/6G radios) are moved back to CONTROLLER_DISCOVERY,
         if (notification_in->params().success) {
             LOG(INFO) << "CAC completed successfully on " << fronthaul_iface
                       << " - restarting autoconfiguration task";
-            if (db->device_conf.management_mode != BPL_MGMT_MODE_MULTIAP_CONTROLLER) {
-                m_task_pool.send_event(eTaskType::AP_AUTOCONFIGURATION,
-                                       ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION);
-            } else {
-                m_task_pool.send_event(eTaskType::AP_AUTOCONFIGURATION,
-                                       ApAutoConfigurationTask::eEvent::INIT_TASK);
-            }
+            m_task_pool.send_event(eTaskType::AP_AUTOCONFIGURATION,
+                                   ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION,
+                                   &fronthaul_iface);
         }
 #endif // USE_PRPLMESH_NLHAL
         break;
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 2425eedbb..a783603cd 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -516,7 +516,12 @@ void ApAutoConfigurationTask::work()
             // hold M1 here. The early AP capability report must reach the controller
             // before M1 so it can include MLO configuration in M2; gating M1 on
             // ts_applied guarantees the order: VLAN creation → early AP cap → M1.
-            if (db->backhaul.connection_type != AgentDB::sBackhaul::eConnectionType::Wired &&
+            //
+            // Only gate on TS for wireless-backhaul devices: the VLAN interface is
+            // created on the wireless backhaul link and must exist before M1 is sent.
+            // For GW (connection_type == Invalid) and wired-backhaul devices there is
+            // no backhaul VLAN to wait for, so the wait is skipped.
+            if (db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
                 db->traffic_separation.primary_vlan_id != 0 && !db->traffic_separation.ts_applied) {
                 LOG(DEBUG) << "Waiting for TS VLAN interface before sending M1 for " << radio_iface;
                 break;
-- 
2.34.1

