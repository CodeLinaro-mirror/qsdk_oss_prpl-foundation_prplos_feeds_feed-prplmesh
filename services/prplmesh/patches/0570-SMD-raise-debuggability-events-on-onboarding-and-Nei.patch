+/**
+ * @brief Notify the HealthMonitoringTask of an SMD onboarding failure, via
+ * task_pool_try_send_event(eTaskType::HEALTH_MONITORING, SMD_FAILURE, ...).
+ *
+ * Local helper (file-scope, mirrors NeighborDbAgentTask::notify_smd_failure) since
+ * ApAutoConfigurationTask already holds slave_thread &m_btl_ctx and uses
+ * task_pool_try_send_event() directly elsewhere in this file.
+ *
+ * @param btl_ctx Agent context used to reach the task pool.
+ * @param smd_identifier SMD identifier in scope, or ZERO_MAC if not applicable.
+ * @param stage Stage identifier (see HealthMonitoringTask::sSmdFailureEvent).
+ * @param reason Human-readable failure reason.
+ */
+void notify_smd_failure(slave_thread &btl_ctx, const sMacAddr &smd_identifier,
+                        const std::string &stage, const std::string &reason)
+{
+    HealthMonitoringTask::sSmdFailureEvent event;
+    event.smd_identifier = smd_identifier;
+    event.stage          = stage;
+    event.reason         = reason;
+
+    btl_ctx.task_pool_try_send_event(
+        eTaskType::HEALTH_MONITORING,
+        static_cast<uint8_t>(HealthMonitoringTask::eEvent::SMD_FAILURE), &event);
+}
+
 bool is_valid_op_std(const std::string &radio_iface,
                      const airties::tlvAirtiesRadioCapability::sStandards &op_std)
 {
