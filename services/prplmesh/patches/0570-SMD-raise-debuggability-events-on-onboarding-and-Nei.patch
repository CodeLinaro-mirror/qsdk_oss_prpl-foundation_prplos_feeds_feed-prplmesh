+                    break;
+                }
+            }
+            if (!any_radio_smd_ok) {
+                notify_smd_failure(m_btl_ctx, beerocks::net::network_utils::ZERO_MAC,
+                                   "SMD_ONBOARDING",
+                                   "enable_smd set but no radio reports driver SMD support");
+            }
+        }
+    }
+
     std::vector<sBssConfig> bss_infos;
     if (!handle_wsc_m2_tlv(cmdu_rx, radio->front.iface_name, m2_list, bss_infos,
                            misconfigured_ssids)) {
