+        if (AgentDB::get()->device_conf.enable_smd) {
+            notify_smd_failure(m_btl_ctx, beerocks::net::network_utils::ZERO_MAC, "SMD_ONBOARDING",
+                               "no SMD policy config TLV in M2 while SMD is enabled");
+        }
     }
 
     // Persist SMD identifiers into AgentDB so NeighborDbAgentTask can issue
@@ -3217,6 +3249,25 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
                    << db->smd_identifiers.size() << " SMD ID(s)";
     }
 
+    {
+        auto db = AgentDB::get();
+
+        if (db->device_conf.enable_smd) {
+            bool any_radio_smd_ok = false;
+            for (const auto db_radio : db->get_radios_list()) {
+                if (db_radio && db_radio->smd_support) {
