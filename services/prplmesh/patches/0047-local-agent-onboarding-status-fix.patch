From 720e1768fb9ae74abfa4f3d3b7e4b7b5175d27f4 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 2 Apr 2026 12:37:09 +0530
Subject: [PATCH 45/54] local agent onboarding status fix

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 agent/src/beerocks/slave/agent_db.h           |  1 +
 .../backhaul_manager/backhaul_manager.cpp     |  2 ++
 agent/src/beerocks/slave/son_slave_thread.cpp | 14 ++++++++++++-
 .../slave/tasks/ap_autoconfiguration_task.cpp |  6 ++++++
 controller/src/beerocks/master/controller.cpp | 21 ++++++++++++++++++-
 controller/src/beerocks/master/controller.h   |  2 ++
 .../src/beerocks/master/son_actions.cpp       |  3 +++
 7 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index e34f61e15..fe0c33584 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -199,6 +199,7 @@ public:
 
     struct sStatus {
         bool ap_autoconfiguration_completed;
+        bool controller_discovery_completed;
         uint32_t zwdfs_cac_remaining_time_sec;
     } statuses;
 
diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index a20765728..b8b46bccd 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -2290,6 +2290,8 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
             if (db->device_conf.local_controller && !db->device_conf.local_gw) {
                 FSM_MOVE_STATE(CONNECTED);
             } else {
+                // send topology_notification after reconnect
+                m_task_pool.send_event(eTaskType::TOPOLOGY, TopologyTask::eEvent::AGENT_RADIO_STATE_CHANGED);
                 FSM_MOVE_STATE(OPERATIONAL);
             }
         }
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index d48567853..67c1e06ab 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -3389,7 +3389,19 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
 
         if (!link_to_controller()) {
             LOG(DEBUG) << "Controller is not connected";
-            return true;
+
+            LOG(DEBUG) << "controller mac: " << db->controller_info.bridge_mac << " agent_bridge_mac: " << db->bridge.mac; 
+
+            //TODO: Needs to handle Extender Agent only mode
+            if ((db->controller_info.bridge_mac != network_utils::ZERO_MAC) && 
+                              (db->controller_info.bridge_mac == db->bridge.mac)) {
+                LOG(DEBUG) << " Local Agent - Send topology notification to controller " ;
+            } else if (db->statuses.controller_discovery_completed == true) {
+                LOG(DEBUG) << " Controller discovery completed in Non-Local Agent - send topology notification" ;
+            } else {
+                LOG(ERROR) << " Controller discovery not completed in Non-Local Agent - Drop topology notification" ;
+                return true;
+            }
         }
 
         // build 1905.1 message CMDU to send to the controller
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 99c37b13c..0859da7c1 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -433,6 +433,7 @@ void ApAutoConfigurationTask::handle_event(uint8_t event_enum_value, const void
         auto db = AgentDB::get();
 
         db->statuses.ap_autoconfiguration_completed = false;
+        db->statuses.controller_discovery_completed = false;
 
         // Reset the discovery statuses.
         for (auto &discovery_status : m_discovery_status) {
@@ -443,6 +444,7 @@ void ApAutoConfigurationTask::handle_event(uint8_t event_enum_value, const void
     }
     case START_AP_AUTOCONFIGURATION: {
         auto db = AgentDB::get();
+        db->statuses.controller_discovery_completed = false;
         for (const auto radio : db->get_radios_list()) {
             if (!radio) {
                 continue;
@@ -1334,6 +1336,7 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_response(
         return;
     }
     m_discovery_status[freq_type].completed = true;
+    db->statuses.controller_discovery_completed = true;
 
     LOG(DEBUG) << "received ap_autoconfiguration response for " << band_name << " band";
 
@@ -1414,6 +1417,7 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_response(
     db->controller_info.prplmesh_controller = prplmesh_controller;
     db->controller_info.bridge_mac          = src_mac;
     m_discovery_status[freq_type].completed = true;
+    db->statuses.controller_discovery_completed = true;
     LOG(DEBUG) << "controller_discovered on " << band_name
                << " band, controller bridge_mac=" << src_mac
                << ", prplmesh_controller=" << prplmesh_controller;
@@ -1671,6 +1675,8 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc_renew(
         return;
     }
 
+    db->statuses.controller_discovery_completed = false;
+
     for (const auto radio : db->get_radios_list()) {
         if (!radio) {
             return;
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 58e85b01d..c9303543c 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -648,7 +648,20 @@ bool Controller::handle_cmdu_1905_1_message(const sMacAddr &src_mac,
 bool Controller::handle_cmdu_1905_autoconfiguration_search(const sMacAddr &src_mac,
                                                            ieee1905_1::CmduMessageRx &cmdu_rx)
 {
-    LOG(DEBUG) << "Received AP_AUTOCONFIGURATION_SEARCH_MESSAGE from src_mac: " << src_mac;
+    LOG(DEBUG) << "Received AP_AUTOCONFIGURATION_SEARCH_MESSAGE FROM: " << src_mac;
+
+    if (database.config.management_mode == BPL_MGMT_MODE_MULTIAP_CONTROLLER_AGENT) {
+        LOG(DEBUG) << "MODE: MULTIAP_CONTROLLER_AGENT - Handle search message based on local_agent_onboarding_status";
+        if (src_mac == database.get_local_bridge_mac()) {
+            LOG(DEBUG) << " Received Local Agent search message " ;
+        } else {
+            LOG(DEBUG) << " Received Non-Local Agent search message " ;
+            if (local_agent_onboarding_status != 1) {
+                LOG(ERROR) << " Local agent onboarding is not completed - Drop search message from " << src_mac;
+                return false;
+            }
+        }
+    }
 
     auto tlvAlMacAddress = cmdu_rx.getClass<ieee1905_1::tlvAlMacAddress>();
     if (!tlvAlMacAddress) {
@@ -1780,6 +1793,12 @@ bool Controller::handle_cmdu_1905_autoconfiguration_WSC(const sMacAddr &src_mac,
         }
     }
 
+    if ((database.config.management_mode == BPL_MGMT_MODE_MULTIAP_CONTROLLER_AGENT) &&
+                               (src_mac == database.get_local_bridge_mac())) {
+        LOG(DEBUG) << " Parsed M1 from the Local agent - set local agent onboarding status as 1" ;
+        local_agent_onboarding_status = 1;
+    }
+
     agent->device_info.manufacturer       = m1->manufacturer();
     agent->device_info.manufacturer_model = m1->model_name();
     agent->device_info.serial_number      = m1->serial_number();
diff --git a/controller/src/beerocks/master/controller.h b/controller/src/beerocks/master/controller.h
index 0b4efe46f..8f29c4e2b 100644
--- a/controller/src/beerocks/master/controller.h
+++ b/controller/src/beerocks/master/controller.h
@@ -843,6 +843,8 @@ private:
     */
     bool send_unassociated_sta_link_metrics_query_message(ieee1905_1::CmduMessageTx &cmdu_tx,
                                                           db &database);
+
+    int8_t local_agent_onboarding_status = -1;
 };
 
 } // namespace son
diff --git a/controller/src/beerocks/master/son_actions.cpp b/controller/src/beerocks/master/son_actions.cpp
index 34acfc851..f275007ad 100644
--- a/controller/src/beerocks/master/son_actions.cpp
+++ b/controller/src/beerocks/master/son_actions.cpp
@@ -64,8 +64,11 @@ void son_actions::handle_completed_connection(db &database, ieee1905_1::CmduMess
         /*
          * send disassociate request to previous hostap to clear STA mac from its list
          */
+        LOG(DEBUG) << "new_hostap_mac: " << new_hostap_mac << " prev:" << previous_hostap_mac;
         if ((!previous_hostap_mac.empty()) &&
             (previous_hostap_mac != network_utils::ZERO_MAC_STRING) &&
+            (!new_hostap_mac.empty()) &&
+            (new_hostap_mac != network_utils::ZERO_MAC_STRING) &&
             (previous_hostap_mac != new_hostap_mac)) {
             disconnect_client(database, cmdu_tx, client_mac, previous_hostap_mac,
                               eDisconnect_Type_Disassoc, 0);
-- 
2.34.1

