+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _BWL_SLAVE_WLAN_HAL_H_
+#define _BWL_SLAVE_WLAN_HAL_H_
+
+#include "base_wlan_hal.h"
+
+namespace bwl {
+
+/*!
+ * Hardware abstraction layer for Slave
+ * Read more about virtual inheritance: https://en.wikipedia.org/wiki/Virtual_inheritance
+ */
+class slave_wlan_hal : public virtual base_wlan_hal {
+
+    // Public definitions
+public:
+    // Slave Events
+    enum class Event {
+        Invalid = 0,
+
+        // SMD Events
+        SMD_Roaming_Completed
+    };
+
+    // Public methods:
+public:
+    virtual ~slave_wlan_hal() = default;
+
+    virtual int smd_set_neighbor(const void* payload, int payload_len) = 0;
+};
+
+// Slave HAL factory types
+std::shared_ptr<slave_wlan_hal> slave_wlan_hal_create(const std::string &iface_name,
+                                                  base_wlan_hal::hal_event_cb_t cb,
+                                                  const bwl::hal_conf_t &hal_conf);
+
+} // namespace bwl
+
+#endif // _BWL_SLAVE_WLAN_HAL_H_
diff --git a/common/beerocks/bwl/nl80211/slave_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/slave_wlan_hal_nl80211.cpp
new file mode 100644
index 000000000..16cefcc75
--- /dev/null
+++ b/common/beerocks/bwl/nl80211/slave_wlan_hal_nl80211.cpp
@@ -0,0 +1,170 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "slave_wlan_hal_nl80211.h"
+
+#include <bcl/beerocks_utils.h>
+#include <bcl/network/network_utils.h>
+#include <easylogging++.h>
+
+using namespace beerocks;
+using namespace mqttapi;
+
+namespace bwl {
+namespace nl80211 {
+
+slave_wlan_hal_nl80211::slave_wlan_hal_nl80211(const std::string &iface_name, hal_event_cb_t callback,
+                                   const bwl::hal_conf_t &hal_conf)
+    : base_wlan_hal(bwl::HALType::Slave, iface_name, IfaceType::Intel, callback, hal_conf)
+{
+    int fd = mqtt_client.init(iface_name, "localhost", 1883,
+        [this](const char* topic, const void* payload, int payload_len) {
+            on_mqtt_message(topic, payload, payload_len);
+        });
+    if (fd < 0) {
+        LOG(ERROR) << "Failed to initialize MQTT client";
+        return;
+    }
+    
+    m_fds_ext_events = {fd};
+    subscribe_to_smd_events();
+}
+
+const std::vector<int> &slave_wlan_hal_nl80211::get_ext_events_fds() const
+{
+    return (m_fds_ext_events);
+}
+
+slave_wlan_hal_nl80211::~slave_wlan_hal_nl80211()
+{
+    detach();
+}
+
+void slave_wlan_hal_nl80211::subscribe_to_smd_events()
+{
+    if (mqtt_client.get_fd() >= 0) {
+        mqtt_client.subscribe("hostapd/transmit/SMD", 1);
+    } else {
+        LOG(ERROR) << "MQTT client is not valid for subscription";
+    }
+}
+
+void slave_wlan_hal_nl80211::on_mqtt_message(const char* topic, const void* payload, int payload_len)
+{
+    LOG(DEBUG) << " Processing message on topic " << topic;
+    // Process message
+    (void)payload;
+    (void)payload_len;
+
+    event_queue_push(Event::SMD_Roaming_Completed);
+}
+
+int slave_wlan_hal_nl80211::smd_set_neighbor(const void* payload, int payload_len)
+{
+    if (mqtt_client.get_fd() < 0) {
+        LOG(ERROR) << "MQTT client is not valid for publishing";
+        return -1;
+    }
+
+    return mqtt_client.publish("hostapd/receive", payload, payload_len, 1, false);
+}
