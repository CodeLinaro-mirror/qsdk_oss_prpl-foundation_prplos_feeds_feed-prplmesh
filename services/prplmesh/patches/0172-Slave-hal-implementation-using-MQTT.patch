diff --git a/framework/platform/mqttapi/mqtt_client.cpp b/framework/platform/mqttapi/mqtt_client.cpp
new file mode 100644
index 000000000..fea283941
--- /dev/null
+++ b/framework/platform/mqttapi/mqtt_client.cpp
@@ -0,0 +1,154 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "mqtt_client.h"
+#include <mosquitto.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <atomic>
+#include <easylogging++.h>
+
+namespace beerocks {
+namespace mqttapi {
+
+static std::atomic<int> g_init_count{0};
+
+MQTTClient::MQTTClient() : mosq(nullptr), mqtt_fd(-1)
+{
+    if (g_init_count.fetch_add(1) == 0) {
+        mosquitto_lib_init();
+    }
+}
+
+MQTTClient::~MQTTClient()
+{
+    cleanup();
+
+    if (g_init_count.fetch_sub(1) == 1) {
+        mosquitto_lib_cleanup();
+    }
+}
+
+int MQTTClient::init(const std::string& id, const std::string& host, int port, MessageCallback callback)
+{
+    cleanup();
+
+    mosq = mosquitto_new(id.c_str(), true, this);
+    if (!mosq) {
+        LOG(ERROR) << "Error: Out of memory.";
+        return -1;
+    }
+
+    mosquitto_connect_callback_set(mosq, on_connect_static);
+    mosquitto_message_callback_set(mosq, on_message_static);
+
+    if (mosquitto_connect(mosq, host.c_str(), port, 60) != MOSQ_ERR_SUCCESS) {
+        LOG(ERROR) << "Unable to connect to MQTT broker";
+        cleanup();
+        return -1;
+    }
+
+    mqtt_fd = mosquitto_socket(mosq);
+    if (mqtt_fd == -1) {
+        perror("mosquitto_socket");
+        cleanup();
+        return -1;
+    }
+
+    int flags = fcntl(mqtt_fd, F_GETFL, 0);
+    if (flags == -1) {
+        perror("fcntl F_GETFL");
+        cleanup();
+        return -1;
+    }
+    if (fcntl(mqtt_fd, F_SETFL, flags | O_NONBLOCK) == -1) {
+        perror("fcntl F_SETFL");
+        cleanup();
+        return -1;
+    }
+
+    mqtt_callback = callback;
+
+    return mqtt_fd;
+}
+
+int MQTTClient::get_fd() const
+{
+    return mqtt_fd;
+}
+
+void MQTTClient::process()
+{
+    if (!mosq || mqtt_fd == -1) {
+        return;
+    }
+
+    int rc = mosquitto_loop_read(mosq, 1);
+    if (rc == MOSQ_ERR_CONN_LOST) {
+        LOG(ERROR) << "MQTT connection lost";
+    }
+    
+    if (mosquitto_want_write(mosq)) {
+        rc = mosquitto_loop_write(mosq, 1);
+        if (rc == MOSQ_ERR_CONN_LOST) {
+            LOG(ERROR) << "MQTT connection lost during write";
+        }
+    }
+}
+
+void MQTTClient::cleanup()
+{
+    if (mosq) {
+        mosquitto_disconnect(mosq);
+        mosquitto_destroy(mosq);
+        mosq = nullptr;
+    }
+    mqtt_fd = -1;
+}
+
+int MQTTClient::publish(const std::string& topic, const void* payload, int payload_len, int qos, bool retain)
+{
+    if (!mosq) return MOSQ_ERR_NO_CONN;
+    return mosquitto_publish(mosq, nullptr, topic.c_str(), payload_len, payload, qos, retain);
+}
+
+int MQTTClient::subscribe(const std::string& topic, int qos)
+{
+    if (!mosq) {
+        return MOSQ_ERR_NO_CONN;
+    }
+    return mosquitto_subscribe(mosq, nullptr, topic.c_str(), qos);
+}
+
+void MQTTClient::on_connect_static(struct mosquitto* mosq, void* obj, int rc)
+{
+    MQTTClient* client = static_cast<MQTTClient*>(obj);
+    client->on_connect(rc);
+}
+
+void MQTTClient::on_message_static(struct mosquitto* mosq, void* obj, const struct mosquitto_message* msg)
+{
+    MQTTClient* client = static_cast<MQTTClient*>(obj);
+    client->on_message(msg);
+}
+
+void MQTTClient::on_connect(int rc)
+{
+    if (rc != MOSQ_ERR_SUCCESS) {
+        LOG(ERROR) << "MQTT connection failed: " << mosquitto_strerror(rc);
+    }
+}
+
+void MQTTClient::on_message(const struct mosquitto_message* msg)
+{
+    if (mqtt_callback && msg && msg->topic) {
+        mqtt_callback(msg->topic, msg->payload, msg->payloadlen);
+    }
+}
