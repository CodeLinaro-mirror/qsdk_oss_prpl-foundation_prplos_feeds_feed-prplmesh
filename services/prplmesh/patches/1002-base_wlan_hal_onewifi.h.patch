+// CCSP bus API - includes both bus_common.h and rbus.h
+// The CCSP bus.h is a wrapper that includes OneWifi's bus_common.h and provides bus_handle_t
+// This is the correct header to use as it's in the sysroot and includes all necessary types
+//
+// CRITICAL: Include order matters!
+// 1. FIRST: Include net/ethernet.h to define ETHER_ADDR_LEN (needed by ec_base.h)
+// 2. Then wifi_hal headers from ccsp-one-wifi-libwebconfig
+// 3. Then wifi_webconfig.h and wifi_data_model.h
+// 4. Finally webconfig_external_proto_easymesh.h which includes em_base.h -> ec_base.h
+extern "C" {
+#include <net/ethernet.h>  // MUST be first - defines ETHER_ADDR_LEN needed by ec_base.h
+// Include bus_common.h explicitly FIRST to get bus_data_prop_t from the correct
+// git/source/platform/common/bus_common.h (not the older qcapps sysroot version).
+// The include guard in bus_common.h prevents double-inclusion when bus.h also includes it.
+#include <bus_common.h>
+#include <bus.h>  // CCSP bus.h (includes bus_common.h and rbus.h)
+#include <ccsp/wifi_hal.h>  // CCSP wifi HAL - defines all WiFi HAL types
+#include <ccsp/wifi_hal_ap.h>  // CCSP wifi HAL AP - defines WIFI_AP_MAX_VENDOR_IE_LEN
+#include <wifi_webconfig.h>  // OneWifi webconfig API
+#include <wifi_data_model.h>  // OneWifi data model types
+#include <webconfig_external_proto_easymesh.h>  // Uses types from wifi_hal.h via em_base.h
+}
 
 namespace bwl {
 namespace onewifi {
 
+// Forward declaration - complete definition needed before std::unique_ptr usage
+class onewifi_data_model_t;
+
 class base_wlan_hal_onewifi : public virtual base_wlan_hal
 {
 public:
@@ -34,7 +102,9 @@ public:
     virtual bool get_vap_status(const std::list<son::wireless_utils::sBssInfoConf> &bss_info_conf_list) override { return true; }
     virtual bool get_channel_utilization(uint8_t &channel_utilization) override { channel_utilization = 0; return true; }
     virtual const std::string get_iface_from_fd(int fd) override { return ""; }
-    virtual std::string get_radio_mac() override { return ""; }
+    virtual std::string get_radio_mac() override;
+    virtual sMacAddr get_bsta_mld_mac() override { return beerocks::net::network_utils::ZERO_MAC; }
+    virtual sMacAddr get_ap_mld_mac() override { return beerocks::net::network_utils::ZERO_MAC; }
     virtual bool set(const std::string &param, const std::string &value, int vap_id) override { return true; }
 
     // Static event handler
@@ -44,7 +114,139 @@ protected:
     // void map_radio_info(const rdk_wifi_radio_t &rdk_radio, RadioInfo &radio_info);
     // void map_vap_info(const rdk_wifi_vap_info_t &rdk_vap, VAPElement &vap_elem);
 
+    // OneWifi bus handle pointer (points to shared bus handle after construction)
+    // Using pointer instead of reference to allow rebinding after shared resources are set
+    bus_handle_t* m_bus_hdl_ptr;
+    
+    /**
+     * @brief Check and open OneWifi bus connection
+     * 
+     * Always calls bus_init() to refresh the handle, then attempts to open
+     * the bus connection. If the bus is already open (bus_error_session_already_exist
+     * or bus_error_component_name_duplicate), treats it as success.
+     * 
+     * @return true if bus is open or successfully opened, false on failure
+     */
+    bool check_and_open_bus();
+
+    /**
+     * @brief Shared resources per radio interface
+     * 
+     * AP and Monitor for the same radio share:
+     * - Data model (device/radio/BSS state)
+     * - Bus handle (OneWifi bus connection)
+     * 
+     * Keyed by interface name (e.g., "wlan0").
+     * Protected by s_shared_resources_mutex for thread-safe access.
+     */
+    struct SharedResources {
+        std::shared_ptr<onewifi_data_model_t> data_model;
+        bus_handle_t bus_handle;
+        int ref_count;  // Track number of HALs using this resource
+        
+        SharedResources() : ref_count(0) {
+            memset(&bus_handle, 0, sizeof(bus_handle_t));
+        }
+    };
+    
+    static std::map<std::string, std::shared_ptr<SharedResources>> s_shared_resources;
+    static std::mutex s_shared_resources_mutex;
+    
+    /**
+     * @brief Pointer to this instance's shared resources
+     */
+    std::shared_ptr<SharedResources> m_shared_resources;
+    
+    /**
+     * @brief Convenience accessor for data model
+     */
+    std::shared_ptr<onewifi_data_model_t> m_data_model;
+    
+    /**
+     * @brief Static mutex to protect webconfig_easymesh_decode()
+     * 
+     * The webconfig_easymesh_decode() function is not thread-safe. This mutex
+     * ensures only one HAL instance can decode at a time, preventing heap corruption
+     * when both AP Manager and Monitor try to decode simultaneously.
+     */
+    static std::mutex s_webconfig_decode_mutex;
+
+    /**
+     * @brief Get OneWifi bus descriptor
+     * 
+     * Returns the platform-specific bus descriptor for OneWifi operations
+     * 
+     * @return Pointer to bus descriptor, or nullptr on failure
+     */
+    wifi_bus_desc_t *get_bus_descriptor();
+
+public:
+    /**
+     * @brief Helper method to initialize webconfig for decode operations
+     * Public so decode_subdoc() static helper can access it.
+     */
+    bool init_webconfig_for_decode(webconfig_external_easymesh_t &ext_data, 
+                                   webconfig_t &config);
+    
+    /**
+     * @brief Thread-safe wrapper for webconfig_easymesh_decode
+     * Public so decode_subdoc() static helper can access it.
+     */
+    webconfig_error_t safe_webconfig_decode(webconfig_t *config, const char *json_str,
+                                            webconfig_external_easymesh_t *ext_data,
+                                            webconfig_subdoc_type_t *subdoc_type);
+
+protected:
+
+    /**
+     * @brief Get webconfig subdoc type for frequency band
+     * 
+     * Maps EasyMesh frequency band enum to OneWifi webconfig subdoc type.
+     * Handles both em_freq_band_60 and em_freq_band_6 for 6GHz band.
+     * 
+     * @param freq_band Frequency band (em_freq_band_24, em_freq_band_5, em_freq_band_60, em_freq_band_6)
+     * @return Corresponding webconfig_subdoc_type_t
+     */
+    webconfig_subdoc_type_t get_subdoc_radio_type_for_freq(em_freq_band_t freq_band);
+
+    /**
+     * @brief Populate radio capabilities from data model
+     * 
+     * Extracts and populates HT/VHT/HE/EHT/MLO capabilities from the data model
+     * into m_radio_info. This includes 802.11n/ac/ax/be capabilities and WiFi6/7 features.
+     * Called from refresh_radio_info() after fetching fresh DML data.
+     * 
+     * @return true if capabilities were successfully populated, false otherwise
+     */
+    bool populate_radio_capabilities_from_data_model();
+
+    /**
+     * @brief Update m_radio_info from data model
+     * 
+     * Synchronizes m_radio_info with the current state of the data model.
+     * Updates channel, bandwidth, frequency band, tx_power, channels_list, and VAPs.
+     * Called from refresh_radio_info() after populating capabilities.
+     */
+    void update_radio_info_from_data_model();
+ 
     int m_event_pipe[2];
+
+public:
+    /**
+     * @brief Virtual event handlers - called by bus callbacks (static free functions)
+     * Must be public so static free functions in ap_wlan_hal_onewifi.cpp can call them.
+     * Subclasses override these to implement role-specific handling.
+     */
+    virtual void on_onewifi_init_data(const char *json_str);
+    virtual void on_onewifi_north_data(const char *json_str, unsigned int len);
+    virtual void on_sta_assoc_data(const char *json_str, unsigned int len) {}
+    virtual void on_sta_assoc_status_data(const char *json_str, unsigned int len) {}
+    virtual void on_ap_metrics_data(const char *json_str, unsigned int len) {}
+    virtual void on_channel_scan_data(const char *json_str, unsigned int len) {}
+    virtual void on_beacon_report_data(const char *json_str, unsigned int len) {}
+    virtual void on_sta_link_metrics_data(const char *json_str, unsigned int len) {}
+
+protected:
     // wifi_bus_desc_t *m_bus_desc;
     // bus_handle_t m_bus_handle;
 
