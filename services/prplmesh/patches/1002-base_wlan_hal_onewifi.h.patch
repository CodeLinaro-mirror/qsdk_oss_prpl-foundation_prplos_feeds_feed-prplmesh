+
+    struct SharedResources {
+        std::shared_ptr<onewifi_data_model_t> data_model;
+        bus_handle_t bus_handle;
+        int ref_count;  // Track number of HALs using this resource
+
+        // Shared eventfds for inter-HAL communication
+        int mon_hal_event_fd;  // Monitor HAL creates and reads, AP HAL writes event types
+        int ap_hal_event_fd;   // AP HAL creates and reads, Monitor HAL can write if needed
+
+        SharedResources() : ref_count(0), mon_hal_event_fd(-1), ap_hal_event_fd(-1) {
+            memset(&bus_handle, 0, sizeof(bus_handle_t));
+        }
+
+        ~SharedResources() {
+            if (mon_hal_event_fd >= 0) {
+                close(mon_hal_event_fd);
+                mon_hal_event_fd = -1;
+            }
+            if (ap_hal_event_fd >= 0) {
+                close(ap_hal_event_fd);
+                ap_hal_event_fd = -1;
+            }
+        }
+    };
