+sMacAddr coordinated_tdma_task::get_bsta_mac_on_radio(const std::shared_ptr<Agent> &agent,
+                                                      const sMacAddr &radio_uid)
+{
+    if (!agent) {
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    // MLO backhaul: agent->backhaul.backhaul_interface may hold only the primary-link /
+    // bSTA MLD MAC address, which is not usable as a per-link BSTA MAC in the Co-TDMA TLVs.
+    // Resolve the affiliated link MAC for the requested radio_uid via the Station object:
+    // the root/parent Agent (owner of the AP MLD this bSTA is associated to) reports
+    // per-band affiliated link MACs for this bSTA MLD station via the Associated STA MLD
+    // Configuration Report TLV (tlvAssociatedStaMldConfigurationReport, parsed in
+    // topology_task::handle_assoc_sta_mld_configuration_tlv() -> db::update_assoc_sta_mld()),
+    // stored on the Station object (keyed by the bSTA's own MLD MAC,
+    // agent->bsta_mld.mld_info.mld_mac) under Station::sta_mld_configuration.affiliated_stas
+    // as {bssid, affiliated_sta_mac} pairs, where bssid is the ROOT's own per-band BSSID for
+    // that link.
+    //
+    // Match by band: radio_uid identifies one of THIS agent's own radios; resolve its band,
+    // then find the affiliated_stas entry whose bssid belongs to a radio of the SAME band
+    // (an MLO link operates on the same band at both ends).
+    if (agent->bsta_mld.ap_mld_mac != beerocks::net::network_utils::ZERO_MAC) {
+        auto local_radio_it = agent->radios.find(radio_uid);
+        if (local_radio_it != agent->radios.end() && local_radio_it->second) {
+            const auto local_band = local_radio_it->second->band;
+
+            const sMacAddr &bsta_mld_mac = agent->bsta_mld.mld_info.mld_mac;
+            auto bsta_station            = database.get_station(bsta_mld_mac);
+            if (bsta_station) {
+                for (const auto &affl_sta : bsta_station->sta_mld_configuration.affiliated_stas) {
+                    auto affl_bss = database.get_bss(affl_sta.bssid);
+                    if (affl_bss && affl_bss->radio.band == local_band &&
+                        affl_sta.affiliated_sta_mac != beerocks::net::network_utils::ZERO_MAC) {
+                        TASK_LOG(DEBUG) << "get_bsta_mac_on_radio: MLO backhaul, agent="
+                                       << agent->al_mac << " radio_uid=" << radio_uid
+                                       << " -> affiliated_sta_mac="
+                                       << affl_sta.affiliated_sta_mac;
+                        return affl_sta.affiliated_sta_mac;
+                    }
+                }
+            }
+        }
+
+        TASK_LOG(WARNING) << "get_bsta_mac_on_radio: agent=" << agent->al_mac
+                          << " has MLO backhaul (ap_mld_mac=" << agent->bsta_mld.ap_mld_mac
+                          << ") but no affiliated STA link found for radio_uid=" << radio_uid
+                          << ", falling back to legacy backhaul_interface="
+                          << agent->backhaul.backhaul_interface
+                          << " (this may be incorrect for this specific radio_uid in a "
+                             "multi-link scenario)";
+    }
+
+    // Legacy (SLO / non-MLO) wireless backhaul: backhaul_interface already holds the
+    // single bSTA interface MAC.
+    return agent->backhaul.backhaul_interface;
+}
