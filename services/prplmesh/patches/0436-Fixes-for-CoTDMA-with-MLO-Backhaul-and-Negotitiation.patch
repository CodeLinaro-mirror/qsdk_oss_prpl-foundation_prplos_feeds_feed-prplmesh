+                                    remote_bss
+                                        ? get_bsta_mac_on_radio(bssid_owner_agent,
+                                                                remote_bss->radio.radio_uid)
+                                        : bssid_owner_agent->backhaul.backhaul_interface;
+
+                                auto &pending_qmids = shared_it->second.pending_e2e_qmids;
+                                for (auto qmid_it = pending_qmids.begin();
+                                     qmid_it != pending_qmids.end();) {
+                                    sCoTDMAQMIDConfig qmid_config{};
+                                    qmid_config.bsta_mac = bssid_owner_bsta_mac;
+                                    qmid_config.qmid     = *qmid_it;
+                                    if (!send_cotdma_configuration_message(
+                                            local_bssid, remote_bssid,
+                                            static_cast<uint8_t>(wfa_map::eCoTDMAConfigMode::ADD),
+                                            nullptr, &qmid_config)) {
+                                        TASK_LOG(ERROR)
+                                            << "handle_mapc_negotiation_status: failed to send "
+                                               "Co-TDMA DL SCS MSDU forwarding configuration "
+                                               "for sharing_bssid="
