 void coordinated_tdma_task::log_mapc_sharing_bssids_map()
 {
     using sMapcSharedBss = Agent::sRadio::sBss::sMapcSharedBss;
diff --git a/controller/src/beerocks/master/tasks/coordinated_tdma_task.h b/controller/src/beerocks/master/tasks/coordinated_tdma_task.h
index a1ea43515..8ee824ce2 100644
--- a/controller/src/beerocks/master/tasks/coordinated_tdma_task.h
+++ b/controller/src/beerocks/master/tasks/coordinated_tdma_task.h
@@ -241,6 +241,43 @@ private:
     std::vector<sMacAddr> get_backhaul_radio_uids(const std::shared_ptr<Agent> &sharing_agent,
                                                   const std::shared_ptr<Agent> &shared_agent);
 
+    /**
+     * @brief Resolve the BSTA MAC address of @p agent on the same radio as @p radio_uid.
+     *
+     * The BSTA MAC address is the address of the (affiliated, in case of MLO) backhaul
+     * station link that must be reported in the Co-TDMA QMID configuration TLVs
+     * (sCoTDMAQMIDConfig::bsta_mac) for the "next repeater" (shared agent) in a multi-hop
+     * QoS path. That link must be on the same radio as the shared BSSID being configured.
+     *
+     * For a legacy (SLO / non-MLO) wireless backhaul, @p agent->backhaul.backhaul_interface
+     * already holds the single bSTA interface MAC and is returned directly.
+     *
+     * For an MLO backhaul (@p agent->bsta_mld.ap_mld_mac != ZERO_MAC),
+     * @p agent->backhaul.backhaul_interface may instead hold only the primary-link / bSTA
+     * MLD MAC address, which is not usable as a per-link BSTA MAC in the Co-TDMA TLVs. In
+     * that case, the affiliated link MAC is resolved via the Station object: the root/parent
+     * Agent (owner of the AP MLD @p agent's bSTA is associated to) reports per-band
+     * affiliated link MACs for this bSTA MLD station via the Associated STA MLD
+     * Configuration Report TLV (parsed in
+     * topology_task::handle_assoc_sta_mld_configuration_tlv() ->
+     * db::update_assoc_sta_mld()), stored on the Station object (keyed by
+     * @p agent->bsta_mld.mld_info.mld_mac) under Station::sta_mld_configuration.affiliated_stas
+     * as {bssid, affiliated_sta_mac} pairs, where bssid is the ROOT's own per-band BSSID for
+     * that link. @p radio_uid's band is resolved via @p agent->radios[radio_uid]->band and
+     * matched against the band of each affiliated_stas[].bssid's owning radio.
+     *
+     * If no matching affiliated link is found (e.g. the Station's MLD info has not yet been
+     * populated via a TOPOLOGY_RESPONSE_MESSAGE), falls back to
+     * @p agent->backhaul.backhaul_interface with a warning logged that this value may not
+     * correctly represent @p radio_uid specifically in a multi-link scenario.
+     *
+     * @param agent      Agent whose BSTA MAC is being resolved (the "next repeater").
+     * @param radio_uid  Radio UID the returned BSTA MAC must be on (the radio hosting the
+     *                   shared BSSID).
+     * @return Resolved BSTA MAC address, or ZERO_MAC if @p agent is null.
+     */
+    sMacAddr get_bsta_mac_on_radio(const std::shared_ptr<Agent> &agent, const sMacAddr &radio_uid);
+
     /**
      * @brief Debug helper: dump the full MAPC sharing/shared BSSID map for every Agent
      * currently known in the Controller DB.
@@ -322,6 +359,12 @@ private:
     db &database;
     ieee1905_1::CmduMessageTx &cmdu_tx;
     task_pool &tasks;
+
+    enum eNegotiationState : uint8_t {
+        UNESTABLISHED = 0,
+        PENDING       = 1,
+        ESTABLISHED   = 2,
+    };
 };
 
