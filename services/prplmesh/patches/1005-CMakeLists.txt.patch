From 356799e2e232db9c66d6dbaffd0a6754ef5ef9b8 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Tue, 12 May 2026 12:16:40 +0530
Subject: [PATCH 07/11] Update CMakeLists.txt for onewifi build configuration

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 common/beerocks/bwl/onewifi/CMakeLists.txt | 108 ++++++++++++++++++++-
 1 file changed, 105 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/onewifi/CMakeLists.txt b/common/beerocks/bwl/onewifi/CMakeLists.txt
index 4fdd9adaf..6520f3aab 100644
--- a/common/beerocks/bwl/onewifi/CMakeLists.txt
+++ b/common/beerocks/bwl/onewifi/CMakeLists.txt
@@ -13,21 +13,34 @@ set(ONEWIFI_SOURCES
     "nl80211_client_factory_onewifi.cpp"
 )
 
+# NOTE: Do NOT compile OneWifi's bus.c - it uses incompatible bus_data_prop_t type
+# Instead, link against libwifi_bus.so which provides get_bus_descriptor() and bus functions
+# This library is built separately and available in the sysroot
+message(STATUS "Using libwifi_bus from sysroot (provides get_bus_descriptor())")
+
 # Create a list of the header files
 set(ONEWIFI_HEADERS
     "base_wlan_hal_onewifi.h"
     "ap_wlan_hal_onewifi.h"
     "sta_wlan_hal_onewifi.h"
+    "onewifi_data_model.h"
 )
 
 # Create the library
 add_library(${ONEWIFI_LIBRARY_NAME} ${ONEWIFI_SOURCES} ${ONEWIFI_HEADERS})
 
+# Find cJSON library
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(CJSON REQUIRED libcjson)
+
 # Link libraries
 target_link_libraries(${ONEWIFI_LIBRARY_NAME}
     PRIVATE
         bpl
-        rbus # Placeholder, should be found by pkg-config
+        wifi_webconfig
+        rbus
+        wifi_bus  # Provides get_bus_descriptor() and CCSP bus implementation
+        ${CJSON_LIBRARIES}
 )
 
 # Set the include path
@@ -40,8 +53,97 @@ target_include_directories(${ONEWIFI_LIBRARY_NAME}
         "${CMAKE_SOURCE_DIR}/framework/tlvf/src/include"
         "${CMAKE_SOURCE_DIR}/common/beerocks/bcl/include"
         "${CMAKE_SOURCE_DIR}/framework/external/easylogging"
-        "${ONEWIFI_SRC_DIR}/include"
-        "${ONEWIFI_SRC_DIR}/source/utils"
+	"${CJSON_INCLUDE_DIRS}"
     PRIVATE
         "${CMAKE_CURRENT_SOURCE_DIR}"
 )
+
+# ============================================================================
+# CRITICAL INCLUDE ORDER: OneWifi source paths MUST come before qcapps sysroot
+# paths to ensure the correct bus_common.h (with bus_data_prop_t) is found.
+# The qcapps sysroot has an older bus_common.h that lacks bus_data_prop_t.
+# ============================================================================
+
+# Step 1: Compute ONEWIFI_ACTUAL_SRC first
+message(STATUS "=== OneWifi Configuration Debug ===")
+message(STATUS "ONEWIFI_SRC_DIR defined: ${ONEWIFI_SRC_DIR}")
+message(STATUS "ENV ONEWIFI_SRC_DIR: $ENV{ONEWIFI_SRC_DIR}")
+
+if(DEFINED ONEWIFI_SRC_DIR)
+    message(STATUS "Checking for webconfig_external_proto_easymesh.h in:")
+    message(STATUS "  1. ${ONEWIFI_SRC_DIR}/include/webconfig_external_proto_easymesh.h")
+    message(STATUS "  2. ${ONEWIFI_SRC_DIR}/git/include/webconfig_external_proto_easymesh.h")
+
+    if(EXISTS "${ONEWIFI_SRC_DIR}/include/webconfig_external_proto_easymesh.h")
+        set(ONEWIFI_ACTUAL_SRC "${ONEWIFI_SRC_DIR}")
+        message(STATUS "Found header at: ${ONEWIFI_SRC_DIR}/include/")
+    elseif(EXISTS "${ONEWIFI_SRC_DIR}/git/include/webconfig_external_proto_easymesh.h")
+        set(ONEWIFI_ACTUAL_SRC "${ONEWIFI_SRC_DIR}/git")
+        message(STATUS "Found header at: ${ONEWIFI_SRC_DIR}/git/include/")
+    else()
+        message(WARNING "OneWifi headers not found in ${ONEWIFI_SRC_DIR} or ${ONEWIFI_SRC_DIR}/git")
+        set(ONEWIFI_ACTUAL_SRC "")
+    endif()
+else()
+    message(WARNING "ONEWIFI_SRC_DIR not set. OneWifi headers may not be found.")
+    set(ONEWIFI_ACTUAL_SRC "")
+endif()
+message(STATUS "=== End OneWifi Configuration ===")
+
+# Step 2: Add OneWifi source/platform/common FIRST (has correct bus_common.h with bus_data_prop_t)
+if(ONEWIFI_ACTUAL_SRC)
+    target_include_directories(${ONEWIFI_LIBRARY_NAME}
+        PUBLIC
+            "${ONEWIFI_ACTUAL_SRC}/include"
+            "${ONEWIFI_ACTUAL_SRC}/source/utils"
+            "${ONEWIFI_ACTUAL_SRC}/source/platform/common"
+            "${ONEWIFI_ACTUAL_SRC}/source/platform/common/data_model"
+            "${ONEWIFI_ACTUAL_SRC}/source/platform/rdkb"
+            "${ONEWIFI_ACTUAL_SRC}/source/webconfig"
+    )
+    message(STATUS "OneWifi source directory: ${ONEWIFI_ACTUAL_SRC}")
+    message(STATUS "Added include paths (BEFORE qcapps sysroot):")
+    message(STATUS "  - ${ONEWIFI_ACTUAL_SRC}/source/platform/common  <-- correct bus_common.h")
+endif()
+
+# Step 3: Add ccsp-one-wifi-libwebconfig recipe-sysroot includes
+if(DEFINED ONEWIFI_SRC_DIR)
+    if(EXISTS "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include/ccsp")
+        target_include_directories(${ONEWIFI_LIBRARY_NAME}
+            PUBLIC
+                "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include"
+                "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include/ccsp"
+        )
+        message(STATUS "Added ccsp-one-wifi-libwebconfig include: ${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include")
+        message(STATUS "  This includes unified-wifi-mesh headers (em_base.h, etc.)")
+    endif()
+endif()
+
+# Add RDK controller include path if available
+if(EXISTS "${CMAKE_SOURCE_DIR}/../rdk_controller/inc")
+    target_include_directories(${ONEWIFI_LIBRARY_NAME}
+        PRIVATE
+            "${CMAKE_SOURCE_DIR}/../rdk_controller/inc"
+    )
+    message(STATUS "Added RDK controller include: ${CMAKE_SOURCE_DIR}/../rdk_controller/inc")
+endif()
+
+# Step 4: Add qcapps CCSP and RBUS include paths LAST
+# These come AFTER OneWifi source/platform/common so the correct bus_common.h is found first.
+if(DEFINED ENV{SYSROOT_DIR})
+    target_include_directories(${ONEWIFI_LIBRARY_NAME}
+        PRIVATE
+            "$ENV{SYSROOT_DIR}/usr/include/ccsp"
+            "$ENV{SYSROOT_DIR}/usr/include/rbus"
+    )
+    message(STATUS "Added CCSP include path (after OneWifi): $ENV{SYSROOT_DIR}/usr/include/ccsp")
+    message(STATUS "Added RBUS include path: $ENV{SYSROOT_DIR}/usr/include/rbus")
+endif()
+
+# Install the library
+install(
+    TARGETS ${ONEWIFI_LIBRARY_NAME}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
-- 
2.34.1

