From e3d8da1fd414fb2b811b2fc9250bce24b48f7060 Mon Sep 17 00:00:00 2001
From: Sandeep Tomer <stomer@qti.qualcomm.com>
Date: Fri, 13 Nov 2026 16:08:38 +0530
Subject: [PATCH] prplMesh: use client MLD MAC in tunneled Source Info

An MLO Association Request is transmitted by an affiliated STA, so its
802.11 source address is a per-link MAC address. EasyMesh identifies the
associated client MLD by its STA MLD MAC in the Tunneled Message Source
Info TLV.

The nl80211 management-frame path retained the 802.11 source address and
AP Manager copied it directly into the Source Info TLV. As a result, the
Tunneled Message reported the link MAC even though the Basic Multi-Link
Element in the tunneled Association Request contained the STA MLD MAC.

For Association and Reassociation Requests, extract the STA MLD MAC from
the frame body's Basic Multi-Link Element and use it in the Source Info
TLV. Keep the original source address as the fallback for legacy clients
and malformed or unsupported Multi-Link Elements. Do not change the
link-MAC-keyed association-frame cache.

Signed-off-by: Sandeep Tomer <stomer@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 1d97d25f7..31f2784fa 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -12,6 +12,7 @@
 #include <fstream>
 #include <string>
 
+#include <bwl/assoc_frame_db.h>
 #include <bwl/base_wlan_hal_types.h>
 #include "../../slave/agent_db.h"
 #include <bcl/beerocks_defines.h>
@@ -5329,8 +5330,22 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
             return false;
         }
 
-        // Store the MAC address of the transmitting station
-        source_info_tlv->mac() = mgmt_frame->mac;
+        // The 802.11 source address identifies the transmitting affiliated STA. For an
+        // MLO (re)association, EasyMesh identifies the client by its STA MLD MAC, which
+        // is carried in the Basic Multi-Link Element in the frame body. Keep the link
+        // MAC as the fallback for legacy STAs and malformed or unsupported MLEs.
+        auto tunnelled_source_mac = mgmt_frame->mac;
+        if (mgmt_frame->type == bwl::eManagementFrameType::ASSOCIATION_REQUEST ||
+            mgmt_frame->type == bwl::eManagementFrameType::REASSOCIATION_REQUEST) {
+            std::string sta_mld_mac;
+            if (bwl::extract_mld_mac_from_assoc_frame(mgmt_frame->data, sta_mld_mac)) {
+                tunnelled_source_mac = tlvf::mac_from_string(sta_mld_mac);
+                LOG(DEBUG) << "Using STA MLD MAC " << tunnelled_source_mac
+                           << " instead of association-frame link MAC " << mgmt_frame->mac
+                           << " in Tunnelled Source Info TLV";
+            }
+        }
+        source_info_tlv->mac() = tunnelled_source_mac;
 
         // Add the Type TLV
         auto type_tlv = cmdu_tx.addClass<wfa_map::tlvTunnelledProtocolType>();
-- 
