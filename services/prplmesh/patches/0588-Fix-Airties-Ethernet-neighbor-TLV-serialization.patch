From 7ee3eb735dc212e8f4d915e940eb2a05ecc6483e Mon Sep 17 00:00:00 2001
From: Aryan Khare <aryakhar@qti.qualcomm.com>
Date: Wed, 11 Nov 2026 11:58:44 +0530
Subject: [PATCH] Fix Airties Ethernet neighbor TLV serialization

Use TLVF list allocation to set the advertised neighbor count for 1905 and
non-1905 Ethernet neighbor lists. Add diagnostics for neighbor collection,
MAC serialization, and port-entry insertion.

Signed-off-by: Aryan Khare <aryakhar@qti.qualcomm.com>
---
 .../airties/src/tlvf_airties_utils.cpp        |  83 ++++++-------
 .../src/tlvf_airties_utils_nl80211.cpp        | 115 ++++++++++++++----
 2 files changed, 133 insertions(+), 65 deletions(-)

diff --git a/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp b/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
index f6fd0e384..ed1f70187 100644
--- a/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
+++ b/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
@@ -83,16 +83,6 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
     // Build port entries with 1905 AL neighbor information
     uint8_t added_ports = 0;
     for (const auto &ifname : lan_ifaces) {
-        auto port_entry = tlvNeighborList->create_port_entries();
-        if (!port_entry) {
-            LOG(ERROR) << "[TLV:1905-NEIGH] create_port_entries() FAILED for ifname=" << ifname;
-            continue;
-        }
-
-        // Get port identifier using system function
-        uint8_t port_id_u8 = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
-        port_entry->port_id() = port_id_u8;
-
         // Get interface MAC using system function
         std::string iface_mac_str;
         sMacAddr local_iface_mac = {};
@@ -120,21 +110,28 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
             }
         }
 
-        // Add neighbor MAC list to port entry
+        // Only create a port entry when it has connected 1905 neighbors.
         const uint8_t num_neighbor = static_cast<uint8_t>(std::min<size_t>(al_neighbors.size(), 0xFF));
+        if (num_neighbor == 0) {
+            continue;
+        }
 
-        if (num_neighbor > 0) {
-            if (!port_entry->alloc_neighbor_al_mac_list(num_neighbor)) {
-                LOG(ERROR) << "[TLV:1905-NEIGH] alloc_neighbor_al_mac_list(" << int(num_neighbor)
-                           << ") failed for ifname=" << ifname;
-                port_entry->num_of_neighbor_al_macs() = 0;
-            } else {
-                for (size_t i = 0; i < num_neighbor; ++i) {
-                    auto tup = port_entry->neighbor_al_mac_list(i);
-                    if (std::get<0>(tup)) {
-                        std::get<1>(tup) = al_neighbors[i];
-                    }
-                }
+        auto port_entry = tlvNeighborList->create_port_entries();
+        if (!port_entry) {
+            LOG(ERROR) << "[TLV:1905-NEIGH] create_port_entries() FAILED for ifname=" << ifname;
+            continue;
+        }
+        port_entry->port_id() = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
+
+        if (!port_entry->alloc_neighbor_al_mac_list(num_neighbor)) {
+            LOG(ERROR) << "[TLV:1905-NEIGH] alloc_neighbor_al_mac_list(" << int(num_neighbor)
+                       << ") failed for ifname=" << ifname;
+            continue;
+        }
+        for (size_t i = 0; i < num_neighbor; ++i) {
+            auto tup = port_entry->neighbor_al_mac_list(i);
+            if (std::get<0>(tup)) {
+                std::get<1>(tup) = al_neighbors[i];
             }
         }
 
@@ -222,16 +219,6 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
     // Build port entries with non-1905 neighbor information
     uint8_t added_ports = 0;
     for (const auto &ifname : lan_ifaces) {
-        auto port_entry = tlvNon1905->create_port_entries();
-        if (!port_entry) {
-            LOG(ERROR) << "[TLV:NON1905-NEIGH] create_port_entries() FAILED for " << ifname;
-            continue;
-        }
-
-        // Get port identifier using system function
-        uint8_t port_id_u8 = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
-        port_entry->port_id() = port_id_u8;
-
         // Query FDB and filter out known 1905 AL neighbors
         std::string iface_mac_str;
         std::vector<sMacAddr> non1905_list;
@@ -284,19 +271,29 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
             }
         }
 
-        // Add filtered neighbor MAC list to port entry
+        // Only create a port entry when it has connected non-1905 neighbors.
         const uint8_t num_neighbor = static_cast<uint8_t>(std::min<size_t>(non1905_list.size(), 0xFF));
+        if (num_neighbor == 0) {
+            continue;
+        }
 
-        if (num_neighbor > 0 && !port_entry->alloc_non1905_neighbor_mac_list(num_neighbor)) {
+        auto port_entry = tlvNon1905->create_port_entries();
+        if (!port_entry) {
+            LOG(ERROR) << "[TLV:NON1905-NEIGH] create_port_entries() FAILED for " << ifname;
+            continue;
+        }
+        port_entry->port_id() = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
+
+        // Add filtered neighbor MAC list to port entry
+        if (!port_entry->alloc_non1905_neighbor_mac_list(num_neighbor)) {
             LOG(ERROR) << "[TLV:NON1905-NEIGH] alloc_non1905_neighbor_mac_list(" << int(num_neighbor)
                        << ") failed for " << ifname;
-            port_entry->num_of_non1905_neighbor_macs() = 0;
-        } else if (num_neighbor > 0) {
-            for (size_t i = 0; i < num_neighbor; ++i) {
-                auto tup = port_entry->non1905_neighbor_mac_list(i);
-                if (std::get<0>(tup)) {
-                    std::get<1>(tup) = non1905_list[i];
-                }
+            continue;
+        }
+        for (size_t i = 0; i < num_neighbor; ++i) {
+            auto tup = port_entry->non1905_neighbor_mac_list(i);
+            if (std::get<0>(tup)) {
+                std::get<1>(tup) = non1905_list[i];
             }
         }
 
@@ -315,7 +312,7 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
 
 /*
  * This Macro is to enable or disable
- * a bit in an octet. This is used for setting 
+ * a bit in an octet. This is used for setting
  * Gateway/Extender information in Device Info TLV.
  */
 #define TLV_BIT_ENABLE 0x1
diff --git a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
index 5e54f0294..3ab878490 100644
--- a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
+++ b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
@@ -1054,18 +1054,15 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
     // Use system functions to get LAN interfaces instead of manual getifaddrs()
     auto lan_ifaces = beerocks::net::network_utils::linux_get_lan_interfaces();
 
+    LOG(INFO) << "[TLV:1905-NEIGH] LAN interfaces=" << lan_ifaces.size();
+
     // Build port entries with 1905 AL neighbor information
     uint8_t added_ports = 0;
     for (const auto &ifname : lan_ifaces) {
-        auto port_entry = tlvNeighborList->create_port_entries();
-        if (!port_entry) {
-            LOG(ERROR) << "[TLV:1905-NEIGH] create_port_entries() FAILED for ifname=" << ifname;
-            continue;
-        }
-
+        LOG(INFO) << "[TLV:1905-NEIGH] Processing interface=" << ifname;
         // Get port identifier using system function
         uint8_t port_id_u8 = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
-        port_entry->port_id() = port_id_u8;
+        std::shared_ptr<airties::cNeighborPortEntry> port_entry;
 
         // Get interface MAC using system function
         std::string iface_mac_str;
@@ -1074,9 +1071,14 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
 
         if (beerocks::net::network_utils::linux_iface_get_mac(ifname, iface_mac_str)) {
             local_iface_mac = tlvf::mac_from_string(iface_mac_str);
+            LOG(INFO) << "[TLV:1905-NEIGH] interface=" << ifname
+                      << " port_id=" << int(port_id_u8)
+                      << " local_mac=" << local_iface_mac;
 
             // Query AgentDB for 1905 AL neighbors behind this interface
             auto db = beerocks::AgentDB::get();
+            LOG(INFO) << "[TLV:1905-NEIGH] AgentDB neighbor interfaces="
+                      << db->neighbor_devices.size();
             auto it = db->neighbor_devices.find(local_iface_mac);
             if (it != db->neighbor_devices.end()) {
                 const auto &neighbors_by_al_mac = it->second;
@@ -1089,18 +1091,38 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
 
         // Add neighbor MAC list to port entry
         const uint8_t num_neighbor = static_cast<uint8_t>(std::min<size_t>(al_neighbors.size(), 0xFF));
-        port_entry->num_of_neighbor_al_macs() = num_neighbor;
+        LOG(INFO) << "[TLV:1905-NEIGH] interface=" << ifname
+                  << " collected_neighbors=" << al_neighbors.size()
+                  << " serialized_neighbors=" << int(num_neighbor);
+        for (size_t i = 0; i < al_neighbors.size(); ++i) {
+            LOG(INFO) << "[TLV:1905-NEIGH] interface=" << ifname
+                      << " neighbor[" << i << "]=" << al_neighbors[i];
+        }
 
         if (num_neighbor > 0) {
+            port_entry = tlvNeighborList->create_port_entries();
+            if (!port_entry) {
+                LOG(ERROR) << "[TLV:1905-NEIGH] create_port_entries() FAILED for ifname=" << ifname;
+                continue;
+            }
+            port_entry->port_id() = port_id_u8;
+
             if (!port_entry->alloc_neighbor_al_mac_list(num_neighbor)) {
                 LOG(ERROR) << "[TLV:1905-NEIGH] alloc_neighbor_al_mac_list(" << int(num_neighbor)
                            << ") failed for ifname=" << ifname;
                 port_entry->num_of_neighbor_al_macs() = 0;
             } else {
+                LOG(INFO) << "[TLV:1905-NEIGH] interface=" << ifname
+                          << " count_after_alloc=" << int(port_entry->num_of_neighbor_al_macs());
                 for (size_t i = 0; i < num_neighbor; ++i) {
                     auto tup = port_entry->neighbor_al_mac_list(i);
                     if (std::get<0>(tup)) {
                         std::get<1>(tup) = al_neighbors[i];
+                        LOG(INFO) << "[TLV:1905-NEIGH] interface=" << ifname
+                                  << " serialized_neighbor[" << i << "]=" << std::get<1>(tup);
+                    } else {
+                        LOG(ERROR) << "[TLV:1905-NEIGH] interface=" << ifname
+                                   << " neighbor list access failed at index=" << i;
                     }
                 }
             }
@@ -1113,8 +1135,22 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
             ++added_ports;
         }
 #else
-        tlvNeighborList->add_port_entries(port_entry);
-        ++added_ports;
+        // Only add ports that have connected 1905 neighbors.
+        if (num_neighbor > 0) {
+            if (added_ports == UINT8_MAX) {
+                LOG(ERROR) << "[TLV:1905-NEIGH] maximum port count reached";
+                break;
+            }
+            if (!tlvNeighborList->add_port_entries(port_entry)) {
+                LOG(ERROR) << "[TLV:1905-NEIGH] add_port_entries() failed for ifname=" << ifname;
+                continue;
+            }
+            ++added_ports;
+            LOG(INFO) << "[TLV:1905-NEIGH] Added port interface=" << ifname
+                      << " port_id=" << int(port_id_u8)
+                      << " count=" << int(port_entry->num_of_neighbor_al_macs())
+                      << " total_ports=" << int(added_ports);
+        }
 #endif
     }
 
@@ -1191,28 +1227,25 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
         pclose(fp);
         return macs;
     };
-    
+
+    LOG(INFO) << "[TLV:NON1905-NEIGH] LAN interfaces=" << lan_ifaces.size();
+
     // Build port entries with non-1905 neighbor information
     uint8_t added_ports = 0;
     for (const auto &ifname : lan_ifaces) {
-        auto port_entry = tlvNon1905->create_port_entries();
-        if (!port_entry) {
-            LOG(ERROR) << "[TLV:NON1905-NEIGH] create_port_entries() FAILED for " << ifname;
-            continue;
-        }
-
+        LOG(INFO) << "[TLV:NON1905-NEIGH] Processing interface=" << ifname;
         // Get port identifier using system function
         uint8_t port_id_u8 = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
-        port_entry->port_id() = port_id_u8;
+        std::shared_ptr<airties::cNon1905NeighborPortEntry> port_entry;
 
         // Query FDB and filter out known 1905 AL neighbors
         std::string iface_mac_str;
         std::vector<sMacAddr> non1905_list;
+        std::vector<sMacAddr> known_1905_al;
 
         if (beerocks::net::network_utils::linux_iface_get_mac(ifname, iface_mac_str)) {
             sMacAddr local_iface_mac = tlvf::mac_from_string(iface_mac_str);
             auto db = beerocks::AgentDB::get();
-            std::vector<sMacAddr> known_1905_al;
             auto it = db->neighbor_devices.find(local_iface_mac);
             if (it != db->neighbor_devices.end()) {
                 const auto &neighbors_by_al = it->second;
@@ -1252,17 +1285,41 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
 
         // Add filtered neighbor MAC list to port entry
         const uint8_t num_neighbor = static_cast<uint8_t>(std::min<size_t>(non1905_list.size(), 0xFF));
-        port_entry->num_of_non1905_neighbor_macs() = num_neighbor;
+        if (num_neighbor > 0) {
+            port_entry = tlvNon1905->create_port_entries();
+            if (!port_entry) {
+                LOG(ERROR) << "[TLV:NON1905-NEIGH] create_port_entries() FAILED for " << ifname;
+                continue;
+            }
+            port_entry->port_id() = port_id_u8;
+        }
+        LOG(INFO) << "[TLV:NON1905-NEIGH] interface=" << ifname
+                  << " local_mac=" << iface_mac_str
+                  << " known_1905_neighbors=" << known_1905_al.size()
+                  << " collected_neighbors=" << non1905_list.size()
+                  << " serialized_neighbors=" << int(num_neighbor);
+        for (size_t i = 0; i < non1905_list.size(); ++i) {
+            LOG(INFO) << "[TLV:NON1905-NEIGH] interface=" << ifname
+                      << " neighbor[" << i << "]=" << non1905_list[i];
+        }
 
         if (num_neighbor > 0 && !port_entry->alloc_non1905_neighbor_mac_list(num_neighbor)) {
             LOG(ERROR) << "[TLV:NON1905-NEIGH] alloc_non1905_neighbor_mac_list(" << int(num_neighbor)
                        << ") failed for " << ifname;
             port_entry->num_of_non1905_neighbor_macs() = 0;
         } else if (num_neighbor > 0) {
+            LOG(INFO) << "[TLV:NON1905-NEIGH] interface=" << ifname
+                      << " count_after_alloc="
+                      << int(port_entry->num_of_non1905_neighbor_macs());
             for (size_t i = 0; i < num_neighbor; ++i) {
                 auto tup = port_entry->non1905_neighbor_mac_list(i);
                 if (std::get<0>(tup)) {
                     std::get<1>(tup) = non1905_list[i];
+                    LOG(INFO) << "[TLV:NON1905-NEIGH] interface=" << ifname
+                              << " serialized_neighbor[" << i << "]=" << std::get<1>(tup);
+                } else {
+                    LOG(ERROR) << "[TLV:NON1905-NEIGH] interface=" << ifname
+                               << " neighbor list access failed at index=" << i;
                 }
             }
         }
@@ -1274,8 +1331,22 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
             ++added_ports;
         }
 #else
-        tlvNon1905->add_port_entries(port_entry);
-        ++added_ports;
+        // Only add ports that have connected non-1905 neighbors.
+        if (num_neighbor > 0) {
+            if (added_ports == UINT8_MAX) {
+                LOG(ERROR) << "[TLV:NON1905-NEIGH] maximum port count reached";
+                break;
+            }
+            if (!tlvNon1905->add_port_entries(port_entry)) {
+                LOG(ERROR) << "[TLV:NON1905-NEIGH] add_port_entries() failed for ifname=" << ifname;
+                continue;
+            }
+            ++added_ports;
+            LOG(INFO) << "[TLV:NON1905-NEIGH] Added port interface=" << ifname
+                      << " port_id=" << int(port_id_u8)
+                      << " count=" << int(port_entry->num_of_non1905_neighbor_macs())
+                      << " total_ports=" << int(added_ports);
+        }
 #endif
     }
 
-- 
