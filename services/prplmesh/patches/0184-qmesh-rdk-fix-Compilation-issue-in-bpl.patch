From 64834bf2891107d0bc4029bf430a7858eba3a594 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Tue, 2 Jun 2026 19:49:49 +0530
Subject: [PATCH 1/3] Fix Compilation issue in bpl

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 framework/platform/CMakeLists.txt          |  4 +++-
 framework/platform/bpl/cfg/rdk/bpl_cfg.cpp | 20 ++++++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/framework/platform/CMakeLists.txt b/framework/platform/CMakeLists.txt
index 9ab6d4ac4..f6049a23d 100644
--- a/framework/platform/CMakeLists.txt
+++ b/framework/platform/CMakeLists.txt
@@ -10,4 +10,6 @@ else()
 	add_subdirectory(nbapi)
 endif()
 
-add_subdirectory(mqttapi)
+if (NOT TARGET_PLATFORM STREQUAL "rdkb")
+	add_subdirectory(mqttapi)
+endif()
diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
index 7db6e5d4b..84532380e 100644
--- a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
@@ -1519,5 +1519,25 @@ bool bpl_cfg_set_ssid_advertisement(const std::string & /*iface*/, bool /*ssid_a
     return true;
 }
 
+bool cfg_get_dhcp_gateway_ip(std::string &gw_ip)
+{
+    std::string cmd = "ip r | awk '/^def/{print $3}'";
+    FILE *fp = popen(cmd.c_str(), "r");
+    if (fp) {
+        char buffer[128];
+        if (fgets(buffer, sizeof(buffer), fp) != nullptr) {
+            gw_ip = buffer;
+            gw_ip.erase(gw_ip.find_last_not_of(" \n\r\t") + 1);
+            LOG(DEBUG) << "cfg_get_dhcp_gateway_ip: Command output [" << cmd << "]: " << gw_ip;
+        }
+        pclose(fp);
+    }
+    if (gw_ip.empty()) {
+        LOG(ERROR) << "cfg_get_dhcp_gateway_ip: Could not resolve gateway IP from command: " << cmd;
+        return false;
+    }
+    return true;
+}
+
 } // namespace bpl
 } // namespace beerocks
