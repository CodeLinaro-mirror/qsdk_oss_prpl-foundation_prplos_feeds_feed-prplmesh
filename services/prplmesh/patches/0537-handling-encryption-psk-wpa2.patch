From 3db717d88a6cf24e3a23bffe6705f1db8fa175b9 Mon Sep 17 00:00:00 2001
From: athitia prakash <athiprak@qti.qualcomm.com>
Date: Wed, 14 Oct 2026 17:33:43 +0530
Subject: [PATCH] handling a encryption

Signed-off-by: athitia prakash <athiprak@qti.qualcomm.com>
---
 framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index dedd357ad..a8ef0d4f7 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -423,7 +423,7 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
     auto get_authentication_type = [&](const std::string &encryption) {
         if ("none" == encryption || encryption.empty()) {
             return WSC::eWscAuth::WSC_AUTH_OPEN;
-        } else if (starts_with("psk2", encryption)) {
+        } else if (starts_with("psk2", encryption) || "psk+wpa2" == encryption) {
             return WSC::eWscAuth::WSC_AUTH_WPA2PSK;
         } else if ("sae" == encryption) {
             return WSC::eWscAuth::WSC_AUTH_SAE;
@@ -445,7 +445,7 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
             return WSC::eWscEncr::WSC_ENCR_NONE;
         } else if (contains("+tkip", encryption)) {
             return WSC::eWscEncr::WSC_ENCR_TKIP;
-        } else if (("psk2" == encryption) || ("sae" == encryption) ||
+        } else if (("psk2" == encryption) || ("psk+wpa2" == encryption) || ("sae" == encryption) ||
                    contains("+aes", encryption) || contains("+ccmp", encryption) || ("sae-mixed" == encryption)) {
             return WSC::eWscEncr::WSC_ENCR_AES;
         } else if (("akm24-sae-mixed" == encryption) || ("sae-sae_ext_key" == encryption) || ("sae-ext-key" == encryption)) {
-- 
