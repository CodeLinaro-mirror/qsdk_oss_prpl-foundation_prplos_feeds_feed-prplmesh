From b1930f5ab22263c6b8fd0ab274f2d330a9b139fd Mon Sep 17 00:00:00 2001
From: Ameya Phadke <phadke@qti.qualcomm.com>
Date: Fri, 23 Oct 2026 15:47:55 -0700
Subject: [PATCH] Health Monitor add SmdFailure event support

Signed-off-by: Ameya Phadke <phadke@qti.qualcomm.com>
---
 agent/src/beerocks/slave/agent_db.cpp         | 47 +++++++++++++++++++
 agent/src/beerocks/slave/agent_db.h           | 18 +++++++
 .../src/beerocks/slave/nbapi/odl/agent.odl.in |  7 +++
 .../slave/tasks/health_monitoring_task.cpp    | 16 +++++++
 .../slave/tasks/health_monitoring_task.h      | 27 ++++++++++-
 5 files changed, 114 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/agent_db.cpp b/agent/src/beerocks/slave/agent_db.cpp
index b946a7241..f609e0005 100644
--- a/agent/src/beerocks/slave/agent_db.cpp
+++ b/agent/src/beerocks/slave/agent_db.cpp
@@ -1000,4 +1000,51 @@ void AgentDB::dm_trigger_scs_install_result_event(uint64_t incident_id,
 #endif // ENABLE_NBAPI
 }
 
+void AgentDB::dm_trigger_smd_failure_event(uint64_t incident_id, const std::string &detected_by,
+                                           const sMacAddr &smd_identifier,
+                                           const std::string &stage, const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    LOG_IF(!m_ambiorix_datamodel, FATAL) << "m_ambiorix_datamodel not set";
+
+    const std::string controller_id      = tlvf::mac_to_string(controller_info.bridge_mac);
+    const std::string smd_identifier_str = tlvf::mac_to_string(smd_identifier);
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress",    controller_id.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",        AGENT_ROOT_DM ".QCOM_Vendor.");
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID",    incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy",    detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "SMDIdentifier", smd_identifier_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Stage",         stage.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason",        reason.c_str());
+
+    const std::string vendor_event_obj = AGENT_ROOT_DM ".QCOM_Vendor.SmdFailure";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_smd_failure_event: failed to trigger SmdFailure"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " smd_identifier=" << smd_identifier_str << " stage=" << stage
+                   << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_smd_failure_event: triggered SmdFailure"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " smd_identifier=" << smd_identifier_str << " stage=" << stage
+                   << " reason=" << reason;
+    }
+#else
+    (void)incident_id;
+    (void)detected_by;
+    (void)smd_identifier;
+    (void)stage;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
+
 } // namespace beerocks
diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index 73c722dda..fb017cc15 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -1301,6 +1301,24 @@ public:
                                          const sMacAddr &local_bssid, const sMacAddr &peer_bssid,
                                          const std::string &stage, const std::string &reason);
 
+    /**
+     * @brief Trigger the SmdFailure vendor event.
+     *
+     * Generic SMD failure event; `stage` differentiates the failing step for the Debug
+     * Agent/cloud consumer.
+     *
+     * @param incident_id Locally-generated incident ID for this diagnostic event.
+     * @param detected_by AL-MAC of the device that detected the condition (this agent).
+     * @param smd_identifier SMD identifier in scope, or ZERO_MAC if not applicable.
+     * @param stage Stage identifier (e.g. "SMD_ONBOARDING", "SMD_NBR_DB_TIMEOUT",
+     *              "SMD_NBR_DB_PUBLISH", "SMD_NBR_DB_RESP_STATUS",
+     *              "SMD_NBR_DB_VALIDATION", "SMD_LOCAL_NBR_INFO_SEND").
+     * @param reason Human-readable failure reason.
+     */
+    void dm_trigger_smd_failure_event(uint64_t incident_id, const std::string &detected_by,
+                                      const sMacAddr &smd_identifier, const std::string &stage,
+                                      const std::string &reason);
+
     /**
      * @brief 1905.1 Neighbor device information
      * Information gathered from a neighbor device upon reception of a Topology Discovery message.
diff --git a/agent/src/beerocks/slave/nbapi/odl/agent.odl.in b/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
index 3140ac299..6db9b7aaf 100644
--- a/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
+++ b/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
@@ -191,6 +191,13 @@
             object SCSInstallResult {
             }
 
+            /* Vendor event: generic SMD failure event; the Stage field differentiates
+               the failing step (e.g. SMD_ONBOARDING, SMD_NBR_DB_TIMEOUT,
+               SMD_NBR_DB_PUBLISH, SMD_NBR_DB_RESP_STATUS, SMD_NBR_DB_VALIDATION,
+               SMD_LOCAL_NBR_INFO_SEND) */
+            object SmdFailure {
+            }
+
         }
 
     @AGENT_ROOT_DM_Footer@
diff --git a/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp b/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp
index e24676c4f..71af233fb 100644
--- a/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp
+++ b/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp
@@ -125,6 +125,22 @@ void HealthMonitoringTask::handle_event(uint8_t event_enum_value, const void *ev
                                              event->scsid, event->qmid, event->success);
         break;
     }
+    case eEvent::SMD_FAILURE: {
+        auto event = static_cast<const sSmdFailureEvent *>(event_obj);
+        if (!event) {
+            LOG(ERROR) << "HEALTH_MONITORING: SMD_FAILURE event_obj is nullptr";
+            break;
+        }
+
+        LOG(DEBUG) << "HEALTH_MONITORING: SMD_FAILURE smd_identifier=" << event->smd_identifier
+                   << " stage=" << event->stage << " reason=" << event->reason;
+
+        auto db = AgentDB::get();
+        db->dm_trigger_smd_failure_event(generate_incident_id(),
+                                         tlvf::mac_to_string(db->bridge.mac),
+                                         event->smd_identifier, event->stage, event->reason);
+        break;
+    }
     }
 }
 
diff --git a/agent/src/beerocks/slave/tasks/health_monitoring_task.h b/agent/src/beerocks/slave/tasks/health_monitoring_task.h
index c2a70d575..154e46aed 100644
--- a/agent/src/beerocks/slave/tasks/health_monitoring_task.h
+++ b/agent/src/beerocks/slave/tasks/health_monitoring_task.h
@@ -7,6 +7,7 @@
 
 #include "task.h"
 
+#include <string>
 #include <unordered_set>
 
 namespace beerocks {
@@ -36,7 +37,14 @@ public:
          * Signals that a QoS Management Descriptor install has completed.
          * event_obj: const sScsInstallResultEvent *
          */
-        SCS_INSTALL_RESULT
+        SCS_INSTALL_RESULT,
+        /**
+         * @brief Generic SMD failure event, covering any failure encountered while
+         * onboarding SMD policy or processing an SMD Neighbor DB exchange.
+         *
+         * event_obj: const sSmdFailureEvent *
+         */
+        SMD_FAILURE,
     };
 
     /**
@@ -66,6 +74,23 @@ public:
         bool     success;
     };
 
+    /**
+     * @brief Payload for eEvent::SMD_FAILURE.
+     *
+     * `stage` differentiates the failing step for the Debug Agent/cloud consumer, e.g.:
+     *   "SMD_ONBOARDING"          - SMD policy missing/unusable at M2, config/driver mismatch
+     *   "SMD_NBR_DB_TIMEOUT"      - Neighbor DB state machine timed out
+     *   "SMD_NBR_DB_PUBLISH"      - MQTT publish / TLV packing failure toward hostapd
+     *   "SMD_NBR_DB_RESP_STATUS"  - hostapd returned a non-OK status
+     *   "SMD_NBR_DB_VALIDATION"   - aggregated neighbor info from controller failed validation
+     *   "SMD_LOCAL_NBR_INFO_SEND" - Local Neighbor Info CMDU build/send failure
+     */
+    struct sSmdFailureEvent {
+        sMacAddr smd_identifier; ///< SMD identifier in scope, or ZERO_MAC if not applicable.
+        std::string stage;
+        std::string reason;
+    };
+
     bool handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
                      const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
                      std::shared_ptr<beerocks_header> beerocks_header) override;
