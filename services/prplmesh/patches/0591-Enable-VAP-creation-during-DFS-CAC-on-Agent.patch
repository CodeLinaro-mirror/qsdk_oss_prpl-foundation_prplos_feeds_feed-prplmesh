From 3d506c98af5484034242f104a8c5b153f380d998 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 2 Nov 2026 19:59:26 +0530
Subject: [PATCH] Enable VAP creation during DFS CAC on Agent

Previously, VAP creation and add_bss operations were deferred until DFS CAC completion
due to a host-side limitation that prevented VAP creation during CAC.
As this limitation has been resolved, the Agent can now clone and create VAPs
while CAC is in progress, eliminating the need to wait for DFS completion before bringing up the VAP.

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 0f6ebd140..78a2f2580 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -5667,10 +5667,9 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
     std::string base_interface="";
     extractLinkBaseInterface(m_radio_info.iface_name, base_interface);
 
-    // Skip update if hostapd reports the interface is not in ENABLED state.
-    // During CAC the state is "DFS"; attempting to configure VAPs at that
-    // point is premature and can fail. The autoconfiguration task will be
-    // restarted once CAC completes successfully.
+    // Log if hostapd reports the interface is not in ENABLED state.
+    // During CAC the state is "DFS"; the update continues regardless and
+    // update_deferred_for_cac is set so the caller knows the radio is still in CAC.
     {
         parsed_obj_map_t status_result;
         const bool have_status_iface = !get_iface_name().empty() &&
@@ -5682,8 +5681,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
             if (state_it != status_result.end() && state_it->second != "ENABLED") {
                 LOG(WARNING) << "update_vap_credentials: hostapd state='"
                              << state_it->second << "' on " << m_radio_info.iface_name
-                             << " is not ENABLED, skipping update";
-                return true;
+                             << " is not ENABLED, continuing update";
             }
         }
     }
