From 2f1323a771bde4979d8088998837722a7ab0fdac Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Fri, 9 Oct 2026 15:30:56 +0530
Subject: [PATCH] CERT: Fetch bSTA MLD MAC address

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 agent/src/beerocks/slave/agent_db.h                 |  2 ++
 .../slave/backhaul_manager/backhaul_manager.cpp     | 13 +++++++++++++
 .../slave/tasks/ap_autoconfiguration_task.cpp       |  5 +++++
 3 files changed, 20 insertions(+)

diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index 7e8dc13..7e61064 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -467,6 +467,8 @@ public:
         // backfilled with the correct MLD MACs.
         sMacAddr observed_ap_mld_mac   = net::network_utils::ZERO_MAC;
         sMacAddr observed_bsta_mld_mac = net::network_utils::ZERO_MAC;
+        // Backhaul SSID cached for late bSTA MLD configuration creation.
+        std::string observed_bsta_mld_ssid;
 
         // Per-RUID affiliated-link-local MAC observed at backhaul-connect time (from
         // Event::Affiliated_Link_Connected), keyed by RUID.
diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index f0a53c8..5ed3d1e 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -3427,6 +3427,10 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
             }
             db->backhaul.observed_ap_mld_mac   = observed_ap_mld_mac;
             db->backhaul.observed_bsta_mld_mac = observed_bsta_mld_mac;
+            auto observed_bsta_mld_ssid = iface_hal->get_ssid();
+            if (!observed_bsta_mld_ssid.empty()) {
+                db->backhaul.observed_bsta_mld_ssid = observed_bsta_mld_ssid;
+            }
 
             if (db->bsta_mld_configuration) {
                 db->bsta_mld_configuration->mld_config.mld_ssid = iface_hal->get_ssid();
@@ -3956,6 +3960,15 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
                 ruid != net::network_utils::ZERO_MAC) {
                 db->backhaul.observed_affiliated_bsta_mac[ruid] = msg->affiliated_mac_address;
             }
+            if (msg->affiliated_mac_address != net::network_utils::ZERO_MAC) {
+                auto iface_hal = get_wireless_hal(iface);
+                if (iface_hal) {
+                    auto observed_bsta_mld_ssid = iface_hal->get_ssid();
+                    if (!observed_bsta_mld_ssid.empty()) {
+                        db->backhaul.observed_bsta_mld_ssid = observed_bsta_mld_ssid;
+                    }
+                }
+            }
         }
 
         if (msg && db->bsta_mld_configuration) {
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index c37efcf..d6a7c54 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -5194,6 +5194,11 @@ bool ApAutoConfigurationTask::handle_bsta_mld_configuration_tlv(ieee1905_1::Cmdu
         }
     }
 
+    if (db->bsta_mld_configuration->mld_config.mld_ssid.empty() &&
+        !db->backhaul.observed_bsta_mld_ssid.empty()) {
+        db->bsta_mld_configuration->mld_config.mld_ssid = db->backhaul.observed_bsta_mld_ssid;
+    }
+
     // Respect the controller's addr_valid bits: some flows deliberately leave these MACs
     // invalid, expecting the agent to self-report its own observed MLD MACs instead of
     // being overwritten with a zero/garbage TLV value.
-- 
2.34.1

