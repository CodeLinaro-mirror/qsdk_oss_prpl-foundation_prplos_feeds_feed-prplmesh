From 12f16f0b31d8a63e7e69e62abb60481e6c4946e0 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Mon, 12 Jan 2026 08:28:20 +0530
Subject: [PATCH] MLO enablement fixes on jan5 baseline

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp |  5 +++++
 controller/src/beerocks/master/controller.cpp       | 13 ++++---------
 controller/src/beerocks/master/db/db.cpp            |  3 +++
 3 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index fdecc6e20..e6221152b 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -771,6 +771,11 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
                m_radio_info.bsta_modes_support.emlsr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
                m_radio_info.bsta_modes_support.nstr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
                m_radio_info.bsta_modes_support.str_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
+
+/* Hard coding */
+               m_radio_info.max_num_mlds = 3;
+               m_radio_info.ap_maximum_links = 2;
+               m_radio_info.bsta_maximum_links = 2;
     }
 
 
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 09b7ad7f2..3345fdb40 100644
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -1425,6 +1425,8 @@ static bool add_agent_ap_mld_configuration_tlv(db &database, ieee1905_1::CmduMes
             }
             if (!bss_conf.ssid.empty() && bss_conf.ssid == mld.second.ssid &&
                 bss_conf.mld_id == mld.first) {
+                auto bss_conf_freq =
+                    son::wireless_utils::which_freq_op_cls(bss_conf.operating_class.front());
 
                 for (const auto &affiliated_radio : agent.radios) {
                     if (!affiliated_radio.second) {
@@ -1432,16 +1434,9 @@ static bool add_agent_ap_mld_configuration_tlv(db &database, ieee1905_1::CmduMes
                         continue;
                     }
 
-                    const auto op_class = son::wireless_utils::get_operating_classes_of_freq_type(
-                                              affiliated_radio.second->band)
-                                              .front();
-
-                    const bool radio_band_found =
-                        (std::find(bss_conf.operating_class.begin(), bss_conf.operating_class.end(),
-                                   op_class) != bss_conf.operating_class.end());
-
                     // Check if bss conf freq matches radio freq and EHT is supported
-                    if (!radio_band_found || !affiliated_radio.second->eht_supported ||
+                    if (bss_conf_freq != affiliated_radio.second->band ||
+                        !affiliated_radio.second->eht_supported ||
                         (!affiliated_radio.second->wifi7_capabilities.ap_role.str_support &&
                          mld_configuration.at(bss_conf.mld_id).str) ||
                         (!affiliated_radio.second->wifi7_capabilities.ap_role.nstr_support &&
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 47023de7e..64daca9c5 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -2439,12 +2439,15 @@ bool db::set_radio_supported_channels(const sMacAddr &mac, beerocks::WifiChannel
     switch (radio->supported_channels[0].get_freq_type()) {
     case eFreqType::FREQ_24G:
         radio->supports_24ghz = true;
+        radio->band = eFreqType::FREQ_24G;
         break;
     case eFreqType::FREQ_5G:
         radio->supports_5ghz = true;
+        radio->band =  eFreqType::FREQ_5G;
         break;
     case eFreqType::FREQ_6G:
         radio->supports_6ghz = true;
+        radio->band = eFreqType::FREQ_6G;
         break;
     default:
         LOG(ERROR) << "unknown frequency! channel: "
-- 
2.34.1

