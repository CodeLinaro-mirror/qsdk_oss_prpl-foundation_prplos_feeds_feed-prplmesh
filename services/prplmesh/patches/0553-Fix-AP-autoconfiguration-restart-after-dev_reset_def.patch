From 0ab612ecafdfbfa8d45e56098d77f0af53292421 Mon Sep 17 00:00:00 2001
From: Mahitha M <mmaddulu@qti.qualcomm.com>
Date: Tue, 20 Oct 2026 12:01:46 +0530
Subject: [PATCH] Fix AP autoconfiguration restart after dev_reset_default
 teardown

Signed-off-by: Mahitha M <mmaddulu@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp | 15 ++++++++++++++-
 agent/src/beerocks/slave/son_slave_thread.h   | 10 ++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 6abce3c1d..8f05f6bc9 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -2786,6 +2786,9 @@ bool slave_thread::handle_cmdu_backhaul_manager_message(
             break;
         }
         LOG(DEBUG) << "Request agent to tear down";
+        // The tear down is only requested by dev_reset_default. Every radio must be
+        // re-onboarded afterwards, not only those whose ap_manager reconnects.
+        m_rearm_autoconfig_all_radios = true;
         for (const auto &radio_manager_element : m_radio_managers.get()) {
             auto &radio_manager = radio_manager_element.second;
             auto radio_iface =
@@ -7082,7 +7085,17 @@ bool slave_thread::agent_fsm()
         LOG(TRACE) << "goto STATE_WAIT_FOR_AUTO_CONFIGURATION_COMPLETE";
         m_agent_state = STATE_WAIT_FOR_AUTO_CONFIGURATION_COMPLETE;
         if (db->device_conf.management_mode != BPL_MGMT_MODE_MULTIAP_CONTROLLER) {
-            if (!m_restarting_fronthaul_ifaces.empty()) {
+            if (m_rearm_autoconfig_all_radios) {
+                // dev_reset_default: the VAPs of every radio were torn down, so every
+                // radio must be re-onboarded regardless of which ap_manager reconnected.
+                LOG(INFO) << "dev_reset_default re-arm, full AP "
+                             "autoconfiguration on all radios (dropping "
+                          << m_restarting_fronthaul_ifaces.size() << " fronthaul-only entries)";
+                m_restarting_fronthaul_ifaces.clear();
+                m_rearm_autoconfig_all_radios = false;
+                m_task_pool.send_event(eTaskType::AP_AUTOCONFIGURATION,
+                                       ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION);
+            } else if (!m_restarting_fronthaul_ifaces.empty()) {
                 // Only specific fronthaul(s) restarted while the backhaul remained up.
                 // Restart AP autoconfiguration only for the affected radio(s) so that
                 // already-CONFIGURED radios are not unnecessarily re-onboarded.
diff --git a/agent/src/beerocks/slave/son_slave_thread.h b/agent/src/beerocks/slave/son_slave_thread.h
index 5c58246b9..c4087a4a0 100644
--- a/agent/src/beerocks/slave/son_slave_thread.h
+++ b/agent/src/beerocks/slave/son_slave_thread.h
@@ -433,6 +433,16 @@ private:
      */
     std::set<std::string> m_restarting_fronthaul_ifaces;
 
+    /**
+     * @brief Set when dev_reset_default tears down every VAP on every radio.
+     *
+     * In that case the normal partial-restart bookkeeping in
+     * m_restarting_fronthaul_ifaces is insufficient, because only some radios may
+     * reconnect their ap_manager/monitor processes before STATE_BACKHAUL_MANAGER_CONNECTED
+     * runs. While this flag is set, the FSM must restart AP autoconfiguration for all radios.
+     */
+    bool m_rearm_autoconfig_all_radios = false;
+
     /**
      * @brief Physical L2 backhaul connection state as reported by the Backhaul Manager.
      */
-- 
2.34.1

