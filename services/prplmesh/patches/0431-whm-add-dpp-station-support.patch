+static bool read_call_string_result(const AmbiorixVariant &result, std::string &value)
+{
+    if (result.get(value) && !value.empty()) {
+        return true;
+    }
+
+    auto retval = result.find_child_deep("0.retval");
+    if (retval && retval->get(value) && !value.empty()) {
+        return true;
+    }
+
+    retval = result.find_child_deep("retval");
+    if (retval && retval->get(value) && !value.empty()) {
+        return true;
+    }
+
+    auto first = result.first_child();
+    return (first && first->get(value) && !value.empty());
+}
+
+static bool read_call_bool_result(const AmbiorixVariant &result, bool &value)
+{
+    if (result.get(value)) {
+        return true;
+    }
+
+    auto retval = result.find_child_deep("0.retval");
+    if (retval && retval->get(value)) {
+        return true;
+    }
+
+    retval = result.find_child_deep("retval");
+    if (retval && retval->get(value)) {
+        return true;
+    }
+
+    auto first = result.first_child();
+    return (first && first->get(value));
+}
+
+static bool parse_dpp_bootstrap_info(const std::string &reply, int &bootstrap_id, std::string &uri)
+{
+    bootstrap_id = 0;
+    uri.clear();
+
+    std::istringstream stream(reply);
+    std::string line;
+    while (std::getline(stream, line)) {
+        if (line.rfind("id=", 0) == 0) {
+            bootstrap_id = beerocks::string_utils::stoi(line.substr(3));
+        } else if (line.rfind("uri=", 0) == 0) {
+            uri = line.substr(4);
+        }
+    }
+
+    return (bootstrap_id > 0 && !uri.empty());
+}
