 bool ap_wlan_hal_whm::set_cce_indication(uint16_t advertise_cce)
 {
     LOG(DEBUG) << "ap_wlan_hal_whm: set_cce_indication, advertise_cce=" << advertise_cce;
-    return true;
+
+    // DPP_CCE_INDICATION_MESSAGE from the Controller is a network-wide, radio-scoped
+    // signal to advertise (or stop advertising) DPP Configurator Connectivity - it is
+    // NOT tied to any particular BSS's chosen AKM. On this platform (pwhm/whm), the CCE
+    // beacon bit ("dpp_configurator_connectivity=1" in hostapd.conf) is driven entirely
+    // by AccessPoint.{i}.DPP.Enable (see wld_hostapd_cfgFile.c::wld_hostapd_cfgFile_setVapConfig()).
+    // Previously this function was a no-op, so the Controller's CCE broadcast never
+    // reached hostapd, and DPP.Enable was only ever set for the one VAP whose own M2
+    // happened to carry the DPP AKM bit (see update_vap_credentials() below). Apply the
+    // requested CCE state to every fronthaul VAP on this radio so all of them advertise
+    // (or stop advertising) DPP support, independent of any BSS's specific AKM.
+    bool success = true;
+    bool any_vap = false;
+    for (const auto &vap_kv : m_radio_info.available_vaps) {
+        const auto &vap_info = vap_kv.second;
+        if (vap_info.bss.empty() || !vap_info.fronthaul) {
+            continue;
+        }
+        auto vap_it = m_vapsExtInfo.find(vap_info.bss);
+        if (vap_it == m_vapsExtInfo.end()) {
+            LOG(WARNING) << "set_cce_indication: no ambiorix path known for VAP "
+                         << vap_info.bss;
+            continue;
+        }
+        any_vap                     = true;
+        const std::string dpp_path = vap_it->second.path + "DPP.";
+        AmbiorixVariant dpp_obj(AMXC_VAR_ID_HTABLE);
+        dpp_obj.add_child("Enable", advertise_cce != 0);
+        if (!m_ambiorix_cl.update_object(dpp_path, dpp_obj)) {
+            LOG(ERROR) << "set_cce_indication: failed to update " << dpp_path;
+            success = false;
+            continue;
+        }
+        LOG(DEBUG) << "set_cce_indication: set " << dpp_path
+                   << "Enable=" << (advertise_cce != 0);
+    }
+    if (!any_vap) {
+        LOG(DEBUG) << "set_cce_indication: no fronthaul VAPs available yet on this radio";
+    }
+    return success;
 }
 
