+void sta_wlan_hal_whm::subscribe_to_ep_wpaCtrl_events()
+{
+    // Subscribe to wpaCtrlEvents on ALL EndPoint paths without per-instance filtering,
+    // since m_ep_path may not be resolved yet at subscription time (mirrors the
+    // wildcard-first, path-check-in-callback pattern already used for
+    // subscribe_to_ep_events() and base_wlan_hal_whm::subscribe_to_ap_events()).
+    //
+    // pwhm forwards the live DPP wpa_supplicant events (DPP-CONNECTOR,
+    // DPP-NET-ACCESS-KEY, DPP-C-SIGN-KEY, DPP-1905-*, DPP-AUTH-SUCCESS, DPP-FAIL,
+    // DPP-CONF-FAILED, DPP-MAP-DFCOUNTER, DPP-CHIRP-RX, etc.) as a "wpaCtrlEvents"
+    // signal on the WiFi.EndPoint.{i}. object (see pwhm's s_wpaCtrlIfaceStdEvt() /
+    // s_fwdIfaceStdWpaCtrlEventsList). Without this subscription those events never
+    // reach process_wpa_ctrl_event(), so BackhaulManager::process_dpp_bridge_events()
+    // (chirp retrigger on DPP-FAIL/DPP-CONF-FAILED, chirp-timer reset on
+    // DPP-AUTH-SUCCESS, and live 1905/backhaul connector bridging) is never invoked.
+    std::string wifi_ep_path = wbapi_utils::search_path_ep();
+
+    auto event_handler         = std::make_shared<sAmbiorixEventHandler>();
+    event_handler->event_type  = AMX_CL_WPA_CTRL_EVT;
+    event_handler->callback_fn = [this](AmbiorixVariant &event_data) -> void {
+        std::string ep_path;
+        if (!event_data.read_child(ep_path, "path") || ep_path.empty()) {
+            return;
+        }
+
+        // Only handle events for our own resolved EndPoint. If not yet resolved,
+        // fall back to matching on ifName so early DPP events aren't dropped.
+        if (!m_ep_path.empty()) {
+            if (m_ep_path != ep_path) {
+                return;
+            }
+        } else {
+            std::string if_name;
+            if (!event_data.read_child(if_name, "ifName") || if_name != get_iface_name()) {
+                return;
+            }
+        }
+
+        std::string data;
+        if (!event_data || !event_data.read_child(data, "eventData")) {
+            return;
+        }
+        process_wpa_ctrl_event(event_data);
+    };
+
+    std::string filter = "(path matches '" + wifi_ep_path +
+                         "[0-9]+.$') && (notification == '" + AMX_CL_WPA_CTRL_EVT + "')";
+
+    m_ambiorix_cl.subscribe_to_object_event(wifi_ep_path, event_handler, filter);
+}
