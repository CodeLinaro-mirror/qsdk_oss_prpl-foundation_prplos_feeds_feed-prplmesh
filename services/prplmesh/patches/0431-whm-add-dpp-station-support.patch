+bool sta_wlan_hal_whm::dpp_bootstrap_gen_and_get_uri(const std::vector<uint8_t> &private_key_der,
+                                                     int &bootstrap_id, std::string &uri)
+{
+    if (m_ep_path.empty()) {
+        LOG(ERROR) << "DPP: endpoint path is empty on " << get_iface_name();
+        return false;
+    }
+
+    std::string hex_key =
+        beerocks::string_utils::bytes_to_hex_string(private_key_der.data(), private_key_der.size());
+
+    AmbiorixVariant args(AMXC_VAR_ID_HTABLE), result;
+    args.add_child("curve", std::string("P-256"));
+    args.add_child("chan", uint32_t(0));
+    args.add_child("operatingclass", uint32_t(0));
+    args.add_child("key", hex_key);
+
+    const auto dpp_path = m_ep_path + "DPP.";
+    if (!m_ambiorix_cl.call(dpp_path, "dpp_bootstrap_gen_info", args, result)) {
+        LOG(ERROR) << "DPP: dpp_bootstrap_gen_info failed on " << get_iface_name();
+        return false;
+    }
+
+    std::string reply;
+    if (!read_call_string_result(result, reply) ||
+        !parse_dpp_bootstrap_info(reply, bootstrap_id, uri)) {
+        LOG(ERROR) << "DPP: invalid dpp_bootstrap_gen_info reply on " << get_iface_name();
+        return false;
+    }
+
+    return true;
+}
+
+bool sta_wlan_hal_whm::dpp_set_extra_conf_req_bsta_list(const std::string &json_value)
+{
+    if (m_ep_path.empty()) {
+        LOG(ERROR) << "DPP: endpoint path is empty on " << get_iface_name();
+        return false;
+    }
+
+    AmbiorixVariant args(AMXC_VAR_ID_HTABLE), result;
+    args.add_child("name", std::string("bSTAList"));
+    args.add_child("value", json_value);
+
+    const auto dpp_path = m_ep_path + "DPP.";
+    if (!m_ambiorix_cl.call(dpp_path, "setDppExtraConfReq", args, result)) {
+        LOG(ERROR) << "DPP: setDppExtraConfReq failed on " << get_iface_name();
+        return false;
+    }
+
+    bool ok = false;
+    return read_call_bool_result(result, ok) && ok;
+}
+
+bool sta_wlan_hal_whm::get_persisted_dpp_credentials(sPersistedDppCredentials &creds)
+{
+    creds = sPersistedDppCredentials{};
+
+    if (m_ep_path.empty()) {
+        LOG(ERROR) << "DPP: endpoint path is empty on " << get_iface_name();
+        return false;
+    }
+
+    const auto dpp_path = m_ep_path + "DPP.";
+
+    AmbiorixVariant args(AMXC_VAR_ID_HTABLE), result;
+    if (!m_ambiorix_cl.call(dpp_path, "listDppNetworks", args, result)) {
+        LOG(ERROR) << "DPP: listDppNetworks failed on " << get_iface_name();
+        return false;
+    }
+
+    std::string networks;
+    if (!read_call_string_result(result, networks)) {
+        LOG(ERROR) << "DPP: empty listDppNetworks reply on " << get_iface_name();
+        return false;
+    }
+
+    int network_id = -1;
+    std::istringstream networks_stream(networks);
+    std::string line;
+    std::getline(networks_stream, line);
+    while (std::getline(networks_stream, line)) {
+        auto tab = line.find('\t');
+        if (tab == std::string::npos) {
+            continue;
+        }
+
+        int id = beerocks::string_utils::stoi(line.substr(0, tab));
+        AmbiorixVariant get_args(AMXC_VAR_ID_HTABLE), get_result;
+        get_args.add_child("id", uint32_t(id));
+        get_args.add_child("field", std::string("dpp_connector"));
+        if (!m_ambiorix_cl.call(dpp_path, "getDppNetworkValue", get_args, get_result)) {
+            continue;
+        }
+
+        std::string connector;
+        if (read_call_string_result(get_result, connector) && !connector.empty()) {
+            creds.has_wlan_connector = true;
+            creds.wlan_connector     = connector;
+            network_id               = id;
+            break;
+        }
+    }
+
+    if (network_id >= 0) {
+        AmbiorixVariant nak_args(AMXC_VAR_ID_HTABLE), nak_result;
+        nak_args.add_child("id", uint32_t(network_id));
+        nak_args.add_child("field", std::string("dpp_netaccesskey"));
+
+        std::string nak_hex;
+        if (m_ambiorix_cl.call(dpp_path, "getDppNetworkValue", nak_args, nak_result)) {
+            read_call_string_result(nak_result, nak_hex);
+        }
+
+        AmbiorixVariant csign_args(AMXC_VAR_ID_HTABLE), csign_result;
+        csign_args.add_child("id", uint32_t(network_id));
+        csign_args.add_child("field", std::string("dpp_csign"));
+
+        std::string csign_hex;
+        if (m_ambiorix_cl.call(dpp_path, "getDppNetworkValue", csign_args, csign_result)) {
+            read_call_string_result(csign_result, csign_hex);
+        }
+
+        if (!nak_hex.empty() && !csign_hex.empty()) {
+            creds.nak_private_der =
+                beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(nak_hex);
+            creds.c_sign_key_der =
+                beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(csign_hex);
+        } else {
+            LOG(WARNING) << "DPP: persisted connector found on " << get_iface_name()
+                         << " but NAK/C-sign-key could not be read";
+        }
+    }
+
+    AmbiorixVariant conn1905_result;
+    if (m_ambiorix_cl.call(dpp_path, "getDpp1905Connector", args, conn1905_result)) {
+        std::string connector;
+        if (read_call_string_result(conn1905_result, connector) && !connector.empty()) {
+            creds.has_1905_connector  = true;
+            creds.dpp_1905_connector = connector;
+        }
+    }
+
+
+    return true;
+}
+
+bool sta_wlan_hal_whm::dpp_chirp(int bootstrap_id, const std::string &net_role, int iterations)
+{
+    if (m_ep_path.empty()) {
+        LOG(ERROR) << "DPP: endpoint path is empty on " << get_iface_name();
+        return false;
+    }
+
+    AmbiorixVariant args(AMXC_VAR_ID_HTABLE), result;
+    args.add_child("id", uint32_t(bootstrap_id));
+    args.add_child("netrole", net_role);
+    args.add_child("iterations", uint32_t(iterations));
+
+    const auto dpp_path = m_ep_path + "DPP.";
+    if (!m_ambiorix_cl.call(dpp_path, "chirp", args, result)) {
+        LOG(WARNING) << "DPP: chirp failed on " << get_iface_name();
+        return false;
+    }
+
+    bool ok = false;
+    return read_call_bool_result(result, ok) && ok;
+}
