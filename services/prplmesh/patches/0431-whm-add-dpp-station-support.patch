+bool sta_wlan_hal_whm::process_wpa_ctrl_event(const AmbiorixVariant &event_data)
+{
+    std::string raw_line;
+    if (!event_data || !event_data.read_child(raw_line, "eventData") || raw_line.empty()) {
+        return true;
+    }
+
+    auto opcode_start = raw_line.find('>');
+    if (opcode_start == std::string::npos) {
+        opcode_start = 0;
+    } else {
+        opcode_start++;
+    }
+
+    if (raw_line.compare(opcode_start, 4, "DPP-") != 0) {
+        return true;
+    }
+
+    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_BACKHAUL_DPP_EVENT_NOTIFICATION));
+    auto msg = reinterpret_cast<sACTION_BACKHAUL_DPP_EVENT_NOTIFICATION *>(msg_buff.get());
+    LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+
+    memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_DPP_EVENT_NOTIFICATION));
+    strlcpy(msg->event_line, raw_line.c_str(), sizeof(msg->event_line));
+
+    event_queue_push(Event::Dpp_Event, msg_buff);
+    return true;
+}
