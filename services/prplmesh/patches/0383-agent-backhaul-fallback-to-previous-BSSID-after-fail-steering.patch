      */
     int m_backhaul_steering_timer = beerocks::net::FileDescriptor::invalid_descriptor;
 
+    /**
+     * Set to true when a disconnect event is received while a backhaul steering operation is
+     * in progress (m_backhaul_steering_bssid != ZERO_MAC). The steering timer is kept running
+     * so the bSTA has the full 10-second window to connect to the target BSSID. When the timer
+     * fires, if this flag is still true (bSTA never connected to the target), the fallback to
+     * the previous BSSID is triggered. Cleared by the timer callback, by EState::RESTART, and
+     * when the bSTA successfully connects to the target (Event::Connected steering branch).
+     */
+    bool m_steering_caused_disconnect = false;
+
+    /**
+     * The BSSID the bSTA was associated to right before an ongoing backhaul steering
+     * operation was triggered. Snapshotted in handle_backhaul_steering_request() before the
+     * scan/roam is attempted, so that if the steer results in a disconnect, we know what to
+     * fall back to. ZERO_MAC if no steering operation is in progress, or none was known.
+     */
+    sMacAddr m_backhaul_steering_previous_bssid = beerocks::net::network_utils::ZERO_MAC;
+
+    /**
+     * One-shot fallback target for select_bssid(): when set, select_bssid() preferentially
+     * matches this BSSID (bypassing the blacklist for it) and clears it once matched.
+     * Set by the steering timeout timer's callback (handle_backhaul_steering_request()) when
+     * it fires with m_steering_caused_disconnect still true and a previous BSSID is known, to
+     * recover the previous BSSID via the normal scan->select->connect flow (roam() cannot be
+     * used here since it requires an already-associated station).
+     */
+    sMacAddr m_fallback_bssid = beerocks::net::network_utils::ZERO_MAC;
+
+    /**
+     * The target BSSID of a steering operation that caused a disconnect on a wireless-only
+     * backhaul. The BACKHAUL_STEERING_RESPONSE FAILURE cannot be sent immediately (the
+     * wireless link is down), so it is queued here and sent once the backhaul is restored
+     * (i.e. when the FSM enters EState::CONNECTED). ZERO_MAC if no response is pending.
+     */
+    sMacAddr m_pending_steering_failure_bssid = beerocks::net::network_utils::ZERO_MAC;
+
     /*
  * State Machines
  */
