index ea0105388..d1adf9c23 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1021,6 +1021,31 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
             }
         }
 
+        // Send any queued backhaul steering FAILURE response now that the backhaul is restored.
+        // The response was queued (rather than sent immediately) when the steering-caused
+        // disconnect was detected, because the wireless link was down at that point and the
+        // message could not be delivered to the controller.
+        if (m_pending_steering_failure_bssid != beerocks::net::network_utils::ZERO_MAC) {
+            // create_backhaul_steering_response() needs an active wireless HAL (to read the
+            // bSTA MAC), which is not available right after restoring over a wired backhaul -
+            // in that case there is nothing useful to send, so just drop the deferred response
+            // rather than forwarding a stale/unrelated cmdu_tx to the controller.
+            if (create_backhaul_steering_response(
+                    wfa_map::tlvErrorCode::eReasonCode::
+                        BACKHAUL_STEERING_REQUEST_REJECTED_TARGET_BSS_SIGNAL_NOT_SUITABLE,
+                    m_pending_steering_failure_bssid)) {
+                LOG(DEBUG) << "Sending deferred BACKHAUL_STA_STEERING_RESPONSE_MESSAGE "
+                              "(backhaul restored), target_bssid="
+                           << m_pending_steering_failure_bssid;
+                send_cmdu_to_broker(cmdu_tx, db->controller_info.bridge_mac, db->bridge.mac);
+            } else {
+                LOG(ERROR) << "Failed to build deferred BACKHAUL_STA_STEERING_RESPONSE_MESSAGE "
+                              "for target_bssid="
+                           << m_pending_steering_failure_bssid << ", dropping it";
+            }
+            m_pending_steering_failure_bssid = beerocks::net::network_utils::ZERO_MAC;
+        }
+
         handle_backhaul_connect();
         stop_on_failure_attempts = configuration_stop_on_failure_attempts;
 
@@ -1296,6 +1321,13 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
 
         LOG(DEBUG) << "Restarting ...";
 
+        // Clear steering fallback state on restart - any pending FAILURE response is stale
+        // by the time the agent reconnects after a full restart cycle.
+        m_steering_caused_disconnect       = false;
+        m_backhaul_steering_previous_bssid = beerocks::net::network_utils::ZERO_MAC;
+        m_fallback_bssid                   = beerocks::net::network_utils::ZERO_MAC;
+        m_pending_steering_failure_bssid   = beerocks::net::network_utils::ZERO_MAC;
+
         if (m_remove_platform_manager_client) {
             m_platform_manager_client.reset();
             m_remove_platform_manager_client = false;
@@ -1759,6 +1791,10 @@ bool BackhaulManager::backhaul_fsm_wireless(bool &skip_select)
             hidden_ssid              = true;
             pending_slave_sta_ifaces = slave_sta_ifaces;
 
+            // Give up on the steering-fallback candidate too, so it doesn't linger and bias
+            // an unrelated future connection attempt.
+            m_fallback_bssid = beerocks::net::network_utils::ZERO_MAC;
+
             FSM_MOVE_STATE(WIRELESS_CONFIG_4ADDR_MODE);
             break;
         }
@@ -2938,8 +2974,9 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
         if ((m_backhaul_steering_bssid != beerocks::net::network_utils::ZERO_MAC) &&
             (m_backhaul_steering_bssid == bssid)) {
 
-            m_backhaul_steering_bssid = beerocks::net::network_utils::ZERO_MAC;
-            m_timer_manager->remove_timer(m_backhaul_steering_timer);
+            // Also resets m_steering_caused_disconnect/m_backhaul_steering_previous_bssid, so
+            // they cannot leak into a later, unrelated steering operation.
+            cancel_backhaul_steering_operation();
 
             create_backhaul_steering_response(wfa_map::tlvErrorCode::eReasonCode::RESERVED, bssid);
 
@@ -3236,18 +3273,37 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
                 }
 #endif
 
-                // If this event comes as a result of a steering request, then do not consider it
-                // as an error.
                 if (m_backhaul_steering_bssid == beerocks::net::network_utils::ZERO_MAC) {
                     platform_notify_error(bpl::eErrorCode::BH_DISCONNECTED,
                                           "Backhaul disconnected on operational state");
                     stop_on_failure_attempts--;
-                }
 
-                state_time_stamp_timeout =
-                    std::chrono::steady_clock::now() +
-                    std::chrono::seconds(WIRELESS_WAIT_FOR_RECONNECT_TIMEOUT);
-                FSM_MOVE_STATE(WIRELESS_WAIT_FOR_RECONNECT);
+                    state_time_stamp_timeout =
+                        std::chrono::steady_clock::now() +
+                        std::chrono::seconds(WIRELESS_WAIT_FOR_RECONNECT_TIMEOUT);
+                    FSM_MOVE_STATE(WIRELESS_WAIT_FOR_RECONNECT);
+                } else {
+                    // The steer caused a disconnect. Do not cancel the steering timer yet -
+                    // give the bSTA the full remaining steering window (up to the 10s timeout)
+                    // to connect to the target BSSID. Record that a disconnect happened so the
+                    // timer callback can trigger the fallback if the bSTA never connects.
+                    m_steering_caused_disconnect = true;
+                    LOG(DEBUG) << "Steering-triggered disconnect. Keeping steering timer running "
+                                  "to give bSTA a chance to connect to target="
+                               << m_backhaul_steering_bssid;
+
+                    // Clear selected_bssid defensively so that if the 30s
+                    // WIRELESS_WAIT_FOR_RECONNECT timer fires (it won't, since the 10s steering
+                    // timer fires first), it does not blacklist the previous/good BSSID.
+                    selected_bssid.clear();
+
+                    // Move to WIRELESS_WAIT_FOR_RECONNECT so that if the bSTA connects to the
+                    // target within the remaining steering window, Event::Connected can handle it.
+                    state_time_stamp_timeout =
+                        std::chrono::steady_clock::now() +
+                        std::chrono::seconds(WIRELESS_WAIT_FOR_RECONNECT_TIMEOUT);
+                    FSM_MOVE_STATE(WIRELESS_WAIT_FOR_RECONNECT);
+                }
             } else if (FSM_IS_IN_STATE(WIRELESS_ASSOCIATE_4ADDR_WAIT)) {
 #ifdef USE_PRPLMESH_NLHAL
                 auto radio_info = get_radio_info_by_iface(iface);
@@ -3543,6 +3599,12 @@ bool BackhaulManager::select_bssid()
                        << ", channel = " << int(scan_result.channel) << " iface = " << iface
                        << ", rssi=" << int(scan_result.rssi);
 
+            // Check if this BSSID is the one-shot steering-fallback candidate.
+            // If so, bypass the blacklist check and short-circuit selection immediately.
+            bool is_fallback_bssid_candidate =
+                (m_fallback_bssid != beerocks::net::network_utils::ZERO_MAC) &&
+                (tlvf::mac_from_string(bssid) == m_fallback_bssid);
+
             auto ap_blacklist_it = ap_blacklist.find(bssid);
             if (ap_blacklist_it != ap_blacklist.end()) {
                 ap_blacklist_entry &entry = ap_blacklist_it->second;
@@ -3551,11 +3613,24 @@ bool BackhaulManager::select_bssid()
                     LOG(DEBUG) << " bssid = " << bssid
                                << " aged and removed from backhaul blacklist";
                     ap_blacklist.erase(bssid);
-                } else if (entry.attempts >= AP_BLACK_LIST_FAILED_ATTEMPTS_THRESHOLD) {
+                } else if (entry.attempts >= AP_BLACK_LIST_FAILED_ATTEMPTS_THRESHOLD &&
+                           !is_fallback_bssid_candidate) {
                     LOG(DEBUG) << " bssid = " << bssid << " is blacklisted, skipping";
                     continue;
                 }
             }
+            if (is_fallback_bssid_candidate) {
+                LOG(DEBUG) << "steering-fallback bssid - found bssid match = " << bssid;
+                selected_bssid_channel           = {scan_result.channel, scan_result.freq_type};
+                selected_bssid                   = bssid;
+                db->backhaul.selected_iface_name = iface;
+                auto radio = db->radio(iface);
+                if (radio) {
+                    db->backhaul.selected_iface_radio_mac = radio->front.iface_mac;
+                }
+                m_fallback_bssid = beerocks::net::network_utils::ZERO_MAC; // one-shot clear
+                return true;
+            }
             if (roam_flag) {
                 if ((bssid == roam_selected_bssid) &&
                     (scan_result.channel == roam_selected_bssid_channel.first &&
@@ -4267,26 +4342,58 @@ bool BackhaulManager::handle_backhaul_steering_request(ieee1905_1::CmduMessageRx
     m_backhaul_steering_bssid   = bssid;
     m_backhaul_steering_channel = {channel, freq_type};
 
+    // Snapshot the BSSID we were on before this steer, so that if it results in a disconnect
+    // (rather than a clean roam), we can fall back to it instead of doing generic best-RSSI
+    // reselection or waiting out WIRELESS_WAIT_FOR_RECONNECT. Empty active_hal->get_bssid()
+    // (e.g. no prior association) yields ZERO_MAC, which the disconnect handler treats as
+    // "nothing to fall back to".
+    m_backhaul_steering_previous_bssid = tlvf::mac_from_string(active_hal->get_bssid());
+
     // Create a timer to check if this Backhaul Steering Request times out.
     m_backhaul_steering_timer = m_timer_manager->add_timer(
         "Backhaul Steering Timeout", backhaul_steering_timeout, std::chrono::milliseconds::zero(),
-        [&](int fd, beerocks::EventLoop &loop) {
-            cancel_backhaul_steering_operation();
+        [bssid, this](int fd, beerocks::EventLoop &loop) {
+            // Snapshot state before cancel_backhaul_steering_operation() clears it.
+            bool caused_disconnect  = m_steering_caused_disconnect;
+            sMacAddr previous_bssid = m_backhaul_steering_previous_bssid;
 
-            // We'll end up in this situation only if an attempt to scan and associate was made, but
-            // we didn't manage to actually connect within 10 seconds, so that's probably indicative
-            // of bad reception.
-            // There is no suitable reason code for "timeout" so "target BSS signal not suitable" is
-            // used as it seems to be the more appropriate of all the reason codes available.
-            create_backhaul_steering_response(
-                wfa_map::tlvErrorCode::eReasonCode::
-                    BACKHAUL_STEERING_REQUEST_REJECTED_TARGET_BSS_SIGNAL_NOT_SUITABLE,
-                bssid);
+            // Also resets m_steering_caused_disconnect/m_backhaul_steering_previous_bssid.
+            cancel_backhaul_steering_operation();
 
-            LOG(DEBUG)
-                << "Steering request timed out. Sending BACKHAUL_STA_STEERING_RESPONSE_MESSAGE";
-            auto db = AgentDB::get();
-            send_cmdu_to_broker(cmdu_tx, db->controller_info.bridge_mac, db->bridge.mac);
+            if (caused_disconnect) {
+                // The bSTA disconnected during the steering window and did not connect to
+                // the target BSSID within the 10s timeout. Queue the FAILURE response (the
+                // wireless link is still down) and trigger fallback to the previous BSSID.
+                m_pending_steering_failure_bssid = bssid;
+                LOG(DEBUG) << "Steering timeout after disconnect. Queuing "
+                              "BACKHAUL_STA_STEERING_RESPONSE_MESSAGE (target="
+                           << bssid << ") for delivery when backhaul is restored.";
+
+                if (previous_bssid != beerocks::net::network_utils::ZERO_MAC) {
+                    LOG(DEBUG) << "Falling back to previous bssid=" << previous_bssid
+                               << " after failed steer to " << bssid;
+                    m_fallback_bssid = previous_bssid;
+                    selected_bssid.clear();
+                    state_attempts = 0;
+                    FSM_MOVE_STATE(INITIATE_SCAN);
+                }
+                // else: no previous BSSID known - stay in WIRELESS_WAIT_FOR_RECONNECT,
+                // existing passive-reconnect behavior applies.
+            } else {
+                // The bSTA did not disconnect - it is still connected to the original BSSID
+                // but simply did not roam to the target within the timeout. The wireless link
+                // is up, so send the FAILURE response immediately.
+                // There is no suitable reason code for "timeout" so "target BSS signal not
+                // suitable" is used as it seems to be the most appropriate available.
+                create_backhaul_steering_response(
+                    wfa_map::tlvErrorCode::eReasonCode::
+                        BACKHAUL_STEERING_REQUEST_REJECTED_TARGET_BSS_SIGNAL_NOT_SUITABLE,
+                    bssid);
+                LOG(DEBUG) << "Steering request timed out (no disconnect). "
+                              "Sending BACKHAUL_STA_STEERING_RESPONSE_MESSAGE";
+                auto db = AgentDB::get();
+                send_cmdu_to_broker(cmdu_tx, db->controller_info.bridge_mac, db->bridge.mac);
+            }
             return true;
         });
     if (m_backhaul_steering_timer == beerocks::net::FileDescriptor::invalid_descriptor) {
@@ -4362,6 +4469,14 @@ void BackhaulManager::cancel_backhaul_steering_operation()
     m_backhaul_steering_channel = {0, eFreqType::FREQ_UNKNOWN};
 
     m_timer_manager->remove_timer(m_backhaul_steering_timer);
+
+    // Reset steering-fallback bookkeeping too, whenever a steering operation ends via any
+    // path (clean success, superseded by a new request, or synchronous roam failure) - not
+    // just via the timer's own expiry. Otherwise a stale m_steering_caused_disconnect/
+    // m_backhaul_steering_previous_bssid from this operation could be misread by a later,
+    // unrelated steering operation's timer callback.
+    m_steering_caused_disconnect       = false;
+    m_backhaul_steering_previous_bssid = beerocks::net::network_utils::ZERO_MAC;
 }
 
