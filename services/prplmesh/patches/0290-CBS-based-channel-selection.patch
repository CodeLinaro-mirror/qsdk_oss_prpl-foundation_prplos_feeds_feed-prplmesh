+bool ap_wlan_hal_nl80211::read_acs_ranks(std::vector<sAcsChannelRank> &out_ranks)
+{
+    out_ranks.clear();
+
+    // The "ACS show_report" command is a hostapd control-interface command registered on the
+    // BASE radio socket (e.g. /var/run/hostapd/wlan2), same as the other "ACS ..." commands used
+    // by start_platform_acs(). Derive the base iface from the link iface and register its socket.
+    const std::string link_iface = m_radio_info.iface_name;
+    std::string radio_iface;
+    extractLinkBaseInterface(link_iface, radio_iface);
+    if (radio_iface.empty()) {
+        radio_iface = link_iface;
+    }
+
+    if (!is_wpa_ctrl_interface_registered(radio_iface)) {
+        if (add_interface(radio_iface) < 0) {
+            LOG(WARNING) << "[CBS] read_acs_ranks: add_interface(" << radio_iface
+                         << ") failed; will still attempt to send on it";
+        }
+    }
+
+    // The "ACS show_report" output can be large (e.g. a 6GHz radio has 200+ channels x several
+    // bandwidths), exceeding the shared 4096-byte wpa_ctrl buffer -> the underlying request()
+    // would fail with "reply of size 4096". Use a dedicated large (32 KB) buffer for this command.
+    std::string report;
+    constexpr size_t ACS_REPORT_BUF_SIZE = 32768;
+    if (!wpa_ctrl_send_msg_bufsize("ACS show_report", report, ACS_REPORT_BUF_SIZE, radio_iface) ||
+        report.empty()) {
+        LOG(ERROR) << "[CBS] read_acs_ranks: 'ACS show_report' failed on iface=" << radio_iface;
+        return false;
+    }
+
+    // Parse the report table produced by acs_extn.c::print_acs_report_to_buf(). Layout:
+    //   " Freq(chan)          BSS    NF   Load  Sec   SRP  Grade  Radar    Eff   Power   Rank"
+    //   "-----------------------------------------------------------------------------------"
+    //   " 5180( 36 5210)  <...>  <rank>"
+    //   " 5180( 36)       <...>  <rank>"
+    //   ...
+    //   "ACS_SUCCESS: ..." / "Best channel ..." / "ACS Algo: ..." / "Chan sel ..."
+    // Extract from each data row: channel (1st paren int), center_freq (2nd paren int, 0 if
+    // absent) and the trailing rank (last whitespace-separated integer). Isolated here so a
+    // QSDK format change is contained to this function.
+    std::stringstream ss(report);
+    std::string line;
+    bool past_separator = false;
+
+    auto is_summary_line = [](const std::string &s) {
+        return s.find("ACS_SUCCESS") != std::string::npos ||
+               s.find("Best channel") != std::string::npos ||
+               s.find("ACS Algo") != std::string::npos ||
+               s.find("Chan sel") != std::string::npos ||
+               s.find("Total Time") != std::string::npos ||
+               s.find("No ACS report") != std::string::npos;
+    };
+
+    while (std::getline(ss, line)) {
+        // The "----" divider marks the start of the data rows.
+        if (!past_separator) {
+            if (line.find("---") != std::string::npos) {
+                past_separator = true;
+            }
+            continue;
+        }
+
+        // Stop at the summary section (or a blank line).
+        if (is_summary_line(line)) {
+            break;
+        }
+        // trim
+        auto first = line.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos) {
+            continue; // blank line inside table: skip (do not stop, some drivers pad)
+        }
+
+        // A data row must contain "(<chan>...)".
+        auto lparen = line.find('(');
+        auto rparen = line.find(')', lparen == std::string::npos ? 0 : lparen);
+        if (lparen == std::string::npos || rparen == std::string::npos || rparen <= lparen) {
+            continue;
+        }
+
+        // Parse channel and optional center_freq from inside the parentheses.
+        const std::string inside = line.substr(lparen + 1, rparen - lparen - 1);
+        std::stringstream pss(inside);
+        int chan = 0, center = 0;
+        pss >> chan;
+        if (pss.fail() || chan <= 0) {
+            continue;
+        }
+        pss >> center; // optional; remains 0 if absent
+
+        // The rank is the last whitespace-separated integer token on the line
+        // (after the closing paren).
+        int32_t rank = -1;
+        {
+            std::stringstream tss(line.substr(rparen + 1));
+            std::string tok;
+            while (tss >> tok) {
+                // parse trailing integer tokens; keep the last valid one
+                char *endp = nullptr;
+                long v     = std::strtol(tok.c_str(), &endp, 10);
+                if (endp != tok.c_str() && *endp == '\0') {
+                    rank = static_cast<int32_t>(v);
+                }
+            }
+        }
+
+        sAcsChannelRank entry;
+        entry.channel     = static_cast<uint8_t>(chan);
+        entry.center_chan = static_cast<uint16_t>(center < 0 ? 0 : center);
+        entry.rank        = rank;
+        out_ranks.push_back(entry);
+    }
+
+    // Log the parsed table for verification.
+    {
+        std::stringstream log_ss;
+        log_ss << "[CBS] read_acs_ranks: parsed " << out_ranks.size()
+               << " rows from 'ACS show_report' on iface=" << radio_iface << ":" << std::endl;
+        for (const auto &e : out_ranks) {
+            log_ss << "  channel=" << int(e.channel) << " center_chan=" << int(e.center_chan)
+                   << " rank=" << e.rank << std::endl;
+        }
+        LOG(DEBUG) << log_ss.str();
+    }
+
+    if (out_ranks.empty()) {
+        LOG(WARNING) << "[CBS] read_acs_ranks: parsed 0 rows (report empty or format changed)";
+        return false;
+    }
+
+    return true;
+}
