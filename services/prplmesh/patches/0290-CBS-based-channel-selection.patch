+uint8_t ChannelSelectionTask::rank_to_preference(int32_t rank)
+{
+    // QCA "ACS show_report" rank semantics:
+    //   rank <  0 : unknown / not reported          -> preference 0 (non-operable)
+    //   rank == 0 : operable but NOT ranked by the driver (baseline) -> preference 1 (lowest
+    //               operable), so any positively-ranked channel always outranks it.
+    //   rank >= 1 : ranked, 1 = best. pref = clamp(16 - rank, 1, 15).
+    if (rank < 0) {
+        return 0;
+    }
+    if (rank == 0) {
+        return 1; // operable baseline
+    }
+    constexpr int BEST_PREF  = 15;
+    constexpr int WORST_PREF = 1;
+    // rank 1 -> 15, rank 2 -> 14, ..., rank 15 -> 1, rank > 15 -> 1
+    if (rank < BEST_PREF + 1) {
+        return static_cast<uint8_t>(BEST_PREF + 1 - rank);
+    }
+    return static_cast<uint8_t>(WORST_PREF);
+}
+
+bool ChannelSelectionTask::refresh_preference_table(const sMacAddr &radio_mac,
+                                                    const std::vector<sChannelBwRank> &entries)
+{
+    auto db = AgentDB::get();
+
+    // Guard: the whole CBS preference-table path is anchored to cbs_based_chansel_enable. When it
+    // is not enabled (default), this function is a strict no-op and does NOT touch any existing
+    // state (channels_list / supported_bw_list[bw].rank / cbs_preference_table), so the regular
+    // channel-selection and ZWDFS flows are completely unaffected.
+    if (!db->device_conf.cbs_based_chansel_enable) {
+        LOG(DEBUG) << "[CBS] refresh_preference_table: cbs_based_chansel_enable=0 -> skipping "
+                      "(existing flow untouched) for radio "
+                   << radio_mac;
+        return false;
+    }
+
+    auto radio = db->get_radio_by_mac(radio_mac, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(ERROR) << "[CBS] refresh_preference_table: radio " << radio_mac << " not found in DB";
+        return false;
+    }
+
+    if (entries.empty()) {
+        LOG(WARNING) << "[CBS] refresh_preference_table: empty rank list for radio "
+                     << radio_mac << ". Keeping previous cache (stale) if any.";
+        // Note: deliberately not setting valid=false to keep the stale report rather than failing.
+        return false;
+    }
+
+    LOG(DEBUG) << "[CBS] refresh_preference_table: starting cache rebuild for radio " << radio_mac
+               << " with " << entries.size() << " (channel,bw,rank) entries.";
+
+    // Temporary map to hold the aggregated ranks per (op-class, channel).
+    std::map<uint8_t, std::map<uint8_t, AgentDB::sRadio::sPreferenceEntry>> new_cache;
+
+    const auto freq_type = radio->wifi_channel.get_freq_type();
+
+    for (const auto &e : entries) {
+        if (e.rank < 0 || e.bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+            continue; // Skip invalid/unknown entries.
+        }
+
+        const uint8_t chan = e.channel;
+        const beerocks::eWiFiBandwidth bw = e.bandwidth;
+
+        // Derive the operating class directly from the (channel, bandwidth) we already know.
+        // No center-frequency round-trip or candidate-bandwidth probing (that produced a lot of
+        // "invalid channel" log noise). Op-class 0 means the (channel, bw) is not a valid combo
+        // for this band -> skip quietly.
+        uint8_t op_class = son::wireless_utils::get_operating_class_by_channel(
+            beerocks::WifiChannel(chan, freq_type, bw));
+        if (op_class == 0) {
+            continue;
+        }
+
+        // Insert or update the cache entry. Aggregation: keep the MIN (best) rank per (opclass,ch).
+        auto &entry = new_cache[op_class][chan];
+        if (entry.rank == -1 || e.rank < entry.rank) {
+            entry.channel = chan;
+            entry.operating_class = op_class;
+            entry.bandwidth = bw;
+            entry.rank = e.rank;
+            entry.preference = rank_to_preference(e.rank);
+            entry.reason = wfa_map::cPreferenceOperatingClasses::eReasonCode::UNSPECIFIED;
+        }
+    }
+
+    // Now overlay the non-operable states from the channels_list (DFS, AWGN, unsupported)
+    // and write the ranks into supported_bw_list[bw].rank.
+    for (auto &opclass_pair : new_cache) {
+        for (auto &chan_pair : opclass_pair.second) {
+            auto &entry = chan_pair.second;
+
+            auto it_ch = radio->channels_list.find(entry.channel);
+            if (it_ch == radio->channels_list.end()) {
+                // Channel completely unsupported
+                entry.preference = 0;
+                entry.reason = wfa_map::cPreferenceOperatingClasses::eReasonCode::UNSPECIFIED;
+                continue;
+            }
+
+            auto &ch_info = it_ch->second;
+
+            // Update AgentDB supported_bw_list rank (used by ZWDFS)
+            auto bw_it = std::find_if(ch_info.supported_bw_list.begin(), ch_info.supported_bw_list.end(),
+                                      [&](const beerocks_message::sSupportedBandwidth &sbw) {
+                                          return sbw.bandwidth == entry.bandwidth;
+                                      });
+            if (bw_it != ch_info.supported_bw_list.end()) {
+                bw_it->rank = entry.rank;
+            } else {
+                // BW unsupported on this channel
+                entry.preference = 0;
+                entry.reason = wfa_map::cPreferenceOperatingClasses::eReasonCode::UNSPECIFIED;
+                continue;
+            }
+
+            // Overlay AWGN
+            if (ch_info.awgn_detected) {
+                entry.preference = 0;
+                entry.reason = wfa_map::cPreferenceOperatingClasses::eReasonCode::AWGN_DETECTED;
+                continue;
+            }
+
+            // Overlay DFS radar
+            if (ch_info.dfs_state == beerocks_message::eDfsState::UNAVAILABLE) {
+                entry.preference = 0;
+                entry.reason = wfa_map::cPreferenceOperatingClasses::eReasonCode::
+                    OPERATION_DISALLOWED_DUE_TO_RADAR_DETECTION_ON_A_DFS_CHANNEL;
+                continue;
+            }
+        }
+    }
+
+    // Atomically replace the cache.
+    radio->cbs_preference_table.by_opclass_channel = std::move(new_cache);
+    radio->cbs_preference_table.valid = true;
+    radio->cbs_preference_table.last_cbs_complete = std::chrono::steady_clock::now();
+
+    // Log the resulting cache content for verification.
+    // NOTE: log each entry on its OWN line. A single multi-line LOG() gets truncated by the
+    // logger/syslog transport, which is why the per-entry dump was previously not visible even
+    // though "SUCCESS" printed.
+    size_t total_entries = 0;
+    for (const auto &oc_pair : radio->cbs_preference_table.by_opclass_channel) {
+        total_entries += oc_pair.second.size();
+    }
+    LOG(DEBUG) << "[CBS] refresh_preference_table: SUCCESS on radio " << radio_mac << " ("
+               << radio->cbs_preference_table.by_opclass_channel.size() << " op-classes, "
+               << total_entries << " entries):";
+    for (const auto &oc_pair : radio->cbs_preference_table.by_opclass_channel) {
+        for (const auto &ch_pair : oc_pair.second) {
+            const auto &e = ch_pair.second;
+            LOG(DEBUG) << "[CBS]   op_class=" << int(oc_pair.first) << " chan=" << int(e.channel)
+                       << " bw=" << beerocks::utils::convert_bandwidth_to_string(e.bandwidth)
+                       << " rank=" << e.rank << " -> pref=" << int(e.preference)
+                       << " reason=" << int(e.reason);
+        }
+    }
+
+    return true;
+}
+
+std::set<uint8_t> ChannelSelectionTask::build_preferred_channel_set(
+    const AgentDB::sRadio::channel_preferences_map &controller_preferences)
+{
+    // Preferred = channels the controller reported with preference != 0 (operable). Op-classes with
+    // an empty channel list are expanded to all channels of that op-class. Channels explicitly
+    // reported preference == 0 (excluded) are removed. If the controller sent NO operable op-class
+    // at all, we leave the set EMPTY and let the caller decide (the pre-selection rules treat an
+    // empty preferred set as "no rule applies").
+    std::set<uint8_t> preferred_channels;
+    std::set<uint8_t> excluded_channels;
+
+    for (const auto &pref : controller_preferences) {
+        auto &target = (pref.first.flags.preference == 0) ? excluded_channels : preferred_channels;
+        if (pref.second.empty()) {
+            const auto oc_it =
+                son::wireless_utils::operating_classes_list.find(pref.first.operating_class);
+            if (oc_it != son::wireless_utils::operating_classes_list.end()) {
+                for (const auto ch : oc_it->second.channels) {
+                    target.insert(ch);
+                }
+            }
+        } else {
+            for (const auto ch : pref.second) {
+                target.insert(ch);
+            }
+        }
+    }
+
+    for (const auto ch : excluded_channels) {
+        preferred_channels.erase(ch);
+    }
+    return preferred_channels;
+}
+
+bool ChannelSelectionTask::select_best_channel_from_cbs(
+    const sMacAddr &radio_mac,
+    const AgentDB::sRadio::channel_preferences_map &controller_preferences,
+    sSelectedChannel &out_selected)
+{
+    auto db    = AgentDB::get();
+    auto radio = db->get_radio_by_mac(radio_mac, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(ERROR) << "[CBS] select_best_channel_from_cbs: radio " << radio_mac << " not in DB";
+        return false;
+    }
+
+    const auto &cache = radio->cbs_preference_table;
+    if (!cache.valid || cache.by_opclass_channel.empty()) {
+        LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: no valid CBS cache for radio "
+                   << radio_mac << " -> fallback";
+        return false;
+    }
+
+    // Build the controller "preferred" channel set (shared helper). If the controller sent no
+    // explicit preferred op-class, assume all radio channels are preferred.
+    std::set<uint8_t> preferred_channels = build_preferred_channel_set(controller_preferences);
+    if (preferred_channels.empty()) {
+        for (const auto &ch_pair : radio->channels_list) {
+            preferred_channels.insert(ch_pair.first);
+        }
+    }
+
+    if (preferred_channels.empty()) {
+        LOG(WARNING) << "[CBS] select_best_channel_from_cbs: controller preferred set is EMPTY for "
+                     << radio_mac << " -> fallback";
+        return false;
+    }
+
+    // Selection policy (matches the driver's own "Best channel" semantics):
+    // The QCA CBS/ACS report assigns a positive RANK (1 = best) only to the channels it actually
+    // evaluated as candidates for the chosen bandwidth; lower rank is better. So we select the
+    // channel/bandwidth with the BEST (lowest positive) rank among the controller-preferred &
+    // operable entries. Rank dominates; bandwidth (wider) is only a tie-break when two entries
+    // share the same rank. Channels with rank 0 (operable-but-unranked baseline) are considered
+    // only if there is NO positively-ranked preferred channel at all.
+    auto bw_to_mhz = [](beerocks::eWiFiBandwidth bw) -> uint32_t {
+        switch (bw) {
+        case beerocks::eWiFiBandwidth::BANDWIDTH_20:    return 20;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_40:    return 40;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_80:    return 80;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_80_80: return 80;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_160:   return 160;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_320:
+        case beerocks::eWiFiBandwidth::BANDWIDTH_320_1:
+        case beerocks::eWiFiBandwidth::BANDWIDTH_320_2: return 320;
+        default:                                        return 0;
+        }
+    };
+
+    // Fallback policy: CBS rank-based selection is only meaningful when the driver actually
+    // ranked at least one channel in the controller-preferred set (rank > 0). The driver only
+    // assigns positive ranks to channels it evaluated for the current operating bandwidth; if the
+    // preferred set contains NO positively-ranked channel (e.g. the CBS scan didn't cover any of
+    // them, or all are rank-0 baseline), then the CBS cache carries no useful ordering for this
+    // request. In that case we must NOT arbitrarily pick a rank-0 preferred channel; instead we
+    // return false so the caller falls back to the existing cumulative-preference-score selection
+    // (build_acs_list / check_is_there_better_channel_than_current), preserving legacy behaviour.
+    {
+        bool any_positive_rank_in_preferred = false;
+        for (const auto &oc_pair : cache.by_opclass_channel) {
+            for (const auto &ch_pair : oc_pair.second) {
+                const auto &e = ch_pair.second;
+                if (e.preference == 0) {
+                    continue; // non-operable
+                }
+                if (preferred_channels.find(e.channel) == preferred_channels.end()) {
+                    continue; // not preferred
+                }
+                if (e.rank > 0) {
+                    any_positive_rank_in_preferred = true;
+                    break;
+                }
+            }
+            if (any_positive_rank_in_preferred) {
+                break;
+            }
+        }
+        if (!any_positive_rank_in_preferred) {
+            LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: NO positively-ranked (>0) channel in "
+                          "the controller-preferred set for radio "
+                       << radio_mac
+                       << " -> CBS has no useful ordering; falling back to cumulative-score method";
+            return false;
+        }
+    }
+
+    // "goodness" of a rank: a positive rank is always better than the unranked baseline (0);
+    // among positive ranks, the lower value is better. Represent as a sortable key where a
+    // SMALLER key is better: ranked entries get key = rank (>=1), unranked (rank 0) get a very
+    // large key so they only win when nothing ranked is available.
+    auto rank_key = [](int32_t rank) -> int64_t {
+        return (rank > 0) ? static_cast<int64_t>(rank) : INT64_MAX;
+    };
+
+    int64_t  best_key   = INT64_MAX;
+    uint32_t best_bwmhz = 0;
+    bool     found      = false;
+    AgentDB::sRadio::sPreferenceEntry best{};
+
+    // Selection trace. Each candidate and each running-best update is logged on its OWN LOG line
+    // (a single multi-line LOG gets truncated by the syslog transport, hiding the decisive rows).
+    // "rank_key" is the sort key actually used: lower is better; a positive driver rank maps to
+    // rank_key=rank, while a rank-0 (operable-but-unranked baseline) maps to a very large key so it
+    // only wins when nothing positively-ranked exists. Tie on rank_key is broken by wider bw_mhz.
+    LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: radio=" << radio_mac
+               << " preferred_count=" << preferred_channels.size()
+               << " -- evaluating candidates (policy: lowest rank_key wins; tie -> wider bw). "
+                  "NOTE: this is a RANK-FIRST selection, not a bw_weight*preference score.";
+
+    size_t candidate_count = 0;
+    for (const auto &oc_pair : cache.by_opclass_channel) {
+        for (const auto &ch_pair : oc_pair.second) {
+            const auto &e = ch_pair.second;
+            if (e.preference == 0) {
+                continue; // non-operable in CBS (radar/awgn/unsupported)
+            }
+            if (preferred_channels.find(e.channel) == preferred_channels.end()) {
+                continue; // not in controller-preferred set
+            }
+            ++candidate_count;
+            const uint32_t bw_mhz = bw_to_mhz(e.bandwidth);
+            const int64_t  key    = rank_key(e.rank);
+
+            // Best (lowest) rank_key wins; tie-break by higher bandwidth.
+            bool better = false;
+            const char *reason = "not-better";
+            if (!found) {
+                better = true;
+                reason = "first-candidate";
+            } else if (key < best_key) {
+                better = true;
+                reason = "lower-rank_key";
+            } else if (key == best_key && bw_mhz > best_bwmhz) {
+                better = true;
+                reason = "same-rank_key-wider-bw";
+            }
+
+            LOG(DEBUG) << "[CBS]   candidate op_class=" << int(e.operating_class)
+                       << " chan=" << int(e.channel)
+                       << " bw=" << beerocks::utils::convert_bandwidth_to_string(e.bandwidth)
+                       << " (" << bw_mhz << "MHz)"
+                       << " pref=" << int(e.preference) << " rank=" << e.rank
+                       << " rank_key=" << (key == INT64_MAX ? -1 : key) << " -> "
+                       << (better ? "NEW-BEST" : "keep-current-best") << " [" << reason << "]"
+                       << (better ? "" : (" (current best: chan=" + std::to_string(int(best.channel)) +
+                                          " bw=" +
+                                          beerocks::utils::convert_bandwidth_to_string(best.bandwidth) +
+                                          " rank=" + std::to_string(best.rank) + ")"));
+
+            if (better) {
+                best_key   = key;
+                best_bwmhz = bw_mhz;
+                best       = e;
+                found      = true;
+            }
+        }
+    }
+    LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: evaluated " << candidate_count
+               << " preferred&operable candidate(s); winner (pre-bw-upgrade): chan="
+               << int(best.channel) << " op_class=" << int(best.operating_class)
+               << " bw=" << beerocks::utils::convert_bandwidth_to_string(best.bandwidth)
+               << " rank=" << best.rank << " rank_key=" << (best_key == INT64_MAX ? -1 : best_key);
+
+    if (!found) {
+        LOG(WARNING) << "[CBS] select_best_channel_from_cbs: no feasible (preferred & operable) "
+                        "channel found in CBS cache for radio "
+                     << radio_mac << " -> fallback";
+        return false;
+    }
+
+    // Resolve to a beacon/primary channel if the winning op-class uses a center channel.
+    const auto freq_type = radio->wifi_channel.get_freq_type();
+    uint8_t primary_channel = best.channel;
+    if (son::wireless_utils::is_operating_class_using_central_channel(best.operating_class)) {
+        auto center_chan = son::wireless_utils::get_center_channel(best.channel, freq_type,
+                                                                   best.bandwidth);
+        // best.channel is a beacon channel already (we cache per beacon channel); only convert if
+        // it turned out to be the center channel.
+        if (center_chan == best.channel) {
+            auto beacons = son::wireless_utils::center_channel_to_beacon_channels(
+                best.channel, best.bandwidth, freq_type);
+            // pick a beacon channel that is in the preferred set, else the first.
+            uint8_t chosen = 0;
+            for (const auto b : beacons) {
+                if (preferred_channels.find(b) != preferred_channels.end()) {
+                    chosen = b;
+                    break;
+                }
+            }
+            if (chosen == 0 && !beacons.empty()) {
+                chosen = beacons.front();
+            }
+            if (chosen != 0) {
+                primary_channel = chosen;
+            }
+        }
+    }
+
+    out_selected                 = sSelectedChannel{};
+    out_selected.channel         = primary_channel;
+    out_selected.operating_class = best.operating_class;
+    out_selected.bw              = best.bandwidth;
+    out_selected.rank            = best.rank;
+    out_selected.preference_score = best.preference;
+    {
+        auto it_ch = radio->channels_list.find(primary_channel);
+        out_selected.dfs_state = (it_ch != radio->channels_list.end())
+                                     ? it_ch->second.dfs_state
+                                     : beerocks_message::eDfsState::NOT_DFS;
+    }
+
+    // Stick to the radio's operating (widest) bandwidth for the chosen channel.
+    //
+    // The driver's "ACS show_report" ranks channels for the bandwidth the radio is CURRENTLY
+    // operating at when the CBS scan runs. If the radio happened to be at 20MHz at scan time, the
+    // report (and therefore best.bandwidth) is 20MHz — even though the radio could operate wider.
+    // We do NOT want to downgrade the channel to that narrow scan-BW. Instead, once the best
+    // channel is chosen by rank, present/switch it at the radio's operating bandwidth (its current
+    // bw, else its max supported bw), provided the selected channel actually supports that wider
+    // bandwidth in its supported_bw_list and the corresponding (channel,bw) op-class is valid.
+    // This mirrors the qca-ezmesh "build up from 20MHz to max supported BW" intent: the ranked
+    // channel is kept, but the operating width is the widest the channel/radio supports.
+    {
+        // Determine the desired operating bandwidth: current operating bw, else max supported bw.
+        beerocks::eWiFiBandwidth desired_bw = radio->wifi_channel.get_bandwidth();
+        if (desired_bw == beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN ||
+            radio->max_supported_bw > desired_bw) {
+            if (radio->max_supported_bw != beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+                desired_bw = radio->max_supported_bw;
+            }
+        }
+
+        // Only upgrade (never downgrade below the ranked bw), and only if the selected primary
+        // channel actually supports the desired bandwidth on this radio.
+        if (desired_bw != beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN &&
+            desired_bw > out_selected.bw) {
+
+            auto it_ch = radio->channels_list.find(primary_channel);
+            bool primary_supports_desired = false;
+            beerocks::eWiFiBandwidth matched_variant = desired_bw;
+            if (it_ch != radio->channels_list.end()) {
+                for (const auto &sbw : it_ch->second.supported_bw_list) {
+                    // For 6GHz 320MHz, supported_bw_list holds the specific 320-1/320-2 variant;
+                    // treat any of them as matching the generic desired 320MHz.
+                    if (sbw.bandwidth == desired_bw) {
+                        primary_supports_desired = true;
+                        matched_variant          = sbw.bandwidth;
+                        break;
+                    }
+                    if (desired_bw == beerocks::eWiFiBandwidth::BANDWIDTH_320 &&
+                        (sbw.bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320_1 ||
+                         sbw.bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320_2)) {
+                        primary_supports_desired = true;
+                        matched_variant          = sbw.bandwidth;
+                        break;
+                    }
+                }
+            }
+
+            if (primary_supports_desired) {
+                // Recompute the op-class for (primary_channel, matched_variant) so the outgoing
+                // switch carries a consistent (channel, bw, op-class) triple.
+                const auto up_opclass = son::wireless_utils::get_operating_class_by_channel(
+                    beerocks::WifiChannel(primary_channel, freq_type, matched_variant));
+                if (up_opclass != 0) {
+                    LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: upgrading selected bandwidth "
+                                  "from "
+                               << beerocks::utils::convert_bandwidth_to_string(out_selected.bw)
+                               << " to operating bandwidth "
+                               << beerocks::utils::convert_bandwidth_to_string(matched_variant)
+                               << " for chan=" << int(primary_channel)
+                               << " (op_class " << int(out_selected.operating_class) << " -> "
+                               << int(up_opclass) << ")";
+                    out_selected.bw              = matched_variant;
+                    out_selected.operating_class = up_opclass;
+                } else {
+                    LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: chan=" << int(primary_channel)
+                               << " supports "
+                               << beerocks::utils::convert_bandwidth_to_string(matched_variant)
+                               << " but op-class lookup failed; keeping ranked bw "
+                               << beerocks::utils::convert_bandwidth_to_string(out_selected.bw);
+                }
+            } else {
+                LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: chan=" << int(primary_channel)
+                           << " does not support operating bandwidth "
+                           << beerocks::utils::convert_bandwidth_to_string(desired_bw)
+                           << "; keeping ranked bw "
+                           << beerocks::utils::convert_bandwidth_to_string(out_selected.bw);
+            }
+        }
+    }
+
+    LOG(DEBUG) << "[CBS] select_best_channel_from_cbs: SELECTED chan=" << int(out_selected.channel)
+               << " op_class=" << int(out_selected.operating_class)
+               << " bw=" << beerocks::utils::convert_bandwidth_to_string(out_selected.bw)
+               << " rank=" << out_selected.rank << " pref=" << int(out_selected.preference_score)
+               << " rank_key=" << (best_key == INT64_MAX ? -1 : best_key);
+    return true;
+}
