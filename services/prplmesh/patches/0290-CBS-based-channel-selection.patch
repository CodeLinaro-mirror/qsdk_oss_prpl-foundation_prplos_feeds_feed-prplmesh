+bool base_wlan_hal_nl80211::wpa_ctrl_send_msg_bufsize(const std::string &cmd, std::string &reply,
+                                                      size_t buf_size, const std::string &ifname)
+{
+    reply.clear();
+
+    std::string iface_name = ifname;
+    if (iface_name.empty()) {
+        iface_name = get_iface_name();
+    }
+
+    auto wpa_ctrl_cmd = m_wpa_ctrl_client.get_socket_cmd(iface_name);
+    if (!wpa_ctrl_cmd) {
+        LOG(ERROR) << "Control socket not available for iface " << iface_name;
+        return false;
+    }
+
+    if (buf_size == 0) {
+        buf_size = 4096;
+    }
+
+    // Temporary, command-scoped buffer so large replies (e.g. "ACS show_report" on 6GHz) do not
+    // overflow the shared m_wpa_ctrl_buffer. +1 for the NUL terminator that request() appends.
+    std::vector<char> local_buffer(buf_size + 1, '\0');
+
+    if (!wpa_ctrl_cmd->request(cmd, local_buffer.data(), buf_size)) {
+        LOG(ERROR) << "wpa_ctrl_send_msg_bufsize: request failed for cmd '" << cmd
+                   << "' on iface " << iface_name << " (buf_size=" << buf_size << ")";
+        return false;
+    }
+
+    if ((!strncmp(local_buffer.data(), "FAIL", 4)) ||
+        (!strncmp(local_buffer.data(), "UNKNOWN", 7))) {
+        LOG(WARNING) << "wpa_ctrl_send_msg_bufsize: cmd '" << cmd << "' returned: "
+                     << local_buffer.data();
+        return false;
+    }
+
+    reply.assign(local_buffer.data());
+    return true;
+}
