+bool ap_wlan_hal_nl80211::trigger_cbs()
+{
+    // Trigger a one-shot CBS scan via "CBS enable 1" on the base radio hostapd control socket.
+    // Same socket-selection logic as read_acs_ranks()/start_platform_acs(): the CBS control
+    // command is registered on the base radio socket (e.g. /var/run/hostapd/wlan2), not the
+    // per-link socket.
+    const std::string link_iface = m_radio_info.iface_name;
+    std::string radio_iface;
+    extractLinkBaseInterface(link_iface, radio_iface);
+    if (radio_iface.empty()) {
+        radio_iface = link_iface;
+    }
+
+    if (!is_wpa_ctrl_interface_registered(radio_iface)) {
+        if (add_interface(radio_iface) < 0) {
+            LOG(WARNING) << "[CBS] trigger_cbs: add_interface(" << radio_iface
+                         << ") failed; will still attempt to send on it";
+        }
+    }
+
+    const std::string cmd = "CBS enable 1";
+    LOG(INFO) << "[CBS] trigger_cbs: sending '" << cmd << "' on iface=" << radio_iface;
+    if (!wpa_ctrl_send_msg(cmd, radio_iface)) {
+        LOG(ERROR) << "[CBS] trigger_cbs: '" << cmd << "' failed on iface=" << radio_iface;
+        return false;
+    }
+    LOG(DEBUG) << "[CBS] trigger_cbs: '" << cmd << "' OK on iface=" << radio_iface;
     return true;
 }
 
