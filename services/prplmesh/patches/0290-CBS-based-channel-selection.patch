+                bw = resolved;
+            } else if (cl.find(beerocks::eWiFiBandwidth::BANDWIDTH_320_1) != cl.end()) {
+                // Fallback only if the center-derived variant isn't present for this channel.
+                bw = beerocks::eWiFiBandwidth::BANDWIDTH_320_1;
+            } else if (cl.find(beerocks::eWiFiBandwidth::BANDWIDTH_320_2) != cl.end()) {
