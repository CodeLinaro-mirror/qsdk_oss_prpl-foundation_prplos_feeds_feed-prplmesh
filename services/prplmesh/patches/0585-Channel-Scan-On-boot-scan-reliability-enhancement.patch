+bool ChannelScanTask::is_on_boot_scan_cache_valid(const sMacAddr &radio_mac)
+{
+    auto db    = AgentDB::get();
+    auto radio = db->get_radio_by_mac(radio_mac);
+    if (!radio) {
+        LOG(ERROR) << "Failed to get radio entry for MAC: " << radio_mac;
+        return false;
+    }
+
+    // An empty map means no scan has ever stored anything for this radio (e.g. right after a
+    // dev-reset, before handle_backhaul_enable_event()'s init loop below, or before any scan
+    // has ever run) - definitely not a valid cache.
+    if (radio->channel_scan_results.empty()) {
+        return false;
+    }
+
+    // A valid cache requires every known channel entry to already reflect a successful scan.
+    // Any entry still at SCAN_NOT_COMPLETED (the initial value set by the init loop below) or
+    // any other non-SUCCESS status means the early trigger either hasn't run yet, is still in
+    // progress, or ran and failed/was only partially successful - in all of these cases we
+    // should not treat the cache as valid and should (re)attempt a trigger.
+    for (const auto &result_kv : radio->channel_scan_results) {
+        const auto &result_tuple = result_kv.second;
+        if (std::get<0>(result_tuple) != eScanStatus::SUCCESS) {
+            return false;
+        }
+    }
+    return true;
