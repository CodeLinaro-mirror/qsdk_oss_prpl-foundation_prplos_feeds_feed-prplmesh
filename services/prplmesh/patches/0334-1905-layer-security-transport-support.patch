+// ============================================================================
+// Utility helpers
+// ============================================================================
+
+std::vector<uint8_t> Ieee1905SecurityManager::encode_counter(uint64_t counter)
+{
+    // Encode as 6 bytes big-endian (48-bit counter) - network byte order
+    // This matches IEEE 1905.1 spec and third-party implementation
+    std::vector<uint8_t> out(6);
+    out[0] = (counter >> 40) & 0xFF;
+    out[1] = (counter >> 32) & 0xFF;
+    out[2] = (counter >> 24) & 0xFF;
+    out[3] = (counter >> 16) & 0xFF;
+    out[4] = (counter >> 8) & 0xFF;
+    out[5] = counter & 0xFF;
+    return out;
+}
+
+std::vector<uint8_t> Ieee1905SecurityManager::collect_tlvs(const uint8_t *buf, size_t buf_len)
+{
+    if (!buf || buf_len < 8) return {};
+
+    // CMDU header is 8 bytes; TLVs start after header
+    const uint8_t *tlv_start = buf + 8;
+    size_t tlv_len           = buf_len - 8;
+
+    // Find End of Message TLV (type=0, length=0) and exclude it
+    size_t end_offset = tlv_len;
+    size_t offset     = 0;
+    while (offset + 3 <= tlv_len) {
+        uint8_t tlv_type = tlv_start[offset];
+        uint16_t tlv_length =
+            (static_cast<uint16_t>(tlv_start[offset + 1]) << 8) | tlv_start[offset + 2];
+        if (tlv_type == 0 && tlv_length == 0) {
+            end_offset = offset;
+            break;
+        }
+        offset += 3 + tlv_length;
+    }
+
+    return std::vector<uint8_t>(tlv_start, tlv_start + end_offset);
+}
+
+std::vector<uint8_t> Ieee1905SecurityManager::collect_tlvs(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    return collect_tlvs(cmdu_tx.getMessageBuff(), cmdu_tx.getMessageLength());
+}
+
+std::vector<uint8_t> Ieee1905SecurityManager::get_cmdu_header_6bytes(
+    ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    const uint8_t *buf = cmdu_tx.getMessageBuff();
+    if (!buf) return {};
+    // Use raw packet bytes as-is for AD1
+    // The agent uses the raw wire format (little-endian as stored by prplMesh)
+    return std::vector<uint8_t>(buf, buf + 6);
+}
+
+std::vector<uint8_t> Ieee1905SecurityManager::get_cmdu_header_6bytes(
+    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    const uint8_t *buf = cmdu_rx.getMessageBuff();
+    if (!buf) return {};
+    // Use raw packet bytes as-is for AD1
+    // The agent uses the raw wire format (little-endian as stored by prplMesh)
+    return std::vector<uint8_t>(buf, buf + 6);
+}
