+/**
+ * @brief Helper class for DPP cryptographic operations
+ *
+ * Provides AES-SIV encryption/decryption and HMAC-SHA256 functions
+ * required for 1905 security layer implementation.
+ */
+class DppCryptoHelper {
+public:
+    /**
+     * @brief Encrypt data using AES-SIV (RFC 5297)
+     *
+     * @param key Encryption key (32 bytes for AES-256)
+     * @param key_len Length of the key in bytes
+     * @param plaintext Data to encrypt
+     * @param aad Vector of Additional Authenticated Data (AAD) components
+     * @return Encrypted ciphertext with SIV prepended, or empty vector on failure
+     */
+    static std::vector<uint8_t> aes_siv_encrypt(const uint8_t *key, size_t key_len,
+                                                 const std::vector<uint8_t> &plaintext,
+                                                 const std::vector<std::vector<uint8_t>> &aad);
+
+    /**
+     * @brief Decrypt data using AES-SIV (RFC 5297)
+     *
+     * @param key Decryption key (32 bytes for AES-256)
+     * @param key_len Length of the key in bytes
+     * @param ciphertext Data to decrypt (includes SIV)
+     * @param aad Vector of Additional Authenticated Data (AAD) components
+     * @param[out] plaintext Decrypted plaintext on success (may be empty for a 0-TLV message)
+     * @return true if authentication succeeded and plaintext is valid, false on auth failure
+     */
+    static bool aes_siv_decrypt(const uint8_t *key, size_t key_len,
+                                 const std::vector<uint8_t> &ciphertext,
+                                 const std::vector<std::vector<uint8_t>> &aad,
+                                 std::vector<uint8_t> &plaintext);
+
+    /**
+     * @brief Compute HMAC-SHA256
+     *
+     * @param key HMAC key
+     * @param key_len Length of the key in bytes
+     * @param data Data to authenticate
+     * @param data_len Length of the data in bytes
+     * @param out Output buffer for HMAC (must be at least 32 bytes)
+     * @return true on success, false on failure
+     */
+    static bool hmac_sha256(const uint8_t *key, size_t key_len,
+                           const uint8_t *data, size_t data_len,
+                           uint8_t *out);
+};
+
+#endif // _TRANSPORT_DPP_CRYPTO_HELPER_H_
