@@ -0,0 +1,222 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "include/dpp_crypto_helper.h"
+
+#include <mapf/common/logger.h>
+
+#include <openssl/evp.h>
+#include <openssl/err.h>
+#include <openssl/params.h>
+
+#include <cstring>
+#include <algorithm>
+
+// RFC 5297 AES-SIV helpers
+// K1 = key[0..15], K2 = key[16..31]
+// S2V produces the SIV by: CMAC each component individually with dbl+xor chaining.
+
+// OMAC1/CMAC using EVP_MAC (OpenSSL 3.x API, replaces deprecated CMAC_CTX_*)
+static bool omac1_aes128(const uint8_t *k1, const uint8_t *data, size_t len, uint8_t out[16])
+{
+    EVP_MAC *mac = EVP_MAC_fetch(nullptr, "CMAC", nullptr);
+    if (!mac) return false;
+
+    EVP_MAC_CTX *ctx = EVP_MAC_CTX_new(mac);
+    EVP_MAC_free(mac);
+    if (!ctx) return false;
+
+    OSSL_PARAM params[] = {
+        OSSL_PARAM_construct_utf8_string("cipher", const_cast<char *>("AES-128-CBC"), 0),
+        OSSL_PARAM_construct_end()
+    };
+    if (EVP_MAC_init(ctx, k1, 16, params) != 1 ||
+        EVP_MAC_update(ctx, data, len) != 1) {
+        EVP_MAC_CTX_free(ctx);
+        return false;
+    }
+    size_t out_len = 16;
+    bool ok = (EVP_MAC_final(ctx, out, &out_len, 16) == 1) && out_len == 16;
+    EVP_MAC_CTX_free(ctx);
+    return ok;
+}
+
+// dbl: shift left by 1 in GF(2^128) with polynomial x^128 + x^7 + x^2 + x + 1
+static void dbl_block(uint8_t b[16])
+{
+    int carry = b[0] & 0x80;
+    for (int i = 0; i < 15; i++)
+        b[i] = static_cast<uint8_t>((b[i] << 1) | (b[i + 1] >> 7));
+    b[15] = static_cast<uint8_t>((b[15] << 1) ^ (carry ? 0x87 : 0x00));
+}
+
+static void xor_block(uint8_t *a, const uint8_t *b, size_t len)
+{
+    for (size_t i = 0; i < len; i++) a[i] ^= b[i];
+}
+
+// S2V per RFC 5297 §2.4
+// aad[] are AD1..ADn, last element is plaintext P
+static bool s2v(const uint8_t *k1,
+                const std::vector<std::vector<uint8_t>> &aad,
+                const std::vector<uint8_t> &plaintext,
+                uint8_t siv[16])
+{
+    static const uint8_t zero16[16] = {};
+    uint8_t d[16];
+
+    // D = OMAC(K1, <zero>)
+    if (!omac1_aes128(k1, zero16, 16, d)) return false;
+
+    // For each AD component: D = dbl(D) xor OMAC(K1, AD_i)
+    for (const auto &ad : aad) {
+        uint8_t tmp[16];
+        if (!omac1_aes128(k1, ad.data(), ad.size(), tmp)) return false;
+        dbl_block(d);
+        xor_block(d, tmp, 16);
+    }
+
+    // Final component = plaintext P
+    if (plaintext.size() >= 16) {
+        // xorend: XOR D into the last 16 bytes of P, then OMAC
+        std::vector<uint8_t> buf(plaintext);
+        xor_block(buf.data() + buf.size() - 16, d, 16);
+        if (!omac1_aes128(k1, buf.data(), buf.size(), siv)) return false;
+    } else {
+        // pad P to 16 bytes: P || 0x80 || 0x00...
+        uint8_t pad[16] = {};
+        memcpy(pad, plaintext.data(), plaintext.size());
+        pad[plaintext.size()] = 0x80;
+        dbl_block(d);
+        xor_block(d, pad, 16);
+        if (!omac1_aes128(k1, d, 16, siv)) return false;
+    }
+    return true;
+}
+
+static bool aes_ctr_crypt(const uint8_t *k2, const uint8_t iv[16],
+                           const uint8_t *in, uint8_t *out, size_t len)
+{
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+    if (!ctx) return false;
+    if (EVP_EncryptInit_ex(ctx, EVP_aes_128_ctr(), nullptr, k2, iv) != 1) {
+        EVP_CIPHER_CTX_free(ctx);
+        return false;
+    }
+    int outl = 0, finl = 0;
+    if (EVP_EncryptUpdate(ctx, out, &outl, in, static_cast<int>(len)) != 1 ||
+        EVP_EncryptFinal_ex(ctx, out + outl, &finl) != 1) {
+        EVP_CIPHER_CTX_free(ctx);
+        return false;
+    }
+    EVP_CIPHER_CTX_free(ctx);
+    return true;
+}
+
+std::vector<uint8_t> DppCryptoHelper::aes_siv_encrypt(const uint8_t *key, size_t key_len,
+                                                       const std::vector<uint8_t> &plaintext,
+                                                       const std::vector<std::vector<uint8_t>> &aad)
+{
+    if (!key || key_len != 32) {
+        LOG(ERROR) << "DppCryptoHelper: Invalid key for AES-SIV encrypt (expected 32 bytes)";
+        return {};
+    }
+
+    const uint8_t *k1 = key;
+    const uint8_t *k2 = key + 16;
+
+    // Step 1: SIV = S2V(K1, AD1..ADn, P)
+    uint8_t siv[16];
+    if (!s2v(k1, aad, plaintext, siv)) {
+        LOG(ERROR) << "DppCryptoHelper: S2V failed";
+        return {};
+    }
+
+    // Step 2: CTR-encrypt P using IV = SIV with bits 63 and 31 cleared
+    uint8_t ctr_iv[16];
+    memcpy(ctr_iv, siv, 16);
+    ctr_iv[8] &= 0x7F;
+    ctr_iv[12] &= 0x7F;
+
+    std::vector<uint8_t> result(16 + plaintext.size());
+    memcpy(result.data(), siv, 16);
+
+    if (!aes_ctr_crypt(k2, ctr_iv, plaintext.data(), result.data() + 16, plaintext.size())) {
+        LOG(ERROR) << "DppCryptoHelper: AES-CTR encrypt failed";
+        return {};
+    }
+    return result;
+}
+
+bool DppCryptoHelper::aes_siv_decrypt(const uint8_t *key, size_t key_len,
+                                       const std::vector<uint8_t> &ciphertext,
+                                       const std::vector<std::vector<uint8_t>> &aad,
+                                       std::vector<uint8_t> &plaintext)
+{
+    if (!key || key_len != 32) {
+        LOG(ERROR) << "DppCryptoHelper: Invalid key for AES-SIV decrypt (expected 32 bytes)";
+        return false;
+    }
+    if (ciphertext.size() < 16) {
+        LOG(ERROR) << "DppCryptoHelper: Ciphertext too short for AES-SIV decrypt";
+        return false;
+    }
+
+    const uint8_t *k1 = key;
+    const uint8_t *k2 = key + 16;
+    const uint8_t *siv = ciphertext.data();
+    size_t ct_len      = ciphertext.size() - 16;
+
+    // Step 1: CTR-decrypt using IV = SIV with bits 63 and 31 cleared
+    uint8_t ctr_iv[16];
+    memcpy(ctr_iv, siv, 16);
+    ctr_iv[8] &= 0x7F;
+    ctr_iv[12] &= 0x7F;
+
+    std::vector<uint8_t> decrypted(ct_len);
+    if (!aes_ctr_crypt(k2, ctr_iv, ciphertext.data() + 16, decrypted.data(), ct_len)) {
+        LOG(ERROR) << "DppCryptoHelper: AES-CTR decrypt failed";
+        return false;
+    }
+
+    // Step 2: Recompute SIV and verify
+    uint8_t check[16];
+    if (!s2v(k1, aad, decrypted, check)) {
+        LOG(ERROR) << "DppCryptoHelper: S2V verification failed";
+        return false;
+    }
+
+    if (memcmp(check, siv, 16) != 0) {
+        LOG(ERROR) << "DppCryptoHelper: SIV verification failed - authentication tag mismatch";
+        return false;
+    }
+
+    plaintext = std::move(decrypted);
+    return true;
+}
+
+bool DppCryptoHelper::hmac_sha256(const uint8_t *key, size_t key_len,
+                                  const uint8_t *data, size_t data_len,
+                                  uint8_t *out)
+{
+    if (!key || !data || !out) {
+        LOG(ERROR) << "DppCryptoHelper: Invalid parameters for HMAC-SHA256";
+        return false;
+    }
+
+    // HMAC-SHA256 using EVP_Q_mac (OpenSSL 3.x API, replaces deprecated HMAC())
+    size_t out_len = 32;
+    if (!EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+                   key, key_len, data, data_len, out, 32, &out_len)) {
+        LOG(ERROR) << "DppCryptoHelper: HMAC-SHA256 computation failed";
+        return false;
+    }
+
+    if (out_len != 32) {
+        LOG(ERROR) << "DppCryptoHelper: Unexpected HMAC output length: " << out_len;
+        return false;
+    }
+
+    return true;
+}
