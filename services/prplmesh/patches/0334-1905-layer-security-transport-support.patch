+void Ieee1905Transport::handle_security_key_install_message(SecurityKeyInstallMessage &msg)
+{
+    if (!m_security_manager) {
+        MAPF_ERR("Security manager not initialized (AL MAC not set yet)");
+        return;
+    }
+
+    auto *metadata = msg.metadata();
+    sMacAddr peer_mac = tlvf::mac_from_array(metadata->peer_mac);
+
+    if (metadata->install) {
+        // Install keys
+        std::array<uint8_t, 32> tk;
+        std::array<uint8_t, 32> gtk;
+        std::copy_n(metadata->tk, 32, tk.begin());
+        std::copy_n(metadata->gtk, 32, gtk.begin());
+
+        m_security_manager->install_agent_keys(peer_mac, tk, gtk, metadata->gtk_key_id);
+        MAPF_INFO("Installed 1905 security keys for peer: " << peer_mac);
+    } else {
+        // Remove keys
+        m_security_manager->remove_agent(peer_mac);
+        MAPF_INFO("Removed 1905 security keys for peer: " << peer_mac);
+    }
