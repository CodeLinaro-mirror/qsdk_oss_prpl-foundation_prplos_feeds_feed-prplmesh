+// ============================================================================
+// Exception message types — never encrypted per EasyMesh §13.3.2
+// ============================================================================
+
+bool Ieee1905SecurityManager::is_exception_message(ieee1905_1::eMessageType msg_type)
+{
+    switch (msg_type) {
+    case ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_SEARCH_MESSAGE:
+    case ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RESPONSE_MESSAGE:
+    case ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE:
+    case ieee1905_1::eMessageType::IEEE1905_ENCAP_EAPOL_MESSAGE:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// ============================================================================
+// Constructor
+// ============================================================================
+
+Ieee1905SecurityManager::Ieee1905SecurityManager(const sMacAddr &controller_al_mac)
+    : m_controller_al_mac(controller_al_mac)
+{
+    m_gtk.fill(0);
+}
+
+// ============================================================================
+// Key installation
+// ============================================================================
+
+void Ieee1905SecurityManager::install_agent_keys(const sMacAddr &agent_mac,
+                                                   const std::array<uint8_t, 32> &tk,
+                                                   const std::array<uint8_t, 32> &gtk,
+                                                   uint8_t gtk_key_id)
+{
+    auto &state            = m_agent_states[agent_mac];
+    state.tk               = tk;
+    state.has_tk           = true;
+    state.security_enabled = true;
+    state.enc_tx_counter   = 1;
+    state.enc_rx_counter   = 0;
+    state.int_rx_counter   = 0;
+    state.decrypt_fail_count = 0;
+
+    // Install GTK (shared across all Agents)
+    m_gtk          = gtk;
+    m_gtk_key_id   = gtk_key_id;
+    m_gtk_valid    = true;
+    m_integrity_tx_counter = 1;
+
+    // Log TK for debugging (first 16 bytes only for security)
+    LOG(ERROR) << "1905Security: TK for " << tlvf::mac_to_string(agent_mac) << " = "
+               << std::hex << std::setfill('0')
+               << std::setw(2) << (int)tk[0]
+               << std::setw(2) << (int)tk[1]
+               << std::setw(2) << (int)tk[2]
+               << std::setw(2) << (int)tk[3]
+               << std::setw(2) << (int)tk[4]
+               << std::setw(2) << (int)tk[5]
+               << std::setw(2) << (int)tk[6]
+               << std::setw(2) << (int)tk[7]
+               << std::setw(2) << (int)tk[8]
+               << std::setw(2) << (int)tk[9]
+               << std::setw(2) << (int)tk[10]
+               << std::setw(2) << (int)tk[11]
+               << std::setw(2) << (int)tk[12]
+               << std::setw(2) << (int)tk[13]
+               << std::setw(2) << (int)tk[14]
+               << std::setw(2) << (int)tk[15]
+               << "..." << std::dec;
+
+    LOG(INFO) << "1905Security: keys installed for Agent " << tlvf::mac_to_string(agent_mac);
+}
+
+void Ieee1905SecurityManager::remove_agent(const sMacAddr &agent_mac)
+{
+    m_agent_states.erase(agent_mac);
+    LOG(INFO) << "1905Security: security state removed for Agent " << tlvf::mac_to_string(agent_mac);
+}
+
+// ============================================================================
+// Query methods
+// ============================================================================
+
+bool Ieee1905SecurityManager::is_security_enabled(const sMacAddr &agent_mac) const
+{
+    auto it = m_agent_states.find(agent_mac);
+    return (it != m_agent_states.end()) && it->second.security_enabled;
+}
+
+bool Ieee1905SecurityManager::has_tk(const sMacAddr &agent_mac) const
+{
+    auto it = m_agent_states.find(agent_mac);
+    return (it != m_agent_states.end()) && it->second.has_tk;
+}
