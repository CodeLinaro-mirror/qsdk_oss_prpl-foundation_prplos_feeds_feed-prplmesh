+#define _1905_SECURITY_MANAGER_H_
+
+#include <tlvf/CmduMessageRx.h>
+#include <tlvf/CmduMessageTx.h>
+#include <tlvf/common/sMacAddr.h>
+#include <tlvf/ieee_1905_1/eMessageType.h>
+
+#include <array>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <tlvf/tlvftypes.h>
+
+namespace son {
+
+/**
+ * @brief 1905-Layer Security Manager
+ *
+ * Provides transparent AES-SIV encryption/decryption and HMAC-SHA256 MIC
+ * for ALL Controller 1905 CMDUs, as specified in EasyMesh §13.
+ *
+ * This class is called from the CMDU send/receive pipeline so that all
+ * Controller tasks (Channel Selection, Client Steering, AP Metrics, etc.)
+ * benefit from 1905 security transparently — without each task needing to
+ * know about encryption.
+ *
+ * Architecture (per EasyMesh §16 design):
+ *
+ *   DppConfiguratorTask  →  generates keys, installs into Ieee1905SecurityManager
+ *   ChannelSelectionTask →  builds CMDU (plaintext)
+ *   ClientSteeringTask   →  builds CMDU (plaintext)
+ *            ↓
+ *   son_actions::send_cmdu_to_agent()
+ *            ↓
+ *   Ieee1905SecurityManager::encrypt_cmdu_if_needed()   ← encrypt if needed
+ *            ↓
+ *   Transport → Remote Agent
+ *
+ *   Remote Agent → Transport → Controller::handle_cmdu()
+ *            ↓
+ *   Ieee1905SecurityManager::verify_mic_if_needed()     ← verify MIC
+ *   Ieee1905SecurityManager::decrypt_cmdu_if_needed()   ← decrypt if needed
+ *            ↓
+ *   Route to appropriate handler task
+ *
+ * Decision rules (per EasyMesh §16.2):
+ *
+ * OUTGOING UNICAST:
+ *   IF msg_type NOT in exception list
+ *   AND dst_mac has security_enabled AND has TK
+ *   → AES-SIV encrypt all TLVs → wrap in Encrypted Payload TLV (0xAC)
+ *
+ * OUTGOING MULTICAST:
+ *   IF GTK available → add MIC TLV (0xAB)
+ *
+ * INCOMING:
+ *   IF Encrypted Payload TLV (0xAC) present:
+ *     IF msg_type is DIRECT_ENCAP_DPP or IEEE1905_ENCAP_EAPOL → process plaintext
+ *     ELSE IF has TK → AES-SIV decrypt
+ *     ELSE → DISCARD
+ *   IF no Encrypted Payload TLV:
+ *     IF src_mac security_enabled → DISCARD
+ *     ELSE → process plaintext
+ *   IF MIC TLV (0xAB) present → verify HMAC-SHA256; DISCARD if fail
+ */
+class Ieee1905SecurityManager {
+public:
+    /**
+     * @brief Constructor.
+     * @param controller_al_mac  Controller's AL MAC address (used in MIC/encryption AAD)
+     */
+    explicit Ieee1905SecurityManager(const sMacAddr &controller_al_mac);
+
+    // -------------------------------------------------------------------------
+    // Key installation (called by DppConfiguratorTask after 4-way handshake M4)
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Install per-Agent TK and shared GTK after successful 4-way handshake.
+     *
+     * Called by DppConfiguratorTask after EAPOL M4 is verified.
+     *
+     * @param agent_mac    Agent AL MAC address
+     * @param tk           256-bit 1905 TK (bytes 32-63 of PTK)
+     * @param gtk          256-bit 1905 GTK (shared across all Agents)
+     * @param gtk_key_id   GTK Key ID (1-3)
+     */
+    void install_agent_keys(const sMacAddr &agent_mac,
+                             const std::array<uint8_t, 32> &tk,
+                             const std::array<uint8_t, 32> &gtk,
+                             uint8_t gtk_key_id);
+
+    /**
+     * @brief Remove security state for an Agent (e.g., on disconnect).
+     */
+    void remove_agent(const sMacAddr &agent_mac);
+
+    // -------------------------------------------------------------------------
+    // Outgoing CMDU processing (called from send path)
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Encrypt a unicast CMDU if security is enabled for the destination.
+     *
+     * Per EasyMesh §13.3.2:
+     * - Skips exception messages (AP_AUTOCONFIG_SEARCH/RESPONSE, DIRECT_ENCAP_DPP,
+     *   IEEE1905_ENCAP_EAPOL)
+     * - If dst_mac has security enabled AND has TK: AES-SIV encrypt all TLVs,
+     *   replace with Encrypted Payload TLV (0xAC)
+     *
+     * @param dst_mac   Destination Agent AL MAC
+     * @param msg_type  Message type (for exception check)
+     * @param cmdu_tx   CMDU to encrypt in-place
+     * @return true on success (or if encryption not needed)
+     */
+    bool encrypt_cmdu_if_needed(const sMacAddr &dst_mac,
+                                 ieee1905_1::eMessageType msg_type,
+                                 uint8_t *buf,
+                                 size_t msg_len,
+                                 size_t buf_capacity,
+                                 size_t &new_len);
+
+    /**
+     * @brief Add MIC TLV to a multicast/relayed CMDU if GTK is available.
+     *
+     * Per EasyMesh §13.2.2:
+     * - Computes HMAC-SHA256(GTK, [CMDU_header_6B | MIC_TLV_first_13B | all_TLVs])
+     * - Inserts MIC TLV (0xAB) before End of Message TLV
+     *
+     * @param cmdu_tx   CMDU to add MIC to
+     * @return true on success (or if MIC not needed)
+     */
+    bool add_mic_if_needed(ieee1905_1::CmduMessageTx &cmdu_tx);
+
+    // -------------------------------------------------------------------------
+    // Incoming CMDU processing (called from receive path)
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Verify MIC TLV in an incoming CMDU if present.
+     *
+     * Per EasyMesh §13.2.3:
+     * - If MIC TLV (0xAB) present: verify HMAC-SHA256; return false if fail
+     * - If no MIC TLV and sender security-enabled: return false (discard)
+     * - If no MIC TLV and sender not security-enabled: return true (plaintext OK)
+     *
+     * @param src_mac   Source Agent AL MAC
+     * @param cmdu_rx   Received CMDU
+     * @return true if MIC is valid (or not required), false if should be discarded
+     */
+    bool verify_mic_if_needed(const sMacAddr &src_mac,
+                               ieee1905_1::CmduMessageRx &cmdu_rx,
+                               const uint8_t raw_header6[6],
+                               size_t msg_len,
+                               const std::vector<uint8_t> &raw_msg);
+
+    /**
+     * @brief Decrypt an incoming CMDU if it contains an Encrypted Payload TLV.
+     *
+     * Per EasyMesh §13.3.3:
+     * - If Encrypted Payload TLV (0xAC) present:
+     *   - Exception messages (DIRECT_ENCAP_DPP, IEEE1905_ENCAP_EAPOL): process plaintext
+     *   - If has TK: AES-SIV decrypt; replace Encrypted Payload TLV with plaintext TLVs
+     *   - If no TK: return false (discard)
+     * - If no Encrypted Payload TLV:
+     *   - If src_mac security-enabled: return false (discard — expected encryption)
+     *   - Else: return true (plaintext OK)
+     *
+     * @param src_mac   Source Agent AL MAC
+     * @param cmdu_rx   Received CMDU (modified in-place on successful decryption)
+     * @return true if decryption succeeded (or not needed), false if should be discarded
+     */
+    bool decrypt_cmdu_if_needed(const sMacAddr &src_mac,
+                                 ieee1905_1::CmduMessageRx &cmdu_rx,
+                                 const uint8_t raw_header6[6],
+                                 size_t &new_msg_len_out);
+
+    // -------------------------------------------------------------------------
+    // Decryption failure handling
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Handle a decryption failure for a specific Agent.
+     *
+     * Increments the Decryption Failure Counter. If it exceeds the threshold,
+     * logs a warning (caller should trigger rekey via 1905 Rekey Request).
+     *
+     * @param agent_mac  Agent that sent the undecryptable message
+     */
+    void handle_decryption_failure(const sMacAddr &agent_mac);
+
+    // -------------------------------------------------------------------------
+    // Query methods
+    // -------------------------------------------------------------------------
+
+    /** @brief Returns true if 1905 security is enabled for the given Agent. */
+    bool is_security_enabled(const sMacAddr &agent_mac) const;
+
+    /** @brief Returns true if a 1905 TK is installed for the given Agent. */
+    bool has_tk(const sMacAddr &agent_mac) const;
+
+    /** @brief Returns true if the 1905 GTK is available. */
+    bool has_gtk() const { return m_gtk_valid; }
+
+    /** @brief Get the current GTK Key ID. */
+    uint8_t gtk_key_id() const { return m_gtk_key_id; }
+
+    /**
+     * @brief Add MIC TLV directly to a raw CMDU buffer if GTK is available.
+     *
+     * Inserts the MIC TLV (0xAB) immediately before the End-of-Message TLV.
+     * The buffer must have at least 48 bytes of extra capacity beyond @p len.
+     * This avoids the CmduMessageTx wrapping issue where addClass() writes at
+     * offset 0 (overwriting the CMDU header) when m_class_vector is empty.
+     *
+     * @param buf    Pointer to the CMDU buffer
+     * @param len    Current length of the CMDU data in the buffer
+     * @param maxlen Maximum capacity of the buffer (must be >= len + 48)
+     * @return New length of the CMDU data after MIC addition, or 0 on failure
+     */
+    size_t add_mic_to_buffer(uint8_t *buf, size_t len, size_t maxlen);
+
+
+private:
+    // -------------------------------------------------------------------------
+    // Per-Agent security state
+    // -------------------------------------------------------------------------
+
+    struct sAgentSecurityState {
+        std::array<uint8_t, 32> tk;              // 1905 TK (256-bit)
+        uint64_t enc_tx_counter    = 1;          // Encryption TX counter (strictly increasing)
+        uint64_t enc_rx_counter    = 0;          // Encryption RX counter (strictly increasing)
+        uint64_t int_rx_counter    = 0;          // Integrity RX counter (strictly increasing)
+        uint16_t decrypt_fail_count = 0;         // Decryption failure counter
+        bool security_enabled      = false;      // true after DPP onboarding + 4-way handshake
+        bool has_tk                = false;      // true after TK is installed
+    };
+
+    std::unordered_map<sMacAddr, sAgentSecurityState> m_agent_states;
+
+    // -------------------------------------------------------------------------
+    // Shared GTK (distributed to all Agents by Controller)
+    // -------------------------------------------------------------------------
+
+    std::array<uint8_t, 32> m_gtk;
+    uint8_t m_gtk_key_id         = 1;
+    bool m_gtk_valid             = false;
+    uint64_t m_integrity_tx_counter = 1;  // Integrity TX counter for MIC
+
+    // -------------------------------------------------------------------------
+    // Controller identity
+    // -------------------------------------------------------------------------
+
+    sMacAddr m_controller_al_mac;
+
+    // -------------------------------------------------------------------------
+    // Exception message types (never encrypted per EasyMesh §13.3.2)
+    // -------------------------------------------------------------------------
+
+    static bool is_exception_message(ieee1905_1::eMessageType msg_type);
+
+    // -------------------------------------------------------------------------
+    // Internal helpers
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Collect all TLVs from a CMDU (excluding End of Message TLV).
+     * @return Serialized TLV bytes
+     */
+    static std::vector<uint8_t> collect_tlvs(const uint8_t *buf, size_t buf_len);
+    static std::vector<uint8_t> collect_tlvs(ieee1905_1::CmduMessageTx &cmdu_tx);
+
+    /**
+     * @brief Get the first 6 bytes of the CMDU header (for AAD).
+     */
+    static std::vector<uint8_t> get_cmdu_header_6bytes(ieee1905_1::CmduMessageTx &cmdu_tx);
+    static std::vector<uint8_t> get_cmdu_header_6bytes(ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Encode a 48-bit counter as 6 bytes (big-endian).
+     */
+    static std::vector<uint8_t> encode_counter(uint64_t counter);
+
+    /**
+     * @brief Decode a 6-byte big-endian counter to uint64_t.
+     */
+    static uint64_t decode_counter(const uint8_t *bytes);
+};
+
+} // namespace son
+
+#endif // _1905_SECURITY_MANAGER_H_
