+// ============================================================================
+// Outgoing: encrypt_cmdu_if_needed (unicast)
+// ============================================================================
+
+bool Ieee1905SecurityManager::encrypt_cmdu_if_needed(const sMacAddr &dst_mac,
+                                                       ieee1905_1::eMessageType msg_type,
+                                                       uint8_t *buf,
+                                                       size_t msg_len,
+                                                       size_t buf_capacity,
+                                                       size_t &new_len)
+{
+    new_len = msg_len; // default: no change
+
+    // Exception messages are never encrypted
+    if (is_exception_message(msg_type)) {
+        return true;
+    }
+
+    // Check if security is enabled and TK is available for this Agent
+    if (!is_security_enabled(dst_mac) || !has_tk(dst_mac)) {
+        return true; // send plaintext
+    }
+
+    if (!buf || msg_len < 8) {
+        LOG(ERROR) << "1905Security: invalid buffer for encryption";
+        return false;
+    }
+
+    auto &state = m_agent_states[dst_mac];
+
+    // 1. Collect all TLVs (excluding End of Message TLV) from the actual message
+    std::vector<uint8_t> plaintext = collect_tlvs(buf, msg_len);
+    LOG(ERROR) << "1905Security: encrypt msg_len=" << msg_len
+               << " msg_type=0x" << std::hex << static_cast<uint16_t>(msg_type) << std::dec
+               << " plaintext=" << plaintext.size() << "B for " << dst_mac;
+
+    // Per EasyMesh §13.3.2, TLV-less messages (e.g. AP_CAPABILITY_QUERY) still get wrapped in
+    // an Encrypted Payload TLV once the TK is available — AES-SIV over an empty plaintext is
+    // well-defined (RFC 5297), so there is no reason to send these plaintext.
+
+    // 2. Build AAD per EasyMesh §13.3.2:
+    //    AD1 = first 6 octets of 1905 CMDU (as-is, per spec)
+    //    AD2 = Encryption TX Counter (6 bytes, from Encrypted Payload TLV)
+    //    AD3 = Source 1905 AL MAC Address
+    //    AD4 = Destination 1905 AL MAC Address
+    std::vector<uint8_t> ad1(buf, buf + 6);
+    std::vector<uint8_t> ad2 = encode_counter(state.enc_tx_counter);
+    std::vector<uint8_t> ad3(m_controller_al_mac.oct,
+                              m_controller_al_mac.oct + sizeof(m_controller_al_mac.oct));
+    std::vector<uint8_t> ad4(dst_mac.oct, dst_mac.oct + sizeof(dst_mac.oct));
+
+    // 3. AES-SIV encrypt
+    std::vector<uint8_t> ciphertext = DppCryptoHelper::aes_siv_encrypt(
+        state.tk.data(), 32, plaintext, {ad1, ad2, ad3, ad4});
+
+    if (ciphertext.empty()) {
+        LOG(ERROR) << "1905Security: AES-SIV encrypt failed for " << dst_mac;
+        return false;
+    }
+
+    // 4. Build new CMDU: header(8) + EncPayload TLV(3+6+6+6+2+ciphertext) + EOM(3)
+    // TLV value = counter(6) + srcMAC(6) + dstMAC(6) + aes_siv_length(2) + aes_siv(N)
+    uint16_t aes_siv_len = static_cast<uint16_t>(ciphertext.size());
+    size_t enc_tlv_value_size = 6 + 6 + 6 + 2 + ciphertext.size();
+    size_t total_size         = 8 + 3 + enc_tlv_value_size + 3;
+
+    if (total_size > buf_capacity) {
+        LOG(ERROR) << "1905Security: encrypted CMDU too large for buffer ("
+                   << total_size << " > " << buf_capacity << ")";
+        return false;
+    }
+
+    // Work from a local copy so the original AD1 bytes aren't clobbered
+    std::vector<uint8_t> new_cmdu(total_size);
+    memcpy(new_cmdu.data(), buf, 8); // copy CMDU header
+
+    size_t offset = 8;
+    new_cmdu[offset++] = 0xAC;
+    new_cmdu[offset++] = (enc_tlv_value_size >> 8) & 0xFF;
+    new_cmdu[offset++] = enc_tlv_value_size & 0xFF;
+
+    memcpy(new_cmdu.data() + offset, ad2.data(), 6); offset += 6; // TX counter
+    memcpy(new_cmdu.data() + offset, m_controller_al_mac.oct, 6); offset += 6; // src
+    memcpy(new_cmdu.data() + offset, dst_mac.oct, 6);             offset += 6; // dst
+    // aes_siv_length (2 bytes, big-endian)
+    new_cmdu[offset++] = (aes_siv_len >> 8) & 0xFF;
+    new_cmdu[offset++] = aes_siv_len & 0xFF;
+    memcpy(new_cmdu.data() + offset, ciphertext.data(), ciphertext.size());
+    offset += ciphertext.size();
+
+    // End of Message TLV
+    new_cmdu[offset++] = 0x00;
+    new_cmdu[offset++] = 0x00;
+    new_cmdu[offset++] = 0x00;
+
+    memcpy(buf, new_cmdu.data(), total_size);
+    new_len = total_size;
+
+    // 5. Increment TX counter
+    state.enc_tx_counter++;
+
+    LOG(ERROR) << "1905Security: encrypted CMDU for " << tlvf::mac_to_string(dst_mac)
+               << " counter=" << (state.enc_tx_counter - 1)
+               << " plaintext=" << plaintext.size() << "B ciphertext=" << total_size << "B";
+    return true;
+}
+
+// ============================================================================
+// Outgoing: add_mic_if_needed (multicast/relayed)
+// ============================================================================
+
+bool Ieee1905SecurityManager::add_mic_if_needed(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    if (!m_gtk_valid) {
+        return true; // no GTK yet, send without MIC
+    }
+
+    // 1. Add MIC TLV (before End of Message TLV)
+    auto mic_tlv = cmdu_tx.addClass<wfa_map::tlvMic>();
+    if (!mic_tlv) {
+        LOG(ERROR) << "1905Security: failed to add tlvMic";
+        return false;
+    }
+
+    // Set MIC TLV fields
+    mic_tlv->flags().ieee1905_gtk_key_id = m_gtk_key_id & 0x03;
+    mic_tlv->flags().mic_version         = 0; // Version 1
+    {
+        auto counter_bytes = encode_counter(m_integrity_tx_counter);
+        mic_tlv->set_integrity_transmission_counter(counter_bytes.data(), counter_bytes.size());
+    }
+    mic_tlv->source_1905_al_mac_address() = m_controller_al_mac;
+
+    // 2. Compute HMAC-SHA256:
+    //    message_array = [first 6 octets of CMDU] +
+    //                    [first 13 octets of MIC TLV value] +
+    //                    [all TLVs except MIC TLV]
+    std::vector<uint8_t> cmdu_header = get_cmdu_header_6bytes(cmdu_tx);
+    std::vector<uint8_t> all_tlvs    = collect_tlvs(cmdu_tx);
+
+    // Build MIC TLV first 13 bytes: flags(1) + Integrity_TX_Counter(6) + Source_AL_MAC(6)
+    // Per spec: first 13 octets of MIC TLV Value
+    std::vector<uint8_t> mic_tlv_prefix(13, 0);
+    mic_tlv_prefix[0] = static_cast<uint8_t>((m_gtk_key_id & 0x03) << 6); // bits 7-6
+    // bits 5-4 = MIC version 0x00, bits 3-0 = reserved
+    {
+        auto counter_bytes = encode_counter(m_integrity_tx_counter);
+        memcpy(mic_tlv_prefix.data() + 1, counter_bytes.data(), 6);
+    }
+    memcpy(mic_tlv_prefix.data() + 7, m_controller_al_mac.oct, 6);
+
+    // Concatenate: CMDU_header + MIC_TLV_prefix + all_TLVs
+    std::vector<uint8_t> message_array;
+    message_array.insert(message_array.end(), cmdu_header.begin(), cmdu_header.end());
+    message_array.insert(message_array.end(), mic_tlv_prefix.begin(), mic_tlv_prefix.end());
+    message_array.insert(message_array.end(), all_tlvs.begin(), all_tlvs.end());
+
+    // 3. Compute HMAC-SHA256(GTK, message_array)
+    uint8_t mic_value[32];
+    if (!DppCryptoHelper::hmac_sha256(m_gtk.data(), 32,
+                                       message_array.data(), message_array.size(),
+                                       mic_value)) {
+        LOG(ERROR) << "1905Security: HMAC-SHA256 for MIC failed";
+        return false;
+    }
+
+    // 4. Set MIC value in TLV
+    if (!mic_tlv->alloc_mic(32)) {
+        LOG(ERROR) << "1905Security: failed to allocate MIC buffer";
+        return false;
+    }
+    memcpy(mic_tlv->mic(), mic_value, 32);
+
+    // 5. Increment integrity TX counter
+    m_integrity_tx_counter++;
+
+    LOG(DEBUG) << "1905Security: MIC added to multicast CMDU";
+    return true;
+}
+
+// ============================================================================
+// Incoming: verify_mic_if_needed
+// ============================================================================
+
+bool Ieee1905SecurityManager::verify_mic_if_needed(const sMacAddr &src_mac,
+                                                     ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                     const uint8_t raw_header6[6],
+                                                     size_t msg_len,
+                                                     const std::vector<uint8_t> &raw_msg)
+{
+    auto mic_tlv  = cmdu_rx.getClass<wfa_map::tlvMic>();
+    auto msg_type = cmdu_rx.getMessageType();
+
+    // Exception messages never carry MIC — pass through regardless of security state.
+    // This allows AP_AUTOCONFIGURATION_SEARCH (and other exception types) from a
+    // rebooted agent to reach the controller and trigger re-onboarding even when the
+    // old security state is still installed.
+    if (is_exception_message(msg_type)) {
+        return true;
+    }
+
+    if (!mic_tlv) {
+        // No MIC TLV present
+        if (is_security_enabled(src_mac)) {
+            // Expected MIC but not present — discard
+            LOG(WARNING) << "1905Security: expected MIC TLV from security-enabled Agent "
+                         << src_mac << " but not found — discarding";
+            return false;
+        }
+        // Plaintext OK (security not enabled for this Agent)
+        return true;
+    }
+
+    // MIC TLV present — verify it
+    if (!m_gtk_valid) {
+        LOG(WARNING) << "1905Security: MIC TLV present but no GTK available — discarding";
+        return false;
+    }
+
+    // Check integrity RX counter (must be strictly increasing)
+    auto it = m_agent_states.find(src_mac);
+    if (it != m_agent_states.end()) {
+        uint64_t rx_counter = decode_counter(mic_tlv->integrity_transmission_counter());
+        if (rx_counter <= it->second.int_rx_counter) {
+            LOG(WARNING) << "1905Security: MIC replay detected from "
+                         << tlvf::mac_to_string(src_mac)
+                         << " rx_counter=" << rx_counter
+                         << " last=" << it->second.int_rx_counter;
+            return false;
+        }
+    }
+
+    // Recompute HMAC-SHA256 and compare
+    // Use raw (wire) header bytes — parse() byte-swaps multi-byte fields in-place
+    std::vector<uint8_t> cmdu_header(raw_header6, raw_header6 + 6);
+
+    // Build MIC TLV prefix (13 bytes) from received TLV
+    std::vector<uint8_t> mic_tlv_prefix(13, 0);
+    mic_tlv_prefix[0] = static_cast<uint8_t>((mic_tlv->flags().ieee1905_gtk_key_id & 0x03) << 6);
+    // Copy the raw 6-byte counter directly from the TLV
+    memcpy(mic_tlv_prefix.data() + 1, mic_tlv->integrity_transmission_counter(), 6);
+    const auto &src_al_mac = mic_tlv->source_1905_al_mac_address();
+    memcpy(mic_tlv_prefix.data() + 7, src_al_mac.oct, 6);
+
+    // Get all TLVs from raw message bytes (pre-parse, no byte-swap corruption), excluding MIC TLV
+    // Use raw_msg (saved before parse()) so TLV lengths are in wire (big-endian) format
+    const uint8_t *buf = raw_msg.data();
+    size_t raw_len     = raw_msg.size();
+
+    // Find actual message end by scanning raw TLVs
+    size_t msg_end = raw_len;
+    if (raw_len > 8) {
+        size_t off = 8;
+        while (off + 3 <= raw_len) {
+            uint8_t  t = buf[off];
+            uint16_t l = (static_cast<uint16_t>(buf[off+1]) << 8) | buf[off+2];
+            off += 3 + l;
+            if (t == 0 && l == 0) { msg_end = off; break; }
+        }
+    }
+
+    // Build all_tlvs: walk raw bytes, exclude MIC TLV (0xAB)
+    std::vector<uint8_t> all_tlvs;
+    if (msg_end > 8) {
+        const uint8_t *tlv_ptr = buf + 8;
+        const uint8_t *end_ptr = buf + msg_end;
+        while (tlv_ptr + 3 <= end_ptr) {
+            uint8_t  t = tlv_ptr[0];
+            uint16_t l = (static_cast<uint16_t>(tlv_ptr[1]) << 8) | tlv_ptr[2];
+            size_t tlv_total = 3 + l;
+            if (t != 0xAB) {
+                all_tlvs.insert(all_tlvs.end(), tlv_ptr, tlv_ptr + tlv_total);
+            }
+            tlv_ptr += tlv_total;
+            if (t == 0 && l == 0) break;
+        }
+    }
+
+    std::vector<uint8_t> message_array;
+    message_array.insert(message_array.end(), cmdu_header.begin(), cmdu_header.end());
+    message_array.insert(message_array.end(), mic_tlv_prefix.begin(), mic_tlv_prefix.end());
+    message_array.insert(message_array.end(), all_tlvs.begin(), all_tlvs.end());
+
+    LOG(ERROR) << "1905Security: MIC dbg"
+               << " hdr=" << std::hex << std::setfill('0')
+               << std::setw(2)<<(int)cmdu_header[0]<<std::setw(2)<<(int)cmdu_header[1]
+               << std::setw(2)<<(int)cmdu_header[2]<<std::setw(2)<<(int)cmdu_header[3]
+               << std::setw(2)<<(int)cmdu_header[4]<<std::setw(2)<<(int)cmdu_header[5]
+               << " pfx[0:2]=" << std::setw(2)<<(int)mic_tlv_prefix[0]
+               << std::setw(2)<<(int)mic_tlv_prefix[1]<<std::setw(2)<<(int)mic_tlv_prefix[2]
+               << " tlvs[0:5]=" << std::setw(2)<<(int)all_tlvs[0]<<std::setw(2)<<(int)all_tlvs[1]
+               << std::setw(2)<<(int)all_tlvs[2]<<std::setw(2)<<(int)all_tlvs[3]
+               << std::setw(2)<<(int)all_tlvs[4]<<std::setw(2)<<(int)all_tlvs[5]
+               << " tlv_sz=" << std::dec << all_tlvs.size()
+               << " raw_len=" << raw_len << " msg_end=" << msg_end;
+
+    uint8_t computed_mic[32];
+    if (!DppCryptoHelper::hmac_sha256(m_gtk.data(), 32,
+                                       message_array.data(), message_array.size(),
+                                       computed_mic)) {
+        LOG(ERROR) << "1905Security: HMAC-SHA256 computation failed for MIC verification";
+        return false;
+    }
+
+    // Compare computed MIC with received MIC
+    if (mic_tlv->mic_length() < 32 ||
+        memcmp(computed_mic, mic_tlv->mic(), 32) != 0) {
+        LOG(ERROR) << "1905Security: MIC verification FAILED from " << src_mac
+                   << " msg_array_len=" << message_array.size()
+                   << " all_tlvs_len=" << all_tlvs.size()
+                   << " GTK[0-3]=" << std::hex << std::setfill('0')
+                   << std::setw(2) << (int)m_gtk[0] << std::setw(2) << (int)m_gtk[1]
+                   << std::setw(2) << (int)m_gtk[2] << std::setw(2) << (int)m_gtk[3]
+                   << " received_mic[0-3]=" << std::setw(2) << (int)mic_tlv->mic()[0]
+                   << std::setw(2) << (int)mic_tlv->mic()[1]
+                   << std::setw(2) << (int)mic_tlv->mic()[2]
+                   << std::setw(2) << (int)mic_tlv->mic()[3]
+                   << " computed_mic[0-3]=" << std::setw(2) << (int)computed_mic[0]
+                   << std::setw(2) << (int)computed_mic[1]
+                   << std::setw(2) << (int)computed_mic[2]
+                   << std::setw(2) << (int)computed_mic[3]
+                   << std::dec;
+        return false;
+    }
+
+    // Update integrity RX counter
+    if (it != m_agent_states.end()) {
+        it->second.int_rx_counter = decode_counter(mic_tlv->integrity_transmission_counter());
+    }
+
+    LOG(DEBUG) << "1905Security: MIC verified OK from " << tlvf::mac_to_string(src_mac);
+    return true;
+}
+
+// ============================================================================
+// Incoming: decrypt_cmdu_if_needed
+// ============================================================================
+
+bool Ieee1905SecurityManager::decrypt_cmdu_if_needed(const sMacAddr &src_mac,
+                                                       ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                       const uint8_t raw_header6[6],
+                                                       size_t &new_msg_len_out)
+{
+    // Read message type from the raw wire bytes (big-endian, bytes 2-3 of 1905 header).
+    // cmdu_rx.getMessageType() returns a byte-swapped value on little-endian after parse().
+    auto msg_type = static_cast<ieee1905_1::eMessageType>(
+        (static_cast<uint16_t>(raw_header6[2]) << 8) | raw_header6[3]);
+    auto enc_tlv  = cmdu_rx.getClass<wfa_map::tlvEncryptedPayload>();
+
+    if (enc_tlv) {
+        // Encrypted Payload TLV IS present — decrypt it
+
+        // Check if we have a TK for this Agent
+        if (!has_tk(src_mac)) {
+            LOG(WARNING) << "1905Security: Encrypted Payload TLV present but no TK for "
+                         << src_mac << " — discarding";
+            return false;
+        }
+
+        auto &state = m_agent_states[src_mac];
+
+        // Check encryption RX counter (must be strictly increasing)
+        uint64_t rx_counter = decode_counter(enc_tlv->encryption_transmission_counter());
+        if (rx_counter <= state.enc_rx_counter) {
+            LOG(WARNING) << "1905Security: encryption replay detected from "
+                         << tlvf::mac_to_string(src_mac)
+                         << " rx_counter=" << rx_counter
+                         << " last=" << state.enc_rx_counter;
+            return false;
+        }
+
+        // Verify destination AL MAC matches us
+        const auto &dst_mac = enc_tlv->destination_1905_al_mac_address();
+        if (memcmp(dst_mac.oct, m_controller_al_mac.oct, 6) != 0) {
+            LOG(WARNING) << "1905Security: Encrypted Payload TLV destination mismatch — discarding";
+            return false;
+        }
+
+        // Build AAD per EasyMesh §13.3.3:
+        // AD1 = first 6 octets of the received 1905 CMDU (raw wire bytes, not post-parse)
+        std::vector<uint8_t> ad1(raw_header6, raw_header6 + 6);
+        std::vector<uint8_t> ad2 = encode_counter(rx_counter);
+
+        const auto &src_al_mac = enc_tlv->source_1905_al_mac_address();
+        std::vector<uint8_t> ad3(src_al_mac.oct, src_al_mac.oct + 6);
+        std::vector<uint8_t> ad4(dst_mac.oct, dst_mac.oct + 6);
+
+        LOG(ERROR) << "1905Security: Decrypting from " << tlvf::mac_to_string(src_mac)
+                   << " rx_counter=" << rx_counter
+                   << " AD1=" << std::hex << std::setfill('0')
+                   << std::setw(2) << (int)ad1[0] << std::setw(2) << (int)ad1[1]
+                   << std::setw(2) << (int)ad1[2] << std::setw(2) << (int)ad1[3]
+                   << std::setw(2) << (int)ad1[4] << std::setw(2) << (int)ad1[5]
+                   << std::dec;
+
+        // Get ciphertext from TLV
+        size_t ct_len = enc_tlv->aes_siv_length();
+        if (ct_len < 16) {
+            LOG(ERROR) << "1905Security: ciphertext too short from " << src_mac;
+            return false;
+        }
+        std::vector<uint8_t> ciphertext(enc_tlv->aes_siv(), enc_tlv->aes_siv() + ct_len);
+
+        // AES-SIV decrypt
+        std::vector<uint8_t> plaintext;
+        bool decrypt_ok = DppCryptoHelper::aes_siv_decrypt(
+            state.tk.data(), 32, ciphertext, {ad1, ad2, ad3, ad4}, plaintext);
+
+        if (!decrypt_ok) {
+            LOG(WARNING) << "1905Security: AES-SIV decrypt FAILED from " << src_mac;
+            handle_decryption_failure(src_mac);
+            return false;
+        }
+
+        // Inject plaintext TLVs back into the raw buffer:
+        // Replace the entire payload with: CMDU_header(8) + plaintext_TLVs + EOM(3)
+        uint8_t *raw = cmdu_rx.getMessageBuff();
+        size_t   raw_capacity = cmdu_rx.getMessageBuffLength();
+        size_t   new_msg_len  = 8 + plaintext.size() + 3; // header + TLVs + EOM
+
+        if (new_msg_len > raw_capacity) {
+            LOG(ERROR) << "1905Security: decrypted CMDU too large for buffer ("
+                       << new_msg_len << " > " << raw_capacity << ")";
+            return false;
+        }
+
+        // Header stays in place (first 8 bytes unchanged), overwrite TLV region
+        memcpy(raw + 8, plaintext.data(), plaintext.size());
+        // EOM TLV
+        raw[8 + plaintext.size() + 0] = 0x00;
+        raw[8 + plaintext.size() + 1] = 0x00;
+        raw[8 + plaintext.size() + 2] = 0x00;
+
+        // Return the new length — caller sets msg.metadata()->length.
+        // Do NOT call cmdu_rx.parse() here: the broker will re-parse with the updated length.
+        new_msg_len_out = new_msg_len;
+
+        // Update RX counter
+        state.enc_rx_counter = rx_counter;
+
+        LOG(ERROR) << "1905Security: decrypted CMDU from " << tlvf::mac_to_string(src_mac)
+                   << " counter=" << rx_counter
+                   << " plaintext=" << plaintext.size() << "B new_len=" << new_msg_len;
+        return true;
+
+    } else {
+        // No Encrypted Payload TLV
+
+        // Exception messages (AP_AUTOCONF_SEARCH/RESPONSE, DIRECT_ENCAP_DPP, ENCAP_EAPOL)
+        // are never encrypted and must always pass through regardless of security state.
+        if (is_exception_message(msg_type)) {
+            return true;
+        }
+
+        if (is_security_enabled(src_mac)) {
+            // Expected encryption but not present — discard
+            LOG(WARNING) << "1905Security: expected Encrypted Payload TLV from "
+                         << tlvf::mac_to_string(src_mac) << " but not found — discarding";
+            return false;
+        }
+
+        // Plaintext OK (security not enabled for this Agent)
+        return true;
+    }
+}
+
+// ============================================================================
+// Decryption failure handling
+// ============================================================================
+
+void Ieee1905SecurityManager::handle_decryption_failure(const sMacAddr &agent_mac)
+{
+    auto it = m_agent_states.find(agent_mac);
+    if (it == m_agent_states.end()) return;
+
+    it->second.decrypt_fail_count++;
+
+    // Per EasyMesh §13.3.3: if counter exceeds dfCounterThreshold, trigger rekey
+    // The threshold is configured per-Agent via DPP Configuration Object
+    // Default threshold = 5 (from design §7.3.2)
+    static constexpr uint16_t DEFAULT_DECRYPT_FAIL_THRESHOLD = 5;
+
+    if (it->second.decrypt_fail_count >= DEFAULT_DECRYPT_FAIL_THRESHOLD) {
+        LOG(WARNING) << "1905Security: Decryption Failure Counter exceeded threshold for "
+                     << tlvf::mac_to_string(agent_mac)
+                     << " (count=" << it->second.decrypt_fail_count << ")"
+                     << " — caller should send 1905 Decryption Failure message and trigger rekey";
+        // Reset counter to avoid repeated warnings
+        it->second.decrypt_fail_count = 0;
+    } else {
+        LOG(DEBUG) << "1905Security: decryption failure #" << it->second.decrypt_fail_count
+                   << " from " << tlvf::mac_to_string(agent_mac);
+    }
+}
+
+// ============================================================================
+// decode_counter — 6-byte big-endian to uint64_t
+// ============================================================================
+
+uint64_t Ieee1905SecurityManager::decode_counter(const uint8_t *bytes)
+{
+    if (!bytes) return 0;
+    // Decode big-endian (network byte order per IEEE 1905.1 spec)
+    return (static_cast<uint64_t>(bytes[0]) << 40) |
+           (static_cast<uint64_t>(bytes[1]) << 32) |
+           (static_cast<uint64_t>(bytes[2]) << 24) |
+           (static_cast<uint64_t>(bytes[3]) << 16) |
+           (static_cast<uint64_t>(bytes[4]) << 8)  |
+            static_cast<uint64_t>(bytes[5]);
+}
+
+// ============================================================================
+// add_mic_to_buffer — directly insert MIC TLV into raw CMDU buffer
+// ============================================================================
+
+size_t Ieee1905SecurityManager::add_mic_to_buffer(uint8_t *buf, size_t len, size_t maxlen)
+{
+    LOG(ERROR) << "1905Security: add_mic_to_buffer called len=" << len
+               << " gtk_valid=" << m_gtk_valid;
+    if (!m_gtk_valid) {
+        return len; // no GTK yet, send without MIC
+    }
+
+    if (!buf || len < 8) return 0;
+
+    // MIC TLV layout: type(1) + length(2) + flags(1) + counter(6) + mac(6) + mic_length(2) + mic(32) = 50 bytes
+    static constexpr size_t   MIC_TLV_SIZE      = 50;
+    static constexpr uint8_t  MIC_TLV_TYPE      = 0xAB;
+    static constexpr uint16_t MIC_TLV_VALUE_LEN = 47; // 1 + 6 + 6 + 2 + 32
+
+    if (len + MIC_TLV_SIZE > maxlen) {
+        LOG(ERROR) << "1905Security: not enough space in buffer for MIC TLV";
+        return 0;
+    }
+
+    // Find the End-of-Message TLV (type=0, length=0).
+    // TLVs start after the 8-byte CMDU header.
+    const uint8_t *tlv_start = buf + 8;
+    size_t tlv_len   = len - 8;
+    size_t eom_offset = tlv_len; // position of EOM relative to tlv_start
+
+    size_t offset = 0;
+    while (offset + 3 <= tlv_len) {
+        uint8_t  tlv_type   = tlv_start[offset];
+        // TLV length is big-endian (network byte order per IEEE 1905.1)
+        uint16_t tlv_length = (static_cast<uint16_t>(tlv_start[offset + 1]) << 8) |
+                               static_cast<uint16_t>(tlv_start[offset + 2]);
+        if (tlv_type == 0 && tlv_length == 0) {
+            eom_offset = offset;
+            break;
+        }
+        offset += 3 + tlv_length;
+    }
+
+    // Build the first 13 bytes of the MIC TLV value for the HMAC input:
+    // flags(1) + Integrity_TX_Counter(6) + Source_AL_MAC(6)
+    std::vector<uint8_t> mic_tlv_prefix(13, 0);
+    mic_tlv_prefix[0] = static_cast<uint8_t>((m_gtk_key_id & 0x03) << 6);
+    {
+        auto counter_bytes = encode_counter(m_integrity_tx_counter);
+        memcpy(mic_tlv_prefix.data() + 1, counter_bytes.data(), 6);
+    }
+    memcpy(mic_tlv_prefix.data() + 7, m_controller_al_mac.oct, 6);
+
+    // Per spec §13.2.2: message_array = [first 6 octets of CMDU] +
+    //                                   [first 13 octets of MIC TLV value] +
+    //                                   [all TLVs including EOM, but NOT the MIC TLV]
+    std::vector<uint8_t> message_array;
+    message_array.reserve(6 + 13 + eom_offset + 3);
+    message_array.insert(message_array.end(), buf, buf + 6);
+    message_array.insert(message_array.end(), mic_tlv_prefix.begin(), mic_tlv_prefix.end());
+    message_array.insert(message_array.end(), tlv_start, tlv_start + eom_offset + 3);
+
+    // Compute HMAC-SHA256(GTK, message_array)
+    uint8_t mic_value[32];
+    if (!DppCryptoHelper::hmac_sha256(m_gtk.data(), 32,
+                                       message_array.data(), message_array.size(),
+                                       mic_value)) {
+        LOG(ERROR) << "1905Security: HMAC-SHA256 for MIC failed";
+        return 0;
+    }
+
+    // Insert the MIC TLV before the End-of-Message TLV.
+    // Move the EOM TLV (3 bytes) forward to make room.
+    uint8_t *eom_pos = buf + 8 + eom_offset;
+    memmove(eom_pos + MIC_TLV_SIZE, eom_pos, 3);
+
+    // Write the MIC TLV
+    uint8_t *mic_pos = eom_pos;
+    mic_pos[0] = MIC_TLV_TYPE;
+    mic_pos[1] = (MIC_TLV_VALUE_LEN >> 8) & 0xFF;
+    mic_pos[2] = MIC_TLV_VALUE_LEN & 0xFF;
+    mic_pos[3] = static_cast<uint8_t>((m_gtk_key_id & 0x03) << 6); // Flags
+    {
+        auto counter_bytes = encode_counter(m_integrity_tx_counter);
+        memcpy(mic_pos + 4, counter_bytes.data(), 6); // Integrity TX Counter
+    }
+    memcpy(mic_pos + 10, m_controller_al_mac.oct, 6); // Source 1905 AL MAC Address
+    // mic_length (2 bytes, BE) = 32
+    mic_pos[16] = 0x00;
+    mic_pos[17] = 0x20;
+    memcpy(mic_pos + 18, mic_value, 32);               // MIC
+
+    m_integrity_tx_counter++;
+
+    LOG(DEBUG) << "1905Security: MIC TLV (0xAB) inserted into multicast CMDU buffer";
+    return len + MIC_TLV_SIZE;
+}
