From 488d5a3e6e4096105e89f8e114d75b3260f3a9cd Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Tue, 6 Jan 2026 10:41:47 +0530
Subject: [PATCH] removed reassociate trigger in STA hal to avoid sta
 reconnection

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bwl/nl80211/base_wlan_hal_nl80211.cpp     |  2 +-
 .../bwl/nl80211/sta_wlan_hal_nl80211.cpp      | 29 ++++++++++++++++++-
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
index d1cd8eb79..d6a9e26fd 100644
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -549,7 +549,7 @@ bool base_wlan_hal_nl80211::ping()
     return true;
 }
 
-bool base_wlan_hal_nl80211::reassociate() { return wpa_ctrl_send_msg("REASSOCIATE"); }
+bool base_wlan_hal_nl80211::reassociate() { return true;}
 
 bool base_wlan_hal_nl80211::wpa_ctrl_send_msg(const std::string &cmd, const std::string &ifname)
 {
diff --git a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
index 9065d9ac2..bb3014a74 100644
--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
@@ -391,7 +391,34 @@ bool sta_wlan_hal_nl80211::update_status()
     return true;
 }
 
-bool sta_wlan_hal_nl80211::reassociate() { return wpa_ctrl_send_msg("REASSOCIATE"); }
+bool sta_wlan_hal_nl80211::reassociate()
+{
+    ConnectionStatus connection_status;
+
+    if (read_status(connection_status)) {
+        if (connection_status.bssid == beerocks::net::network_utils::ZERO_MAC_STRING) {
+            LOG(ERROR) << "Got zero BSSID after read status";
+            return false;
+        }
+        update_status(connection_status);
+        if (is_connected(connection_status.wpa_state)) {
+            LOG(TRACE) << "reassociate: - backhaul STA already connected";
+
+            auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_BACKHAUL_CONNECTED_NOTIFICATION *>(msg_buff.get());
+
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+
+            memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
+
+            event_queue_push(Event::Connected, msg_buff);
+
+            return true;
+        }
+    }
+
+    return false;
+}
 
 int sta_wlan_hal_nl80211::add_network()
 {
-- 
