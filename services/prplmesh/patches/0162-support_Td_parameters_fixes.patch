From a190a957d8ceb60b1cb6419fc5cfc1b5a450bd07 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Thu, 21 May 2026 19:14:11 +0530
Subject: [PATCH] Td summary fixes 05/21

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 .../tasks/link_metrics_collection_task.cpp    | 35 ++++++++++++++-
 controller/src/beerocks/master/db/db.cpp      | 17 ++++++-
 .../beerocks/master/tasks/topology_task.cpp   | 44 +++++++++++++++++++
 3 files changed, 93 insertions(+), 3 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
index 309daab8f..c6e9a00f5 100644
--- a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
@@ -1395,13 +1395,46 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
             sta_traffic_response_tlv->rx_packets_error()     = stat.rx_packets_error;
             sta_traffic_response_tlv->retransmission_count() = stat.retransmission_count;
 
-            // adding, currently only with sta-mac set, an associated sta EXTENDED link metrics tlv
+            // Build tlvAssociatedStaExtendedLinkMetrics with one sMetrics entry.
+            // Populate LastDataDownlinkRate / LastDataUplinkRate from the corresponding
+            // AssocStaLinkMetrics entry (PHY rate used as proxy — same source as
+            // EstMACDataRateDownlink/Uplink).  UtilizationReceive/Transmit are not
+            // available from the current HAL stats path; set to 0 to avoid sending
+            // uninitialized (junk) values in the TLV.
             auto extended = m_cmdu_tx.addClass<wfa_map::tlvAssociatedStaExtendedLinkMetrics>();
             if (!extended) {
                 LOG(ERROR) << "adding wfa_map::tlvAssociatedStaExtendedLinkMetrics failed";
                 continue;
             }
             extended->associated_sta() = stat.sta_mac;
+
+            // Find the matching link metric entry for this STA to get BSSID and rates.
+            auto lm_it = std::find_if(response.sta_link_metrics.begin(),
+                                      response.sta_link_metrics.end(),
+                                      [&stat](const sStaLinkMetrics &lm) {
+                                          return lm.sta_mac == stat.sta_mac;
+                                      });
+
+            if (!extended->alloc_metrics_list(1)) {
+                LOG(ERROR) << "alloc_metrics_list failed for ExtendedLinkMetrics sta="
+                           << stat.sta_mac;
+                continue;
+            }
+            auto &ext_metrics = std::get<1>(extended->metrics_list(0));
+            if (lm_it != response.sta_link_metrics.end()) {
+                ext_metrics.bssid = lm_it->bssid_info.bssid;
+                ext_metrics.last_data_down_link_rate =
+                    lm_it->bssid_info.downlink_estimated_mac_data_rate_mbps;
+                ext_metrics.last_data_up_link_rate =
+                    lm_it->bssid_info.uplink_estimated_mac_data_rate_mbps;
+            } else {
+                ext_metrics.bssid = {};
+                ext_metrics.last_data_down_link_rate = 0;
+                ext_metrics.last_data_up_link_rate   = 0;
+            }
+            // UtilizationReceive/Transmit not available from current HAL stats path.
+            ext_metrics.utilization_receive  = 0;
+            ext_metrics.utilization_transmit = 0;
         }
 
         for (auto &link_metric : response.sta_link_metrics) {
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 474cef1d1..ec558aa2e 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -8627,8 +8627,20 @@ bool db::dm_set_device_multi_ap_backhaul(const Agent &agent)
                                          agent.backhaul.parent_interface);
 
     auto parent_agent = agent.backhaul.parent_agent.lock();
+    if (!parent_agent &&
+        agent.backhaul.parent_interface != beerocks::net::network_utils::ZERO_MAC) {
+        /* Lazy resolution: parent_agent was null when topology response was processed
+         * (race condition: parent BSS not yet in DB when Agent 2's TOPOLOGY_RESPONSE
+         * arrived). Try to resolve now via parent_interface (upstream BSS MAC). */
+        parent_agent = get_agent_by_bssid(agent.backhaul.parent_interface);
+        if (parent_agent) {
+            LOG(INFO) << "dm_set_device_multi_ap_backhaul: lazily resolved parent_agent "
+                      << parent_agent->al_mac << " for agent " << agent.al_mac
+                      << " via parent_interface " << agent.backhaul.parent_interface;
+            const_cast<Agent &>(agent).backhaul.parent_agent = parent_agent;
+        }
+    }
     if (!parent_agent) {
-
         //TODO: Error log could be added after (PPM-2043), otherwise it floods logs
         m_ambiorix_datamodel->set(multiap_backhaul_path, "BackhaulDeviceID", std::string{});
         return false;
@@ -8714,7 +8726,8 @@ bool db::dm_set_profile3_device_info(const Agent &agent)
     ret_val &=
         m_ambiorix_datamodel->set(agent.dm_path, "ExecutionEnv", agent.device_info.execution_env);
     ret_val &=
-        m_ambiorix_datamodel->set(agent.dm_path, "CountryCode", agent.device_info.country_code);
+        m_ambiorix_datamodel->set(agent.dm_path, "CountryCode",
+                                  agent.device_info.country_code);
 
     for (const auto &radio : agent.radios) {
         if (radio.second->dm_path.empty()) {
diff --git a/controller/src/beerocks/master/tasks/topology_task.cpp b/controller/src/beerocks/master/tasks/topology_task.cpp
index e332519aa..56a1f4294 100644
--- a/controller/src/beerocks/master/tasks/topology_task.cpp
+++ b/controller/src/beerocks/master/tasks/topology_task.cpp
@@ -1018,6 +1018,50 @@ bool topology_task::handle_topology_notification(const sMacAddr &src_mac,
         LOG(INFO) << "client connected, al_mac=" << src_mac << " mac=" << client_mac_str
                   << ", bssid=" << bssid_str;
 
+        // If this STA is connecting to a backhaul BSS, it may be a backhaul STA (bSTA) of a
+        // child agent.  When the child agent's TOPOLOGY_RESPONSE was processed earlier, the bSTA
+        // was not yet in the database (timing: TOPOLOGY_RESPONSE arrives before TOPOLOGY_
+        // NOTIFICATION with JOIN), so parent_agent was left null and BackhaulDeviceID was set
+        // to "" in the DM.  Now that the bSTA has joined, re-resolve the parent and update the
+        // backhaul DM so that BackhaulDeviceID is correctly populated.
+        {
+            auto bss_ptr = database.get_bss(bssid);
+            if (bss_ptr && bss_ptr->backhaul) {
+                // Find the child agent whose backhaul_interface matches this bSTA MAC
+                // and whose parent_agent is not yet resolved.
+                for (auto &agent_pair : database.m_agents) {
+                    auto &child_agent_ptr = agent_pair.second;
+                    if (!child_agent_ptr || child_agent_ptr->is_gateway) {
+                        continue;
+                    }
+                    if (child_agent_ptr->backhaul.backhaul_interface == client_mac &&
+                        child_agent_ptr->backhaul.parent_agent.expired()) {
+                        auto parent_agent_ptr = database.get_agent_by_bssid(bssid);
+                        if (parent_agent_ptr) {
+                            child_agent_ptr->backhaul.parent_agent =
+                                parent_agent_ptr;
+                            child_agent_ptr->backhaul.backhaul_iface_type =
+                                beerocks::IFACE_TYPE_WIFI_UNSPECIFIED;
+                            child_agent_ptr->backhaul.parent_interface = bssid;
+                            if (!database.dm_set_device_multi_ap_backhaul(*child_agent_ptr)) {
+                                LOG(ERROR)
+                                    << "Failed to update backhaul DM for agent "
+                                    << child_agent_ptr->al_mac << " after bSTA " << client_mac
+                                    << " joined BSS " << bssid;
+                            } else {
+                                LOG(INFO)
+                                    << "Backhaul DM updated for agent "
+                                    << child_agent_ptr->al_mac
+                                    << " parent=" << parent_agent_ptr->al_mac
+                                    << " after bSTA " << client_mac << " joined BSS " << bssid;
+                            }
+                        }
+                        break;
+                    }
+                }
+            }
+        }
+
         std::shared_ptr<Agent::sRadio> radio = database.get_radio_by_bssid(bssid);
         if (!radio) {
             LOG(ERROR) << "No radio found hosting BSS " << bssid;
-- 
