+int8_t ApAutoConfigurationTask::allocate_whm_mld_unit(const std::string &ssid, int8_t mld_id)
+{
+    if (mld_id == DISABLED_MLDUNIT) {
+        return DISABLED_MLDUNIT;
+    }
+
+    auto db = AgentDB::get();
+    const std::string key = ssid + "\x1f" + std::to_string(mld_id);
+
+    auto existing_it = db->whm_mld_unit_registry.find(key);
+    if (existing_it != db->whm_mld_unit_registry.end()) {
+        return existing_it->second;
+    }
+
+    std::set<int8_t> used_units;
+    for (const auto &entry : db->whm_mld_unit_registry) {
+        used_units.insert(entry.second);
+    }
+    for (int8_t candidate = 1; candidate <= MLD_UNIT_MAX; ++candidate) {
+        if (used_units.find(candidate) == used_units.end()) {
+            db->whm_mld_unit_registry[key] = candidate;
+            return candidate;
+        }
+    }
+
+    LOG(WARNING) << "allocate_whm_mld_unit: no free WHM MLDUnit for ssid=" << ssid
+                 << ", mld_id=" << static_cast<int>(mld_id);
+    return DISABLED_MLDUNIT;
+}
