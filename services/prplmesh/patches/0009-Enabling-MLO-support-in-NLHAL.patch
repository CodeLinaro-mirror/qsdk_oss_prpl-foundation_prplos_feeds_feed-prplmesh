+int fetch_mld_id_pair(int mld_id, std::string &mld_grp_primary_ifname) {
+
+       std::string filename = MLD_PAIR_ENTRANT_FILE;
+
+       int fd = open(filename.c_str(), O_RDONLY);
+       if (fd == -1) {
+               perror("open");
+               return -1;
+       }
+
+       struct flock lock = { F_RDLCK, SEEK_SET, 0, 0, 0 };
+       fcntl(fd, F_SETLKW, &lock); // acquire read lock
+
+       std::ifstream file(filename);
+       std::string line;
+       std::string name;
+       while (getline(file, line)) {
+               std::istringstream iss(line);
+               std::string id_str, name_str;
+               if (getline(iss, id_str, ',') && getline(iss, name_str)) {
+                       if (std::stoi(id_str) == mld_id) {
+                               name = name_str;
+                               break;
+                       }
+
+
+
+               }
+       }
+
+       lock.l_type = F_UNLCK;
+       fcntl(fd, F_SETLK, &lock); // release lock
+       close(fd);
+       mld_grp_primary_ifname = name;
+       return 0;
+
+}
+
+int update_mld_grp_primary_ifname(int mld_id, std::string cur_ifname) {
+       std::string filename = MLD_PAIR_ENTRANT_FILE;
+
+       int fd = open(filename.c_str(), O_WRONLY | O_APPEND | O_CREAT, 0666);
+       if (fd == -1) {
+               perror("open");
+               return -1;
+       }
+
+       struct flock lock = { F_WRLCK, SEEK_SET, 0, 0, 0 };
+       lock.l_type = F_WRLCK; // write lock
+
+       fcntl(fd, F_SETLKW, &lock); // wait until lock is acquired
+       std::ofstream file(filename, std::ios::app);
+       if (file.is_open()) {
+               file << mld_id << "," << cur_ifname << "\n";
+               file.close();
+       }
+
+       lock.l_type = F_UNLCK;
+       fcntl(fd, F_SETLK, &lock); // release lock
+       close(fd);
+       return 0;
+
+}
+
+
+std::string get_ifname_wrt_mld_grp(int mld_id, std::string cur_ifname) {
+       std::string mld_grp_primary_ifname;
+       fetch_mld_id_pair(mld_id, mld_grp_primary_ifname);
+       if (mld_grp_primary_ifname.empty()) {
+               update_mld_grp_primary_ifname(mld_id, cur_ifname);
+               return cur_ifname;
+       } else {
+               return mld_grp_primary_ifname;
+       }
+
+}
