From 1da2afb9f874106daa5872b311c9f1ea93a057a1 Mon Sep 17 00:00:00 2001
From: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
Date: Thu, 26 Feb 2026 15:18:24 +0530
Subject: [PATCH 1/9] Fix MLO metrics matching and STA capability selection

- Continue processing metric reporting policy entries even if one fails.
- Handle MLO by matching AP Metrics BSSID against either link BSSID or AP MLD MAC.
- Prefer nl80211 *_BYTES64 station counters when available to avoid overflow.
- Fix controller STA capability lookup returning wrong band capabilities.

Signed-off-by: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp |  6 +--
 .../tasks/link_metrics_collection_task.cpp    | 23 ++++++++--
 .../bwl/nl80211/mon_wlan_hal_nl80211.cpp      | 46 +++++++++++++------
 controller/src/beerocks/master/db/db.cpp      |  4 +-
 4 files changed, 56 insertions(+), 23 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index c25c90625..e59593419 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -1828,7 +1828,7 @@ void ApAutoConfigurationTask::handle_multi_ap_policy_config_request(
             if (!std::get<0>(tuple)) {
                 LOG(ERROR) << "Failed to get metrics_reporting_conf[" << i
                            << "] from TLV_METRIC_REPORTING_POLICY";
-                return;
+                continue;
             }
 
             auto metrics_reporting_conf = std::get<1>(tuple);
@@ -1847,12 +1847,12 @@ void ApAutoConfigurationTask::handle_multi_ap_policy_config_request(
              */
             if (monitor_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
                 LOG(ERROR) << "monitor_socket is null";
-                return;
+                continue;
             }
 
             if (!m_btl_ctx.forward_cmdu_to_uds(monitor_fd, cmdu_rx)) {
                 LOG(ERROR) << "Failed to forward message to monitor";
-                return;
+                continue;
             }
         }
 
diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
index f8d5e8f7c..e8b6c2bdd 100644
--- a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
@@ -1127,6 +1127,17 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
             continue;
         }
 
+        // For MLO, the client's BSSID in associated_clients is the AP MLD MAC,
+        // while metric.bssid is the link-specific BSSID. Find the AP MLD MAC for
+        // this BSS to handle both cases in the BSSID checks below.
+        sMacAddr bss_apmld_mac = net::network_utils::ZERO_MAC;
+        for (const auto &bssid_entry : radio->front.bssids) {
+            if (bssid_entry.mac == metric.bssid) {
+                bss_apmld_mac = bssid_entry.apmld_mac;
+                break;
+            }
+        }
+
         std::vector<sStaTrafficStats> traffic_stats_response;
 
         for (const auto &sta_traffic :
@@ -1138,7 +1149,9 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
 
             auto assoc_client = radio->associated_clients.find(sta_traffic->sta_mac());
             if (assoc_client != radio->associated_clients.end() &&
-                assoc_client->second.bssid == metric.bssid) {
+                (assoc_client->second.bssid == metric.bssid ||
+                 (bss_apmld_mac != net::network_utils::ZERO_MAC &&
+                  assoc_client->second.bssid == bss_apmld_mac))) {
                 traffic_stats_response.push_back({
                     sta_traffic->sta_mac(),
                     sta_traffic->byte_sent(),
@@ -1179,7 +1192,9 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
             }
             auto assoc_client = radio->associated_clients.find(sta_qos_ctrl_params->sta_mac());
             if (assoc_client != radio->associated_clients.end() &&
-                assoc_client->second.bssid == metric.bssid) {
+                (assoc_client->second.bssid == metric.bssid ||
+                 (bss_apmld_mac != net::network_utils::ZERO_MAC &&
+                  assoc_client->second.bssid == bss_apmld_mac))) {
                 uint8_t tid_list_length = sta_qos_ctrl_params->tid_queue_size_list_length();
 
                 sStaQosCtrlParams sta_qos_params;
@@ -1228,7 +1243,9 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
 
             auto assoc_client = radio->associated_clients.find(affl_sta_metrics->sta_mac_addr());
             if (assoc_client != radio->associated_clients.end() &&
-                assoc_client->second.bssid == metric.bssid) {
+                (assoc_client->second.bssid == metric.bssid ||
+                 (bss_apmld_mac != net::network_utils::ZERO_MAC &&
+                  assoc_client->second.bssid == bss_apmld_mac))) {
                 affiliated_sta_metrics.push_back({
                     affl_sta_metrics->sta_mac_addr(),
                     affl_sta_metrics->bytes_sent(),
diff --git a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
index 85558f70a..5e8524505 100644
--- a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
