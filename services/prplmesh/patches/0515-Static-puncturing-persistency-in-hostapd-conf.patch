From e4e1586bc6fbc1ea2421e469ea1312cb0491d6aa Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Thu, 8 Oct 2026 21:51:38 +0530
Subject: [PATCH] Static puncturing persistency in hostapd conf

This scenario is seen when a static puncturing is already propogated
and later we trigger update wifi credentials, since there is no
punct pattern stored in the hostapd conf file the puncture gets restored to 0

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h |  9 ++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 49 +++++++++++++++++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.h         |  1 +
 3 files changed, 59 insertions(+)

diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index 519ac6557..128f8f538 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -197,6 +197,15 @@ public:
      */
     virtual bool set_disabled_subchannels(uint16_t disabled_subchannel_bitmap) = 0;
 
+    /**
+     * @brief Update the static puncturing bitmap in the hostapd configuration so that it
+     * survives a BSS re-creation (e.g. credential cloning).
+     *
+     * @param [in] punct_bitmap The bitmap in effect (0 = no puncturing).
+     * @return true on success or if nothing needs to be updated.
+     */
+    virtual bool update_hostapd_punct_bitmap(uint16_t punct_bitmap) { return true; }
+
 #ifdef BEEROCKS_RDKB
     /**
      * @brief Apply a full set of EHT operation parameters to all BSS entries on this radio.
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 3c2552ec9..28d8163af 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -7690,6 +7690,34 @@ bool ap_wlan_hal_nl80211::set_disabled_subchannels(uint16_t bitmap)
     return true;
 }
 
+bool ap_wlan_hal_nl80211::update_hostapd_punct_bitmap(uint16_t punct_bitmap)
+{
+    if (!m_radio_info.eht_supported) {
+        return true;
+    }
+
+    prplmesh::hostapd::Configuration conf = load_hostapd_config(m_radio_info.iface_name, "");
+    if (!conf) {
+        LOG(ERROR) << "Unable to load hostapd config for interface " << m_radio_info.iface_name;
+        return false;
+    }
+
+    // A missing key means "no puncturing", so radios that never puncture are not touched.
+    auto existing    = conf.get_head_value("punct_bitmap");
+    uint16_t current = existing.empty() ? 0 : (uint16_t)std::strtoul(existing.c_str(), nullptr, 0);
+    if (current == punct_bitmap) {
+        return true;
+    }
+
+    LOG(DEBUG) << "Update hostapd conf punct_bitmap " << current << " -> " << punct_bitmap;
+    if (!conf.set_create_head_value("punct_bitmap", std::to_string(punct_bitmap)) ||
+        !conf.store("")) {
+        LOG(ERROR) << "update_hostapd_punct_bitmap: cannot save hostapd config!";
+        return false;
+    }
+    return true;
+}
+
 void ap_wlan_hal_nl80211::detect_mlo_client(
     const std::string &sta_mac, const std::string &interface, int vap_id,
     sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION *msg)
@@ -8935,6 +8963,27 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
                        << " for iface=" << m_radio_info.iface_name;
             event_queue_push(Event::CSA_Finished);
         }
+
+        // Update the hostapd conf with the bitmap announced by the driver/hostapd so that it
+        // survives a BSS re-creation (e.g. credential cloning). This is event driven, so it
+        // covers every way a puncture gets applied (controller channel selection, CSA followed
+        // from the backhaul, driver autonomous) on both controller and agent. The event is
+        // relayed for every MLO link, so only accept it when its frequency belongs to this
+        // radio's band.
+        {
+            auto norm_band = [](beerocks::eFreqType b) {
+                return (b == beerocks::eFreqType::FREQ_5GL || b == beerocks::eFreqType::FREQ_5GH)
+                           ? beerocks::eFreqType::FREQ_5G
+                           : b;
+            };
+            const int csa_freq    = beerocks::string_utils::stoi(parsed_obj["freq"]);
+            const auto radio_band = m_radio_info.frequency_band;
+            if (csa_freq > 0 && radio_band != beerocks::eFreqType::FREQ_UNKNOWN &&
+                norm_band(son::wireless_utils::which_freq_type(csa_freq)) ==
+                    norm_band(radio_band)) {
+                update_hostapd_punct_bitmap(new_bitmap);
+            }
+        }
     } break;
 
     case Event::AWGN_Detected: {
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index e43e82bcb..4a2b61f82 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -153,6 +153,7 @@ public:
     virtual bool set_radio_mbo_assoc_disallow(bool enable) override;
     virtual bool set_primary_vlan_id(uint16_t primary_vlan_id) override;
     virtual bool set_disabled_subchannels(uint16_t bitmap) override;
+    virtual bool update_hostapd_punct_bitmap(uint16_t punct_bitmap) override;
     virtual bool set_cce_indication(uint16_t advertise_cce) override;
     virtual int add_bss(std::string &ifname, son::wireless_utils::sBssInfoConf &bss_conf,
                         std::string &bridge, bool vbss) override;
