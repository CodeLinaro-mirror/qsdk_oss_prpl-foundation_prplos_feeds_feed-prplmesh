@@ -0,0 +1,109 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "neighbor_db_agent_task.h"
+
+#include <bcl/network/network_utils.h>
+#include <easylogging++.h>
+
+using namespace beerocks;
+
+NeighborDbAgentTask::NeighborDbAgentTask(slave_thread &btl_ctx_,
+                                         ieee1905_1::CmduMessageTx &cmdu_tx_)
+    : Task(eTaskType::NEIGHBOR_DB), m_btl_ctx(btl_ctx_), m_cmdu_tx(cmdu_tx_)
+{
+    LOG(DEBUG) << "AP_DEBUG: NeighborDbAgentTask started";
+}
+
+void NeighborDbAgentTask::work()
+{
+    // No periodic work required. The task is event-driven:
+    //  - TRIGGER_SEND_LOCAL_NEIGHBOR_INFO event → collect and send local neighbor info.
+}
+
+void NeighborDbAgentTask::handle_event(uint8_t event_enum_value, const void *event_obj)
+{
+    switch (static_cast<eEvent>(event_enum_value)) {
+    case TRIGGER_SEND_LOCAL_NEIGHBOR_INFO: {
+        const auto *ev = reinterpret_cast<const sTriggerSendLocalNeighborInfoEvent *>(event_obj);
+
+        if (ev) {
+            LOG(INFO) << "AP_DEBUG: Event TRIGGER_SEND_LOCAL_NEIGHBOR_INFO"
+                      << " reason_code=" << int(ev->reason_code) << " reason=\"" << ev->reason
+                      << "\"";
+        } else {
+            LOG(INFO) << "AP_DEBUG: Event TRIGGER_SEND_LOCAL_NEIGHBOR_INFO (no payload)";
+        }
+
+        auto report_data = collect_local_neighbor_report();
+        send_local_neighbor_info_to_controller(report_data);
+        m_last_sent = std::chrono::steady_clock::now();
+        break;
+    }
+    default:
+        LOG(WARNING) << "AP_DEBUG: NeighborDbAgentTask received unknown event type "
+                     << int(event_enum_value);
+        break;
+    }
+}
+
+bool NeighborDbAgentTask::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                                      const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                                      std::shared_ptr<beerocks_header> beerocks_header)
+{
+    (void)iface_index;
+    (void)dst_mac;
+    (void)src_mac;
+    (void)fd;
+    (void)beerocks_header;
+
+    // Agent-side Neighbor DB task currently does not consume any CMDUs.
+    // Retained for future use (e.g. if controller later sends aggregated neighbor info to agent).
+    (void)cmdu_rx;
+    return false;
+}
+
+std::vector<uint8_t> NeighborDbAgentTask::collect_local_neighbor_report()
+{
+    // [STUB] In the full implementation this function will query hostapd (per radio/BSS)
+    // and build the Neighbor Report Element (NRE) bytes to send to the controller.
+    //
+    // For now, return an empty placeholder vector.
+    LOG(DEBUG) << "AP_DEBUG: [STUB] Collecting local neighbor report element from hostapd"
+               << " (TBD - returning placeholder empty NRE bytes)";
+    return {};
+}
+
+void NeighborDbAgentTask::send_local_neighbor_info_to_controller(
+    const std::vector<uint8_t> &report_data)
+{
+    // [STUB] In the full implementation this function will:
+    //  1. Build a 1905 Local Neighbor Information Message.
+    //  2. Add Neighbor Information TLV (SMD TLV TBD) populated from report_data.
+    //  3. Transmit to the controller via slave_thread::send_cmdu_to_controller().
+    // The message is fire-and-forget; no response is expected.
+
+    auto db                    = AgentDB::get();
+    const auto controller_alid = db->controller_info.bridge_mac;
+
+    LOG(DEBUG) << "AP_DEBUG: [STUB] Sending Local Neighbor Information Message to controller "
+               << controller_alid << " (NRE bytes=" << report_data.size() << ")";
+
+    if (controller_alid == net::network_utils::ZERO_MAC) {
+        LOG(WARNING) << "AP_DEBUG: [STUB] Controller ALID is unknown (ZERO_MAC)."
+                     << " Message would be dropped in a real implementation.";
+    }
+
+    // TODO: Replace stub with actual 1905 message construction and transmission:
+    //
+    //   if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::LOCAL_NEIGHBOR_INFORMATION_MESSAGE)) {
+    //       LOG(ERROR) << "Failed to create LOCAL_NEIGHBOR_INFORMATION_MESSAGE";
+    //       return;
+    //   }
+    //   auto tlv = m_cmdu_tx.addClass<vendor_specific::tlvNeighborInformation>();
+    //   // populate tlv from report_data...
+    //   if (!m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx)) {
+    //       LOG(ERROR) << "Failed sending local neighbor info to controller";
+    //   }
+}
