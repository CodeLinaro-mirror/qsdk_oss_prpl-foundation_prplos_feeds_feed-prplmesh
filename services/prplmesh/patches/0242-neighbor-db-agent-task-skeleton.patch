+++ b/agent/src/beerocks/slave/tasks/neighbor_db_agent_task.h
@@ -0,0 +1,130 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _NEIGHBOR_DB_AGENT_TASK_H_
+#define _NEIGHBOR_DB_AGENT_TASK_H_
+
+#include "../son_slave_thread.h"
+#include "task.h"
+
+#include <chrono>
+#include <string>
+#include <vector>
+
+namespace beerocks {
+
+/**
+ * @brief Agent Neighbor DB Task (SMD skeleton)
+ *
+ * Agent-side task for the SMD Neighbor DB Update process.
+ *
+ * The agent only ever sends the Local Neighbor Information Message to the controller.
+ *
+ * Triggers
+ * --------
+ * This task is event-driven and exposes an internal event which can be pushed from outside
+ * whenever the agent should report updated neighbor information. For example:
+ *  - After onboarding when MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE is received.
+ *  - After any change to VAP state / BSS parameters.
+ *
+ * Current implementation status
+ * ------------------------------
+ * This is a skeleton implementation. All 1905 message transmissions and hostapd API calls are
+ * replaced by LOG(DEBUG) stubs so that the logic can be exercised without any external
+ * dependencies. The stubs are clearly marked with "[STUB]" in the log output.
+ */
+class NeighborDbAgentTask : public Task {
+public:
+    // -----------------------------------------------------------------------
+    // Events
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Events that can be pushed to this task via TaskPool::send_event(eTaskType,...).
+     */
+    enum eEvent : uint8_t {
+        /**
+         * Trigger sending the Local Neighbor Information Message to the controller.
+         * This is fire-and-forget: no response is expected.
+         */
+        TRIGGER_SEND_LOCAL_NEIGHBOR_INFO,
+    };
+
+    // -----------------------------------------------------------------------
+    // Event payload structs
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Payload for TRIGGER_SEND_LOCAL_NEIGHBOR_INFO.
+     *
+     * Optional debug fields to help trace the reason for the trigger.
+     */
+    struct sTriggerSendLocalNeighborInfoEvent {
+        uint8_t reason_code = 0;
+        std::string reason; ///< Optional human-readable reason (for logs/debug).
+    };
+
+    // -----------------------------------------------------------------------
+    // Constructor / destructor
+    // -----------------------------------------------------------------------
+
+    NeighborDbAgentTask(slave_thread &btl_ctx_, ieee1905_1::CmduMessageTx &cmdu_tx_);
+    virtual ~NeighborDbAgentTask() = default;
+
+    // -----------------------------------------------------------------------
+    // Task overrides
+    // -----------------------------------------------------------------------
+
+    void work() override;
+    void handle_event(uint8_t event_enum_value, const void *event_obj) override;
+
+    /**
+     * @brief Handle incoming 1905.1 CMDUs.
+     *
+     * Currently no 1905 messages are handled by this task (agent only sends).
+     * The method is implemented for future use.
+     */
+    bool handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                     const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                     std::shared_ptr<beerocks_header> beerocks_header) override;
+
+private:
+    // -----------------------------------------------------------------------
+    // Helpers
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief [STUB] Collect local neighbor information from hostapd.
+     *
+     * In the full implementation, this will query hostapd for the current neighbor report
+     * element bytes (IEEE Neighbor Report Element / BSS Transition Management neighbor report).
+     *
+     * @return Placeholder neighbor report bytes.
+     */
+    std::vector<uint8_t> collect_local_neighbor_report();
+
+    /**
+     * @brief [STUB] Send Local Neighbor Information Message to the controller.
+     *
+     * In the full implementation, this will build and transmit a 1905 Local Neighbor
+     * Information Message with the Neighbor Information TLV.
+     *
+     * The message is sent fire-and-forget; no response is expected.
+     *
+     * @param report_data Raw NRE bytes (placeholder).
+     */
+    void send_local_neighbor_info_to_controller(const std::vector<uint8_t> &report_data);
+
+private:
+    slave_thread &m_btl_ctx;
+    ieee1905_1::CmduMessageTx &m_cmdu_tx;
+
+    // Last time we sent a report (for debug / potential future throttling).
+    std::chrono::steady_clock::time_point m_last_sent =
+        std::chrono::steady_clock::time_point::min();
+};
+
+} // namespace beerocks
+
+#endif // _NEIGHBOR_DB_AGENT_TASK_H_
