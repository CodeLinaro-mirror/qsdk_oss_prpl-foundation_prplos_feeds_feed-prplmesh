+bool TrunkPortPlumbing8021q::retag_subifaces(const sTrafficSeparationConfig &cfg)
+{
+    // Both subifaces must still exist to retag in place; if either is gone
+    // (e.g. parent interface was torn down/recreated), let the caller fall
+    // back to the normal clear+recreate path.
+    if ((!m_private_subiface.empty() &&
+         !network_utils::linux_iface_exists(m_private_subiface)) ||
+        (!m_guest_subiface.empty() && !network_utils::linux_iface_exists(m_guest_subiface))) {
+        return false;
+    }
+
+    // Retag the VLAN ID, then rename the interface to match (e.g. "w0.492" ->
+    // "w0.4092"), so the interface name never diverges from the VID it now
+    // carries. The rename does not affect bridge membership or STP state (see
+    // network_utils::rename_interface()); a failed rename is only cosmetic
+    // and does not need to roll back the (already functional) VID change. If
+    // it fails, m_private_subiface/m_guest_subiface keep the old name even
+    // though the kernel-level VID has already changed on that interface.
+    if (!m_private_subiface.empty() && m_last_cfg.private_vid != cfg.private_vid) {
+        if (!network_utils::set_vlan_interface_id(m_private_subiface, cfg.private_vid)) {
+            LOG(ERROR) << "failed to retag iface=" << m_private_subiface
+                       << " to vid=" << cfg.private_vid;
+            return false;
+        }
+
+        const auto new_name =
+            network_utils::build_vlan_interface_name(m_trunk.iface_name, cfg.private_vid);
+        if (!new_name.empty() &&
+            network_utils::rename_interface(m_private_subiface, new_name)) {
+            m_private_subiface = new_name;
+        } else if (!new_name.empty()) {
+            LOG(WARNING) << "failed to rename iface=" << m_private_subiface << " to " << new_name
+                        << ", keeping old name (VID retag already applied)";
+        }
+    }
+
+    if (!m_guest_subiface.empty() && m_last_cfg.guest_vid != cfg.guest_vid) {
+        if (!network_utils::set_vlan_interface_id(m_guest_subiface, cfg.guest_vid)) {
+            LOG(ERROR) << "failed to retag iface=" << m_guest_subiface
+                       << " to vid=" << cfg.guest_vid;
+            return false;
+        }
+
+        const auto new_name =
+            network_utils::build_vlan_interface_name(m_trunk.iface_name, cfg.guest_vid);
+        if (!new_name.empty() && network_utils::rename_interface(m_guest_subiface, new_name)) {
+            m_guest_subiface = new_name;
+        } else if (!new_name.empty()) {
+            LOG(WARNING) << "failed to rename iface=" << m_guest_subiface << " to " << new_name
+                        << ", keeping old name (VID retag already applied)";
+        }
+    }
+
+    return true;
+}
