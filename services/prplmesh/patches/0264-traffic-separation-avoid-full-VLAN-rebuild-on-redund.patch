+bool network_utils::set_vlan_interface_id(const std::string &vlan_iface, uint16_t new_vid)
+{
+    if (vlan_iface.empty()) {
+        LOG(ERROR) << "vlan_iface is empty!";
+        return false;
+    }
+
+    if (new_vid < net::MIN_VLAN_ID || new_vid > net::MAX_VLAN_ID) {
+        LOG(ERROR) << "Given VID is invalid: " << new_vid;
+        return false;
+    }
+
+    if (!linux_iface_exists(vlan_iface)) {
+        LOG(ERROR) << "vlan_iface=" << vlan_iface << " does not exist";
+        return false;
+    }
+
+    // Command example:
+    // ip link set wlan0.sta1.20 type vlan id 30
+    std::string cmd;
+    cmd.reserve(64);
+    cmd.assign("ip link set ")
+        .append(vlan_iface)
+        .append(" type vlan id ")
+        .append(std::to_string(new_vid));
+
+    if (beerocks::os_utils::system_call(cmd) != 0) {
+        LOG(ERROR) << "Failed to retag iface=" << vlan_iface << " to vid=" << new_vid;
+        return false;
+    }
+
+    return true;
+}
+
+bool network_utils::rename_interface(const std::string &old_name, const std::string &new_name)
+{
+    if (old_name.empty() || new_name.empty()) {
+        LOG(ERROR) << "old_name/new_name must not be empty!";
+        return false;
+    }
+
+    if (old_name == new_name) {
+        return true;
+    }
+
+    if (!linux_iface_exists(old_name)) {
+        LOG(ERROR) << "old_name=" << old_name << " does not exist";
+        return false;
+    }
+
+    if (linux_iface_exists(new_name)) {
+        LOG(ERROR) << "new_name=" << new_name << " already exists";
+        return false;
+    }
+
+    // Bridge port membership and link state are keyed by ifindex, not name, so
+    // renaming a live/forwarding bridge port does not detach it and does not
+    // affect its current bridge/STP state. The interface is intentionally left
+    // up during the rename.
+    //
+    // Command example:
+    // ip link set wlan0.sta1.492 name wlan0.sta1.4092
+    std::string cmd;
+    cmd.reserve(64);
+    cmd.assign("ip link set ").append(old_name).append(" name ").append(new_name);
+
+    beerocks::os_utils::system_call(cmd);
+
+    if (!linux_iface_exists(new_name)) {
+        LOG(ERROR) << "Failed to rename iface '" << old_name << "' to '" << new_name << "'";
+        return false;
+    }
+
+    return true;
+}
