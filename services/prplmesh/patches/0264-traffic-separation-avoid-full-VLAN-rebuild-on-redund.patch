+bool TrafficSeparationManager::reapply_config(const sTrafficSeparationConfig &cfg)
+{
+    if (!is_applied()) {
+        LOG(ERROR) << "reapply_config called while manager is not in APPLIED state";
+        return false;
+    }
+
+    m_config = cfg;
+
+    bool success = true;
+
+    for (auto &entry : m_trunk_port_plumbing_map) {
+        const auto &iface_name = entry.first;
+        auto &plumbing         = entry.second;
+
+        if (!plumbing) {
+            LOG(ERROR) << "null trunk_port plumbing iface=" << iface_name;
+            success = false;
+            continue;
+        }
+
+        if (!plumbing->apply(m_config)) {
+            LOG(ERROR) << "trunk_port reapply failed iface=" << iface_name;
+            success = false;
+        }
+    }
+
+    for (auto &entry : m_access_port_plumbing_map) {
+        const auto &iface_name = entry.first;
+        auto &plumbing         = entry.second;
+
+        if (!plumbing) {
+            LOG(ERROR) << "null access plumbing iface=" << iface_name;
+            success = false;
+            continue;
+        }
+
+        if (!plumbing->apply(m_config)) {
+            LOG(ERROR) << "access reapply failed iface=" << iface_name;
+            success = false;
+        }
+    }
+
+    if (!success) {
+        LOG(ERROR) << "reapply_config failed for one or more ports";
+        return false;
+    }
+
+    {
+        auto db = beerocks::AgentDB::get();
+        if (db->device_conf.ts_bridge_mapping_enabled) {
+            verify_and_fix_bridge_assignments();
+        }
+    }
+
+    {
+        auto db = beerocks::AgentDB::get();
+        if (db->device_conf.ts_persistence_enabled) {
+            persist_bridge_assignments();
+        }
+    }
+
+    LOG(DEBUG) << "config reapplied successfully on all managed ports";
+
+    return true;
+}
