+
+bool TrafficSeparationTask::trunks_unchanged(const std::vector<net::sTrunkPort> &trunks) const
+{
+    if (trunks.size() != m_last_applied_trunks.size()) {
+        return false;
+    }
+
+    // get_ports_from_db() does not guarantee stable ordering, so compare as
+    // multisets rather than relying on identical sequence order.
+    std::vector<bool> matched(m_last_applied_trunks.size(), false);
+    for (const auto &trunk : trunks) {
+        bool found = false;
+        for (size_t i = 0; i < m_last_applied_trunks.size(); ++i) {
+            if (!matched[i] && m_last_applied_trunks[i] == trunk) {
+                matched[i] = true;
+                found      = true;
+                break;
+            }
+        }
+        if (!found) {
+            return false;
+        }
+    }
     return true;
 }
 
+bool TrafficSeparationTask::matches_last_applied(const net::sTrafficSeparationConfig &cfg,
+                                                 const std::vector<net::sTrunkPort> &trunks) const
+{
+    if (!m_last_applied_valid || !(m_last_applied_cfg == cfg)) {
+        return false;
+    }
+
+    return trunks_unchanged(trunks);
+}
+
+bool TrafficSeparationTask::only_vids_changed(const net::sTrafficSeparationConfig &cfg,
+                                              const std::vector<net::sTrunkPort> &trunks) const
+{
+    if (!m_last_applied_valid) {
+        return false;
+    }
+
+    // Bridges must be unchanged; only the VIDs may differ. A bridge change or
+    // a differing trunk port set still requires the full clear_policies() +
+    // rebuild path.
+    if (m_last_applied_cfg.private_bridge != cfg.private_bridge ||
+        m_last_applied_cfg.guest_bridge != cfg.guest_bridge) {
+        return false;
+    }
+
+    if (m_last_applied_cfg.private_vid == cfg.private_vid &&
+        m_last_applied_cfg.guest_vid == cfg.guest_vid) {
+        // Identical config is handled by matches_last_applied(); nothing to do here.
+        return false;
+    }
+
+    return trunks_unchanged(trunks);
+}
