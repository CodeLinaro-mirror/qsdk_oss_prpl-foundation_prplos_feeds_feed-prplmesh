From 6c4d87234f34f143f481e032e69a91730e4bd8e9 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Fri, 16 Oct 2026 21:34:02 +0530
Subject: [PATCH] update selected_iface_name on wired-to-wireless hot-switch

On a wired-to-wireless hot-switch, connection_type is set to Wireless
but selected_iface_name still holds the stale Ethernet name (e.g. eth2).
db->radio(selected_iface_name) then returns nullptr, and the M1 builder
in ap_autoconfiguration_task dereferences it, crashing beerocks_agent.

The code that updates selected_iface_name, backhaul_bssid and
selected_iface_radio_mac on STA_CONNECTED was compiled only under
BEEROCKS_RDKB, so it was missing in the NL build. Remove the ifdef so
the hot-switch branch is built on all platforms.

Note: Also removed few error logs which were flooding the logs

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     | 38 ++++++++++++++++---
 .../bwl/shared/nl80211_client_impl.cpp        | 10 -----
 2 files changed, 32 insertions(+), 16 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 377d56f0b..d5d9e1727 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -3380,12 +3380,20 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
         // traffic_separation_task's trunk-port selection). See the matching else
         // branch further below for the full VLAN-ID-change handling.
         auto connected_msg = static_cast<bwl::sACTION_BACKHAUL_CONNECTED_NOTIFICATION *>(data);
-        if (connected_msg && connected_msg->multi_ap_primary_vlan_id != 0 &&
-            db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
-            iface != db->backhaul.selected_iface_name &&
-            db->backhaul.mlo_primary_bsta_iface.empty()) {
-            db->backhaul.mlo_primary_bsta_iface = iface;
-            LOG(INFO) << "MLO: identified primary bSTA anchor iface=" << iface;
+        if (connected_msg &&
+            db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless) {
+            db->backhaul.backhaul_bss_multi_ap_profile = connected_msg->multi_ap_profile;
+            LOG(DEBUG) << "backhaul_bss_multi_ap_profile="
+                       << int(db->backhaul.backhaul_bss_multi_ap_profile)
+                       << " multi_ap_primary_vlan_id=" << connected_msg->multi_ap_primary_vlan_id
+                       << " iface=" << iface << " selected_iface='"
+                       << db->backhaul.selected_iface_name << "'";
+            if (connected_msg->multi_ap_primary_vlan_id != 0 &&
+                iface != db->backhaul.selected_iface_name &&
+                db->backhaul.mlo_primary_bsta_iface.empty()) {
+                db->backhaul.mlo_primary_bsta_iface = iface;
+                LOG(INFO) << "MLO: identified primary bSTA anchor iface=" << iface;
+            }
         }
 
         // Try adding wireless backhaul STA interface to the bridge in case there is no
@@ -3635,6 +3643,24 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
             // (up to 60s) Topology Discovery, so the controller sees the corrected
             // network_membership as soon as possible.
             m_task_pool.send_event(eTaskType::TOPOLOGY, TopologyTask::eEvent::AGENT_RADIO_STATE_CHANGED);
+        } else if ((FSM_IS_IN_STATE(CONNECTED) || FSM_IS_IN_STATE(OPERATIONAL)) &&
+                   db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
+                   (db->backhaul.selected_iface_name != iface ||
+                    db->backhaul.backhaul_bssid != bssid)) {
+            // Hot-switch wired→wireless or BSSID change on a different iface: update
+            // selected_iface_name/bssid/radio_mac so is_wireless_backhaul_on_radio() returns
+            // true and the vendor BSS TLV emits the bSTA entry. Guarded by iface/bssid change
+            // to suppress steady-state topology reports from duplicate Connected events.
+            LOG(DEBUG) << "Wireless Connected: updating selected_iface_name from '"
+                       << db->backhaul.selected_iface_name << "' to '" << iface
+                       << "' bssid=" << bssid;
+            db->backhaul.selected_iface_name = iface;
+            db->backhaul.backhaul_bssid      = bssid;
+            auto radio                       = db->radio(iface);
+            if (radio) {
+                db->backhaul.selected_iface_radio_mac = radio->front.iface_mac;
+            }
+            m_task_pool.send_event(eTaskType::TOPOLOGY, TopologyTask::eEvent::AGENT_RADIO_STATE_CHANGED);
         }
     } break;
 
diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index 76094b9f8..2786c8c98 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -111,7 +111,6 @@ static void update_qos_map_support_from_supported_commands(nl80211_client::radio
                                                            struct nlattr *supported_commands)
 {
     if (!supported_commands) {
-        LOG(DEBUG) << "QoS management NL80211_ATTR_SUPPORTED_COMMANDS not present";
         return;
     }
 
@@ -155,7 +154,6 @@ static void update_qos_management_support_from_vendor_data(nl80211_client::radio
                                                            struct nlattr *vendor_data)
 {
     if (!vendor_data) {
-        LOG(DEBUG) << "QoS management NL80211_ATTR_VENDOR_DATA not present";
         return;
     }
 
@@ -199,7 +197,6 @@ static void update_traffic_separation_support_from_iftypes(nl80211_client::radio
                                                            struct nlattr *supported_iftypes)
 {
     if (!supported_iftypes) {
-        LOG(DEBUG) << "AP Radio Advanced Capabilities NL80211_ATTR_SUPPORTED_IFTYPES not present";
         return;
     }
 
@@ -756,8 +753,6 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
                            << nla_length << " copied_len=" << actual_length;
                 update_qos_management_support_from_ext_capa(
                     radio_info, ext_capability, actual_length, "NL80211_ATTR_EXT_CAPA");
-            } else {
-                LOG(DEBUG) << "QoS management NL80211_ATTR_EXT_CAPA not present";
             }
 #endif
 
@@ -990,8 +985,6 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
                                        << int(eht_mac[EHT_MAC_QM_SCS_TRAFFIC_BYTE]) << std::dec
                                        << " => qm_scs_traffic_description="
                                        << radio_info.qm_scs_traffic_description_supported;
-                        } else {
-                            LOG(DEBUG) << "QoS management EHT MAC caps not present";
                         }
 #endif
 
@@ -1280,7 +1273,6 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
 	  }
 
 	  if (tb[NL80211_ATTR_IFTYPE_EXT_CAPA]) {
-		  LOG(DEBUG) << "QoS management NL80211_ATTR_IFTYPE_EXT_CAPA present";
 		  radio_info.eht_cfg.eht_supported = 1;
 		  struct nlattr* nl_ext_capa;
 		  int rem_band;
@@ -1334,8 +1326,6 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
 				  LOG(ERROR) << "tb_ext_capa[NL80211_ATTR_EML_CAPABILITY] not available";
 			  }
 		  }
-	  } else {
-		  LOG(DEBUG) << "QoS management NL80211_ATTR_IFTYPE_EXT_CAPA not present";
 	  }
 
           if (tb[NL80211_ATTR_WIPHY_RADIOS]) {
