From 47ce0f0028333d4b7d342063268d520814917d49 Mon Sep 17 00:00:00 2001
From: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
Date: Wed, 24 Jun 2026 11:23:58 +0530
Subject: [PATCH] Fix for Backhaul VAP Reload

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 24 +------------------
 1 file changed, 1 insertion(+), 23 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 5f12716ef..351e25016 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -60,14 +60,10 @@ bool ap_wlan_hal_nl80211::nl_event_handle(struct nl_msg *msg, void *arg)
 
 // Multi-AP Vendor IE components for assocresp_elements
 // Wire format: <vendor_type(1)><length(1)><oui(3)><oui_type(1)><hop_count(1)>
-// Example (extender):   "dd050013741b01"
-// Example (local agent): "dd050013741b00"
 #define MULTIAP_VENDOR_IE_TYPE         0xDDU  // Vendor-specific IE type
 #define MULTIAP_VENDOR_IE_LENGTH       0x05U  // Length of the IE payload (5 bytes)
 #define QUALCOMM_VENDOR_OUI            "001374"  // Qualcomm OUI (3 bytes)
 #define MULTIAP_VENDOR_OUI_TYPE        0x1BU  // Multi-AP vendor OUI type
-#define MULTIAP_HOP_COUNT_EXTENDER     0x01U  // Hop count for standalone extenders
-#define MULTIAP_HOP_COUNT_LOCAL_AGENT  0x00U  // Hop count for local agents
 
 
 // Temporary storage for station capabilities
@@ -403,11 +399,7 @@ static int remove_mld_entry_by_ifname(const std::string &ifname)
 
 
 // Builds the assocresp_elements hexdump for the Multi-AP backhaul vendor IE.
-// The IE is constructed from its individual components so that each field is
-// clearly identifiable and can be changed independently.
-//
-// @param hop_count  MULTIAP_HOP_COUNT_EXTENDER (0x01) for standalone extenders,
-//                   MULTIAP_HOP_COUNT_LOCAL_AGENT (0x00) for local agents.
+// @param hop_count  0x00 = local agent (gateway), 0x01 = standalone extender, 0xFF = unreachable.
 // @return  Lowercase hex string, e.g. "dd050013741b01".
 static std::string build_multiap_assocresp_ie(uint8_t hop_count)
 {
@@ -2560,14 +2552,6 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 conf.set_create_vap_value(vap_id, "rrm_neighbor_report", 1);
                 conf.set_create_vap_value(vap_id, "rrm_beacon_report", 1);
 
-                if (bss_it.backhaul) {
-                    uint8_t hop_count = (beerocks::bpl::cfg_is_master() != 0)
-                                        ? MULTIAP_HOP_COUNT_LOCAL_AGENT
-                                        : MULTIAP_HOP_COUNT_EXTENDER;
-                    conf.set_create_vap_value(vap_id, "assocresp_elements",
-                        build_multiap_assocresp_ie(hop_count));
-                }
-
                 // Write SMD policy parameters to hostapd config
                 if (bss_it.has_smd_policy) {
                     conf.set_create_vap_value(vap_id, "smd_ap", "1");
@@ -4750,12 +4734,6 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
                                   bss_conf.backhaul_wps_passphrase);
     }
     if (bss_conf.backhaul) {
-        uint8_t hop_count = (beerocks::bpl::cfg_is_master() != 0)
-                            ? MULTIAP_HOP_COUNT_LOCAL_AGENT
-                            : MULTIAP_HOP_COUNT_EXTENDER;
-        conf.set_create_vap_value(vap_id, "assocresp_elements",
-            build_multiap_assocresp_ie(hop_count));
-
         // If a primary VLAN ID was already received (set_primary_vlan_id was called
         // before this backhaul AP was created), embed multi_ap_vlanid directly in the
         // conf file so hostapd advertises the VLAN ID in association responses
-- 
2.34.1

