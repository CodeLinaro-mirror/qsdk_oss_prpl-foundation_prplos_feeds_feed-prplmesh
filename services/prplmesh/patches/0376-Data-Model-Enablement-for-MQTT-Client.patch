+bool MqttNbapiImpl::init(const std::string &broker_address, const std::string &client_id)
+{
+    if (m_initialized) {
+        LOG(WARNING) << "MQTT Handler already initialized";
+        return true;
+    }
+
+    if (!m_amx_client) {
+        LOG(ERROR) << "Ambiorix client is null";
+        return false;
+    }
+
+    LOG(INFO) << "Initializing MQTT Handler...";
+    LOG(INFO) << "Broker: " << broker_address;
+    LOG(INFO) << "Client ID: " << client_id;
+
+    // Parse broker address (format: "tcp://host:port" or "host:port")
+    std::string host = "localhost";
+    int port = 1883;
+    
+    size_t proto_pos = broker_address.find("://");
+    std::string addr = broker_address;
+    if (proto_pos != std::string::npos) {
+        addr = broker_address.substr(proto_pos + 3);
+    }
+    
+    size_t colon_pos = addr.find(':');
+    if (colon_pos != std::string::npos) {
+        host = addr.substr(0, colon_pos);
+        port = std::stoi(addr.substr(colon_pos + 1));
+    } else {
+        host = addr;
+    }
+
+    // Create MQTT client
+    m_mqtt_client = beerocks::mqttapi::mqtt_client_create();
+    if (!m_mqtt_client) {
+        LOG(ERROR) << "Failed to create MQTT client";
+        return false;
+    }
+
+    // Initialize with callbacks
+    beerocks::mqttapi::MQTTClient::Callbacks callbacks;
+    callbacks.process_msg_cb = [this](const char* topic, const void* payload, int len) {
+        this->handle_message(topic, payload, len);
+    };
+    // Use member functions for FD registration/unregistration
+    callbacks.register_fd_cb = [this](int fd) {
+        this->register_mqtt_fd(fd);
+    };
+    callbacks.unregister_fd_cb = [this](int fd) {
+        this->unregister_mqtt_fd(fd);
+    };
+
+    if (!m_mqtt_client->init(client_id, callbacks, /*conn_retry_timeout_ms=*/5000)) {
+        LOG(ERROR) << "Failed to initialize MQTT client";
+        return false;
+    }
+
+    // Connect to broker
+    if (!m_mqtt_client->connect(host, port, /*keepalive=*/60)) {
+        LOG(ERROR) << "Failed to connect MQTT client";
+        return false;
+    }
+
+    LOG(INFO) << "MQTT client connected successfully";
+
+    // Subscribe to DataElements data model paths with wildcard
+    std::string dm_topic = "Device/WiFi/DataElements/#";
+    LOG(INFO) << "Subscribing to data model topic: " << dm_topic;
+    
+    if (m_mqtt_client->subscribe(dm_topic, 1) != 0) {
+        LOG(ERROR) << "Failed to subscribe to " << dm_topic;
+        return false;
+    }
+
+    LOG(INFO) << "Successfully subscribed to data model topics";
+
+    m_initialized = true;
+    LOG(INFO) << "MQTT Handler initialized successfully";
+    return true;
+}
+
+int MqttNbapiImpl::get_fd() const
+{
+    if (!m_mqtt_client) {
+        return -1;
+    }
+    return m_mqtt_client->get_fd();
+}
+
+bool MqttNbapiImpl::process_mqtt_events(int fd)
+{
+    if (!m_mqtt_client || !m_initialized) {
+        return false;
+    }
+
+    if (fd == m_mqtt_client->get_fd()) {
+        // Readable event on the MQTT socket — process to consume incoming data
+        m_mqtt_client->process();
+        return true;
+    }
+    return false;
+}
+
+void MqttNbapiImpl::run_loop()
+{
+    if (!m_initialized || !m_mqtt_client) {
+        return;
+    }
+
+    m_mqtt_client->run_loop();
+}
+
+void MqttNbapiImpl::shutdown()
+{
+    if (m_mqtt_client) {
+        LOG(INFO) << "Shutting down MQTT Handler";
+        m_mqtt_client->deinit();
+        m_mqtt_client.reset();
+    }
+    m_initialized = false;
+}
+
+void MqttNbapiImpl::handle_message(const char *topic, const void *payload, int payloadlen)
+{
+    if (!topic || !payload || payloadlen <= 0) {
+        LOG(ERROR) << "Invalid message received";
+        return;
+    }
+
+    std::string topic_str(topic);
+    std::string payload_str(static_cast<const char *>(payload), payloadlen);
+    LOG(DEBUG) << "Received message on topic: " << topic_str << ", payload: " << payload_str;
+
+    // Parse request
+    std::string op, key, data, cmd, args, result_path;
+    if (!parse_payload(payload_str, op, key, data, cmd, args, result_path)) {
+        LOG(ERROR) << "Failed to parse request payload";
+        if (!result_path.empty()) {
+            publish_response(result_path, build_error_response(topic_str, "FAIL"));
+        }
+        return;
+    }
+
+    // EVENT notifications are published by this controller itself
+    if (op == "EVENT") {
+        LOG(DEBUG) << "Ignoring own EVENT notification received on: " << topic_str;
+        return;
+    }
+
+    LOG(INFO) << "Processing " << op << " request for path: " << topic_str;
+
+    // Handle based on operation type
+    if (op == "GET") {
+        handle_get(topic_str, result_path);
+    } else if (op == "RESOLVE") {
+        handle_resolve(topic_str, key, result_path);
+    } else if (op == "SET") {
+        handle_set(topic_str, data, result_path);
+    } else if (op == "CMD") {
+        handle_cmd(topic_str, cmd, args, result_path);
+    } else {
+        LOG(ERROR) << "Unknown operation: " << op;
+        publish_response(result_path, build_error_response(topic_str, "FAIL"));
+    }
+}
+
+void MqttNbapiImpl::handle_get(const std::string &path, const std::string &result_path)
+{
+    LOG(DEBUG) << "Handling GET request for path: " << path;
+
+    // Convert MQTT topic path (Device/WiFi/...) to data model path (Device.WiFi....)
+    std::string dm_path = path;
+    std::replace(dm_path.begin(), dm_path.end(), '/', '.');
+
+    std::string value;
+
+    // Try to get as object first (works for both object paths and instance paths)
+    // Ensure path ends with '.' for object queries (bus API requirement)
+    std::string query_path = dm_path;
+    if (!query_path.empty() && query_path.back() != '.') {
+        query_path += '.';
+    }
+
+    // Try get_object_data_json first - this works for both object and instance paths
+    bool success = m_amx_client->get_object_data_json(query_path, -1, value);
+    if (success) {
+        LOG(DEBUG) << "Retrieved as object/instance: " << dm_path;
+    } else {
+        // If get_object_data_json fails, try as a parameter
+        LOG(DEBUG) << "get_object_data_json failed, trying as parameter: " << dm_path;
+
+        size_t last_dot = dm_path.find_last_of('.');
+        if (last_dot == std::string::npos) {
+            LOG(ERROR) << "Invalid path format and not an object: " << dm_path;
+            publish_response(result_path, build_get_response(path, "FAIL"));
+            return;
+        }
+
+        std::string obj_path = dm_path.substr(0, last_dot);
+        std::string param_name = dm_path.substr(last_dot + 1);
+
+        LOG(DEBUG) << "Trying as parameter: obj=" << obj_path << ", param=" << param_name;
+
+        // Get single parameter value
+        if (!m_amx_client->read_param(obj_path, param_name, &value)) {
+            LOG(ERROR) << "Failed to get value for path: " << dm_path;
+            publish_response(result_path, build_get_response(path, "FAIL"));
+            return;
+        }
+    }
+
+    LOG(INFO) << "Successfully retrieved value for " << dm_path;
+
+    // Build and publish response
+    std::string response_payload = build_get_response(path, "OK", value);
+    publish_response(result_path, response_payload);
+}
+
+void MqttNbapiImpl::handle_resolve(const std::string &path, const std::string &key,
+                                 const std::string &result_path)
+{
+    LOG(DEBUG) << "Handling RESOLVE request for path: " << path << " with Key: " << key;
+
+    // Convert MQTT topic path to data model path
+    std::string dm_path = path;
+    std::replace(dm_path.begin(), dm_path.end(), '/', '.');
+
+    // Build search path: Device.WiFi.DataElements.Network.Device.[ID == 'key'].
+    std::string search_path = dm_path + ".[ID == '" + key + "'].";
+
+    // Get instance index using Ambiorix client
+    uint32_t instance_index = m_amx_client->get_instance_index(search_path, key);
+    
+    if (instance_index == 0) {
+        LOG(ERROR) << "Failed to resolve instance for Key: " << key;
+        publish_response(result_path, build_resolve_response(path, key, "FAIL"));
+        return;
+    }
+
+    LOG(INFO) << "Successfully resolved instance index: " << instance_index;
+
+    // Build and publish response
+    std::string response_payload =
+        build_resolve_response(path, key, "OK", std::to_string(instance_index));
+    publish_response(result_path, response_payload);
+}
+
+void MqttNbapiImpl::handle_set(const std::string &path, const std::string &data,
+                             const std::string &result_path)
+{
+    LOG(DEBUG) << "Handling SET request for path: " << path << " with data: " << data;
+
+    // Convert MQTT topic path to data model path
+    std::string dm_path = path;
+    std::replace(dm_path.begin(), dm_path.end(), '/', '.');
+
+    // Parse data JSON to extract parameter and value
+    struct json_object *data_obj = json_tokener_parse(data.c_str());
+    if (!data_obj) {
+        LOG(ERROR) << "Failed to parse data JSON";
+        publish_response(result_path, build_set_response(path, "FAIL"));
+        return;
+    }
+
+    bool success = true;
+    json_object_object_foreach(data_obj, param_name, param_value) {
+        const char *value_str = json_object_get_string(param_value);
+        if (!m_amx_client->set(dm_path, param_name, std::string(value_str))) {
+            LOG(ERROR) << "Failed to set " << param_name << " = " << value_str;
+            success = false;
+            break;
+        }
+    }
+
+    json_object_put(data_obj);
+
+    // Build and publish response
+    std::string status = success ? "OK" : "FAIL";
+    std::string response_payload = build_set_response(path, status);
+    publish_response(result_path, response_payload);
+}
+
+void MqttNbapiImpl::handle_cmd(const std::string &path, const std::string &cmd,
+                             const std::string &args, const std::string &result_path)
+{
+    LOG(DEBUG) << "Handling CMD request for path: " << path << ", cmd: " << cmd << ", args: " << args;
+
+    // Convert MQTT topic path to data model path
+    std::string dm_path = path;
+    std::replace(dm_path.begin(), dm_path.end(), '/', '.');
+
+    // Parse args JSON (if any) into a string key/value map for invoke_function
+    std::map<std::string, std::string> args_map;
+    if (!args.empty()) {
+        struct json_object *args_obj = json_tokener_parse(args.c_str());
+        if (!args_obj) {
+            LOG(ERROR) << "Failed to parse args JSON for cmd: " << cmd;
+            std::string response_payload = build_cmd_response(path, cmd, "FAIL");
+            publish_response(result_path, response_payload);
+            return;
+        }
+
+        if (json_object_is_type(args_obj, json_type_object)) {
+            json_object_object_foreach(args_obj, arg_name, arg_value) {
+                const char *value_str = json_object_get_string(arg_value);
+                args_map[arg_name] = value_str ? value_str : "";
+            }
+        }
+
+        json_object_put(args_obj);
+    }
+
+    std::string result;
+    bool success = m_amx_client->invoke_function(dm_path, cmd, args_map, &result);
+
+    if (!success) {
+        LOG(ERROR) << "Failed to invoke function [" << cmd << "] on " << dm_path;
+    } else {
+        LOG(INFO) << "Successfully invoked function [" << cmd << "] on " << dm_path;
+    }
+
+    // Build and publish response
+    std::string response_payload = build_cmd_response(path, cmd, success ? "OK" : "FAIL", result);
+    publish_response(result_path, response_payload);
+}
+
+bool MqttNbapiImpl::publish_event(const std::string &topic, const std::string &json_data)
+{
+    if (!m_mqtt_client || !m_initialized) {
+        LOG(DEBUG) << "MQTT handler not initialized, skipping EVENT publish to " << topic;
+        return false;
+    }
+
+    struct json_object *root = json_object_new_object();
+    json_object_object_add(root, "op", json_object_new_string("EVENT"));
+    json_object_object_add(root, "data", json_object_new_string(json_data.c_str()));
+    const std::string payload(json_object_to_json_string(root));
+    json_object_put(root);
+
+    LOG(DEBUG) << "Publishing EVENT to: " << topic;
+
+    if (m_mqtt_client->publish(topic, payload.c_str(), payload.length(), 0, false) != 0) {
+        LOG(ERROR) << "Failed to publish EVENT to " << topic;
+        return false;
+    }
+
+    LOG(INFO) << "Successfully published EVENT to " << topic;
+    return true;
+}
+
+void MqttNbapiImpl::publish_response(const std::string &result_path, const std::string &payload)
+{
+    LOG(DEBUG) << "Publishing response to: " << result_path;
+
+    if (m_mqtt_client->publish(result_path, payload.c_str(), payload.length(), 0, false) != 0) {
+        LOG(ERROR) << "Failed to publish response to " << result_path;
+        return;
+    }
+
+    LOG(INFO) << "Successfully published response";
+}
