+MqttNbapiImpl::MqttNbapiImpl(std::shared_ptr<beerocks::nbapi::Ambiorix> amx_client,
+                         std::shared_ptr<beerocks::EventLoop> event_loop)
+    : m_mqtt_client(nullptr), m_amx_client(amx_client), m_event_loop(event_loop),
+      m_initialized(false)
