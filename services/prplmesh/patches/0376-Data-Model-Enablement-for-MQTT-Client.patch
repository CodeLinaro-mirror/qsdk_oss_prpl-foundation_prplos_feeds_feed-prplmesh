--- a/framework/platform/nbapi/ambiorix_impl.cpp
+++ b/framework/platform/nbapi/ambiorix_impl.cpp
@@ -13,7 +13,10 @@
 #include <amxd/amxd_object.h>
 #include <amxd/amxd_object_event.h>
 #include <amxd/amxd_transaction.h>
+#include <yajl/yajl_gen.h>
+#include <amxj/amxj_variant.h>
 
+#include <algorithm>
 #include <bcl/network/network_utils.h>
 #include <mapf/common/utils.h>
 #include <tlvf/tlvftypes.h>
@@ -1084,9 +1087,165 @@ bool AmbiorixImpl::trigger_event_with_data(const std::string &object_path,
 
     // Cast void* to amxc_var_t* for the Ambiorix API
     amxc_var_t *data = static_cast<amxc_var_t *>(event_data);
-    amxd_object_trigger_signal(event_obj, event_name.c_str(), data);
+
+    // amxd_object_trigger_signal() takes ownership of `data` (it moves/empties
+    // the variant into the constructed event as part of amxd_object_send_signal()'s
+    // signal-emission convention), so pass it a copy - callers of this function
+    // (e.g. db::dm_trigger_*_event()) rely on their event_data still being valid
+    // and populated after this call returns, in particular to also publish the
+    // same data over MQTT below. Emptying the caller's
+    // variant here silently turned every MQTT-published event's data into "{}".
+    amxc_var_t data_copy;
+    amxc_var_init(&data_copy);
+    amxc_var_copy(&data_copy, data);
+    amxd_object_trigger_signal(event_obj, event_name.c_str(), &data_copy);
+    amxc_var_clean(&data_copy);
 
     LOG(DEBUG) << "Triggered event '" << event_name << "' with data at '" << object_path << "'";
+
+#ifdef ENABLE_MQTT_DM
+    dm_publish_mqtt_event(object_path, data);
+#endif // ENABLE_MQTT_DM
+
+    return true;
+}
+
+#ifdef ENABLE_MQTT_DM
+void AmbiorixImpl::dm_publish_mqtt_event(const std::string &object_path, void *event_data)
+{
+    if (m_mqtt_event_publisher) {
+        std::string topic = object_path;
+        std::replace(topic.begin(), topic.end(), '.', '/');
+
+        amxc_var_t *var = static_cast<amxc_var_t *>(event_data);
+        amxc_var_t json_var;
+        amxc_var_init(&json_var);
+        amxc_var_copy(&json_var, var);
+
+        bool ok = (amxc_var_cast(&json_var, AMXC_VAR_ID_JSON) == 0);
+        std::string json_data;
+        if (ok) {
+            const char *json_cstr = amxc_var_constcast(jstring_t, &json_var);
+            ok                    = (json_cstr != nullptr);
+            if (ok) {
+                json_data = json_cstr;
+            }
+        }
+        amxc_var_clean(&json_var);
+
+        if (ok) {
+            m_mqtt_event_publisher(topic, json_data);
+        } else {
+            LOG(ERROR) << "dm_publish_mqtt_event: failed to convert event data to JSON for "
+                      << object_path;
+        }
+    }
+}
+
+void AmbiorixImpl::set_mqtt_event_publisher(MqttEventPublisher mqtt_event_publisher)
+{
+    m_mqtt_event_publisher = std::move(mqtt_event_publisher);
+}
+#endif // ENABLE_MQTT_DM
+
+bool AmbiorixImpl::get_object_data(const std::string &object_path, int32_t depth, void *result)
+{
+    if (!result) {
+        LOG(ERROR) << "Result variant is null";
+        return false;
+    }
+
+    // Cast void* to amxc_var_t*
+    amxc_var_t *result_var = static_cast<amxc_var_t *>(result);
+
+    // Initialize result variant
+    amxc_var_init(result_var);
+
+    // Use amxb_get to get actual parameter values (not metadata)
+    // This uses the bus API which returns values in the format similar to ubus-cli
+    // Convert depth: -1 (unlimited) to UINT32_MAX for bus API
+    uint32_t bus_depth = (depth < 0) ? UINT32_MAX : static_cast<uint32_t>(depth);
+    
+    int status = amxb_get(m_bus_ctx_vect[0], object_path.c_str(), bus_depth, result_var, 5);
+    if (status != 0) {
+        LOG(ERROR) << "Failed to get object values for: " << object_path 
+                   << ", status: " << status;
+        amxc_var_clean(result_var);
+        return false;
+    }
+
+    LOG(DEBUG) << "Successfully retrieved object values for: " << object_path
+               << " with depth: " << depth;
+    return true;
+}
+
+bool AmbiorixImpl::get_object_data_json(const std::string &object_path, int32_t depth,
+                                        std::string &json_result)
+{
+    amxc_var_t result;
+
+    bool success = get_object_data(object_path, depth, &result);
+    if (success) {
+        success = (amxc_var_cast(&result, AMXC_VAR_ID_JSON) == 0);
+        if (success) {
+            const char *json_cstr = amxc_var_constcast(jstring_t, &result);
+            success               = (json_cstr != nullptr);
+            if (success) {
+                json_result = json_cstr;
+            }
+        } else {
+            LOG(ERROR) << "get_object_data_json: failed to convert variant to JSON for "
+                       << object_path;
+        }
+        amxc_var_clean(&result);
+    }
+
+    return success;
+}
+
+bool AmbiorixImpl::invoke_function(const std::string &object_path, const std::string &method,
+                                   const std::map<std::string, std::string> &args,
+                                   std::string *result)
+{
+    amxd_object_t *object = find_object(object_path);
+    if (!object) {
+        LOG(ERROR) << "Failed to find object for invoke: " << object_path;
+        return false;
+    }
+
+    amxc_var_t args_var;
+    amxc_var_init(&args_var);
+    amxc_var_set_type(&args_var, AMXC_VAR_ID_HTABLE);
+    for (const auto &arg : args) {
+        amxc_var_add_new_key_cstring_t(&args_var, arg.first.c_str(), arg.second.c_str());
+    }
+
+    amxc_var_t ret_var;
+    amxc_var_init(&ret_var);
+
+    amxd_status_t status =
+        amxd_object_invoke_function(object, method.c_str(), &args_var, &ret_var);
+
+    amxc_var_clean(&args_var);
+
+    if (status != amxd_status_ok) {
+        LOG(ERROR) << "Failed to invoke function [" << method << "] on " << object_path
+                   << ", status: " << amxd_status_string(status);
+        amxc_var_clean(&ret_var);
+        return false;
+    }
+
+    if (result) {
+        amxc_var_cast(&ret_var, AMXC_VAR_ID_JSON);
+        const char *json_cstr = amxc_var_constcast(jstring_t, &ret_var);
+        if (json_cstr) {
+            *result = json_cstr;
+        }
+    }
+
+    amxc_var_clean(&ret_var);
+
+    LOG(DEBUG) << "Successfully invoked function [" << method << "] on " << object_path;
     return true;
 }
 
