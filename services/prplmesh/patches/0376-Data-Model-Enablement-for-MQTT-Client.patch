diff --git a/framework/platform/nbapi/include/mqtt_nbapi_impl.h b/framework/platform/nbapi/include/mqtt_nbapi_impl.h
new file mode 100644
index 000000000..c733600e7
--- /dev/null
+++ b/framework/platform/nbapi/include/mqtt_nbapi_impl.h
@@ -0,0 +1,193 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _MQTT_NBAPI_IMPL_H_
+#define _MQTT_NBAPI_IMPL_H_
+
+#include <mqtt_client.h>
+/*
+ * Forward declaration to avoid hard dependency on controller headers here.
+ * The concrete Ambiorix interface is provided by the controller (db.cpp).
+ */
+namespace beerocks { 
+namespace nbapi { class Ambiorix; }
+class EventLoop;
+}
+#include <string>
+#include <memory>
+
+#define MQTT_DEFAULT_BROKER_ADDRESS "tcp://localhost:1883"
+#define MQTT_DEFAULT_CLIENT_ID "prplmesh_controller"
+
+namespace beerocks {
+namespace nbapi {
+
+/**
+ * @brief MQTT Handler for processing data model requests
+ * 
+ * This class handles incoming MQTT messages on data model paths and responds
+ * with data fetched from the Ambiorix data model.
+ * 
+ * Supported operations:
+ * - GET: Retrieve value from data model path
+ * - RESOLVE: Resolve instance index from MAC address (Key)
+ * - SET: Set value in data model
+ * - CMD: Execute command on data model object
+ */
+class MqttNbapiImpl {
+public:
+    /**
+     * @brief Constructor
+     * @param amx_client Shared pointer to Ambiorix client (controller's existing client)
+     * @param event_loop Shared pointer to event loop for FD registration
+     */
+    MqttNbapiImpl(std::shared_ptr<beerocks::nbapi::Ambiorix> amx_client,
+                std::shared_ptr<beerocks::EventLoop> event_loop);
+
+    /**
+     * @brief Destructor
+     */
+    ~MqttNbapiImpl();
+
+    /**
+     * @brief Initialize the MQTT handler and connect to broker
+     * @param broker_address MQTT broker address (e.g., "tcp://localhost:1883")
+     * @param client_id MQTT client ID (default: "prplmesh_controller")
+     * @return true on success, false on failure
+     */
+    bool init(const std::string &broker_address = MQTT_DEFAULT_BROKER_ADDRESS,
+              const std::string &client_id = MQTT_DEFAULT_CLIENT_ID);
+
+    /**
+     * @brief Publish a data model event notification to MQTT subscribers.
+     *
+     * Used by the data model (e.g. controller's db) to push EVENT notifications
+     * for data model changes that AMX subscribers already receive via
+     * Ambiorix::trigger_event_with_data(), mirroring the same notification over MQTT.
+     *
+     * @param topic MQTT topic to publish on, e.g.
+     *   "Device/WiFi/DataElements/Network/Device/1/Disconnected"
+     * @param json_data JSON-encoded event data (the "data" field of the EVENT payload)
+     * @return true on success, false otherwise (e.g. not connected)
+     */
+    bool publish_event(const std::string &topic, const std::string &json_data);
+
+    /**
+     * @brief Get the MQTT socket file descriptor
+     * @return Socket FD, or -1 if not connected
+     */
+    int get_fd() const;
+
+    /**
+     * @brief Process events on the MQTT socket (called when FD is readable)
+     * @param fd File descriptor that has events
+     * @return true if this was the MQTT FD and was processed, false otherwise
+     */
+    bool process_mqtt_events(int fd);
+
+    /**
+     * @brief Run the MQTT event loop (should be called periodically, e.g., every 1 second)
+     * This handles keepalive and reconnection logic
+     */
+    void run_loop();
+
+    /**
+     * @brief Shutdown the MQTT handler and disconnect from broker
+     */
+    void shutdown();
+
+    /**
+     * @brief Register MQTT FD with event loop
+     * This method should be called by the MQTT client when the socket is ready
+     * @param fd File descriptor to register
+     */
+    void register_mqtt_fd(int fd);
+
+    /**
+     * @brief Unregister MQTT FD from event loop
+     * This method should be called by the MQTT client when the socket is closed
+     * @param fd File descriptor to unregister
+     */
+    void unregister_mqtt_fd(int fd);
+
+private:
+    /**
+     * @brief Handle incoming MQTT message
+     */
+    void handle_message(const char *topic, const void *payload, int payloadlen);
+
+    /**
+     * @brief Handle GET request
+     * Request: {"op":"GET","result_path":"APP/thread_id/GET_RESP"}
+     * Response: {"path":"Device/WiFi/.../ID","status":"OK","data":"00:11:22:33:44:55"}
+     */
+    void handle_get(const std::string &path, const std::string &result_path);
+
+    /**
+     * @brief Handle RESOLVE request
+     * Request: {"op":"RESOLVE","Key":"00:11:22:33:44:55","result_path":"APP/thread_id/RESOLVE_RESP"}
+     * Response: {"path":"Device/WiFi/.../Device","Key":"00:11:22:33:44:55","status":"OK","data":"1"}
+     */
+    void handle_resolve(const std::string &path, const std::string &key,
+                        const std::string &result_path);
+
+    /**
+     * @brief Handle SET request
+     * Request: {"op":"SET","data":"{\"ID\":\"00:11:22:33:44:66\"}","result_path":"APP/thread_id/SET_RESP"}
+     * Response: {"path":"Device/WiFi/.../Device/1", "status":"OK"}
+     */
+    void handle_set(const std::string &path, const std::string &data,
+                    const std::string &result_path);
+
+    /**
+     * @brief Handle CMD request
+     * Invokes the named data model RPC function on the object at path with the
+     * given arguments (equivalent to `ubus call <path> <cmd> <args>`).
+     * Request: {"op":"CMD","cmd":"Disconnect","args":"{\"reason\":\"0x0021\"}","result_path":"APP/thread_id/CMD_RESP"}
+     * Response: {"path":"Device/WiFi/.../Device/1","cmd":"Disconnect","status":"OK"}
+     */
+    void handle_cmd(const std::string &path, const std::string &cmd, const std::string &args,
+                    const std::string &result_path);
+
+    /**
+     * @brief Publish response to result_path
+     */
+    void publish_response(const std::string &result_path, const std::string &payload);
+
+    /**
+     * @brief Parse JSON payload
+     */
+    bool parse_payload(const std::string &payload, std::string &op, std::string &key,
+                       std::string &data, std::string &cmd, std::string &args,
+                       std::string &result_path);
+
+    /**
+     * @brief Build JSON response. Every response carries a "status" field ("OK" or "FAIL")
+     * so the (blocking) requester always knows whether its request was serviced.
+     */
+    std::string build_get_response(const std::string &path, const std::string &status,
+                                   const std::string &data = "");
+    std::string build_resolve_response(const std::string &path, const std::string &key,
+                                       const std::string &status, const std::string &data = "");
+    std::string build_set_response(const std::string &path, const std::string &status);
+    std::string build_cmd_response(const std::string &path, const std::string &cmd,
+                                   const std::string &status, const std::string &result = "");
+
+    /**
+     * @brief Build a minimal {"path","status"} response for requests that couldn't be
+     * matched to a specific op (unknown/missing op, unparseable request), so that a
+     * response is still sent whenever a result_path is known.
+     */
+    std::string build_error_response(const std::string &path, const std::string &status);
+
+    std::shared_ptr<beerocks::mqttapi::MQTTClient> m_mqtt_client;
+    std::shared_ptr<beerocks::nbapi::Ambiorix> m_amx_client;
+    std::shared_ptr<beerocks::EventLoop> m_event_loop;
+    bool m_initialized;
+};
+
+} // namespace nbapi
+} // namespace beerocks
+
