From d48dd61eaf9aa85df5bf7960418856301ec02448 Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Tue, 14 Jul 2026 11:09:50 +0530
Subject: [PATCH] Data Model Enablement for MQTT Client

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 CMakeLists.txt                                |   1 +
 controller/src/beerocks/master/CMakeLists.txt |   8 +-
 .../beerocks/master/beerocks_master_main.cpp  |  29 +
 controller/src/beerocks/master/db/db.cpp      | 784 ++++++++----------
 controller/src/beerocks/master/db/db.h        |   1 +
 framework/platform/CMakeLists.txt             |   9 +-
 .../platform/mqttapi/include/mqtt_client.h    |   3 +-
 .../mqttapi/include/mqtt_client_impl.h        |   3 +
 .../platform/mqttapi/mqtt_client_impl.cpp     |  58 +-
 framework/platform/nbapi/CMakeLists.txt       |   9 +-
 framework/platform/nbapi/ambiorix_dummy.cpp   |  19 +
 framework/platform/nbapi/ambiorix_impl.cpp    | 161 +++-
 framework/platform/nbapi/include/ambiorix.h   |  48 ++
 .../platform/nbapi/include/ambiorix_dummy.h   |   9 +
 .../platform/nbapi/include/ambiorix_impl.h    |  55 ++
 .../platform/nbapi/include/ambiorix_mock.h    |  12 +
 .../platform/nbapi/include/mqtt_nbapi_impl.h  | 193 +++++
 framework/platform/nbapi/mqtt_nbapi_impl.cpp  | 591 +++++++++++++
 18 files changed, 1533 insertions(+), 460 deletions(-)
 create mode 100644 framework/platform/nbapi/include/mqtt_nbapi_impl.h
 create mode 100644 framework/platform/nbapi/mqtt_nbapi_impl.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b8d08df79..f62187cc6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -77,6 +77,7 @@ option (BUILD_CONTROLLER "Build EasyMesh controller" ON)
 option(BUILD_SHARED_LIBS "Build shared libraries (.so) instead of static ones (.a)" ON)
 option (ENABLE_NBAPI "Build the northbound (high-level) API" ON)
 option (ENABLE_VBSS "Build with Virtual BSS support" ON)
+option (ENABLE_MQTT_DM "Enable the MQTT data model bridge (GET/SET/RESOLVE/CMD/EVENT over MQTT)" OFF)
 
 ## Generic checks and defaults
 
diff --git a/controller/src/beerocks/master/CMakeLists.txt b/controller/src/beerocks/master/CMakeLists.txt
index 4dd0a464f..c12905c7a 100644
--- a/controller/src/beerocks/master/CMakeLists.txt
+++ b/controller/src/beerocks/master/CMakeLists.txt
@@ -50,8 +50,14 @@ if (ENABLE_NBAPI OR USE_PRPLMESH_WHM)
     find_package(amxd REQUIRED)
     find_package(amxo REQUIRED)
     find_package(amxp REQUIRED)
+    find_package(amxj REQUIRED)
     find_package(libamxrt REQUIRED)
-    list(APPEND LINKED_LIBS amxc amxd amxo amxp libamxrt)
+    list(APPEND LINKED_LIBS amxc amxd amxo amxp amxj libamxrt)
+endif()
+
+if (ENABLE_NBAPI AND ENABLE_MQTT_DM AND NOT TARGET_PLATFORM STREQUAL "rdkb")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DENABLE_MQTT_DM")
+    list(APPEND LINKED_LIBS mqttapi)
 endif()
 
 if (USE_PRPLMESH_WHM)
diff --git a/controller/src/beerocks/master/beerocks_master_main.cpp b/controller/src/beerocks/master/beerocks_master_main.cpp
index 380d5ceac..f6b0f9a40 100644
--- a/controller/src/beerocks/master/beerocks_master_main.cpp
+++ b/controller/src/beerocks/master/beerocks_master_main.cpp
@@ -47,6 +47,10 @@ static std::shared_ptr<beerocks::nbapi::Amxrt> guarantee = nullptr;
 #include "ambiorix_impl.h"
 #include "on_action.h"
 
+#ifdef ENABLE_MQTT_DM
+#include <mqtt_nbapi_impl.h>
+#endif //ENABLE_MQTT_DM
+
 #ifndef CONTROLLER_DATAMODEL_PATH
 #define CONTROLLER_DATAMODEL_PATH "config/controller/odl/master_config.odl"
 #endif
@@ -839,6 +843,31 @@ int main(int argc, char *argv[])
     LOG_IF(!amb_dm_obj, FATAL) << "Unable to create Ambiorix!";
 
     LOG_IF(!amb_dm_obj->init(controller_dm_path), FATAL) << "Unable to init ambiorix object!";
+
+#ifdef ENABLE_MQTT_DM
+    // Create MQTT handler with event loop - FD registration is handled internally
+    auto mqtt_handler = std::make_shared<beerocks::nbapi::MqttNbapiImpl>(amb_dm_obj, event_loop);
+
+    // Initialize MQTT handler (creates client, connects to broker, subscribes to topics)
+    LOG_IF(!mqtt_handler->init(MQTT_DEFAULT_BROKER_ADDRESS, "beerocks_controller"), FATAL)
+        << "Failed to initialize MQTT handler!";
+
+    // Mirror every triggered data model event to MQTT subscribers as well.
+    amb_dm_obj->set_mqtt_event_publisher(
+        [mqtt_handler](const std::string &topic, const std::string &json_data) {
+            return mqtt_handler->publish_event(topic, json_data);
+        });
+
+    // Add timer to call run_loop() periodically for keepalive and reconnection
+    auto mqtt_run_loop_timer = timer_manager->add_timer(
+        "MQTT Handler", std::chrono::milliseconds(1000), std::chrono::milliseconds(1000),
+        [mqtt_handler](int fd, beerocks::EventLoop &loop) {
+            mqtt_handler->run_loop();
+            return true;
+        });
+    LOG_IF(mqtt_run_loop_timer == beerocks::net::FileDescriptor::invalid_descriptor, ERROR)
+        << "Failed to add MQTT handler run_loop timer!";
+#endif //ENABLE_MQTT_DM
 #else
     auto amb_dm_obj = std::make_shared<beerocks::nbapi::AmbiorixDummy>();
 #endif //ENABLE_NBAPI
