+void MqttNbapiImpl::register_mqtt_fd(int fd)
+{
+    LOG(DEBUG) << "Registering MQTT FD: " << fd;
+    
+    if (!m_event_loop) {
+        LOG(ERROR) << "Event loop is null, cannot register MQTT FD";
+        return;
+    }
+
+    // Register event handlers for the MQTT socket FD
+    beerocks::EventLoop::EventHandlers handlers{
+        .name = "mqtt_handler",
+        .on_read =
+            [this](int fd, beerocks::EventLoop &loop) {
+                if (!this->process_mqtt_events(fd)) {
+                    LOG(ERROR) << "Failed to process MQTT events on FD: " << fd;
+                    return false;
+                }
+                return true;
+            },
+        .on_write      = nullptr,
+        .on_disconnect =
+            [this](int fd, beerocks::EventLoop &loop) {
+                LOG(WARNING) << "MQTT socket disconnected, FD: " << fd;
+                if (m_mqtt_client) {
+                    m_mqtt_client->reconnect();
+                }
+                return true;
+            },
+        .on_error =
+            [](int fd, beerocks::EventLoop &loop) {
+                LOG(ERROR) << "Error on MQTT socket, FD: " << fd;
+                return true;
+            },
+    };
+
+    if (!m_event_loop->register_handlers(fd, handlers)) {
+        LOG(ERROR) << "Failed to register event handlers for MQTT FD: " << fd;
+    } else {
+        LOG(INFO) << "Successfully registered MQTT FD: " << fd;
+    }
+}
+
+void MqttNbapiImpl::unregister_mqtt_fd(int fd)
+{
+    LOG(DEBUG) << "Unregistering MQTT FD: " << fd;
+    
+    if (!m_event_loop) {
+        LOG(ERROR) << "Event loop is null, cannot unregister MQTT FD";
+        return;
+    }
+
+    m_event_loop->remove_handlers(fd);
+    LOG(INFO) << "Successfully unregistered MQTT FD: " << fd;
+}
