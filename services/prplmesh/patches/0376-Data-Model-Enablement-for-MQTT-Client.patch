+std::string MqttNbapiImpl::build_set_response(const std::string &path, const std::string &status)
+{
+    struct json_object *root = json_object_new_object();
+    json_object_object_add(root, "path", json_object_new_string(path.c_str()));
+    json_object_object_add(root, "status", json_object_new_string(status.c_str()));
+
+    const char *json_str = json_object_to_json_string(root);
+    std::string result(json_str);
+    json_object_put(root);
+    return result;
+}
+
+std::string MqttNbapiImpl::build_cmd_response(const std::string &path, const std::string &cmd,
+                                            const std::string &status, const std::string &result)
+{
+    struct json_object *root = json_object_new_object();
+    json_object_object_add(root, "path", json_object_new_string(path.c_str()));
+    json_object_object_add(root, "cmd", json_object_new_string(cmd.c_str()));
+    json_object_object_add(root, "status", json_object_new_string(status.c_str()));
+    if (!result.empty()) {
+        json_object_object_add(root, "result", json_object_new_string(result.c_str()));
+    }
+
+    const char *json_str = json_object_to_json_string(root);
+    std::string response(json_str);
+    json_object_put(root);
+    return response;
+}
