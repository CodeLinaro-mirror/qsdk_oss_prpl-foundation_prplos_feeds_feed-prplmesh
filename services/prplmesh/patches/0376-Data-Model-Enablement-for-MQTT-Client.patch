+bool MqttNbapiImpl::parse_payload(const std::string &payload, std::string &op, std::string &key,
+                                std::string &data, std::string &cmd, std::string &args,
+                                std::string &result_path)
+{
+    struct json_object *root = json_tokener_parse(payload.c_str());
+    if (!root) {
+        LOG(ERROR) << "Failed to parse JSON payload";
+        return false;
+    }
+
+    bool success = true;
+
+    // Parse op
+    struct json_object *op_obj = nullptr;
+    if (json_object_object_get_ex(root, "op", &op_obj)) {
+        op = json_object_get_string(op_obj);
+    } else {
+        LOG(ERROR) << "Missing 'op' field";
+        success = false;
+    }
+
+    // drop EVENT messages
+    if (op == "EVENT") {
+        json_object_put(root);
+        return success;
+    }
+
+    // Parse Key (optional, for RESOLVE)
+    struct json_object *key_obj = nullptr;
+    if (json_object_object_get_ex(root, "Key", &key_obj)) {
+        key = json_object_get_string(key_obj);
+    }
+
+    // Parse data (optional, for SET)
+    struct json_object *data_obj = nullptr;
+    if (json_object_object_get_ex(root, "data", &data_obj)) {
+        data = json_object_get_string(data_obj);
+    }
+
+    // Parse cmd (optional, for CMD)
+    struct json_object *cmd_obj = nullptr;
+    if (json_object_object_get_ex(root, "cmd", &cmd_obj)) {
+        cmd = json_object_get_string(cmd_obj);
+    }
+
+    // Parse args (optional, for CMD)
+    struct json_object *args_obj = nullptr;
+    if (json_object_object_get_ex(root, "args", &args_obj)) {
+        args = json_object_get_string(args_obj);
+    }
+
+    // Parse result_path
+    struct json_object *result_path_obj = nullptr;
+    if (json_object_object_get_ex(root, "result_path", &result_path_obj)) {
+        result_path = json_object_get_string(result_path_obj);
+    } else {
+        LOG(ERROR) << "Missing 'result_path' field";
+        success = false;
+    }
+
+    json_object_put(root);
+    return success;
+}
+
+std::string MqttNbapiImpl::build_get_response(const std::string &path, const std::string &status,
+                                            const std::string &data)
+{
+    struct json_object *root = json_object_new_object();
+    json_object_object_add(root, "path", json_object_new_string(path.c_str()));
+    json_object_object_add(root, "status", json_object_new_string(status.c_str()));
+    json_object_object_add(root, "data", json_object_new_string(data.c_str()));
+
+    const char *json_str = json_object_to_json_string(root);
+    std::string result(json_str);
+    json_object_put(root);
+    return result;
+}
