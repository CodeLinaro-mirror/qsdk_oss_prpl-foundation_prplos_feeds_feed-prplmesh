+            // the already-selected one, so the anchor link's own reconnect/roam events
+            // (which go through the branch above) cannot retrigger this path.
+            auto msg = static_cast<bwl::sACTION_BACKHAUL_CONNECTED_NOTIFICATION *>(data);
+            if (msg && msg->multi_ap_primary_vlan_id != 0 &&
+                db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
+                iface != db->backhaul.selected_iface_name &&
+                db->traffic_separation.primary_vlan_id != msg->multi_ap_primary_vlan_id) {
+                LOG(INFO) << "MLO: updating primary_vlan_id "
+                          << db->traffic_separation.primary_vlan_id << " -> "
+                          << msg->multi_ap_primary_vlan_id << " from iface=" << iface;
+                db->traffic_separation.primary_vlan_id = msg->multi_ap_primary_vlan_id;
+                // bsta_mld_configuration isn't available yet, so record this interface
+                // as the trunk port for traffic_separation_task to use.
+                db->backhaul.mlo_primary_bsta_iface = iface;
+                auto request = message_com::create_vs_message<
+                    beerocks_message::cACTION_BACKHAUL_APPLY_VLAN_POLICY_REQUEST>(cmdu_tx);
