@@ -3161,6 +3165,25 @@ void slave_thread::retrigger_wds_ts(AgentDB::sRadio &radio,
     }
 }
 
+bool slave_thread::is_ap_mld_operationally_up(const sMacAddr &ap_mld_mac) const
+{
+    auto db = AgentDB::get();
+    for (const auto *radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+        for (const auto &bss : radio->front.bssids) {
+            if (bss.apmld_mac != ap_mld_mac || bss.iface_name.empty()) {
+                continue;
+            }
+            if (net::network_utils::linux_iface_is_up_and_running(bss.iface_name)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
