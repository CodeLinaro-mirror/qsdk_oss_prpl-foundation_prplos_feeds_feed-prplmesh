                 beerocks_message::cACTION_BACKHAUL_APPLY_VLAN_POLICY_REQUEST>(cmdu_tx);
-
-            // Send the message to one of the son_slaves.
-            send_cmdu(m_agent_fd, cmdu_tx);
+            if (!request) {
