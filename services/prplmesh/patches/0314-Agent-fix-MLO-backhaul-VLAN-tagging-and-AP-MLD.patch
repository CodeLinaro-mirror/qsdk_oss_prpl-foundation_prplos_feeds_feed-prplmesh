+uint16_t sta_wlan_hal_whm::get_multi_ap_primary_vlan_id()
+{
+    // Read the endpoint status to obtain MultiAPVlanId without pushing any
+    // event.  In MLO mode only the anchor link endpoint has this field set;
+    // secondary per-link interfaces return 0.
+    Endpoint endpoint;
+    if (read_status(endpoint)) {
+        return endpoint.multi_ap_primary_vlanid;
+    }
+    return 0;
+}
