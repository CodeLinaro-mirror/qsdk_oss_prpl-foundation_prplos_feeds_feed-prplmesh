From 69953ab347f9d9cb7326fd3f953d370c6c0d1714 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Fri, 2 Oct 2026 12:03:12 +0530
Subject: [PATCH] CERT: Fix Max Affiliated Links for R6.1

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../src/beerocks/slave/tasks/capability_reporting_task.cpp  | 6 ++++--
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp         | 6 +++++-
 controller/src/beerocks/master/controller.cpp               | 4 ++--
 3 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
index 5f59aa2..8c99010 100644
--- a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
+++ b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
@@ -427,8 +427,10 @@ bool CapabilityReportingTask::add_wifi7_agent_capabilities_tlv(ieee1905_1::CmduM
     // Hard-coded for now, may be specified somehwere in the DM
     wifi7_agent_capabilities_tlv->max_num_mlds() = db->device_conf.max_num_mlds;
 
-    wifi7_agent_capabilities_tlv->flags1().ap_maximum_links   = db->device_conf.ap_maximum_links;
-    wifi7_agent_capabilities_tlv->flags1().bsta_maximum_links = db->device_conf.bsta_maximum_links;
+    // EasyMesh R6 Table 118: AP_Maximum_Links/bSTA_Maximum_Links on the wire are the
+    // number of affiliated links minus 1 (0-14, 15 reserved).
+    wifi7_agent_capabilities_tlv->flags1().ap_maximum_links   = db->device_conf.ap_maximum_links - 1;
+    wifi7_agent_capabilities_tlv->flags1().bsta_maximum_links = db->device_conf.bsta_maximum_links - 1;
     wifi7_agent_capabilities_tlv->flags2().tid_to_link_mapping_capability = 0;
 
     LOG(DEBUG) << "Max AP MLD Links " << wifi7_agent_capabilities_tlv->flags1().ap_maximum_links
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 56beecb..b665ec8 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1933,7 +1933,11 @@ static bool assign_auth_encr_parameters(prplmesh::hostapd::Configuration &conf,
                        << " freq_band=" << int(bss.freq_band);
             wpa = 0x2;
             wpa_key_mgmt.assign("SAE SAE-EXT-KEY");
-            wpa_pairwise.assign("CCMP");
+            // SAE-EXT-KEY (AKM24) is the GCMP-256 suite, so the pairwise set must offer
+            // GCMP-256 alongside CCMP for plain SAE (AKM8). Same set as the WPA2-PSK variant
+            // of this transition mode above; without GCMP-256 an AKM24 STA is rejected with
+            // status 42 (Invalid pairwise cipher).
+            wpa_pairwise.assign("GCMP CCMP GCMP-256");
 
             if (bss.encryption_type != WSC::eWscEncr::WSC_ENCR_AES) {
                 LOG(ERROR) << "Autoconfiguration: " << vap_id << " CCMP(AES) is required for WPA3";
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 62546d3..199fa10 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -2164,9 +2164,9 @@ static bool add_agent_ap_mld_configuration_tlv(db &database, ieee1905_1::CmduMes
                         continue;
                     }
 
-                    if (ap_mld->num_affiliated_ap() >= (agent.ap_maximum_links)) {
+                    if (ap_mld->num_affiliated_ap() >= (agent.ap_maximum_links + 1)) {
                         LOG(ERROR) << "More Affiliated APs than  maximum links available ("
-                                   << (agent.ap_maximum_links) << ")";
+                                   << (agent.ap_maximum_links + 1) << ")";
                         break;
                     }
                     LOG(INFO) << "Adding radio " << affiliated_radio.first
-- 
2.34.1

