+bool DppKeyStore::write_dpp_uris(const std::vector<std::string> &uris) const
+{
+    constexpr const char *uris_file = "/etc/prplmesh/dpp_uri";
+
+    if (uris.empty()) {
+        // An empty list here is indistinguishable from "the ProvisionDPP table hasn't
+        // finished (re)loading yet" (e.g. right after a datamodel restore, an instance can
+        // be signalled before its persisted DPPURI value is reapplied to it) vs. "the user
+        // genuinely removed the last entry". Refuse to destructively truncate a mirror file
+        // that still holds previously-persisted URIs; only allow it if the file is already
+        // empty/missing, so this call stays a harmless no-op in the startup-race case.
+        if (!load_string(uris_file).empty()) {
+            MAPF_WARN("DppKeyStore: refusing to clear non-empty " << uris_file
+                                                                   << " with an empty URI list");
+            return false;
+        }
+        return true;
+    }
+
+    std::ofstream out(uris_file, std::ios::trunc);
+    if (!out.good()) {
+        MAPF_ERR("DppKeyStore: failed to open " << uris_file << " for write");
+        return false;
+    }
+    for (const auto &uri : uris) {
+        out << uri << "\n";
+    }
+    return out.good();
+}
