+
+#ifndef _BPL_RUNNING_MODE_H_
+#define _BPL_RUNNING_MODE_H_
+
+#include <stdint.h>
+
+namespace beerocks {
+namespace bpl {
+
+/**
+ * @brief Identifies which beerocks executable (process) this BPL instance is
+ * linked into. Unlike cfg_is_master(), which reflects the configured
+ * management mode (e.g. whether a controller is co-located), this reflects
+ * the literal identity of the running binary and is set exactly once, at
+ * process startup, in each executable's main().
+ */
+// enum auto-print skip
+enum class eRunningMode : uint8_t {
+    NONE,       /**< Not yet set. */
+    AGENT,      /**< Running inside the beerocks_agent process. */
+    CONTROLLER, /**< Running inside the beerocks_controller process. */
+};
+
+/**
+ * @brief Set the running mode of this process. Must be called exactly once,
+ * early in main(), before any code that depends on get_running_mode() runs.
+ *
+ * @param [in] mode eRunningMode::AGENT or eRunningMode::CONTROLLER.
+ */
+void set_running_mode(eRunningMode mode);
+
+/**
+ * @brief Get the running mode of this process, as set by set_running_mode().
+ *
+ * @return eRunningMode::NONE if set_running_mode() has not been called yet.
+ */
+eRunningMode get_running_mode();
+
+} // namespace bpl
+} // namespace beerocks
+
+#endif /* _BPL_RUNNING_MODE_H_ */
