From 053fef740833f23fc0a6a80ab1f1adb3bd3df5e6 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:20:46 +0530
Subject: [PATCH 24/31] Autoconfig renew using stop_mld and hostapd_file change

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 51 ++++++++++++++-----
 .../beerocks/hostapd/source/configuration.cpp | 17 +++++--
 2 files changed, 53 insertions(+), 15 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 72366d374..b97d819d9 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -215,19 +215,10 @@ prplmesh::hostapd::Configuration ap_wlan_hal_nl80211::load_hostapd_config(const
     // TODO: PRPLMESH_NLHAL To be replaced hostapd.conf selection logic
 
     int link_id;
-    int radio_idx = -1;
     std::string base_interface="";
     if (!radio_iface_name.empty()) {
         extractLinkBaseInterface(radio_iface_name, base_interface);
         extractLinkId(radio_iface_name, link_id);
-
-	if (link_id != -1) {
-        //deriving radio_idx here is just for sanity now and is not used really in below logics
-	    radio_idx = getRadioIdxFromLinkId(base_interface, link_id);
-	    if (radio_idx == -1) {
-		return prplmesh::hostapd::Configuration("radio_idx not found");
-	    }
-	}
     }
 
     std::vector<std::string> hostapd_cfg_names;
@@ -1489,16 +1480,52 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     if (bss_name_changed == true) {
                         add_mld_link(bss,vap_info.bss,bss_it,bridge_ifname);
                     } else {
-                        const std::string cmd("STOP_AP");
-                        if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
-                            LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
+                        parsed_obj_map_t result;
+
+                        if (!wpa_ctrl_send_msg("STATUS", result, vap_info.bss)) {
+                            LOG(ERROR) << __func__ << " failed";
+                            LOG(ERROR) << "wpa_ctrl_send_msg returned false for STATUS command";
                             continue;
                         }
+                        int links_present = 0;
+                        
+                        auto it = result.find("num_links");
+                        if (it != result.end() && !it->second.empty()) {
+                            const std::string &num_links_str = it->second;
+                            bool valid = std::all_of(num_links_str.begin(), num_links_str.end(), ::isdigit);
+
+                            if (valid) {
+                                LOG(INFO) << "num_links found";
+                                links_present = std::stoi(num_links_str);
+                            } else {
+                                LOG(WARNING) << "num_links value is not a valid number: '" << num_links_str << "'";
+                            }
+                        } else {
+                            LOG(WARNING) << "num_links not found or empty in result";
+                        }
+
+                        if(links_present > 1 && links_present <= 4)
+                        {
+                            const std::string cmd("STOP_MLD");
+                            if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
+                                LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
+                                continue;
+                            }
+                            LOG(INFO) << "STOP_MLD successful";
+                        } else {
+                            const std::string cmd("STOP_AP");
+                            if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
+                                LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
+                                continue;
+                            }
+                            LOG(INFO) << "STOP_AP successful";
+                        }
                         const std::string cmd_2("RELOAD_CONFIG");
                         if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
                             LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
                             continue;
                         }
+                        LOG(INFO) << "RELOAD_CONFIG successful";
                    }
                 }
                 LOG(DEBUG) << "Autoconfiguration: done:\n" << conf;
diff --git a/common/beerocks/hostapd/source/configuration.cpp b/common/beerocks/hostapd/source/configuration.cpp
index a743bd685..c8f61b2b9 100644
--- a/common/beerocks/hostapd/source/configuration.cpp
+++ b/common/beerocks/hostapd/source/configuration.cpp
@@ -275,10 +275,21 @@ bool Configuration::set_create_vap_value(const std::string &vap, const std::stri
 
     // when the new value is provided add the key back with that new value
     if (value.length() != 0) {
-        if (existing_vap_commented) {
-            existing_vap->push_back('#' + key_eq + value);
+        //Check if vap value being set is "interface" or "bss", if so then add it so that it gets inserted at the top
+        if (key == "interface" || key == "bss") {
+            LOG(DEBUG) << "Inserting key '" << key << "' at the beginning for vap: " << vap;
+            if (existing_vap_commented) {
+                existing_vap->insert(existing_vap->begin(), '#' + key_eq + value);
+            } else {
+                    existing_vap->insert(existing_vap->begin(), key_eq + value);
+            }
         } else {
-            existing_vap->push_back(key_eq + value);
+            LOG(DEBUG) << "Appending key '" << key << "' at the end for vap: " << vap;
+            if (existing_vap_commented) {
+                existing_vap->push_back('#' + key_eq + value);
+            } else {
+                existing_vap->push_back(key_eq + value);
+            }
         }
         m_last_message =
             std::string(__FUNCTION__) + " the key '" + key + "' for vap " + vap + " was (re)added";
-- 
2.34.1

