+void slave_thread::trigger_dpp_extender_bss_config_request(const sMacAddr &controller_mac)
+{
+    if (m_dpp_agent_task) {
+        m_dpp_agent_task->trigger_bss_config_request(controller_mac);
+    } else {
+        LOG(WARNING) << "DPP: DppAgentTask not available for BSS Config Request";
+    }
+}
