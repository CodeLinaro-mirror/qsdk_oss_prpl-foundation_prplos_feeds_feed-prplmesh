+    // =========================================================================
+    // 1905-Layer Security (DPP Profile-3)
+    // Per EasyMesh §5.3.7 and dpp_agent_1905_security_design.md
+    // =========================================================================
+
+    /**
+     * @brief Per-peer 1905-layer security state.
+     *
+     * Maintained for each peer Agent and the Controller after DPP onboarding.
+     * Populated during 1905 Network Introduction (Peer Discovery) and
+     * 1905 4-way handshake.
+     */
+    struct s1905PeerSecurity {
+        // Peer's Connector (JWS compact serialization, netRole="mapAgent")
+        std::string connector;
+
+        // Peer's netAccessKey (EC public key, extracted from Connector)
+        // Stored as DER-encoded SubjectPublicKeyInfo bytes
+        std::vector<uint8_t> nak_der;
+
+        // 1905 PMK (32 bytes, derived via ECDH + HKDF during Network Introduction)
+        std::array<uint8_t, 32> pmk_1905 = {};
+        bool pmk_valid = false;
+
+        // 1905 PTK (512-bit, derived during 4-way handshake)
+        std::array<uint8_t, 64> ptk_1905 = {};
+
+        // 1905 TK (256-bit = bytes 32-63 of PTK, used for AES-SIV encryption)
+        std::array<uint8_t, 32> tk_1905 = {};
+        bool tk_valid = false;
+
+        // 4-way handshake nonces
+        std::array<uint8_t, 32> a_nonce = {}; // ANonce (generated by Authenticator)
+        std::array<uint8_t, 32> s_nonce = {}; // SNonce (generated by Supplicant)
+        bool handshake_in_progress = false;
+
+        // Per-session EAPOL replay counter (Authenticator role: sent in M1/M3 and incremented;
+        // Supplicant role: read from received M1/M3 and echoed in M2/M4)
+        uint64_t replay_counter = 0;
+
+        // Encryption/decryption counters (48-bit, strictly increasing)
+        uint64_t enc_tx_counter    = 1;
+        uint64_t enc_rx_counter    = 0;
+        uint64_t int_rx_counter    = 0;
+        uint16_t decrypt_fail_count = 0;
+    };
+
+    /**
+     * @brief Map of per-peer 1905 security state.
+     * Key: peer AL MAC address (Controller or peer Agent)
+     * Uses unordered_map since sMacAddr has std::hash<sMacAddr> defined in tlvftypes.h
+     * but no operator< required by std::map.
+     */
+    std::unordered_map<sMacAddr, s1905PeerSecurity> peer_1905_security;
+
+    /**
+     * @brief Agent's own DPP credentials.
+     *
+     * Populated when the Agent receives the BSS Configuration Response
+     * containing the 1905-layer DPP Configuration Object
+     * (wi-fi_tech="map", cred.akm="dpp").
+     */
+    struct sDppCredentials {
+        // Agent's own Connector (JWS, netRole="mapAgent")
+        // Received in DPP Configuration Object (1905-layer config)
+        std::string connector;
+
+        // Agent's netAccessKey private key (EC P-256)
+        // This is the Enrollee's protocol key (pR) from DPP Authentication.
+        // nak_pkey: in-memory EVP_PKEY* (correct ECDH, primary path for Peer Discovery)
+        // nak_private_der: DER-encoded fallback (for compatibility with wireless path)
+        EVP_PKEY *nak_pkey = nullptr;
+        std::vector<uint8_t> nak_private_der;
+
+        // Configurator's C-sign-key (JWK JSON string, for Connector verification)
+        std::string c_sign_key_jwk;
+
+        // Configurator's Privacy-protection-key (JWK JSON string, for reconfiguration)
+        std::string pp_key_jwk;
+
+        // Decryption Failure Counter threshold (from DPP Config Object dfCounterThreshold)
+        uint16_t df_counter_threshold = 5;
+
+        bool initialized = false;
+
+        ~sDppCredentials() {
+            if (nak_pkey) { EVP_PKEY_free(nak_pkey); nak_pkey = nullptr; }
+        }
+        // Non-copyable — EVP_PKEY* ownership
+        sDppCredentials() = default;
+        sDppCredentials(const sDppCredentials &) = delete;
+        sDppCredentials &operator=(const sDppCredentials &) = delete;
+    } dpp_credentials;
+
+    /**
+     * @brief 1905 GTK (Group Temporal Key).
+     *
+     * Received from the Controller in EAPOL M3 during the 1905 4-way handshake.
+     * Used for HMAC-SHA256 MIC on multicast/relayed CMDUs.
+     * Also distributed to peer Agents when this Agent acts as Authenticator.
+     */
+    struct s1905Gtk {
+        std::array<uint8_t, 32> gtk = {};
+        uint8_t key_id              = 0;
+        bool valid                  = false;
+        uint64_t integrity_tx_counter = 1; // Strictly increasing TX counter for MIC
+        uint64_t integrity_rx_counter = 0; // Last received RX counter for MIC
+    } gtk_1905;
+
