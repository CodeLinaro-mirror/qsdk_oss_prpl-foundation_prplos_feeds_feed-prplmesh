+void ApAutoConfigurationTask::drain_pending_bss_config_send()
+{
+    if (m_pending_bss_config_sends.empty()) {
+        return;
+    }
+
+    if (m_bss_config_send_defer_armed &&
+        std::chrono::steady_clock::now() < m_bss_config_send_not_before) {
+        return;
+    }
+    m_bss_config_send_defer_armed = false;
+
+    const std::string radio_iface = m_pending_bss_config_send_order.front();
+    m_pending_bss_config_send_order.erase(m_pending_bss_config_send_order.begin());
+    auto queued_it                    = m_pending_bss_config_sends.find(radio_iface);
+    std::vector<sBssConfig> bss_infos = std::move(queued_it->second);
+    m_pending_bss_config_sends.erase(queued_it);
+
+    send_ap_bss_configuration_message(radio_iface, bss_infos);
+
+    auto db                                 = AgentDB::get();
+    db->dpp_extender_config.bss_config_sent = true;
+
+    LOG(INFO) << "DPP: sent BSS config to ap_manager for " << radio_iface << " — "
+              << bss_infos.size() << " VAP(s) configured";
+
+    // Radio is already in WAIT_AP_CONFIGURATION_COMPLETE except in NOT_MULTIAP mode,
+    // where it can only move to CONFIGURED now that the send has actually happened.
+    if (db->device_conf.management_mode == BPL_MGMT_MODE_NOT_MULTIAP) {
+        FSM_MOVE_STATE(radio_iface, eState::CONFIGURED);
+    }
+
+    // Stagger the next send so this radio's hostapd interface create/teardown has
+    // time to finish before the next radio's credentials are pushed.
+    m_bss_config_send_defer_armed = true;
+    m_bss_config_send_not_before =
+        std::chrono::steady_clock::now() + BSS_CONFIG_SEND_STAGGER_DELAY;
+}
