+bool slave_thread::load_dpp_provisioned_keys()
+{
+    auto db = AgentDB::get();
+
+    // Only load if DPP extender mode is enabled
+    if (db->dpp_extender_config.onboarding_type != AgentDB::OnboardingType::DPP) {
+        return true; // nothing to do for WSC mode
+    }
+
+    const std::string key_dir  = "/etc/prplmesh/dpp";
+    const std::string key_path = key_dir + "/bootstrap_key.pem";
+    const std::string uri_path = "/etc/prplmesh/dpp_uri";
+
+    // -------------------------------------------------------------------------
+    // If key or URI is missing: auto-generate ONCE and persist.
+    // This handles first-boot. After generation the files are stable across
+    // reboots. User should back them up before factory reset to preserve
+    // the same chirp hash and avoid re-provisioning the controller.
+    // -------------------------------------------------------------------------
+    bool key_missing = (access(key_path.c_str(), F_OK) != 0);
+    bool uri_missing = (access(uri_path.c_str(), F_OK) != 0);
+
+    if (key_missing || uri_missing) {
+        LOG(INFO) << "DPP: bootstrap " << (key_missing ? "key" : "URI")
+                  << " not found — " << (key_missing ? "generating new key pair" : "regenerating URI from existing key");
+
+        // Create parent directory and key directory if needed (mkdir -p equivalent)
+        const std::string parent_dir = "/etc/prplmesh";
+        struct stat st{};
+        if (stat(parent_dir.c_str(), &st) != 0) {
+            if (mkdir(parent_dir.c_str(), 0755) != 0 && errno != EEXIST) {
+                LOG(ERROR) << "DPP: failed to create directory: " << parent_dir;
+                return false;
+            }
+        }
+        if (stat(key_dir.c_str(), &st) != 0) {
+            if (mkdir(key_dir.c_str(), 0700) != 0 && errno != EEXIST) {
+                LOG(ERROR) << "DPP: failed to create directory: " << key_dir;
+                return false;
+            }
+        }
+
+        EVP_PKEY *new_key = nullptr;
+
+        if (!key_missing) {
+            // Key exists but URI is missing — load the existing key to regenerate URI.
+            // DO NOT generate a new key: that would change the chirp hash and break
+            // any controller that already has the old URI provisioned.
+            FILE *fp = fopen(key_path.c_str(), "r");
+            if (fp) {
+                new_key = PEM_read_PrivateKey(fp, nullptr, nullptr, nullptr);
+                fclose(fp);
+            }
+            if (!new_key) {
+                LOG(WARNING) << "DPP: failed to load existing key from " << key_path
+                             << " — generating new key pair";
+            } else {
+                LOG(INFO) << "DPP: loaded existing key, regenerating URI from it";
+            }
+        }
+
+        if (!new_key) {
+            // Either key is missing or loading failed — generate a new key pair
+            EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_id(EVP_PKEY_EC, nullptr);
+            if (pctx &&
+                EVP_PKEY_keygen_init(pctx) == 1 &&
+                EVP_PKEY_CTX_set_ec_paramgen_curve_nid(pctx, NID_X9_62_prime256v1) == 1) {
+                EVP_PKEY_keygen(pctx, &new_key);
+            }
+            if (pctx) EVP_PKEY_CTX_free(pctx);
+            if (!new_key) {
+                LOG(ERROR) << "DPP: EC P-256 key generation failed";
+                LOG(ERROR) << "DPP: EC P-256 key generation failed";
+                return false;
+            }
+
+            // Save new private key as PEM (only when key was missing/invalid)
+            FILE *fp = fopen(key_path.c_str(), "w");
+            if (!fp) {
+                LOG(ERROR) << "DPP: cannot create " << key_path;
+                EVP_PKEY_free(new_key);
+                return false;
+            }
+            if (PEM_write_PrivateKey(fp, new_key, nullptr, nullptr, 0, nullptr, nullptr) != 1) {
+                LOG(ERROR) << "DPP: PEM_write_PrivateKey failed";
+                fclose(fp);
+                EVP_PKEY_free(new_key);
+                return false;
+            }
+            fclose(fp);
+            chmod(key_path.c_str(), 0600);
+        } // end if (!new_key) — new key generation
+
+        // Export compressed SPKI DER for the URI K: field.
+        // hostapd uses compressed point form → shorter URI (~88 chars).
+        // Use OpenSSL 3.x EVP_PKEY_todata to get the compressed point, then
+        // build the SPKI DER manually (avoids deprecated EC_KEY APIs).
+        unsigned char *spki_der_ptr = nullptr;
+        int spki_len = 0;
+        {
+            // Request compressed public key via OSSL_PKEY_PARAM_EC_POINT_CONVERSION_FORMAT
+            // then export pub key. OpenSSL 3.x EVP_PKEY_todata approach:
+            OSSL_PARAM params[] = {
+                OSSL_PARAM_construct_utf8_string(
+                    OSSL_PKEY_PARAM_EC_POINT_CONVERSION_FORMAT,
+                    const_cast<char *>("compressed"), 0),
+                OSSL_PARAM_END
+            };
+            EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_from_pkey(nullptr, new_key, nullptr);
+            if (pctx) {
+                // Get compressed pubkey point (33 bytes for P-256)
+                uint8_t compressed[33] = {};
+                size_t comp_len = 0;
+                // Set point format on a duplicate key
+                EVP_PKEY *dup = EVP_PKEY_dup(new_key);
+                if (dup) {
+                    // Use OSSL params to set compressed format
+                    if (EVP_PKEY_set_params(dup, params) == 1) {
+                        EVP_PKEY_get_octet_string_param(dup, OSSL_PKEY_PARAM_PUB_KEY,
+                                                         nullptr, 0, &comp_len);
+                        if (comp_len == 33) {
+                            EVP_PKEY_get_octet_string_param(dup, OSSL_PKEY_PARAM_PUB_KEY,
+                                                             compressed, 33, &comp_len);
+                        }
+                    }
+                    EVP_PKEY_free(dup);
+                }
+                EVP_PKEY_CTX_free(pctx);
+
+                if (comp_len == 33) {
+                    // Build SPKI DER for P-256 compressed point:
+                    // SEQUENCE(57) { SEQUENCE(19) { OID ecPublicKey, OID prime256v1 }
+                    //                BIT STRING(34) { 0x00 || compressed(33) } }
+                    static const uint8_t hdr[] = {
+                        0x30, 0x39,
+                          0x30, 0x13,
+                            0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01,
+                            0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07,
+                          0x03, 0x22, 0x00
+                    };
+                    spki_len = static_cast<int>(sizeof(hdr) + 33);
+                    spki_der_ptr = static_cast<unsigned char *>(OPENSSL_malloc(spki_len));
+                    if (spki_der_ptr) {
+                        memcpy(spki_der_ptr, hdr, sizeof(hdr));
+                        memcpy(spki_der_ptr + sizeof(hdr), compressed, 33);
+                    } else {
+                        spki_len = 0;
+                    }
+                }
+            }
+            // Fallback to uncompressed SPKI DER
+            if (spki_len <= 0) {
+                spki_len = i2d_PUBKEY(new_key, &spki_der_ptr);
+            }
+        }
+        if (spki_len <= 0 || !spki_der_ptr) {
+            LOG(ERROR) << "DPP: i2d_PUBKEY failed";
+            EVP_PKEY_free(new_key);
+            return false;
+        }
+
+        // Base64url-encode for DPP URI (standard base64, URI uses std encoding with padding)
+        BIO *b64  = BIO_new(BIO_f_base64());
+        BIO *bmem = BIO_new(BIO_s_mem());
+        b64       = BIO_push(b64, bmem);
+        BIO_set_flags(b64, BIO_FLAGS_BASE64_NO_NL);
+        BIO_write(b64, spki_der_ptr, spki_len);
+        BIO_flush(b64);
+        BUF_MEM *bptr = nullptr;
+        BIO_get_mem_ptr(bmem, &bptr);
+        std::string key_b64(bptr->data, bptr->length);
+        BIO_free_all(b64);
+        OPENSSL_free(spki_der_ptr);
+
+        // Build DPP URI
+        std::string new_uri = "DPP:V:3;K:" + key_b64 + ";;";
+
+        // Save URI
+        FILE *uf = fopen(uri_path.c_str(), "w");
+        if (!uf) {
+            LOG(ERROR) << "DPP: cannot create " << uri_path;
+            EVP_PKEY_free(new_key);
+            return false;
+        }
+        fprintf(uf, "%s\n", new_uri.c_str());
+        fclose(uf);
+
+        LOG(INFO) << "DPP: generated bootstrap key pair";
+        LOG(INFO) << "DPP: URI saved to " << uri_path;
+        LOG(INFO) << "DPP: URI=" << new_uri;
+        LOG(WARNING) << "DPP: IMPORTANT — back up " << key_path << " and " << uri_path
+                     << " before factory reset to preserve the same chirp hash";
+        LOG(WARNING) << "DPP: Provide this URI to the controller: " << new_uri;
+
+        EVP_PKEY_free(new_key);
+        // Fall through — the files now exist, load them below
+    }
+
+    // -------------------------------------------------------------------------
+    // Load the key and URI (whether just generated or pre-provisioned)
+    // -------------------------------------------------------------------------
+
+    // 1. Load private key from PEM file
+    FILE *fp = fopen(key_path.c_str(), "r");
+    if (!fp) {
+        LOG(ERROR) << "DPP: cannot open bootstrap key: " << key_path;
+        return false;
+    }
+    EVP_PKEY *pkey = PEM_read_PrivateKey(fp, nullptr, nullptr, nullptr);
+    fclose(fp);
+    if (!pkey) {
+        LOG(ERROR) << "DPP: failed to parse bootstrap private key from " << key_path;
+        return false;
+    }
+
+    // 2. Parse DPP URI — extract K: field → decode SPKI DER
+    std::ifstream uri_file(uri_path);
+    if (!uri_file.is_open()) {
+        LOG(ERROR) << "DPP: cannot open DPP URI file: " << uri_path;
+        EVP_PKEY_free(pkey);
+        return false;
+    }
+    std::string uri_line;
+    std::getline(uri_file, uri_line);
+    // Trim trailing whitespace/newline
+    uri_line.erase(uri_line.find_last_not_of(" \t\n\r") + 1);
+
+    // Extract K: field from URI
+    const std::string k_prefix = "K:";
+    auto k_pos = uri_line.find(k_prefix);
+    if (k_pos == std::string::npos) {
+        LOG(ERROR) << "DPP: DPP URI missing K: field in " << uri_path;
+        EVP_PKEY_free(pkey);
+        return false;
+    }
+    k_pos += k_prefix.size();
+    auto k_end = uri_line.find(';', k_pos);
+    if (k_end == std::string::npos) k_end = uri_line.size();
+    std::string key_b64 = uri_line.substr(k_pos, k_end - k_pos);
+
+    // Base64-decode (standard + url-safe variants)
+    // Replace url-safe chars
+    for (char &c : key_b64) {
+        if (c == '-') c = '+';
+        if (c == '_') c = '/';
+    }
+    // Pad if needed
+    while (key_b64.size() % 4) key_b64 += '=';
+
+    std::vector<uint8_t> spki_der;
+    {
+        // Use OpenSSL BIO for base64 decode
+        BIO *b64  = BIO_new(BIO_f_base64());
+        BIO *bmem = BIO_new_mem_buf(key_b64.data(), static_cast<int>(key_b64.size()));
+        bmem      = BIO_push(b64, bmem);
+        BIO_set_flags(bmem, BIO_FLAGS_BASE64_NO_NL);
+        spki_der.resize(key_b64.size()); // upper bound
+        int decoded_len = BIO_read(bmem, spki_der.data(), static_cast<int>(spki_der.size()));
+        BIO_free_all(bmem);
+        if (decoded_len <= 0) {
+            LOG(ERROR) << "DPP: failed to base64-decode K: field from URI";
+            EVP_PKEY_free(pkey);
+            return false;
+        }
+        spki_der.resize(static_cast<size_t>(decoded_len));
+    }
+
+    // 3. Validate: derive public key from private key and compare with URI SPKI DER.
+    // The URI K: field uses compressed SPKI DER (59 bytes for P-256).
+    // i2d_PUBKEY exports uncompressed SPKI DER (91 bytes). Build compressed form
+    // to match the URI encoding before comparing.
+    {
+        bool match = false;
+        unsigned char *pub_ptr = nullptr;
+        int pub_len = i2d_PUBKEY(pkey, &pub_ptr);
+        if (pub_len > 0 && pub_ptr) {
+            // Uncompressed SPKI DER for P-256 ends with: 04 || x(32) || y(32)
+            if (pub_len >= 65) {
+                const unsigned char *point = pub_ptr + (pub_len - 65);
+                if (point[0] == 0x04) {
+                    const unsigned char *x = point + 1;
+                    const unsigned char *y = point + 33;
+                    unsigned char prefix = (y[31] & 1) ? 0x03 : 0x02;
+                    // Compressed SPKI DER for P-256 (59 bytes):
+                    // 30 39 30 13 06 07 2a864 8ce3d020106082a8648ce3d030107 03 22 00 prefix x[32]
+                    static const unsigned char spki_prefix[] = {
+                        0x30, 0x39, 0x30, 0x13, 0x06, 0x07,
+                        0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01,
+                        0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07,
+                        0x03, 0x22, 0x00
+                    };
+                    std::vector<uint8_t> compressed_spki(sizeof(spki_prefix) + 1 + 32);
+                    memcpy(compressed_spki.data(), spki_prefix, sizeof(spki_prefix));
+                    compressed_spki[sizeof(spki_prefix)] = prefix;
+                    memcpy(compressed_spki.data() + sizeof(spki_prefix) + 1, x, 32);
+                    match = (compressed_spki.size() == spki_der.size() &&
+                             memcmp(compressed_spki.data(), spki_der.data(), spki_der.size()) == 0);
+                }
+            }
+            OPENSSL_free(pub_ptr);
+        }
+        if (!match) {
+            LOG(ERROR) << "DPP: bootstrap key mismatch — private key public point "
+                          "does not match K: field in DPP URI. "
+                          "Check /etc/prplmesh/dpp/ and /etc/prplmesh/dpp_uri";
+            EVP_PKEY_free(pkey);
+            return false;
+        }
+    }
+
+    // 4. Compute chirp_hash = SHA256("chirp" || SPKI_DER)
+    //    and pubkey_hash   = SHA256(SPKI_DER)  (hostapd pkhash for dpp_controller)
+    std::array<uint8_t, 32> chirp_hash{};
+    std::array<uint8_t, 32> pubkey_hash{};
+    {
+        std::vector<uint8_t> input;
+        const std::string chirp_prefix = "chirp";
+        input.insert(input.end(), chirp_prefix.begin(), chirp_prefix.end());
+        input.insert(input.end(), spki_der.begin(), spki_der.end());
+        SHA256(input.data(), input.size(), chirp_hash.data());
+    }
+    SHA256(spki_der.data(), spki_der.size(), pubkey_hash.data());
+
+    // 5. Store in AgentDB
+    if (db->dpp_bootstrap.private_key) {
+        EVP_PKEY_free(db->dpp_bootstrap.private_key);
+    }
+    db->dpp_bootstrap.private_key = pkey;
+    db->dpp_bootstrap.key_der     = std::move(spki_der);
+    db->dpp_bootstrap.chirp_hash  = chirp_hash;
+    db->dpp_bootstrap.pubkey_hash = pubkey_hash;
+    db->dpp_bootstrap.dpp_uri     = uri_line;
+    db->dpp_bootstrap.valid       = true;
+
+    LOG(INFO) << "DPP: loaded bootstrap key from " << key_path;
+    LOG(INFO) << "DPP: chirp_hash=" << [&chirp_hash]() {
+        std::string hex;
+        for (auto b : chirp_hash) {
+            char buf[3];
+            snprintf(buf, sizeof(buf), "%02x", b);
+            hex += buf;
+        }
+        return hex;
+    }();
+
+    return true;
+}
+void slave_thread::start_dpp_tcp_relay_server()
+{
+    if (!m_dpp_agent_task) {
+        return;
+    }
+    if (m_dpp_agent_task->is_relay_active()) {
+        LOG(DEBUG) << "DPP: TCP relay server already active";
+        return;
+    }
+
+    LOG(INFO) << "DPP: own onboarding complete — starting TCP relay listener (port "
+              << bwl::DPP_TCP_PORT << ") for downstream enrollee proxying";
+
+    if (!m_slave_wlan_hal || !m_slave_wlan_hal->init_dpp_relay()) {
+        LOG(ERROR) << "DPP: failed to start TCP relay listener (port "
+                   << bwl::DPP_TCP_PORT << ")";
+        return;
+    }
+
+    m_dpp_agent_task->on_relay_status(m_slave_wlan_hal->is_dpp_client_connected());
+}
