+}
+
+void DppAgentTask::send_proxied_encap_dpp(const uint8_t *frame, size_t frame_len, bool is_gas)
+{
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::PROXIED_ENCAP_DPP_MESSAGE)) {
+        LOG(ERROR) << "DPP: failed to create PROXIED_ENCAP_DPP_MESSAGE CMDU";
+        return;
+    }
+
+    auto encap_tlv = m_cmdu_tx.addClass<wfa_map::tlv1905EncapDpp>();
+    if (!encap_tlv) {
+        LOG(ERROR) << "DPP: failed to add tlv1905EncapDpp";
+        return;
+    }
+
+    if (is_gas) {
+        encap_tlv->frame_type() = static_cast<wfa_map::tlv1905EncapDpp::eFrameType>(0xFF);
+        encap_tlv->frame_flags().dpp_frame_indicator = true;
+    } else {
+        encap_tlv->frame_type() = static_cast<wfa_map::tlv1905EncapDpp::eFrameType>(0x01);
+        encap_tlv->frame_flags().dpp_frame_indicator = false;
+    }
+
+    encap_tlv->frame_flags().enrollee_mac_address_present = false;
+
+    // Per EasyMesh spec and hostapd TCP protocol:
+    // - hostapd sends GAS frames over TCP with the Action byte (0x0A) already stripped
+    // - The TCP frame from hostapd starts directly with the dialog token
+    // - For 1905 encapsulation, we need to prepend the Action byte back
+    // - The 1905 frame should be: Action(0x0A) + dialog_token + rest_of_frame
+    const uint8_t tcp_prefix = is_gas ? WLAN_PA_GAS_INITIAL_REQ : WLAN_PA_VENDOR_SPECIFIC;
+    if (!encap_tlv->alloc_encapsulated_frame(1 + frame_len)) {
+        LOG(ERROR) << "DPP: failed to allocate encapsulated frame in TLV";
+        return;
+    }
+    encap_tlv->encapsulated_frame()[0] = tcp_prefix;
+    std::copy(frame, frame + frame_len, encap_tlv->encapsulated_frame() + 1);
+    encap_tlv->encapsulated_frame_length() = static_cast<uint16_t>(1 + frame_len);
+
+    // Debug: Print first 16 bytes of encapsulated frame
+    {
+        std::ostringstream hex_dump;
+        const uint8_t *enc_frame = encap_tlv->encapsulated_frame();
+        size_t dump_len = std::min(static_cast<size_t>(16), static_cast<size_t>(1 + frame_len));
+        for (size_t i = 0; i < dump_len; ++i) {
+            hex_dump << std::hex << std::setw(2) << std::setfill('0')
+                     << static_cast<int>(enc_frame[i]) << " ";
+        }
+        LOG(DEBUG) << "DPP: agent sending to controller, first " << dump_len << " bytes: "
+                   << hex_dump.str();
+    }
+
+    if (!m_btl_ctx.send_cmdu_to_controller("", m_cmdu_tx)) {
+        LOG(ERROR) << "DPP: failed to send PROXIED_ENCAP_DPP_MESSAGE to controller";
+        return;
+    }
+
+    LOG(DEBUG) << "DPP: sent PROXIED_ENCAP_DPP_MESSAGE to controller"
+               << " (is_gas=" << is_gas
+               << ", encap_frame_len=" << (1 + frame_len)
+               << ", mid=0x" << std::hex << m_cmdu_tx.getMessageId() << std::dec << ")"
+               << ", tlv=0xCD, msg_type=0x8029";
+}
+
+// ---------------------------------------------------------------------------
+// Private: Downlink frame dispatch (Controller → hostapd)
+// ---------------------------------------------------------------------------
+
+void DppAgentTask::handle_proxied_encap_dpp_from_controller(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto mid       = cmdu_rx.getMessageId();
+    auto encap_tlv = cmdu_rx.getClass<wfa_map::tlv1905EncapDpp>();
+    if (!encap_tlv) {
+        LOG(ERROR) << "DPP: Proxied Encap DPP from controller (mid=" << mid
+                   << ") missing tlv1905EncapDpp (0xCD)";
+        return;
+    }
+
+    uint8_t tcp_type;
+    if (encap_tlv->frame_type() == static_cast<wfa_map::tlv1905EncapDpp::eFrameType>(0xFF)) {
+        tcp_type = WLAN_PA_GAS_INITIAL_RESP;
+    } else {
+        tcp_type = WLAN_PA_VENDOR_SPECIFIC;
+    }
+
+    const uint8_t *frame = encap_tlv->encapsulated_frame();
+    size_t frame_len     = encap_tlv->encapsulated_frame_length();
+
+    if (!frame || frame_len == 0) {
+        LOG(ERROR) << "DPP: Proxied Encap DPP from controller (mid=" << mid
+                   << ") has empty frame body";
+        return;
+    }
+
+    // The 1905 TLV's encapsulated frame for DPP_PUBLIC_ACTION_FRAME starts with
+    // the 802.11 Action byte (0x09 = Vendor Specific), per the Wi-Fi Easy Connect
+    // spec ("starting from the Action field"). For GAS frames, keep the TCP type
+    // byte (0x0a/0x0d) in the encapsulated payload so the full hostapd framing
+    // is preserved.
+    const uint8_t *send_frame = frame;
+    size_t send_frame_len     = frame_len;
+    if (tcp_type == WLAN_PA_VENDOR_SPECIFIC && send_frame_len > 1 &&
+        send_frame[0] == WLAN_PA_VENDOR_SPECIFIC) {
+        LOG(DEBUG) << "DPP: stripping leading Action byte (0x09) from encapsulated frame"
+                   << " before sending to hostapd";
+        send_frame    = frame + 1;
+        send_frame_len = frame_len - 1;
+    }
+    // Auth Request caching disabled for validation.
+    // To re-enable, uncomment the block below.
+    //
+    // if (tcp_type == WLAN_PA_VENDOR_SPECIFIC) {
+    //     auto chirp_tlv = cmdu_rx.getClass<wfa_map::tlvDppChirpValue>();
+    //     if (chirp_tlv && chirp_tlv->flags().hash_validity &&
+    //         chirp_tlv->hash_length() == 32) {
+    //         if (send_frame_len > DPP_HDR_LEN &&
+    //             send_frame[DPP_SUBTYPE_OFFSET] == DPP_PA_AUTHENTICATION_REQ) {
+    //             LOG(DEBUG) << "DPP: caching Auth Request (subtype=0x00) keyed by"
+    //                        << " hash from tlvDppChirpValue (0xD3)";
+    //             cache_auth_request(chirp_tlv->hash(), send_frame, send_frame_len);
+    //         }
+    //     }
+    // }
+
+    // Log the specific DPP frame subtype being sent to hostapd for easier tracing.
+    // IMPORTANT: Auth Response (0x01) is an UPLINK-only frame — it is sent FROM the Enrollee
+    // TO the Controller. The Controller must never send an Auth Response back downlink to the
+    // Enrollee. If we receive an Auth Response in a downlink PROXIED_ENCAP_DPP_MESSAGE, it
+    // means the Controller has no active session and is echoing the frame back. Discard it.
+    if (tcp_type == WLAN_PA_VENDOR_SPECIFIC && send_frame_len > DPP_HDR_LEN) {
+        uint8_t subtype = send_frame[DPP_SUBTYPE_OFFSET];
+        const char *subtype_name = "Unknown";
+        switch (subtype) {
+        case DPP_PA_AUTHENTICATION_REQ:  subtype_name = "Auth Request";  break;
+        case DPP_PA_AUTHENTICATION_RESP: subtype_name = "Auth Response"; break;
+        case DPP_PA_AUTHENTICATION_CONF: subtype_name = "Auth Confirm";  break;
+        default: break;
+        }
+
+        // Auth Response (0x01) must never be sent downlink to the Enrollee.
+        // This can happen when the Controller has no active session and the message
+        // is routed to a secondary handler that echoes it back. Discard it.
+        if (subtype == DPP_PA_AUTHENTICATION_RESP) {
+            LOG(WARNING) << "DPP: discarding downlink Auth Response (subtype=0x01) — "
+                         << "Auth Response is uplink-only; Controller has no active session "
+                         << "(mid=0x" << std::hex << mid << std::dec << ")";
+            return;
+        }
+
+        LOG(INFO) << "DPP: sending " << subtype_name << " (subtype=0x" << std::hex
+                  << static_cast<int>(subtype) << std::dec << ") to hostapd"
+                  << ", mid=0x" << std::hex << mid << std::dec
+                  << ", frame_len=" << send_frame_len;
+    } else if (tcp_type == WLAN_PA_GAS_INITIAL_RESP || tcp_type == WLAN_PA_GAS_COMEBACK_RESP) {
+        // Per EasyMesh spec and hostapd TCP protocol:
+        // - The 1905 encapsulated GAS Response starts with Action byte (0x0B)
+        // - hostapd TCP protocol expects GAS frames WITHOUT the Action byte
+        // - Strip the Action byte before forwarding to hostapd
+        if (frame_len > 1 && frame[0] == tcp_type) {
+            send_frame     = frame + 1;
+            send_frame_len = frame_len - 1;
+            LOG(INFO) << "DPP: sending GAS Response (type=0x" << std::hex
+                      << static_cast<int>(tcp_type) << std::dec << ") to hostapd"
+                      << " (stripped Action byte)"
+                      << ", mid=0x" << std::hex << mid << std::dec
+                      << ", frame_len=" << send_frame_len;
+        } else {
+            LOG(WARNING) << "DPP: GAS Response frame doesn't start with expected Action byte"
+                         << " (expected 0x" << std::hex << static_cast<int>(tcp_type) << std::dec
+                         << ", got 0x" << std::hex << static_cast<int>(frame[0]) << std::dec << ")";
+            send_frame     = frame;
+            send_frame_len = frame_len;
+        }
+    }
+
+    if (!send_dpp_frame(tcp_type, send_frame, send_frame_len)) {
+        LOG(ERROR) << "DPP: failed to relay frame to hostapd (mid=" << mid << ")";
+        return;
+    }
+
+    LOG(DEBUG) << "DPP: relayed " << send_frame_len << " bytes to hostapd"
+               << " (type=0x" << std::hex << static_cast<int>(tcp_type) << std::dec
+               << ", mid=" << mid << ")";
+}
+
+uint64_t DppAgentTask::monotonic_time_ms()
+{
+    using namespace std::chrono;
+    return duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+void DppAgentTask::cache_auth_request(const uint8_t hash[32], const uint8_t *frame,
+                                      size_t frame_len)
+{
+    std::array<uint8_t, 32> key {};
+    std::copy(hash, hash + 32, key.begin());
+
+    auto &entry      = m_auth_request_cache[key];
+    entry.frame.assign(frame, frame + frame_len);
+    entry.frame_len   = static_cast<uint16_t>(frame_len);
+    entry.timestamp_ms = monotonic_time_ms();
+    entry.valid       = true;
+}
+
+bool DppAgentTask::get_cached_auth_request(const uint8_t hash[32], const uint8_t *&frame,
+                                           size_t &frame_len)
+{
+    std::array<uint8_t, 32> key {};
+    std::copy(hash, hash + 32, key.begin());
+
+    auto it = m_auth_request_cache.find(key);
+    if (it == m_auth_request_cache.end() || !it->second.valid) {
+        return false;
+    }
+
+    frame     = it->second.frame.data();
+    frame_len = it->second.frame_len;
+    return true;
+}
+
+void DppAgentTask::clear_cached_auth_request(const uint8_t hash[32])
+{
+    std::array<uint8_t, 32> key {};
+    std::copy(hash, hash + 32, key.begin());
+    m_auth_request_cache.erase(key);
+}
+
+bool DppAgentTask::send_direct_encap_dpp_to_controller(const sMacAddr &peer_mac,
+                                              const std::vector<uint8_t> &frame)
+{
+    auto cmdu_hdr = m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+    if (!cmdu_hdr) return false;
+
+    auto dpp_msg_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppMessage>();
+    if (!dpp_msg_tlv) return false;
+
+    if (!dpp_msg_tlv->alloc_dpp_frame(frame.size())) return false;
+    memcpy(dpp_msg_tlv->dpp_frame(), frame.data(), frame.size());
+
+    return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
+
+bool DppAgentTask::handle_dpp_wired_auth_request(
+    const sMacAddr &src_mac, const uint8_t *frame, size_t frame_len)
+{
+    LOG(INFO) << "DPP: wired Auth Request from " << src_mac;
+
+    auto db = AgentDB::get();
+    if (!db->dpp_bootstrap.valid || !db->dpp_bootstrap.private_key) {
+        LOG(ERROR) << "DPP: bootstrap key not loaded — cannot handle Auth Request";
+        return false;
+    }
+
+    // Guard against duplicate delivery to multiple radios — only one session at a time.
+    if (db->dpp_wired_session.active) {
+        LOG(DEBUG) << "DPP: Auth Request ignored — session already active (duplicate delivery)";
+        return true;
+    }
+
+    LOG(DEBUG) << "DPP: Auth Request — frame_len=" << frame_len
+               << " key_der_len=" << db->dpp_bootstrap.key_der.size();
+
+    // Frame: Action(1)+OUI(3)+OUIType(1)+CryptoSuite(1)+FrameType(1) = 7 bytes header
+    if (frame_len < 7) return false;
+    const uint8_t *attrs     = frame + 7;
+    size_t attrs_len         = frame_len - 7;
+
+    // 1. Verify R-Bootstrap-Hash matches own chirp hash (SHA256(DER), not chirp prefix)
+    LOG(DEBUG) << "DPP: Auth Request step 1 — verify R-Bootstrap-Hash";
+    uint16_t r_hash_len = 0;
+    const uint8_t *r_hash = find_attr(attrs, attrs_len, DPP_ATTR_R_BOOTSTRAP_HASH, &r_hash_len);
+    if (!r_hash || r_hash_len < 32) {
+        LOG(ERROR) << "DPP: Auth Request missing R-Bootstrap-Hash";
+        return false;
+    }
+    // Compute SHA256(SPKI_DER) — the plain bootstrap hash (not chirp hash)
+    uint8_t own_bs_hash[32];
+    SHA256(db->dpp_bootstrap.key_der.data(), db->dpp_bootstrap.key_der.size(), own_bs_hash);
+    if (memcmp(r_hash, own_bs_hash, 32) != 0) {
+        LOG(ERROR) << "DPP: Auth Request R-Bootstrap-Hash does not match own key";
+        return false;
+    }
+
+    // 2. Extract PI (I-Protocol-Key) — 64 bytes x||y
+    LOG(DEBUG) << "DPP: Auth Request step 2 — extract PI";
+    uint16_t pi_len = 0;
+    const uint8_t *pi_bytes = find_attr(attrs, attrs_len, DPP_ATTR_I_PROTOCOL_KEY, &pi_len);
+    if (!pi_bytes || pi_len < 64) {
+        LOG(ERROR) << "DPP: Auth Request missing I-Protocol-Key";
+        return false;
+    }
+
+    // Import PI as EVP_PKEY (uncompressed point: prepend 0x04)
+    LOG(DEBUG) << "DPP: Auth Request step 3 — import PI key, pi_len=" << pi_len;
+    // Build SPKI DER for P-256 uncompressed key and import via d2i_PUBKEY.
+    // OSSL_PARAM_BLD import can produce keys that give wrong ECDH results on some
+    // OpenSSL 3.x builds — d2i_PUBKEY uses the standard ASN.1 path used by hostapd.
+    // SPKI DER for P-256 uncompressed (65B key): 27-byte header + 04||x||y = 91 bytes total
+    static const uint8_t p256_spki_hdr[] = {
+        0x30, 0x59,                         // SEQUENCE (89 bytes)
+          0x30, 0x13,                       // SEQUENCE (19 bytes) — AlgorithmIdentifier
+            0x06, 0x07,                     // OID ecPublicKey (7 bytes)
+              0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01,
+            0x06, 0x08,                     // OID prime256v1 (8 bytes)
+              0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07,
+          0x03, 0x42, 0x00                  // BIT STRING (66 bytes, 0 unused bits)
+    };
+    uint8_t pi_spki_der[91];
+    memcpy(pi_spki_der, p256_spki_hdr, sizeof(p256_spki_hdr));
+    pi_spki_der[sizeof(p256_spki_hdr)] = 0x04;  // uncompressed prefix
+    memcpy(pi_spki_der + sizeof(p256_spki_hdr) + 1, pi_bytes, 64);
+
+    const uint8_t *p = pi_spki_der;
+    EVP_PKEY *pi_key = d2i_PUBKEY(nullptr, &p, static_cast<long>(sizeof(pi_spki_der)));
+    if (!pi_key) {
+        LOG(ERROR) << "DPP: failed to import I-Protocol-Key via d2i_PUBKEY";
+        return false;
+    }
+    LOG(DEBUG) << "DPP: Auth Request step 4 — M.x ECDH";
+
+    // 3. Compute M.x = ECDH(bR, PI)
+    std::vector<uint8_t> M_x;
+    {
+        EVP_PKEY_CTX *ctx = EVP_PKEY_CTX_new(db->dpp_bootstrap.private_key, nullptr);
+        if (!ctx) {
+            LOG(ERROR) << "DPP: EVP_PKEY_CTX_new failed for M.x ECDH";
+            EVP_PKEY_free(pi_key);
+            return false;
+        }
+        if (EVP_PKEY_derive_init(ctx) <= 0 ||
+            EVP_PKEY_derive_set_peer(ctx, pi_key) <= 0) {
+            LOG(ERROR) << "DPP: ECDH init/set_peer failed for M.x";
+            EVP_PKEY_CTX_free(ctx); EVP_PKEY_free(pi_key); return false;
+        }
+        size_t secret_len = 0;
+        EVP_PKEY_derive(ctx, nullptr, &secret_len);
+        M_x.resize(secret_len);
+        if (EVP_PKEY_derive(ctx, M_x.data(), &secret_len) <= 0) {
+            LOG(ERROR) << "DPP: EVP_PKEY_derive failed for M.x";
+            EVP_PKEY_CTX_free(ctx); EVP_PKEY_free(pi_key); return false;
+        }
+        M_x.resize(secret_len);
+        // DPP uses only x-coordinate (32 bytes) for key derivation
+        if (M_x.size() > 32) M_x.resize(32);
+        LOG(DEBUG) << "DPP: Auth Request M_x (" << M_x.size() << "B): "
+                   << [&]() { std::string h; char b[3];
+                       for (auto c : M_x) { snprintf(b,3,"%02x",c); h+=b; }
+                       return h; }();
+        EVP_PKEY_CTX_free(ctx);
+        if (M_x.empty()) {
+            LOG(ERROR) << "DPP: ECDH(bR, PI) for M.x returned empty result";
+            EVP_PKEY_free(pi_key);
+            return false;
+        }
+    }
+
+    // 4. Derive k1 = HKDF(<salt=0>, "first intermediate key", M.x)
+    LOG(DEBUG) << "DPP: Auth Request step 5 — derive k1, M_x_len=" << M_x.size();
+    std::array<uint8_t, 32> k1{};
+    {
+        std::array<uint8_t, 32> salt{};  // all zeros
+        uint8_t prk[32]; size_t prk_len = 32;
+        hkdf_extract(salt.data(), 32, M_x.data(), M_x.size(), prk, &prk_len);
+        const char *info = "first intermediate key";
+        hkdf_expand(prk, prk_len, info, strlen(info), k1.data(), 32);
+    }
+
+    // 5. Decrypt WRAPPED_DATA with k1 — get I-nonce
+    LOG(DEBUG) << "DPP: Auth Request step 6 — decrypt Wrapped Data";
+    // Wrapped Data attr = offset of WRAPPED_DATA in pre-attrs
+    const uint8_t *wd_val = nullptr; uint16_t wd_len = 0;
+    // Find offset of Wrapped Data for AAD computation
+    size_t wd_offset = 0;
+    {
+        size_t off = 0;
+        while (off + 4 <= attrs_len) {
+            uint16_t id = attrs[off] | (static_cast<uint16_t>(attrs[off+1]) << 8);
+            uint16_t ln = attrs[off+2] | (static_cast<uint16_t>(attrs[off+3]) << 8);
+            if (id == DPP_ATTR_WRAPPED_DATA) { wd_val = attrs+off+4; wd_len = ln; wd_offset = off; break; }
+            off += 4 + ln;
+        }
+    }
+    if (!wd_val || wd_len < 16) {
+        LOG(ERROR) << "DPP: Auth Request missing Wrapped Data";
+        EVP_PKEY_free(pi_key);
+        return false;
+    }
+
+    // AAD for k1 decrypt: [OUI header 6B (frame[1..7])] + [attrs before Wrapped Data]
+    std::vector<uint8_t> aad1(frame + 1, frame + 7);
+    std::vector<uint8_t> aad2(attrs, attrs + wd_offset);
+    std::vector<uint8_t> inner;
+    if (!aes_siv_decrypt(k1.data(), 32, wd_val, wd_len, {aad1, aad2}, inner)) {
+        LOG(ERROR) << "DPP: Auth Request k1 decrypt failed";
+        EVP_PKEY_free(pi_key);
+        return false;
+    }
+
+    // Extract I-nonce from inner
+    uint16_t i_nonce_len = 0;
+    const uint8_t *i_nonce_val = find_attr(inner.data(), inner.size(), DPP_ATTR_I_NONCE, &i_nonce_len);
+    if (!i_nonce_val || i_nonce_len < 16) {
+        LOG(ERROR) << "DPP: Auth Request missing I-nonce in Wrapped Data";
+        EVP_PKEY_free(pi_key);
+        return false;
+    }
+
+    // 6. Store session state (reset frees any old EVP_PKEY pointers safely)
+    LOG(DEBUG) << "DPP: Auth Request step 7 — store session, building Auth Response";
+    auto &sess = db->dpp_wired_session;
+    sess.reset();
+    sess.active = true;  // mark before any crypto to block duplicate deliveries
+    m_chirp_sent_time = {}; // Auth Request received — cancel the chirp timeout
+    sess.controller_mac          = src_mac;
+    sess.initiator_protocol_key  = pi_key;  // PI (takes ownership)
+    memcpy(sess.i_nonce.data(), i_nonce_val, 16);
+    sess.M_x = std::move(M_x);
+
+    // 7. Build and send Auth Response
+    return build_and_send_auth_response(src_mac);
+}
+
+bool DppAgentTask::build_and_send_auth_response(const sMacAddr &controller_mac)
+{
+    auto db = AgentDB::get();
+    auto &sess = db->dpp_wired_session;
+
+    // 1. Generate pR (ephemeral protocol key pair).
+    // Keys generated by EVP_PKEY_CTX APIs on this platform produce wrong ECDH results.
+    // The workaround: generate via EVP_PKEY_CTX, serialize as traditional EC PEM
+    // (BEGIN EC PRIVATE KEY — same format as bR loaded from file), then reload.
+    // PEM_write_bio_PrivateKey_traditional writes traditional format without deprecated APIs.
+    {
+        EVP_PKEY *tmp = nullptr;
+        EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_id(EVP_PKEY_EC, nullptr);
+        if (pctx &&
+            EVP_PKEY_keygen_init(pctx) == 1 &&
+            EVP_PKEY_CTX_set_ec_paramgen_curve_nid(pctx, NID_X9_62_prime256v1) == 1) {
+            EVP_PKEY_keygen(pctx, &tmp);
+        }
+        if (pctx) EVP_PKEY_CTX_free(pctx);
+
+        if (tmp) {
+            BIO *bio = BIO_new(BIO_s_mem());
+            if (bio) {
+                // Traditional EC PEM format (BEGIN EC PRIVATE KEY) — same as PEM_read_PrivateKey
+                // reads from a .pem file — produces correct ECDH on this platform.
+                if (PEM_write_bio_PrivateKey_traditional(bio, tmp,
+                                                          nullptr, nullptr, 0,
+                                                          nullptr, nullptr) == 1) {
+                    sess.agent_protocol_key = PEM_read_bio_PrivateKey(bio, nullptr,
+                                                                       nullptr, nullptr);
+                }
+                BIO_free(bio);
+            }
+            EVP_PKEY_free(tmp);
+        }
+    }
+    if (!sess.agent_protocol_key) {
+        LOG(ERROR) << "DPP: failed to generate agent ephemeral protocol key (pR)";
+        return false;
+    }
+
+    // 2. Generate R-nonce (16 random bytes)
+    RAND_bytes(sess.r_nonce.data(), 16);
+
+    // 3. N.x = ECDH(pR, PI)
+    {
+        EVP_PKEY_CTX *ctx = EVP_PKEY_CTX_new(sess.agent_protocol_key, nullptr);
+        if (!ctx) {
+            LOG(ERROR) << "DPP: EVP_PKEY_CTX_new failed for N.x ECDH";
+            return false;
+        }
+        if (EVP_PKEY_derive_init(ctx) <= 0) {
+            LOG(ERROR) << "DPP: EVP_PKEY_derive_init failed for N.x";
+            EVP_PKEY_CTX_free(ctx); return false;
+        }
+        if (EVP_PKEY_derive_set_peer(ctx, sess.initiator_protocol_key) <= 0) {
+            LOG(ERROR) << "DPP: EVP_PKEY_derive_set_peer failed for N.x — PI key incompatible with pR";
+            EVP_PKEY_CTX_free(ctx); return false;
+        }
+        size_t len = 0;
+        EVP_PKEY_derive(ctx, nullptr, &len);
+        LOG(DEBUG) << "DPP: N.x ECDH raw output len=" << len;
+        sess.N_x.resize(len);
+        if (EVP_PKEY_derive(ctx, sess.N_x.data(), &len) <= 0) {
+            LOG(ERROR) << "DPP: EVP_PKEY_derive failed for N.x";
+            EVP_PKEY_CTX_free(ctx); return false;
+        }
+        sess.N_x.resize(len);
+        // DPP uses only x-coordinate (32 bytes) for key derivation
+        if (sess.N_x.size() > 32) sess.N_x.resize(32);
+        EVP_PKEY_CTX_free(ctx);
+        if (sess.N_x.empty()) {
+            LOG(ERROR) << "DPP: ECDH(pR, PI) for N.x returned empty result";
+            return false;
+        }
+        LOG(DEBUG) << "DPP: Auth Response N_x (" << sess.N_x.size() << "B): "
+                   << [&]() { std::string h; char b[3];
+                       for (auto c : sess.N_x) { snprintf(b,3,"%02x",c); h+=b; }
+                       return h; }();
+    }
+
+    // 4. k2 = HKDF(<>, "second intermediate key", N.x)
+    std::array<uint8_t, 32> k2{};
+    {
+        std::array<uint8_t, 32> salt{};
+        uint8_t prk[32]; size_t prk_len = 32;
+        hkdf_extract(salt.data(), 32, sess.N_x.data(), sess.N_x.size(), prk, &prk_len);
+        const char *info = "second intermediate key";
+        hkdf_expand(prk, prk_len, info, strlen(info), k2.data(), 32);
+        LOG(DEBUG) << "DPP: Auth Response M_x (" << sess.M_x.size() << "B): "
+                   << [&]() { std::string h; char b[3];
+                       for (auto c : sess.M_x) { snprintf(b,3,"%02x",c); h+=b; }
+                       return h; }();
+        LOG(DEBUG) << "DPP: Auth Response k2: "
+                   << [&]() { std::string h; char b[3];
+                       for (auto c : k2) { snprintf(b,3,"%02x",c); h+=b; }
+                       return h; }();
+    }
+
+    // 5. bk = HKDF-Extract(I-nonce||R-nonce, M.x||N.x)
+    std::array<uint8_t, 32> bk{};
+    {
+        std::vector<uint8_t> salt_vec;
+        salt_vec.insert(salt_vec.end(), sess.i_nonce.begin(), sess.i_nonce.end());
+        salt_vec.insert(salt_vec.end(), sess.r_nonce.begin(), sess.r_nonce.end());
+        std::vector<uint8_t> ikm;
+        ikm.insert(ikm.end(), sess.M_x.begin(), sess.M_x.end());
+        ikm.insert(ikm.end(), sess.N_x.begin(), sess.N_x.end());
+        // No L.x — no mutual auth in EasyMesh wired flow
+        uint8_t prk[32]; size_t prk_len = 32;
+        hkdf_extract(salt_vec.data(), salt_vec.size(), ikm.data(), ikm.size(), prk, &prk_len);
+        memcpy(bk.data(), prk, 32);
+    }
+
+    // 6. ke = HKDF-Expand(bk, "DPP Key", 32)
+    {
+        const char *info = "DPP Key";
+        hkdf_expand(bk.data(), 32, info, strlen(info), sess.ke.data(), 32);
+    }
+
+    // 7. R-auth = SHA256(I-nonce||R-nonce||PI.x||PR.x||BR.x||0x00)
+    // Helper: get x-coordinate (32B) from EVP_PKEY via SPKI DER (reliable across platforms)
+    auto get_x_coord = [](EVP_PKEY *key, uint8_t out[32]) -> bool {
+        unsigned char *der = nullptr;
+        int der_len = i2d_PUBKEY(key, &der);
+        // P-256 uncompressed: 91 bytes, uncompressed prefix at [26]
+        bool ok = false;
+        if (der_len == 91 && der && der[26] == 0x04) {
+            memcpy(out, der + 27, 32); ok = true;
+        } else if (der) {
+            // Fallback: try EVP_PKEY_get_octet_string_param
+            size_t len = 0;
+            std::vector<uint8_t> buf;
+            EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY, nullptr, 0, &len);
+            buf.resize(len);
+            EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY, buf.data(), len, &len);
+            if ((len==65 && buf[0]==0x04) || (len==33 && (buf[0]==0x02||buf[0]==0x03))) {
+                memcpy(out, buf.data()+1, 32); ok = true;
+            }
+        }
+        if (der) OPENSSL_free(der);
+        return ok;
+    };
+    uint8_t r_auth[32];
+    {
+        uint8_t pr_x[32]={}, pi_x[32]={}, br_x[32]={};
+        bool pr_ok = get_x_coord(sess.agent_protocol_key,     pr_x);
+        bool pi_ok = get_x_coord(sess.initiator_protocol_key, pi_x);
+        bool br_ok = get_x_coord(db->dpp_bootstrap.private_key, br_x);
+        LOG(DEBUG) << "DPP: R-auth pr_ok=" << pr_ok << " pi_ok=" << pi_ok << " br_ok=" << br_ok;
+
+        // R-auth = SHA256(I-nonce||R-nonce||PI.x||PR.x||BR.x||0x00)
+        {
+            EVP_MD_CTX *md = EVP_MD_CTX_new();
+            uint8_t zero = 0;
+            unsigned int out_len = 32;
+            EVP_DigestInit_ex(md, EVP_sha256(), nullptr);
+            EVP_DigestUpdate(md, sess.i_nonce.data(), 16);
+            EVP_DigestUpdate(md, sess.r_nonce.data(), 16);
+            if (pi_ok) EVP_DigestUpdate(md, pi_x, 32);
+            if (pr_ok) EVP_DigestUpdate(md, pr_x, 32);
+            if (br_ok) EVP_DigestUpdate(md, br_x, 32);
+            EVP_DigestUpdate(md, &zero, 1);
+            EVP_DigestFinal_ex(md, r_auth, &out_len);
+            EVP_MD_CTX_free(md);
+        }
+    }
+
+    // 8. Build Auth Response frame
+    // Header: 0x09 50:6F:9A 0x1A 0x01 0x01(Auth Response)
+    static const uint8_t hdr[] = {0x09, 0x50, 0x6F, 0x9A, 0x1A, 0x01, 0x01};
+    std::vector<uint8_t> frame(hdr, hdr + sizeof(hdr));
+
+    // Status=OK, R-Bootstrap-Hash, R-Protocol-Key in pre-attrs
+    uint8_t own_bs_hash[32];
+    SHA256(db->dpp_bootstrap.key_der.data(), db->dpp_bootstrap.key_der.size(), own_bs_hash);
+
+    std::vector<uint8_t> pre_attrs;
+    uint8_t status_ok = 0;
+    append_attr(pre_attrs, DPP_ATTR_STATUS, &status_ok, 1);
+    append_attr(pre_attrs, DPP_ATTR_R_BOOTSTRAP_HASH, own_bs_hash, 32);
+    {
+        // Export PR as uncompressed 64-byte x||y for the Auth Response attribute.
+        // Use i2d_PUBKEY → SPKI DER, then extract the 65-byte uncompressed point
+        // (skip the 26-byte SPKI header). This guarantees the exported bytes match
+        // what the controller can re-import for correct ECDH.
+        uint8_t pr_raw[65] = {}; size_t pr_len = 0;
+        {
+            unsigned char *spki_der = nullptr;
+            int spki_len = i2d_PUBKEY(sess.agent_protocol_key, &spki_der);
+            // P-256 uncompressed SPKI DER = 91 bytes: 26-byte header + 0x04 + 64B x||y
+            if (spki_len == 91 && spki_der && spki_der[26] == 0x04) {
+                pr_raw[0] = 0x04;
+                memcpy(pr_raw + 1, spki_der + 27, 64);
+                pr_len = 65;
+            }
+            if (spki_der) OPENSSL_free(spki_der);
+        }
+        LOG(DEBUG) << "DPP: PR export actual_len=" << pr_len;
+        LOG(DEBUG) << "DPP: PR export pr_len=" << pr_len
+                   << " pr_raw[0]=0x" << std::hex << (int)pr_raw[0] << std::dec;
+        if (pr_len >= 65)
+            append_attr(pre_attrs, DPP_ATTR_R_PROTOCOL_KEY, pr_raw + 1, 64);
+        else
+            LOG(ERROR) << "DPP: failed to export PR public key for Auth Response (pr_len=" << pr_len << ")";
+        LOG(DEBUG) << "DPP: PR sent x=" << [&](){std::string h;char b[3];
+            for(int i=1;i<=32;i++){snprintf(b,3,"%02x",pr_raw[i]);h+=b;}return h;}()
+                   << " y=" << [&](){std::string h;char b[3];
+            for(int i=33;i<=64;i++){snprintf(b,3,"%02x",pr_raw[i]);h+=b;}return h;}();
+    }
+    // DPP Protocol Version = 2 per EasyMesh v6.1 §5.3.3 and qca-ezmesh interop (INTEROP-01).
+    uint8_t proto_ver = 2;
+    append_attr(pre_attrs, DPP_ATTR_PROTOCOL_VERSION, &proto_ver, 1);
+
+    // Outer Wrapped Data = {R-nonce, I-nonce, R-caps, {R-auth}ke}k2
+    // Build inner first: {R-auth}ke
+    std::vector<uint8_t> inner_plain;
+    append_attr(inner_plain, DPP_ATTR_R_AUTH_TAG, r_auth, 32);
+    std::vector<uint8_t> inner_ct;
+    aes_siv_encrypt(sess.ke.data(), 32, inner_plain.data(), inner_plain.size(), {}, inner_ct);
+
+    // Outer plaintext: R-nonce, I-nonce, R-caps, inner
+    std::vector<uint8_t> outer_plain;
+    append_attr(outer_plain, DPP_ATTR_R_NONCE, sess.r_nonce.data(), 16);
+    append_attr(outer_plain, DPP_ATTR_I_NONCE, sess.i_nonce.data(), 16);
+    uint8_t r_caps = 0x01; // Enrollee
+    append_attr(outer_plain, DPP_ATTR_R_CAPABILITIES, &r_caps, 1);
+    append_attr(outer_plain, DPP_ATTR_WRAPPED_DATA, inner_ct.data(),
+                static_cast<uint16_t>(inner_ct.size()));
+
+    // Outer AAD: [frame[1..7]] + [pre_attrs]
+    std::vector<uint8_t> aad1(frame.begin() + 1, frame.end());
+    std::vector<uint8_t> outer_ct;
+    aes_siv_encrypt(k2.data(), 32, outer_plain.data(), outer_plain.size(),
+                    {aad1, pre_attrs}, outer_ct);
+
+    frame.insert(frame.end(), pre_attrs.begin(), pre_attrs.end());
+    append_attr(frame, DPP_ATTR_WRAPPED_DATA, outer_ct.data(),
+                static_cast<uint16_t>(outer_ct.size()));
+
+    // Send as DIRECT_ENCAP_DPP_MESSAGE
+    auto cmdu_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+    if (!cmdu_header) return false;
+    auto dpp_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppMessage>();
+    if (!dpp_tlv) return false;
+    if (!dpp_tlv->alloc_dpp_frame(frame.size())) return false;
+    memcpy(dpp_tlv->dpp_frame(), frame.data(), frame.size());
+
+    LOG(INFO) << "DPP: sending Auth Response to " << controller_mac;
+    m_auth_response_sent_time = std::chrono::steady_clock::now();
+    return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
+
+bool DppAgentTask::handle_dpp_wired_auth_confirm(
+    const sMacAddr &src_mac, const uint8_t *frame, size_t frame_len)
+{
+    LOG(INFO) << "DPP: wired Auth Confirm from " << src_mac;
+
+    auto db = AgentDB::get();
+    auto &sess = db->dpp_wired_session;
+
+    if (frame_len < 7) return false;
+    const uint8_t *attrs = frame + 7;
+    size_t attrs_len     = frame_len - 7;
+
+    // Check DPP Status attribute first — failure Auth Confirm has no Wrapped Data.
+    uint16_t status_len = 0;
+    const uint8_t *status_val = find_attr(attrs, attrs_len, DPP_ATTR_STATUS, &status_len);
+    if (status_val && status_len >= 1 && status_val[0] != 0 /* DPP_STATUS_OK */) {
+        LOG(WARNING) << "DPP: Auth Confirm failure status=" << (int)status_val[0]
+                     << " from " << src_mac << " — resetting session and restarting Search";
+        sess.reset();
+        m_auth_response_sent_time = {};
+        m_btl_ctx.task_pool_send_event(
+            eTaskType::AP_AUTOCONFIGURATION,
+            static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::INIT_TASK));
+        m_btl_ctx.task_pool_send_event(
+            eTaskType::AP_AUTOCONFIGURATION,
+            static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION));
+        return true;
+    }
+
+    const uint8_t *wd_val = nullptr; uint16_t wd_len = 0;
+    size_t wd_offset = 0;
+    {
+        size_t off = 0;
+        while (off + 4 <= attrs_len) {
+            uint16_t id = attrs[off] | (static_cast<uint16_t>(attrs[off+1]) << 8);
+            uint16_t ln = attrs[off+2] | (static_cast<uint16_t>(attrs[off+3]) << 8);
+            if (id == DPP_ATTR_WRAPPED_DATA) { wd_val = attrs+off+4; wd_len = ln; wd_offset = off; break; }
+            off += 4 + ln;
+        }
+    }
+    if (!wd_val || wd_len < 16) {
+        LOG(ERROR) << "DPP: Auth Confirm missing Wrapped Data — resetting session";
+        sess.reset();
+        m_auth_response_sent_time = {};
+        m_btl_ctx.task_pool_send_event(eTaskType::AP_AUTOCONFIGURATION,
+            static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::INIT_TASK));
+        m_btl_ctx.task_pool_send_event(eTaskType::AP_AUTOCONFIGURATION,
+            static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION));
+        return false;
+    }
+
+    // AAD: [frame[1..7]] + [attrs before Wrapped Data]
+    std::vector<uint8_t> aad1(frame + 1, frame + 7);
+    std::vector<uint8_t> aad2(attrs, attrs + wd_offset);
+    std::vector<uint8_t> inner;
+    if (!aes_siv_decrypt(sess.ke.data(), 32, wd_val, wd_len, {aad1, aad2}, inner)) {
+        LOG(ERROR) << "DPP: Auth Confirm ke decrypt failed — resetting session";
+        sess.reset();
+        m_auth_response_sent_time = {};
+        m_btl_ctx.task_pool_send_event(eTaskType::AP_AUTOCONFIGURATION,
+            static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::INIT_TASK));
+        m_btl_ctx.task_pool_send_event(eTaskType::AP_AUTOCONFIGURATION,
+            static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION));
+        return false;
+    }
+
+    // Extract I-auth tag
+    uint16_t i_auth_len = 0;
+    const uint8_t *i_auth_val = find_attr(inner.data(), inner.size(), DPP_ATTR_I_AUTH_TAG, &i_auth_len);
+    if (!i_auth_val || i_auth_len < 32) {
+        LOG(ERROR) << "DPP: Auth Confirm missing I-auth tag";
+        return false;
+    }
+
+    // Verify I-auth = SHA256(R-nonce||I-nonce||PR.x||PI.x||BR.x||1)
+    {
+        auto get_x = [](EVP_PKEY *key, uint8_t out[32]) -> bool {
+            unsigned char *der = nullptr;
+            int der_len = i2d_PUBKEY(key, &der);
+            bool ok = false;
+            if (der_len == 91 && der && der[26] == 0x04) {
+                memcpy(out, der + 27, 32); ok = true;
+            } else if (der) {
+                size_t len = 0;
+                std::vector<uint8_t> buf;
+                EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY, nullptr, 0, &len);
+                buf.resize(len);
+                EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY, buf.data(), len, &len);
+                if ((len==65 && buf[0]==0x04) || (len==33 && (buf[0]==0x02||buf[0]==0x03))) {
+                    memcpy(out, buf.data()+1, 32); ok = true;
+                }
+            }
+            if (der) OPENSSL_free(der);
+            return ok;
+        };
+        uint8_t pr_x[32]={}, pi_x[32]={}, br_x[32]={};
+        bool pr_ok = get_x(sess.agent_protocol_key,     pr_x);
+        bool pi_ok = get_x(sess.initiator_protocol_key, pi_x);
+        bool br_ok = get_x(db->dpp_bootstrap.private_key, br_x);
+
+        uint8_t expected[32] = {};
+        {
+            EVP_MD_CTX *md = EVP_MD_CTX_new();
+            uint8_t one = 1;
+            unsigned int out_len = 32;
+            EVP_DigestInit_ex(md, EVP_sha256(), nullptr);
+            EVP_DigestUpdate(md, sess.r_nonce.data(), 16);
+            EVP_DigestUpdate(md, sess.i_nonce.data(), 16);
+            if (pr_ok) EVP_DigestUpdate(md, pr_x, 32);
+            if (pi_ok) EVP_DigestUpdate(md, pi_x, 32);
+            if (br_ok) EVP_DigestUpdate(md, br_x, 32);
+            // BI.x omitted — no mutual auth in EasyMesh wired flow
+            EVP_DigestUpdate(md, &one, 1);
+            EVP_DigestFinal_ex(md, expected, &out_len);
+            EVP_MD_CTX_free(md);
+        }
+
+        if (memcmp(expected, i_auth_val, 32) != 0) {
+            LOG(ERROR) << "DPP: I-auth tag mismatch — Auth Confirm rejected, resetting session";
+            sess.reset();
+            m_auth_response_sent_time = {};
+            m_btl_ctx.task_pool_send_event(eTaskType::AP_AUTOCONFIGURATION,
+                static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::INIT_TASK));
+            m_btl_ctx.task_pool_send_event(eTaskType::AP_AUTOCONFIGURATION,
+                static_cast<uint8_t>(ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION));
+            return false;
+        }
+    }
+
+    LOG(INFO) << "DPP: wired Auth Confirm verified — authentication complete";
+    LOG(INFO) << "DPP: ke (session key) established with " << src_mac;
+    m_auth_response_sent_time = {};  // clear timeout — Auth Confirm received
+
+    // Auth complete — transition to GAS Config Request phase (TASK-19)
+    return build_gas_config_request(src_mac);
+}
+
+bool DppAgentTask::build_gas_config_request(const sMacAddr &controller_mac)
+{
+    auto db = AgentDB::get();
+    auto &sess = db->dpp_wired_session;
+
+    LOG(INFO) << "DPP: building GAS Config Request to " << controller_mac;
+
+    // Generate E-nonce (16 random bytes)
+    RAND_bytes(sess.e_nonce.data(), 16);
+
+    // Build configRequest JSON
+    const std::string config_req_json =
+        "{\"name\":\"prplMesh\",\"wi-fi_tech\":\"map\",\"netRole\":\"mapAgent\"}";
+
+    // Build plaintext: {E-nonce, configRequest}
+    std::vector<uint8_t> plaintext;
+    append_attr(plaintext, DPP_ATTR_ENROLLEE_NONCE,
+                sess.e_nonce.data(), 16);
+    append_attr(plaintext, static_cast<uint16_t>(0x100B) /* DPP_ATTR_CONFIG_REQUEST_OBJ */,
+                reinterpret_cast<const uint8_t *>(config_req_json.data()),
+                static_cast<uint16_t>(config_req_json.size()));
+
+    // Encrypt with ke (no AAD for Config Request per Easy Connect §8.1)
+    std::vector<uint8_t> wrapped;
+    if (!aes_siv_encrypt(sess.ke.data(), 32,
+                          plaintext.data(), plaintext.size(), {}, wrapped)) {
+        LOG(ERROR) << "DPP: GAS Config Request AES-SIV encrypt failed";
+        return false;
+    }
+
+    // Build DPP attributes payload: Wrapped Data only
+    std::vector<uint8_t> dpp_attrs;
+    append_attr(dpp_attrs, DPP_ATTR_WRAPPED_DATA,
+                wrapped.data(), static_cast<uint16_t>(wrapped.size()));
+
+    // Build GAS Initial Request frame
+    // Format (no Category byte per EasyMesh §17.2.79):
+    // Action(0x0A) + DialogToken(1) + AdvProto(10) + QueryReqLen(2) + DPP attrs
+    sess.gas_dialog_token = static_cast<uint8_t>(rand() & 0xFF);
+
+    std::vector<uint8_t> gas_frame;
+    gas_frame.push_back(0x0A);               // GAS Initial Request Action
+    gas_frame.push_back(sess.gas_dialog_token);
+
+    // Advertisement Protocol element: 0x6C 0x08 0x7F 0xDD 0x05 50:6F:9A 0x1A 0x01
+    static const uint8_t adv_proto[] = {
+        0x6C, 0x08, 0x7F, 0xDD, 0x05, 0x50, 0x6F, 0x9A, 0x1A, 0x01
+    };
+    gas_frame.insert(gas_frame.end(), adv_proto, adv_proto + sizeof(adv_proto));
+
+    // Query Request Length (LE)
+    uint16_t qr_len = static_cast<uint16_t>(dpp_attrs.size());
+    gas_frame.push_back(qr_len & 0xFF);
+    gas_frame.push_back((qr_len >> 8) & 0xFF);
+
+    // Query Request = DPP attributes
+    gas_frame.insert(gas_frame.end(), dpp_attrs.begin(), dpp_attrs.end());
+
+    // Send as DIRECT_ENCAP_DPP_MESSAGE to controller
+    auto cmdu_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+    if (!cmdu_header) return false;
+    auto dpp_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppMessage>();
+    if (!dpp_tlv) return false;
+    if (!dpp_tlv->alloc_dpp_frame(gas_frame.size())) return false;
+    memcpy(dpp_tlv->dpp_frame(), gas_frame.data(), gas_frame.size());
+
+    LOG(INFO) << "DPP: sending GAS Config Request (" << gas_frame.size()
+              << " bytes) to " << controller_mac
+              << " dialog_token=0x" << std::hex << (int)sess.gas_dialog_token;
+    LOG(DEBUG) << "DPP: GAS Config Request plaintext_len=" << plaintext.size()
+               << " wrapped_len=" << wrapped.size()
+               << " dpp_attrs_len=" << dpp_attrs.size();
+    LOG(DEBUG) << "DPP: GAS Config Request e_nonce="
+               << [&]() { std::string h; char b[3];
+                   for (auto c : sess.e_nonce) { snprintf(b,3,"%02x",c); h+=b; }
+                   return h; }();
+    return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
+
+bool DppAgentTask::handle_dpp_wired_gas_response(const sMacAddr &src_mac,
+                                                           const uint8_t *frame, size_t frame_len)
+{
+    auto db   = AgentDB::get();
+    auto &sess = db->dpp_wired_session;
+
+    LOG(INFO) << "DPP: wired GAS Config Response from " << src_mac
+              << " (" << frame_len << " bytes)";
+    LOG(DEBUG) << "DPP: GAS Response action=0x" << std::hex << (int)frame[0]
+               << " dialog_token=0x" << (int)frame[1] << std::dec;
+
+    // GAS Initial Response format (no Category byte):
+    // Action(0x0B) + DialogToken(1) + StatusCode(2) + ComebackDelay(2) + AdvProto(10)
+    // + QueryRespLen(2) + DPP attributes
+    if (frame_len < 16 || frame[0] != 0x0B) {
+        LOG(ERROR) << "DPP: invalid GAS Response frame";
+        return false;
+    }
+
+    uint8_t dialog_token = frame[1];
+    if (dialog_token != sess.gas_dialog_token) {
+        LOG(WARNING) << "DPP: GAS Response dialog token mismatch: got 0x"
+                     << std::hex << (int)dialog_token
+                     << " expected 0x" << (int)sess.gas_dialog_token;
+    }
+
+    // Skip to DPP attributes: Action(1)+Token(1)+Status(2)+Delay(2)+AdvProto(10)+QRLen(2)=18
+    if (frame_len < 18) { LOG(ERROR) << "DPP: GAS Response too short"; return false; }
+    uint16_t qr_len = frame[16] | (static_cast<uint16_t>(frame[17]) << 8);
+    if (frame_len < static_cast<size_t>(18) + qr_len) { LOG(ERROR) << "DPP: GAS Response truncated"; return false; }
+    const uint8_t *attrs = frame + 18;
+    size_t attrs_len     = qr_len;
+
+    // Find Status attribute
+    uint16_t status_len = 0;
+    const uint8_t *status_val = find_attr(attrs, attrs_len, DPP_ATTR_STATUS, &status_len);
+    if (!status_val || status_len < 1 || status_val[0] != 0) {
+        LOG(ERROR) << "DPP: GAS Config Response status != OK: "
+                   << (status_val ? (int)status_val[0] : -1);
+        return false;
+    }
+    LOG(DEBUG) << "DPP: GAS Config Response status=OK attrs_len=" << attrs_len;
+
+    // Decrypt Wrapped Data with ke
+    uint16_t wd_len = 0;
+    const uint8_t *wd_val = find_attr(attrs, attrs_len, DPP_ATTR_WRAPPED_DATA, &wd_len);
+    if (!wd_val || wd_len < 16) {
+        LOG(ERROR) << "DPP: GAS Config Response missing Wrapped Data";
+        return false;
+    }
+
+    // AAD for Config Response: all attrs before Wrapped Data
+    size_t wd_offset = static_cast<size_t>(wd_val - 4 - attrs);
+    std::vector<uint8_t> aad_attrs(attrs, attrs + wd_offset);
+    std::vector<uint8_t> plaintext;
+    if (!aes_siv_decrypt(sess.ke.data(), 32, wd_val, wd_len, {aad_attrs}, plaintext)) {
+        LOG(ERROR) << "DPP: GAS Config Response AES-SIV decrypt failed"
+                   << " wd_len=" << wd_len << " aad_len=" << aad_attrs.size();
+        return false;
+    }
+    LOG(DEBUG) << "DPP: GAS Config Response decrypted ok, plaintext_len=" << plaintext.size();
+
+    // Verify E-nonce
+    uint16_t e_nonce_len = 0;
+    const uint8_t *e_nonce_val = find_attr(plaintext.data(), plaintext.size(),
+                                            DPP_ATTR_ENROLLEE_NONCE, &e_nonce_len);
+    if (!e_nonce_val || e_nonce_len < 16 ||
+        memcmp(e_nonce_val, sess.e_nonce.data(), 16) != 0) {
+        LOG(ERROR) << "DPP: GAS Config Response E-nonce mismatch";
+        return false;
+    }
+    LOG(DEBUG) << "DPP: GAS Config Response E-nonce verified ok";
+
+    // Extract config objects (DPP_ATTR_CONFIG_OBJ = 0x100C)
+    static constexpr uint16_t DPP_ATTR_CONFIG_OBJ = 0x100C;
+    size_t offset = 0;
+    bool found_1905_connector = false;
+
+    while (offset + 4 <= plaintext.size()) {
+        uint16_t id  = plaintext[offset] | (static_cast<uint16_t>(plaintext[offset+1]) << 8);
+        uint16_t len = plaintext[offset+2] | (static_cast<uint16_t>(plaintext[offset+3]) << 8);
+        if (offset + 4 + len > plaintext.size()) break;
+        const uint8_t *val = plaintext.data() + offset + 4;
+
+        if (id == DPP_ATTR_CONFIG_OBJ) {
+            std::string json(reinterpret_cast<const char *>(val), len);
+            LOG(INFO) << "DPP: config object (" << len << " bytes): "
+                      << json.substr(0, 80) << (len > 80 ? "..." : "");
+
+            // Identify 1905-layer config object: contains "map_bss_type" (unique to 1905 config)
+            // or akm=dpp (as opposed to bSTA config which uses akm=506F9A02+000FAC08).
+            // Note: "mapAgent" is inside the base64-encoded JWT, not in the outer JSON.
+            if (json.find("\"map_bss_type\"") != std::string::npos ||
+                (json.find("\"akm\":\"dpp\"") != std::string::npos &&
+                 json.find("\"signedConnector\"") != std::string::npos)) {
+
+                // Extract signedConnector
+                auto conn_pos = json.find("\"signedConnector\":\"");
+                if (conn_pos != std::string::npos) {
+                    conn_pos += 19;
+                    auto conn_end = json.find('"', conn_pos);
+                    if (conn_end != std::string::npos) {
+                        db->dpp_credentials.connector = json.substr(conn_pos, conn_end - conn_pos);
+                        LOG(INFO) << "DPP: stored 1905 connector (mapAgent)";
+                        found_1905_connector = true;
+                    }
+                }
+
+                // Extract c-sign-key JWK
+                auto csign_pos = json.find("\"csign\":");
+                if (csign_pos != std::string::npos) {
+                    csign_pos += 8;
+                    // Find matching closing brace for the JWK object
+                    int depth = 0; size_t end = csign_pos;
+                    for (; end < json.size(); ++end) {
+                        if (json[end] == '{') ++depth;
+                        else if (json[end] == '}') { if (--depth == 0) { ++end; break; } }
+                    }
+                    db->dpp_credentials.c_sign_key_jwk = json.substr(csign_pos, end - csign_pos);
+                }
+
+                // dfCounterThreshold
+                auto dct_pos = json.find("\"dfCounterThreshold\":");
+                if (dct_pos != std::string::npos) {
+                    const char *s = json.c_str() + dct_pos + 21;
+                    char *end_ptr = nullptr;
+                    long v = strtol(s, &end_ptr, 10);
+                    if (end_ptr != s && v >= 0 && v <= 65535) {
+                        db->dpp_credentials.df_counter_threshold = static_cast<uint16_t>(v);
+                    }
+                }
+            }
+        } else if (id == DPP_ATTR_NET_ACCESS_KEY /* 0x100E */ || id == 0x100E) {
+            // netAccessKey private key — store as DER
+            db->dpp_credentials.nak_private_der.assign(val, val + len);
+            LOG(INFO) << "DPP: stored netAccessKey private key (" << len << " bytes)";
+        }
+        offset += 4 + len;
+    }
+
+    if (!found_1905_connector || db->dpp_credentials.nak_private_der.empty()) {
+        // The prplMesh controller embeds the NAK public key inside the signedConnector JWT
+        // (as "netAccessKey" claim) rather than as a separate DPP_ATTR_NET_ACCESS_KEY TLV.
+        // The NAK private key is sess.agent_protocol_key (pR) — the ephemeral key whose
+        // public part was sent as R-Protocol-Key in the Auth Response and used by the
+        // controller to sign the connector.
+        // Export it as traditional EC DER (SEC1 format) matching the OSSL_DECODER expectation.
+        if (found_1905_connector && db->dpp_credentials.nak_private_der.empty()
+                && sess.agent_protocol_key) {
+            BIO *bio = BIO_new(BIO_s_mem());
+            if (bio) {
+                if (PEM_write_bio_PrivateKey_traditional(bio, sess.agent_protocol_key,
+                                                          nullptr, nullptr, 0,
+                                                          nullptr, nullptr) == 1) {
+                    // Store as EVP_PKEY* loaded via traditional PEM path (correct ECDH)
+                    EVP_PKEY *reloaded = PEM_read_bio_PrivateKey(bio, nullptr, nullptr, nullptr);
+                    if (reloaded) {
+                        if (db->dpp_credentials.nak_pkey) EVP_PKEY_free(db->dpp_credentials.nak_pkey);
+                        db->dpp_credentials.nak_pkey = reloaded;
+                        // Also export DER for wireless/fallback path
+                        unsigned char *der = nullptr;
+                        int der_len = i2d_PrivateKey(reloaded, &der);
+                        if (der_len > 0 && der) {
+                            db->dpp_credentials.nak_private_der.assign(der, der + der_len);
+                            OPENSSL_free(der);
+                        }
+                        LOG(INFO) << "DPP: stored NAK private key from pR (pkey+der)";
+                    }
+                }
+                BIO_free(bio);
+            }
+            if (!db->dpp_credentials.nak_pkey) {
+                LOG(ERROR) << "DPP: failed to export pR as NAK private key";
+            }
+        }
+    }
+
+    if (!found_1905_connector || db->dpp_credentials.nak_private_der.empty()) {
+        LOG(ERROR) << "DPP: GAS Config Response missing connector or NAK key"
+                   << " connector=" << found_1905_connector
+                   << " nak_len=" << db->dpp_credentials.nak_private_der.size();
+        return false;
+    }
+
+    db->dpp_credentials.initialized = true;
+    LOG(INFO) << "DPP: credentials initialized — sending Config Result";
+
+    // Send DPP Config Result (status=OK)
+    {
+        static const uint8_t result_hdr[] = {0x09, 0x50, 0x6F, 0x9A, 0x1A, 0x01, 0x0B};
+        std::vector<uint8_t> result_frame(result_hdr, result_hdr + sizeof(result_hdr));
+        // Status=OK + Wrapped{Status}ke
+        std::vector<uint8_t> status_inner;
+        uint8_t status_ok = 0;
+        append_attr(status_inner, DPP_ATTR_STATUS, &status_ok, 1);
+        std::vector<uint8_t> status_attr;
+        append_attr(status_attr, DPP_ATTR_STATUS, &status_ok, 1);
+        std::vector<uint8_t> oui_hdr(result_hdr + 1, result_hdr + sizeof(result_hdr));
+        std::vector<uint8_t> wrapped_result;
+        aes_siv_encrypt(sess.ke.data(), 32,
+                         status_inner.data(), status_inner.size(),
+                         {oui_hdr, status_attr}, wrapped_result);
+        append_attr(result_frame, DPP_ATTR_STATUS, &status_ok, 1);
+        append_attr(result_frame, DPP_ATTR_WRAPPED_DATA,
+                    wrapped_result.data(), static_cast<uint16_t>(wrapped_result.size()));
+
+        auto cmdu_hdr = m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+        auto result_tlv = cmdu_hdr ? m_cmdu_tx.addClass<wfa_map::tlvDppMessage>() : nullptr;
+        if (result_tlv && result_tlv->alloc_dpp_frame(result_frame.size())) {
+            memcpy(result_tlv->dpp_frame(), result_frame.data(), result_frame.size());
+            m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+            LOG(INFO) << "DPP: sent Config Result to " << src_mac;
+        }
+    }
+
+    // If controller did not include 0xA9 TLV in AP-Autoconfig Response (§17.1.2),
+    // link encryption is disabled — skip Peer Discovery and EAPOL, go straight to BSS Config.
+    if (!db->dpp_extender_config.controller_requires_1905_security) {
+        // Start TCP relay server now (no 4-way handshake will follow)
+        m_btl_ctx.start_dpp_tcp_relay_server();
+        LOG(INFO) << "DPP: 0xA9 absent in autoconfig response"
+                  << " — skipping Peer Discovery+EAPOL, sending BSS Config Request";
+        return send_bss_configuration_request(src_mac);
+    }
+
+    // Initiate Peer Discovery — TCP relay server starts after 4-way handshake completes
+    return initiate_peer_discovery(src_mac);
+}
+
+bool DppAgentTask::initiate_peer_discovery(const sMacAddr &controller_mac)
+{
+    auto db = AgentDB::get();
+    if (!db->dpp_credentials.initialized || db->dpp_credentials.connector.empty()) {
+        LOG(ERROR) << "DPP: cannot initiate Peer Discovery — credentials not ready";
+        return false;
+    }
+
+    LOG(INFO) << "DPP: initiating Peer Discovery with " << controller_mac;
+
+    // Build Peer Discovery Request frame (DPP_PA_PEER_DISCOVERY_REQ = 0x05)
+    static const uint8_t hdr[] = {0x09, 0x50, 0x6F, 0x9A, 0x1A, 0x01, 0x05};
+    std::vector<uint8_t> frame(hdr, hdr + sizeof(hdr));
+
+    // Transaction ID
+    uint8_t tx_id = 1;
+    append_attr(frame, DPP_ATTR_TRANS_ID, &tx_id, 1);
+
+    // Connector
+    append_attr(frame, DPP_ATTR_CONNECTOR,
+                reinterpret_cast<const uint8_t *>(db->dpp_credentials.connector.data()),
+                static_cast<uint16_t>(db->dpp_credentials.connector.size()));
+
+    auto cmdu_hdr = m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+    if (!cmdu_hdr) return false;
+    auto dpp_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppMessage>();
+    if (!dpp_tlv) return false;
+    if (!dpp_tlv->alloc_dpp_frame(frame.size())) return false;
+    memcpy(dpp_tlv->dpp_frame(), frame.data(), frame.size());
+
+    LOG(INFO) << "DPP: sent Peer Discovery Request to " << controller_mac;
+    return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
+
+bool DppAgentTask::send_bss_configuration_request(const sMacAddr &controller_mac)
+{
+    LOG(INFO) << "DPP: preparing BSS_CONFIGURATION_REQUEST (0x802C) to " << controller_mac;
+
+    // Per EasyMesh spec §17.1.X, BSS Config Request must include all AP capability TLVs.
+    // Create the CMDU header first, then let CapabilityReportingTask fill all capability TLVs,
+    // then append the BSS Configuration Request TLV with the DPP JSON object.
+    auto cmdu_hdr = m_cmdu_tx.create(
+        0, ieee1905_1::eMessageType::BSS_CONFIGURATION_REQUEST_MESSAGE);
+    if (!cmdu_hdr) {
+        LOG(ERROR) << "DPP: failed to create BSS_CONFIGURATION_REQUEST_MESSAGE";
+        return false;
+    }
+
+    // Fill all spec-required capability TLVs (Multi-AP Profile, SupportedService,
+    // AP Capability, AP Radio Basic Capabilities per radio, AKM Suite, etc.)
+    auto cap_task = m_btl_ctx.get_capability_reporting_task();
+    if (cap_task) {
+        if (!cap_task->prepare_ap_capability_message(false)) {
+            LOG(WARNING) << "DPP: prepare_ap_capability_message failed — sending minimal request";
+        }
+    } else {
+        LOG(WARNING) << "DPP: CapabilityReportingTask not available — adding minimal RUIDs only";
+        // Fallback: add AP Radio Basic Capabilities TLVs manually for RUIDs
+        auto db = AgentDB::get();
+        for (const auto &radio : db->get_radios_list()) {
+            if (!radio) continue;
+            auto tlv = m_cmdu_tx.addClass<wfa_map::tlvApRadioBasicCapabilities>();
+            if (tlv) tlv->radio_uid() = radio->front.iface_mac;
+        }
+    }
+
+    // Print all RUIDs being sent
+    auto db = AgentDB::get();
+    LOG(INFO) << "DPP: BSS Config Request — radios:";
+    for (const auto &radio : db->get_radios_list()) {
+        if (!radio) continue;
+        LOG(INFO) << "DPP:   RUID=" << radio->front.iface_mac
+                  << " iface=" << radio->front.iface_name
+                  << " channel=" << radio->wifi_channel.get_channel()
+                  << " bw=" << radio->wifi_channel.get_bandwidth()
+                  << " num_bssids=" << radio->front.bssids.size();
+        for (const auto &bss : radio->front.bssids) {
+            if (bss.mac == beerocks::net::network_utils::ZERO_MAC) continue;
+            LOG(INFO) << "DPP:     BSS mac=" << bss.mac
+                      << " ssid=" << bss.ssid
+                      << " fh=" << bss.fronthaul_bss
+                      << " bh=" << bss.backhaul_bss;
+        }
+    }
+
+    // Append the BSS Configuration Request TLV with DPP JSON object
+    const std::string req_json =
+        "{\"name\":\"prplMesh\",\"wi-fi_tech\":\"map\",\"netRole\":\"mapAgent\"}";
+
+    auto tlv = m_cmdu_tx.addClass<wfa_map::tlvBssConfigurationRequest>();
+    if (!tlv) {
+        LOG(ERROR) << "DPP: failed to add tlvBssConfigurationRequest";
+        return false;
+    }
+
+    if (!tlv->set_dpp_configuration_request_object(req_json.data(), req_json.size())) {
+        LOG(ERROR) << "DPP: failed to set BSS config request JSON";
+        return false;
+    }
+
+    LOG(INFO) << "DPP: BSS Config Request JSON (full, no truncation): " << req_json;
+    LOG(INFO) << "DPP: sending BSS_CONFIGURATION_REQUEST to " << controller_mac;
+    return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
+
+bool DppAgentTask::handle_agent_list(const sMacAddr &src_mac,
+                                               ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto agent_list_tlv = cmdu_rx.getClass<wfa_map::tlvAgentList>();
+    if (!agent_list_tlv) {
+        LOG(WARNING) << "AGENT_LIST: missing tlvAgentList — message may be encrypted"
+                     << " or TK not yet propagated to transport. Ignoring.";
+        return true;
+    }
+
+    auto db = AgentDB::get();
+
+    LOG(INFO) << "AGENT_LIST: received with " << (int)agent_list_tlv->number_of_agents() << " agents";
+
+    // Per EasyMesh Figure 17: on receiving Agent List (sent by controller after BSS Config Result),
+    // the extender is fully integrated. No BSS Config Request is needed here — that was already
+    // sent after the 4-way handshake, before this Agent List arrived.
+    // Agent List is just a notification about the network topology.
+
+    for (uint8_t i = 0; i < agent_list_tlv->number_of_agents(); i++) {
+        auto entry = agent_list_tlv->agents(i);
+        if (!std::get<0>(entry)) continue;
+        const auto &e = std::get<1>(entry);
+
+        // Skip ourselves
+        if (e.al_mac == db->bridge.mac) {
+            LOG(DEBUG) << "AGENT_LIST: skipping self " << e.al_mac;
+            continue;
+        }
+
+        bool security_enabled =
+            (e.security == wfa_map::tlvAgentList::IEEE1905_ENABLED);
+
+        LOG(DEBUG) << "AGENT_LIST: peer=" << e.al_mac
+                   << " profile=" << (int)e.multi_ap_profile
+                   << " security=" << (security_enabled ? "ENABLED" : "DISABLED");
+
+        if (!security_enabled) {
+            // Remove any existing security state for this peer
+            db->peer_1905_security.erase(e.al_mac);
+            continue;
+        }
+
+        // Check if we already have a valid TK with this peer
+        auto it = db->peer_1905_security.find(e.al_mac);
+        if (it != db->peer_1905_security.end() && it->second.tk_valid) {
+            LOG(DEBUG) << "AGENT_LIST: TK already established with " << e.al_mac;
+            continue;
+        }
+
+        // Check if we have our own DPP credentials
+        if (!db->dpp_credentials.initialized || db->dpp_credentials.connector.empty()) {
+            LOG(WARNING) << "AGENT_LIST: DPP credentials not ready — cannot establish "
+                            "1905 security with " << e.al_mac;
+            continue;
+        }
+
+        // Initiate 1905 Network Introduction with this peer
+        LOG(INFO) << "AGENT_LIST: initiating 1905 security with peer " << e.al_mac;
+        initiate_1905_network_introduction(e.al_mac);
+    }
+
+    return true;
+}
+
+bool DppAgentTask::handle_1905_encap_eapol(const sMacAddr &src_mac,
+                                                      ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // See handle_direct_encap_dpp: on a gateway the local Controller (DppConfiguratorTask)
+    // already owns the EAPOL 4-way handshake for the local Agent — don't double-process.
+    auto db = AgentDB::get();
+    if (db->device_conf.local_controller) {
+        return false;
+    }
+
+    auto eapol_tlv = cmdu_rx.getClass<wfa_map::tlv1905EncapEapol>();
+    if (!eapol_tlv) return false;
+
+    const uint8_t *eapol_frame = eapol_tlv->payload();
+    size_t eapol_len           = eapol_tlv->payload_length();
+
+    if (!eapol_frame || eapol_len < 7) {
+        LOG(ERROR) << "1905 security: EAPOL frame too short from " << src_mac;
+        return false;
+    }
+
+    uint8_t msg_num = get_eapol_key_msg_num(eapol_frame, eapol_len);
+    LOG(DEBUG) << "1905 security: EAPOL M" << (int)msg_num << " from " << src_mac;
+
+    switch (msg_num) {
+    case 1: return handle_eapol_m1(src_mac, eapol_frame, eapol_len);
+    case 2: return handle_eapol_m2(src_mac, eapol_frame, eapol_len);
+    case 3: return handle_eapol_m3(src_mac, eapol_frame, eapol_len);
+    case 4: return handle_eapol_m4(src_mac, eapol_frame, eapol_len);
+    default:
+        LOG(WARNING) << "1905 security: unknown EAPOL message number " << (int)msg_num
+                     << " from " << src_mac;
+        return false;
+    }
+}
+
+bool DppAgentTask::initiate_1905_network_introduction(const sMacAddr &peer_mac)
+{
+    auto db = AgentDB::get();
+
+    if (!db->dpp_credentials.initialized || db->dpp_credentials.connector.empty()) {
+        LOG(ERROR) << "1905 intro: DPP credentials not initialized for peer " << peer_mac;
+        return false;
+    }
+
+    // Build DPP Peer Discovery Request frame
+    // Header: Action[1=0x09] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1=0x05]
+    std::vector<uint8_t> frame = {0x09, 0x50, 0x6F, 0x9A, 0x1A, 0x01,
+                                   DPP_PA_PEER_DISCOVERY_REQUEST};
+
+    // Transaction ID attribute (ID=0x1016 LE, Len=1, Value=1)
+    uint8_t trans_id = 1;
+    append_dpp_attr(frame, DPP_ATTR_TRANS_ID, &trans_id, 1);
+
+    // Connector attribute (ID=0x100D LE)
+    const auto &connector = db->dpp_credentials.connector;
+    append_dpp_attr(frame, DPP_ATTR_CONNECTOR,
+                    reinterpret_cast<const uint8_t *>(connector.data()),
+                    static_cast<uint16_t>(connector.size()));
+
+    // Mark handshake in progress
+    db->peer_1905_security[peer_mac].handshake_in_progress = true;
+
+    LOG(INFO) << "1905 intro: sending Peer Discovery Request to " << peer_mac;
+    return send_direct_encap_dpp_to_peer(peer_mac, frame);
+}
+
+bool DppAgentTask::handle_peer_discovery_request(const sMacAddr &src_mac,
+                                                           const uint8_t *frame, size_t len)
+{
+    auto db = AgentDB::get();
+
+    LOG(INFO) << "1905 intro: Peer Discovery Request from " << src_mac;
+
+    // Frame: Action(1)+OUI(3)+OUI_Type(1)+CryptoSuite(1)+FrameType(1) = 7 bytes header
+    if (len < 7) return false;
+    const uint8_t *attrs = frame + 7;
+    size_t attrs_len     = len - 7;
+
+    // Extract peer's Connector
+    uint16_t connector_len = 0;
+    const uint8_t *connector_val = find_dpp_attr(attrs, attrs_len,
+                                                   DPP_ATTR_CONNECTOR, &connector_len);
+    if (!connector_val || connector_len == 0) {
+        LOG(ERROR) << "1905 intro: Peer Discovery Request missing Connector from " << src_mac;
+        send_peer_discovery_response(src_mac, false, "");
+        return false;
+    }
+
+    std::string peer_connector(reinterpret_cast<const char *>(connector_val), connector_len);
+
+    // Verify Connector signature using C-sign-key
+    if (!db->dpp_credentials.initialized || db->dpp_credentials.c_sign_key_jwk.empty()) {
+        LOG(ERROR) << "1905 intro: C-sign-key not available for Connector verification";
+        send_peer_discovery_response(src_mac, false, "");
+        return false;
+    }
+
+    if (!verify_connector(peer_connector, db->dpp_credentials.c_sign_key_jwk)) {
+        LOG(ERROR) << "1905 intro: Peer Connector signature invalid from " << src_mac;
+        send_peer_discovery_response(src_mac, false, "");
+        return false;
+    }
+
+    // Extract peer's netAccessKey as DER bytes
+    std::vector<uint8_t> peer_nak_der = extract_nak_der_from_connector(peer_connector);
+    if (peer_nak_der.empty()) {
+        LOG(ERROR) << "1905 intro: failed to extract NAK from peer Connector from " << src_mac;
+        send_peer_discovery_response(src_mac, false, "");
+        return false;
+    }
+
+    // Store peer's Connector and NAK
+    auto &peer_state     = db->peer_1905_security[src_mac];
+    peer_state.connector = peer_connector;
+    peer_state.nak_der   = peer_nak_der;
+
+    // Derive 1905 PMK
+    if (!derive_1905_pmk(src_mac, peer_nak_der)) {
+        LOG(ERROR) << "1905 intro: PMK derivation failed for " << src_mac;
+        send_peer_discovery_response(src_mac, false, "");
+        return false;
+    }
+
+    // Send Peer Discovery Response with our Connector
+    if (!send_peer_discovery_response(src_mac, true, db->dpp_credentials.connector)) {
+        return false;
+    }
+
+    LOG(DEBUG) << "1905 intro: waiting 500ms before sending EAPOL M1 to " << src_mac;
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+
+    // As Authenticator (Responder in Peer Discovery): initiate 4-way handshake
+    return initiate_4way_handshake_authenticator(src_mac);
+}
+
+bool DppAgentTask::handle_peer_discovery_response(const sMacAddr &src_mac,
+                                                            const uint8_t *frame, size_t len)
+{
+    auto db = AgentDB::get();
+
+    LOG(INFO) << "1905 intro: Peer Discovery Response from " << src_mac;
+
+    // Frame: Action(1)+OUI(3)+OUI_Type(1)+CryptoSuite(1)+FrameType(1) = 7 bytes header
+    if (len < 7) return false;
+    const uint8_t *attrs = frame + 7;
+    size_t attrs_len     = len - 7;
+
+    // Check DPP Status
+    uint16_t status_len = 0;
+    const uint8_t *status_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_STATUS, &status_len);
+    if (!status_val || status_len < 1 || status_val[0] != DPP_STATUS_OK) {
+        uint8_t status = status_val ? status_val[0] : 0xFF;
+        LOG(ERROR) << "1905 intro: Peer Discovery Response status=0x"
+                   << std::hex << (int)status << " from " << src_mac;
+        db->peer_1905_security.erase(src_mac);
+        return false;
+    }
+
+    // Extract peer's Connector
+    uint16_t connector_len = 0;
+    const uint8_t *connector_val = find_dpp_attr(attrs, attrs_len,
+                                                   DPP_ATTR_CONNECTOR, &connector_len);
+    if (!connector_val || connector_len == 0) {
+        LOG(ERROR) << "1905 intro: Peer Discovery Response missing Connector from " << src_mac;
+        return false;
+    }
+
+    std::string peer_connector(reinterpret_cast<const char *>(connector_val), connector_len);
+
+    // Verify Connector signature
+    if (!db->dpp_credentials.initialized || db->dpp_credentials.c_sign_key_jwk.empty()) {
+        LOG(ERROR) << "1905 intro: C-sign-key not available for Connector verification";
+        return false;
+    }
+
+    if (!verify_connector(peer_connector, db->dpp_credentials.c_sign_key_jwk)) {
+        LOG(ERROR) << "1905 intro: Peer Connector signature invalid from " << src_mac;
+        db->peer_1905_security.erase(src_mac);
+        return false;
+    }
+
+    // Extract peer's netAccessKey
+    std::vector<uint8_t> peer_nak_der = extract_nak_der_from_connector(peer_connector);
+    if (peer_nak_der.empty()) {
+        LOG(ERROR) << "1905 intro: failed to extract NAK from peer Connector from " << src_mac;
+        return false;
+    }
+
+    // Store peer's Connector and NAK
+    auto &peer_state     = db->peer_1905_security[src_mac];
+    peer_state.connector = peer_connector;
+    peer_state.nak_der   = peer_nak_der;
+
+    // Derive 1905 PMK
+    if (!derive_1905_pmk(src_mac, peer_nak_der)) {
+        LOG(ERROR) << "1905 intro: PMK derivation failed for " << src_mac;
+        return false;
+    }
+
+    LOG(INFO) << "1905 intro: PMK established with " << src_mac
+              << " — waiting for EAPOL M1 (Authenticator role is peer)";
+
+    // As Supplicant (Initiator in Peer Discovery): wait for EAPOL M1 from peer
+    return true;
+}
+
+bool DppAgentTask::send_peer_discovery_response(const sMacAddr &peer_mac,
+                                                          bool success,
+                                                          const std::string &connector)
+{
+    // Build DPP Peer Discovery Response frame
+    // Header: Action[1=0x09] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1=0x06]
+    std::vector<uint8_t> frame = {0x09, 0x50, 0x6F, 0x9A, 0x1A, 0x01,
+                                   DPP_PA_PEER_DISCOVERY_RESPONSE};
+
+    // Transaction ID
+    uint8_t trans_id = 1;
+    append_dpp_attr(frame, DPP_ATTR_TRANS_ID, &trans_id, 1);
+
+    // DPP Status
+    uint8_t status_val = success ? DPP_STATUS_OK : DPP_STATUS_INVALID_CONNECTOR;
+    append_dpp_attr(frame, DPP_ATTR_STATUS, &status_val, 1);
+
+    // Connector (only on success)
+    if (success && !connector.empty()) {
+        append_dpp_attr(frame, DPP_ATTR_CONNECTOR,
+                        reinterpret_cast<const uint8_t *>(connector.data()),
+                        static_cast<uint16_t>(connector.size()));
+    }
+
+    return send_direct_encap_dpp_to_peer(peer_mac, frame);
+}
+
+bool DppAgentTask::derive_1905_pmk(const sMacAddr &peer_mac,
+                                              const std::vector<uint8_t> &peer_nak_der)
+{
+    auto db = AgentDB::get();
+
+    if (db->dpp_credentials.nak_pkey == nullptr && db->dpp_credentials.nak_private_der.empty()) {
+        LOG(ERROR) << "PMK: agent NAK private key not available";
+        return false;
+    }
+
+    // Import agent's NAK private key.
+    // Prefer nak_pkey (EVP_PKEY* loaded via traditional PEM — correct ECDH on this platform).
+    // Fall back to nak_private_der + OSSL_DECODER for wireless/legacy path.
+    EVP_PKEY *agent_pkey = nullptr;
+    bool agent_pkey_owned = false;
+    if (db->dpp_credentials.nak_pkey) {
+        agent_pkey = db->dpp_credentials.nak_pkey;  // borrowed reference — do not free
+    } else {
+        const uint8_t *p   = db->dpp_credentials.nak_private_der.data();
+        size_t p_len       = db->dpp_credentials.nak_private_der.size();
+        OSSL_DECODER_CTX *dctx = OSSL_DECODER_CTX_new_for_pkey(
+            &agent_pkey, "DER", nullptr, "EC",
+            OSSL_KEYMGMT_SELECT_PRIVATE_KEY, nullptr, nullptr);
+        if (dctx) {
+            OSSL_DECODER_from_data(dctx, &p, &p_len);
+            OSSL_DECODER_CTX_free(dctx);
+        }
+        agent_pkey_owned = true;
+    }
+    if (!agent_pkey) {
+        LOG(ERROR) << "PMK: failed to import agent NAK private key";
+        return false;
+    }
+
+    // Import peer's NAK public key.
+    // extract_nak_der_from_connector() returns a raw 65-byte uncompressed EC point (0x04||x||y).
+    // Use EVP_PKEY_fromdata with OSSL_PKEY_PARAM_PUB_KEY.
+    EVP_PKEY *peer_pkey = nullptr;
+    if (peer_nak_der.size() == 65 && peer_nak_der[0] == 0x04) {
+        // Build SPKI DER for P-256 uncompressed key and import via d2i_PUBKEY
+        // (same approach as PI import — avoids OSSL_PARAM_BLD ECDH issue on this platform)
+        static const uint8_t p256_hdr[] = {
+            0x30,0x59, 0x30,0x13, 0x06,0x07, 0x2a,0x86,0x48,0xce,0x3d,0x02,0x01,
+            0x06,0x08, 0x2a,0x86,0x48,0xce,0x3d,0x03,0x01,0x07, 0x03,0x42,0x00
+        };
+        uint8_t spki[91];
+        memcpy(spki, p256_hdr, sizeof(p256_hdr));
+        memcpy(spki + sizeof(p256_hdr), peer_nak_der.data(), 65);
+        const uint8_t *pp = spki;
+        peer_pkey = d2i_PUBKEY(nullptr, &pp, static_cast<long>(sizeof(spki)));
+    } else {
+        // Fallback: try SPKI DER (for future use / backward compat)
+        const uint8_t *pp  = peer_nak_der.data();
+        size_t pp_len      = peer_nak_der.size();
+        OSSL_DECODER_CTX *dctx = OSSL_DECODER_CTX_new_for_pkey(
+            &peer_pkey, "DER", nullptr, "EC",
+            OSSL_KEYMGMT_SELECT_PUBLIC_KEY, nullptr, nullptr);
+        if (dctx) {
+            OSSL_DECODER_from_data(dctx, &pp, &pp_len);
+            OSSL_DECODER_CTX_free(dctx);
+        }
+    }
+    if (!peer_pkey) {
+        if (agent_pkey_owned) EVP_PKEY_free(agent_pkey);
+        LOG(ERROR) << "PMK: failed to import peer NAK public key";
+        return false;
+    }
+
+    // ECDH: N = agent_nak_private * peer_nak_public using EVP_PKEY_derive
+    EVP_PKEY_CTX *ecdh_ctx = EVP_PKEY_CTX_new(agent_pkey, nullptr);
+    std::vector<uint8_t> N_x;
+    if (!ecdh_ctx || EVP_PKEY_derive_init(ecdh_ctx) <= 0 ||
+        EVP_PKEY_derive_set_peer(ecdh_ctx, peer_pkey) <= 0) {
+        if (ecdh_ctx) EVP_PKEY_CTX_free(ecdh_ctx);
+        if (agent_pkey_owned) EVP_PKEY_free(agent_pkey);
+        EVP_PKEY_free(peer_pkey);
+        LOG(ERROR) << "PMK: ECDH init failed for " << peer_mac;
+        return false;
+    }
+
+    size_t secret_len = 0;
+    EVP_PKEY_derive(ecdh_ctx, nullptr, &secret_len);
+    std::vector<uint8_t> shared_secret(secret_len);
+    if (EVP_PKEY_derive(ecdh_ctx, shared_secret.data(), &secret_len) <= 0) {
+        EVP_PKEY_CTX_free(ecdh_ctx);
+        if (agent_pkey_owned) EVP_PKEY_free(agent_pkey);
+        EVP_PKEY_free(peer_pkey);
+        LOG(ERROR) << "PMK: ECDH computation failed for " << peer_mac;
+        return false;
+    }
+    EVP_PKEY_CTX_free(ecdh_ctx);
+    if (agent_pkey_owned) EVP_PKEY_free(agent_pkey);
+    EVP_PKEY_free(peer_pkey);
+
+    // EVP_PKEY_derive for EC returns x-coordinate (32 bytes for P-256)
+    N_x = shared_secret;
+    if (N_x.size() > 32) N_x.resize(32);
+
+    // PMK = HKDF(<>, "DPP PMK", N.x)
+    // Using HKDF-Extract with empty salt, then HKDF-Expand
+    // HKDF-Extract(salt=<empty>, ikm=N.x) → PRK
+    // Using EVP_Q_mac (OpenSSL 3.0 native, non-deprecated)
+    uint8_t prk[SHA256_DIGEST_LENGTH] = {};
+    {
+        uint8_t zero_salt[SHA256_DIGEST_LENGTH] = {};
+        size_t prk_out_len = SHA256_DIGEST_LENGTH;
+        EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+                  zero_salt, SHA256_DIGEST_LENGTH,
+                  N_x.data(), N_x.size(),
+                  prk, SHA256_DIGEST_LENGTH, &prk_out_len);
+    }
+
+    // HKDF-Expand(PRK, info="DPP PMK", len=32) → PMK
+    // T(1) = HMAC(PRK, info || 0x01)
+    static const char *info = "DPP PMK";
+    uint8_t pmk[32] = {};
+    {
+        std::vector<uint8_t> hkdf_input;
+        hkdf_input.insert(hkdf_input.end(),
+                          reinterpret_cast<const uint8_t *>(info),
+                          reinterpret_cast<const uint8_t *>(info) + strlen(info));
+        hkdf_input.push_back(0x01); // counter = 1
+        size_t t_len = SHA256_DIGEST_LENGTH;
+        uint8_t t[SHA256_DIGEST_LENGTH] = {};
+        EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+                  prk, SHA256_DIGEST_LENGTH,
+                  hkdf_input.data(), hkdf_input.size(),
+                  t, SHA256_DIGEST_LENGTH, &t_len);
+        memcpy(pmk, t, 32);
+    }
+
+    // Store PMK
+    auto &peer_state = db->peer_1905_security[peer_mac];
+    memcpy(peer_state.pmk_1905.data(), pmk, 32);
+    peer_state.pmk_valid = true;
+
+    LOG(INFO) << "PMK: 1905 PMK derived for peer " << peer_mac;
+    return true;
+}
+
+bool DppAgentTask::initiate_4way_handshake_authenticator(const sMacAddr &peer_mac)
+{
+    auto db = AgentDB::get();
+    auto it = db->peer_1905_security.find(peer_mac);
+    if (it == db->peer_1905_security.end() || !it->second.pmk_valid) {
+        LOG(ERROR) << "4-way: no PMK for " << peer_mac;
+        return false;
+    }
+
+    auto &peer_state = it->second;
+
+    // Generate ANonce (32 bytes random)
+    RAND_bytes(peer_state.a_nonce.data(), 32);
+
+    // Replay counter starts at 1 and is tracked per-session for subsequent rekeys
+    peer_state.replay_counter = 1;
+    std::vector<uint8_t> m1 = build_eapol_key_m1(peer_state.a_nonce, peer_state.replay_counter);
+    peer_state.handshake_in_progress = true;
+
+    LOG(INFO) << "4-way: sent M1 (ANonce) to " << peer_mac << " [Authenticator role]";
+    return send_1905_encap_eapol(peer_mac, m1);
+}
+
+bool DppAgentTask::handle_eapol_m1(const sMacAddr &src_mac,
+                                              const uint8_t *eapol_frame, size_t len)
+{
+    auto db = AgentDB::get();
+    auto it = db->peer_1905_security.find(src_mac);
+    if (it == db->peer_1905_security.end() || !it->second.pmk_valid) {
+        LOG(ERROR) << "4-way M1: no PMK for " << src_mac;
+        return false;
+    }
+
+    auto &peer_state = it->second;
+
+    // Extract ANonce from M1 (offset 17 in EAPOL-Key frame)
+    if (!extract_nonce(eapol_frame, len, peer_state.a_nonce)) {
+        LOG(ERROR) << "4-way M1: failed to extract ANonce from " << src_mac;
+        return false;
+    }
+
+    // Read the replay counter from M1 (offset 9, 8 bytes big-endian)
+    uint64_t replay_counter = 0;
+    if (len >= 17) {
+        for (int i = 0; i < 8; i++)
+            replay_counter = (replay_counter << 8) | eapol_frame[9 + i];
+    }
+
+    // Generate SNonce
+    RAND_bytes(peer_state.s_nonce.data(), 32);
+
+    // Derive PTK (Supplicant role: src_mac is Authenticator = AA)
+    if (!derive_1905_ptk(src_mac, peer_state, false /*is_authenticator=false*/)) {
+        LOG(ERROR) << "4-way M1: PTK derivation failed for " << src_mac;
+        return false;
+    }
+
+    // Derive TK = PTK[32:64]
+    memcpy(peer_state.tk_1905.data(), peer_state.ptk_1905.data() + 32, 32);
+
+    // M2 echoes M1's replay counter (per IEEE 802.11 §12.7.6.3)
+    std::vector<uint8_t> m2 = build_eapol_key_m2(peer_state.a_nonce, peer_state.s_nonce,
+                                                   peer_state.ptk_1905, replay_counter);
+
+    LOG(INFO) << "4-way: sent M2 (SNonce+MIC) to " << src_mac << " [Supplicant role]";
+    return send_1905_encap_eapol(src_mac, m2);
+}
+
+bool DppAgentTask::handle_eapol_m2(const sMacAddr &src_mac,
+                                              const uint8_t *eapol_frame, size_t len)
+{
+    auto db = AgentDB::get();
+    auto it = db->peer_1905_security.find(src_mac);
+    if (it == db->peer_1905_security.end() || !it->second.pmk_valid) {
+        LOG(ERROR) << "4-way M2: no PMK for " << src_mac;
+        return false;
+    }
+
+    auto &peer_state = it->second;
+
+    // Extract SNonce from M2
+    if (!extract_nonce(eapol_frame, len, peer_state.s_nonce)) {
+        LOG(ERROR) << "4-way M2: failed to extract SNonce from " << src_mac;
+        return false;
+    }
+
+    // Derive PTK (Authenticator role: this Agent is AA)
+    if (!derive_1905_ptk(src_mac, peer_state, true /*is_authenticator=true*/)) {
+        LOG(ERROR) << "4-way M2: PTK derivation failed for " << src_mac;
+        return false;
+    }
+
+    // Derive TK = PTK[32:64]
+    memcpy(peer_state.tk_1905.data(), peer_state.ptk_1905.data() + 32, 32);
+
+    // Verify M2 MIC using KCK (PTK[0:32])
+    if (!verify_eapol_mic(eapol_frame, len, peer_state.ptk_1905.data())) {
+        LOG(ERROR) << "4-way M2: MIC verification failed from " << src_mac;
+        return false;
+    }
+
+    // Check if we have GTK from Controller
+    if (!db->gtk_1905.valid) {
+        LOG(WARNING) << "4-way M2: GTK not yet available from Controller — "
+                        "cannot send M3 to " << src_mac;
+        return false;
+    }
+
+    // Build M3 with GTK KDE and MIC; M3 counter must be > M2 counter (§12.7.6.4)
+    peer_state.replay_counter++;
+    std::vector<uint8_t> m3 = build_eapol_key_m3(peer_state.a_nonce,
+                                                   peer_state.ptk_1905,
+                                                   db->gtk_1905.gtk, db->gtk_1905.key_id,
+                                                   peer_state.replay_counter);
+
+    LOG(INFO) << "4-way: sent M3 (GTK+MIC) to " << src_mac << " [Authenticator role]";
+    return send_1905_encap_eapol(src_mac, m3);
+}
+
+bool DppAgentTask::handle_eapol_m3(const sMacAddr &src_mac,
+                                              const uint8_t *eapol_frame, size_t len)
+{
+    auto db = AgentDB::get();
+    auto it = db->peer_1905_security.find(src_mac);
+    if (it == db->peer_1905_security.end()) {
+        LOG(ERROR) << "4-way M3: no security state for " << src_mac;
+        return false;
+    }
+
+    auto &peer_state = it->second;
+
+    // Verify M3 MIC
+    if (!verify_eapol_mic(eapol_frame, len, peer_state.ptk_1905.data())) {
+        LOG(ERROR) << "4-way M3: MIC verification failed from " << src_mac;
+        return false;
+    }
+
+    // Extract GTK from M3 Key Data using AES Key Wrap (RFC 3394)
+    // KEK = PTK[16:32]
+    {
+        std::array<uint8_t, 32> gtk{};
+        uint8_t key_id = 1;
+        const uint8_t *kek = peer_state.ptk_1905.data() + 16;
+        if (extract_gtk_from_m3(eapol_frame, len, kek, gtk, key_id)) {
+            db->gtk_1905.gtk     = gtk;
+            db->gtk_1905.key_id  = key_id;
+            db->gtk_1905.valid   = true;
+            LOG(INFO) << "4-way M3: GTK extracted key_id=" << (int)key_id
+                      << " from " << src_mac;
+        } else {
+            LOG(ERROR) << "4-way M3: GTK extraction failed from " << src_mac;
+        }
+    }
+
+    // Build M4 with MIC; M4 echoes M3's replay counter (per IEEE 802.11 §12.7.6.5)
+    uint64_t replay_counter = 0;
+    if (len >= 17) {
+        for (int i = 0; i < 8; i++)
+            replay_counter = (replay_counter << 8) | eapol_frame[9 + i];
+    }
+    std::vector<uint8_t> m4 = build_eapol_key_m4(peer_state.ptk_1905, replay_counter);
+
+    // Send M4
+    if (!send_1905_encap_eapol(src_mac, m4)) {
+        return false;
+    }
+
+    // Install TK
+    peer_state.tk_valid              = true;
+    peer_state.enc_tx_counter        = 1;
+    peer_state.enc_rx_counter        = 0;
+    peer_state.int_rx_counter        = 0;
+    peer_state.handshake_in_progress = false;
+
+    // Install TK and GTK into the Transport so it handles all encrypt/decrypt/MIC transparently.
+    // The Transport process (not Agent) performs all 1905 crypto once keys are installed.
+    if (db->gtk_1905.valid) {
+        m_btl_ctx.m_broker_client->install_security_key(
+            src_mac,
+            peer_state.tk_1905,   // TK = PTK[32:64]
+            db->gtk_1905.gtk,
+            db->gtk_1905.key_id,
+            true);
+        LOG(INFO) << "4-way: TK+GTK installed in transport for peer " << src_mac
+                  << " [Supplicant role]";
+    } else {
+        LOG(WARNING) << "4-way: GTK not valid after M3 — transport keys not installed for "
+                     << src_mac;
+    }
+
+    LOG(INFO) << "4-way: M4 sent, TK installed for peer " << src_mac << " [Supplicant role]";
+    LOG(INFO) << "4-way: 1905 security established with " << src_mac;
+
+    // TCP relay server and BSS Config Request fire only when the completed 4-way is
+    // with the controller (not a peer agent).  Agent-to-agent handshakes share this
+    // code path but must not trigger BSS Config Request (wrong destination).
+    {
+        auto db2 = AgentDB::get();
+        if (db2->dpp_credentials.initialized &&
+                db2->dpp_extender_config.onboarding_type == AgentDB::OnboardingType::DPP
+                && src_mac == db2->controller_info.bridge_mac) {
+            m_btl_ctx.start_dpp_tcp_relay_server();
+            // Per EasyMesh Figure 17: BSS Config Request follows immediately after the
+            // 4-way handshake that establishes 1905 security with the controller.
+            m_btl_ctx.trigger_dpp_extender_bss_config_request(src_mac);
+        }
+    }
+    return true;
+}
+
+bool DppAgentTask::handle_eapol_m4(const sMacAddr &src_mac,
+                                              const uint8_t *eapol_frame, size_t len)
+{
+    auto db = AgentDB::get();
+    auto it = db->peer_1905_security.find(src_mac);
+    if (it == db->peer_1905_security.end()) {
+        LOG(ERROR) << "4-way M4: no security state for " << src_mac;
+        return false;
+    }
+
+    auto &peer_state = it->second;
+
+    // Verify M4 MIC
+    if (!verify_eapol_mic(eapol_frame, len, peer_state.ptk_1905.data())) {
+        LOG(ERROR) << "4-way M4: MIC verification failed from " << src_mac;
+        return false;
+    }
+
+    // Install TK
+    peer_state.tk_valid              = true;
+    peer_state.enc_tx_counter        = 1;
+    peer_state.enc_rx_counter        = 0;
+    peer_state.int_rx_counter        = 0;
+    peer_state.handshake_in_progress = false;
+
+    // Install TK and GTK into the Transport (Agent-as-Authenticator path, e.g. Agent↔Agent).
+    if (db->gtk_1905.valid) {
+        m_btl_ctx.m_broker_client->install_security_key(
+            src_mac,
+            peer_state.tk_1905,
+            db->gtk_1905.gtk,
+            db->gtk_1905.key_id,
+            true);
+        LOG(INFO) << "4-way: TK+GTK installed in transport for peer " << src_mac
+                  << " [Authenticator role]";
+    }
+
+    LOG(INFO) << "4-way: TK installed for peer " << src_mac << " [Authenticator role]";
+    LOG(INFO) << "4-way: 1905 security established with " << src_mac;
+    return true;
+}
+
+bool DppAgentTask::derive_1905_ptk(const sMacAddr &peer_mac,
+                                              AgentDB::s1905PeerSecurity &peer_state,
+                                              bool is_authenticator)
+{
+    auto db = AgentDB::get();
+
+    // AA = Authenticator AL MAC (Responder in Peer Discovery)
+    // SPA = Supplicant AL MAC (Initiator in Peer Discovery)
+    const uint8_t *aa;
+    const uint8_t *spa;
+
+    if (is_authenticator) {
+        // This Agent is Authenticator → AA = this Agent, SPA = peer
+        aa  = db->bridge.mac.oct;
+        spa = peer_mac.oct;
+    } else {
+        // This Agent is Supplicant → AA = peer, SPA = this Agent
+        aa  = peer_mac.oct;
+        spa = db->bridge.mac.oct;
+    }
+
+    // Determine min/max of AA and SPA (lexicographic comparison)
+    const uint8_t *min_mac = (memcmp(aa, spa, 6) < 0) ? aa : spa;
+    const uint8_t *max_mac = (memcmp(aa, spa, 6) < 0) ? spa : aa;
+
+    // Determine min/max of ANonce and SNonce
+    const uint8_t *min_nonce = (memcmp(peer_state.a_nonce.data(),
+                                        peer_state.s_nonce.data(), 32) < 0)
+                                    ? peer_state.a_nonce.data()
+                                    : peer_state.s_nonce.data();
+    const uint8_t *max_nonce = (memcmp(peer_state.a_nonce.data(),
+                                        peer_state.s_nonce.data(), 32) < 0)
+                                    ? peer_state.s_nonce.data()
+                                    : peer_state.a_nonce.data();
+
+    // IEEE 802.11-2020 §12.7.1.7.2 KDF-SHA-256-512:
+    // Ti = HMAC-SHA256(PMK, counter_le16 || label || context || length_le16)
+    // context = min(AA,SPA) || max(AA,SPA) || min(ANonce,SNonce) || max(ANonce,SNonce)
+    // length = 512 bits → 0x00 0x02 in LE, counter starts at 1
+    static const char *label     = "Pairwise key expansion";
+    const uint8_t length_le[2]   = {0x00, 0x02};
+
+    std::vector<uint8_t> context;
+    context.insert(context.end(), min_mac, min_mac + 6);
+    context.insert(context.end(), max_mac, max_mac + 6);
+    context.insert(context.end(), min_nonce, min_nonce + 32);
+    context.insert(context.end(), max_nonce, max_nonce + 32);
+
+    uint8_t ptk[64];
+    for (uint16_t i = 1; i <= 2; i++) {
+        const uint8_t counter_le[2] = {static_cast<uint8_t>(i & 0xFF),
+                                        static_cast<uint8_t>((i >> 8) & 0xFF)};
+        std::vector<uint8_t> prf_input;
+        prf_input.insert(prf_input.end(), counter_le, counter_le + 2);
+        prf_input.insert(prf_input.end(),
+                         reinterpret_cast<const uint8_t *>(label),
+                         reinterpret_cast<const uint8_t *>(label) + strlen(label));
+        prf_input.insert(prf_input.end(), context.begin(), context.end());
+        prf_input.insert(prf_input.end(), length_le, length_le + 2);
+
+        uint8_t hmac_out[SHA256_DIGEST_LENGTH] = {};
+        size_t hmac_len = SHA256_DIGEST_LENGTH;
+        EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+                  peer_state.pmk_1905.data(), 32,
+                  prf_input.data(), prf_input.size(),
+                  hmac_out, SHA256_DIGEST_LENGTH, &hmac_len);
+        memcpy(ptk + (i - 1) * 32, hmac_out, 32);
+    }
+
+    memcpy(peer_state.ptk_1905.data(), ptk, 64);
+    LOG(DEBUG) << "4-way: PTK derived for peer " << peer_mac;
+    return true;
+}
+
+std::vector<uint8_t> DppAgentTask::build_eapol_key_m1(
+    const std::array<uint8_t, 32> &anonce, uint64_t replay_counter)
+{
+    // EAPOL-Key frame layout (per struct wpa_eapol_key, total 99 bytes):
+    // Offset  0: EAPOL Version(1), Type(1), Length(2)=95
+    // Offset  4: Key Descriptor Type(1), Key Info(2), Key Length(2)
+    // Offset  9: Replay Counter(8)
+    // Offset 17: Key Nonce(32)
+    // Offset 49: Key IV(16), Key RSC(8), Reserved(8)
+    // Offset 81: Key MIC(16)
+    // Offset 97: Key Data Length(2)
+    std::vector<uint8_t> frame(99, 0);
+
+    frame[0] = 0x02; // EAPOL version 2
+    frame[1] = 0x03; // EAPOL-Key
+    frame[2] = 0x00;
+    frame[3] = 0x5F; // EAPOL Length = 95 (99 - 4 header bytes)
+
+    frame[4] = 0x02; // Descriptor Type: RSN
+    // Key Info: Pairwise=1, ACK=1, Version=0 (AKM-defined for DPP)
+    // 0x0088 = Pairwise(bit3) | ACK(bit7) | Version=0
+    uint16_t key_info = 0x0088;
+    frame[5] = (key_info >> 8) & 0xFF;
+    frame[6] = key_info & 0xFF;
+
+    frame[7] = 0x00;
+    frame[8] = 0x20; // Key Length = 32
+
+    // Write replay counter big-endian at offset 9 (8 bytes)
+    for (int i = 7; i >= 0; i--)
+        frame[9 + (7 - i)] = (replay_counter >> (i * 8)) & 0xFF;
+
+    // ANonce at offset 17
+    memcpy(frame.data() + 17, anonce.data(), 32);
+
+    // Key MIC at offset 81 = 0 (no MIC in M1)
+    return frame;
+}
+
+std::vector<uint8_t> DppAgentTask::build_eapol_key_m2(
+    const std::array<uint8_t, 32> &anonce,
+    const std::array<uint8_t, 32> &snonce,
+    const std::array<uint8_t, 64> &ptk,
+    uint64_t replay_counter)
+{
+    std::vector<uint8_t> frame(99, 0);
+
+    frame[0] = 0x02;
+    frame[1] = 0x03;
+    frame[2] = 0x00;
+    frame[3] = 0x5F; // EAPOL Length = 95
+
+    frame[4] = 0x02;
+    // Key Info: Pairwise=1, MIC=1, Version=0 (AKM-defined for DPP)
+    // 0x0108 = Pairwise(bit3) | MIC(bit8) | Version=0
+    uint16_t key_info = 0x0108;
+    frame[5] = (key_info >> 8) & 0xFF;
+    frame[6] = key_info & 0xFF;
+
+    frame[7] = 0x00;
+    frame[8] = 0x20;
+
+    // Supplicant M2 echoes the replay counter from M1 (per IEEE 802.11 §12.7.6.3)
+    for (int i = 7; i >= 0; i--)
+        frame[9 + (7 - i)] = (replay_counter >> (i * 8)) & 0xFF;
+
+    // SNonce at offset 17
+    memcpy(frame.data() + 17, snonce.data(), 32);
+
+    // Compute MIC using KCK = PTK[0:16] (DPP KCK = PMK/2 = 16 bytes), MIC at offset 81
+    uint8_t mic[SHA256_DIGEST_LENGTH] = {};
+    size_t mic_len = SHA256_DIGEST_LENGTH;
+    EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+              ptk.data(), 16, frame.data(), frame.size(),
+              mic, SHA256_DIGEST_LENGTH, &mic_len);
+    memcpy(frame.data() + 81, mic, 16); // MIC at offset 81 (per wpa_eapol_key structure)
+
+    return frame;
+}
+
+std::vector<uint8_t> DppAgentTask::build_eapol_key_m3(
+    const std::array<uint8_t, 32> &anonce,
+    const std::array<uint8_t, 64> &ptk,
+    const std::array<uint8_t, 32> &gtk,
+    uint8_t gtk_key_id,
+    uint64_t replay_counter)
+{
+    // Build 1905 GTK KDE plaintext (EasyMesh v6.1 §5.3.7.3 Tables 11 and 12)
+    // KDE format: Type(1)+Length(1)+OUI(3)+DataType(1)+KeyID(1)+GTK(32) = 39B
+    // (single KeyID header byte, no separate Reserved byte, per MAP_KEY_DATA_GROUPKEY)
+    // OUI = 50:6F:9A, DataType = 0x00 (1905 GTK KDE)
+    // Table 12: KeyID bits 0-1 = Key ID, bits 2-7 = Reserved
+    // Buffer is padded to 40B (multiple of 8) for AES-Key-Wrap; the trailing pad byte
+    // is outside the KDE's own len field and is ignored by the receiver's KDE walk.
+    uint8_t kde_plain[40] = {};
+    kde_plain[0] = 0xDD;                   // KDE type: Vendor Specific
+    kde_plain[1] = 37;                     // len = OUI(3)+DataType(1)+KeyID(1)+GTK(32)
+    kde_plain[2] = 0x50; kde_plain[3] = 0x6F; kde_plain[4] = 0x9A; // OUI: EasyMesh 1905
+    kde_plain[5] = 0x00;                   // DataType: 0x00 (1905 GTK KDE per Table 11)
+    kde_plain[6] = gtk_key_id & 0x03;      // Key ID (bits 0-1); bits 2-7 Reserved
+    memcpy(kde_plain + 7, gtk.data(), 32);
+
+    // AES-Key-Wrap the entire KDE (40B → 48B wrapped)
+    const uint8_t *kek = ptk.data() + 16; // KEK = PTK[16:32]
+    std::vector<uint8_t> kde_wrapped(48, 0);
+    {
+        EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+        EVP_CIPHER_CTX_set_flags(ctx, EVP_CIPHER_CTX_FLAG_WRAP_ALLOW);
+        int out_len = 0, final_len = 0;
+        EVP_EncryptInit_ex(ctx, EVP_aes_128_wrap(), nullptr, kek, nullptr);
+        EVP_EncryptUpdate(ctx, kde_wrapped.data(), &out_len, kde_plain, sizeof(kde_plain));
+        EVP_EncryptFinal_ex(ctx, kde_wrapped.data() + out_len, &final_len);
+        EVP_CIPHER_CTX_free(ctx);
+        kde_wrapped.resize(static_cast<size_t>(out_len + final_len));
+    }
+
+    // Key Data = the AES-wrapped blob (KDE header is inside the wrapped plaintext)
+    // Key Data Length at bytes 97-98 (big-endian)
+    uint16_t kd_len = static_cast<uint16_t>(kde_wrapped.size());
+
+    // Total frame is 99B: [0-3]=EAPOL hdr, [4]=KeyDesc, [5-6]=KeyInfo, [7-8]=KeyLen,
+    // [9-16]=Replay(8B), [17-48]=ANonce(32B), [49-80]=SNonce(32B), [81-96]=MIC(16B),
+    // [97-98]=KeyDataLen. Key Data starts at byte 99.
+    std::vector<uint8_t> frame(99, 0);
+
+    frame[0] = 0x02;
+    frame[1] = 0x03;
+    // EAPOL body length will be set after we know total Key Data size
+    frame[4] = 0x02; // Key Descriptor Type
+    // Key Info: Pairwise=1, Install=1, ACK=1, MIC=1, Secure=1, Encrypted Key Data=1, Version=0
+    uint16_t key_info = 0x13C8;
+    frame[5] = (key_info >> 8) & 0xFF;
+    frame[6] = key_info & 0xFF;
+    frame[7] = 0x00;
+    frame[8] = 0x20; // Key Length = 32 (PTK)
+    // Authenticator M3 counter must be > M2 counter (per IEEE 802.11 §12.7.6.4)
+    for (int i = 7; i >= 0; i--)
+        frame[9 + (7 - i)] = (replay_counter >> (i * 8)) & 0xFF;
+    memcpy(frame.data() + 17, anonce.data(), 32); // ANonce
+
+    // Key Data Length at bytes 97-98 (big-endian) — kd_len already computed above
+    frame[97] = (kd_len >> 8) & 0xFF;
+    frame[98] = kd_len & 0xFF;
+
+    // Append Key Data (the AES-wrapped blob)
+    frame.insert(frame.end(), kde_wrapped.begin(), kde_wrapped.end());
+
+    // EAPOL body length = total frame - 4 (EAPOL header bytes 0-3)
+    uint16_t eapol_body_len = static_cast<uint16_t>(frame.size() - 4);
+    frame[2] = (eapol_body_len >> 8) & 0xFF;
+    frame[3] = eapol_body_len & 0xFF;
+
+    // Compute MIC over the whole frame with MIC field zeroed (it already is at offset 81)
+    uint8_t mic[SHA256_DIGEST_LENGTH] = {};
+    size_t mic_len = SHA256_DIGEST_LENGTH;
+    EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+              ptk.data(), 16, frame.data(), frame.size(),
+              mic, SHA256_DIGEST_LENGTH, &mic_len);
+    memcpy(frame.data() + 81, mic, 16);
+
+    return frame;
+}
+
+std::vector<uint8_t> DppAgentTask::build_eapol_key_m4(
+    const std::array<uint8_t, 64> &ptk, uint64_t replay_counter)
+{
+    std::vector<uint8_t> frame(99, 0);
+
+    frame[0] = 0x02;
+    frame[1] = 0x03;
+    frame[2] = 0x00;
+    frame[3] = 0x5F; // EAPOL Length = 95
+
+    frame[4] = 0x02;
+    // Key Info: Pairwise=1, MIC=1, Secure=1, Version=0 (AKM-defined for DPP)
+    // 0x0308 = Pairwise(bit3) | MIC(bit8) | Secure(bit9) | Version=0
+    uint16_t key_info = 0x0308;
+    frame[5] = (key_info >> 8) & 0xFF;
+    frame[6] = key_info & 0xFF;
+
+    frame[7] = 0x00;
+    frame[8] = 0x20;
+
+    // Supplicant M4 echoes the replay counter from M3 (per IEEE 802.11 §12.7.6.5)
+    for (int i = 7; i >= 0; i--)
+        frame[9 + (7 - i)] = (replay_counter >> (i * 8)) & 0xFF;
+
+    // Compute MIC using KCK = PTK[0:16] (DPP KCK = PMK/2 = 16 bytes), MIC at offset 81
+    uint8_t mic[SHA256_DIGEST_LENGTH] = {};
+    size_t mic_len = SHA256_DIGEST_LENGTH;
+    EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+              ptk.data(), 16, frame.data(), frame.size(),
+              mic, SHA256_DIGEST_LENGTH, &mic_len);
+    memcpy(frame.data() + 81, mic, 16);
+
+    return frame;
+}
+
+uint8_t DppAgentTask::get_eapol_key_msg_num(const uint8_t *eapol_frame, size_t len)
+{
+    if (!eapol_frame || len < 7) return 0;
+
+    uint16_t key_info = (static_cast<uint16_t>(eapol_frame[5]) << 8) | eapol_frame[6];
+
+    bool pairwise = (key_info >> 3) & 1;
+    bool install  = (key_info >> 6) & 1;
+    bool ack      = (key_info >> 7) & 1;
+    bool mic      = (key_info >> 8) & 1;
+    bool secure   = (key_info >> 9) & 1;
+
+    if (pairwise && !install && ack && !mic && !secure) return 1; // M1
+    if (pairwise && !install && !ack && mic && !secure) return 2; // M2
+    if (pairwise && install && ack && mic && secure)    return 3; // M3
+    if (pairwise && !install && !ack && mic && secure)  return 4; // M4
+
+    return 0;
+}
+
+bool DppAgentTask::extract_nonce(const uint8_t *eapol_frame, size_t len,
+                                           std::array<uint8_t, 32> &nonce)
+{
+    if (!eapol_frame || len < 49) return false;
+    memcpy(nonce.data(), eapol_frame + 17, 32);
+    return true;
+}
+
+bool DppAgentTask::verify_eapol_mic(const uint8_t *eapol_frame, size_t len,
+                                              const uint8_t *kck)
+{
+    // Minimum frame size: 4 (EAPOL header) + 77 (wpa_eapol_key) + 16 (MIC) + 2 (DataLen) = 99
+    if (!eapol_frame || len < 99 || !kck) return false;
+
+    // For DPP (AKM-defined, PMK=32 bytes):
+    //   KCK = PTK[0:16] (wpa_kck_len(DPP, 32) = 32/2 = 16 bytes)
+    //   MIC = first 16 bytes of HMAC-SHA256(KCK[0:16], frame_with_mic_zeroed)
+    const size_t kck_len = 16; // DPP KCK = PMK/2 = 16 bytes
+
+    // MIC is at offset 81 (4 EAPOL header + 77 wpa_eapol_key struct), length 16
+    std::vector<uint8_t> frame_copy(eapol_frame, eapol_frame + len);
+    memset(frame_copy.data() + 81, 0, 16);
+
+    uint8_t computed_mic[SHA256_DIGEST_LENGTH] = {};
+    size_t mic_len = SHA256_DIGEST_LENGTH;
+    EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+              kck, kck_len, frame_copy.data(), frame_copy.size(),
+              computed_mic, SHA256_DIGEST_LENGTH, &mic_len);
+
+    return memcmp(computed_mic, eapol_frame + 81, 16) == 0;
+}
+
+uint8_t DppAgentTask::get_dpp_frame_type(const uint8_t *frame, size_t len)
+{
+    // DPP frame layout: Action(1) + OUI(3) + OUI_Type(1) + CryptoSuite(1) + FrameType(1)
+    if (!frame || len < 7) return 0xFF;
+    return frame[6];
+}
+
+const uint8_t *DppAgentTask::find_dpp_attr(const uint8_t *attrs, size_t attrs_len,
+                                                      uint16_t attr_id, uint16_t *attr_len)
+{
+    if (!attrs || attrs_len < 4) return nullptr;
+
+    size_t offset = 0;
+    while (offset + 4 <= attrs_len) {
+        uint16_t id  = attrs[offset] | (static_cast<uint16_t>(attrs[offset + 1]) << 8);
+        uint16_t len = attrs[offset + 2] | (static_cast<uint16_t>(attrs[offset + 3]) << 8);
+
+        if (id == attr_id) {
+            if (attr_len) *attr_len = len;
+            if (offset + 4 + len <= attrs_len) {
+                return attrs + offset + 4;
+            }
+            return nullptr;
+        }
+        offset += 4 + len;
+    }
+    return nullptr;
+}
+
+void DppAgentTask::append_dpp_attr(std::vector<uint8_t> &frame, uint16_t id,
+                                             const uint8_t *value, uint16_t len)
+{
+    frame.push_back(id & 0xFF);
+    frame.push_back((id >> 8) & 0xFF);
+    frame.push_back(len & 0xFF);
+    frame.push_back((len >> 8) & 0xFF);
+    if (value && len > 0) {
+        frame.insert(frame.end(), value, value + len);
+    }
+}
+
+bool DppAgentTask::verify_connector(const std::string &connector_jws,
+                                               const std::string &c_sign_key_jwk)
+{
+    if (connector_jws.empty() || c_sign_key_jwk.empty()) {
+        LOG(ERROR) << "verify_connector: empty input";
+        return false;
+    }
+
+    // JWS compact: header_b64u.payload_b64u.sig_b64u
+    size_t dot1 = connector_jws.find('.');
+    size_t dot2 = connector_jws.find('.', dot1 + 1);
+    if (dot1 == std::string::npos || dot2 == std::string::npos) {
+        LOG(ERROR) << "verify_connector: invalid JWS format";
+        return false;
+    }
+
+    // Signing input = "header_b64u.payload_b64u"
+    std::string signing_input = connector_jws.substr(0, dot2);
+    std::string sig_b64u      = connector_jws.substr(dot2 + 1);
+
+    // 1. Decode signature (raw R||S, 64 bytes for P-256)
+    std::vector<uint8_t> sig_raw = base64url_decode(sig_b64u);
+    if (sig_raw.size() < 64) {
+        LOG(ERROR) << "verify_connector: signature too short (" << sig_raw.size() << ")";
+        return false;
+    }
+
+    // Convert R||S to DER ECDSA signature (SEQUENCE { INTEGER r, INTEGER s })
+    // R and S are 32 bytes each for P-256
+    const uint8_t *r = sig_raw.data();
+    const uint8_t *s = sig_raw.data() + 32;
+    ECDSA_SIG *ecdsa_sig = ECDSA_SIG_new();
+    if (!ecdsa_sig) {
+        LOG(ERROR) << "verify_connector: ECDSA_SIG_new failed";
+        return false;
+    }
+    BIGNUM *bn_r = BN_bin2bn(r, 32, nullptr);
+    BIGNUM *bn_s = BN_bin2bn(s, 32, nullptr);
+    ECDSA_SIG_set0(ecdsa_sig, bn_r, bn_s); // takes ownership of bn_r, bn_s
+    unsigned char *der_sig = nullptr;
+    int der_len = i2d_ECDSA_SIG(ecdsa_sig, &der_sig);
+    ECDSA_SIG_free(ecdsa_sig);
+    if (der_len <= 0 || !der_sig) {
+        LOG(ERROR) << "verify_connector: i2d_ECDSA_SIG failed";
+        return false;
+    }
+
+    // 2. Parse c-sign-key JWK: {"kty":"EC","crv":"P-256","x":"...","y":"..."}
+    EVP_PKEY *csign_key = nullptr;
+    {
+        // Extract x and y base64url values from JWK JSON
+        auto extract_jwk_field = [&](const std::string &jwk, const std::string &field) -> std::string {
+            std::string search = "\"" + field + "\":\"";
+            auto pos = jwk.find(search);
+            if (pos == std::string::npos) return {};
+            pos += search.size();
+            auto end = jwk.find('"', pos);
+            if (end == std::string::npos) return {};
+            return jwk.substr(pos, end - pos);
+        };
+
+        std::string x_b64 = extract_jwk_field(c_sign_key_jwk, "x");
+        std::string y_b64 = extract_jwk_field(c_sign_key_jwk, "y");
+        if (x_b64.empty() || y_b64.empty()) {
+            LOG(ERROR) << "verify_connector: c_sign_key_jwk missing x or y";
+            OPENSSL_free(der_sig);
+            return false;
+        }
+
+        std::vector<uint8_t> x_bytes = base64url_decode(x_b64);
+        std::vector<uint8_t> y_bytes = base64url_decode(y_b64);
+        if (x_bytes.size() < 32 || y_bytes.size() < 32) {
+            LOG(ERROR) << "verify_connector: c_sign_key x/y too short";
+            OPENSSL_free(der_sig);
+            return false;
+        }
+
+        // Build uncompressed EC point: 0x04 || x(32) || y(32)
+        uint8_t pub[65];
+        pub[0] = 0x04;
+        memcpy(pub + 1,  x_bytes.data(), 32);
+        memcpy(pub + 33, y_bytes.data(), 32);
+
+        OSSL_PARAM_BLD *bld = OSSL_PARAM_BLD_new();
+        OSSL_PARAM *par     = nullptr;
+        EVP_PKEY_CTX *fctx  = nullptr;
+        if (bld) {
+            OSSL_PARAM_BLD_push_utf8_string(bld, OSSL_PKEY_PARAM_GROUP_NAME, "P-256", 0);
+            OSSL_PARAM_BLD_push_octet_string(bld, OSSL_PKEY_PARAM_PUB_KEY, pub, 65);
+            par = OSSL_PARAM_BLD_to_param(bld);
+        }
+        fctx = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr);
+        if (fctx && par && EVP_PKEY_fromdata_init(fctx) == 1)
+            EVP_PKEY_fromdata(fctx, &csign_key, EVP_PKEY_PUBLIC_KEY, par);
+        if (fctx) EVP_PKEY_CTX_free(fctx);
+        if (par)  OSSL_PARAM_free(par);
+        if (bld)  OSSL_PARAM_BLD_free(bld);
+    }
+
+    if (!csign_key) {
+        LOG(ERROR) << "verify_connector: failed to import c_sign_key from JWK";
+        OPENSSL_free(der_sig);
+        return false;
+    }
+
+    // 3. Verify ECDSA-SHA256 signature over signing_input
+    EVP_MD_CTX *md_ctx = EVP_MD_CTX_new();
+    bool ok = false;
+    if (md_ctx &&
+        EVP_DigestVerifyInit(md_ctx, nullptr, EVP_sha256(), nullptr, csign_key) == 1 &&
+        EVP_DigestVerifyUpdate(md_ctx,
+                               signing_input.data(), signing_input.size()) == 1) {
+        int result = EVP_DigestVerifyFinal(md_ctx, der_sig,
+                                            static_cast<size_t>(der_len));
+        ok = (result == 1);
+        if (!ok) {
+            LOG(ERROR) << "verify_connector: ECDSA signature verification FAILED";
+        } else {
+            LOG(DEBUG) << "verify_connector: signature OK";
+        }
+    }
+    EVP_MD_CTX_free(md_ctx);
+    EVP_PKEY_free(csign_key);
+    OPENSSL_free(der_sig);
+    return ok;
+}
+
+std::vector<uint8_t> DppAgentTask::extract_nak_der_from_connector(
+    const std::string &connector_jws)
+{
+    // JWS compact: header_b64u.payload_b64u.sig_b64u
+    // Payload JSON contains: {"groups":[...],"netAccessKey":{"kty":"EC","crv":"P-256","x":"...","y":"..."}}
+    if (connector_jws.empty()) return {};
+
+    size_t dot1 = connector_jws.find('.');
+    size_t dot2 = connector_jws.find('.', dot1 + 1);
+    if (dot1 == std::string::npos || dot2 == std::string::npos) return {};
+
+    // 1. Base64url-decode the payload
+    std::string payload_b64u = connector_jws.substr(dot1 + 1, dot2 - dot1 - 1);
+    std::vector<uint8_t> payload_bytes = base64url_decode(payload_b64u);
+    if (payload_bytes.empty()) {
+        LOG(ERROR) << "extract_nak_der_from_connector: base64url decode of payload failed";
+        return {};
+    }
+    std::string payload_json(reinterpret_cast<const char *>(payload_bytes.data()),
+                              payload_bytes.size());
+    LOG(DEBUG) << "extract_nak_der_from_connector: payload=" << payload_json.substr(0, 120);
+
+    // 2. Find "netAccessKey" JWK object in payload JSON
+    auto pos = payload_json.find("\"netAccessKey\"");
+    if (pos == std::string::npos) {
+        LOG(ERROR) << "extract_nak_der_from_connector: netAccessKey not found in payload";
+        return {};
+    }
+
+    // Extract x and y from the netAccessKey JWK
+    auto extract_field = [&](const std::string &json, size_t start,
+                              const std::string &field) -> std::string {
+        std::string search = "\"" + field + "\":\"";
+        auto p = json.find(search, start);
+        if (p == std::string::npos) return {};
+        p += search.size();
+        auto e = json.find('"', p);
+        if (e == std::string::npos) return {};
+        return json.substr(p, e - p);
+    };
+
+    std::string x_b64 = extract_field(payload_json, pos, "x");
+    std::string y_b64 = extract_field(payload_json, pos, "y");
+
+    if (x_b64.empty() || y_b64.empty()) {
+        LOG(ERROR) << "extract_nak_der_from_connector: netAccessKey missing x or y";
+        return {};
+    }
+
+    std::vector<uint8_t> x_bytes = base64url_decode(x_b64);
+    std::vector<uint8_t> y_bytes = base64url_decode(y_b64);
+
+    if (x_bytes.size() < 32 || y_bytes.size() < 32) {
+        LOG(ERROR) << "extract_nak_der_from_connector: x or y too short";
+        return {};
+    }
+
+    // 3. Build uncompressed EC point: 0x04 || x(32) || y(32)
+    std::vector<uint8_t> pub_point(65);
+    pub_point[0] = 0x04;
+    memcpy(pub_point.data() + 1,  x_bytes.data(), 32);
+    memcpy(pub_point.data() + 33, y_bytes.data(), 32);
+
+    LOG(DEBUG) << "extract_nak_der_from_connector: extracted 65-byte EC public key";
+    return pub_point;
+}
+
+bool DppAgentTask::send_direct_encap_dpp_to_peer(const sMacAddr &peer_mac,
+                                                    const std::vector<uint8_t> &frame)
+{
+    auto cmdu_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+    if (!cmdu_header) return false;
+
+    auto dpp_msg_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppMessage>();
+    if (!dpp_msg_tlv) return false;
+
+    if (!dpp_msg_tlv->alloc_dpp_frame(frame.size())) return false;
+    memcpy(dpp_msg_tlv->dpp_frame(), frame.data(), frame.size());
+
+    // Send directly to the peer Agent's AL MAC (Network Introduction is agent-to-agent,
+    // not routed through the Controller).
+    auto db = AgentDB::get();
+    return m_btl_ctx.send_cmdu_to_broker(m_cmdu_tx, peer_mac, db->bridge.mac);
+}
+
+bool DppAgentTask::send_1905_encap_eapol(const sMacAddr &peer_mac,
+                                                    const std::vector<uint8_t> &eapol_frame)
+{
+    auto cmdu_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::IEEE1905_ENCAP_EAPOL_MESSAGE);
+    if (!cmdu_header) return false;
+
+    auto eapol_tlv = m_cmdu_tx.addClass<wfa_map::tlv1905EncapEapol>();
+    if (!eapol_tlv) return false;
+
+    if (!eapol_tlv->alloc_payload(eapol_frame.size())) return false;
+    memcpy(eapol_tlv->payload(), eapol_frame.data(), eapol_frame.size());
+
+    // EAPOL 4-way handshake runs agent-to-agent (peer_mac), not via the Controller.
+    auto db = AgentDB::get();
+    return m_btl_ctx.send_cmdu_to_broker(m_cmdu_tx, peer_mac, db->bridge.mac);
+}
+
+// ============================================================================
+// handle_direct_encap_dpp — merged dispatch for DIRECT_ENCAP_DPP_MESSAGE
+//
+// Combines the wired-extender frame-type dispatch with the 1905 Peer
+// Discovery dispatch into one deterministic switch, replacing the former
+// task-pool race arbitration between two separate tasks.
+// ============================================================================
+
+bool DppAgentTask::handle_direct_encap_dpp(const sMacAddr &src_mac,
+                                            ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // On a gateway (colocated Controller + local Agent), both processes subscribe to
+    // DIRECT_ENCAP_DPP_MESSAGE and would otherwise each answer the same Peer Discovery
+    // Request/Response — DppConfiguratorTask already owns this exchange for the local
+    // Controller, so the local Agent must not also respond.
+    auto db = AgentDB::get();
+    if (db->device_conf.local_controller) {
+        return false;
+    }
+
+    bool is_dpp_wired_extender =
+        (db->dpp_extender_config.onboarding_type == AgentDB::OnboardingType::DPP &&
+         db->dpp_bootstrap.valid &&
+         !db->dpp_credentials.initialized);
+
+    auto dpp_msg_tlv = cmdu_rx.getClass<wfa_map::tlvDppMessage>();
+    if (!dpp_msg_tlv) {
+        LOG(ERROR) << "DPP: DIRECT_ENCAP_DPP missing tlvDppMessage";
+        return false;
+    }
+
+    const uint8_t *frame = dpp_msg_tlv->dpp_frame();
+    size_t frame_len     = dpp_msg_tlv->dpp_frame_length();
+
+    if (!frame || frame_len < 7) {
+        LOG(ERROR) << "DPP: DIRECT_ENCAP_DPP frame too short";
+        return false;
+    }
+
+    uint8_t frame_type = frame[6];
+
+    switch (frame_type) {
+    case DPP_PA_AUTHENTICATION_REQUEST:
+        if (is_dpp_wired_extender)
+            return handle_dpp_wired_auth_request(src_mac, frame, frame_len);
+        return false;
+    case DPP_PA_AUTHENTICATION_CONFIRM:
+        if (is_dpp_wired_extender)
+            return handle_dpp_wired_auth_confirm(src_mac, frame, frame_len);
+        return false;
+    case DPP_PA_PEER_DISCOVERY_REQUEST:
+        return handle_peer_discovery_request(src_mac, frame, frame_len);
+    case DPP_PA_PEER_DISCOVERY_RESPONSE:
+        return handle_peer_discovery_response(src_mac, frame, frame_len);
+    default:
+        // GAS Initial Response: frame[0] == 0x0B (WLAN_PA_GAS_INITIAL_RESP).
+        // GAS frames don't use the DPP Public Action header so frame_type == 0xFF.
+        if (is_dpp_wired_extender && frame_len > 0 && frame[0] == 0x0B)
+            return handle_dpp_wired_gas_response(src_mac, frame, frame_len);
+        return false;
+    }
+}
+
