+            }
+            bss_config_report->add_radios(radio_entry);
+        }
+    } else {
+        LOG(ERROR) << "DPP: failed to add tlvBssConfigurationReport";
+    }
+
+    // 2. Agent AP MLD Configuration TLV (optional, §17.2.96)
+    if (!slave_thread::add_agent_ap_mld_configuration_tlv(m_cmdu_tx)) {
+        LOG(DEBUG) << "DPP: no Agent AP MLD Configuration TLV added";
+    }
+
+    // 3. Backhaul STA MLD Configuration TLV (optional, §17.2.97)
+    if (!slave_thread::add_backhaul_sta_mld_configuration_tlv(m_cmdu_tx)) {
+        LOG(DEBUG) << "DPP: no Backhaul STA MLD Configuration TLV added";
+    }
+
+    // 4. EHT Operations TLV (optional, §17.2.103)
+    if (!slave_thread::add_eht_operations_tlv(m_cmdu_tx)) {
+        LOG(DEBUG) << "DPP: no EHT Operations TLV added";
+    }
+
+    LOG(INFO) << "DPP: sending BSS Configuration Result to " << src_mac;
+    m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
