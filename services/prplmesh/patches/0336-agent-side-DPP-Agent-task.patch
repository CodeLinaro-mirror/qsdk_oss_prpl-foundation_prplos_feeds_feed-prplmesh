+bool ApAutoConfigurationTask::send_dpp_radio_info_notification(const std::string &radio_iface)
+{
+    auto db    = AgentDB::get();
+    auto radio = db->radio(radio_iface);
+    if (!radio) {
+        LOG(ERROR) << "Cannot find radio for " << radio_iface;
+        return false;
+    }
+
+    auto notification = message_com::create_vs_message<
+        beerocks_message::cACTION_CONTROL_DPP_RADIO_INFO_NOTIFICATION>(m_cmdu_tx);
+    if (!notification) {
+        LOG(ERROR) << "Failed building cACTION_CONTROL_DPP_RADIO_INFO_NOTIFICATION!";
+        return false;
+    }
+
+    string_utils::copy_string(notification->iface_name(beerocks::message::IFACE_NAME_LENGTH),
+                              radio->front.iface_name.c_str(),
+                              beerocks::message::IFACE_NAME_LENGTH);
+
+    network_utils::iface_info bridge_info;
+    if (network_utils::get_iface_info(bridge_info, db->bridge.iface_name) == 0) {
+        notification->bridge_ipv4() = network_utils::ipv4_from_string(bridge_info.ip);
+    } else {
+        LOG(WARNING) << "Failed reading addresses for: " << db->bridge.iface_name;
+    }
+
+    if (db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless) {
+        auto wireless_bh_radio = db->radio(db->backhaul.selected_iface_name);
+        notification->backhaul_mac() =
+            wireless_bh_radio ? wireless_bh_radio->back.iface_mac : net::network_utils::ZERO_MAC;
+        notification->backhaul_is_wireless() = 1;
+    } else if (db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wired) {
+        notification->backhaul_mac()         = db->ethernet.wan.mac;
+        notification->backhaul_is_wireless() = 0;
+    } else {
+        notification->backhaul_mac()         = net::network_utils::ZERO_MAC;
+        notification->backhaul_is_wireless() = 0;
+    }
+
+    m_btl_ctx.send_cmdu_to_controller(radio_iface, m_cmdu_tx);
+    LOG(DEBUG) << "DPP: sent radio info notification for " << radio_iface;
+    return true;
+}
