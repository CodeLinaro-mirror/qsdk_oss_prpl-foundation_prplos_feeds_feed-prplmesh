+                              | (static_cast<uint16_t>(blob[offset + 1]) << 8);
+            uint16_t sub_len  = static_cast<uint16_t>(blob[offset + 2])
+                              | (static_cast<uint16_t>(blob[offset + 3]) << 8);
+            offset += 4;
