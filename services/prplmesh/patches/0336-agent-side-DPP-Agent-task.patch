+    auto resp_tlvs = cmdu_rx.getClassList<wfa_map::tlvBssConfigurationResponse>();
+    for (const auto &tlv : resp_tlvs) {
+        if (!tlv || tlv->dpp_configuration_object_length() == 0) continue;
+
+        const uint8_t *blob     = tlv->dpp_configuration_object();
+        size_t         blob_len = tlv->dpp_configuration_object_length();
+        size_t         offset   = 0;
+
