+                ie.backhaul_bss   = bssid.backhaul_bss;
+                ie.fronthaul_bss  = bssid.fronthaul_bss;
+                ie.r1_disallowed  = bssid.backhaul_bss_disallow_profile1_agent_association;
+                ie.r2_disallowed  = bssid.backhaul_bss_disallow_profile2_agent_association;
+                bss_info->set_ssid(bssid.ssid);
