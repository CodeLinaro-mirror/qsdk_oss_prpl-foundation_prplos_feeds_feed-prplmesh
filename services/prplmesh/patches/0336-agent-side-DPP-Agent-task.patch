+    /**
+     * @brief DPP extender configuration (read from UCI at startup).
+     *
+     * Only meaningful when management_mode == BPL_MGMT_MODE_MULTIAP_AGENT.
+     * Gateway/Controller modes ignore these settings.
+     *
+     * UCI options in /etc/config/prplmesh:
+     *   option onboardingtype      'DPP'  (or 'WSC' — default)
+     *   option Enable1905Security  '1'    (or '0')
+     *
+     * Security is active only when all three conditions hold:
+     *   1. link_encryption == true          (Enable1905Security=1)
+     *   2. management_mode == MULTIAP_AGENT (agent-only, not gateway)
+     *   3. onboarding_type == DPP           (Profile-3 / DPP mode)
+     */
+    enum class OnboardingType { WSC, DPP };
+
+    struct sDppExtenderConfig {
+        OnboardingType onboarding_type = OnboardingType::WSC;
+        bool link_encryption           = true;  // maps to Enable1905Security UCI option
+
+        /// Set from 0xA9 TLV presence in AP-Autoconfig Response (§17.1.2).
+        /// true  → controller requires Peer Discovery + EAPOL + TK.
+        /// false → skip Peer Discovery and EAPOL; send BSS Config Request directly.
+        bool controller_requires_1905_security = false;
+
+        /// Set to true when BSS config has been sent to at least one ap_manager.
+        /// Used to suppress agent_reset() during hostapd reload on wired DPP extenders
+        /// (where dpp_credentials.initialized is never set via the wireless path).
+        bool bss_config_sent = false;
+
+        /** Returns true when all conditions for 1905 link encryption are met.
+         *  Mirrors mapService_is1905SecurityEnabled() in qca-ezmesh. */
+        bool is_1905_security_enabled(uint8_t mgmt_mode) const
+        {
+            // mgmt_mode == 2 is BPL_MGMT_MODE_MULTIAP_AGENT (from bpl_cfg.h)
+            // Avoid including bpl_cfg.h in agent_db.h to prevent circular deps
+            return link_encryption && (mgmt_mode == 2) &&
+                   (onboarding_type == OnboardingType::DPP);
+        }
+    } dpp_extender_config;
+
+    /**
+     * @brief DPP bootstrap key (pre-provisioned by user).
+     *
+     * Loaded at startup from /etc/prplmesh/dpp/bootstrap_key.pem and
+     * /etc/prplmesh/dpp_uri. Same key used in both wired and wireless modes.
+     * In wireless mode, the private key is injected into wpa_supplicant via
+     * DPP_BOOTSTRAP_GEN key=<hex_DER>.
+     */
+    struct sDppBootstrapKey {
+        EVP_PKEY *private_key   = nullptr;  // bR — EC P-256 private key
+        std::vector<uint8_t> key_der;       // compressed SPKI DER of BR (public key)
+        std::array<uint8_t, 32> chirp_hash{};   // SHA256("chirp" || key_der) — used for Presence Announcement matching
+        std::array<uint8_t, 32> pubkey_hash{};  // SHA256(key_der) — used for hostapd pkhash in dpp_controller
+        std::string dpp_uri;                // DPP:V:3;K:<base64url(key_der)>;;
+        bool valid              = false;    // true when key loaded and validated
+
+        ~sDppBootstrapKey() {
+            if (private_key) {
+                EVP_PKEY_free(private_key);
+                private_key = nullptr;
+            }
+        }
+    } dpp_bootstrap;
+
+    /**
+     * @brief Wired DPP extender session state — active during DPP Auth exchange.
+     * Cleared after Auth Confirm is verified and GAS Config exchange begins.
+     */
+    struct sDppWiredSession {
+        sMacAddr controller_mac          = {};
+        EVP_PKEY *initiator_protocol_key = nullptr;
+        EVP_PKEY *agent_protocol_key     = nullptr;
+        std::array<uint8_t, 16> i_nonce  = {};
+        std::array<uint8_t, 16> r_nonce  = {};
+        std::array<uint8_t, 16> e_nonce  = {};
+        std::array<uint8_t, 32> ke       = {};
+        std::vector<uint8_t> M_x;
+        std::vector<uint8_t> N_x;
+        uint8_t gas_dialog_token = 0;
+        bool active = false;
+
+        // Non-copyable — raw EVP_PKEY* ownership must not be accidentally duplicated.
+        sDppWiredSession() = default;
+        sDppWiredSession(const sDppWiredSession &) = delete;
+        sDppWiredSession &operator=(const sDppWiredSession &) = delete;
+
+        void reset() {
+            // Free owned keys first, then zero all fields individually.
+            if (initiator_protocol_key) { EVP_PKEY_free(initiator_protocol_key); initiator_protocol_key = nullptr; }
+            if (agent_protocol_key)     { EVP_PKEY_free(agent_protocol_key);     agent_protocol_key     = nullptr; }
+            controller_mac   = {};
+            i_nonce.fill(0); r_nonce.fill(0); e_nonce.fill(0); ke.fill(0);
+            M_x.clear(); N_x.clear();
+            gas_dialog_token = 0;
+            active           = false;
+        }
+
+        ~sDppWiredSession() {
+            if (initiator_protocol_key) EVP_PKEY_free(initiator_protocol_key);
+            if (agent_protocol_key)     EVP_PKEY_free(agent_protocol_key);
+        }
+    } dpp_wired_session;
