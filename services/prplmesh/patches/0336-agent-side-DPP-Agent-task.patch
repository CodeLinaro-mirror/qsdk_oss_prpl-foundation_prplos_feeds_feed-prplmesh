+// DPP TCP wire format constants (from hostapd dpp_tcp.c)
+// ---------------------------------------------------------------------------
+
+/** 802.11 Public Action frame type byte (DPP Public Action frames) */
+static constexpr uint8_t WLAN_PA_VENDOR_SPECIFIC = 0x09;
+
+/** GAS Initial Request type byte */
+static constexpr uint8_t WLAN_PA_GAS_INITIAL_REQ = 0x0A;
+
+/** GAS Initial Response type byte */
+static constexpr uint8_t WLAN_PA_GAS_INITIAL_RESP = 0x0B;
+
+/** GAS Comeback Response type byte */
+static constexpr uint8_t WLAN_PA_GAS_COMEBACK_RESP = 0x0C;
+
+/** GAS Comeback Request type byte */
+static constexpr uint8_t WLAN_PA_GAS_COMEBACK_REQ = 0x0D;
+
+// ---------------------------------------------------------------------------
+// DPP Public Action frame layout (after TCP header strip)
+// Offset 0-2: OUI = 50:6F:9A
+// Offset 3:   OUI Type = 0x1A (DPP)
+// Offset 4:   Crypto Suite = 0x01
+// Offset 5:   DPP Frame Type (subtype)
+// Offset 6+:  DPP Attributes (TLV-encoded)
+// ---------------------------------------------------------------------------
+
+static constexpr size_t DPP_HDR_LEN        = 6; ///< OUI(3)+OUIType(1)+CryptoSuite(1)+FrameType(1)
+static constexpr size_t DPP_SUBTYPE_OFFSET = 5; ///< Byte index of DPP Frame Type in frame body
+
+/** DPP Public Action frame subtypes (from hostapd dpp.h enum dpp_public_action_frame_type) */
+static constexpr uint8_t DPP_PA_AUTHENTICATION_REQ    = 0x00;
+static constexpr uint8_t DPP_PA_AUTHENTICATION_RESP   = 0x01; ///< NOT 0x02 — 0x02 is Auth Confirm
+static constexpr uint8_t DPP_PA_AUTHENTICATION_CONF   = 0x02;
+static constexpr uint8_t DPP_PA_CONFIGURATION_RESULT  = 0x0B; ///< 11
+static constexpr uint8_t DPP_PA_PRESENCE_ANNOUNCEMENT = 0x0D; ///< 13
+
+// ---------------------------------------------------------------------------
+// DPP Attribute TLV format (little-endian IDs and lengths)
+// [2 bytes ID LE][2 bytes Length LE][N bytes Value]
+// ---------------------------------------------------------------------------
+
+static constexpr uint16_t DPP_ATTR_R_BOOTSTRAP_KEY_HASH = 0x1002;
+
+// ---------------------------------------------------------------------------
+// DPP Wired Extender — attribute IDs (little-endian in frame).
+// DPP_ATTR_STATUS / DPP_ATTR_CONNECTOR / DPP_ATTR_TRANS_ID are class-scope
+// members (see dpp_agent_task.h) shared with the 1905-security section below,
+// so they are intentionally not repeated here.
+// ---------------------------------------------------------------------------
+
+static constexpr uint16_t DPP_ATTR_R_BOOTSTRAP_HASH   = 0x1002;
+static constexpr uint16_t DPP_ATTR_I_BOOTSTRAP_HASH   = 0x1001;
+static constexpr uint16_t DPP_ATTR_I_PROTOCOL_KEY     = 0x1003;
+static constexpr uint16_t DPP_ATTR_WRAPPED_DATA        = 0x1004;
+static constexpr uint16_t DPP_ATTR_I_NONCE             = 0x1005;
+static constexpr uint16_t DPP_ATTR_I_CAPABILITIES     = 0x1006;
+static constexpr uint16_t DPP_ATTR_R_NONCE             = 0x1007;
+static constexpr uint16_t DPP_ATTR_R_CAPABILITIES     = 0x1008;
+static constexpr uint16_t DPP_ATTR_R_PROTOCOL_KEY     = 0x1009;
+static constexpr uint16_t DPP_ATTR_I_AUTH_TAG          = 0x100A;
+static constexpr uint16_t DPP_ATTR_R_AUTH_TAG          = 0x100B;
+static constexpr uint16_t DPP_ATTR_PROTOCOL_VERSION   = 0x1019;
+static constexpr uint16_t DPP_ATTR_ENROLLEE_NONCE     = 0x1014;
+static constexpr uint16_t DPP_ATTR_NET_ACCESS_KEY     = 0x100E;
+
+static const uint8_t *find_attr(const uint8_t *attrs, size_t attrs_len,
+                                 uint16_t attr_id, uint16_t *out_len)
+{
+    size_t offset = 0;
+    while (offset + 4 <= attrs_len) {
+        uint16_t id  = attrs[offset] | (static_cast<uint16_t>(attrs[offset + 1]) << 8);
+        uint16_t len = attrs[offset + 2] | (static_cast<uint16_t>(attrs[offset + 3]) << 8);
+        if (offset + 4 + len > attrs_len) break;
+        if (id == attr_id) {
+            if (out_len) *out_len = len;
+            return attrs + offset + 4;
+        }
+        offset += 4 + len;
+    }
+    return nullptr;
+}
+
+static bool hkdf_extract(const uint8_t *salt, size_t salt_len,
+                          const uint8_t *ikm,  size_t ikm_len,
+                          uint8_t *prk, size_t *prk_len)
+{
+    // Use EVP_Q_mac (OpenSSL 3.0) instead of deprecated HMAC()
+    size_t out_len = 0;
+    if (!EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+                   salt, salt_len, ikm, ikm_len, prk, EVP_MAX_MD_SIZE, &out_len)) {
+        return false;
+    }
+    *prk_len = out_len;
+    return true;
+}
+
+static bool hkdf_expand(const uint8_t *prk, size_t prk_len,
+                         const char *info, size_t info_len,
+                         uint8_t *out, size_t out_len)
+{
+    // Use EVP_Q_mac (OpenSSL 3.0) for HMAC instead of deprecated HMAC_CTX_new
+    uint8_t t[32] = {};
+    size_t t_len  = 0;
+    size_t done   = 0;
+    uint8_t counter = 1;
+    while (done < out_len) {
+        // Build input: T(i-1) || info || counter
+        std::vector<uint8_t> input;
+        input.insert(input.end(), t, t + t_len);
+        input.insert(input.end(), reinterpret_cast<const uint8_t *>(info),
+                     reinterpret_cast<const uint8_t *>(info) + info_len);
+        input.push_back(counter++);
+
+        uint8_t tmp[32] = {};
+        size_t mac_len  = 0;
+        if (!EVP_Q_mac(nullptr, "HMAC", nullptr, "SHA256", nullptr,
+                       prk, prk_len, input.data(), input.size(),
+                       tmp, sizeof(tmp), &mac_len)) {
+            return false;
+        }
+        memcpy(t, tmp, mac_len);
+        t_len = mac_len;
+        size_t copy = std::min(out_len - done, mac_len);
+        memcpy(out + done, t, copy);
+        done += copy;
+    }
+    return true;
+}
+
+// ============================================================================
+// RFC 5297 AES-SIV helpers — manual implementation matching hostapd/libwpa2.
+// Uses AES-128-ECB (always available) for OMAC1/CMAC and AES-128-CTR for
+// encryption. Does NOT use EVP_CIPHER_fetch("AES-SIV") which is unavailable
+// on embedded OpenSSL 3.x minimal provider builds.
+// K = 32 bytes: K1 = key[0..15] (OMAC1/CMAC), K2 = key[16..31] (CTR)
+// ============================================================================
+
+// OMAC1 (CMAC) using AES-128-ECB — matches hostapd omac1_aes_128()
+static bool omac1_aes128(const uint8_t *k1, const uint8_t *data, size_t len, uint8_t out[16])
+{
+    // Subkey generation
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+    if (!ctx) return false;
+    if (EVP_EncryptInit_ex(ctx, EVP_aes_128_ecb(), nullptr, k1, nullptr) != 1 ||
+        EVP_CIPHER_CTX_set_padding(ctx, 0) != 1) {
+        EVP_CIPHER_CTX_free(ctx); return false;
+    }
+
+    // Generate subkeys K1s and K2s from AES(key, 0)
+    uint8_t L[16] = {};
+    int enc_len = 0;
+    if (EVP_EncryptUpdate(ctx, L, &enc_len, L, 16) != 1 || enc_len != 16) {
+        EVP_CIPHER_CTX_free(ctx); return false;
+    }
+
+    uint8_t K1s[16], K2s[16];
+    // K1s = dbl(L)
+    memcpy(K1s, L, 16);
+    {
+        int carry = K1s[0] & 0x80;
+        for (int i = 0; i < 15; i++)
+            K1s[i] = static_cast<uint8_t>((K1s[i] << 1) | (K1s[i+1] >> 7));
+        K1s[15] = static_cast<uint8_t>((K1s[15] << 1) ^ (carry ? 0x87 : 0x00));
+    }
+    // K2s = dbl(K1s)
+    memcpy(K2s, K1s, 16);
+    {
+        int carry = K2s[0] & 0x80;
+        for (int i = 0; i < 15; i++)
+            K2s[i] = static_cast<uint8_t>((K2s[i] << 1) | (K2s[i+1] >> 7));
+        K2s[15] = static_cast<uint8_t>((K2s[15] << 1) ^ (carry ? 0x87 : 0x00));
+    }
+
+    // Process data blocks
+    uint8_t x[16] = {};
+    size_t n_blocks = (len + 15) / 16;
+    if (n_blocks == 0) n_blocks = 1;
+
+    for (size_t i = 0; i < n_blocks - 1; i++) {
+        for (int j = 0; j < 16; j++) x[j] ^= data[i*16 + j];
+        if (EVP_EncryptUpdate(ctx, x, &enc_len, x, 16) != 1) {
+            EVP_CIPHER_CTX_free(ctx); return false;
+        }
+    }
+
+    // Last block
+    size_t rem = len - (n_blocks - 1) * 16;
+    uint8_t last[16] = {};
+    if (rem == 16) {
+        memcpy(last, data + (n_blocks-1)*16, 16);
+        for (int j = 0; j < 16; j++) last[j] ^= K1s[j];
+    } else {
+        memcpy(last, data + (n_blocks-1)*16, rem);
+        last[rem] = 0x80;
+        for (int j = 0; j < 16; j++) last[j] ^= K2s[j];
+    }
+    for (int j = 0; j < 16; j++) x[j] ^= last[j];
+    if (EVP_EncryptUpdate(ctx, out, &enc_len, x, 16) != 1 || enc_len != 16) {
+        EVP_CIPHER_CTX_free(ctx); return false;
+    }
+
+    EVP_CIPHER_CTX_free(ctx);
+    return true;
+}
+
+static void dbl_block(uint8_t b[16])
+{
+    int carry = b[0] & 0x80;
+    for (int i = 0; i < 15; i++)
+        b[i] = static_cast<uint8_t>((b[i] << 1) | (b[i + 1] >> 7));
+    b[15] = static_cast<uint8_t>((b[15] << 1) ^ (carry ? 0x87 : 0x00));
+}
+
+static void xor_block(uint8_t *a, const uint8_t *b, size_t len)
+{
+    for (size_t i = 0; i < len; i++) a[i] ^= b[i];
+}
+
+static bool s2v(const uint8_t *k1, const std::vector<std::vector<uint8_t>> &aad,
+                const std::vector<uint8_t> &plaintext, uint8_t siv[16])
+{
+    static const uint8_t zero16[16] = {};
+    uint8_t d[16];
+    if (!omac1_aes128(k1, zero16, 16, d)) return false;
+    for (const auto &ad : aad) {
+        uint8_t tmp[16];
+        if (!omac1_aes128(k1, ad.data(), ad.size(), tmp)) return false;
+        dbl_block(d); xor_block(d, tmp, 16);
+    }
+    if (plaintext.size() >= 16) {
+        std::vector<uint8_t> buf(plaintext);
+        xor_block(buf.data() + buf.size() - 16, d, 16);
+        if (!omac1_aes128(k1, buf.data(), buf.size(), siv)) return false;
+    } else {
+        uint8_t pad[16] = {};
+        memcpy(pad, plaintext.data(), plaintext.size());
+        pad[plaintext.size()] = 0x80;
+        dbl_block(d); xor_block(d, pad, 16);
+        if (!omac1_aes128(k1, d, 16, siv)) return false;
+    }
+    return true;
+}
+
+static bool aes_ctr_crypt(const uint8_t *k2, const uint8_t iv[16],
+                           const uint8_t *in, uint8_t *out, size_t len)
+{
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+    if (!ctx) return false;
+    if (EVP_EncryptInit_ex(ctx, EVP_aes_128_ctr(), nullptr, k2, iv) != 1) {
+        EVP_CIPHER_CTX_free(ctx); return false;
+    }
+    int outl = 0, finl = 0;
+    bool ok = (EVP_EncryptUpdate(ctx, out, &outl, in, static_cast<int>(len)) == 1 &&
+               EVP_EncryptFinal_ex(ctx, out + outl, &finl) == 1);
+    EVP_CIPHER_CTX_free(ctx);
+    return ok;
+}
+
+static bool aes_siv_encrypt(const uint8_t *key, size_t key_len,
+                              const uint8_t *pt, size_t pt_len,
+                              const std::vector<std::vector<uint8_t>> &ad,
+                              std::vector<uint8_t> &ciphertext)
+{
+    if (!key || key_len != 32 || !pt || pt_len == 0) return false;
+    const uint8_t *k1 = key, *k2 = key + 16;
+    std::vector<uint8_t> plaintext(pt, pt + pt_len);
+
+    uint8_t siv[16];
+    if (!s2v(k1, ad, plaintext, siv)) return false;
+
+    uint8_t ctr_iv[16];
+    memcpy(ctr_iv, siv, 16);
+    ctr_iv[8] &= 0x7F; ctr_iv[12] &= 0x7F;
+
+    ciphertext.resize(16 + pt_len);
+    memcpy(ciphertext.data(), siv, 16);
+    return aes_ctr_crypt(k2, ctr_iv, pt, ciphertext.data() + 16, pt_len);
+}
+
+static bool aes_siv_decrypt(const uint8_t *key, size_t key_len,
+                              const uint8_t *ct, size_t ct_len,
+                              const std::vector<std::vector<uint8_t>> &ad,
+                              std::vector<uint8_t> &plaintext)
+{
+    if (!key || key_len != 32 || !ct || ct_len < 16) return false;
+    const uint8_t *k1 = key, *k2 = key + 16;
+    const uint8_t *siv = ct;
+    size_t pt_len = ct_len - 16;
+
+    uint8_t ctr_iv[16];
+    memcpy(ctr_iv, siv, 16);
+    ctr_iv[8] &= 0x7F; ctr_iv[12] &= 0x7F;
+
+    plaintext.resize(pt_len);
+    if (!aes_ctr_crypt(k2, ctr_iv, ct + 16, plaintext.data(), pt_len)) {
+        plaintext.clear(); return false;
+    }
+
+    uint8_t check[16];
+    if (!s2v(k1, ad, plaintext, check) || memcmp(check, siv, 16) != 0) {
+        plaintext.clear(); return false;
+    }
+    return true;
+}
+
+static void append_attr(std::vector<uint8_t> &buf, uint16_t id,
+                         const uint8_t *val, uint16_t len)
+{
+    buf.push_back(id & 0xFF);
+    buf.push_back((id >> 8) & 0xFF);
+    buf.push_back(len & 0xFF);
+    buf.push_back((len >> 8) & 0xFF);
+    if (val && len) buf.insert(buf.end(), val, val + len);
+}
+
+// AES Key Unwrap (RFC 3394) helper: extract GTK from EAPOL M3 Key Data.
+// KEK = PTK[16:32] (16 bytes).  Returns true and fills gtk_out/key_id_out on success.
+static bool extract_gtk_from_m3(const uint8_t *eapol_frame, size_t len,
+                                  const uint8_t kek[16],
+                                  std::array<uint8_t, 32> &gtk_out,
+                                  uint8_t &key_id_out)
+{
+    // Key Data Length is at bytes [97-98] (big-endian) per IEEE 802.11 EAPOL-Key frame layout:
+    // [4]=DescType [5-6]=KeyInfo [7-8]=KeyLen [9-16]=Replay [17-48]=ANonce
+    // [49-64]=KeyIV [65-72]=KeyRSC [73-80]=KeyID [81-96]=MIC [97-98]=KeyDataLen [99+]=KeyData
+    if (len < 99) return false;
+    uint16_t kd_len = (static_cast<uint16_t>(eapol_frame[97]) << 8) | eapol_frame[98];
+    if (len < static_cast<size_t>(99 + kd_len) || kd_len < 8) return false;
+
+    // AES Key Unwrap (RFC 3394) using EVP API (OpenSSL 3.x compatible).
+    // EVP_aes_128_wrap with AES-128 KEK: plaintext = wrapped_len - 8 bytes.
+    std::vector<uint8_t> plain(kd_len);  // output can be at most kd_len bytes
+    int plain_len = 0;
+
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+    if (!ctx) return false;
+
+    // EVP_aes_128_wrap expects input to include the 8-byte IV header
+    EVP_CIPHER_CTX_set_flags(ctx, EVP_CIPHER_CTX_FLAG_WRAP_ALLOW);
+    bool ok = (EVP_DecryptInit_ex(ctx, EVP_aes_128_wrap(), nullptr, kek, nullptr) == 1 &&
+               EVP_DecryptUpdate(ctx, plain.data(), &plain_len,
+                                 eapol_frame + 99, kd_len) == 1);
+    int final_len = 0;
+    if (ok) EVP_DecryptFinal_ex(ctx, plain.data() + plain_len, &final_len);
+    EVP_CIPHER_CTX_free(ctx);
+    if (!ok) return false;
+    plain.resize(static_cast<size_t>(plain_len + final_len));
+
+    // Walk KDEs: type(1B)+len(1B)+OUI(3B)+data_type(1B)+KeyID(1B)+GTK(32B)
+    // 1905 GTK KDE: OUI=50:6F:9A, DataType=0x00 (EasyMesh v6.1 §5.3.7.3 Tables 11+12)
+    const uint8_t *p   = plain.data();
+    size_t         rem = plain.size();
+    while (rem >= 2) {
+        uint8_t t = p[0], l = p[1];
+        if (t == 0xDD && l >= 37 && rem >= static_cast<size_t>(2 + l) &&
+            p[2] == 0x50 && p[3] == 0x6F && p[4] == 0x9A && p[5] == 0x00) {
+            key_id_out = p[6] & 0x03;
+            memcpy(gtk_out.data(), p + 7, 32);
+            return true;
+        }
+        if (static_cast<size_t>(2 + l) > rem) break;
+        p   += 2 + l;
+        rem -= 2 + l;
+    }
+    return false;
+}
+
+// Helper: base64url-decode a string (handles url-safe alphabet and missing padding)
+static std::vector<uint8_t> base64url_decode(const std::string &in)
+{
+    std::string s = in;
+    // Convert url-safe to standard
+    for (char &c : s) {
+        if (c == '-') c = '+';
+        if (c == '_') c = '/';
+    }
+    // Pad to multiple of 4
+    while (s.size() % 4) s += '=';
+
+    std::vector<uint8_t> out;
+    BIO *b64  = BIO_new(BIO_f_base64());
+    BIO *bmem = BIO_new_mem_buf(s.data(), static_cast<int>(s.size()));
+    bmem      = BIO_push(b64, bmem);
+    BIO_set_flags(bmem, BIO_FLAGS_BASE64_NO_NL);
+    out.resize(s.size()); // upper bound
+    int len = BIO_read(bmem, out.data(), static_cast<int>(out.size()));
+    BIO_free_all(bmem);
+    if (len > 0) out.resize(static_cast<size_t>(len));
+    else out.clear();
+    return out;
+}
