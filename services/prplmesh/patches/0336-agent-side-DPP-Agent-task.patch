+            // Extract AKM
+            auto akm_pos = json.find("\"akm\":\"");
+            if (akm_pos != std::string::npos) {
+                akm_pos += 7;
+                auto akm_end = json.find('"', akm_pos);
+                if (akm_end != std::string::npos)
+                    cfg.akm = json.substr(akm_pos, akm_end - akm_pos);
+            }
+
+            // Extract passphrase
+            auto pass_pos = json.find("\"pass\":\"");
+            if (pass_pos != std::string::npos) {
+                pass_pos += 8;
+                auto pass_end = json.find('"', pass_pos);
+                if (pass_end != std::string::npos)
+                    cfg.passphrase = json.substr(pass_pos, pass_end - pass_pos);
