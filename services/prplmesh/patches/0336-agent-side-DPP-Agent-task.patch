+namespace beerocks {
+
+// Forward declaration
+class slave_thread;
+
+/**
+ * @brief DPP Agent Task
+ *
+ * Implements the DPP Relay Proxy role for the prplMesh Agent, the wired DPP
+ * Extender onboarding state machine, and the Agent-side 1905-layer security
+ * establishment (EasyMesh §5.3.7).
+ *
+ * Wireless relay: The raw TCP:8908 relay socket to hostapd is owned in-process by
+ * slave_thread's bwl::slave_wlan_hal (common/beerocks/bwl/include/bwl/slave_wlan_hal.h) —
+ * on the NL80211 (openwrt) backend this is backed by the shared bwl::dpp_relay_socket
+ * engine (common/beerocks/bwl/include/bwl/dpp_relay_socket.h); this task is notified of
+ * received frames via the Dpp_Frame_Received event and sends frames back to hostapd via
+ * direct calls to slave_wlan_hal::dpp_send_frame() — no cross-process/CMDU hop is involved.
+ *
+ *   Uplink:   Receives DPP frame notifications from the relay HAL, encapsulates them into
+ *             IEEE 1905.1 Proxied Encap DPP / Chirp Notification CMDUs, and forwards to the
+ *             Controller.
+ *   Downlink: Receives Proxied Encap DPP CMDUs from the Controller, extracts the
+ *             raw DPP frame, and sends it to hostapd via the relay HAL.
+ *
+ * Only one Enrollee session is active at a time over the wireless relay (single-Enrollee
+ * policy, enforced inside dpp_relay_socket's handle_accept()).
+ *
+ * Wired Extender onboarding: owns the complete wired DPP extender enrollment state
+ * machine:
+ *   Auth Request → Auth Response → Auth Confirm
+ *   → GAS Config Request → GAS Config Response → Config Result
+ *   → Peer Discovery → BSS Config Request → BSS Config Response
+ *
+ * 1905-layer security: handles AGENT_LIST_MESSAGE, DIRECT_ENCAP_DPP_MESSAGE (Peer
+ * Discovery Request/Response), and IEEE1905_ENCAP_EAPOL_MESSAGE (4-way handshake
+ * M1-M4), per EasyMesh §5.3.7 and dpp_agent_1905_security_design.md:
+ *   1. Handle AGENT_LIST_MESSAGE: for each peer Agent with Security=ENABLED,
+ *      check if PTK is derived; if not, initiate 1905 Network Introduction.
+ *   2. 1905 Network Introduction (Peer Discovery Request/Response):
+ *      - Initiator: send Peer Discovery Request with own Connector
+ *      - Responder: verify peer Connector, derive PMK, send Response
+ *   3. 1905 4-way handshake (EAPOL M1→M2→M3→M4):
+ *      - Authenticator role (Responder in Peer Discovery): send M1, M3
+ *      - Supplicant role (Initiator in Peer Discovery): send M2, M4
+ *   4. Install TK after successful handshake for AES-SIV encryption
+ */
+class DppAgentTask : public Task {
+public:
+    /**
+     * @brief Constructor.
+     *
+     * @param btl_ctx Reference to the slave thread context.
+     * @param cmdu_tx CMDU transmit buffer.
+     */
+    DppAgentTask(slave_thread &btl_ctx, ieee1905_1::CmduMessageTx &cmdu_tx);
+
+    ~DppAgentTask() = default;
+
+    /** Periodic timeout checks for the wired Extender Auth and Chirp timers. */
+    void work() override;
+
+    /**
+     * @brief Handle incoming CMDU messages (downlink from Controller).
+     *
+     * Handles PROXIED_ENCAP_DPP_MESSAGE from the Controller and forwards
+     * the encapsulated DPP frame to hostapd via the relay HAL; AGENT_LIST_MESSAGE
+     * and IEEE1905_ENCAP_EAPOL_MESSAGE for 1905-layer security; and
+     * DIRECT_ENCAP_DPP_MESSAGE, routed by DPP frame type to either the wired
+     * Extender onboarding handlers or the 1905 Peer Discovery handlers.
+     */
+    bool handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                     const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                     std::shared_ptr<beerocks_header> beerocks_header) override;
+
+    /**
+     * @brief Notify the task that a DPP frame was received from hostapd via the relay HAL.
+     *
+     * @param tcp_type  TCP type byte (first byte of payload after length header).
+     * @param frame     Pointer to the frame body (after TCP header strip).
+     * @param frame_len Length of the frame body in bytes.
+     */
+    void on_dpp_frame_received(uint8_t tcp_type, const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Notify the task that hostapd's connection state to the relay changed, as
+     * reported by slave_thread's bwl::slave_wlan_hal Dpp_Client_Connected/
+     * Dpp_Client_Disconnected events (routed through hal_event_handler()). The listener itself
+     * is always active once slave_thread has started the relay via init_dpp_relay(), so there
+     * is no separate "server active" signal.
+     *
+     * @param client_connected true if hostapd is currently connected to the relay.
+     */
+    void on_relay_status(bool client_connected);
+
+    /**
+     * @brief Returns true if slave_thread has started the relay HAL's TCP listener.
+     * Used by slave_thread to decide whether to suppress the ap_manager's
+     * CHIRP_NOTIFICATION_MESSAGE (which would be a duplicate), and as the
+     * idempotency guard before starting the listener.
+     */
+    bool is_relay_active() const { return m_relay_active; }
+
+    /**
+     * @brief Trigger BSS Configuration Request directly (no 4-way handshake).
+     *
+     * Called from son_slave_thread when link_encryption=false (0xA9 TLV absent in
+     * AP-Autoconfig Response) after wireless credentials are loaded from tmpfs.
+     */
+    bool trigger_bss_config_request(const sMacAddr &controller_mac);
+
+    // -------------------------------------------------------------------------
+    // External entry points (called from son_slave_thread.cpp)
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Handle AGENT_LIST_MESSAGE from Controller.
+     *
+     * For each peer Agent with Security=ENABLED and no existing TK,
+     * initiates 1905 Network Introduction.
+     */
+    bool handle_agent_list(const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Handle DIRECT_ENCAP_DPP_MESSAGE.
+     *
+     * Routes to Peer Discovery Request or Response handler based on DPP frame type.
+     */
+    bool handle_direct_encap_dpp(const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Handle IEEE1905_ENCAP_EAPOL_MESSAGE.
+     *
+     * Routes to M1/M2/M3/M4 handler based on EAPOL Key Info field.
+     */
+    bool handle_1905_encap_eapol(const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx);
+
+private:
+    /**
+     * @brief Send a raw DPP frame to hostapd via the relay HAL.
+     *
+     * @param tcp_type  802.11 Public Action type byte (e.g. 0x09 or 0x0B).
+     * @param frame     Raw DPP frame body.
+     * @param frame_len Length of the raw DPP frame in bytes.
+     * @return true on success, false if no active hostapd connection or send failed.
+     */
+    bool send_dpp_frame(uint8_t tcp_type, const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Called when hostapd transitions from disconnected to connected.
+     * Flushes any pending buffered GAS Config Response.
+     */
+    void on_hostapd_connected();
+
+    // -------------------------------------------------------------------------
+    // Uplink frame dispatch (hostapd → Controller)
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Dispatch a complete TCP frame received from hostapd.
+     *
+     * @param tcp_type  TCP type byte (first byte of payload after length header).
+     * @param frame     Pointer to the frame body (after TCP header strip).
+     * @param frame_len Length of the frame body in bytes.
+     */
+    void dispatch_dpp_frame(uint8_t tcp_type, const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Handle a DPP Presence Announcement frame (subtype 0x00).
+     * Extracts the bootstrapping key hash and sends a Chirp Notification CMDU.
+     */
+    void handle_presence_announcement(const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Handle a DPP Authentication Response frame (subtype 0x02).
+     * Sends a Proxied Encap DPP CMDU (frame_type=PUBLIC_ACTION) to the Controller.
+     */
+    void handle_auth_response(const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Handle a DPP Configuration Result frame (subtype 0x0B).
+     * Sends a Proxied Encap DPP CMDU (frame_type=PUBLIC_ACTION) to the Controller.
+     */
+    void handle_config_result(const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Handle a GAS Initial Request frame (type 0x0A).
+     * Sends a Proxied Encap DPP CMDU (frame_type=GAS_FRAME) to the Controller.
+     */
+    void handle_gas_request(const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Send a Proxied Encap DPP CMDU to the Controller.
+     *
+     * @param frame      Raw DPP frame body.
+     * @param frame_len  Length of the frame body.
+     * @param is_gas     true for GAS frames, false for Public Action frames.
+     */
+    void send_proxied_encap_dpp(const uint8_t *frame, size_t frame_len, bool is_gas);
+
+    // -------------------------------------------------------------------------
+    // Downlink frame dispatch (Controller → hostapd)
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Handle a Proxied Encap DPP message received from the Controller.
+     * Extracts the encapsulated DPP frame and sends it to hostapd via TCP.
+     */
+    void handle_proxied_encap_dpp_from_controller(ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    // -------------------------------------------------------------------------
+    // Wired DPP Auth exchange
+    // -------------------------------------------------------------------------
+
+    bool handle_dpp_wired_auth_request(const sMacAddr &src_mac,
+                                        const uint8_t *frame, size_t frame_len);
+
+    bool build_and_send_auth_response(const sMacAddr &controller_mac);
+
+    bool handle_dpp_wired_auth_confirm(const sMacAddr &src_mac,
+                                        const uint8_t *frame, size_t frame_len);
+
+    // -------------------------------------------------------------------------
+    // GAS Config exchange
+    // -------------------------------------------------------------------------
+
+    bool build_gas_config_request(const sMacAddr &controller_mac);
+
+    bool handle_dpp_wired_gas_response(const sMacAddr &src_mac,
+                                        const uint8_t *frame, size_t frame_len);
+
+    // -------------------------------------------------------------------------
+    // Post-config: Peer Discovery → BSS Config
+    // -------------------------------------------------------------------------
+
+    bool initiate_peer_discovery(const sMacAddr &controller_mac);
+
+    bool send_bss_configuration_request(const sMacAddr &controller_mac);
+
+    // -------------------------------------------------------------------------
+    // Wired DPP CMDU send helpers
+    // -------------------------------------------------------------------------
+
+    bool send_direct_encap_dpp_to_controller(const sMacAddr &peer_mac,
+                                              const std::vector<uint8_t> &frame);
+
+    // -------------------------------------------------------------------------
+    // 1905 Network Introduction
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Initiate 1905 Network Introduction with a peer Agent.
+     *
+     * Sends a DPP Peer Discovery Request frame (via DIRECT_ENCAP_DPP_MESSAGE)
+     * containing this Agent's Connector (netRole="mapAgent").
+     *
+     * @param peer_mac  Peer Agent AL MAC address
+     */
+    bool initiate_1905_network_introduction(const sMacAddr &peer_mac);
+
+    /**
+     * @brief Handle DPP Peer Discovery Request from a peer Agent (Responder role).
+     *
+     * Verifies peer's Connector, derives 1905 PMK, sends Peer Discovery Response,
+     * then initiates 4-way handshake as Authenticator.
+     *
+     * @param src_mac   Source Agent AL MAC
+     * @param frame     Raw DPP frame bytes
+     * @param len       Frame length
+     */
+    bool handle_peer_discovery_request(const sMacAddr &src_mac,
+                                        const uint8_t *frame, size_t len);
+
+    /**
+     * @brief Handle DPP Peer Discovery Response from a peer Agent (Initiator role).
+     *
+     * Verifies peer's Connector, derives 1905 PMK.
+     * Then waits for EAPOL M1 from the peer (Authenticator).
+     *
+     * @param src_mac   Source Agent AL MAC
+     * @param frame     Raw DPP frame bytes
+     * @param len       Frame length
+     */
+    bool handle_peer_discovery_response(const sMacAddr &src_mac,
+                                         const uint8_t *frame, size_t len);
+
+    /**
+     * @brief Send DPP Peer Discovery Response to a peer Agent.
+     *
+     * @param peer_mac   Destination Agent AL MAC
+     * @param success    true = STATUS_OK, false = STATUS_INVALID_CONNECTOR
+     * @param connector  Our Connector to include (only when success=true)
+     */
+    bool send_peer_discovery_response(const sMacAddr &peer_mac, bool success,
+                                       const std::string &connector);
+
+    // -------------------------------------------------------------------------
+    // 1905 PMK derivation
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Derive 1905 PMK from ECDH shared secret.
+     *
+     * Per Easy Connect §6.6.4:
+     *   N = agent_nak_private * peer_nak_public  (ECDH)
+     *   PMK = HKDF(<>, "DPP PMK", N.x)
+     *
+     * @param peer_mac      Peer Agent AL MAC (key into peer_1905_security map)
+     * @param peer_nak_der  Peer's netAccessKey as DER-encoded SubjectPublicKeyInfo
+     */
+    bool derive_1905_pmk(const sMacAddr &peer_mac,
+                          const std::vector<uint8_t> &peer_nak_der);
+
+    // -------------------------------------------------------------------------
+    // 1905 4-way handshake
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Initiate 1905 4-way handshake as Authenticator (send M1).
+     *
+     * Called after sending Peer Discovery Response.
+     * Generates ANonce and sends EAPOL-Key M1 via IEEE1905_ENCAP_EAPOL_MESSAGE.
+     *
+     * @param peer_mac  Peer Agent AL MAC
+     */
+    bool initiate_4way_handshake_authenticator(const sMacAddr &peer_mac);
+
+    /**
+     * @brief Handle EAPOL-Key M1 as Supplicant (send M2).
+     *
+     * Extracts ANonce, generates SNonce, derives PTK, sends M2 with MIC.
+     *
+     * @param src_mac      Source Agent AL MAC (Authenticator)
+     * @param eapol_frame  Raw EAPOL-Key frame
+     * @param len          Frame length
+     */
+    bool handle_eapol_m1(const sMacAddr &src_mac,
+                          const uint8_t *eapol_frame, size_t len);
+
+    /**
+     * @brief Handle EAPOL-Key M2 as Authenticator (send M3).
+     *
+     * Extracts SNonce, derives PTK, verifies MIC, sends M3 with GTK KDE.
+     *
+     * @param src_mac      Source Agent AL MAC (Supplicant)
+     * @param eapol_frame  Raw EAPOL-Key frame
+     * @param len          Frame length
+     */
+    bool handle_eapol_m2(const sMacAddr &src_mac,
+                          const uint8_t *eapol_frame, size_t len);
+
+    /**
+     * @brief Handle EAPOL-Key M3 as Supplicant (send M4, install TK).
+     *
+     * Verifies MIC, extracts GTK, sends M4, installs TK.
+     *
+     * @param src_mac      Source Agent AL MAC (Authenticator)
+     * @param eapol_frame  Raw EAPOL-Key frame
+     * @param len          Frame length
+     */
+    bool handle_eapol_m3(const sMacAddr &src_mac,
+                          const uint8_t *eapol_frame, size_t len);
+
+    /**
+     * @brief Handle EAPOL-Key M4 as Authenticator (install TK).
+     *
+     * Verifies MIC, installs TK.
+     *
+     * @param src_mac      Source Agent AL MAC (Supplicant)
+     * @param eapol_frame  Raw EAPOL-Key frame
+     * @param len          Frame length
+     */
+    bool handle_eapol_m4(const sMacAddr &src_mac,
+                          const uint8_t *eapol_frame, size_t len);
+
+    // -------------------------------------------------------------------------
+    // PTK derivation
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Derive 1905 PTK (512-bit) from PMK.
+     *
+     * Per EasyMesh §5.3.7.2 and IEEE 802.11 §12.7.1.3:
+     *   PTK = KDF-SHA256-512(PMK, "Pairwise Key Expansion",
+     *                        min(AA,SPA) || max(AA,SPA) ||
+     *                        min(ANonce,SNonce) || max(ANonce,SNonce))
+     *
+     * AA  = Authenticator AL MAC (Responder in Peer Discovery)
+     * SPA = Supplicant AL MAC (Initiator in Peer Discovery)
+     *
+     * @param peer_mac    Peer Agent AL MAC
+     * @param peer_state  Reference to peer security state (contains PMK, nonces)
+     * @param is_authenticator  true if this Agent is the Authenticator
+     */
+    bool derive_1905_ptk(const sMacAddr &peer_mac,
+                          AgentDB::s1905PeerSecurity &peer_state,
+                          bool is_authenticator);
+
+    // -------------------------------------------------------------------------
+    // EAPOL frame builders
+    // -------------------------------------------------------------------------
+
+    /** @brief Build EAPOL-Key M1 (ANonce, no MIC). */
+    std::vector<uint8_t> build_eapol_key_m1(const std::array<uint8_t, 32> &anonce,
+                                              uint64_t replay_counter);
+
+    /** @brief Build EAPOL-Key M2 (SNonce + MIC). */
+    std::vector<uint8_t> build_eapol_key_m2(const std::array<uint8_t, 32> &anonce,
+                                              const std::array<uint8_t, 32> &snonce,
+                                              const std::array<uint8_t, 64> &ptk,
+                                              uint64_t replay_counter);
+
+    /** @brief Build EAPOL-Key M3 (GTK KDE encrypted + MIC). */
+    std::vector<uint8_t> build_eapol_key_m3(const std::array<uint8_t, 32> &anonce,
+                                              const std::array<uint8_t, 64> &ptk,
+                                              const std::array<uint8_t, 32> &gtk,
+                                              uint8_t gtk_key_id,
+                                              uint64_t replay_counter);
+
+    /** @brief Build EAPOL-Key M4 (MIC only). */
+    std::vector<uint8_t> build_eapol_key_m4(const std::array<uint8_t, 64> &ptk,
+                                              uint64_t replay_counter);
+
+    // -------------------------------------------------------------------------
+    // EAPOL frame parsing helpers
+    // -------------------------------------------------------------------------
+
+    /** @brief Determine EAPOL-Key message number (1=M1, 2=M2, 3=M3, 4=M4, 0=unknown). */
+    static uint8_t get_eapol_key_msg_num(const uint8_t *eapol_frame, size_t len);
+
+    /** @brief Extract Nonce from EAPOL-Key frame (offset 17, 32 bytes). */
+    static bool extract_nonce(const uint8_t *eapol_frame, size_t len,
+                               std::array<uint8_t, 32> &nonce);
+
+    /** @brief Verify EAPOL-Key MIC using KCK (first 32 bytes of PTK). */
+    static bool verify_eapol_mic(const uint8_t *eapol_frame, size_t len,
+                                  const uint8_t *kck);
+
+    // -------------------------------------------------------------------------
+    // 1905 DPP frame helpers
+    // -------------------------------------------------------------------------
+
+    /** @brief Get DPP frame type byte (offset 5 in DPP Public Action frame). */
+    static uint8_t get_dpp_frame_type(const uint8_t *frame, size_t len);
+
+    /** @brief Find a DPP attribute by ID in an attribute buffer. */
+    static const uint8_t *find_dpp_attr(const uint8_t *attrs, size_t attrs_len,
+                                         uint16_t attr_id, uint16_t *attr_len);
+
+    /** @brief Append a DPP attribute (ID[2LE] + Len[2LE] + Value) to a frame. */
+    static void append_dpp_attr(std::vector<uint8_t> &frame, uint16_t id,
+                                 const uint8_t *value, uint16_t len);
+
+    // -------------------------------------------------------------------------
+    // Connector helpers
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Verify a DPP Connector JWS signature using the C-sign-key.
+     *
+     * @param connector_jws  JWS compact serialization
+     * @param c_sign_key_jwk Configurator's C-sign-key as JWK JSON string
+     */
+    static bool verify_connector(const std::string &connector_jws,
+                                  const std::string &c_sign_key_jwk);
+
+    /**
+     * @brief Extract the netAccessKey JWK from a DPP Connector.
+     *
+     * @param connector_jws  JWS compact serialization
+     * @return netAccessKey as DER-encoded SubjectPublicKeyInfo bytes, empty on failure
+     */
+    static std::vector<uint8_t> extract_nak_der_from_connector(
+        const std::string &connector_jws);
+
+    // -------------------------------------------------------------------------
+    // 1905 CMDU send helpers
+    // -------------------------------------------------------------------------
+
+    /** @brief Send a DIRECT_ENCAP_DPP_MESSAGE to a peer Agent. */
+    bool send_direct_encap_dpp_to_peer(const sMacAddr &peer_mac,
+                                        const std::vector<uint8_t> &frame);
+
+    /** @brief Send an IEEE1905_ENCAP_EAPOL_MESSAGE to a peer Agent. */
+    bool send_1905_encap_eapol(const sMacAddr &peer_mac,
+                                const std::vector<uint8_t> &eapol_frame);
+
+    /**
+     * @brief Cache an Authentication Request frame for a bootstrap hash.
+     */
+    void cache_auth_request(const uint8_t hash[32], const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Check whether a cached Authentication Request exists for the hash.
+     */
+    bool get_cached_auth_request(const uint8_t hash[32], const uint8_t *&frame,
+                                 size_t &frame_len);
+
+    /**
+     * @brief Clear a cached Authentication Request for a bootstrap hash.
+     */
+    void clear_cached_auth_request(const uint8_t hash[32]);
+
+    /**
+     * @brief Return current monotonic time in milliseconds.
+     */
+    static uint64_t monotonic_time_ms();
+
+    // -------------------------------------------------------------------------
+    // Member variables
+    // -------------------------------------------------------------------------
+
+    slave_thread &m_btl_ctx;
+    ieee1905_1::CmduMessageTx &m_cmdu_tx;
+
+    /** True if PlatformManager's TCP:8908 relay listener is active. */
+    bool m_relay_active = false;
+
+    /** True if hostapd is currently connected to PlatformManager's relay. */
+    bool m_hostapd_connected = false;
+
+    /** Cached Authentication Request frames keyed by bootstrap hash. */
+    struct sAuthRequestCacheEntry {
+        std::vector<uint8_t> frame;
+        uint16_t frame_len = 0;
+        uint64_t timestamp_ms = 0;
+        bool valid = false;
+    };
+
+    /** Bootstrap-hash indexed cache of the last Authentication Request. */
+    std::map<std::array<uint8_t, 32>, sAuthRequestCacheEntry> m_auth_request_cache;
+
+    /**
+     * Pending GAS response (Config Response) that arrived from the Controller while
+     * the TCP connection to hostapd was closed (race: GAS Initial Request arrived in
+     * dpp_tcp_drain() just before the FIN, so tcp_client_fd=-1 when the response comes back).
+     * Delivered to hostapd on the next TCP connection from hostapd.
+     */
+    struct sPendingGasResponse {
+        uint8_t tcp_type = 0;           ///< WLAN_PA_GAS_INITIAL_RESP (0x0B)
+        std::vector<uint8_t> frame;     ///< raw frame body (after stripping leading type byte)
+        bool valid = false;
+    };
+    sPendingGasResponse m_pending_gas_response;
+
+    // Auth Response sent time — used to detect Auth Confirm timeout.
+    std::chrono::steady_clock::time_point m_auth_response_sent_time{};
+
+    // Chirp sent time — used to detect Auth Request timeout after Search+Chirp.
+    std::chrono::steady_clock::time_point m_chirp_sent_time{};
+
+    static constexpr int DPP_AUTH_TIMEOUT_SECONDS         = 10;
+    static constexpr int DPP_AUTH_REQUEST_TIMEOUT_SECONDS = 10; // spec §5.3.5 DPP_TIMER
+
+    // DPP frame type constants (Easy Connect §8.2.1)
+    static constexpr uint8_t DPP_PA_AUTHENTICATION_REQUEST  = 0x00;
+    static constexpr uint8_t DPP_PA_AUTHENTICATION_CONFIRM  = 0x02;
+    static constexpr uint8_t DPP_PA_CONFIGURATION_RESULT    = 0x0B;
+    static constexpr uint8_t DPP_PA_PEER_DISCOVERY_REQUEST  = 0x05;
+    static constexpr uint8_t DPP_PA_PEER_DISCOVERY_RESPONSE = 0x06;
+
+    // DPP Attribute IDs (Easy Connect §8.1)
+    static constexpr uint16_t DPP_ATTR_STATUS    = 0x1000;
+    static constexpr uint16_t DPP_ATTR_CONNECTOR = 0x100D;
+    static constexpr uint16_t DPP_ATTR_TRANS_ID  = 0x1016;
+
+    // DPP Status values
+    static constexpr uint8_t DPP_STATUS_OK                = 0;
+    static constexpr uint8_t DPP_STATUS_INVALID_CONNECTOR = 7;
+    static constexpr uint8_t DPP_STATUS_NO_MATCH          = 8;
+};
+
+} // namespace beerocks
+
+#endif // _DPP_AGENT_TASK_H_
