+// handle_bss_configuration_response — DPP VAP credential application
+// ============================================================================
+//
+// Parses JSON DPP config objects from tlvBssConfigurationResponse TLVs and
+// applies them to all radios in WAIT_AP_CONFIGURATION_COMPLETE state.
+// This is the DPP equivalent of the WSC M2 credential application.
+//
+// JSON format (1905-layer config):
+//   {"wi-fi_tech":"map","discovery":{"ssid":"<ssid>"},"map_bss_type":64,
+//    "dfCounterThreshold":5,"cred":{"akm":"dpp","signedConnector":"...",...}}
+//
+// JSON format (backhaul STA config — for wireless extenders):
+//   {"wi-fi_tech":"map","discovery":{"ssid":"<ssid>"},
+//    "cred":{"akm":"506F9A02+000FAC08","pass":"<psk>","signedConnector":"..."}}
+
+void ApAutoConfigurationTask::handle_bss_configuration_response(
+    ieee1905_1::CmduMessageRx &cmdu_rx, const sMacAddr &src_mac)
+{
+    auto db = AgentDB::get();
+
+    LOG(INFO) << "DPP: BSS Configuration Response from " << src_mac
+              << " — applying VAP credentials";
+
+#ifdef USE_PRPLMESH_NLHAL
+    // Clear the MLD pair entrant file so all ap_managers start with a fresh
+    // registration. Stale entries from a previous run cause the mld_pair_entrant.txt
+    // race: the 5GHz ap_manager finds an old wlan2_1 entry and creates separate
+    // MLO groups instead of linking to the 2.4GHz-registered wlan0_1. Clearing here
+    // (before any ap_manager processes WILD_MAC allocations) mirrors what WSC does in
+    // handle_ap_autoconfiguration_wsc_renew().
+    {
+        const char *mld_entrant_file = "/tmp/beerocks/mld_pair_entrant.txt";
+        FILE *f = fopen(mld_entrant_file, "w");
+        if (f) {
+            fclose(f);
+            LOG(INFO) << "DPP: cleared " << mld_entrant_file << " before BSS config";
+        }
+    }
+#endif
+
+    // Collect all config object JSON strings from the TLVs.
+    // Each tlvBssConfigurationResponse carries a binary payload of sub-TLVs:
+    //   type (2B LE) + len (2B LE) + JSON bytes
+    // All Wi-Fi BSS config objects use type 0x100c.  Parse every sub-TLV entry.
+    struct sDppBssConfig {
+        std::string ssid;
+        std::string passphrase;
+        std::string akm;
+        std::string wifi_tech;       // "map"=backhaul BSS, "inframap"=fronthaul BSS
+        std::string ruid;            // hex radio UID, e.g. "00037f123535" (no colons)
+        std::string vap_label;       // from "Extension-ID" or vendor field
+        std::string custom_alias;    // from "customAlias" (HOME/GUEST/VIDEO/BACKHAUL/HOTSPOT role tag)
+        uint8_t     map_bss_type  = 0;  // 0x40=backhaul BSS, 0x20=fronthaul BSS
+        bool        hidden_ssid   = false;  // from "SSIDAdvertisement": false → hidden
+        bool        ssid_advert_present = false; // true when field was found in JSON
+    };
