+    case Event::AWGN_Detected: {
+        if (!data) {
+            LOG(ERROR) << "AWGN_Detected without data!";
+            return false;
+        }
+
+        auto msg = static_cast<bwl::sACTION_APMANAGER_HOSTAP_AWGN_DETECTED_NOTIFICATION *>(data);
+        LOG(INFO) << "AWGN detected on channel " << int(msg->params.channel)
+                  << ", Freq " << int(msg->params.frequency);
