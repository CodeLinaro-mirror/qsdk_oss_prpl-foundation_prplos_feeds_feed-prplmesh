+void ChannelSelectionTask::handle_vs_awgn_detected_notification(
+    ieee1905_1::CmduMessageRx &cmdu_rx, int fd, std::shared_ptr<beerocks_header> beerocks_header)
+{
+    auto notification =
+        beerocks_header
+            ->addClass<beerocks_message::cACTION_BACKHAUL_HOSTAP_AWGN_DETECTED_NOTIFICATION>();
+    if (!notification) {
+        LOG(ERROR) << "addClass cACTION_BACKHAUL_HOSTAP_AWGN_DETECTED_NOTIFICATION failed";
+        return;
+    }
+
+    auto db = AgentDB::get();
+    auto radio =
+        db->get_radio_by_mac(beerocks_header->actionhdr()->radio_mac(), AgentDB::eMacType::RADIO);
+    if (!radio) {
+        return;
+    }
+
+    const auto &sender_iface_name = radio->front.iface_name;
+    const auto channel            = notification->params().channel;
+
+    LOG(INFO) << "Received AWGN_DETECTED notification from " << sender_iface_name
+              << " for channel " << int(channel);
+
+    // Mark channel as AWGN detected in the database
+    auto channel_it = radio->channels_list.find(channel);
+    if (channel_it != radio->channels_list.end()) {
+        channel_it->second.awgn_detected = true;
+        LOG(INFO) << "Marked channel " << int(channel) << " as AWGN detected in Agent DB";
+    } else {
+        LOG(WARNING) << "Channel " << int(channel) << " not found in channels list for radio "
+                     << sender_iface_name;
+    }
+
+    // Trigger Channel Preference Report
+    m_pending_preference.preference_ready.clear();
+    m_pending_preference.preference_ready[radio->front.iface_mac] = false;
+    m_send_preference_report_after_awgn_event = true;
+
+    auto agent_fd = m_btl_ctx.get_agent_fd();
+    if (agent_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "socket to Agent not found";
+        return;
+    }
+
+    LOG(DEBUG) << "Requesting updated channel list for AWGN event handling";
+
+    // Request updated channel list
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_BACKHAUL_CHANNELS_LIST_REQUEST>(m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "Failed to build message";
+        return;
+    }
+
+    auto action_header         = message_com::get_beerocks_header(m_cmdu_tx)->actionhdr();
+    action_header->radio_mac() = radio->front.iface_mac;
+
+    m_btl_ctx.send_cmdu(agent_fd, m_cmdu_tx);
+}
