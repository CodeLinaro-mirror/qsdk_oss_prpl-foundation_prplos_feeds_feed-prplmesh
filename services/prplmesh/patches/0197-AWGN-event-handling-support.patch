+        // Forward to slave thread (son_slave_thread)
+        auto notification = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_HOSTAP_AWGN_DETECTED_NOTIFICATION>(cmdu_tx);
+
+        if (!notification) {
+            LOG(ERROR) << "Failed to create AWGN notification message";
+            return false;
+        }
+
+        notification->params().channel = msg->params.channel;
+        notification->params().frequency = msg->params.frequency;
+
+        LOG(INFO) << "AWGN notified to slave thread";
+        // Send to slave
+        send_cmdu(cmdu_tx);
