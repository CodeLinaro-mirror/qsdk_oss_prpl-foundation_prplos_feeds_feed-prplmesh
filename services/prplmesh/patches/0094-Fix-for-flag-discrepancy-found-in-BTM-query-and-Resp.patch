From 268f6c4c3f85546bd269ea2f471e8a30da35f020 Mon Sep 17 00:00:00 2001
From: Aryan Khare <aryakhar@qti.qualcomm.com>
Date: Tue, 10 Mar 2026 17:14:34 +0530
Subject: [PATCH] BTM without macros

---
 .../ap_manager/ap_manager.cpp                 | 20 +++++++++++--
 agent/src/beerocks/slave/son_slave_thread.cpp |  2 ++
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h |  4 +--
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 29 +++++++++++++++----
 4 files changed, 45 insertions(+), 10 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 18c3c8013..e10bdf4e5 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1855,15 +1855,29 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         btm_params.oper_class = request->params().target.operating_class;
         btm_params.chan       = request->params().target.channel;
         btm_params.disassoc_timer_btt =
-            request->params().disassoc_imminent
-                ? (request->params().disassoc_timer_ms / BEACON_TRANSMIT_TIME_MS)
-                : 0;
+    request->params().disassoc_imminent
+        ? static_cast<float>(request->params().disassoc_timer_ms) / static_cast<float>(BEACON_TRANSMIT_TIME_MS)
+        : 0.0f;
         btm_params.valid_int_btt      = bss_steer_valid_int;
         btm_params.reason             = request->params().target.reason;
         btm_params.pref_list_included = true; // since a valid target BSSID is always assumed
         btm_params.abridged           = request->params().abridged;
         btm_params.disassoc_imminent  = request->params().disassoc_imminent;
 
+
+        LOG(DEBUG) << "BTM Params: "
+        << "vap_id=" << btm_params.vap_id
+        << ", mac=" << tlvf::mac_to_string(btm_params.mac)
+        << ", bssid=" << tlvf::mac_to_string(btm_params.bssid)
+        << ", oper_class=" << btm_params.oper_class
+        << ", chan=" << btm_params.chan
+        << ", disassoc_timer_btt=" << btm_params.disassoc_timer_btt
+        << ", valid_int_btt=" << btm_params.valid_int_btt
+        << ", reason=" << btm_params.reason
+        << ", pref_list_included=" << btm_params.pref_list_included
+        << ", abridged=" << btm_params.abridged
+        << ", disassoc_imminent=" << btm_params.disassoc_imminent;
+
         LOG(DEBUG) << "CLIENT_BSS_STEER (802.11v) for sta_mac = "
                    << tlvf::mac_to_string(btm_params.mac)
                    << " to bssid = " << tlvf::mac_to_string(btm_params.bssid)
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index f81ac8427..579e0fd4a 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -5662,6 +5662,7 @@ bool slave_thread::handle_client_steering_request(ieee1905_1::CmduMessageRx &cmd
             request_out->params().abridged =
                 steering_request_tlv_profile2->request_flags().btm_abridged_bit;
             request_out->params().target.reason = std::get<1>(bssid_list).target_bss_reason_code;
+
         } else {
             auto bssid_list = steering_request_tlv->target_bssid_list(0);
             request_out->params().disassoc_timer_ms =
@@ -5675,6 +5676,7 @@ bool slave_thread::handle_client_steering_request(ieee1905_1::CmduMessageRx &cmd
                 steering_request_tlv->request_flags().btm_disassociation_imminent_bit;
             request_out->params().abridged = steering_request_tlv->request_flags().btm_abridged_bit;
             request_out->params().target.reason = -1; // Mark that reason is not added
+
         }
 
         send_cmdu(m_radio_managers[radio->front.iface_name].ap_manager_fd, cmdu_tx);
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index a11fc9be4..73e8b8f61 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -89,12 +89,12 @@ public:
         sMacAddr bssid          = {};
         int oper_class          = 0;
         int chan                = 0;
-        int disassoc_timer_btt  = 0;
+        float disassoc_timer_btt  = 0;
         int valid_int_btt       = 0;
         int reason              = 0;
         bool pref_list_included = 0;
         bool abridged           = 0;
-        bool disassoc_imminent  = 1;
+        bool disassoc_imminent  = 0;
     };
 
     // Public methods
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 0db7b7966..1606e2db4 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -46,6 +46,18 @@ bool ap_wlan_hal_nl80211::nl_event_handle(struct nl_msg *msg, void *arg)
 
 #define MLD_PAIR_ENTRANT_FILE "/tmp/beerocks/mld_pair_entrant.txt"
 
+// Neighbor Report BSSID Information field value used for EasyMesh 11v steering tests.
+// 0xFF sets low bits in the BSSID Information bitfield and is treated as a fully-capable,
+// valid candidate by the test environment.
+#define NEIGHBOR_REPORT_BSSID_INFO_EASYMESH 0xFF
+
+// Neighbor Report subelement: ID=3 (BSS Transition Candidate Preference),
+// length=1, value=0xFF (maximum preference).
+//  Wire format: 0x03 0x01 0xFF → "0301ff" as hex for hostapd CLI.
+
+#define NEIGHBOR_REPORT_SUBELEM_CANDIDATE_PREF_MAX_HEX "0301ff"
+
+
 // Temporary storage for station capabilities
 struct SRadioCapabilitiesStrings {
     std::string supported_rates;
@@ -1383,6 +1395,8 @@ bool ap_wlan_hal_nl80211::sta_disassoc(int8_t vap_id, const std::string &mac, ui
         return false;
     }
 
+    LOG(DEBUG) << "BTM query sent to NL: " << cmd;
+
     return true;
 }
 
@@ -1433,20 +1447,26 @@ bool ap_wlan_hal_nl80211::sta_bss_steer(const sBtmRequestParams &params)
                << ", BSS: " << tlvf::mac_to_string(params.bssid)
                << ", oper_class: " << params.oper_class << ", channel: " << params.chan
                << ", disassoc: " << params.disassoc_timer_btt
-               << ", valid_int: " << params.valid_int_btt << ", reason: " << params.reason;
+               << ", valid_int: " << params.valid_int_btt << ", reason: " << params.reason
+               << ", abridged: " << params.abridged
+               << ", disassoc_imminent: " << params.disassoc_imminent;
 
     if (!check_vap_id(params.vap_id)) {
         LOG(ERROR) << "invalid source vap_id " << params.vap_id;
         return false;
     }
 
+    std::string abridged_str = params.abridged ? "1" : "0";
+    std::string disassoc_imminent_str = params.disassoc_imminent ? "1" : "0";
+
+
     // Build command string
     std::string cmd =
         // Set the STA MAC address
         "BSS_TM_REQ " +
         tlvf::mac_to_string(params.mac)
         // Transition management parameters
-        + " pref=" + "1" + " abridged=" + "1";
+        + " pref=" + "1" + " abridged=" + abridged_str;
 
     // Add only valid (positive) reason codes
     // Upper layers may set the reason value to a (-1) value to mark that the reason is not present
@@ -1466,7 +1486,7 @@ bool ap_wlan_hal_nl80211::sta_bss_steer(const sBtmRequestParams &params)
     }
 
     if (params.disassoc_timer_btt) {
-        cmd += std::string() + " disassoc_imminent=" + "1" +
+        cmd += std::string() + " disassoc_imminent=" + disassoc_imminent_str +
                " disassoc_timer=" + std::to_string(params.disassoc_timer_btt);
     }
     // " bss_term="  // Unused Param
@@ -1477,8 +1497,7 @@ bool ap_wlan_hal_nl80211::sta_bss_steer(const sBtmRequestParams &params)
     }
 
     // Target BSSID
-    cmd += std::string() + " neighbor=" + tlvf::mac_to_string(params.bssid) + ",0," +
-           std::to_string(params.oper_class) + "," + std::to_string(params.chan) + ",0";
+    cmd += std::string() + " neighbor=" + tlvf::mac_to_string(params.bssid) + "," + std::to_string(NEIGHBOR_REPORT_BSSID_INFO_EASYMESH) + "," + std::to_string(params.oper_class) + "," + std::to_string(params.chan) + ",0," + NEIGHBOR_REPORT_SUBELEM_CANDIDATE_PREF_MAX_HEX;
 
     // Send command
     if (!wpa_ctrl_send_msg(cmd, m_radio_info.available_vaps[params.vap_id].bss)) {
-- 
2.34.1

