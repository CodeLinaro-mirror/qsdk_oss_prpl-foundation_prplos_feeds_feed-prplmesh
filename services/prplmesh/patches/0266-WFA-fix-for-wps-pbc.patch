From 44743fa7db0bfba9e757ce8943ede57c312d9c1c Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Mon, 13 Jul 2026 11:45:37 +0530
Subject: [PATCH] WFA fix for wps pbc

The interface name was not being fetched properly to invoke
wps pbc. So made changes for that.

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 23 ++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 335e8c5..cea903e 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -1421,9 +1421,26 @@ bool ap_wlan_hal_whm::pre_generate_connected_clients_events()
 bool ap_wlan_hal_whm::start_wps_pbc()
 {
     AmbiorixVariant args, result;
-    std::string main_vap_ifname = m_radio_info.available_vaps[0].bss;
-    std::string wps_path        = wbapi_utils::search_path_ap_by_iface(main_vap_ifname) + "WPS.";
-    bool ret                    = m_ambiorix_cl.call(wps_path, "InitiateWPSPBC", args, result);
+
+    // VAP IDs on PrplOS start at 1 (matching the interface suffix, e.g. wlan1.1 -> vap_id=1).
+    // available_vaps[0] is always empty, so iterate to find the first active fronthaul VAP.
+    std::string main_vap_ifname;
+    for (const auto &vap_kv : m_radio_info.available_vaps) {
+        if (!vap_kv.second.bss.empty() && vap_kv.second.fronthaul) {
+            main_vap_ifname = vap_kv.second.bss;
+            break;
+        }
+    }
+
+    if (main_vap_ifname.empty()) {
+        LOG(ERROR) << "start_wps_pbc(): no fronthaul VAP found in available_vaps";
+        return false;
+    }
+
+    std::string wps_path = wbapi_utils::search_path_ap_by_iface(main_vap_ifname) + "WPS.";
+    LOG(DEBUG) << "start_wps_pbc(): main_vap_ifname=" << main_vap_ifname
+               << " wps_path=" << wps_path;
+    bool ret = m_ambiorix_cl.call(wps_path, "InitiateWPSPBC", args, result);
 
     if (!ret) {
         LOG(ERROR) << "start_wps_pbc() failed!";
-- 
2.34.1

