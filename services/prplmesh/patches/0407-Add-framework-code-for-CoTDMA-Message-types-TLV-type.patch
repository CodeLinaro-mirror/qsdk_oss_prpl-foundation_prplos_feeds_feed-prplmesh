 {
     s_wifi_compat_entries = entries;
@@ -112,6 +117,19 @@ void tlvf_qca_utils::set_current_agent_smd_capabilities(const sQcaSmdCapabilitie
     s_current_agent_smd_caps = caps;
 }
 
+void tlvf_qca_utils::set_cotdma_qmid_entries(const std::vector<sCoTdmaMsduFwdQmidEntry> &entries)
+{
