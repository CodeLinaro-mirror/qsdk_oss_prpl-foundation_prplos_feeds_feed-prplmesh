index 000000000..45840032e
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcCapabilityUpdate.yaml
@@ -0,0 +1,60 @@
+#
+---
+_include: {
+  tlvf/common/sMacAddr.h,
+  tlvf/wfa_map/eTlvTypeMap.h,
+}
+_namespace: wfa_map
+
+# MAPC Capability Update TLV
+# Sent by the Agent to the Controller (in a MAPC_REPORT_MESSAGE) when the Agent
+# receives a MAPC Capability Report notification from hostapd.
+# Reports per-BSS MAPC capability bitmaps and Co-TDMA profiles.
+
+eMapcCapabilityBit:
+  _type: enum
+  _comment: |
+    Bit positions within MAPC_Capability_Bitmap (uint16_t).
+    B0: Co-BF  (Coordinated Beamforming)
+    B1: Co-SR  (Coordinated Spatial Reuse)
+    B2: Co-TDMA
+    B3: Co-rTWT (Coordinated restricted TWT)
+    B4: Co-CR  (Coordinated Channel Reuse)
+    B5-B15: Reserved
+  CO_BF:   0x0001
+  CO_SR:   0x0002
+  CO_TDMA: 0x0004
+  CO_RTWT: 0x0008
+  CO_CR:   0x0010
+
+sMapcBssCapability:
+  _type: struct
+  bssid: sMacAddr
+  mapc_capability_bitmap:
+    _type: uint16_t
+    _comment: |
+      Bitmask of supported MAPC capabilities. See eMapcCapabilityBit.
+      B0=Co-BF, B1=Co-SR, B2=Co-TDMA, B3=Co-rTWT, B4=Co-CR, B5-B15=Reserved.
+  ctdma_profile_len:
+    _type: uint8_t
+    _comment: Length of the Co-TDMA profile data (4 to 6 octets).
+  ctdma_profile:
+    _type: uint64_t
+    _comment: |
+      802.11 Co-TDMA profile specifying Co-TDMA Info, BW, CCFS, BSS color etc.
+      Only the first ctdma_profile_len bytes are valid.
+
+tlvMapcCapabilityUpdate:
+  _type: class
+  _is_tlv_class : True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_MAPC_CAPABILITY_UPDATE
+  length: uint16_t
+  local_bssid: sMacAddr
+  peer_bss_count:
+    _type: uint8_t
+    _length_var: True
+  peer_bss_capabilities:
+    _type: sMapcBssCapability
+    _length: [ peer_bss_count ]
diff --git a/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcConfigurationPolicy.yaml b/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcConfigurationPolicy.yaml
new file mode 100644
index 000000000..670e9b543
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcConfigurationPolicy.yaml
@@ -0,0 +1,77 @@
+#
+---
+_include: {
+  tlvf/common/sMacAddr.h,
+  tlvf/wfa_map/eTlvTypeMap.h,
+}
+_namespace: wfa_map
+
+# MAPC Configuration Policy TLV
+# Carried in MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE from Controller to Agent.
+# Specifies per-BSS MAPC configuration: leader BSSID role, feature bitmap,
+# and the list of permitted remote BSSIDs per remote agent.
+#
+# Wire format (tlvValue):
+#   flags (1B) | local_bss_count (1B) |
+#   [ local_bssid(6B) | leader_bssid_configuration(1B) |
+#     mapc_feature_enable_bitmap(2B) | remote_agent_count(1B) |
+#     [ remote_agent_al_mac_address(6B) | permitted_remote_bss_count(1B) |
+#       [ permitted_remote_bssid(6B) ] * permitted_remote_bss_count
+#     ] * remote_agent_count
+#   ] * local_bss_count
+
+cMapcPermittedRemoteBss:
+  _type: class
+  permitted_remote_bssid:
+    _type: sMacAddr
+    _comment: "BSSID of the remote BSS or in case of MLD, Affiliated_AP_MAC Address authorized for MAPC discovery and negotiation"
+
+cMapcRemoteAgent:
+  _type: class
+  remote_agent_al_mac_address:
+    _type: sMacAddr
+    _comment: "AL MAC Address of the remote Multi-AP Agent"
+  permitted_remote_bss_count:
+    _type: uint8_t
+    _length_var: True
+    _comment: "Number of remote BSSIDs with which this localBSS is allowed to perform MAPC discovery and negotiation"
+  permitted_remote_bss_list:
+    _type: cMapcPermittedRemoteBss
+    _length: [ permitted_remote_bss_count ]
+
+cMapcLocalBss:
+  _type: class
+  local_bssid:
+    _type: sMacAddr
+    _comment: "BSSID of the BSS or in case of MLD, the Affiliated AP MAC Address for which the MAPC Configuration applies"
+  leader_bssid_configuration:
+    _type: uint8_t
+    _comment: "Bit 7: leaderBSSIDConfiguration (0=not leader, 1=leader), Bits 6-0: reserved. Valid only when leaderBSSIDConfigurationValid=1"
+  mapc_feature_enable_bitmap:
+    _type: uint16_t
+    _comment: "Bitmap of enabled MAPC features: B0=Co-BF, B1=Co-SR, B2=Co-TDMA, B3=Co-rTWT, B4=Co-CR, B5-B15=Reserved"
+  remote_agent_count:
+    _type: uint8_t
+    _length_var: True
+    _comment: "Number of remote Multi-AP Agents for which MAPC configuration information is provided"
+  remote_agent_list:
+    _type: cMapcRemoteAgent
+    _length: [ remote_agent_count ]
+
+tlvMapcConfigurationPolicy:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_MAPC_CONFIGURATION_POLICY
+  length: uint16_t
+  flags:
+    _type: uint8_t
+    _comment: "Bit 7: leaderBSSIDConfigurationValid (0=Invalid, 1=Valid), Bits 6-0: reserved"
+  local_bss_count:
+    _type: uint8_t
+    _length_var: True
+    _comment: "Number of local BSS entries included in this TLV"
+  local_bss_list:
+    _type: cMapcLocalBss
+    _length: [ local_bss_count ]
diff --git a/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcNegotiationStatus.yaml b/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcNegotiationStatus.yaml
