+// SEND side: Add CoTDMA Sharing AP MSDU Forwarding Config to outgoing message
+bool tlvf_qca_utils::add_qca_cotdma_sharing_ap_dl_scs_msdu_fwd_config_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    if (s_cotdma_qmid_entries.empty()) {
+        LOG(WARNING) << "No CoTDMA QMIDs set, skipping QCA CoTDMA Sharing AP MSDU Forwarding Config TLV";
+        return true;
+    }
+
+    auto tlv_cotdma_config = cmdu_tx.addClass<qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig>();
+    if (!tlv_cotdma_config) {
+        LOG(ERROR) << "Failed to add QCA CoTDMA Sharing AP MSDU Forwarding Config TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv_cotdma_config->vendor_oui() = (sVendorOUI(qca::qcaVendorOUI::OUI_QCA));
+
+    // Set TLV ID
+    tlv_cotdma_config->tlv_id() = static_cast<int>(qca::eQcaTlVId::QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG);
+
+    // alloc_qmid_entries() allocates the buffer space for the entries AND sets
+    // qmid_count() internally.
+    if (!tlv_cotdma_config->alloc_qmid_entries(s_cotdma_qmid_entries.size())) {
+        LOG(ERROR) << "Failed to allocate " << s_cotdma_qmid_entries.size() << " QMID entries";
+        return false;
+    }
+
+    for (size_t i = 0; i < s_cotdma_qmid_entries.size(); i++) {
+        const auto &entry = s_cotdma_qmid_entries[i];
+        auto result = tlv_cotdma_config->qmid_entries(i);
+        if (!std::get<0>(result)) {
+            LOG(ERROR) << "Failed to access QMID Entries[" << i << "]";
+            return false;
+        }
+        sQmidSharingConfigEntry &tlv_qmid_entry = std::get<1>(result);
+
+        // Set cotdma config fields from qmid entry
+        tlv_qmid_entry.config_mode = entry.config_mode;
+        tlv_qmid_entry.sharing_bssid = entry.sharing_bssid;
+        tlv_qmid_entry.bsta_mac = entry.bsta_mac;
+        tlv_qmid_entry.shared_bssid = entry.shared_bssid;
+        tlv_qmid_entry.qmid = entry.qmid;
+
+        LOG(INFO) << "Added to TLV CoTDMA QMID entry[" << i << "]"
+                  << " config_mode=" << static_cast<int>(entry.config_mode)
+                  << " sharing_bssid=" << entry.sharing_bssid
+                  << " bsta_mac=" << entry.bsta_mac
+                  << " shared_bssid=" << entry.shared_bssid
+                  << " qmid=" << static_cast<int>(entry.qmid);
+    }
+
+    return true;
+}
+
+// SEND side: Add CoTDMA Shared AP MSDU Forwarding Config to outgoing message
+bool tlvf_qca_utils::add_qca_cotdma_shared_ap_dl_scs_msdu_fwd_config_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    if (s_cotdma_qmid_entries.empty()) {
+        LOG(WARNING) << "No CoTDMA QMIDs set, skipping QCA CoTDMA Shared AP MSDU Forwarding Config TLV";
+        return true;
+    }
+
+    auto tlv_cotdma_config = cmdu_tx.addClass<qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig>();
+    if (!tlv_cotdma_config) {
+        LOG(ERROR) << "Failed to add QCA CoTDMA Shared AP MSDU Forwarding Config TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv_cotdma_config->vendor_oui() = (sVendorOUI(qca::qcaVendorOUI::OUI_QCA));
+
+    // Set TLV ID
+    tlv_cotdma_config->tlv_id() = static_cast<int>(qca::eQcaTlVId::QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG);
+
+    // alloc_qmid_entries() allocates the buffer space for the entries AND sets
+    // qmid_count() internally.
+    if (!tlv_cotdma_config->alloc_qmid_entries(s_cotdma_qmid_entries.size())) {
+        LOG(ERROR) << "Failed to allocate " << s_cotdma_qmid_entries.size() << " QMID entries";
+        return false;
+    }
+
+    for (size_t i = 0; i < s_cotdma_qmid_entries.size(); i++) {
+        const auto &entry = s_cotdma_qmid_entries[i];
+        auto result = tlv_cotdma_config->qmid_entries(i);
+        if (!std::get<0>(result)) {
+            LOG(ERROR) << "Failed to access QMID Entries[" << i << "]";
+            return false;
+        }
+        sQmidSharedConfigEntry &tlv_qmid_entry = std::get<1>(result);
+
+        // Set cotdma config fields from qmid entry
+        tlv_qmid_entry.config_mode = entry.config_mode;
+        tlv_qmid_entry.shared_bssid = entry.shared_bssid;
+        tlv_qmid_entry.peer_bssid = entry.sharing_bssid;
+        tlv_qmid_entry.qmid = entry.qmid;
+
+        LOG(INFO) << "Added to TLV CoTDMA QMID entry[" << i << "]"
+                  << " config_mode=" << static_cast<int>(entry.config_mode)
+                  << " shared_bssid=" << entry.shared_bssid
+                  << " peer_bssid=" << entry.sharing_bssid
+                  << " qmid=" << static_cast<int>(entry.qmid);
+    }
+
+    return true;
+}
