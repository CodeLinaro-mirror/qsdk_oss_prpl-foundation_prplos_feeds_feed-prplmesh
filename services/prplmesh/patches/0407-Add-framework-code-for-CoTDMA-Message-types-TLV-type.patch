index 000000000..de2490739
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvCoTDMASharingApConfiguration.yaml
@@ -0,0 +1,80 @@
+#
+---
+_include: {
+  tlvf/common/sMacAddr.h,
+  tlvf/wfa_map/eTlvTypeMap.h,
+}
+_namespace: wfa_map
+
+# Co-TDMA Q2Q Sharing Configuration TLV
+# Sent from Controller to Agent to configure the Sharing AP role in Co-TDMA operation.
+# Specifies the Sharing AP BSSID, config mode (Add/Remove), and a list of Shared BSS
+# entries each carrying TXOP timing and scheduling parameters.
+
+eCoTDMAConfigMode:
+  _type: enum
+  _comment: |
+    0: Add   - Add the Shared BSS to the Co-TDMA sharing configuration
+    1: Remove - Remove the Shared BSS from the Co-TDMA sharing configuration
+    Other: Reserved
+  ADD: 0x00
+  REMOVE: 0x01
+
+sSharedBssEntry:
+  _type: struct
+  shared_bssid: sMacAddr
+  primary_ac:
+    _type: uint8_t
+    _comment: |
+      Access Category for TXOP sharing: BE=0, BK=1, VI=2, VO=3.
+      TXOP is shared for traffic of the neighbor AP in this AC or higher.
+  max_shared_txop_duration:
+    _type: uint8_t
+    _comment: |
+      Maximum duration of the shared TXOP per Primary AC in units of 100us.
+      Ignored by Shared AP if config_mode == REMOVE.
+  min_shared_txop_duration:
+    _type: uint8_t
+    _comment: |
+      Minimum duration of the shared TXOP per Primary AC in units of 100us.
+      Ignored by Shared AP if config_mode == REMOVE.
+  service_start_time:
+    _type: uint16_t
+    _comment: |
+      Time to start sharing the TXOP with the neighbor AP, relative to the
+      TSF block of the Sharing AP, in units of 100us.
+  service_interval:
+    _type: uint16_t
+    _comment: |
+      Service interval in units of 100us.
+      0: The Sharing AP treats the neighbor AP as virtually always having traffic
+         and shares the TXOP with it unconditionally.
+      Otherwise: The Sharing AP polls this neighbor AP once every Service_Interval.
+  service_end_time:
+    _type: uint16_t
+    _comment: |
+      Service end time for sharing the TXOP with this neighbor AP, relative to
+      the TSF block of the Sharing AP service interval, in units of 100us.
+  priority:
+    _type: uint8_t
+    _comment: |
+      Priority value for this Shared BSS. Lower value means higher priority.
+
+tlvCoTDMASharingApConfiguration:
+  _type: class
+  _is_tlv_class : True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_COTDMA_SHARING_AP_CONFIGURATION
+  length: uint16_t
+  sharing_bssid: sMacAddr
+  config_mode:
+    _type: uint8_t
+    _comment: |
+      0: Add, 1: Remove, Other: Reserved. See eCoTDMAConfigMode.
+  shared_bss_count:
+    _type: uint8_t
+    _length_var: True
+  shared_bss_list:
+    _type: sSharedBssEntry
+    _length: [ shared_bss_count ]
diff --git a/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcCapabilityUpdate.yaml b/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcCapabilityUpdate.yaml
