--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvMapcNegotiationStatus.yaml
@@ -0,0 +1,36 @@
+#
+---
+_include: {
+  tlvf/common/sMacAddr.h,
+  tlvf/wfa_map/eTlvTypeMap.h,
+}
+_namespace: wfa_map
+
+# MAPC Negotiation Status TLV
+# Sent by the Agent to the Controller when the Agent receives a MAPC
+# Negotiation Response Status notification from hostapd.
+# Reports the outcome (or teardown) of a MAPC negotiation between two BSSes.
+#
+# Wire format (tlvValue):
+#   tlv_sub_type(2B) | flags(1B) |
+#   local_mapc_bssid(6B) | remote_mapc_bssid(6B)
+
+tlvMapcNegotiationStatus:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_MAPC_NEGOTIATION_STATUS
+  length: uint16_t
+  tlv_sub_type:
+    _type: uint16_t
+    _comment: "Subtype of the Wi-Fi 8 TLV"
+  flags:
+    _type: uint8_t
+    _comment: "Bit 7: negotiationType (0=Teardown, 1=Establishment), Bit 6: negotiationStatus (0=Fail, 1=Success), Bits 5-0: reserved"
+  local_mapc_bssid:
+    _type: sMacAddr
+    _comment: "BSSID of the MAPC Negotiation Request Initiator"
+  remote_mapc_bssid:
+    _type: sMacAddr
+    _comment: "BSSID of the MAPC Negotiation Request Responder"
