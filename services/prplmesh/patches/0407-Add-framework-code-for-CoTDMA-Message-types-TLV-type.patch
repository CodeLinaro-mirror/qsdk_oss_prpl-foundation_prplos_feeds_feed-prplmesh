+
     default:
         LOG(WARNING) << "Unknown QCA TLV ID: 0x" << std::hex << tlv_id;
         return nullptr;
@@ -648,3 +778,52 @@ tlvf_qca_utils::parse_qca_wifi8_capabilities_tlv(ieee1905_1::CmduMessageRx &cmdu
     }
     return tlv;
 }
+
+// RECEIVE side: QCA CoTDMA Sharing AP MSDU Forwarding Config
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_cotdma_sharing_ap_dl_scs_msdu_fwd_config_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA CoTDMA Sharing AP MSDU Forwarding Config TLV";
+        return nullptr;
+    }
+    LOG(INFO) << "Parsed CoTDMA Sharing AP MSDU Forwarding Config TLV: " << tlv->qmid_count() << " QMID(s)";
+    for (size_t i = 0; i < tlv->qmid_count(); i++) {
+        auto result = tlv->qmid_entries(i);
+        if (std::get<0>(result)) {
+            sQmidSharingConfigEntry &entry = std::get<1>(result);
+            bool add_qmid = (entry.config_mode & 0x80) != 0;
+            LOG(DEBUG) << " config_mode=" << (add_qmid ? "add" : "delete")
+                       << " sharing_bssid=" << tlvf::mac_to_string(entry.sharing_bssid)
+                       << " bsta_mac=" << tlvf::mac_to_string(entry.bsta_mac)
+                       << " shared_bssid=" << tlvf::mac_to_string(entry.shared_bssid)
+                       << " qmid=" << entry.qmid;
+        }
+    }
+    return tlv;
+}
+
+// RECEIVE side: QCA CoTDMA Shared AP MSDU Forwarding Config
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_cotdma_shared_ap_dl_scs_msdu_fwd_config_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA CoTDMA Shared AP MSDU Forwarding Config TLV";
+        return nullptr;
+    }
+    LOG(INFO) << "Parsed CoTDMA Shared AP MSDU Forwarding Config TLV: " << tlv->qmid_count() << " QMID(s)";
+    for (size_t i = 0; i < tlv->qmid_count(); i++) {
+        auto result = tlv->qmid_entries(i);
+        if (std::get<0>(result)) {
+            sQmidSharedConfigEntry &entry = std::get<1>(result);
+            bool add_qmid = (entry.config_mode & 0x80) != 0;
+            LOG(DEBUG) << " config_mode=" << (add_qmid ? "add" : "delete")
+                       << " shared_bssid=" << tlvf::mac_to_string(entry.shared_bssid)
+                       << " peer_bssid=" << tlvf::mac_to_string(entry.peer_bssid)
+                       << " qmid=" << entry.qmid;
+        }
+    }
+    return tlv;
+}
