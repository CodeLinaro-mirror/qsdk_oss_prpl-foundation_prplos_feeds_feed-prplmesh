 class MultiVendorQCA : public multi_vendor::tlvf_handler, public qca::tlvf_qca_utils {
 private:
     static bool smd_tlvs_registered;
+    static bool cotdma_tlvs_registered;
 
 public:
     /**
@@ -76,6 +77,7 @@ public:
                                                     parse_qca_vs_tlv);
 
         // Note: SMD TLVs are registered via register_smd_tlvs() based on enable_smd config
+        // Note: CoTDMA TLVs are registered via register_cotdma_tlvs() based on enable_cotdma config
     }
 
     /**
@@ -114,10 +116,53 @@ public:
             LOG(INFO) << "MultiVendorQCA: SMD TLVs not registered (enable_smd=0)";
         }
     }
+
+    /**
+     * @brief Register CoTDMA-related TLV handlers and parsers based on configuration.
+     *
+     * This method should be called from agent/controller initialization after reading
+     * the enable_cotdma configuration parameter. It performs role-based registration:
+     * - Controller: Registers to SEND Policy Config TLV and RECEIVE Capabilities TLV
+     * - Agent: Registers to SEND Capabilities TLV and RECEIVE Policy Config TLV
+     *
+     * @param enable_cotdma If true, registers CoTDMA TLV handlers; if false, skips registration
+     * @param is_controller If true, registers controller-side handlers; if false, registers agent-side handlers
+     */
+    static void register_cotdma_tlvs(bool enable_cotdma, bool is_controller)
+    {
+        if (enable_cotdma && !cotdma_tlvs_registered) {
+            LOG(INFO) << "MultiVendorQCA: registering CoTDMA TLV handlers (enable_cotdma=1, "
+                      << (is_controller ? "controller" : "agent") << ")";
+
+            if (is_controller) {
+                // Controller: SEND Policy Config TLV in COTDMA_CONFIGURATION_MESSAGE
+                multi_vendor::tlvf_handler::register_handler(
+                    eMessageType::COTDMA_CONFIGURATION_MESSAGE,
+                    add_qca_cotdma_sharing_ap_dl_scs_msdu_fwd_config_tlv);
+                multi_vendor::tlvf_handler::register_handler(
+                    eMessageType::COTDMA_CONFIGURATION_MESSAGE,
+                    add_qca_cotdma_shared_ap_dl_scs_msdu_fwd_config_tlv);
+            } else {
+                // Agent: RECEIVE Policy Config TLV from controller
+                multi_vendor::tlvf_handler::register_parser(
+                    eMessageType::COTDMA_CONFIGURATION_MESSAGE,
+                    parse_qca_cotdma_sharing_ap_dl_scs_msdu_fwd_config_tlv);
+                multi_vendor::tlvf_handler::register_parser(
+                    eMessageType::COTDMA_CONFIGURATION_MESSAGE,
+                    parse_qca_cotdma_shared_ap_dl_scs_msdu_fwd_config_tlv);
+            }
+
+            cotdma_tlvs_registered = true;
+        } else if (!enable_cotdma) {
+            LOG(INFO) << "MultiVendorQCA: CoTDMA TLVs not registered (enable_cotdma=0)";
+        }
+    }
 };
 
 bool MultiVendorQCA::smd_tlvs_registered = false;
 
+bool MultiVendorQCA::cotdma_tlvs_registered = false;
+
 // Static object of the QCA vendor object. This ensures the QCA vendor's handlers are
