From 09e42ce1ff7dc7a9fe58707fe39484ed77e92c15 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Fri, 23 Oct 2026 15:55:42 +0530
Subject: [PATCH] Enable AIRTIES_FEATURE_WPA3 for airties MRSNO

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp     | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
index cdba4cf71..3d85235bc 100644
--- a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
+++ b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
@@ -436,6 +436,7 @@ bool tlvf_airties_utils::add_airties_version_reporting_tlv(ieee1905_1::CmduMessa
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_SERVICE_STATUS_WIFI_ON_OFF:
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_HIDDEN_SSID:
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_RADIO_CAPABILITY:
+        case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_WPA3:
             // Create and add the feature to the TLV
             create_and_add_feature_to_list(tlv_version_reporting, feature_id_enum);
             break;
@@ -452,7 +453,6 @@ bool tlvf_airties_utils::add_airties_version_reporting_tlv(ieee1905_1::CmduMessa
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_LED:
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_AFC_SUPPORT:
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_TUNNELED_PROBE_REQUEST:
-        case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_WPA3:
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_WPA_ENTERPRISE:
         case airties::eAirtiesFeatureIDs::AIRTIES_FEATURE_CLIENT_ISOLATION:
             break;
-- 
