+bool uci_add_list_option(const std::string &package_name, const std::string &section_name,
+                         const std::string &option_name, const std::string &value,
+                         bool commit_changes)
+{
+    auto ctx = alloc_context();
+    if (!ctx) {
+        return false;
+    }
+
+    // path format: "package.section.option=value"
+    // NOTE: uci_lookup_ptr() modifies the path buffer in-place (inserts null terminators).
+    // Two separate buffers are required: one for the del operation and one for the add operation.
+    char del_path[256] = {0};
+    char add_path[256] = {0};
+    if (snprintf(del_path, sizeof(del_path), "%s.%s.%s=%s", package_name.c_str(),
+                 section_name.c_str(), option_name.c_str(), value.c_str()) <= 0) {
+        LOG(ERROR) << "uci_add_list_option: failed to compose del_path";
+        return false;
+    }
+    if (snprintf(add_path, sizeof(add_path), "%s.%s.%s=%s", package_name.c_str(),
+                 section_name.c_str(), option_name.c_str(), value.c_str()) <= 0) {
+        LOG(ERROR) << "uci_add_list_option: failed to compose add_path";
+        return false;
+    }
+
+    // Remove any existing occurrence first to prevent duplicates on re-apply.
+    uci_ptr del_ptr = {};
+    if (uci_lookup_ptr(ctx.get(), &del_ptr, del_path, true) == UCI_OK) {
+        uci_del_list(ctx.get(), &del_ptr);
+    }
+
+    // Add the value to the list.
+    uci_ptr add_ptr = {};
+    if (uci_lookup_ptr(ctx.get(), &add_ptr, add_path, true) != UCI_OK) {
+        LOG(ERROR) << "uci_add_list_option: uci_lookup_ptr failed for path="
+                   << package_name << "." << section_name << "." << option_name << "=" << value;
+        return false;
+    }
+    if (uci_add_list(ctx.get(), &add_ptr) != UCI_OK) {
+        LOG(ERROR) << "uci_add_list_option: uci_add_list failed for path="
+                   << package_name << "." << section_name << "." << option_name << "=" << value;
+        return false;
+    }
+
+    // Single uci_save covers both the del and the add.
+    if (uci_save(ctx.get(), add_ptr.p) != UCI_OK) {
+        LOG(ERROR) << "uci_add_list_option: uci_save failed for path="
+                   << package_name << "." << section_name << "." << option_name << "=" << value;
+        return false;
+    }
+
+    if (commit_changes) {
+        return uci_commit_changes(package_name);
+    }
+    return true;
+}
+
+bool uci_del_list_option(const std::string &package_name, const std::string &section_name,
+                         const std::string &option_name, const std::string &value,
+                         bool commit_changes)
+{
+    auto ctx = alloc_context();
+    if (!ctx) {
+        return false;
+    }
+
+    char path[256] = {0};
+    if (snprintf(path, sizeof(path), "%s.%s.%s=%s", package_name.c_str(), section_name.c_str(),
+                 option_name.c_str(), value.c_str()) <= 0) {
+        LOG(ERROR) << "uci_del_list_option: failed to compose path";
+        return false;
+    }
+
+    uci_ptr del_ptr = {};
+    if (uci_lookup_ptr(ctx.get(), &del_ptr, path, true) != UCI_OK) {
+        LOG(ERROR) << "uci_del_list_option: uci_lookup_ptr failed for path=" << path;
+        return false;
+    }
+    uci_del_list(ctx.get(), &del_ptr);
+
+    if (uci_save(ctx.get(), del_ptr.p) != UCI_OK) {
+        LOG(WARNING) << "uci_del_list_option: uci_save failed for path=" << path;
+    }
+
+    if (commit_changes) {
+        return uci_commit_changes(package_name);
+    }
+    return true;
+}
