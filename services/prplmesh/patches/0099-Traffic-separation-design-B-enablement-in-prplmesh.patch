+void TrafficSeparationManager::persist_bridge_assignments()
+{
+    if (m_config.private_bridge.empty()) {
+        LOG(WARNING) << "persist_bridge_assignments: private_bridge is empty, skipping";
+        return;
+    }
+
+    auto db          = beerocks::AgentDB::get();
+    bool wireless_written = false;
+    bool network_written  = false;
+
+    for (const auto *radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        for (const auto &bss : radio->front.bssids) {
+            if (!bss.active || bss.iface_name.empty()) {
+                continue;
+            }
+
+            // Skip BSS that are neither fronthaul nor backhaul
+            if (!bss.fronthaul_bss && !bss.backhaul_bss) {
+                continue;
+            }
+
+            // Backhaul BSS (including combined fh+bh) always belong to the private bridge.
+            // Fronthaul-only BSS go to guest or private based on vap_type.
+            // If vap_type is OTHER (repeater BSS created before TS policy arrived),
+            // fall back to ssid_vid_mapping to identify guest interfaces.
+            const bool is_guest = !bss.backhaul_bss && is_guest_bss(bss, db->traffic_separation);
+            const std::string &correct_bridge =
+                is_guest ? m_config.guest_bridge : m_config.private_bridge;
+
+            if (correct_bridge.empty()) {
+                LOG(DEBUG) << "persist_bridge_assignments: no bridge for iface=" << bss.iface_name
+                           << ", skipping";
+                continue;
+            }
+
+            // Strip _link suffix for MLO
+            const std::string iface_name = strip_link_suffix(bss.iface_name);
+
+            // Clean up any legacy bridge ports assignment for this iface.
+            std::string current_bridge_in_config;
+            if (bpl::cfg_get_bridge_for_iface(iface_name, current_bridge_in_config) &&
+                !current_bridge_in_config.empty()) {
+                bpl::cfg_remove_iface_from_bridge_config(current_bridge_in_config, iface_name);
+                network_written = true;
+            }
+
+            // Update wireless config: set option network in the wifi-iface section.
+            std::string network_name;
+            if (!bpl::cfg_get_network_name_for_bridge(correct_bridge, network_name)) {
+                LOG(WARNING) << "persist_bridge_assignments: cannot find network name for bridge="
+                             << correct_bridge << ", iface=" << iface_name;
+                continue;
+            }
+
+            if (bpl::cfg_set_wifi_iface_network(iface_name, network_name, bss.ssid)) {
+                wireless_written = true;
+            }
+        }
+    }
+
+    // Persist VLAN subinterface bridge assignments for tagged trunk ports.
+    // For each tagged trunk port, the VLAN subinterface(s) must also be listed
+    // in the correct bridge's ports in /etc/config/network so they survive reboot.
+    //   - Ethernet trunks: <iface>.<guest_vid> -> guest_bridge
+    //   - WiFi trunks:     <iface>.<guest_vid> -> guest_bridge
+    //                      <iface>.<private_vid> -> private_bridge
+    // Untagged trunk ports are skipped (no VLAN subinterfaces are created for them).
+    for (const auto &entry : m_trunk_ports) {
+        const sTrunkPort &tp = entry.second;
+        if (tp.is_untagged_mode) {
+            continue;
+        }
+
+        // Guest VLAN subinterface -> guest_bridge
+        if (!m_config.guest_bridge.empty() && m_config.guest_vid != 0) {
+            const std::string guest_vlan_iface =
+                tp.iface_name + "." + std::to_string(m_config.guest_vid);
+            if (bpl::cfg_persist_iface_bridge_assignment(m_config.guest_bridge, guest_vlan_iface)) {
+                network_written = true;
+            }
+        }
+
+        // Private VLAN subinterface -> private_bridge (WiFi trunks only;
+        // for Ethernet trunks the private traffic is untagged on the native VLAN).
+        if (!tp.is_ethernet && !m_config.private_bridge.empty() && m_config.private_vid != 0) {
+            const std::string private_vlan_iface =
+                tp.iface_name + "." + std::to_string(m_config.private_vid);
+            if (bpl::cfg_persist_iface_bridge_assignment(m_config.private_bridge,
+                                                         private_vlan_iface)) {
+                network_written = true;
+            }
+        }
+    }
+
+    if (wireless_written) {
+        if (!bpl::cfg_commit_wireless_config()) {
+            LOG(WARNING) << "persist_bridge_assignments: wireless commit FAILED";
+        } else {
+            LOG(DEBUG) << "persist_bridge_assignments: wireless commit SUCCESS";
+        }
+    }
+
+    if (network_written) {
+        if (!bpl::cfg_commit_network_config()) {
+            LOG(WARNING) << "persist_bridge_assignments: network commit FAILED";
+        } else {
+            LOG(DEBUG) << "persist_bridge_assignments: network commit SUCCESS";
+        }
+    }
+}
+
+void TrafficSeparationManager::reset_persistence()
+{
+    if (m_config.private_bridge.empty()) {
+        LOG(WARNING) << "reset_persistence: private_bridge is empty, skipping";
+        return;
+    }
+
+    std::string private_network_name;
+    if (!bpl::cfg_get_network_name_for_bridge(m_config.private_bridge, private_network_name)) {
+        LOG(WARNING) << "reset_persistence: cannot find network name for private_bridge="
+                     << m_config.private_bridge;
+        return;
+    }
+
+    auto db               = beerocks::AgentDB::get();
+    bool wireless_written = false;
+    bool network_written  = false;
+
+    // Reset wifi-iface 'option network' back to the private bridge for all BSS interfaces.
+    for (const auto *radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        for (const auto &bss : radio->front.bssids) {
+            if (!bss.active || bss.iface_name.empty()) {
+                continue;
+            }
+
+            if (!bss.fronthaul_bss && !bss.backhaul_bss) {
+                continue;
+            }
+
+            const std::string iface_name = strip_link_suffix(bss.iface_name);
+
+            if (bpl::cfg_set_wifi_iface_network(iface_name, private_network_name, bss.ssid)) {
+                LOG(DEBUG) << "reset_persistence: reset iface=" << iface_name
+                           << " to network=" << private_network_name;
+                wireless_written = true;
+            }
+        }
+    }
+
+    // Remove VLAN subinterface entries from /etc/config/network that were added by
+    // persist_bridge_assignments() for tagged trunk ports.
+    //   - All tagged trunk ports: remove <iface>.<guest_vid> from guest_bridge
+    //   - WiFi trunks only:       remove <iface>.<private_vid> from private_bridge
+    for (const auto &entry : m_trunk_ports) {
+        const sTrunkPort &tp = entry.second;
+        if (tp.is_untagged_mode) {
+            continue;
+        }
+
+        // Remove guest VLAN subinterface from guest_bridge
+        if (!m_config.guest_bridge.empty() && m_config.guest_vid != 0) {
+            const std::string guest_vlan_iface =
+                tp.iface_name + "." + std::to_string(m_config.guest_vid);
+            if (bpl::cfg_remove_iface_from_bridge_config(m_config.guest_bridge,
+                                                         guest_vlan_iface)) {
+                LOG(DEBUG) << "reset_persistence: removed " << guest_vlan_iface
+                           << " from bridge=" << m_config.guest_bridge;
+                network_written = true;
+            }
+        }
+
+        // Remove private VLAN subinterface from private_bridge (WiFi trunks only)
+        if (!tp.is_ethernet && !m_config.private_bridge.empty() && m_config.private_vid != 0) {
+            const std::string private_vlan_iface =
+                tp.iface_name + "." + std::to_string(m_config.private_vid);
+            if (bpl::cfg_remove_iface_from_bridge_config(m_config.private_bridge,
+                                                         private_vlan_iface)) {
+                LOG(DEBUG) << "reset_persistence: removed " << private_vlan_iface
+                           << " from bridge=" << m_config.private_bridge;
+                network_written = true;
+            }
+        }
+    }
+
+    if (wireless_written) {
+        if (!bpl::cfg_commit_wireless_config()) {
+            LOG(WARNING) << "reset_persistence: wireless commit FAILED";
+        } else {
+            LOG(DEBUG) << "reset_persistence: wireless commit SUCCESS";
+        }
+    }
+
+    if (network_written) {
+        if (!bpl::cfg_commit_network_config()) {
+            LOG(WARNING) << "reset_persistence: network commit FAILED";
+        } else {
+            LOG(DEBUG) << "reset_persistence: network commit SUCCESS";
+        }
+    }
+}
+
+void TrafficSeparationManager::verify_and_fix_bridge_assignments()
+{
+    if (m_config.private_bridge.empty()) {
+        LOG(WARNING) << "verify_and_fix_bridge_assignments: private_bridge is empty, skipping";
+        return;
+    }
+
+    auto db = beerocks::AgentDB::get();
+
+    for (const auto *radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        for (const auto &bss : radio->front.bssids) {
+            if (!bss.active || bss.iface_name.empty()) {
+                continue;
+            }
+
+            // Only process fronthaul-only BSS (access ports)
+            if (!bss.fronthaul_bss || bss.backhaul_bss) {
+                continue;
+            }
+
+            // GUEST vap_type goes to guest bridge; all others go to private bridge.
+            // If vap_type is OTHER (e.g. repeater BSS created before TS policy arrived),
+            // fall back to the SSID-to-VID mapping from the TS policy to identify guest SSIDs.
+            const bool is_guest = is_guest_bss(bss, db->traffic_separation);
+            const std::string &expected_bridge =
+                is_guest ? m_config.guest_bridge : m_config.private_bridge;
+
+            if (expected_bridge.empty()) {
+                LOG(DEBUG) << "verify_and_fix: no expected bridge for iface=" << bss.iface_name
+                           << ", skipping";
+                continue;
+            }
+
+            // Strip _link suffix for MLO (prplMesh uses wlan0_link0 internally, system uses wlan0)
+            const std::string iface_name = strip_link_suffix(bss.iface_name);
+
+            // Get current bridge
+            const std::string current_bridge =
+                network_utils::linux_iface_get_host_bridge(iface_name);
+
+            if (current_bridge == expected_bridge) {
+                LOG(TRACE) << "verify_and_fix: iface=" << iface_name
+                           << " already in correct bridge=" << expected_bridge;
+                continue;
+            }
+
+            LOG(INFO) << "verify_and_fix: iface=" << iface_name << " current_bridge='"
+                      << current_bridge << "' expected_bridge='" << expected_bridge << "' - fixing";
+
+            // Remove from wrong bridge if currently in one
+            if (!current_bridge.empty()) {
+                if (!network_utils::linux_remove_iface_from_bridge(current_bridge, iface_name)) {
+                    LOG(ERROR) << "verify_and_fix: failed to remove iface=" << iface_name
+                               << " from bridge=" << current_bridge;
+                }
+            }
+
+            // Add to expected bridge
+            if (!network_utils::linux_add_iface_to_bridge(expected_bridge, iface_name)) {
+                LOG(ERROR) << "verify_and_fix: failed to add iface=" << iface_name
+                           << " to bridge=" << expected_bridge;
+            }
+        }
+    }
+}
+
 } // namespace beerocks::net
