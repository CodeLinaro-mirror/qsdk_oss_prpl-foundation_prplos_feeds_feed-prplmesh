+/**
+ * @brief Strip the MLO link suffix from an interface name.
+ *
+ * prplMesh uses link-specific interface names internally (e.g. "wlan0_link0"),
+ * while the system uses the base interface name (e.g. "wlan0"). This function
+ * strips the "_link" suffix and everything after it.
+ *
+ * @param iface_name Interface name, possibly with a "_link" suffix.
+ * @return Base interface name with the "_link" suffix removed, or the original
+ *         name if no such suffix is present.
+ */
+inline std::string strip_link_suffix(const std::string &iface_name)
+{
+    const auto pos = iface_name.rfind("_link");
+    return (pos != std::string::npos) ? iface_name.substr(0, pos) : iface_name;
+}
+
 } // namespace net
+
+/**
+ * @brief Determine whether a BSS is a guest BSS.
+ *
+ * Returns true if bss.vap_type is GUEST, or if vap_type is OTHER and the
+ * BSS SSID maps to a secondary (guest) VID in the traffic-separation policy.
+ *
+ * @param bss    BSS descriptor from AgentDB.
+ * @param ts_db  Traffic-separation sub-database from AgentDB.
+ * @return true if the BSS is a guest BSS, false otherwise.
+ */
+inline bool is_guest_bss(const AgentDB::sRadio::sFront::sBssid &bss,
+                         const AgentDB::sTrafficSeparation &ts_db)
+{
+    if (bss.vap_type == eVapType::GUEST) {
+        return true;
+    }
+    if (bss.vap_type == eVapType::OTHER && !bss.ssid.empty()) {
+        const auto it = ts_db.ssid_vid_mapping.find(bss.ssid);
+        if (it != ts_db.ssid_vid_mapping.end() && ts_db.secondary_vlans_ids.count(it->second)) {
+            return true;
+        }
+    }
+    return false;
+}
+
