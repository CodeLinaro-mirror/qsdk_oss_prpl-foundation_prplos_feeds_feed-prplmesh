+
+        if (section_ssid == ssid) {
+            // Found matching SSID, get full configuration
+            if (!bpl_cfg_get_bss_configuration(section_name, configuration)) {
+                LOG(ERROR) << "Failed to get wireless configuration for SSID " << ssid
