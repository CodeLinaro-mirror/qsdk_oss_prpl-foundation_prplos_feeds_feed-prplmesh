+bool cfg_get_bridge_for_iface(const std::string &iface, std::string &bridge_name)
+{
+    uci_context *ctx = uci_alloc_context();
+    if (!ctx) {
+        LOG(ERROR) << "cfg_get_bridge_for_iface: failed to alloc UCI context";
+        return false;
+    }
+
+    uci_package *pkg = nullptr;
+    if (uci_load(ctx, "network", &pkg) != UCI_OK || !pkg) {
+        LOG(ERROR) << "cfg_get_bridge_for_iface: failed to load network package";
+        uci_free_context(ctx);
+        return false;
+    }
+
+    bool found       = false;
+    uci_element *elm = nullptr;
+    uci_foreach_element(&pkg->sections, elm)
+    {
+        uci_section *sec = uci_to_section(elm);
+        if (strcmp(sec->type, "device") != 0) {
+            continue;
+        }
+
+        // Look for the interface in the "ports" list of this section
+        uci_element *opt_elm = nullptr;
+        uci_foreach_element(&sec->options, opt_elm)
+        {
+            uci_option *opt = uci_to_option(opt_elm);
+            if (strcmp(opt->e.name, "ports") != 0 || opt->type != UCI_TYPE_LIST) {
+                continue;
+            }
+            uci_element *list_elm = nullptr;
+            uci_foreach_element(&opt->v.list, list_elm)
+            {
+                if (iface == list_elm->name) {
+                    // Found the interface; get the bridge name from the "name" option
+                    uci_element *name_elm = nullptr;
+                    uci_foreach_element(&sec->options, name_elm)
+                    {
+                        uci_option *name_opt = uci_to_option(name_elm);
+                        if (strcmp(name_opt->e.name, "name") == 0 &&
+                            name_opt->type == UCI_TYPE_STRING) {
+                            bridge_name = name_opt->v.string;
+                            found       = true;
+                            break;
+                        }
+                    }
+                    break;
+                }
+            }
+            if (found) {
+                break;
+            }
+        }
+        if (found) {
+            break;
+        }
+    }
+
+    uci_free_context(ctx);
+    if (found) {
+        LOG(DEBUG) << "cfg_get_bridge_for_iface: iface=" << iface << " -> bridge=" << bridge_name;
+    } else {
+        LOG(DEBUG) << "cfg_get_bridge_for_iface: iface=" << iface << " not found in any bridge";
+    }
+    return found;
+}
