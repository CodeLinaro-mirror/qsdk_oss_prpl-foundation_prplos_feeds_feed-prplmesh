+bool cfg_persist_iface_bridge_assignment(const std::string &bridge, const std::string &iface)
+{
+    // Find the UCI network device section whose 'name' option matches the bridge.
+    std::string section_name;
+    bool find_ok = uci_find_section_by_option("network", "device", "name", bridge, section_name);
+
+    if (!find_ok || section_name.empty()) {
+        LOG(WARNING) << "cfg_persist_iface_bridge_assignment: no UCI section found for bridge="
+                     << bridge << ", skipping iface=" << iface;
+        return false;
+    }
+
+    // uci_add_list_option removes any existing occurrence first (dedup), then adds,
+    // and issues a single uci_save covering both operations.
+    bool add_ok = uci_add_list_option("network", section_name, "ports", iface, false);
+    if (!add_ok) {
+        LOG(ERROR) << "cfg_persist_iface_bridge_assignment: failed to add iface=" << iface
+                   << " to bridge=" << bridge;
+        return false;
+    }
+
+    LOG(DEBUG) << "cfg_persist_iface_bridge_assignment: added iface=" << iface
+               << " to bridge=" << bridge;
+    return true;
+}
+
+bool cfg_remove_iface_from_bridge_config(const std::string &bridge, const std::string &iface)
+{
+    // Find the UCI network device section whose 'name' option matches the bridge.
+    std::string section_name;
