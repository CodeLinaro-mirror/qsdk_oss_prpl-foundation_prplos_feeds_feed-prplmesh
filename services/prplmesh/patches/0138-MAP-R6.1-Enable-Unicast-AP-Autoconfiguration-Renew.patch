From 0c75f06db2ceb5abef9142569a2ed589ffb7dcb4 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Thu, 23 Apr 2026 10:40:04 +0530
Subject: [PATCH] MAP R6.1: Enable Unicast AP Autoconfiguration Renew

1. Introduce a config flag
2. Enable changes for sending Unicast AP Autoconfiguration Renew

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../beerocks/master/beerocks_master_main.cpp  |  6 +++++
 controller/src/beerocks/master/db/db.h        |  1 +
 .../src/beerocks/master/son_actions.cpp       | 24 +++++++++++++++++--
 framework/platform/bpl/cfg/dm/bpl_cfg.cpp     |  6 +++++
 framework/platform/bpl/cfg/linux/bpl_cfg.cpp  |  6 +++++
 framework/platform/bpl/cfg/rdk/bpl_cfg.cpp    |  6 +++++
 framework/platform/bpl/cfg/uci/bpl_cfg.cpp    | 13 ++++++++++
 framework/platform/bpl/include/bpl/bpl_cfg.h  | 14 +++++++++++
 8 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/controller/src/beerocks/master/beerocks_master_main.cpp b/controller/src/beerocks/master/beerocks_master_main.cpp
index 9fc1f2f..681a4d2 100644
--- a/controller/src/beerocks/master/beerocks_master_main.cpp
+++ b/controller/src/beerocks/master/beerocks_master_main.cpp
@@ -560,6 +560,12 @@ static void fill_master_config(son::db::sDbMasterConfig &master_conf,
                    << beerocks::bpl::DEFAULT_DAISY_CHAINING_DISABLED;
         master_conf.daisy_chaining_disabled = beerocks::bpl::DEFAULT_DAISY_CHAINING_DISABLED;
     }
+
+    if (!beerocks::bpl::cfg_get_enable_unicast_renew(master_conf.enable_unicast_renew)) {
+        LOG(DEBUG) << "Failed to read EnableUnicastRenew, setting to default value: "
+                   << beerocks::bpl::DEFAULT_ENABLE_UNICAST_RENEW;
+        master_conf.enable_unicast_renew = beerocks::bpl::DEFAULT_ENABLE_UNICAST_RENEW;
+    }
 }
 
 #ifdef ENABLE_NBAPI
diff --git a/controller/src/beerocks/master/db/db.h b/controller/src/beerocks/master/db/db.h
index 11829a2..69ddbba 100644
--- a/controller/src/beerocks/master/db/db.h
+++ b/controller/src/beerocks/master/db/db.h
@@ -196,6 +196,7 @@ public:
         unsigned int steering_policy;
         unsigned int channel_utilization_threshold;
         unsigned int rcpi_steering_threshold;
+        bool enable_unicast_renew;
     } sDbMasterConfig;
 
     typedef struct {
diff --git a/controller/src/beerocks/master/son_actions.cpp b/controller/src/beerocks/master/son_actions.cpp
index 7398845..bb50e50 100644
--- a/controller/src/beerocks/master/son_actions.cpp
+++ b/controller/src/beerocks/master/son_actions.cpp
@@ -490,8 +490,28 @@ bool son_actions::send_ap_config_renew_msg(ieee1905_1::CmduMessageTx &cmdu_tx, d
     tlvSupportedFreqBand->value() = ieee1905_1::tlvSupportedFreqBand::eValue(0);
 
     LOG(INFO) << "Send AP_AUTOCONFIGURATION_RENEW_MESSAGE";
-    return son_actions::send_cmdu_to_agent(network_utils::MULTICAST_1905_MAC_ADDR, cmdu_tx,
-                                           database);
+    bool ret = son_actions::send_cmdu_to_agent(network_utils::MULTICAST_1905_MAC_ADDR, cmdu_tx,
+                                            database);
+
+    // Multicast renew is not reliable, so also send unicast renew to all agent ALIDs
+    // that were stored in alid db when M2 was sent.
+    // For unicast, use the same frame but reset the relay bit in flags.
+    if (database.config.enable_unicast_renew) {
+        cmdu_header->flags().relay_indicator = 0;
+        for (const auto &agent : database.m_agents) {
+            const auto &agent_alid = agent.first;
+            // Skip local bridge (controller itself)
+            if (agent_alid == database.get_local_bridge_mac()) {
+                continue;
+            }
+            LOG(INFO) << "Send unicast AP_AUTOCONFIGURATION_RENEW_MESSAGE to agent " << agent_alid;
+            if (!son_actions::send_cmdu_to_agent(agent_alid, cmdu_tx, database)) {
+                LOG(ERROR) << "Failed to send unicast AP_AUTOCONFIGURATION_RENEW_MESSAGE to agent " << agent_alid;
+            }
+        }
+    }
+
+    return ret;
 }
 
 bool son_actions::send_topology_query_msg(const sMacAddr &dest_mac,
