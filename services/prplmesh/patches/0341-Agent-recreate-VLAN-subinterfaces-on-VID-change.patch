+        bool success = true;
+        for (const auto &trunk : trunks) {
+            if (!m_mgr->add_trunk_port(trunk)) {
+                LOG(ERROR) << "add_trunk_port failed during skip-rebuild recovery iface="
+                           << trunk.iface_name;
+                success = false;
