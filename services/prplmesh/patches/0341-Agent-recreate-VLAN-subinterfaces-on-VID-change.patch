     // traffic loss on the live trunk.
     if (m_mgr->is_applied() && matches_last_applied(cfg, trunks)) {
         LOG(DEBUG) << "TS config/ports unchanged since last apply, skipping rebuild";
+
+        // Config/ports didn't change, but a reconnect on an existing trunk (e.g. the same
+        // bSTA iface re-associating, or its parent netdev being torn down and recreated -
+        // see TrunkPortPlumbing8021q::apply()'s "already applied" handling) may have
+        // destroyed its VLAN subinterfaces without changing anything matches_last_applied()
