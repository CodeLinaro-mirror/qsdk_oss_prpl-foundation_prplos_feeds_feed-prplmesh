+    // Helper method to send AP metrics policy configuration to OneWifi
+    // Called from AP manager after VAP credentials are configured
+    bool set_ap_metrics_reporting_interval(int interval_sec, bool report_ind_ch_scan);
+
+    // Helper method to process individual STA events
+    bool process_sta_event(em_sta_info_t *sta, const mac_address_t &current_radio_mac, bool is_connected, bool send_events = true);
+    
+    // Helper method to load connected clients data with optional event generation
+    bool load_connected_clients_data(bool send_events = false);
+
+    // Member variable to store channel scan reporting policy
+    bool m_report_ind_ch_scan = false;
+
+protected:
+    // Override decode handlers from base class
+    virtual void on_onewifi_init_data(const char *json_str) override;
+    virtual void on_onewifi_north_data(const char *json_str, unsigned int len) override;
+    virtual void on_sta_assoc_data(const char *json_str, unsigned int len, bool send_events = true) override;
+    virtual void on_sta_assoc_status_data(const char *data, unsigned int len) override;
+    virtual void on_ap_metrics_data(const char *json_str, unsigned int len) override;
+    virtual void on_channel_scan_data(const char *json_str, unsigned int len) override;
+    virtual void on_beacon_report_data(const char *json_str, unsigned int len) override;
+    virtual void on_sta_link_metrics_data(const char *json_str, unsigned int len) override;
