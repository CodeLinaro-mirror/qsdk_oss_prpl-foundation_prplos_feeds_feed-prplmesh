From 38ed658fece4b294b3f41a737fc7829aa3c08215 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Wed, 26 Aug 2026 08:27:35 +0530
Subject: [PATCH] MBO configuruaration enabled for cert

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../src/beerocks/slave/agent_ucc_listener.cpp |  5 ----
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 26 ++++++++++++++++---
 2 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/agent/src/beerocks/slave/agent_ucc_listener.cpp b/agent/src/beerocks/slave/agent_ucc_listener.cpp
index 021ccea08..46ca044cb 100644
--- a/agent/src/beerocks/slave/agent_ucc_listener.cpp
+++ b/agent/src/beerocks/slave/agent_ucc_listener.cpp
@@ -223,11 +223,6 @@ bool agent_ucc_listener::handle_dev_set_rfeature(
             return false;
         }
         ruid = radio->front.iface_mac;
-        if (ruid == bssid) {
-            err_string = "The provided BSSID is RUID";
-            LOG(ERROR) << err_string;
-            return false;
-        }
     } else {
         err_string = "Command must include RUID or BSSID";
         LOG(ERROR) << err_string;
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 3ff13cd23..a65c13126 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -6089,14 +6089,34 @@ bool ap_wlan_hal_nl80211::set_tx_power_limit(int tx_pow_limit)
 
 bool ap_wlan_hal_nl80211::set_mbo_assoc_disallow(const std::string &bssid, bool enable)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
+    LOG(DEBUG) << "set_mbo_assoc_disallow " << enable << " for bssid " << bssid;
+
+    auto vap_id = get_vap_id_with_mac(bssid);
+    if (vap_id < 0) {
+        LOG(ERROR) << "no vap has bssid " << bssid;
+        return false;
+    }
+    std::string ifname = m_radio_info.available_vaps[vap_id].bss;
+
+    const std::string cmd = "SET mbo_assoc_disallow " + std::to_string(enable ? 4 : 0);
+
+    if (!wpa_ctrl_send_msg(cmd, ifname)) {
+        LOG(ERROR) << "set_mbo_assoc_disallow() failed!";
+        return false;
+    }
     return true;
 }
 
 bool ap_wlan_hal_nl80211::set_radio_mbo_assoc_disallow(bool enable)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return true;
+    bool ret = true;
+    for (const auto &vap : m_radio_info.available_vaps) {
+        if (!set_mbo_assoc_disallow(vap.second.mac, enable)) {
+            LOG(ERROR) << "set_radio_mbo_assoc_disallow failed for vap " << vap.second.mac;
+            ret = false;
+        }
+    }
+    return ret;
 }
 
 bool ap_wlan_hal_nl80211::set_primary_vlan_id(uint16_t primary_vlan_id)
-- 
