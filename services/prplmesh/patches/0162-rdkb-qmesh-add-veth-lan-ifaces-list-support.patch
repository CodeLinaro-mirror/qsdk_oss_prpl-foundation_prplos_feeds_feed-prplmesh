 bool bpl_cfg_get_mandatory_interfaces(std::string &mandatory_interfaces)
 {
     mandatory_interfaces.clear();
+
+    if (!config_file_path) {
+        return true;
+    }
+
+    std::ifstream config_file(config_file_path);
+    if (!config_file.is_open()) {
+        return true;
+    }
+
+    std::string config_content((std::istreambuf_iterator<char>(config_file)),
+                               std::istreambuf_iterator<char>());
+    config_file.clear();  // clear eofbit before close so fail() only detects close errors
+    config_file.close();
+    if (config_file.fail()) {
+        LOG(ERROR) << "unable to close config file: " << config_file_path;
+        return true;
+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        return true;
+    }
+
+    // Collect mandatory_iface values from each radio section as-is.
+    // If mandatory_iface is absent or empty, fall back to hostap_iface.
+    std::string result;
+    for (int radio_idx = 0; radio_idx < BPL_MAX_RADIOS_SUPPORTED; radio_idx++) {
+        char radio_key[BPL_RADIO_KEY_BUF_LEN];
+        snprintf(radio_key, sizeof(radio_key), "radio%d", radio_idx);
+
+        cJSON *radio_obj = cJSON_GetObjectItem(root, radio_key);
+        if (!radio_obj) continue;
+
+        std::string iface_str;
+
+        // Use mandatory_iface if present and non-empty
+        cJSON *mandatory_iface_obj = cJSON_GetObjectItem(radio_obj, "mandatory_iface");
+        if (mandatory_iface_obj && cJSON_IsString(mandatory_iface_obj)) {
+            const char *mandatory_iface = cJSON_GetStringValue(mandatory_iface_obj);
+            if (mandatory_iface && strlen(mandatory_iface) > 0) {
+                iface_str = mandatory_iface;
+            }
+        }
+
+        // Fallback: use hostap_iface as-is
+        if (iface_str.empty()) {
+            cJSON *hostap_iface_obj = cJSON_GetObjectItem(radio_obj, "hostap_iface");
+            if (!hostap_iface_obj || !cJSON_IsString(hostap_iface_obj)) continue;
+            const char *hostap_iface = cJSON_GetStringValue(hostap_iface_obj);
+            if (!hostap_iface || strlen(hostap_iface) == 0) continue;
+            iface_str = hostap_iface;
+        }
+
+        if (!result.empty()) result += ',';
+        result += iface_str;
+    }
+
+    cJSON_Delete(root);
+    mandatory_interfaces = result;
+    LOG(INFO) << "bpl_cfg_get_mandatory_interfaces: returning mandatory_interfaces='"
+              << mandatory_interfaces << "'";
+    return true;
+}
+
+bool cfg_get_veth_ifaces(std::vector<std::string> &veth_ifaces)
+{
+    veth_ifaces.clear();
+
+    if (!config_file_path) {
+        LOG(ERROR) << "config_file_path is null";
+        return false;
+    }
+
+    std::ifstream config_file(config_file_path);
+    if (!config_file.is_open()) {
+        LOG(DEBUG) << "cfg_get_veth_ifaces: config file not found: " << config_file_path;
+        return true; // Not an error - veth_ifaces is optional
+    }
+
+    std::string config_content((std::istreambuf_iterator<char>(config_file)),
+                               std::istreambuf_iterator<char>());
+    config_file.clear();  // clear eofbit before close so fail() only detects close errors
+    config_file.close();
+    if (config_file.fail()) {
+        LOG(ERROR) << "unable to close config file: " << config_file_path;
+        return false;
+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        const char *error_ptr = cJSON_GetErrorPtr();
+        LOG(ERROR) << "cfg_get_veth_ifaces: Failed to parse JSON: "
+                   << (error_ptr ? error_ptr : "unknown");
+        return false;
+    }
+
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (!config_obj) {
+        // No "config" section - veth_ifaces is optional, return empty list
+        cJSON_Delete(root);
+        return true;
+    }
+
+    cJSON *veth_array = cJSON_GetObjectItem(config_obj, "veth_ifaces");
+    if (!veth_array) {
+        // veth_ifaces not configured - return empty list
+        cJSON_Delete(root);
+        return true;
+    }
+
+    if (!cJSON_IsArray(veth_array)) {
+        LOG(ERROR) << "cfg_get_veth_ifaces: 'veth_ifaces' is not a JSON array";
+        cJSON_Delete(root);
+        return false;
+    }
+
+    int array_size = cJSON_GetArraySize(veth_array);
+    for (int i = 0; i < array_size; i++) {
+        cJSON *item = cJSON_GetArrayItem(veth_array, i);
+        if (item && cJSON_IsString(item)) {
+            const char *iface_name = cJSON_GetStringValue(item);
+            if (iface_name && strlen(iface_name) > 0) {
+                veth_ifaces.push_back(std::string(iface_name));
+                LOG(DEBUG) << "cfg_get_veth_ifaces: found veth interface: " << iface_name;
+            }
+        }
+    }
+
+    cJSON_Delete(root);
     return true;
 }
 
