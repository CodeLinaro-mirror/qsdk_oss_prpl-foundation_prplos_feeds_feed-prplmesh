@@ -718,6 +719,35 @@ bool slave_thread::read_platform_configuration()
             LOG(DEBUG) << "LAN interface added: " << lan_iface << " - " << iface_mac;
         }
     }
+#ifdef BEEROCKS_RDKB
+    // Add veth interfaces from config file (config.veth_ifaces) to the LAN list.
+    // These are virtual Ethernet interfaces used in local controller+agent setups
+    // (e.g. veth0 bridged to brlan0, veth1 assigned to the controller).
+    std::vector<std::string> veth_ifaces;
+    if (bpl::cfg_get_veth_ifaces(veth_ifaces)) {
+        for (const auto &veth_iface : veth_ifaces) {
+            std::string iface_mac;
+            if (beerocks::net::network_utils::linux_iface_get_mac(veth_iface, iface_mac)) {
+                auto mac = tlvf::mac_from_string(iface_mac);
+                auto it = std::find_if(db->ethernet.lan.begin(), db->ethernet.lan.end(),
+                                       [&](const auto &port) {
+                                           return port.iface_name == veth_iface && port.mac == mac;
+                                       });
+                if (it == db->ethernet.lan.end()) {
+                    db->ethernet.lan.emplace_back(veth_iface, mac);
+                    LOG(DEBUG) << "veth LAN interface added from config: " << veth_iface
+                               << " - " << iface_mac;
+                } else {
+                    LOG(DEBUG) << "veth LAN interface already exists in db: " << veth_iface;
+                }
+            } else {
+                LOG(WARNING) << "veth interface from config not found: " << veth_iface;
+            }
+        }
+    } else {
+        LOG(WARNING) << "Failed to read veth interfaces from config!";
+    }
+#endif
 
     LOG(DEBUG) << "local_gw: " << db->device_conf.local_gw;
     LOG(DEBUG) << "local_controller: " << db->device_conf.local_controller;
