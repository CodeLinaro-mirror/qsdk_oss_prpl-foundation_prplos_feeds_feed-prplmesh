+void coordinated_tdma_task::start_negotiation_pending_timer(
+    Agent::sRadio::sBss::sMapcSharedBss &entry, uint8_t config_mode)
+{
+    using sMapcSharedBss = Agent::sRadio::sBss::sMapcSharedBss;
+
+    // Derive the revert-to status purely from config_mode
+    entry.negotiation_status_before_pending =
+        (config_mode == static_cast<uint8_t>(qca::eCoTDMAConfigMode::ADD))
+            ? sMapcSharedBss::eNegotiationStatus::IDLE
+            : sMapcSharedBss::eNegotiationStatus::ESTABLISHED;
+    entry.negotiation_pending_deadline =
+        std::chrono::steady_clock::now() + COTDMA_NEGOTIATION_PENDING_TIMEOUT;
+    entry.negotiation_pending_timer_active = true;
+}
+
+void coordinated_tdma_task::clear_negotiation_pending_timer(
+    Agent::sRadio::sBss::sMapcSharedBss &entry)
+{
+    entry.negotiation_pending_timer_active = false;
+}
+
+void coordinated_tdma_task::check_negotiation_pending_timeouts()
+{
+    using sMapcSharedBss = Agent::sRadio::sBss::sMapcSharedBss;
+
+    const auto now = std::chrono::steady_clock::now();
+
+    for (auto &agent_pair : database.m_agents) {
+        auto &agent = agent_pair.second;
+        if (!agent) {
+            continue;
+        }
+
+        for (auto &radio_pair : agent->radios) {
+            auto &radio = radio_pair.second;
+            if (!radio) {
+                continue;
+            }
+
+            for (auto &bss_pair : radio->bsses) {
+                auto &bss = bss_pair.second;
+                if (!bss || !bss->mapc_sharing_bss.is_valid) {
+                    continue;
+                }
+
+                for (auto &shared_pair : bss->mapc_sharing_bss.shared_bssids) {
+                    sMapcSharedBss &shared_entry = shared_pair.second;
+
+                    if (!shared_entry.negotiation_pending_timer_active) {
+                        continue;
+                    }
+
+                    if (now < shared_entry.negotiation_pending_deadline) {
+                        continue;
+                    }
+
+                    // Timed out - the lower layer (Agent firmware) failed to deliver the
+                    // corresponding MAPC Negotiation Status update in time. Revert to the
+                    // status this entry had immediately before entering the pending state,
+                    // so it becomes eligible for a retry (IDLE/TORN) or is otherwise handled
+                    // consistently with the pre-pending state (e.g. ESTABLISHED, on a failed
+                    // teardown).
+                    TASK_LOG(WARNING)
+                        << "check_negotiation_pending_timeouts: pending-negotiation timeout "
+                           "for sharing_bssid="
+                        << bss->bssid << " shared_bssid=" << shared_pair.first << " (agent "
+                        << agent->al_mac << "), reverting negotiation_status from "
+                        << static_cast<int>(shared_entry.negotiation_status) << " to "
+                        << static_cast<int>(shared_entry.negotiation_status_before_pending);
+
+                    shared_entry.negotiation_status =
+                        shared_entry.negotiation_status_before_pending;
+                    shared_entry.negotiation_pending_timer_active = false;
+                }
+            }
+        }
+    }
+}
