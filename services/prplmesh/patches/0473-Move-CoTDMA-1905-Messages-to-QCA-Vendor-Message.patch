+tlvf_qca_utils::parse_qca_mapc_capability_update_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaMapcCapabilityUpdate>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA MAPC Capability Update TLV";
+        return nullptr;
+    }
+    LOG(DEBUG) << "Parsed QCA MAPC Capability Update TLV: local_bssid=" << tlv->local_bssid()
+              << " peer_bss_count=" << static_cast<int>(tlv->peer_bss_count());
+    return tlv;
+}
