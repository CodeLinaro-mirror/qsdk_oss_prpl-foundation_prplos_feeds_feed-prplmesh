+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_mapc_configuration_policy_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaMapcConfigurationPolicy>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA MAPC Configuration Policy TLV";
+        return nullptr;
+    }
+    LOG(DEBUG) << "Parsed QCA MAPC Configuration Policy TLV: local_bss_count="
+              << static_cast<int>(tlv->local_bss_count());
+    return tlv;
+}
+
+// RECEIVE side: QCA MAPC Capability Update (carried in a QCA VENDOR_SPECIFIC_MESSAGE
+// identified by QCA_MSG_MAPC_REPORT).
