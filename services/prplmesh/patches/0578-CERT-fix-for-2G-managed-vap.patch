     return false;
 }
 
+#ifdef USE_PRPLMESH_NLHAL
+bool BackhaulManager::is_radio_htmode_he(const sMacAddr &radio_mac)
+{
+    auto radio = AgentDB::get()->get_radio_by_mac(radio_mac, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(DEBUG) << "WPS PBC: requested radio " << radio_mac << " not found in AgentDB";
+        return false;
+    }
+
+    std::string htmode;
+    if (!beerocks::bpl::bpl_cfg_get_radio_htmode(radio->front.iface_name, htmode)) {
+        LOG(DEBUG) << "WPS PBC: failed to read htmode for radio " << radio_mac
+                   << " iface=" << radio->front.iface_name;
+        return false;
+    }
+
+    const bool is_he = htmode.compare(0, 2, "HE") == 0;
+    LOG(DEBUG) << "WPS PBC: radio " << radio_mac << " htmode='" << htmode
+               << "' is_11ax=" << is_he;
+    return is_he;
+}
+
+bool BackhaulManager::disable_other_bsta_endpoints(const sMacAddr &keep_radio_mac)
+{
+    bool success       = true;
+    const auto bridge  = AgentDB::get()->bridge.iface_name;
+
+    for (const auto &radio_info : m_radios_info) {
+        if (!radio_info || radio_info->radio_mac == keep_radio_mac ||
+            radio_info->sta_iface.empty()) {
+            continue;
+        }
+
+        LOG(DEBUG) << "WPS PBC: removing STA interface " << radio_info->sta_iface
+                   << " from bridge " << bridge << " on radio " << radio_info->radio_mac;
+        if (!beerocks::net::network_utils::linux_remove_iface_from_bridge(
+                bridge, radio_info->sta_iface)) {
+            LOG(WARNING) << "WPS PBC: failed to remove STA interface " << radio_info->sta_iface
+                         << " from bridge " << bridge;
+            success = false;
+        }
+
+        LOG(DEBUG) << "WPS PBC: stopping STA interface " << radio_info->sta_iface;
+        if (!beerocks::net::network_utils::linux_iface_ctrl(radio_info->sta_iface, false)) {
+            LOG(WARNING) << "WPS PBC: failed to stop STA interface " << radio_info->sta_iface;
+            success = false;
+        }
+
+        if (!radio_info->sta_wlan_hal) {
+            continue;
+        }
+
+        LOG(DEBUG) << "WPS PBC: disabling STA endpoint " << radio_info->sta_iface
+                   << " on radio " << radio_info->radio_mac;
+        if (!radio_info->sta_wlan_hal->enable_disable_ep(false)) {
+            LOG(WARNING) << "WPS PBC: failed to disable STA endpoint " << radio_info->sta_iface
+                         << " on radio " << radio_info->radio_mac;
+            success = false;
+        }
+
+        LOG(DEBUG) << "WPS PBC: removing STA VAP " << radio_info->sta_iface << " from iw dev";
+        if (!radio_info->sta_wlan_hal->remove_vap_interface()) {
+            LOG(WARNING) << "WPS PBC: failed to remove STA VAP " << radio_info->sta_iface
+                         << " from iw dev";
+            success = false;
+        }
+    }
+    return success;
+}
+#endif
+
 void BackhaulManager::send_powersave_request(eFreqType freq, bool enable)
 {
     auto radio_mac = freq_to_radio_mac(freq);
@@ -6029,6 +6100,27 @@ bool BackhaulManager::start_wps_pbc(const sMacAddr &radio_mac)
         return start_wps_pbc_ap(radio_mac);
     }
     LOG(INFO) << "WPS PBC: bSTA path (agent not operational)";
+#ifdef USE_PRPLMESH_NLHAL
+    if (is_radio_htmode_he(radio_mac)) {
+        auto radio_it = std::find_if(
+            m_radios_info.begin(), m_radios_info.end(),
+            [&](const std::shared_ptr<sRadioInfo> &radio_info) {
+                return radio_info && radio_info->radio_mac == radio_mac;
+            });
+        if (radio_it == m_radios_info.end() || !(*radio_it) ||
+            (*radio_it)->sta_iface.empty() || !(*radio_it)->sta_wlan_hal) {
+            LOG(ERROR) << "WPS PBC: requested 11ax radio " << radio_mac
+                       << " has no usable STA interface/HAL";
+            return false;
+        }
+
+        if (!disable_other_bsta_endpoints(radio_mac)) {
+            LOG(ERROR) << "WPS PBC: failed to disable all other STA endpoints";
+            return false;
+        }
+        return start_wps_pbc_ep(radio_mac);
+    }
+#endif
     return start_wps_pbc_sta();
 }
 
