+# DPP credentials (Connector netRole=mapBackhaulSta, NAK private key, Configurator C-sign-key)
+# have been received from wpa_supplicant on the bSTA interface. Carries no payload — the values
+# themselves are written directly into the shared AgentDB (dpp_credentials) before this is sent,
+# exactly like cACTION_BACKHAUL_CONNECTED_NOTIFICATION/cACTION_BACKHAUL_SUPPLICANT_RESTART above.
+# Informational only — this is not the 1905-layer credential and does not trigger the 1905
+# handshake; see cACTION_BACKHAUL_DPP_1905_CREDENTIALS_NOTIFICATION below for that.
+cACTION_BACKHAUL_DPP_CREDENTIALS_NOTIFICATION:
+  _type: class
+
+# Sent by BackhaulManager to son_slave_thread once all three 1905/EasyMesh-layer DPP credentials
+# (Connector netRole=mapAgent, NAK private key, Configurator C-sign-key) have been received from
+# wpa_supplicant's DPP-1905-* events on the bSTA interface. Carries no payload — the values
+# themselves are written directly into the shared AgentDB (dpp_1905_credentials) before this is
+# sent. Triggers the 1905 4-way handshake (or direct BSS Configuration Request) — the wireless
+# bSTA analog of the wired DPP Extender's handle_dpp_wired_gas_response() trigger.
+cACTION_BACKHAUL_DPP_1905_CREDENTIALS_NOTIFICATION:
+  _type: class
