+bool sta_wlan_hal_nl80211::dpp_bootstrap_gen_and_get_uri(
+    const std::vector<uint8_t> &private_key_der, int &bootstrap_id, std::string &uri)
+{
+    std::string hex_key =
+        beerocks::string_utils::bytes_to_hex_string(private_key_der.data(), private_key_der.size());
+
+    char *reply         = nullptr;
+    std::string gen_cmd = "DPP_BOOTSTRAP_GEN type=qrcode key=" + hex_key;
+    if (!wpa_ctrl_send_msg(gen_cmd, &reply) || !reply) {
+        LOG(ERROR) << "DPP_BOOTSTRAP_GEN failed on " << get_iface_name();
+        return false;
+    }
+    bootstrap_id = beerocks::string_utils::stoi(reply);
+    if (bootstrap_id <= 0) {
+        LOG(ERROR) << "DPP_BOOTSTRAP_GEN returned invalid bootstrap id '" << reply << "' on "
+                   << get_iface_name();
+        return false;
+    }
+
+    std::string get_uri_cmd = "DPP_BOOTSTRAP_GET_URI " + std::to_string(bootstrap_id);
+    if (!wpa_ctrl_send_msg(get_uri_cmd, &reply) || !reply) {
+        LOG(ERROR) << "DPP_BOOTSTRAP_GET_URI failed for bootstrap id " << bootstrap_id << " on "
+                   << get_iface_name();
+        return false;
+    }
+    uri = reply;
+
+    return true;
+}
+
+bool sta_wlan_hal_nl80211::dpp_set_extra_conf_req_bsta_list(const std::string &json_value)
+{
+    if (!wpa_ctrl_send_msg("SET dpp_extra_conf_req_name bSTAList")) {
+        LOG(ERROR) << "SET dpp_extra_conf_req_name failed on " << get_iface_name();
+        return false;
+    }
+    if (!wpa_ctrl_send_msg("SET dpp_extra_conf_req_value " + json_value)) {
+        LOG(ERROR) << "SET dpp_extra_conf_req_value failed on " << get_iface_name();
+        return false;
+    }
+    return true;
+}
+
+bool sta_wlan_hal_nl80211::get_persisted_dpp_credentials(sPersistedDppCredentials &creds)
+{
+    creds = sPersistedDppCredentials{};
+
+    std::string iface_name = get_iface_name();
+
+    char *reply = nullptr;
+    if (!wpa_ctrl_send_msg("LIST_NETWORKS", &reply, iface_name) || !reply) {
+        LOG(ERROR) << "LIST_NETWORKS failed on " << iface_name;
+        return false;
+    }
+    std::string networks = reply;
+    LOG(DEBUG) << "DPP: LIST_NETWORKS reply on " << iface_name << ":\n" << networks;
+
+    int network_id = invalid_network_id;
+    std::istringstream networks_stream(networks);
+    std::string line;
+    std::getline(networks_stream, line); // header row
+    while (std::getline(networks_stream, line)) {
+        auto tab = line.find('\t');
+        if (tab == std::string::npos) {
+            continue;
+        }
+        int id = beerocks::string_utils::stoi(line.substr(0, tab));
+        std::string get_connector_cmd =
+            "GET_NETWORK " + std::to_string(id) + " dpp_connector";
+        bool ok = wpa_ctrl_send_msg(get_connector_cmd, &reply, iface_name) && reply;
+        LOG(DEBUG) << "DPP: " << get_connector_cmd << " reply on " << iface_name << ": "
+                  << (ok ? reply : "<failed>");
+        if (ok) {
+            network_id                = id;
+            creds.has_wlan_connector = true;
+            creds.wlan_connector      = reply;
+            break;
+        }
+    }
+
+    if (network_id != invalid_network_id) {
+        std::string nak_hex;
+        std::string get_nak_cmd =
+            "GET_NETWORK " + std::to_string(network_id) + " dpp_netaccesskey";
+        bool nak_ok = wpa_ctrl_send_msg(get_nak_cmd, &reply, iface_name) && reply;
+        LOG(DEBUG) << "DPP: " << get_nak_cmd << " reply on " << iface_name << ": "
+                  << (nak_ok ? reply : "<failed>");
+        if (nak_ok) {
+            nak_hex = reply;
+        }
+        std::string csign_hex;
+        std::string get_csign_cmd = "GET_NETWORK " + std::to_string(network_id) + " dpp_csign";
+        bool csign_ok              = wpa_ctrl_send_msg(get_csign_cmd, &reply, iface_name) && reply;
+        LOG(DEBUG) << "DPP: " << get_csign_cmd << " reply on " << iface_name << ": "
+                  << (csign_ok ? reply : "<failed>");
+        if (csign_ok) {
+            csign_hex = reply;
+        }
+        if (!nak_hex.empty() && !csign_hex.empty()) {
+            creds.nak_private_der = beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(nak_hex);
+            creds.c_sign_key_der = beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(csign_hex);
+        } else {
+            LOG(WARNING) << "DPP: persisted connector found on " << iface_name
+                         << " but NAK/C-sign-key could not be read back from network "
+                         << network_id;
+        }
+    } else {
+        LOG(DEBUG) << "DPP: no wpa_supplicant network on " << iface_name
+                  << " holds a persisted connector";
+    }
+
+    bool conn1905_ok = wpa_ctrl_send_msg("GET dpp_1905_connector", &reply, iface_name) && reply;
+    LOG(DEBUG) << "DPP: GET dpp_1905_connector reply on " << iface_name << ": "
+              << (conn1905_ok ? reply : "<failed>");
+    if (conn1905_ok) {
+        creds.has_1905_connector  = true;
+        creds.dpp_1905_connector = reply;
+    }
+
+    return true;
+}
+
+bool sta_wlan_hal_nl80211::dpp_chirp(int bootstrap_id, const std::string &net_role, int iterations)
+{
+    std::string chirp_cmd = "DPP_CHIRP own=" + std::to_string(bootstrap_id) +
+                            " iter=" + std::to_string(iterations) + " netrole=" + net_role;
+    if (!wpa_ctrl_send_msg(chirp_cmd)) {
+        LOG(WARNING) << "DPP: DPP_CHIRP failed on " << get_iface_name();
+        return false;
+    }
+    return true;
+}
+
 } // namespace nl80211
 
