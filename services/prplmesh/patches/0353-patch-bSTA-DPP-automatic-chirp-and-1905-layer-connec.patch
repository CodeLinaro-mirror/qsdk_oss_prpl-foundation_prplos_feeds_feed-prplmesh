+namespace {
+
+// Mirrors controller-side DppCryptoHelper::ec_key_to_jwk() (not linked into the agent build);
+// hand-adapted here since this is the only agent-side call site that needs DER->JWK for DPP.
+std::string base64url_encode(const uint8_t *data, size_t len)
+{
+    std::vector<uint8_t> out(4 * ((len + 2) / 3) + 1);
+    int out_len = EVP_EncodeBlock(out.data(), data, static_cast<int>(len));
+    std::string b64(reinterpret_cast<char *>(out.data()), static_cast<size_t>(out_len));
+    for (char &c : b64) {
+        if (c == '+') {
+            c = '-';
+        } else if (c == '/') {
+            c = '_';
+        }
+    }
+    while (!b64.empty() && b64.back() == '=') {
+        b64.pop_back();
+    }
+    return b64;
+}
+
+bool der_pubkey_to_jwk(const std::vector<uint8_t> &der, std::string &jwk_out)
+{
+    if (der.empty()) {
+        return false;
+    }
+    const uint8_t *p = der.data();
+    EVP_PKEY *key     = d2i_PUBKEY(nullptr, &p, static_cast<long>(der.size()));
+    if (!key) {
+        LOG(ERROR) << "DPP: d2i_PUBKEY failed while parsing C-sign-key DER";
+        return false;
+    }
+
+    uint8_t pub_bytes[128];
+    size_t pub_len = 0;
+    bool ok = EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY, pub_bytes,
+                                               sizeof(pub_bytes), &pub_len);
+
+    if (ok && pub_len == 33 && (pub_bytes[0] == 0x02 || pub_bytes[0] == 0x03)) {
+        // wpa_supplicant persists/emits the C-sign-key as a compressed EC point.
+        // Re-export the same key with the point-conversion-form switched to
+        // uncompressed to recover the x/y coordinates the JWK needs (OpenSSL 3.x
+        // param API, mirrors the compressed-form export in
+        // slave_thread::load_dpp_provisioned_keys() below — avoids deprecated EC_KEY calls).
+        OSSL_PARAM params[] = {
+            OSSL_PARAM_construct_utf8_string(OSSL_PKEY_PARAM_EC_POINT_CONVERSION_FORMAT,
+                                              const_cast<char *>("uncompressed"), 0),
+            OSSL_PARAM_END};
+        EVP_PKEY *dup = EVP_PKEY_dup(key);
+        ok            = dup && EVP_PKEY_set_params(dup, params) == 1 &&
+               EVP_PKEY_get_octet_string_param(dup, OSSL_PKEY_PARAM_PUB_KEY, pub_bytes,
+                                                sizeof(pub_bytes), &pub_len);
+        if (dup) {
+            EVP_PKEY_free(dup);
+        }
+    }
+
+    EVP_PKEY_free(key);
+
+    if (!ok || pub_len != 65 || pub_bytes[0] != 0x04) {
+        LOG(ERROR) << "DPP: unexpected C-sign-key public key encoding (len=" << pub_len << ")";
+        return false;
+    }
+
+    std::string x = base64url_encode(pub_bytes + 1, 32);
+    std::string y = base64url_encode(pub_bytes + 33, 32);
+    jwk_out       = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"" + x + "\",\"y\":\"" + y + "\"}";
+    return true;
+}
+
