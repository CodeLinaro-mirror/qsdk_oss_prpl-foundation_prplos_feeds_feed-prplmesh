+// ---------------------------------------------------------------------------
+// DPP Credential Bridge — consumes DPP-* ctrl_iface events forwarded from the
+// STA HAL's existing wpa_supplicant event socket and forwards collected
+// 1905-layer DPP credentials to son_slave_thread once all three are received.
+// ---------------------------------------------------------------------------
+
+void BackhaulManager::process_dpp_bridge_events(const std::string &sta_iface,
+                                                 const std::string &event_line)
+{
+    std::string event(event_line);
+    if (event.empty()) {
+        return;
+    }
+    if (event[0] == '<') {
+        auto end = event.find('>');
+        if (end != std::string::npos) {
+            event = event.substr(end + 1);
+        }
+    }
+
+    auto strip_eol = [](std::string &s) {
+        while (!s.empty() && (s.back() == '\n' || s.back() == '\r')) {
+            s.pop_back();
+        }
+    };
+
+    if (event.rfind("DPP-CONNECTOR ", 0) == 0) {
+        std::string jws = event.substr(14);
+        strip_eol(jws);
+        std::string net_role = extract_net_role_from_connector(jws);
+        if (net_role == "mapBackhaulSta") {
+            m_dpp_cred_bridge.connector               = jws;
+            m_dpp_cred_bridge.connector_1905_received = true;
+            LOG(DEBUG) << "DPP bridge: received own WLAN connector";
+        } else {
+            LOG(DEBUG) << "DPP bridge: ignoring connector with netRole=" << net_role;
+        }
+    } else if (event.rfind("DPP-NET-ACCESS-KEY ", 0) == 0) {
+        std::string hex = event.substr(19);
+        auto sp = hex.find(' ');
+        if (sp != std::string::npos) {
+            hex = hex.substr(0, sp);
+        }
+        strip_eol(hex);
+        m_dpp_cred_bridge.nak_private_der =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(hex);
+        m_dpp_cred_bridge.nak_received = true;
+        LOG(DEBUG) << "DPP bridge: received NAK private key";
+    } else if (event.rfind("DPP-C-SIGN-KEY ", 0) == 0) {
+        std::string hex = event.substr(15);
+        strip_eol(hex);
+        m_dpp_cred_bridge.c_sign_key_der =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(hex);
+        m_dpp_cred_bridge.csign_received = true;
+        LOG(DEBUG) << "DPP bridge: received C-sign-key";
+    } else if (event.rfind("DPP-MAP-DFCOUNTER ", 0) == 0) {
+        std::string val = event.substr(18);
+        strip_eol(val);
+        if (!val.empty()) {
+            m_dpp_cred_bridge.df_counter_threshold = static_cast<uint16_t>(std::atoi(val.c_str()));
+        }
+        LOG(DEBUG) << "DPP bridge: dfCounterThreshold=" << m_dpp_cred_bridge.df_counter_threshold;
+    } else if (event.rfind("DPP-1905-CONNECTOR ", 0) == 0) {
+        std::string jws = event.substr(19);
+        strip_eol(jws);
+        // wpa_supplicant may prefix this event with "signedConnector=" — strip it if present.
+        const std::string prefix = "signedConnector=";
+        if (jws.rfind(prefix, 0) == 0) {
+            jws = jws.substr(prefix.size());
+        }
+        std::string net_role = extract_net_role_from_connector(jws);
+        if (net_role == "mapAgent") {
+            m_dpp_1905_cred_bridge.connector          = jws;
+            m_dpp_1905_cred_bridge.connector_received = true;
+            LOG(DEBUG) << "DPP bridge: received 1905-layer connector";
+        } else {
+            LOG(DEBUG) << "DPP bridge: ignoring 1905 connector with netRole=" << net_role;
+        }
+    } else if (event.rfind("DPP-1905-NET-ACCESS-KEY ", 0) == 0) {
+        std::string hex = event.substr(24);
+        auto sp = hex.find(' ');
+        if (sp != std::string::npos) {
+            hex = hex.substr(0, sp);
+        }
+        strip_eol(hex);
+        m_dpp_1905_cred_bridge.nak_private_der =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(hex);
+        m_dpp_1905_cred_bridge.nak_received = true;
+        LOG(DEBUG) << "DPP bridge: received 1905-layer NAK private key";
+    } else if (event.rfind("DPP-1905-C-SIGN-KEY ", 0) == 0) {
+        std::string hex = event.substr(20);
+        strip_eol(hex);
+        m_dpp_1905_cred_bridge.c_sign_key_der =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(hex);
+        m_dpp_1905_cred_bridge.csign_received = true;
+        LOG(DEBUG) << "DPP bridge: received 1905-layer C-sign-key";
+    } else if (event.rfind("DPP-1905-DF-COUNTER-THRESHOLD ", 0) == 0) {
+        std::string val = event.substr(30);
+        strip_eol(val);
+        if (!val.empty()) {
+            m_dpp_1905_cred_bridge.df_counter_threshold =
+                static_cast<uint16_t>(std::atoi(val.c_str()));
+        }
+        LOG(DEBUG) << "DPP bridge: 1905-layer dfCounterThreshold="
+                   << m_dpp_1905_cred_bridge.df_counter_threshold;
+    } else if (event.rfind("DPP-AUTH-SUCCESS", 0) == 0) {
+        // Not final success — DPP Authentication succeeded, Configuration is still to come.
+        // Give it a fresh full window rather than firing a retry chirp mid-exchange.
+        auto db = AgentDB::get();
+        auto radio_it =
+            std::find_if(m_radios_info.begin(), m_radios_info.end(),
+                         [&](const auto &r) { return r->sta_iface == sta_iface; });
+        if (radio_it != m_radios_info.end()) {
+            arm_dpp_chirp_timer(*radio_it,
+                               std::chrono::seconds(db->dpp_bootstrap.chirp_retry_interval_sec));
+        }
+        LOG(DEBUG) << "DPP bridge: DPP-AUTH-SUCCESS on " << sta_iface << " — chirp timer reset";
+    } else if (event.rfind("DPP-FAIL", 0) == 0) {
+        // wpa_supplicant tears down the whole DPP exchange on failure (e.g. a TX status
+        // timeout for an off-channel DPP action frame) and does not resume chirping on its own.
+        retry_dpp_chirp_after_failure(sta_iface, "DPP-FAIL");
+    } else if (event.rfind("DPP-CONF-FAILED", 0) == 0) {
+        // Authentication succeeded but the Configuration exchange that followed it did not
+        // (e.g. a GAS query timeout waiting for a Configuration Response). Same story as
+        // DPP-FAIL: wpa_supplicant tears down the exchange and does not resume chirping on its
+        // own.
+        retry_dpp_chirp_after_failure(sta_iface, "DPP-CONF-FAILED");
+    }
+
+    if (m_dpp_cred_bridge.connector_1905_received && m_dpp_cred_bridge.nak_received &&
+        m_dpp_cred_bridge.csign_received) {
+        LOG(INFO) << "DPP bridge: own WLAN connector, NAK, and C-sign-key received";
+
+        finalize_dpp_credentials(m_dpp_cred_bridge.connector, m_dpp_cred_bridge.nak_private_der,
+                                 m_dpp_cred_bridge.c_sign_key_der,
+                                 m_dpp_cred_bridge.df_counter_threshold);
+
+        m_dpp_cred_bridge = sDppCredentialBridgeState{};
+    }
+
+    if (m_dpp_1905_cred_bridge.connector_received && m_dpp_1905_cred_bridge.nak_received &&
+        m_dpp_1905_cred_bridge.csign_received) {
+        LOG(INFO) << "DPP bridge: all 1905-layer credentials received — forwarding to agent";
+
+        finalize_dpp_1905_credentials(m_dpp_1905_cred_bridge.connector,
+                                       m_dpp_1905_cred_bridge.nak_private_der,
+                                       m_dpp_1905_cred_bridge.c_sign_key_der,
+                                       m_dpp_1905_cred_bridge.df_counter_threshold);
+
+        m_dpp_1905_cred_bridge = sDpp1905CredentialBridgeState{};
+    }
+}
+
+void BackhaulManager::finalize_dpp_1905_credentials(const std::string &connector,
+                                                     const std::vector<uint8_t> &nak_private_der,
+                                                     const std::vector<uint8_t> &c_sign_key_der,
+                                                     uint16_t df_counter_threshold)
+{
+    auto db                                       = AgentDB::get();
+    db->dpp_1905_credentials.connector            = connector;
+    db->dpp_1905_credentials.nak_private_der      = nak_private_der;
+    db->dpp_1905_credentials.c_sign_key_der       = c_sign_key_der;
+    db->dpp_1905_credentials.df_counter_threshold = df_counter_threshold;
+    db->dpp_1905_credentials.initialized          = false; // son_slave_thread flips this true
+                                                             // after DER->JWK conversion
+
+    auto notify = message_com::create_vs_message<
+        beerocks_message::cACTION_BACKHAUL_DPP_1905_CREDENTIALS_NOTIFICATION>(cmdu_tx);
+    if (notify && m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+        send_cmdu(m_agent_fd, cmdu_tx);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// DPP Connector reboot-restore — pulls the persisted WLAN/backhaul and
+// 1905-layer Connectors and their key material out of wpa_supplicant via
+// ctrl_iface at startup, since wpa_supplicant never re-emits DPP-CONNECTOR /
+// DPP-1905-CONNECTOR (or their NAK/C-sign-key counterparts) on restart; those
+// events only fire once, live, during an active DPP exchange.
+// ---------------------------------------------------------------------------
+
+void BackhaulManager::finalize_dpp_credentials(const std::string &connector,
+                                               const std::vector<uint8_t> &nak_private_der,
+                                               const std::vector<uint8_t> &c_sign_key_der,
+                                               uint16_t df_counter_threshold)
+{
+    auto db                                  = AgentDB::get();
+    db->dpp_credentials.connector            = connector;
+    db->dpp_credentials.nak_private_der      = nak_private_der;
+    db->dpp_credentials.c_sign_key_der       = c_sign_key_der;
+    db->dpp_credentials.df_counter_threshold = df_counter_threshold;
+    db->dpp_credentials.initialized          = false; // son_slave_thread flips this true
+                                                         // after DER->JWK conversion
+
+    auto notify = message_com::create_vs_message<
+        beerocks_message::cACTION_BACKHAUL_DPP_CREDENTIALS_NOTIFICATION>(cmdu_tx);
+    if (notify && m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+        send_cmdu(m_agent_fd, cmdu_tx);
+    }
+}
+
+void BackhaulManager::restore_dpp_credentials_on_boot(const std::shared_ptr<sRadioInfo> &radio_info)
+{
+    auto db = AgentDB::get();
+
+    bool need_backhaul =
+        !db->dpp_credentials.initialized && db->dpp_credentials.connector.empty();
+    bool need_1905 =
+        !db->dpp_1905_credentials.initialized && db->dpp_1905_credentials.connector.empty();
+    if (!need_backhaul && !need_1905) {
+        // Either already restored/converted this run, or a live DPP exchange already
+        // populated both (e.g. this is a HAL re-init after a backhaul reconnect, not a reboot).
+        return;
+    }
+
+    bwl::sPersistedDppCredentials creds;
+    if (!radio_info->sta_wlan_hal->get_persisted_dpp_credentials(creds)) {
+        LOG(WARNING) << "DPP: failed to query persisted credentials on " << radio_info->sta_iface;
+        return;
+    }
+
+    if (need_backhaul) {
+        if (!creds.has_wlan_connector) {
+            LOG(DEBUG) << "DPP: no wpa_supplicant network on " << radio_info->sta_iface
+                      << " holds a persisted connector — nothing to restore";
+        } else if (creds.nak_private_der.empty() || creds.c_sign_key_der.empty()) {
+            LOG(WARNING) << "DPP: persisted connector found on " << radio_info->sta_iface
+                         << " but NAK/C-sign-key could not be read back";
+        } else {
+            std::string net_role = extract_net_role_from_connector(creds.wlan_connector);
+            if (net_role == "mapBackhaulSta") {
+                LOG(INFO) << "DPP: restored own WLAN connector from wpa_supplicant persisted "
+                             "config on "
+                          << radio_info->sta_iface;
+                finalize_dpp_credentials(creds.wlan_connector, creds.nak_private_der,
+                                         creds.c_sign_key_der,
+                                         db->dpp_credentials.df_counter_threshold);
+            } else {
+                LOG(WARNING) << "DPP: persisted connector on " << radio_info->sta_iface
+                            << " has unexpected netRole=" << net_role
+                            << " — not restoring as WLAN/backhaul connector";
+            }
+        }
+    }
+
+    if (need_1905) {
+        if (!creds.has_1905_connector) {
+            LOG(DEBUG) << "DPP: no persisted 1905 connector on " << radio_info->sta_iface
+                      << " — nothing to restore";
+        } else if (creds.nak_private_der.empty() || creds.c_sign_key_der.empty()) {
+            LOG(WARNING) << "DPP: persisted 1905 connector found on " << radio_info->sta_iface
+                         << " but NAK/C-sign-key could not be read back";
+        } else {
+            std::string net_role = extract_net_role_from_connector(creds.dpp_1905_connector);
+            if (net_role == "mapAgent") {
+                LOG(INFO) << "DPP: restored 1905-layer connector from wpa_supplicant persisted "
+                             "config on "
+                          << radio_info->sta_iface;
+                finalize_dpp_1905_credentials(creds.dpp_1905_connector, creds.nak_private_der,
+                                              creds.c_sign_key_der,
+                                              db->dpp_1905_credentials.df_counter_threshold);
+            } else {
+                LOG(WARNING) << "DPP: persisted dpp_1905_connector has unexpected netRole="
+                             << net_role << " — ignoring";
+            }
+        }
+    }
+}
+
+void BackhaulManager::retry_dpp_chirp_after_failure(const std::string &sta_iface,
+                                                    const std::string &event_name)
+{
+    auto radio_it = std::find_if(m_radios_info.begin(), m_radios_info.end(),
+                                 [&](const std::shared_ptr<sRadioInfo> &radio_info) {
+                                     return radio_info->sta_iface == sta_iface;
+                                 });
+
+    // No chirp cycle currently running for this radio — e.g. an unrelated FSM restart (say, the
+    // WAIT_WPS overall timeout) raced with this failure and already tore the timer down.
+    // Nothing to do here; that restart's own fresh WAIT_WPS entry will arm a new cycle itself.
+    if (radio_it == m_radios_info.end() ||
+        (*radio_it)->dpp_chirp_timer_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(INFO) << "DPP bridge: " << event_name << " on " << sta_iface
+                  << " — no active chirp cycle to retry (already progressed, or an FSM restart "
+                     "is in progress)";
+        return;
+    }
+
+    LOG(INFO) << "DPP bridge: " << event_name << " on " << sta_iface << " — retrying chirp in "
+              << dpp_chirp_fail_retry_delay.count() << "s";
+    arm_dpp_chirp_timer(*radio_it, dpp_chirp_fail_retry_delay);
+
+    // Refresh the WAIT_WPS overall timeout so it doesn't expire out from under this retry —
+    // without this, a failure landing late in the current STATE_WAIT_WPS_TIMEOUT_SECONDS window
+    // could let that window's own timeout fire a full FSM restart before the
+    // dpp_chirp_fail_retry_delay retry above even gets a chance to run, throwing the retry away
+    // and falling back to a much slower restart-and-reattach cycle instead. If nothing else
+    // happens for a further full STATE_WAIT_WPS_TIMEOUT_SECONDS after this, the normal timeout
+    // still applies as before.
+    if (FSM_IS_IN_STATE(WAIT_WPS)) {
+        state_time_stamp_timeout =
+            std::chrono::steady_clock::now() + std::chrono::seconds(STATE_WAIT_WPS_TIMEOUT_SECONDS);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// DPP bootstrap key injection — wpa_supplicant setup for a wireless bSTA
+// ---------------------------------------------------------------------------
+
+bool BackhaulManager::inject_dpp_bootstrap_key_and_conf_req(
+    const std::shared_ptr<sRadioInfo> &radio_info)
+{
+    auto db = AgentDB::get();
+    if (!db->dpp_bootstrap.valid || !db->dpp_bootstrap.private_key) {
+        LOG(WARNING) << "DPP: no valid bootstrap key — skipping wpa_supplicant injection";
+        return false;
+    }
+
+    // DPP_BOOTSTRAP_GEN key= requires the full SEC1 ECPrivateKey DER as hex (RFC 5915), not
+    // just the raw 32-byte private scalar. i2d_PrivateKey() on an EC-backed EVP_PKEY already
+    // produces this format (same call already used for the NAK export in dpp_agent_task.cpp).
+    unsigned char *der = nullptr;
+    int der_len        = i2d_PrivateKey(db->dpp_bootstrap.private_key, &der);
+    if (der_len <= 0 || !der) {
+        LOG(ERROR) << "DPP: failed to serialize bootstrap key to SEC1 DER";
+        return false;
+    }
+    std::vector<uint8_t> der_bytes(der, der + der_len);
+    OPENSSL_free(der);
+
+    int bootstrap_id = 0;
+    std::string uri;
+    if (!radio_info->sta_wlan_hal->dpp_bootstrap_gen_and_get_uri(der_bytes, bootstrap_id, uri)) {
+        LOG(ERROR) << "DPP: bootstrap key generation/URI fetch failed on "
+                   << radio_info->sta_iface;
+        return false;
+    }
+    db->dpp_bootstrap.wpa_bootstrap_id = bootstrap_id;
+    LOG(INFO) << "DPP: bootstrap key registered, wpa_bootstrap_id="
+              << db->dpp_bootstrap.wpa_bootstrap_id;
+
+    // wpa_supplicant re-derives the URI from the bootstrap key it just parsed; persist that
+    // version so wpa_supplicant is the single source of truth — this is the one genuinely new
+    // idea worth taking from the reference change; everything else about key
+    // provisioning/validation is already handled more thoroughly by the existing
+    // load_dpp_provisioned_keys() in son_slave_thread.cpp.
+    db->dpp_bootstrap.dpp_uri = uri;
+
+    // Set bSTAList for the EasyMesh config request.
+    std::string bsta_val = "[{\"netRole\":\"mapBackhaulSta\","
+                           "\"akm\":\"506F9A02+000FAC08\","
+                           "\"channelList\":\"81/1,6,11,115/36,121/100,125/149\"}]";
+    radio_info->sta_wlan_hal->dpp_set_extra_conf_req_bsta_list(bsta_val);
+
+    LOG(INFO) << "DPP: bootstrap key injected on " << radio_info->sta_iface
+              << ", URI refreshed from wpa_supplicant, bSTAList configured";
+    return true;
+}
+
+bool BackhaulManager::is_dpp_bootstrap_injected_on_any_radio() const
+{
+    return std::any_of(m_radios_info.begin(), m_radios_info.end(),
+                        [](const std::shared_ptr<sRadioInfo> &radio_info) {
+                            return radio_info->dpp_bootstrap_injected;
+                        });
+}
+
+std::string BackhaulManager::extract_net_role_from_connector(const std::string &connector_jws)
+{
+    // JWS compact: header_b64u.payload_b64u.sig_b64u — netRole lives in the payload JSON.
+    size_t dot1 = connector_jws.find('.');
+    size_t dot2 = connector_jws.find('.', dot1 + 1);
+    if (dot1 == std::string::npos || dot2 == std::string::npos) {
+        return {};
+    }
+
+    std::string payload_b64u = connector_jws.substr(dot1 + 1, dot2 - dot1 - 1);
+    // base64url decode (url-safe alphabet, missing padding tolerated)
+    std::string s = payload_b64u;
+    for (char &c : s) {
+        if (c == '-') c = '+';
+        if (c == '_') c = '/';
+    }
+    while (s.size() % 4) {
+        s += '=';
+    }
+    std::vector<uint8_t> raw(s.size());
+    int len = EVP_DecodeBlock(raw.data(), reinterpret_cast<const unsigned char *>(s.c_str()),
+                               static_cast<int>(s.size()));
+    if (len <= 0) {
+        return {};
+    }
+    std::string payload_json(reinterpret_cast<const char *>(raw.data()),
+                             static_cast<size_t>(len));
+
+    auto pos = payload_json.find("\"netRole\":\"");
+    if (pos == std::string::npos) {
+        return {};
+    }
+    pos += 11;
+    auto end = payload_json.find('"', pos);
+    if (end == std::string::npos) {
+        return {};
+    }
+    return payload_json.substr(pos, end - pos);
+}
+
+// ---------------------------------------------------------------------------
+// DPP chirp (Presence Announcement) lifecycle — wireless bSTA
+// ---------------------------------------------------------------------------
+
+bool BackhaulManager::is_bsta_connected() const
+{
+    return FSM_IS_IN_STATE(CONNECTED) || FSM_IS_IN_STATE(OPERATIONAL);
+}
+
+void BackhaulManager::maybe_start_dpp_chirp()
+{
+    auto db = AgentDB::get();
+    if (db->dpp_extender_config.onboarding_type != AgentDB::OnboardingType::DPP ||
+        !db->dpp_bootstrap.valid) {
+        return;
+    }
+
+    for (auto &radio_info : m_radios_info) {
+        if (radio_info->sta_iface.empty() || !radio_info->dpp_bootstrap_injected ||
+            radio_info->dpp_provisioning_done ||
+            radio_info->dpp_chirp_timer_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+            continue;
+        }
+        arm_dpp_chirp_timer(radio_info,
+                            std::chrono::seconds(db->dpp_bootstrap.chirp_start_delay_sec));
+    }
+}
+
+void BackhaulManager::arm_dpp_chirp_timer(const std::shared_ptr<sRadioInfo> &radio_info,
+                                          std::chrono::seconds delay)
+{
+    cancel_dpp_chirp_timer(radio_info);
+
+    radio_info->dpp_chirp_timer_fd = m_timer_manager->add_timer(
+        "DPP Chirp", std::chrono::duration_cast<std::chrono::milliseconds>(delay),
+        std::chrono::milliseconds::zero(), [this, radio_info](int fd, EventLoop &loop) {
+            radio_info->dpp_chirp_timer_fd = beerocks::net::FileDescriptor::invalid_descriptor;
+            handle_dpp_chirp_timeout(radio_info);
+            return true;
+        });
+    if (radio_info->dpp_chirp_timer_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "DPP: failed to arm chirp timer for " << radio_info->sta_iface;
+    }
+}
+
+void BackhaulManager::cancel_dpp_chirp_timer(const std::shared_ptr<sRadioInfo> &radio_info)
+{
+    if (radio_info->dpp_chirp_timer_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+        m_timer_manager->remove_timer(radio_info->dpp_chirp_timer_fd);
+    }
+}
+
+void BackhaulManager::handle_dpp_chirp_timeout(const std::shared_ptr<sRadioInfo> &radio_info)
+{
+    auto db = AgentDB::get();
+
+    if (is_bsta_connected()) {
+        radio_info->dpp_provisioning_done = true;
+        LOG(DEBUG) << "DPP: bSTA connected on " << radio_info->sta_iface
+                   << " — stopping chirp cycle";
+        return;
+    }
+
+    if (!radio_info->sta_wlan_hal->dpp_chirp(db->dpp_bootstrap.wpa_bootstrap_id, "mapAgent", 3)) {
+        LOG(WARNING) << "DPP: DPP_CHIRP failed on " << radio_info->sta_iface;
+    } else {
+        LOG(DEBUG) << "DPP: DPP_CHIRP sent on " << radio_info->sta_iface;
+    }
+
+    arm_dpp_chirp_timer(radio_info, std::chrono::seconds(db->dpp_bootstrap.chirp_retry_interval_sec));
+}
+
 } // namespace beerocks
