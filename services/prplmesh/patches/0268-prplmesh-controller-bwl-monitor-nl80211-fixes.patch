+                                 << " client_mac=" << client_mac;
+                    msg->params.association_frame_length = 0;
+                }
             } else {
                 // Add the latest association frame
                 // PPM-1718: parse the association frame and make sure it belongs to the right MAC address.
@@ -3651,6 +3758,8 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
                 std::string src_mac           = tlvf::mac_to_string(mgmt_frame->mac);
                 m_latest_assoc_frame[src_mac] = mgmt_frame;
                 LOG(DEBUG) << "Saved assoc frame";
+                // Persist to the shared DB so the frame survives agent restart.
+                persist_assoc_frame(src_mac, mgmt_frame->data);
             }
         }
 
@@ -3687,13 +3796,40 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
 
         auto assoc_frame_type = assoc_frame::AssocReqFrame::UNKNOWN;
 
-        if (m_latest_assoc_frame.find(src_mac) == m_latest_assoc_frame.end()) {
-            LOG(WARNING) << "STA-CONNECTED without previously receiving a (re-)association frame!";
+        auto it_sta = m_latest_assoc_frame.find(src_mac);
+
+        /* MLO fallback: STA_Connected uses the MLD MAC as src_mac, but
+         * m_latest_assoc_frame is keyed by the link MAC (affiliated STA MAC)
+         * from the AP_MGMT_FRAME_RECEIVED event.  When the direct lookup fails,
+         * scan for a frame whose BSSID matches the current VAP's BSS MAC — this
+         * uniquely identifies the link-specific assoc frame for this MLO client.
+         *
+         * This mirrors the same fallback already present in the STA-FIRST/STA-NEXT
+         * path (see above) and fixes the case where STA_Connected arrives with the
+         * MLD MAC before the link MAC → MLD MAC mapping is established. */
+        if (it_sta == m_latest_assoc_frame.end()) {
+            /* In process_nl80211_event() the VAP is identified by vap_id, not a loop variable.
+             * Use m_radio_info.available_vaps[vap_id].bss to get the BSS interface name. */
+            const std::string &cur_bss = m_radio_info.available_vaps[vap_id].bss;
+            for (auto &kv : m_latest_assoc_frame) {
+                if (tlvf::mac_to_string(kv.second->bssid) == cur_bss) {
+                    it_sta = m_latest_assoc_frame.find(kv.first);
+                    LOG(DEBUG) << "MLO STA_Connected assoc frame fallback: MLD_MAC=" << src_mac
+                               << " → link_MAC=" << kv.first
+                               << " (BSS=" << cur_bss << ")";
+                    break;
+                }
+            }
+        }
+
+        if (it_sta == m_latest_assoc_frame.end()) {
+            LOG(WARNING) << "STA-CONNECTED without previously receiving a (re-)association frame!"
+                         << " client_mac=" << src_mac;
             msg->params.association_frame_length = 0;
         } else {
             // Add the latest association frame
             // PPM-1718: parse the association frame and make sure it belongs to the right MAC address.
-            auto &frame_info  = m_latest_assoc_frame[src_mac];
+            auto &frame_info  = it_sta->second;
             msg->params.bssid = frame_info->bssid;
             auto &frame_body  = frame_info->data;
             // Add the latest association frame
@@ -3859,7 +3995,12 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         // Add the message to the queue
         event_queue_push(Event::STA_Disconnected, msg_buff);
 
-        m_latest_assoc_frame.erase(parsed_obj[bwl::EVENT_KEYLESS_PARAM_MAC]);
+        {
+            const std::string &sta_mac = parsed_obj[bwl::EVENT_KEYLESS_PARAM_MAC];
+            m_latest_assoc_frame.erase(sta_mac);
+            // Remove the entry from the shared assoc frame DB.
+            remove_assoc_frame(sta_mac);
+        }
 
     } break;
 
