+// Path of the single file that persists all STA association frames across agent restarts.
+// Format: one line per STA — "<sta_mac> <frame_hex>\n"
+static const std::string ASSOC_FRAMES_DB = "/tmp/beerocks/sta_assoc_frames.txt";
+
+// Persist or update the association frame for one STA in the shared DB file.
+static void persist_assoc_frame(const std::string &sta_mac,
+                                 const std::vector<uint8_t> &frame)
+{
+    // Build hex string from raw frame bytes
+    std::ostringstream hex;
+    for (uint8_t b : frame) {
+        hex << std::hex << std::setw(2) << std::setfill('0') << static_cast<int>(b);
+    }
+    std::string new_hex = hex.str();
+
+    // Read existing lines, replacing any entry for this sta_mac
+    std::vector<std::string> lines;
+    std::ifstream ifs(ASSOC_FRAMES_DB);
+    if (ifs) {
+        std::string line;
+        while (std::getline(ifs, line)) {
+            if (line.empty()) continue;
+            std::istringstream ss(line);
+            std::string mac;
+            ss >> mac;
+            if (mac == sta_mac) continue; // will be replaced
+            lines.push_back(line);
+        }
+    }
+    lines.push_back(sta_mac + " " + new_hex);
+
+    std::ofstream ofs(ASSOC_FRAMES_DB, std::ios::trunc);
+    if (ofs) {
+        for (const auto &l : lines) ofs << l << "\n";
+        LOG(DEBUG) << "Persisted assoc frame for " << sta_mac
+                   << " (" << frame.size() << " bytes) to " << ASSOC_FRAMES_DB;
+    }
+}
+
+// Restore the association frame for one STA from the shared DB file.
+// Returns empty vector if not found.
+static std::vector<uint8_t> restore_assoc_frame(const std::string &sta_mac)
+{
+    std::ifstream ifs(ASSOC_FRAMES_DB);
+    if (!ifs) return {};
+
+    std::string line;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) continue;
+        std::istringstream ss(line);
+        std::string mac, hex_str;
+        ss >> mac >> hex_str;
+        if (mac != sta_mac) continue;
+        // Decode hex string back to bytes
+        std::vector<uint8_t> frame;
+        for (size_t i = 0; i + 1 < hex_str.size(); i += 2) {
+            frame.push_back(static_cast<uint8_t>(std::stoi(hex_str.substr(i, 2), nullptr, 16)));
+        }
+        return frame;
+    }
+    return {};
+}
+
+// Remove the entry for a given sta_mac from the shared DB file.
+static void remove_assoc_frame(const std::string &sta_mac)
+{
+    std::ifstream ifs(ASSOC_FRAMES_DB);
+    if (!ifs) return;
+
+    std::vector<std::string> lines;
+    std::string line;
+    bool removed = false;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) continue;
+        std::istringstream ss(line);
+        std::string mac;
+        ss >> mac;
+        if (mac == sta_mac) { removed = true; continue; }
+        lines.push_back(line);
+    }
+    ifs.close();
+
+    if (!removed) return;
+    std::ofstream ofs(ASSOC_FRAMES_DB, std::ios::trunc);
+    if (ofs) {
+        for (const auto &l : lines) ofs << l << "\n";
+        LOG(DEBUG) << "Removed persisted assoc frame for " << sta_mac
+                   << " from " << ASSOC_FRAMES_DB;
+    }
+}
