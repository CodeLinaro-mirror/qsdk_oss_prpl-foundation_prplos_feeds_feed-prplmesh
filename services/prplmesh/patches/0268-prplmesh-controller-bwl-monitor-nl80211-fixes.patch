  * @brief Adds an unassociated STA to the ath12k driver's peer neighbor list.
  */
-bool mon_wlan_hal_nl80211::add_peer_neighbor(const std::string &mac_address)
+bool mon_wlan_hal_nl80211::add_peer_neighbor(const std::string &mac_address, bool *already_exists)
 {
     // Compose correct debugfs path based on phy_name and hw index
     std::string phy_name = m_radio_info.phy_name;
@@ -1105,14 +1105,30 @@ bool mon_wlan_hal_nl80211::add_peer_neighbor(const std::string &mac_address)
         << " debugfs_path=" << debugfs_path
         << " command=" << command;
 
-    // Use write_debugfs_file to write the command
-    if (!write_debugfs_file(debugfs_path, command)) {
-        LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+    std::string sys_cmd = "echo \"" + command + "\" > " + debugfs_path;
+    int ret = system(sys_cmd.c_str());
+
+    if (ret == 0) {
+        LOG(INFO) << "Successfully added neighbor " << mac_address << " via " << debugfs_path;
+        if (already_exists) { *already_exists = false; }
+        return true;
+    }
+
+    /* Return code 256 (shell exit 1) maps to the kernel's EEXIST —
+     * "cannot add existing neighbor peer" — meaning this STA is currently
+     * associated on this radio.  Treat as a soft skip: the driver cannot
+     * measure an associated peer via the unassoc ROC path. */
+    if (ret == 256) {
+        LOG(INFO) << "add_peer_neighbor: " << mac_address
+                  << " is already/associated on this radio (EEXIST) — skipping unassoc measurement";
+        if (already_exists) { *already_exists = true; }
         return false;
     }
 
-    LOG(INFO) << "Successfully added neighbor " << mac_address << " via " << debugfs_path;
-    return true;
+    LOG(ERROR) << "Failed to add peer neighbor: " << mac_address
+               << " Return code: " << ret;
+    if (already_exists) { *already_exists = false; }
+    return false;
 }
 
 
@@ -1407,8 +1423,18 @@ bool mon_wlan_hal_nl80211::sta_unassoc_rssi_measurement(
         }
 
         // Add STA to the driver's debugfs list for monitoring
-        if (!add_peer_neighbor(mac_address)) {
-            LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+        bool already_exists = false;
+        if (!add_peer_neighbor(mac_address, &already_exists)) {
+            if (already_exists) {
+                /* STA is currently associated on this radio — driver cannot
+                 * measure it as an unassociated peer via ROC scan.  Skip it
+                 * silently; the unassoc query for this STA will return RCPI=0
+                 * (noise floor) which the steering app treats as no-measurement. */
+                LOG(INFO) << "sta_unassoc_rssi_measurement: skipping " << mac_address
+                          << " (associated peer on this radio)";
+            } else {
+                LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+            }
             continue;
         }
 
