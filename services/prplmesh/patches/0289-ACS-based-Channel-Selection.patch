--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -267,6 +267,11 @@ struct RadioInfo {
 
 struct hal_conf_t {
     bool ap_acs_enabled = false;
+    // Active ACS channel selection. Propagated from
+    // AgentDB::device_conf.active_acs_chansel_enable via ap_manager::create_ap_wlan_hal().
+    // When true, nl80211 start_platform_acs() drives the driver ACS:
+    //   acs clear_block_chan_list + acs set_block_chan_list <block> + acs invoke 0.
+    bool active_acs_chansel_enable = false;
