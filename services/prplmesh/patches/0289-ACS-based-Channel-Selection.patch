diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 2fe4f68..6704dc6 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -5756,8 +5756,173 @@ bool ap_wlan_hal_nl80211::get_spatial_reuse_config(
 bool ap_wlan_hal_nl80211::start_platform_acs(
     const std::shared_ptr<airties::cACSChannelList> &acs_list)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return false;
+    // Active ACS channel selection.
+    //
+    // NOTE on gating: the active_acs_chansel_enable decision is made on the BACKHAUL side
+    // (ChannelSelectionTask), which reads AgentDB and only sends ACTION_BACKHAUL_PLATFORM_ACS ->
+    // ACTION_APMANAGER_PLATFORM_ACS -> start_platform_acs() when the flag is set. The ap_manager
+    // runs in a SEPARATE process whose AgentDB/hal_conf copy of the flag is NOT populated, so we
+    // must NOT gate here on get_hal_conf().active_acs_chansel_enable (it would read false and
+    // skip the driver programming). Reaching this function already implies the flag is enabled.
+
+    // The QCA ACS control commands are driven over the hostapd control interface via
+    // wpa_ctrl_send_msg (the standard prplMesh mechanism). They must be sent on the BASE radio
+    // hostapd control socket (e.g. /var/run/hostapd/wlan2), which is what `hostapd_cli -i wlan2
+    // acs ...` targets on-board. They are NOT available on the per-link socket (wlan2_link0).
+    //
+    // hostapd control-interface commands are UPPERCASE: hostapd_cli's `acs <sub>` maps to the raw
+    // control command "ACS <sub>". Sending lowercase "acs ..." over the socket returns
+    // "UNKNOWN COMMAND"; the correct raw command is "ACS <sub>".
+    //
+    // m_radio_info.iface_name is the link iface (e.g. "wlan2_link0"); derive the base iface
+    // ("wlan2") and make sure its wpa_ctrl socket is registered before sending.
+    const std::string link_iface = m_radio_info.iface_name;
+    std::string radio_iface;
+    extractLinkBaseInterface(link_iface, radio_iface);
+    if (radio_iface.empty()) {
+        radio_iface = link_iface;
+    }
+    LOG(INFO) << "[ACTIVE_ACS] start_platform_acs: ENABLED, link_iface=" << link_iface
+              << " -> base radio_iface=" << radio_iface;
+
+    // Ensure the base radio interface wpa_ctrl socket is registered/connected. add_interface() is
+    // idempotent (returns early if already present) and connects the cmd+event sockets so that
+    // wpa_ctrl_send_msg(cmd, radio_iface) reaches /var/run/hostapd/<radio_iface>.
+    if (!is_wpa_ctrl_interface_registered(radio_iface)) {
+        LOG(DEBUG) << "[ACTIVE_ACS] start_platform_acs: base radio iface " << radio_iface
+                   << " not registered yet, registering its wpa_ctrl socket";
+        if (add_interface(radio_iface) < 0) {
+            LOG(WARNING) << "[ACTIVE_ACS] start_platform_acs: add_interface(" << radio_iface
+                         << ") failed; will still attempt to send on it";
+        }
+    }
+
+    if (!acs_list) {
+        LOG(ERROR) << "[ACTIVE_ACS] start_platform_acs: acs_list (cACSChannelList) is null";
+        return false;
+    }
+
+    // Helper: send an ACS control command over the hostapd control socket of the base radio iface
+    // using the standard wpa_ctrl_send_msg mechanism. The subcommand is passed in hostapd_cli
+    // syntax (e.g. "clear_block_chan_list"); we prefix the uppercase "ACS " control verb.
+    auto run_acs_cmd = [&](const std::string &acs_subcmd, std::string &reply_out) -> bool {
+        const std::string cmd = "ACS " + acs_subcmd;
+        char *reply           = nullptr;
+        reply_out.clear();
+        if (!wpa_ctrl_send_msg(cmd, &reply, radio_iface)) {
+            if (reply) {
+                reply_out = reply;
+            }
+            return false;
+        }
+        if (reply) {
+            reply_out = reply;
+        }
+        return true;
+    };
+
+    // (1) Flatten the incoming cACSChannelList (per-opclass exclude_channels) into a de-duplicated,
+    //     ordered flat list of channel numbers to block.
+    std::set<uint8_t> block_set;
+    {
+        std::stringstream ss;
+        const uint8_t n_opclass = acs_list->acs_list_length();
+        ss << "[ACTIVE_ACS] start_platform_acs: received cACSChannelList with "
+           << int(n_opclass) << " op-class entries:" << std::endl;
+        for (uint8_t oc = 0; oc < n_opclass; ++oc) {
+            auto entry_tuple = acs_list->acs_list(oc);
+            if (!std::get<0>(entry_tuple)) {
+                LOG(WARNING) << "[ACTIVE_ACS] start_platform_acs: failed to get acs_list entry "
+                             << int(oc);
+                continue;
+            }
+            auto &entry              = std::get<1>(entry_tuple);
+            const uint8_t opclass    = entry.opclass();
+            const uint8_t n_channels = entry.exclude_channels_length();
+            ss << "  op-class=" << int(opclass) << " exclude_channels(" << int(n_channels)
+               << ")={ ";
+            for (uint8_t ci = 0; ci < n_channels; ++ci) {
+                uint8_t *ch_ptr = entry.exclude_channels(ci);
+                if (!ch_ptr) {
+                    continue;
+                }
+                block_set.insert(*ch_ptr);
+                ss << int(*ch_ptr) << " ";
+            }
+            ss << "}" << std::endl;
+        }
+        LOG(DEBUG) << ss.str();
+    }
+
+    // (2) Flush the existing ACS block list: `ACS clear_block_chan_list`.
+    {
+        const std::string acs_subcmd = "clear_block_chan_list";
+        LOG(INFO) << "[ACTIVE_ACS] start_platform_acs: FLUSH block list on iface=" << radio_iface
+                  << " cmd='ACS " << acs_subcmd << "'";
+        std::string reply;
+        if (!run_acs_cmd(acs_subcmd, reply)) {
+            LOG(ERROR) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << acs_subcmd
+                       << "' failed on iface=" << radio_iface << " reply='" << reply << "'";
+            return false;
+        }
+        LOG(DEBUG) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << acs_subcmd << "' OK reply='"
+                   << reply << "'";
+    }
+
+    // (3) Program the block list: `acs set_block_chan_list <c1> <c2> ...` (only if non-empty).
+    if (block_set.empty()) {
+        LOG(WARNING) << "[ACTIVE_ACS] start_platform_acs: computed block list is EMPTY - nothing to"
+                        " block; ACS will consider all channels. Proceeding to invoke anyway.";
+    } else {
+        std::stringstream cmd_ss;
+        cmd_ss << "set_block_chan_list";
+        for (const auto ch : block_set) {
+            cmd_ss << " " << int(ch);
+        }
+        const std::string acs_subcmd = cmd_ss.str();
+        LOG(INFO) << "[ACTIVE_ACS] start_platform_acs: SET block list (" << block_set.size()
+                  << " channels) on iface=" << radio_iface << " cmd='ACS " << acs_subcmd << "'";
+        std::string reply;
+        if (!run_acs_cmd(acs_subcmd, reply)) {
+            LOG(ERROR) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << acs_subcmd
+                       << "' failed on iface=" << radio_iface << " reply='" << reply << "'";
+            return false;
+        }
+        LOG(DEBUG) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << acs_subcmd << "' OK reply='"
+                   << reply << "'";
+
+        // Optional verification read-back of the block list.
+        {
+            std::string get_reply;
+            const std::string get_subcmd = "get_block_chan_list";
+            if (run_acs_cmd(get_subcmd, get_reply)) {
+                LOG(DEBUG) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << get_subcmd
+                           << "' reply: " << get_reply;
+            } else {
+                LOG(DEBUG) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << get_subcmd
+                           << "' read-back not available (non-fatal) reply='" << get_reply << "'";
+            }
+        }
+    }
+
+    // (4) Trigger the driver ACS (DynamicACS + CSA): `ACS invoke 0`.
+    {
+        const std::string acs_subcmd = "invoke 0";
+        LOG(INFO) << "[ACTIVE_ACS] start_platform_acs: INVOKE ACS on iface=" << radio_iface
+                  << " cmd='ACS " << acs_subcmd << "' (driver will pick a channel from the "
+                     "non-blocked/preferred set and perform CSA)";
+        std::string reply;
+        if (!run_acs_cmd(acs_subcmd, reply)) {
+            LOG(ERROR) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << acs_subcmd
+                       << "' failed on iface=" << radio_iface << " reply='" << reply << "'";
+            return false;
+        }
+        LOG(DEBUG) << "[ACTIVE_ACS] start_platform_acs: 'ACS " << acs_subcmd << "' OK reply='"
+                   << reply << "' - waiting for driver CSA (AP-CSA-FINISHED) to proceed with OCR";
+    }
+
+    LOG(INFO) << "[ACTIVE_ACS] start_platform_acs: completed successfully on iface=" << radio_iface;
+    return true;
 }
 
