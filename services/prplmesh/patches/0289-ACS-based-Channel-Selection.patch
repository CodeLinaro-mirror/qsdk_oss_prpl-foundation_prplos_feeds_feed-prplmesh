diff --git a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
index 163a922..9058762 100644
--- a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
@@ -521,11 +521,30 @@ void ChannelSelectionTask::handle_channel_selection_request(ieee1905_1::CmduMess
         }
 
         if (db->device_conf.enable_auto_chansel_handling) {
-            if (radio_mac == m_acs_list.first) {
-                if (!send_acs_list_to_platform(radio_mac)) {
-                    LOG(ERROR) << "Failed to send ACS list";
-                    return;
+            // [ACTIVE_ACS] : only drive the platform/driver ACS (clear/set block list +
+            // acs invoke 0) when active_acs_chansel_enable is set. The flag is read here on the
+            // backhaul side (AgentDB is valid here). The ap_manager/nl80211 side runs in a
+            // different process where this AgentDB flag is NOT populated, so the decision must be
+            // made here; start_platform_acs() on nl80211 unconditionally drives the driver when
+            // reached.
+            if (db->device_conf.active_acs_chansel_enable) {
+                if (radio_mac == m_acs_list.first) {
+                    LOG(DEBUG) << "[ACTIVE_ACS] active_acs_chansel_enable=1 -> sending platform ACS"
+                                  " (block-list + acs invoke 0) for radio "
+                               << radio_mac;
+                    if (!send_acs_list_to_platform(radio_mac)) {
+                        LOG(ERROR) << "Failed to send ACS list";
+                        return;
+                    }
+                    // Wait for the driver ACS CSA (AP-CSA-FINISHED) before sending the Operating
+                    // Channel Report, reusing the existing CSA-notification flow.
+                    request.chan_sel_state            = eRadioChanSwitchState::ACS_SENT;
+                    m_pending_selection.last_chan_sel = std::chrono::steady_clock::now();
                 }
+            } else {
+                LOG(DEBUG) << "[ACTIVE_ACS] active_acs_chansel_enable=0 -> keeping existing behaviour"
+                              " (platform ACS not driven) for radio "
+                           << radio_mac;
             }
             continue;
         }
@@ -2964,6 +2983,163 @@ bool ChannelSelectionTask::build_acs_list(const sMacAddr &radio_mac,
     m_acs_list.first = radio_mac;
     m_acs_list.second.clear();
 
+    auto db = AgentDB::get();
+    const bool active_acs = db->device_conf.active_acs_chansel_enable;
+
+    // [ACTIVE_ACS] Dump the controller's parsed preference map first so we can correlate what the
+    // Controller sent (per op-class, preference value + channel list) with what build_acs_list
+    // actually collects into the ACS (block/exclude) list.
+    {
+        std::stringstream ss_ctrl;
+        ss_ctrl << "[ACTIVE_ACS] build_acs_list: radio=" << radio_mac
+                << " active_acs_chansel_enable=" << active_acs
+                << " controller_preferences dump (" << radio_request.controller_preferences.size()
+                << " op-class entries):" << std::endl;
+        for (const auto &preference : radio_request.controller_preferences) {
+            ss_ctrl << "  op-class=" << int(preference.first.operating_class)
+                    << " preference=" << int(preference.first.flags.preference)
+                    << " reason=" << int(preference.first.flags.reason_code) << " channels={ ";
+            for (const auto ch : preference.second) {
+                ss_ctrl << int(ch) << " ";
+            }
+            ss_ctrl << "}" << std::endl;
+        }
+        LOG(DEBUG) << ss_ctrl.str();
+    }
+
+    if (active_acs) {
+        // ================= ACTIVE ACS branch =================
+        // Requirement P0.R3: build the ACS (block) list as "all channels of the radio that are
+        // NOT part of the preferred list". Preferred = channels reported by the Controller with
+        // preference != 0 (operable). If a preferred op-class has an empty channel list, expand it
+        // to all channels of that op-class (from the operating_classes_list table).
+
+        // (1) Build the PREFERRED channel set from controller_preferences (preference != 0).
+        std::set<uint8_t> preferred_channels;
+        {
+            std::stringstream ss_pref;
+            ss_pref << "[ACTIVE_ACS] build_acs_list: building PREFERRED set (preference != 0):"
+                    << std::endl;
+            for (const auto &preference : radio_request.controller_preferences) {
+                const auto &operating_class_info          = preference.first;
+                const auto &operating_class_channels_list = preference.second;
+                const auto opclass                        = operating_class_info.operating_class;
+                if (operating_class_info.flags.preference == 0) {
+                    continue; // non-operable -> not preferred
+                }
+                if (operating_class_channels_list.empty()) {
+                    // Empty channel list under an operable op-class means "all channels of the
+                    // op-class are preferred".
+                    auto opclass_it = son::wireless_utils::operating_classes_list.find(opclass);
+                    if (opclass_it == son::wireless_utils::operating_classes_list.end()) {
+                        LOG(WARNING) << "[ACTIVE_ACS] build_acs_list: op-class=" << int(opclass)
+                                     << " (preferred, empty list) not found in operating_classes_list"
+                                     << " - skipping expansion";
+                        continue;
+                    }
+                    ss_pref << "  op-class=" << int(opclass)
+                            << " (pref=" << int(operating_class_info.flags.preference)
+                            << ", EMPTY list) -> add ALL op-class channels: { ";
+                    for (const auto ch : opclass_it->second.channels) {
+                        preferred_channels.insert(ch);
+                        ss_pref << int(ch) << " ";
+                    }
+                    ss_pref << "}" << std::endl;
+                } else {
+                    ss_pref << "  op-class=" << int(opclass)
+                            << " (pref=" << int(operating_class_info.flags.preference)
+                            << ") -> add channels: { ";
+                    for (const auto ch : operating_class_channels_list) {
+                        preferred_channels.insert(ch);
+                        ss_pref << int(ch) << " ";
+                    }
+                    ss_pref << "}" << std::endl;
+                }
+            }
+            LOG(DEBUG) << ss_pref.str();
+        }
+
+        // Log the preferred set summary + count (answers requirement R3.a: how many preferred).
+        {
+            std::stringstream ss;
+            ss << "[ACTIVE_ACS] build_acs_list: PREFERRED channel set (count="
+               << preferred_channels.size() << "): { ";
+            for (const auto ch : preferred_channels) {
+                ss << int(ch) << " ";
+            }
+            ss << "}";
+            LOG(DEBUG) << ss.str();
+        }
+
+        // (2) Enumerate ALL channels available on the radio (radio->channels_list).
+        {
+            std::stringstream ss_all;
+            ss_all << "[ACTIVE_ACS] build_acs_list: ALL radio channels available (count="
+                   << radio->channels_list.size() << "): { ";
+            for (const auto &ch_it : radio->channels_list) {
+                ss_all << int(ch_it.first) << " ";
+            }
+            ss_all << "}";
+            LOG(DEBUG) << ss_all.str();
+        }
+
+        // (3) Compute BLOCK set = all radio channels that are NOT in the preferred set, and put
+        // them into m_acs_list keyed by each channel's 20MHz operating class (so the existing
+        // send_acs_list_to_platform packing still works, and the nl80211 HAL can flatten it).
+        auto freq_type = radio->wifi_channel.get_freq_type();
+        if (radio->wifi_channel.is_empty()) {
+            LOG(WARNING) << "[ACTIVE_ACS] build_acs_list: radio wifi_channel is empty, assuming 5G"
+                            " for op-class derivation";
+            freq_type = beerocks::eFreqType::FREQ_5G;
+        }
+
+        std::set<uint8_t> block_channels; // for logging summary
+        for (const auto &ch_it : radio->channels_list) {
+            const auto channel = ch_it.first;
+            if (preferred_channels.find(channel) != preferred_channels.end()) {
+                // This channel is preferred -> do NOT block it.
+                continue;
+            }
+            // Derive the 20MHz operating class for this channel.
+            auto opclass = son::wireless_utils::get_operating_class_by_channel(
+                beerocks::WifiChannel(channel, freq_type, beerocks::eWiFiBandwidth::BANDWIDTH_20));
+            if (opclass == 0) {
+                LOG(WARNING) << "[ACTIVE_ACS] build_acs_list: could not derive op-class for channel="
+                             << int(channel) << " freq_type="
+                             << beerocks::utils::convert_frequency_type_to_string(freq_type)
+                             << " - blocking under op-class 0";
+            }
+            m_acs_list.second[opclass].push_back(channel);
+            block_channels.insert(channel);
+        }
+
+        // (4) Exhaustive result print of the computed block (exclude) list.
+        {
+            std::stringstream ss_blk;
+            ss_blk << "[ACTIVE_ACS] build_acs_list: RESULT BLOCK list = (all radio channels - "
+                      "preferred) for radio=" << m_acs_list.first << " ("
+                   << m_acs_list.second.size() << " op-class entries, "
+                   << block_channels.size() << " total channels to block):" << std::endl;
+            for (const auto &entry : m_acs_list.second) {
+                ss_blk << "  op-class=" << int(entry.first) << " block_channels={ ";
+                for (const auto ch : entry.second) {
+                    ss_blk << int(ch) << " ";
+                }
+                ss_blk << "}" << std::endl;
+            }
+            std::stringstream ss_flat;
+            ss_flat << "  flat block channel list: { ";
+            for (const auto ch : block_channels) {
+                ss_flat << int(ch) << " ";
+            }
+            ss_flat << "}";
+            LOG(DEBUG) << ss_blk.str() << ss_flat.str();
+        }
+
+        return true;
+    }
+
+    // ================= Existing (non-active-acs) exclude-list logic =================
     for (const auto &preference : radio_request.controller_preferences) {
         const auto &operating_class_info          = preference.first;
         const auto &operating_class_channels_list = preference.second;
@@ -2977,12 +3153,47 @@ bool ChannelSelectionTask::build_acs_list(const sMacAddr &radio_mac,
                 }
                 std::copy(opclass_it->second.channels.begin(), opclass_it->second.channels.end(),
                           std::back_inserter(m_acs_list.second[opclass]));
+                // [ACTIVE_ACS]
+                LOG(DEBUG) << "[ACTIVE_ACS] build_acs_list: op-class=" << int(opclass)
+                           << " has preference=0 with EMPTY channel list -> excluding ALL "
+                           << opclass_it->second.channels.size()
+                           << " channels of this op-class";
             } else {
                 std::copy(operating_class_channels_list.begin(),
                           operating_class_channels_list.end(),
                           std::back_inserter(m_acs_list.second[opclass]));
+                // [ACTIVE_ACS]
+                LOG(DEBUG) << "[ACTIVE_ACS] build_acs_list: op-class=" << int(opclass)
+                           << " has preference=0 with " << operating_class_channels_list.size()
+                           << " explicit channel(s) -> excluding those channels";
+            }
+        } else {
+            // [ACTIVE_ACS] Controller-operable (preferred) op-class: NOT added to the ACS exclude
+            // list in the default (non-active-acs) flow.
+            LOG(DEBUG) << "[ACTIVE_ACS] build_acs_list: op-class=" << int(opclass)
+                       << " has preference=" << int(operating_class_info.flags.preference)
+                       << " (operable/preferred) -> NOT added to ACS exclude list ("
+                       << operating_class_channels_list.size() << " channel(s))";
+        }
+    }
+
+    // [ACTIVE_ACS] Final ACS (exclude) list that will be sent to the platform/driver.
+    {
+        std::stringstream ss_acs;
+        ss_acs << "[ACTIVE_ACS] build_acs_list: RESULT m_acs_list (exclude list) for radio="
+               << m_acs_list.first << " (" << m_acs_list.second.size() << " op-class entries):"
+               << std::endl;
+        size_t total_excluded = 0;
+        for (const auto &entry : m_acs_list.second) {
+            ss_acs << "  op-class=" << int(entry.first) << " exclude_channels={ ";
+            for (const auto ch : entry.second) {
+                ss_acs << int(ch) << " ";
+                ++total_excluded;
             }
+            ss_acs << "}" << std::endl;
         }
+        ss_acs << "  total_excluded_channels=" << total_excluded;
+        LOG(DEBUG) << ss_acs.str();
     }
 
     return true;
