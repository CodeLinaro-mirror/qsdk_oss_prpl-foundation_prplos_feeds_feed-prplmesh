From b76ccbcba768ce251ac9025c4f8903a9346b2a04 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Fri, 11 Sep 2026 10:17:22 +0530
Subject: [PATCH] Fix for Reboot scenario

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 controller/src/beerocks/master/controller.cpp | 34 ++++++++++++++++---
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     |  2 +-
 2 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index ab075fd..222b504 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -2603,11 +2603,35 @@ bool Controller::handle_cmdu_1905_autoconfiguration_WSC(const sMacAddr &src_mac,
             return false;
         }
 
-        if (agent->bSTA_reconfiguration_supported && bss_info_conf.backhaul &&
-            !autoconfig_wsc_add_m8(*m1, bss_info_conf)) {
-            database.clear_configured_bss_info(ruid);
-            LOG(ERROR) << "Failed setting M8 attributes";
-            return false;
+        if (agent->bSTA_reconfiguration_supported && bss_info_conf.backhaul) {
+            // The Agent's backhaul-STA (M8 credential consumer) has no RSN-Override
+            // consumption path, unlike the fronthaul-BSS (M2) consumer which may rely on
+            // the RSN Parameters Configuration TLV when rsn_overriding_supported. Always
+            // downgrade the bSTA's WSC Auth Type to the spec-canonical WPA3 Transition
+            // Mode / plain-AKM bitmask (which includes SAE-EXT-KEY / AKM24 when the BSS is
+            // MRSNO), regardless of the Agent's RSN-Overriding capability — otherwise the
+            // joining Agent silently fails to negotiate SAE-EXT-KEY on its backhaul STA link.
+            const WSC::eWscAuth m8_pcm_downgrade =
+                wpa3_pcm_downgrade_auth_type(bss_info_conf, radio->band);
+            if (m8_pcm_downgrade != WSC::eWscAuth::WSC_AUTH_INVALID) {
+                bss_info_conf.authentication_type = m8_pcm_downgrade;
+                bss_info_conf.additional_auth = son::wireless_utils::eAdditionalAuth::NONE;
+                bss_info_conf.security_ies.clear();
+            } else if (bss_info_conf.authentication_type == WSC::eWscAuth::WSC_AUTH_RSN) {
+                bss_info_conf.authentication_type =
+                    (radio->band == beerocks::FREQ_6G) ? rsn_fallback_security_mode_6_g
+                                                        : rsn_fallback_security_mode_24_5_g;
+            }
+
+            LOG(DEBUG) << "M8 auth_type=" << std::hex
+                       << uint16_t(bss_info_conf.authentication_type) << std::dec
+                       << " ssid=" << bss_info_conf.ssid;
+
+            if (!autoconfig_wsc_add_m8(*m1, bss_info_conf)) {
+                database.clear_configured_bss_info(ruid);
+                LOG(ERROR) << "Failed setting M8 attributes";
+                return false;
+            }
         }
 
         // Emit the RSN Parameters Configuration TLV whenever the BSS carries MRSNO /
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index aebba97..f948cf7 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -2948,7 +2948,7 @@ static std::string get_encryption_string(WSC::eWscAuth authentication_type,
     if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK |
                                 WSC::eWscAuth::WSC_AUTH_SAE |
                                 WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
-        encryption = "sae-mixed";
+        encryption = "akm24-sae-mixed";
     } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE |
                                        WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
         encryption = "sae-sae_ext_key";
-- 
