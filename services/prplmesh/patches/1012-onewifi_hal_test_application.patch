+/* =========================================================================
+ * main
+ * ========================================================================= */
+int main(int argc, char *argv[])
+{
+    printf("=== OneWifi HAL DML / Radio-Cap test ===\n\n");
+
+    std::string json_buf;
+    const char *json_str = nullptr;
+
+    if (argc >= 2) {
+        /* Mode 1: explicit JSON file */
+        std::ifstream f(argv[1]);
+        if (!f.is_open()) {
+            fprintf(stderr, "ERROR: cannot open '%s'\n", argv[1]);
+            return 1;
+        }
+        std::ostringstream ss;
+        ss << f.rdbuf();
+        json_buf = ss.str();
+        json_str = json_buf.c_str();
+        printf("[INFO] source: file '%s'  (%zu bytes)\n\n", argv[1], json_buf.size());
+    } else {
+        /* Mode 2: live bus */
+        printf("[INFO] Fetching DML from live bus (%s)...\n", WIFI_WEBCONFIG_INIT_DML_DATA);
+        if (!fetch_dml_from_bus(json_buf)) {
+            fprintf(stderr, "ERROR: bus fetch failed – run with a JSON file argument "
+                    "or ensure OneWifi is running\n");
+            return 1;
+        }
+        json_str = json_buf.c_str();
+        printf("[INFO] source: live bus  (%zu bytes)\n\n", json_buf.size());
+    }
+
+    onewifi_data_model_t *dm = new onewifi_data_model_t();
+    int fail = 0;
+
+    if (!test_init(*dm))                       fail++;
+    if (!test_radio_cap_decode(*dm, json_str)) fail++;
+
+    delete dm;
+
+    printf("\n=== %s  (%d / 2 passed) ===\n",
+           fail == 0 ? "ALL TESTS PASSED" : "SOME TESTS FAILED",
+           2 - fail);
+
+    return fail == 0 ? 0 : 1;
+}
