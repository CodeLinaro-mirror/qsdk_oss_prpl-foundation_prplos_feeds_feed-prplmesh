+++ b/common/beerocks/bwl/onewifi/tests/CMakeLists.txt
@@ -0,0 +1,107 @@
+# Standalone CMake project for OneWifi HAL tests.
+# Invoked directly by pull_build_rdk.sh --no-build-agent --build-onewifi-hal-test
+# so it must resolve all include / link paths on its own without the full
+# qmesh_agent tree.
+#
+# Required CMake inputs (passed via -D or environment):
+#   ONEWIFI_SRC_DIR   — path to ccsp-one-wifi recipe source
+#   SYSROOT_DIR       — cross-compilation sysroot (STAGING_DIR)
+#   CMAKE_INSTALL_PREFIX
+#   CMAKE_TOOLCHAIN_FILE
+
+cmake_minimum_required(VERSION 3.10)
+project(onewifi_hal_tests CXX C)
+
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(CJSON REQUIRED libcjson)
+
+# ── Locate OneWifi source tree ───────────────────────────────────────────────
+if(NOT DEFINED ONEWIFI_SRC_DIR AND DEFINED ENV{ONEWIFI_SRC_DIR})
+    set(ONEWIFI_SRC_DIR "$ENV{ONEWIFI_SRC_DIR}")
+endif()
+if(NOT DEFINED ONEWIFI_SRC_DIR)
+    message(FATAL_ERROR "ONEWIFI_SRC_DIR must be set")
+endif()
+
+if(EXISTS "${ONEWIFI_SRC_DIR}/include/webconfig_external_proto_easymesh.h")
+    set(OW_SRC "${ONEWIFI_SRC_DIR}")
+elseif(EXISTS "${ONEWIFI_SRC_DIR}/git/include/webconfig_external_proto_easymesh.h")
+    set(OW_SRC "${ONEWIFI_SRC_DIR}/git")
+else()
+    message(FATAL_ERROR "webconfig_external_proto_easymesh.h not found under ${ONEWIFI_SRC_DIR}")
+endif()
+
+# Sysroot for CCSP/rbus headers (may come from env via toolchain file)
+if(NOT DEFINED SYSROOT_DIR AND DEFINED ENV{SYSROOT_DIR})
+    set(SYSROOT_DIR "$ENV{SYSROOT_DIR}")
+endif()
+if(NOT DEFINED SYSROOT_DIR)
+    set(SYSROOT_DIR "${CMAKE_SYSROOT}")
+endif()
+
+# ── dml_test ─────────────────────────────────────────────────────────────────
+add_executable(dml_test dml_test.cpp)
+
+target_compile_definitions(dml_test PRIVATE EM_APP EASY_MESH_NODE)
+
+# Include order: OneWifi source first (correct bus_common.h), sysroot last
+target_include_directories(dml_test PRIVATE
+    # onewifi_data_model.h lives one level up (the onewifi/ HAL directory)
+    "${CMAKE_CURRENT_SOURCE_DIR}/.."
+    # OneWifi public headers
+    "${OW_SRC}/include"
+    "${OW_SRC}/source/utils"
+    # bus_common.h with bus_data_prop_t (must come before sysroot)
+    "${OW_SRC}/source/platform/common"
+    "${OW_SRC}/source/platform/common/data_model"
+    "${OW_SRC}/source/platform/rdkb"
+    "${OW_SRC}/source/webconfig"
+    # unified-wifi-mesh headers (em_base.h)
+    "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include"
+    "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include/ccsp"
+    # cJSON
+    ${CJSON_INCLUDE_DIRS}
+    # CCSP / rbus from cross sysroot (after OneWifi so correct bus_common.h wins)
+    "${SYSROOT_DIR}/usr/include"
+    "${SYSROOT_DIR}/usr/include/ccsp"
+    "${SYSROOT_DIR}/usr/include/rbus"
+)
+
+target_link_libraries(dml_test PRIVATE
+    wifi_webconfig
+    wifi_bus
+    rbus
+    ${CJSON_LIBRARIES}
+)
+
+install(TARGETS dml_test DESTINATION tests)
+
+# ── channel_scan_test ─────────────────────────────────────────────────────────
+add_executable(channel_scan_test channel_scan_test.cpp)
+
+target_compile_definitions(channel_scan_test PRIVATE EM_APP EASY_MESH_NODE)
+
+target_include_directories(channel_scan_test PRIVATE
+    "${CMAKE_CURRENT_SOURCE_DIR}/.."
+    "${OW_SRC}/include"
+    "${OW_SRC}/source/utils"
+    "${OW_SRC}/source/platform/common"
+    "${OW_SRC}/source/platform/common/data_model"
+    "${OW_SRC}/source/platform/rdkb"
+    "${OW_SRC}/source/webconfig"
+    "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include"
+    "${ONEWIFI_SRC_DIR}/recipe-sysroot/usr/include/ccsp"
+    ${CJSON_INCLUDE_DIRS}
+    "${SYSROOT_DIR}/usr/include"
+    "${SYSROOT_DIR}/usr/include/ccsp"
+    "${SYSROOT_DIR}/usr/include/rbus"
+)
+
+target_link_libraries(channel_scan_test PRIVATE
+    wifi_webconfig
+    wifi_bus
+    rbus
+    ${CJSON_LIBRARIES}
+)
+
+install(TARGETS channel_scan_test DESTINATION tests)
diff --git a/common/beerocks/bwl/onewifi/tests/channel_scan_test.cpp b/common/beerocks/bwl/onewifi/tests/channel_scan_test.cpp
new file mode 100644
index 000000000..5de2c8f96
--- /dev/null
+++ b/common/beerocks/bwl/onewifi/tests/channel_scan_test.cpp
@@ -0,0 +1,636 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ *
+ * Standalone test binary for OneWifi HAL channel-scan data decode.
+ *
+ * The channel scan report arrives as a bus EVENT on:
+ *   Device.WiFi.EM.ChannelScanReport
+ *
+ * A scan can be triggered by writing a channel_scan_request_t to:
+ *   Device.WiFi.EM.ChannelScanRequest
+ *
+ * Usage:
+ *   channel_scan_test
+ *       Subscribe and wait (scan triggered externally)
+ *
+ *   channel_scan_test <ruid>
+ *       Fresh full-scan on all channels for that radio RUID
+ *       e.g.  channel_scan_test aa:bb:cc:dd:ee:ff
+ *
+ *   channel_scan_test <ruid> --2g|--5g|--6g
+ *       Band scan using the correct op-class set with num_channels=0 (recommended).
+ *       Mirrors the working mon_wlan_hal_onewifi::channel_scan_trigger() HAL path.
+ *       SELECT_CHANNELS mode (triggered by num_channels>0) is broken in OneWifi's
+ *       wifi_stats_radio_channel.c::process_neighbor_stats() — results are always NULL.
+ *       e.g.  channel_scan_test aa:bb:cc:dd:ee:ff --5g
+ *
+ *   channel_scan_test <ruid> <op_class>:<ch>[,<ch>...] [<op_class>:<ch>[,<ch>...] ...]
+ *       Targeted scan: one or more op-class/channel specs
+ *       e.g.  channel_scan_test aa:bb:cc:dd:ee:ff 81:1,6,11 115:36,40
+ *             channel_scan_test aa:bb:cc:dd:ee:ff 131:5
+ *
+ *   channel_scan_test <ruid> <op_class> [<op_class> ...]
+ *       Scan all channels in specified op-class(es) (num_channels=0 → full op-class)
+ *       e.g.  channel_scan_test aa:bb:cc:dd:ee:ff 115
+ *             channel_scan_test aa:bb:cc:dd:ee:ff 115 116
+ *
+ *   channel_scan_test /path/to/scan.json
+ *       Decode a captured JSON file (no bus required)
+ *
+ * Tests exercised:
+ *   1. webconfig_proto_easymesh_init + webconfig_init
+ *   2. decode channel-scan JSON → print all em_scan_result_t fields
+ *
+ * Build:
+ *   Part of the standalone onewifi_hal_tests cmake project.
+ *   Binary installed to <install_dir>/tests/channel_scan_test
+ */
+
+#ifndef EM_APP
+#define EM_APP
+#endif
+#ifndef EASY_MESH_NODE
+#define EASY_MESH_NODE
+#endif
+
+#include "onewifi_data_model.h"
+
+extern "C" {
+#include "wifi_webconfig.h"
+#include "webconfig_external_proto_easymesh.h"
+#include "webconfig_external_proto.h"
+
+/* Not exported from public header but present in libwifi_webconfig */
+webconfig_error_t webconfig_easymesh_decode(webconfig_t *config, const char *str,
+                                            webconfig_external_easymesh_t *data,
+                                            webconfig_subdoc_type_t *type);
+
+/* Bus API (provided by libwifi_bus via get_bus_descriptor()) */
+#include "bus_common.h"
+#include <ccsp/bus.h>
+wifi_bus_desc_t *get_bus_descriptor(void);
+bus_error_t bus_init(bus_handle_t *handle);
+}
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+using namespace bwl::onewifi;
+
+#ifndef ONEWIFI_EM_CHANNEL_SCAN_REPORT
+#define ONEWIFI_EM_CHANNEL_SCAN_REPORT  "Device.WiFi.EM.ChannelScanReport"
+#endif
+#ifndef WIFI_EM_CHANNEL_SCAN_REQUEST
+#define WIFI_EM_CHANNEL_SCAN_REQUEST    "Device.WiFi.EM.ChannelScanRequest"
+#endif
+
+/* How long to wait for a scan report event (seconds) */
+static constexpr int WAIT_SECS = 120;
+
+/* =========================================================================
+ * Shared state for the bus event callback
+ * ========================================================================= */
+static std::atomic<bool> g_event_received{false};
+static std::string       g_event_json;
+
+static bus_error_t channel_scan_event_cb(char * /*event_name*/,
+                                         bus_data_prop_t *prop,
+                                         void * /*user_data*/)
+{
+    if (!prop || !prop->value.raw_data.bytes || prop->value.raw_data_len == 0)
+        return bus_error_success;
+
+    g_event_json.assign(reinterpret_cast<const char *>(prop->value.raw_data.bytes),
+                        prop->value.raw_data_len);
+    g_event_received.store(true);
+    return bus_error_success;
+}
+
+/* =========================================================================
+ * Parse helpers
+ * ========================================================================= */
+static bool parse_mac(const char *str, unsigned char mac[6])
+{
+    unsigned int b[6];
+    if (sscanf(str, "%02x:%02x:%02x:%02x:%02x:%02x",
+               &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+        return false;
+    for (int i = 0; i < 6; i++) mac[i] = static_cast<unsigned char>(b[i]);
+    return true;
+}
+
+static bool is_mac_string(const char *s)
+{
+    unsigned char tmp[6];
+    return parse_mac(s, tmp);
+}
+
+/* Parse "op_class:ch1,ch2,..." into operating_class_t.
+ * Colon is optional: bare "115" or "115:" means all channels in that op-class.
+ * Returns true on success. */
+static bool parse_op_class_spec(const char *spec, operating_class_t *oc)
+{
+    memset(oc, 0, sizeof(*oc));
+
+    /* Locate optional colon; if absent, treat as "op_class with no channel filter" */
+    const char *colon = strchr(spec, ':');
+    const char *ch_start = colon ? colon + 1 : "";
+
+    oc->operating_class = static_cast<UCHAR>(atoi(spec));
+    if (oc->operating_class == 0) {
+        fprintf(stderr, "ERROR: invalid op_class in '%s'\n", spec);
+        return false;
+    }
+
+    /* Parse comma-separated channels. Empty list means all channels in this op-class. */
+    const char *p = ch_start;
+    while (*p) {
+        if (oc->num_channels >= EM_MAX_CHANNELS) {
+            fprintf(stderr, "WARNING: too many channels in '%s', truncating at %d\n",
+                    spec, EM_MAX_CHANNELS);
+            break;
+        }
+        char *end;
+        unsigned long ch = strtoul(p, &end, 10);
+        if (end == p) {
+            fprintf(stderr, "ERROR: invalid channel number in '%s'\n", spec);
+            return false;
+        }
+        oc->channels[oc->num_channels++] = static_cast<UCHAR>(ch);
+        p = end;
+        if (*p == ',') p++;
+    }
+
+    /* num_channels == 0 means "all channels in this op-class" */
+    return true;
+}
+
+/* =========================================================================
+ * Send a channel-scan request to OneWifi.
+ * op_classes / num_op_classes: targeted scan (0 = full scan on all channels).
+ * ========================================================================= */
+static bool send_scan_request(bus_handle_t *handle,
+                               const unsigned char ruid[6],
+                               const operating_class_t *op_classes,
+                               unsigned int num_op_classes)
+{
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (!desc || !desc->bus_set_fn) {
+        printf("[SCAN_REQ] bus_set_fn not available\n");
+        return false;
+    }
+
+    channel_scan_request_t req;
+    memset(&req, 0, sizeof(req));
+    req.perform_fresh_scan = TRUE;
+    req.num_radios         = 1;
+    memcpy(req.ruid, ruid, sizeof(mac_address_t));
+
+    if (num_op_classes > EM_MAX_OPERATING_CLASS)
+        num_op_classes = EM_MAX_OPERATING_CLASS;
+
+    req.num_operating_classes = static_cast<UINT>(num_op_classes);
+    for (unsigned int i = 0; i < num_op_classes; i++)
+        req.operating_classes[i] = op_classes[i];
+
+    raw_data_t data = {};
+    data.data_type      = bus_data_type_bytes;
+    data.raw_data.bytes = static_cast<void *>(&req);
+    data.raw_data_len   = sizeof(req);
+
+    bus_error_t rc = desc->bus_set_fn(handle, WIFI_EM_CHANNEL_SCAN_REQUEST, &data);
+    if (rc != bus_error_success) {
+        printf("[SCAN_REQ] bus_set_fn('%s') failed (rc=%d)\n",
+               WIFI_EM_CHANNEL_SCAN_REQUEST, static_cast<int>(rc));
+        return false;
+    }
+
+    printf("[SCAN_REQ] ruid=%02x:%02x:%02x:%02x:%02x:%02x  perform_fresh_scan=1"
+           "  num_op_classes=%u",
+           ruid[0], ruid[1], ruid[2], ruid[3], ruid[4], ruid[5],
+           num_op_classes);
+    if (num_op_classes == 0) {
+        printf("  (full scan – all channels)\n");
+    } else {
+        printf("\n");
+        for (unsigned int i = 0; i < num_op_classes; i++) {
+            printf("[SCAN_REQ]   op_class=%u  channels=", op_classes[i].operating_class);
+            for (unsigned int j = 0; j < op_classes[i].num_channels; j++)
+                printf("%u%s", op_classes[i].channels[j],
+                       j + 1 < op_classes[i].num_channels ? "," : "");
+            printf("\n");
+        }
+    }
+
+    return true;
+}
+
+/* =========================================================================
+ * Open bus, optionally send scan request, subscribe to report event,
+ * wait, unsubscribe.
+ * ========================================================================= */
+static bool fetch_scan_from_bus(std::string &json_out,
+                                 const unsigned char *ruid,
+                                 const operating_class_t *op_classes,
+                                 unsigned int num_op_classes)
+{
+    bus_handle_t handle = {};
+    if (bus_init(&handle) != bus_error_success) {
+        printf("[BUS] bus_init() failed\n");
+        return false;
+    }
+
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (!desc) {
+        printf("[BUS] get_bus_descriptor() returned NULL\n");
+        return false;
+    }
+    if (!desc->bus_open_fn || !desc->bus_event_subs_fn || !desc->bus_event_unsubs_fn) {
+        printf("[BUS] required bus function pointers are NULL\n");
+        if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    bus_error_t open_rc = desc->bus_open_fn(&handle,
+                                             const_cast<char *>("prplmesh-scan-test"));
+    if (open_rc != bus_error_success &&
+        open_rc != bus_error_session_already_exist &&
+        open_rc != bus_error_component_name_duplicate) {
+        printf("[BUS] bus_open_fn failed (rc=%d)\n", static_cast<int>(open_rc));
+        if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    g_event_received.store(false);
+
+    /* Subscribe before sending request to avoid missing the event */
+    bus_error_t sub_rc = desc->bus_event_subs_fn(
+        &handle, ONEWIFI_EM_CHANNEL_SCAN_REPORT,
+        reinterpret_cast<void *>(channel_scan_event_cb),
+        nullptr, 0);
+    if (sub_rc != bus_error_success) {
+        printf("[BUS] bus_event_subs_fn('%s') failed (rc=%d)\n",
+               ONEWIFI_EM_CHANNEL_SCAN_REPORT, static_cast<int>(sub_rc));
+        if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+        return false;
+    }
+    printf("[BUS] Subscribed to '%s'\n", ONEWIFI_EM_CHANNEL_SCAN_REPORT);
+
+    if (ruid) {
+        if (!send_scan_request(&handle, ruid, op_classes, num_op_classes))
+            printf("[BUS] Warning: scan request failed; waiting anyway\n");
+    }
+
+    printf("[BUS] Waiting up to %d seconds for scan report...\n", WAIT_SECS);
+    for (int i = 0; i < WAIT_SECS; i++) {
+        if (g_event_received.load()) break;
+        sleep(1);
+        if (i % 10 == 9)
+            printf("[BUS]   ... %d/%d s elapsed\n", i + 1, WAIT_SECS);
+    }
+
+    desc->bus_event_unsubs_fn(&handle, ONEWIFI_EM_CHANNEL_SCAN_REPORT);
+
+    if (!g_event_received.load()) {
+        printf("[BUS] Timed out waiting for '%s'\n", ONEWIFI_EM_CHANNEL_SCAN_REPORT);
+        if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    json_out = g_event_json;
+    if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+    printf("[BUS] Received %zu bytes\n", json_out.size());
+    return true;
+}
+
+/* =========================================================================
+ * webconfig helpers
+ * ========================================================================= */
+static webconfig_error_t dummy_apply(webconfig_subdoc_t *, webconfig_subdoc_data_t *)
+{
+    return webconfig_error_none;
+}
+
+static bool setup_webconfig(onewifi_data_model_t &dm,
+                             webconfig_external_easymesh_t &ext_data,
+                             webconfig_t *config)
+{
+    memset(&ext_data, 0, sizeof(ext_data));
+    memset(config,    0, sizeof(*config));
+
+    webconfig_proto_easymesh_init(&ext_data,
+                                  &dm,
+                                  nullptr,
+                                  nullptr,
+                                  onewifi_data_model_t::get_num_radios,
+                                  onewifi_data_model_t::set_num_radios,
+                                  onewifi_data_model_t::get_num_op_class,
+                                  onewifi_data_model_t::set_num_op_class,
+                                  onewifi_data_model_t::get_num_bss,
+                                  onewifi_data_model_t::set_num_bss,
+                                  onewifi_data_model_t::get_device_info,
+                                  onewifi_data_model_t::get_network_info,
+                                  onewifi_data_model_t::get_radio_info,
+                                  onewifi_data_model_t::get_ieee_1905_security_info,
+                                  onewifi_data_model_t::get_bss_info,
+                                  onewifi_data_model_t::get_op_class_info,
+                                  onewifi_data_model_t::get_first_sta_info,
+                                  onewifi_data_model_t::get_next_sta_info,
+                                  onewifi_data_model_t::get_sta_info,
+                                  onewifi_data_model_t::put_sta_info,
+                                  onewifi_data_model_t::get_bss_info_with_mac,
+                                  onewifi_data_model_t::put_scan_results,
+                                  onewifi_data_model_t::update_ap_mld_info,
+                                  onewifi_data_model_t::update_bsta_mld_info,
+                                  onewifi_data_model_t::update_assoc_sta_mld_info,
+                                  onewifi_data_model_t::get_ap_mld_frm_bssid,
+                                  onewifi_data_model_t::get_radio_cap_info);
+
+    config->initializer = webconfig_initializer_onewifi;
+    config->apply_data  = dummy_apply;
+
+    return (webconfig_init(config) == webconfig_error_none);
+}
+
+/* =========================================================================
+ * Test 1 – init
+ * ========================================================================= */
+static bool test_init(onewifi_data_model_t &dm)
+{
+    printf("[TEST 1] webconfig_proto_easymesh_init + webconfig_init ... ");
+    webconfig_external_easymesh_t *ext_data = new webconfig_external_easymesh_t();
+    webconfig_t *config = new webconfig_t();
+    bool ok = setup_webconfig(dm, *ext_data, config);
+    delete ext_data;
+    delete config;
+    printf("%s\n", ok ? "PASS" : "FAIL");
+    return ok;
+}
+
+/* =========================================================================
+ * Bandwidth enum → string
+ * ========================================================================= */
+static const char *bw_str(wifi_channelBandwidth_t bw)
+{
+    switch (bw) {
+    case WIFI_CHANNELBANDWIDTH_20MHZ:  return "20MHz";
+    case WIFI_CHANNELBANDWIDTH_40MHZ:  return "40MHz";
+    case WIFI_CHANNELBANDWIDTH_80MHZ:  return "80MHz";
+    case WIFI_CHANNELBANDWIDTH_160MHZ: return "160MHz";
+    default:                           return "unknown";
+    }
+}
+
+/* =========================================================================
+ * Test 2 – channel-scan decode: print all em_scan_result_t fields
+ * ========================================================================= */
+static bool test_scan_decode(onewifi_data_model_t &dm, const char *json_str)
+{
+    printf("[TEST 2] Channel-scan decode ... ");
+
+    webconfig_external_easymesh_t *ext_data = new webconfig_external_easymesh_t();
+    webconfig_t *config = new webconfig_t();
+
+    if (!setup_webconfig(dm, *ext_data, config)) {
+        printf("FAIL  (webconfig_init)\n");
+        delete ext_data; delete config;
+        return false;
+    }
+
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_em_channel_stats;
+    webconfig_error_t rc = webconfig_easymesh_decode(config, json_str, ext_data, &type);
+    delete ext_data;
+    delete config;
+
+    if (rc != webconfig_error_none) {
+        printf("FAIL  (webconfig_easymesh_decode rc=%d)\n", static_cast<int>(rc));
+        return false;
+    }
+
+    size_t n = dm.get_num_scan_results();
+    printf("PASS  (type=%d  num_scan_results=%zu)\n", static_cast<int>(type), n);
+
+    for (size_t r = 0; r < n; r++) {
+        em_scan_result_t *s = dm.get_scan_result(r);
+        if (!s) { printf("  scan[%zu]: NULL\n", r); continue; }
+
+        printf("  scan[%zu]:\n", r);
+        printf("    id.net_id        = %s\n",    s->id.net_id);
+        printf("    id.dev_mac       = %02x:%02x:%02x:%02x:%02x:%02x\n",
+               s->id.dev_mac[0], s->id.dev_mac[1], s->id.dev_mac[2],
+               s->id.dev_mac[3], s->id.dev_mac[4], s->id.dev_mac[5]);
+        printf("    id.scanner_mac   = %02x:%02x:%02x:%02x:%02x:%02x\n",
+               s->id.scanner_mac[0], s->id.scanner_mac[1], s->id.scanner_mac[2],
+               s->id.scanner_mac[3], s->id.scanner_mac[4], s->id.scanner_mac[5]);
+        printf("    id.op_class      = %u\n",    s->id.op_class);
+        printf("    id.channel       = %u\n",    s->id.channel);
+        printf("    id.scanner_type  = %d\n",    static_cast<int>(s->id.scanner_type));
+        printf("    scan_status      = %u\n",    s->scan_status);
+        printf("    timestamp        = %s\n",    s->timestamp);
+        printf("    util             = %u\n",    s->util);
+        printf("    noise            = %d dBm\n",static_cast<int>(static_cast<signed char>(s->noise)));
+        printf("    aggr_scan_dur    = %u ms\n", s->aggr_scan_duration);
+        printf("    scan_type        = %u\n",    s->scan_type);
+        printf("    num_neighbors    = %u\n",    s->num_neighbors);
+
+        int nn = (s->num_neighbors < EM_MAX_NEIGHBORS)
+                     ? static_cast<int>(s->num_neighbors) : EM_MAX_NEIGHBORS;
+        for (int nb = 0; nb < nn; nb++) {
+            const em_neighbor_t &nb_e = s->neighbor[nb];
+            printf("    neighbor[%d]:\n", nb);
+            printf("      bssid            = %02x:%02x:%02x:%02x:%02x:%02x\n",
+                   nb_e.bssid[0], nb_e.bssid[1], nb_e.bssid[2],
+                   nb_e.bssid[3], nb_e.bssid[4], nb_e.bssid[5]);
+            printf("      ssid             = %s\n",    nb_e.ssid);
+            printf("      signal_strength  = %d dBm\n",static_cast<int>(nb_e.signal_strength));
+            printf("      bandwidth        = %s\n",    bw_str(nb_e.bandwidth));
+            printf("      bss_color        = %u\n",    nb_e.bss_color);
+            printf("      channel_util     = %u\n",    nb_e.channel_util);
+            printf("      sta_count        = %u\n",    nb_e.sta_count);
+            printf("      bss_load_present = %u\n",    nb_e.bss_load_element_present);
+        }
+    }
+
+    return true;
+}
+
+/* Band shortcut → operating class list (num_channels=0 = full op-class scan).
+ * Mirrors mon_wlan_hal_onewifi::channel_scan_trigger() band→op_class mapping.
+ * num_channels=0 forces OneWifi into FULL scan mode; SELECT_CHANNELS mode
+ * (triggered when num_channels>0) has no result-publishing path in
+ * wifi_stats_radio_channel.c::process_neighbor_stats() and always returns NULL. */
+static std::vector<operating_class_t> band_op_classes(const char *band_flag)
+{
+    static const unsigned int oc_2g[]  = {81, 83, 84};
+    static const unsigned int oc_5g[]  = {115, 116, 117, 118, 119, 128, 129, 130};
+    static const unsigned int oc_6g[]  = {131, 132, 133, 134, 136, 137};
+
+    const unsigned int *arr = nullptr;
+    size_t n = 0;
+    if      (strcmp(band_flag, "--2g") == 0) { arr = oc_2g; n = sizeof(oc_2g)/sizeof(*oc_2g); }
+    else if (strcmp(band_flag, "--5g") == 0) { arr = oc_5g; n = sizeof(oc_5g)/sizeof(*oc_5g); }
+    else if (strcmp(band_flag, "--6g") == 0) { arr = oc_6g; n = sizeof(oc_6g)/sizeof(*oc_6g); }
+
+    std::vector<operating_class_t> result;
+    for (size_t i = 0; i < n; i++) {
+        operating_class_t oc;
+        memset(&oc, 0, sizeof(oc));
+        oc.operating_class = static_cast<UCHAR>(arr[i]);
+        /* num_channels stays 0 — full op-class scan */
+        result.push_back(oc);
+    }
+    return result;
+}
+
+static bool is_band_flag(const char *s)
+{
+    return strcmp(s, "--2g") == 0 || strcmp(s, "--5g") == 0 || strcmp(s, "--6g") == 0;
+}
+
+
+static void print_usage(const char *prog)
+{
+    fprintf(stderr,
+            "Usage:\n"
+            "  %s\n"
+            "      Subscribe and wait for a scan report (triggered externally)\n\n"
+            "  %s <ruid>\n"
+            "      Full scan all channels for radio RUID\n"
+            "      e.g.  %s aa:bb:cc:dd:ee:ff\n\n"
+            "  %s <ruid> --2g|--5g|--6g\n"
+            "      Full scan using band-appropriate op-class set (recommended)\n"
+            "      Mirrors the working HAL path: num_channels=0 forces FULL scan mode.\n"
+            "      e.g.  %s aa:bb:cc:dd:ee:ff --5g\n"
+            "            %s aa:bb:cc:dd:ee:ff --2g\n\n"
+            "  %s <ruid> <op_class>[:<ch>[,<ch>...]] [...]\n"
+            "      Targeted scan. Omit channels (e.g. '115') for all channels in that op-class.\n"
+            "      NOTE: specifying channels (e.g. '115:44') sets num_channels>0 which triggers\n"
+            "      SELECT_CHANNELS mode in OneWifi — this mode is broken on the vendor side and\n"
+            "      will return no results. Use --5g/--2g/--6g instead.\n"
+            "      e.g.  %s aa:bb:cc:dd:ee:ff 115 116\n"
+            "            %s aa:bb:cc:dd:ee:ff 81:1,6,11\n\n"
+            "  %s /path/to/scan.json\n"
+            "      Decode a captured JSON file (no bus required)\n",
+            prog, prog, prog, prog, prog, prog, prog, prog, prog, prog);
+}
+
+/* =========================================================================
+ * main
+ * ========================================================================= */
+int main(int argc, char *argv[])
+{
+    printf("=== OneWifi HAL Channel-Scan test ===\n\n");
+
+    std::string json_buf;
+    const char *json_str = nullptr;
+
+    /* ---- File mode: single non-MAC argument ---- */
+    if (argc == 2 && !is_mac_string(argv[1])) {
+        std::ifstream f(argv[1]);
+        if (!f.is_open()) {
+            fprintf(stderr, "ERROR: cannot open '%s'\n", argv[1]);
+            return 1;
+        }
+        std::ostringstream ss;
+        ss << f.rdbuf();
+        json_buf = ss.str();
+        json_str = json_buf.c_str();
+        printf("[INFO] source: file '%s'  (%zu bytes)\n\n", argv[1], json_buf.size());
+        goto run_tests;
+    }
+
+    /* ---- Bus mode ---- */
+    {
+        const unsigned char *ruid_ptr = nullptr;
+        unsigned char ruid[6] = {};
+
+        /* op-class specs (argv[2..]) */
+        std::vector<operating_class_t> op_classes;
+
+        if (argc >= 2) {
+            if (!is_mac_string(argv[1])) {
+                print_usage(argv[0]);
+                return 1;
+            }
+            parse_mac(argv[1], ruid);
+            ruid_ptr = ruid;
+
+            /* Band shortcut: --2g / --5g / --6g as the single argv[2] */
+            if (argc == 3 && is_band_flag(argv[2])) {
+                op_classes = band_op_classes(argv[2]);
+                printf("[INFO] band=%s  auto op-classes:", argv[2]);
+                for (size_t i = 0; i < op_classes.size(); i++)
+                    printf(" %u", op_classes[i].operating_class);
+                printf("  (num_channels=0 each → FULL scan mode)\n");
+            } else {
+            /* Parse each "op_class[:ch1,ch2,...]" argument */
+            for (int i = 2; i < argc; i++) {
+                operating_class_t oc;
+                if (!parse_op_class_spec(argv[i], &oc)) {
+                    print_usage(argv[0]);
+                    return 1;
+                }
+                op_classes.push_back(oc);
+            }
+            }
+
+            printf("[INFO] ruid=%02x:%02x:%02x:%02x:%02x:%02x\n",
+                   ruid[0], ruid[1], ruid[2], ruid[3], ruid[4], ruid[5]);
+            if (op_classes.empty()) {
+                printf("[INFO] mode: full scan (no op_class filter)\n");
+            } else {
+                printf("[INFO] mode: targeted scan  %zu op-class spec(s):\n",
+                       op_classes.size());
+                for (size_t i = 0; i < op_classes.size(); i++) {
+                    printf("[INFO]   op_class=%-3u  channels=",
+                           op_classes[i].operating_class);
+                    for (unsigned int j = 0; j < op_classes[i].num_channels; j++)
+                        printf("%u%s", op_classes[i].channels[j],
+                               j + 1 < op_classes[i].num_channels ? "," : "");
+                    printf("\n");
+                }
+            }
+        } else {
+            printf("[INFO] No ruid given – subscribe only (trigger scan externally)\n");
+        }
+        printf("\n");
+
+        if (!fetch_scan_from_bus(json_buf, ruid_ptr,
+                                  op_classes.empty() ? nullptr : op_classes.data(),
+                                  static_cast<unsigned int>(op_classes.size()))) {
+            fprintf(stderr,
+                    "\nERROR: bus event not received.\n"
+                    "  • Ensure OneWifi is running\n"
+                    "  • Verify ruid matches a radio interface MAC (check 'cat /sys/class/net/wifiX/address')\n"
+                    "  • Or pass a captured JSON file: %s /path/to/scan.json\n",
+                    argv[0]);
+            return 1;
+        }
+        json_str = json_buf.c_str();
+        printf("[INFO] source: live bus event  (%zu bytes)\n\n", json_buf.size());
+    }
+
+run_tests:
+    {
+        onewifi_data_model_t *dm = new onewifi_data_model_t();
+        int fail = 0;
+
+        if (!test_init(*dm))                   fail++;
+        if (!test_scan_decode(*dm, json_str))  fail++;
+
+        delete dm;
+
+        printf("\n=== %s  (%d / 2 passed) ===\n",
+               fail == 0 ? "ALL TESTS PASSED" : "SOME TESTS FAILED",
+               2 - fail);
+
+        return fail == 0 ? 0 : 1;
+    }
+}
