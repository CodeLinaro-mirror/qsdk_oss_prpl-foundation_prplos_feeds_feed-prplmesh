+        size_t n_bsta = dm.m_bsta_mld.size();
+        printf("\n[BSTA MLD INFO]  count=%zu\n", n_bsta);
+        for (size_t i = 0; i < n_bsta; i++) {
+            const em_bsta_mld_info_t &m = dm.m_bsta_mld[i];
+            printf("  bsta_mld[%zu]: mac_valid=%u  mac=%02x:%02x:%02x:%02x:%02x:%02x"
+                   "  str=%u  nstr=%u  emlsr=%u  emlmr=%u  num_affiliated=%u\n",
+                   i, m.mac_addr_valid,
+                   m.mac_addr[0], m.mac_addr[1], m.mac_addr[2],
+                   m.mac_addr[3], m.mac_addr[4], m.mac_addr[5],
+                   m.str, m.nstr, m.emlsr, m.emlmr, m.num_affiliated_bsta);
+            for (int k = 0; k < m.num_affiliated_bsta && k < EM_MAX_AP_MLD; k++) {
+                const em_affiliated_bsta_info_t &bsta = m.affiliated_bsta[k];
+                printf("    affiliated_bsta[%d]: ruid=%02x:%02x:%02x:%02x:%02x:%02x"
+                       "  mac=%02x:%02x:%02x:%02x:%02x:%02x  mac_valid=%u\n",
+                       k,
+                       bsta.ruid.mac[0], bsta.ruid.mac[1], bsta.ruid.mac[2],
+                       bsta.ruid.mac[3], bsta.ruid.mac[4], bsta.ruid.mac[5],
+                       bsta.mac_addr[0], bsta.mac_addr[1], bsta.mac_addr[2],
+                       bsta.mac_addr[3], bsta.mac_addr[4], bsta.mac_addr[5],
+                       bsta.mac_addr_valid);
+            }
+        }
+    }
+
+    /* ---- Assoc STA MLD info ---- */
+    {
+        size_t n_sta = dm.m_assoc_sta_mld.size();
+        printf("\n[ASSOC STA MLD INFO]  count=%zu\n", n_sta);
+        for (size_t i = 0; i < n_sta; i++) {
+            const em_assoc_sta_mld_info_t &m = dm.m_assoc_sta_mld[i];
+            printf("  assoc_sta_mld[%zu]:"
+                   "  mac=%02x:%02x:%02x:%02x:%02x:%02x"
+                   "  ap_mld_mac=%02x:%02x:%02x:%02x:%02x:%02x"
+                   "  str=%u  nstr=%u  emlsr=%u  emlmr=%u  num_affiliated=%u\n",
+                   i,
+                   m.mac_addr[0], m.mac_addr[1], m.mac_addr[2],
+                   m.mac_addr[3], m.mac_addr[4], m.mac_addr[5],
+                   m.ap_mld_mac_addr[0], m.ap_mld_mac_addr[1], m.ap_mld_mac_addr[2],
+                   m.ap_mld_mac_addr[3], m.ap_mld_mac_addr[4], m.ap_mld_mac_addr[5],
+                   m.str, m.nstr, m.emlsr, m.emlmr, m.num_affiliated_sta);
+            for (int k = 0; k < m.num_affiliated_sta && k < EM_MAX_AP_MLD; k++) {
+                const em_affiliated_sta_info_t &sta = m.affiliated_sta[k];
+                printf("    affiliated_sta[%d]: bssid=%02x:%02x:%02x:%02x:%02x:%02x"
+                       "  mac=%02x:%02x:%02x:%02x:%02x:%02x\n",
+                       k,
+                       sta.bssid[0], sta.bssid[1], sta.bssid[2],
+                       sta.bssid[3], sta.bssid[4], sta.bssid[5],
+                       sta.mac_addr[0], sta.mac_addr[1], sta.mac_addr[2],
+                       sta.mac_addr[3], sta.mac_addr[4], sta.mac_addr[5]);
+            }
+        }
+    }
+
+    return true;
+}
