+/* =========================================================================
+ * Bus path for the DML init data (defined in wifi_webconfig.h)
+ * ========================================================================= */
+#ifndef WIFI_WEBCONFIG_INIT_DML_DATA
+#define WIFI_WEBCONFIG_INIT_DML_DATA "Device.WiFi.WebConfig.Data.Init_dml"
+#endif
+
+/* =========================================================================
+ * Bus fetch: try to get DML JSON from Device.WiFi.WebConfig.Data.Init_dml.
+ * Returns true and fills json_out when successful.
+ * Caller must free(json_out.data()) on success via the returned raw_data_t.
+ * ========================================================================= */
+static bool fetch_dml_from_bus(std::string &json_out)
+{
+    /* Same pattern as base_wlan_hal_onewifi::check_and_open_bus():
+     * call bus_init() directly (not through descriptor), then use
+     * descriptor only for bus_open_fn / bus_data_get_fn / bus_close_fn. */
+    bus_handle_t handle = {};
+    if (bus_init(&handle) != bus_error_success) {
+        printf("[BUS] bus_init() failed – skipping bus fetch\n");
+        return false;
+    }
+
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (!desc) {
+        printf("[BUS] get_bus_descriptor() returned NULL – skipping bus fetch\n");
+        /* no descriptor, can't close cleanly — handle is uninitialised from init perspective */
+        return false;
+    }
+    if (!desc->bus_open_fn || !desc->bus_data_get_fn) {
+        printf("[BUS] bus_open_fn or bus_data_get_fn is NULL – skipping bus fetch\n");
+        if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    bus_error_t open_rc = desc->bus_open_fn(&handle,
+                                             const_cast<char *>("prplmesh-dml-test"));
+    if (open_rc != bus_error_success &&
+        open_rc != bus_error_session_already_exist &&
+        open_rc != bus_error_component_name_duplicate) {
+        printf("[BUS] bus_open_fn failed (rc=%d) – skipping bus fetch\n", (int)open_rc);
+        if (desc->bus_close_fn) desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    raw_data_t data = {};
+    bus_error_t rc = desc->bus_data_get_fn(&handle,
+                                           WIFI_WEBCONFIG_INIT_DML_DATA,
+                                           &data);
+    if (rc != bus_error_success) {
+        printf("[BUS] bus_data_get_fn('%s') failed (rc=%d) – skipping bus fetch\n",
+               WIFI_WEBCONFIG_INIT_DML_DATA, (int)rc);
+        if (desc->bus_close_fn)
+            desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    if (!data.raw_data.bytes || data.raw_data_len == 0) {
+        printf("[BUS] Empty response for '%s' – skipping bus fetch\n",
+               WIFI_WEBCONFIG_INIT_DML_DATA);
+        if (desc->bus_close_fn)
+            desc->bus_close_fn(&handle);
+        return false;
+    }
+
+    json_out.assign(reinterpret_cast<const char *>(data.raw_data.bytes),
+                    data.raw_data_len);
+
+    if (desc->bus_data_free_fn)
+        desc->bus_data_free_fn(&data);
+    else
+        free(data.raw_data.bytes);
+
+    if (desc->bus_close_fn)
+        desc->bus_close_fn(&handle);
+
+    printf("[BUS] Fetched %zu bytes from '%s'\n",
+           json_out.size(), WIFI_WEBCONFIG_INIT_DML_DATA);
+    return true;
+}
