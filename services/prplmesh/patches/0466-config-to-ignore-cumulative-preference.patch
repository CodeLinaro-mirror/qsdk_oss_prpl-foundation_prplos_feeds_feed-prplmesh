From c0f09b7a8874bf2f41beb14dc4f18c212ae62ed7 Mon Sep 17 00:00:00 2001
From: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
Date: Mon, 28 Sep 2026 19:40:21 +0530
Subject: [PATCH] config to ignore cumulative preference

use only the controller preference by ignoring the local radio
radio preference

Signed-off-by: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
---
 agent/config/beerocks_agent.conf.in           |  5 +++
 agent/src/beerocks/slave/agent_db.h           |  3 ++
 .../beerocks/slave/beerocks_agent_main.cpp    |  6 +++
 .../slave/tasks/channel_selection_task.cpp    | 41 +++++++++++++++----
 .../bcl/include/bcl/beerocks_config_file.h    |  3 ++
 .../bcl/source/beerocks_config_file.cpp       |  2 +
 6 files changed, 51 insertions(+), 9 deletions(-)

diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index 208d95a30..ee18bac5b 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -19,6 +19,11 @@ enable_system_hang_test=0 # 0 - disabled
 monitor_polling_rate_msec=@BEEROCKS_MONITOR_POLLING_RATE_MSEC@
 enable_auto_chansel_handling=0 # 0 - disabled
 
+# channel_selection_use_radio_preference:
+# 0 - use only Controller Channel Preference TLV scoring when selecting a channel (default)
+# 1 - use legacy cumulative scoring: Controller preference + Agent radio preference
+channel_selection_use_radio_preference=0 # 0 - controller only, 1 - controller + radio
+
 # active_acs_chansel_enable: Active ACS based channel selection.
 # Effective ONLY when enable_auto_chansel_handling=1.
 # 0 - disabled (existing exclude-list behaviour / stubbed platform ACS)
diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index 2183cdccd..b9f9e0314 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -197,6 +197,9 @@ public:
         uint8_t ap_maximum_links     = 0;
         uint8_t bsta_maximum_links   = 0;
         bool enable_auto_chansel_handling;
+        // Channel selection scoring. Default false: use only the Controller preference when
+        // selecting a channel. True restores the legacy Controller + radio preference score.
+        bool channel_selection_use_radio_preference = false;
         // When set, is_gateway_reachable_via_interface() skips the arping call.
         bool disable_gw_arping = false;
         // Active ACS channel selection. Effective only when enable_auto_chansel_handling
diff --git a/agent/src/beerocks/slave/beerocks_agent_main.cpp b/agent/src/beerocks/slave/beerocks_agent_main.cpp
index 4d2838356..8500f4776 100644
--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -614,6 +614,12 @@ static int run_beerocks_slave(beerocks::config_file::sConfigSlave &beerocks_slav
 
         db->device_conf.enable_auto_chansel_handling =
             beerocks_slave_conf.enable_auto_chansel_handling == "1";
+        db->device_conf.channel_selection_use_radio_preference =
+            beerocks_slave_conf.channel_selection_use_radio_preference == "1";
+        LOG(DEBUG) << "[CHANSEL] Config: channel_selection_use_radio_preference="
+                   << db->device_conf.channel_selection_use_radio_preference
+                   << " (raw channel_selection_use_radio_preference='"
+                   << beerocks_slave_conf.channel_selection_use_radio_preference << "')";
         // Active ACS channel selection. Only effective when enable_auto_chansel_handling
         // is also enabled.
         db->device_conf.active_acs_chansel_enable =
diff --git a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
index 643299f93..d49bdb99d 100644
--- a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
@@ -117,16 +117,18 @@ get_preference_for_channel(const AgentDB::sRadio::channel_preferences_map &chann
 }
 
 /**
- * @brief Returns the cumulative preference of a given channel.
- * A cumulative preference is calculated by adding the controller's preference and the radio's preference.
- * If either preference is Non-Operable, return Non-Operable.
+ * @brief Returns the selection preference of a given channel.
+ * By default, only the controller's preference is used. If
+ * channel_selection_use_radio_preference is enabled, restore the legacy cumulative score by adding
+ * the controller's preference and the radio's preference. If either preference is Non-Operable,
+ * return Non-Operable.
  * 
  * @param[in] radio Pointer to the AgentDB's radio element.
  * @param[in] controller_preferences Reference to the controller's preference map.
  * @param[in] operating_class Channel's operating class.
  * @param[in] channel_number Channel's number.
  * 
- * @return Cumulative preference score of the given channel.
+ * @return Selection preference score of the given channel.
  */
 uint8_t
 get_cumulative_preference(const AgentDB::sRadio *radio,
@@ -144,6 +146,10 @@ get_cumulative_preference(const AgentDB::sRadio *radio,
     const auto controller_preference =
         get_preference_for_channel(controller_preferences, operating_class, channel_number);
 
+    if (!AgentDB::get()->device_conf.channel_selection_use_radio_preference) {
+        return controller_preference;
+    }
+
     // Get Radio's reported preference
     const auto radio_preference =
         get_preference_for_channel(radio->channel_preferences, operating_class, channel_number);
@@ -3723,6 +3729,12 @@ bool ChannelSelectionTask::check_received_preferences_contain_violation(const sM
     auto &radio_request              = m_pending_selection.requests[radio_mac];
     const auto &received_preferences = radio_request.controller_preferences;
 
+    if (!AgentDB::get()->device_conf.channel_selection_use_radio_preference) {
+        LOG(DEBUG) << "Skipping radio preference violation check for radio " << radio_mac
+                   << " because channel_selection_use_radio_preference is disabled";
+        return true;
+    }
+
     for (const auto &preference_iter : received_preferences) {
         const auto operating_class       = preference_iter.first.operating_class;
         const auto controller_preference = preference_iter.first.flags.preference;
@@ -3766,7 +3778,7 @@ bool ChannelSelectionTask::check_is_there_better_channel_than_current(const sMac
 
     LOG(DEBUG) << "Current Channel is [" << radio->wifi_channel
                << "] Operating Class:" << (int)operating_class
-               << " and has a cumulative preference score of " << (int)current_preference;
+               << " and has a selection preference score of " << (int)current_preference;
 
     /**
      * Find the next best channel.
@@ -3998,17 +4010,28 @@ ChannelSelectionTask::sSelectedChannel ChannelSelectionTask::select_next_channel
             }
         }
 
+        if (best_bcn_chan == 0) {
+            return std::make_pair(uint8_t(0), uint8_t(0));
+        }
+
         // Get the 20Mhz operating class for the beacon channel
         const auto operating_class_20Mhz = son::wireless_utils::get_operating_class_by_channel(
             message::sWifiChannel(best_bcn_chan, eWiFiBandwidth::BANDWIDTH_20));
 
-        // Get the radio preference for the best beacon
-        auto bcn_radio_pref = get_preference_for_channel(radio->channel_preferences,
-                                                         operating_class_20Mhz, best_bcn_chan);
         // Get the controller preference for the central channel
         auto bcn_controller_pref =
             get_preference_for_channel(controller_preferences, operating_class, channel);
-        // Return the combination of the beacon's radio's preference with the primary's controller's preference.
+
+        if (!AgentDB::get()->device_conf.channel_selection_use_radio_preference) {
+            // In controller-only mode, the radio preference must not affect either the
+            // beacon choice or the score assigned to the selected central channel.
+            return std::make_pair(best_bcn_chan, bcn_controller_pref);
+        }
+
+        // Preserve the legacy score when radio preferences are explicitly enabled: use the
+        // radio preference of the selected beacon with the controller preference of the primary.
+        const auto bcn_radio_pref = get_preference_for_channel(
+            radio->channel_preferences, operating_class_20Mhz, best_bcn_chan);
         return std::make_pair(best_bcn_chan, (bcn_controller_pref + bcn_radio_pref));
     };
 
diff --git a/common/beerocks/bcl/include/bcl/beerocks_config_file.h b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
index 3c97c0824..f2e217f61 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_config_file.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
@@ -120,6 +120,9 @@ public:
         std::string on_boot_scan;
         std::string dwell_time;
         std::string enable_auto_chansel_handling;
+        // Channel selection scoring: when "0" (default), only Controller preference is used.
+        // When "1", restore legacy cumulative scoring using Controller + radio preference.
+        std::string channel_selection_use_radio_preference;
         // Active ACS channel selection : when set to "1" AND enable_auto_chansel_handling
         // is "1", build_acs_list() blocks all-radio-channels-minus-preferred and nl80211
         // start_platform_acs() drives the driver ACS (acs clear/set_block_chan_list + acs invoke 0).
diff --git a/common/beerocks/bcl/source/beerocks_config_file.cpp b/common/beerocks/bcl/source/beerocks_config_file.cpp
index 9cb36bfc6..4718e479a 100644
--- a/common/beerocks/bcl/source/beerocks_config_file.cpp
+++ b/common/beerocks/bcl/source/beerocks_config_file.cpp
@@ -185,6 +185,8 @@ bool config_file::read_slave_config_file(const std::string &config_file_path, sC
             std::make_tuple("on_boot_scan=", &conf.on_boot_scan, 0),
             std::make_tuple("dwell_time=", &conf.dwell_time, 0),
             std::make_tuple("enable_auto_chansel_handling=", &conf.enable_auto_chansel_handling, 0),
+            std::make_tuple("channel_selection_use_radio_preference=",
+                            &conf.channel_selection_use_radio_preference, 0),
             std::make_tuple("active_acs_chansel_enable=", &conf.active_acs_chansel_enable, 0),
             std::make_tuple("cbs_based_chansel_enable=", &conf.cbs_based_chansel_enable, 0),
             std::make_tuple("cbs_trigger_periodic_interval=", &conf.cbs_trigger_periodic_interval,
-- 
2.34.1

