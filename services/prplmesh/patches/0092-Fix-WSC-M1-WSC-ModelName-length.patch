From 49d65c4fc5eb9c3597c716b5744816a04dc49e94 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Thu, 5 Mar 2026 11:46:29 +0530
Subject: [PATCH 2/9] WSC M1 has WSC Model Name TLV with incorrect length Fix
 is to resize it appropriately.

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp  | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index e59593419..203841671 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -1236,6 +1236,12 @@ bool ApAutoConfigurationTask::add_wsc_m1_tlv(const std::string &radio_iface)
     cfg.model_number        = board_info.model_number;
     cfg.primary_dev_type_id = WSC::WSC_DEV_NETWORK_INFRA_AP;
     cfg.device_name         = "prplmesh-agent";
+
+    //WSC M1 packet Model name has size restrictions
+    if (cfg.model_name.size() > 30) {
+        cfg.model_name.resize(30);
+    }
+
     switch (radio->wifi_channel.get_freq_type()) {
     case beerocks::FREQ_24G:
         cfg.bands = WSC::WSC_RF_BAND_2GHZ;
-- 
2.34.1

