+uint8_t get_temp_degC(const char *path)
+{
+    FILE *fd = fopen(path, "r");
+    if (!fd) {
+        return 0;   // cannot open file → return 0
+    }
+
+    long milli = 0;
+    if (fscanf(fd, "%ld", &milli) != 1) {
+        fclose(fd);
+        return 0;   // cannot read → return 0
+    }
+
+    fclose(fd);
+
+    if (milli < 0) {
+        milli = 0;  // safety for invalid negative values
+    }
+
+    // Convert millidegree → °C
+    return (uint8_t)(milli / 1000);
+}
