+/**
+ * @brief Helper function to extract a string field from the config JSON file.
+ *
+ * This function reads the config file, parses it as JSON, navigates to root["config"],
+ * and extracts the specified string field.
+ *
+ * @param field_name The name of the field to extract from the config object
+ * @param output The string to store the extracted value
+ * @return true if the field was successfully extracted, false otherwise
+ */
+static bool get_config_string_field(const char *field_name, std::string &output)
+{
+    output.clear();
+
+    if (!config_file_path) {
+        LOG(ERROR) << "config_file_path is null";
+        return false;
+    }
+
+    std::ifstream config_file(config_file_path);
+    if (!config_file.is_open()) {
+        LOG(WARNING) << "Failed to open config file: " << config_file_path;
+        return false;
+    }
+
+    std::string config_content((std::istreambuf_iterator<char>(config_file)),
+                               std::istreambuf_iterator<char>());
+    config_file.close();
+    if (config_file.fail()) {
+        LOG(ERROR) << "unable to close config file: " << config_file_path;
+        return false;
+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        const char *error_ptr = cJSON_GetErrorPtr();
+        LOG(ERROR) << "Failed to parse JSON config file: " << config_file_path
+                   << " Error: " << (error_ptr ? error_ptr : "unknown");
+        return false;
+    }
+
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (!config_obj) {
+        LOG(WARNING) << "Missing 'config' object in " << config_file_path;
+        cJSON_Delete(root);
+        return false;
+    }
+
+    cJSON *field_obj = cJSON_GetObjectItem(config_obj, field_name);
+    if (field_obj && cJSON_IsString(field_obj)) {
+        const char *field_str = cJSON_GetStringValue(field_obj);
+        if (field_str && strlen(field_str) > 0) {
+            output = field_str;
+            cJSON_Delete(root);
+            return true;
+        }
+    }
+
+    LOG(WARNING) << "Missing or invalid " << field_name << " in " << config_file_path;
+    cJSON_Delete(root);
+    return false;
+}
+
+bool cfg_get_client_id(std::string &client_id)
+{
+    return get_config_string_field("client_id", client_id);
+}
+
+bool cfg_get_client_password(std::string &client_password)
+{
+    return get_config_string_field("client_password", client_password);
+}
