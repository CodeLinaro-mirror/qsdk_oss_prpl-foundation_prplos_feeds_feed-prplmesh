+/*
+ * Function to update the Client details.
+ */
+void update_client_details(std::shared_ptr<airties::tlvAirtiesDeviceInfo> &tlvDevinfo)
+{
+    if (!tlvDevinfo) {
+        LOG(ERROR) << "tlvDevinfo is null";
+        return;
+    }
+
+    static constexpr const char* kDefaultClientId     = "airties_123";
+    static constexpr const char* kDefaultClientSecret = "airties_secret";
+
+    std::string client_id;
+    std::string client_secret;
+
+    // Get client_id and client_password from BPL configuration
+    const bool is_client_id_present = beerocks::bpl::cfg_get_client_id(client_id);
+    const bool is_client_secret_present = beerocks::bpl::cfg_get_client_password(client_secret);
+
+    if (!is_client_id_present || client_id.empty()) {
+        LOG(WARNING) << "BPL: missing or empty client_id in configuration, using default";
+        client_id = kDefaultClientId;
+    }
+    if (!is_client_secret_present || client_secret.empty()) {
+        LOG(WARNING) << "BPL: missing or empty client_password in configuration, using default";
+        client_secret = kDefaultClientSecret;
+    }
+
+    tlvDevinfo->set_client_id(client_id);
+    tlvDevinfo->set_client_secret(client_secret);
+}
