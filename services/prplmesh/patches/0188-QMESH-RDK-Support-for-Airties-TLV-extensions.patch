+/**
+ * @brief Add Airties Radio Capability TLV to the CMDU message.
+ *
+ * This function constructs a Radio Capability TLV, populates it with
+ * supported standards from the radio's actual capabilities (HT/VHT/HE/WiFi6/EHT),
+ * and adds it to the outgoing CMDU message.
+ *
+ * @param cmdu_tx The CMDU message to which the TLV will be added.
+ * @return Returns true if the TLV was successfully added, false otherwise.
+ */
+bool tlvf_airties_utils::add_radio_capability(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto db = beerocks::AgentDB::get();
+    const auto &radios = db->get_radios_list();
+
+    for (const auto &radio : radios) {
+        if (!radio) {
+            continue;
+        }
+
+        auto tlvAirtiesRadioCapability = cmdu_tx.addClass<airties::tlvAirtiesRadioCapability>();
+        if (!tlvAirtiesRadioCapability) {
+            LOG(ERROR) << "addClass airties::tlvAirtiesRadioCapability failed";
+            return false;
+        }
+
+        tlvAirtiesRadioCapability->vendor_oui() =
+            (sVendorOUI(airties::tlvAirtiesMsgType::airtiesVendorOUI::OUI_AIRTIES));
+        tlvAirtiesRadioCapability->tlv_id() =
+            static_cast<int>(airties::eAirtiesTlVId::AIRTIES_RADIO_CAPABILITY);
+
+        tlvAirtiesRadioCapability->radio_id() = radio->front.iface_mac;
+
+        // Initialize all standards to 0
+        tlvAirtiesRadioCapability->standards().s_80211a = 0;
+        tlvAirtiesRadioCapability->standards().s_80211b = 0;
+        tlvAirtiesRadioCapability->standards().s_80211g = 0;
+        tlvAirtiesRadioCapability->standards().s_80211n = 0;
+        tlvAirtiesRadioCapability->standards().s_80211ac = 0;
+        tlvAirtiesRadioCapability->standards().s_80211ax = 0;
+        tlvAirtiesRadioCapability->standards().s_80211be = 0;
+        tlvAirtiesRadioCapability->standards().s_80211bn = 0;
+
+        // Determine supported standards based on frequency band and actual radio capabilities
+        // The radio_info structure is populated from OneWifi data model in refresh_radio_info()
+        
+        // Set basic standards based on frequency band
+        if (radio->frequency_band == beerocks::eFreqType::FREQ_24G) {
+            // 2.4GHz band supports b/g
+            tlvAirtiesRadioCapability->standards().s_80211b = 1;
+            tlvAirtiesRadioCapability->standards().s_80211g = 1;
+        } else if (radio->frequency_band == beerocks::eFreqType::FREQ_5G) {
+            // 5GHz band supports a
+            tlvAirtiesRadioCapability->standards().s_80211a = 1;
+        } else if (radio->frequency_band == beerocks::eFreqType::FREQ_6G) {
+            // 6GHz band - no legacy standards
+        }
+
+        // Check HT (802.11n) support from radio capabilities
+        if (radio->ht_supported) {
+            tlvAirtiesRadioCapability->standards().s_80211n = 1;
+        }
+
+        // Check VHT (802.11ac) support from radio capabilities
+        if (radio->vht_supported) {
+            tlvAirtiesRadioCapability->standards().s_80211ac = 1;
+        }
+
+        // Check HE (802.11ax/WiFi 6) support from radio capabilities
+        if (radio->he_supported) {
+            tlvAirtiesRadioCapability->standards().s_80211ax = 1;
+        }
+
+        // Check EHT (802.11be/WiFi 7) support from radio capabilities
+        if (radio->eht_supported) {
+            tlvAirtiesRadioCapability->standards().s_80211be = 1;
+        }
+
+#ifdef IEEE80211_11BN
+        // Force enable WiFi 7 and WiFi 8 for testing on platforms that support it
+        // This can be removed once OneWifi properly populates radio capabilities
+        tlvAirtiesRadioCapability->standards().s_80211be = 1;
+        tlvAirtiesRadioCapability->standards().s_80211bn = 1;
+#endif
+
+        LOG(INFO) << "Added Radio Capability TLV for radio " << radio->front.iface_mac
+                  << " (iface=" << radio->front.iface_name
+                  << ", freq_type=" << static_cast<int>(radio->frequency_band)
+                  << ", ht=" << radio->ht_supported
+                  << ", vht=" << radio->vht_supported
+                  << ", he=" << radio->he_supported
+                  << ", eht=" << radio->eht_supported
+                  << ", standards: a=" << (int)tlvAirtiesRadioCapability->standards().s_80211a
+                  << " b=" << (int)tlvAirtiesRadioCapability->standards().s_80211b
+                  << " g=" << (int)tlvAirtiesRadioCapability->standards().s_80211g
+                  << " n=" << (int)tlvAirtiesRadioCapability->standards().s_80211n
+                  << " ac=" << (int)tlvAirtiesRadioCapability->standards().s_80211ac
+                  << " ax=" << (int)tlvAirtiesRadioCapability->standards().s_80211ax
+                  << " be=" << (int)tlvAirtiesRadioCapability->standards().s_80211be << ")";
+    }
+
+    return true;
+}
+
+uint8_t tlvf_airties_utils::assign_unique_port_id(const std::string &interface_name)
+{
+    static std::mutex mtx;
+    std::lock_guard<std::mutex> lock(mtx);
+
+    static std::map<std::string, uint8_t> iface_to_id;
+
+    // If already assigned, return existing ID
+    auto it = iface_to_id.find(interface_name);
+    if (it != iface_to_id.end()) {
+        return it->second;
+    }
+
+    // Assign next sequential ID starting from 1
+    uint8_t new_id              = static_cast<uint8_t>(iface_to_id.size() + 1);
+    iface_to_id[interface_name] = new_id;
+
+    return new_id;
+}
+
+/*
+ * Function to add the Ethernet 1905 Neighbor Device List TLV
+ * to Topology Response Message
+ */
+bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    // Use system functions to get LAN interfaces instead of manual getifaddrs()
+    auto lan_ifaces = beerocks::net::network_utils::linux_get_lan_interfaces();
+
+    // First collect all ports that actually have 1905 neighbors
+    struct sPortNeighbors {
+        std::string ifname;
+        uint8_t port_id;
+        std::vector<sMacAddr> al_neighbors;
+    };
+    std::vector<sPortNeighbors> ports_with_neighbors;
+
+    for (const auto &ifname : lan_ifaces) {
+        std::string iface_mac_str;
+        sMacAddr local_iface_mac = {};
+        std::vector<sMacAddr> al_neighbors;
+
+        if (beerocks::net::network_utils::linux_iface_get_mac(ifname, iface_mac_str)) {
+            local_iface_mac = tlvf::mac_from_string(iface_mac_str);
+
+            // Query AgentDB for 1905 AL neighbors behind this interface
+            auto db = beerocks::AgentDB::get();
+            auto it = db->neighbor_devices.find(local_iface_mac);
+            if (it != db->neighbor_devices.end()) {
+                const auto &neighbors_by_al_mac = it->second;
+                al_neighbors.reserve(neighbors_by_al_mac.size());
+                for (const auto &kv : neighbors_by_al_mac) {
+                    al_neighbors.push_back(kv.first);
+                }
+            }
+        }
+
+        if (al_neighbors.empty()) {
+            continue;
+        }
+
+        sPortNeighbors pn;
+        pn.ifname      = ifname;
+        pn.port_id     = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
+        pn.al_neighbors = std::move(al_neighbors);
+        ports_with_neighbors.push_back(std::move(pn));
+    }
+
+    // If no ports have neighbors, skip emitting the TLV to avoid confusing strict controllers.
+    if (ports_with_neighbors.empty()) {
+        LOG(INFO) << "[TLV:1905-NEIGH] No Ethernet ports with 1905 neighbors, skipping TLV";
+        return true;
+    }
+
+    // Create and initialize the 1905 neighbor device list TLV
+    auto tlvNeighborList = cmdu_tx.addClass<airties::tlvAirtiesEth1905NeighborDeviceList>();
+    if (!tlvNeighborList) {
+        LOG(ERROR) << "[TLV:1905-NEIGH] addClass tlvAirtiesEth1905NeighborDeviceList FAILED";
+        return false;
+    }
+
+    tlvNeighborList->vendor_oui() = sVendorOUI(airties::tlvAirtiesMsgType::airtiesVendorOUI::OUI_AIRTIES);
+    tlvNeighborList->tlv_id()     = static_cast<int>(airties::eAirtiesTlVId::AIRTIES_1905_NEIGHBOR_DEVICE_LIST);
+
+    uint8_t added_ports = 0;
+    for (const auto &port_info : ports_with_neighbors) {
+        auto port_entry = tlvNeighborList->create_port_entries();
+        if (!port_entry) {
+            LOG(ERROR) << "[TLV:1905-NEIGH] create_port_entries() FAILED for ifname=" << port_info.ifname;
+            continue;
+        }
+
+        port_entry->port_id() = port_info.port_id;
+
+        const uint8_t num_neighbor =
+            static_cast<uint8_t>(std::min<size_t>(port_info.al_neighbors.size(), 0xFF));
+        port_entry->num_of_neighbor_al_macs() = num_neighbor;
+
+        if (num_neighbor > 0) {
+            if (!port_entry->alloc_neighbor_al_mac_list(num_neighbor)) {
+                LOG(ERROR) << "[TLV:1905-NEIGH] alloc_neighbor_al_mac_list(" << int(num_neighbor)
+                           << ") failed for ifname=" << port_info.ifname;
+                port_entry->num_of_neighbor_al_macs() = 0;
+            } else {
+                for (size_t i = 0; i < num_neighbor; ++i) {
+                    auto tup = port_entry->neighbor_al_mac_list(i);
+                    if (std::get<0>(tup)) {
+                        std::get<1>(tup) = port_info.al_neighbors[i];
+                    }
+                }
+            }
+        }
+
+        tlvNeighborList->add_port_entries(port_entry);
+        ++added_ports;
+    }
+
+    tlvNeighborList->num_of_eth_ports() = added_ports;
+    LOG(INFO) << "Added Ethernet 1905 Neighbor Device List TLV with " << int(added_ports)
+              << " ports";
+    return true;
+}
+
+/*
+ * Function to add the Ethernet Non 1905 Neighbor Device List TLV
+ * to Topology Response Message
+ */
+bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    // Use system functions to get LAN interfaces instead of manual getifaddrs()
+    auto lan_ifaces = beerocks::net::network_utils::linux_get_lan_interfaces();
+
+    // Helper functions for FDB processing and MAC filtering
+    auto is_multicast_mac_str = [](const std::string &mac) -> bool {
+        unsigned first_oct = 0;
+        if (mac.size() < 2 || std::sscanf(mac.c_str(), "%2x", &first_oct) != 1) {
+            return true;
+        }
+        return (first_oct & 0x01) != 0;
+    };
+
+    auto get_fdb_unicast_for_dev =
+        [&is_multicast_mac_str](const std::string &dev) -> std::vector<std::string> {
+        std::vector<std::string> macs;
+        FILE *fp = popen("bridge fdb show", "r");
+        if (!fp) {
+            LOG(WARNING) << "[TLV:NON1905-NEIGH] 'bridge fdb show' failed; dev=" << dev;
+            return macs;
+        }
+        char line[512] = {0};
+        while (fgets(line, sizeof(line), fp)) {
+            std::string ln(line);
+            if (ln.find(" dev " + dev) == std::string::npos) {
+                continue;
+            }
+            if (ln.find(" self ") != std::string::npos) {
+                continue;
+            }
+            if (ln.find(" permanent") != std::string::npos) {
+                continue;
+            }
+
+            size_t sp = ln.find(' ');
+            if (sp == std::string::npos) {
+                continue;
+            }
+            std::string mac = ln.substr(0, sp);
+            if (mac.size() != 17) {
+                continue;
+            }
+            if (is_multicast_mac_str(mac)) {
+                continue;
+            }
+
+            if (std::find(macs.begin(), macs.end(), mac) == macs.end()) {
+                macs.push_back(mac);
+            }
+        }
+        pclose(fp);
+        return macs;
+    };
+
+    // First collect only ports that actually have non-1905 neighbors
+    struct sPortNon1905 {
+        std::string ifname;
+        uint8_t port_id;
+        std::vector<sMacAddr> non1905_neighbors;
+    };
+    std::vector<sPortNon1905> ports_with_non1905_neighbors;
+
+    for (const auto &ifname : lan_ifaces) {
+        std::string iface_mac_str;
+        std::vector<sMacAddr> non1905_list;
+
+        if (beerocks::net::network_utils::linux_iface_get_mac(ifname, iface_mac_str)) {
+            sMacAddr local_iface_mac = tlvf::mac_from_string(iface_mac_str);
+            auto db                  = beerocks::AgentDB::get();
+            std::vector<sMacAddr> known_1905_al;
+            auto it = db->neighbor_devices.find(local_iface_mac);
+            if (it != db->neighbor_devices.end()) {
+                const auto &neighbors_by_al = it->second;
+                known_1905_al.reserve(neighbors_by_al.size());
+                for (const auto &kv : neighbors_by_al) {
+                    known_1905_al.push_back(kv.first);
+                }
+            }
+
+            auto fdb_list_str = get_fdb_unicast_for_dev(ifname);
+
+            for (const auto &mac_s : fdb_list_str) {
+                sMacAddr mac = tlvf::mac_from_string(mac_s);
+                bool is_1905 = false;
+                for (const auto &al : known_1905_al) {
+                    if (al == mac) {
+                        is_1905 = true;
+                        break;
+                    }
+                }
+                if (is_1905) {
+                    continue;
+                }
+
+                bool dup = false;
+                for (const auto &m : non1905_list) {
+                    if (m == mac) {
+                        dup = true;
+                        break;
+                    }
+                }
+                if (!dup) {
+                    non1905_list.push_back(mac);
+                }
+            }
+        }
+
+        if (non1905_list.empty()) {
+            continue;
+        }
+
+        sPortNon1905 pn;
+        pn.ifname            = ifname;
+        pn.port_id           = airties::tlvf_airties_utils::assign_unique_port_id(ifname);
+        pn.non1905_neighbors = std::move(non1905_list);
+        ports_with_non1905_neighbors.push_back(std::move(pn));
+    }
+
+    // If no ports have non-1905 neighbors, skip emitting the TLV.
+    if (ports_with_non1905_neighbors.empty()) {
+        LOG(INFO) << "[TLV:NON1905-NEIGH] No Ethernet ports with non-1905 neighbors, skipping TLV";
+        return true;
+    }
+
+    // Create and initialize the non-1905 neighbor device list TLV
+    auto tlvNon1905 = cmdu_tx.addClass<airties::tlvAirtiesEthNon1905NeighborDeviceList>();
+    if (!tlvNon1905) {
+        LOG(ERROR) << "[TLV:NON1905-NEIGH] addClass tlvAirtiesEthNon1905NeighborDeviceList FAILED";
+        return false;
+    }
+
+    tlvNon1905->vendor_oui() =
+        sVendorOUI(airties::tlvAirtiesMsgType::airtiesVendorOUI::OUI_AIRTIES);
+    tlvNon1905->tlv_id() =
+        static_cast<int>(airties::eAirtiesTlVId::AIRTIES_NON_1905_NEIGHBOR_DEVICE_LIST);
+
+    uint8_t added_ports = 0;
+    for (const auto &port_info : ports_with_non1905_neighbors) {
+        auto port_entry = tlvNon1905->create_port_entries();
+        if (!port_entry) {
+            LOG(ERROR) << "[TLV:NON1905-NEIGH] create_port_entries() FAILED for "
+                       << port_info.ifname;
+            continue;
+        }
+
+        port_entry->port_id() = port_info.port_id;
+
+        const uint8_t num_neighbor =
+            static_cast<uint8_t>(std::min<size_t>(port_info.non1905_neighbors.size(), 0xFF));
+        port_entry->num_of_non1905_neighbor_macs() = num_neighbor;
+
+        if (num_neighbor > 0 && !port_entry->alloc_non1905_neighbor_mac_list(num_neighbor)) {
+            LOG(ERROR) << "[TLV:NON1905-NEIGH] alloc_non1905_neighbor_mac_list(" << int(num_neighbor)
+                       << ") failed for " << port_info.ifname;
+            port_entry->num_of_non1905_neighbor_macs() = 0;
+        } else if (num_neighbor > 0) {
+            for (size_t i = 0; i < num_neighbor; ++i) {
+                auto tup = port_entry->non1905_neighbor_mac_list(i);
+                if (std::get<0>(tup)) {
+                    std::get<1>(tup) = port_info.non1905_neighbors[i];
+                }
+            }
+        }
+
+        tlvNon1905->add_port_entries(port_entry);
+        ++added_ports;
+    }
+
+    // Finalize TLV with total port count
+    tlvNon1905->num_of_eth_ports() = added_ports;
+    LOG(INFO) << "Added Ethernet non 1905 Neighbor Device List TLV with " << int(added_ports)
+              << " ports";
+    return true;
+}
