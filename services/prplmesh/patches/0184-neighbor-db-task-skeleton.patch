+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "neighbor_db_ctrl_task.h"
+
+#include <bcl/network/network_utils.h>
+#include <easylogging++.h>
+#include <memory>
+
+using namespace beerocks;
+using namespace net;
+using namespace son;
+
+// ---------------------------------------------------------------------------
+// Constructor
+// ---------------------------------------------------------------------------
+
+NeighborDbCtrlTask::NeighborDbCtrlTask(db &database_, ieee1905_1::CmduMessageTx &cmdu_tx_,
+                                       task_pool &tasks_)
+    : task("neighbor_db_ctrl_task"), database(database_), cmdu_tx(cmdu_tx_), tasks(tasks_)
+{
+    // Register this task's ID in the database so other components can push
+    // events to it (e.g. agent_monitoring_task on onboarding).
+    database.assign_neighbor_db_ctrl_task_id(id);
+
+    TASK_LOG(DEBUG) << "AP_DEBUG: NeighborDbCtrlTask started, task_id=" << id;
+}
+
+// ---------------------------------------------------------------------------
+// task::work() – periodic callback (currently a no-op)
+// ---------------------------------------------------------------------------
+
+void NeighborDbCtrlTask::work()
+{
+    // No periodic work required.  The task is entirely event-driven:
+    //   - AGENT_ONBOARDED event → send aggregated neighbor info to the new agent.
+    //   - LOCAL_NEIGHBOR_INFORMATION_MESSAGE received → update DB and propagate.
+}
+
+// ---------------------------------------------------------------------------
+// task::handle_event()
+// ---------------------------------------------------------------------------
+
+void NeighborDbCtrlTask::handle_event(int event_type, void *obj)
+{
+    switch (static_cast<eEvent>(event_type)) {
+
+    case AGENT_ONBOARDED: {
+        if (!obj) {
+            TASK_LOG(ERROR) << "AP_DEBUG: AGENT_ONBOARDED event received with null payload";
+            return;
+        }
+        std::unique_ptr<sAgentOnboardedEvent> ev(static_cast<sAgentOnboardedEvent *>(obj));
+        TASK_LOG(DEBUG) << "AP_DEBUG: Event AGENT_ONBOARDED for agent " << ev->agent_alid;
+        handle_agent_onboarded(ev->agent_alid);
+        // unique_ptr destructor frees memory automatically at end of scope
+        break;
+    }
+
+    case TRIGGER_NEIGHBOR_UPDATE: {
+        if (!obj) {
+            TASK_LOG(ERROR) << "AP_DEBUG: TRIGGER_NEIGHBOR_UPDATE event received with null payload";
+            return;
+        }
+        std::unique_ptr<sTriggerNeighborUpdateEvent> ev(
+            static_cast<sTriggerNeighborUpdateEvent *>(obj));
+        TASK_LOG(DEBUG) << "AP_DEBUG: Event TRIGGER_NEIGHBOR_UPDATE for agent " << ev->agent_alid;
+
+        if (ev->agent_alid == network_utils::ZERO_MAC) {
+            // Send aggregated neighbor info to every known connected agent.
+            TASK_LOG(DEBUG) << "AP_DEBUG: TRIGGER_NEIGHBOR_UPDATE: sending to ALL agents";
+            auto connected_agents = database.get_all_connected_agents();
+            for (const auto &agent : connected_agents) {
+                if (!agent) {
+                    continue;
+                }
+                send_aggregated_neighbor_info(agent->al_mac);
+            }
+        } else {
+            send_aggregated_neighbor_info(ev->agent_alid);
+        }
+        // unique_ptr destructor frees memory automatically at end of scope
+        break;
+    }
+
+    default:
+        TASK_LOG(WARNING) << "AP_DEBUG: Unknown event type " << event_type;
+        break;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// handle_ieee1905_1_msg()
+// ---------------------------------------------------------------------------
+
