+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _NEIGHBOR_DB_CTRL_TASK_H_
+#define _NEIGHBOR_DB_CTRL_TASK_H_
+
+#include "../db/db.h"
+#include "task.h"
+#include "task_pool.h"
+
+#include <tlvf/tlvftypes.h>
+
+#include <chrono>
+#include <unordered_map>
+#include <vector>
+
+namespace son {
+
+/**
+ * @brief Controller Neighbor DB Task
+ *
+ * Implements the controller-side logic for the SMD Neighbor DB Update process.
+ * This task:
+ *
+ *  1. Monitors agent onboarding events (AGENT_ONBOARDED) – no action taken on
+ *     onboarding itself; the event is kept for future extensibility.
+ *  2. On receipt of a Local Neighbor Information Message from an agent:
+ *       a. Updates the controller's local neighbor DB.
+ *       b. Propagates the updated DB to every other agent via an Aggregated
+ *          Neighbor Information Message (fire-and-forget, no response expected).
+ *  3. On a user/debug command (TRIGGER_NEIGHBOR_UPDATE event), sends the current
+ *     aggregated neighbor DB to the specified agent (or all agents if ZERO_MAC).
+ *
+ * Triggers for the Aggregated Neighbor Information Message
+ * --------------------------------------------------------
+ * There are exactly two triggers:
+ *   1. A user/debug command (TRIGGER_NEIGHBOR_UPDATE event).
+ *   2. A Local Neighbor Information Message has been received from an agent.
+ *
+ * In both cases the message is sent as fire-and-forget: after transmission the
+ * task returns immediately to the idle state without waiting for any response.
+ *
+ * Concurrency note
+ * ----------------
+ * All processing runs in the single-threaded controller event loop, so there
+ * are no data-race issues.
+ *
+ * Current implementation status
+ * ------------------------------
+ * This is a skeleton implementation.  All 1905 message transmissions and
+ * hostapd API calls are replaced by LOG(DEBUG) stubs so that the logic can be
+ * exercised and tested without any external dependencies.  The stubs are
+ * clearly marked with "[STUB]" in the log output.
+ */
+class NeighborDbCtrlTask : public task {
+public:
+    // -----------------------------------------------------------------------
+    // Events
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Events that can be pushed to this task via task_pool::push_event().
+     */
+    enum eEvent {
+        /** A new agent has completed onboarding. */
+        AGENT_ONBOARDED,
+
+        /**
+         * Debug / test hook for manual triggering via bml_cli.
+         * Sends the current aggregated neighbor DB to the specified agent
+         * (fire-and-forget).  Set agent_alid to ZERO_MAC to send to every
+         * known connected agent.
+         *
+         * To wire up a bml_cli command, add a handler in son_management.cpp:
+         *   tasks.push_event(database.get_neighbor_db_ctrl_task_id(),
+         *                    NeighborDbCtrlTask::TRIGGER_NEIGHBOR_UPDATE, &event);
+         */
+        TRIGGER_NEIGHBOR_UPDATE,
+    };
+
+    // -----------------------------------------------------------------------
+    // Event payload structs
+    // -----------------------------------------------------------------------
+
+    /** Payload for AGENT_ONBOARDED. */
+    struct sAgentOnboardedEvent {
+        sMacAddr agent_alid; ///< ALID of the newly onboarded agent.
+    };
+
+    /**
+     * Payload for TRIGGER_NEIGHBOR_UPDATE.
+     * Set agent_alid to ZERO_MAC to send aggregated neighbor info to all
+     * known connected agents.
+     */
+    struct sTriggerNeighborUpdateEvent {
+        sMacAddr agent_alid; ///< Target agent ALID, or ZERO_MAC for all agents.
+    };
+
+    // -----------------------------------------------------------------------
+    // Constructor / destructor
+    // -----------------------------------------------------------------------
+
+    NeighborDbCtrlTask(db &database_, ieee1905_1::CmduMessageTx &cmdu_tx_, task_pool &tasks_);
+    virtual ~NeighborDbCtrlTask() {}
+
+    // -----------------------------------------------------------------------
+    // 1905.1 message handler
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Handle incoming 1905.1 messages.
+     *
+     * Currently handles (as stubs):
+     *   - LOCAL_NEIGHBOR_INFORMATION_MESSAGE  (new SMD message, TLV TBD)
+     *
+     * @param src_mac  MAC address of the message sender.
+     * @param cmdu_rx  Received CMDU.
+     * @return True if the message was consumed, false otherwise.
+     */
+    bool handle_ieee1905_1_msg(const sMacAddr &src_mac,
+                               ieee1905_1::CmduMessageRx &cmdu_rx) override;
+
+protected:
+    // -----------------------------------------------------------------------
+    // task overrides
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Periodic work function.
+     *
+     * Currently a no-op.  Retained for future use.
+     */
+    void work() override;
+
+    /**
+     * @brief Handle an event pushed via task_pool::push_event().
+     *
+     * @param event_type  One of the eEvent values.
+     * @param obj         Pointer to the corresponding event payload struct.
+     */
+    void handle_event(int event_type, void *obj) override;
+
+private:
+    // -----------------------------------------------------------------------
+    // Local neighbor DB
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief One entry in the controller's local neighbor DB.
+     *
+     * In the full implementation report_data will hold the raw bytes of the
+     * IEEE Neighbor Report Element (NRE) received from the agent.  For now it
+     * is a placeholder vector.
+     */
+    struct sNeighborReportEntry {
+        sMacAddr agent_alid;                                ///< ALID of the reporting agent.
+        std::vector<uint8_t> report_data;                   ///< Raw NRE bytes (placeholder).
+        std::chrono::steady_clock::time_point last_updated; ///< Timestamp of last update.
+    };
+
+    // -----------------------------------------------------------------------
+    // Member variables
+    // -----------------------------------------------------------------------
+
+    db &database;
+    ieee1905_1::CmduMessageTx &cmdu_tx;
+    task_pool &tasks;
+
+    /**
+     * @brief Controller's local neighbor DB.
+     *
+     * Key:   Agent ALID (sMacAddr).
+     * Value: Latest neighbor report received from that agent.
+     */
+    std::unordered_map<sMacAddr, sNeighborReportEntry> m_neighbor_db;
+
+    // -----------------------------------------------------------------------
+    // Event handlers
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Handle AGENT_ONBOARDED event.
+     *
+     * Sends the current aggregated neighbor DB to the new agent (fire-and-forget).
+     * Returns immediately to idle state; no response is expected.
+     *
+     * @param agent_alid ALID of the newly onboarded agent.
+     */
+    void handle_agent_onboarded(const sMacAddr &agent_alid);
+
+    // -----------------------------------------------------------------------
+    // Message handlers
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief Handle a received Local Neighbor Information Message.
+     *
+     * Called from handle_ieee1905_1_msg() when a LOCAL_NEIGHBOR_INFORMATION_MESSAGE
+     * is received.
+     *
+     * Steps:
+     *  1. Update the local neighbor DB with the data from the reporting agent.
+     *  2. Propagate the updated DB to all other agents (fire-and-forget).
+     *
+     * After propagation the task returns to idle state; no response is expected.
+     *
+     * @param src_mac  ALID of the sending agent.
+     * @param cmdu_rx  Received CMDU (TLV parsing is stubbed).
+     * @return True on success.
+     */
+    bool handle_local_neighbor_info_message(const sMacAddr &src_mac,
+                                            ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    // -----------------------------------------------------------------------
+    // Helpers
+    // -----------------------------------------------------------------------
+
+    /**
+     * @brief [STUB] Send Aggregated Neighbor Information Message to an agent.
+     *
+     * In the full implementation this builds and transmits a 1905 Aggregated
+     * Neighbor Information Message containing the Neighbor Information TLVs
+     * for every AP currently in m_neighbor_db.
+     *
+     * The message is sent fire-and-forget; no response is expected.
+     *
+     * Currently prints a LOG(DEBUG) stub.
+     *
+     * @param agent_alid ALID of the target agent.
+     */
+    void send_aggregated_neighbor_info(const sMacAddr &agent_alid);
+
+    /**
+     * @brief Update the local neighbor DB for a given agent.
+     *
+     * Also prints a stub for the hostapd "set neighbor report element" API call.
+     *
+     * @param agent_alid  ALID of the reporting agent.
+     * @param report_data Raw NRE bytes (placeholder).
+     */
+    void update_local_neighbor_db(const sMacAddr &agent_alid,
+                                  const std::vector<uint8_t> &report_data);
+
+    /**
+     * @brief Propagate the updated neighbor DB to all agents except the reporter.
+     *
+     * Iterates database.m_agents and calls send_aggregated_neighbor_info() for
+     * every connected agent whose ALID differs from reporting_agent_alid.
+     * Each send is fire-and-forget; no response is expected.
+     *
+     * @param reporting_agent_alid ALID of the agent that just sent its report
+     *                             (excluded from propagation).
+     */
+    void propagate_neighbor_info_to_all_agents(const sMacAddr &reporting_agent_alid);
+};
+
+} // namespace son
+
+#endif // _NEIGHBOR_DB_CTRL_TASK_H_
