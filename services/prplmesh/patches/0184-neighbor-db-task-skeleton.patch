+    //
+    //   case ieee1905_1::eMessageType::LOCAL_NEIGHBOR_INFORMATION_MESSAGE:
+    //       return handle_local_neighbor_info_message(src_mac, cmdu_rx);
+
+    switch (cmdu_rx.getMessageType()) {
+
+        // -----------------------------------------------------------------------
+        // Placeholder: LOCAL_NEIGHBOR_INFORMATION_MESSAGE
+        // Replace the numeric value below with the actual eMessageType enum value
+        // once the SMD TLV patch is applied.
+        // -----------------------------------------------------------------------
+        // case ieee1905_1::eMessageType::LOCAL_NEIGHBOR_INFORMATION_MESSAGE:
+        // {
+        //     return handle_local_neighbor_info_message(src_mac, cmdu_rx);
+        // }
+
+    default:
+        // Message not handled by this task.
+        return false;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Event handler implementations
+// ---------------------------------------------------------------------------
+
+void NeighborDbCtrlTask::handle_agent_onboarded(const sMacAddr &agent_alid)
+{
+    // Per the simplified design, aggregated neighbor info is only sent when:
+    //   1. A user command triggers it (TRIGGER_NEIGHBOR_UPDATE event), or
+    //   2. A Local Neighbor Information Message is received from an agent.
+    // Agent onboarding no longer triggers an aggregated neighbor info send.
+    TASK_LOG(INFO) << "AP_DEBUG: Agent onboarded: " << agent_alid
+                   << " – no aggregated neighbor DB send on onboarding (by design)";
+}
+
+// ---------------------------------------------------------------------------
+// 1905.1 message handler implementations
+// ---------------------------------------------------------------------------
+
+bool NeighborDbCtrlTask::handle_local_neighbor_info_message(const sMacAddr &src_mac,
+                                                            ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto mid = cmdu_rx.getMessageId();
+    TASK_LOG(INFO) << "AP_DEBUG: Received Local Neighbor Information Message from agent " << src_mac
+                   << ", mid=" << std::hex << mid;
+
+    // -----------------------------------------------------------------------
+    // Step 1: Parse the Neighbor Information TLV and extract the NRE bytes.
+    //
+    // [STUB] In the full implementation:
+    //   auto tlv = cmdu_rx.getClass<vendor_specific::tlvNeighborInformation>();
+    //   if (!tlv) { TASK_LOG(ERROR) << "Missing Neighbor Information TLV"; return false; }
+    //   std::vector<uint8_t> nre_bytes(tlv->frame_body(), tlv->frame_body() + tlv->length());
+    //
+    // For now we use an empty placeholder vector.
+    // -----------------------------------------------------------------------
+    TASK_LOG(DEBUG) << "AP_DEBUG: [STUB] Parsing Neighbor Information TLV from agent " << src_mac
+                    << " (TLV type TBD – using placeholder NRE data)";
+    std::vector<uint8_t> nre_bytes; // placeholder
+
+    // -----------------------------------------------------------------------
+    // Step 2: Update the local neighbor DB.
+    // -----------------------------------------------------------------------
+    update_local_neighbor_db(src_mac, nre_bytes);
+
+    // -----------------------------------------------------------------------
+    // Step 3: Propagate the updated DB to all other agents (fire-and-forget).
+    // After propagation the task is back in idle state; no response is expected.
+    // -----------------------------------------------------------------------
+    propagate_neighbor_info_to_all_agents(src_mac);
+
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Helper implementations
+// ---------------------------------------------------------------------------
+
+void NeighborDbCtrlTask::send_aggregated_neighbor_info(const sMacAddr &agent_alid)
+{
+    // [STUB] In the full implementation this function will:
+    //  1. Build a 1905 Aggregated Neighbor Information Message.
+    //  2. Add one Neighbor Information TLV per entry in m_neighbor_db.
+    //  3. Transmit the message to agent_alid via send_cmdu_to_broker().
+    //  The message is fire-and-forget; no response is expected.
+
+    TASK_LOG(DEBUG) << "AP_DEBUG: [STUB] Sending Aggregated Neighbor Information Message to agent "
+                    << agent_alid;
+
+    if (m_neighbor_db.empty()) {
+        TASK_LOG(DEBUG)
+            << "AP_DEBUG: [STUB]   Neighbor DB is empty – sending empty aggregated message";
+    } else {
+        TASK_LOG(DEBUG) << "AP_DEBUG: [STUB]   Neighbor DB contains " << m_neighbor_db.size()
+                        << " entries:";
+        for (const auto &entry_kv : m_neighbor_db) {
+            TASK_LOG(DEBUG) << "AP_DEBUG: [STUB]     ALID=" << entry_kv.second.agent_alid
+                            << "  NRE bytes=" << entry_kv.second.report_data.size()
+                            << "  last_updated=(steady_clock)";
+        }
+    }
+
+    // TODO: Replace stub with actual 1905 message construction and transmission:
+    //
+    //   if (!cmdu_tx.create(0, ieee1905_1::eMessageType::AGGREGATED_NEIGHBOR_INFO_MESSAGE)) {
+    //       TASK_LOG(ERROR) << "Failed to create AGGREGATED_NEIGHBOR_INFO_MESSAGE";
+    //       return;
+    //   }
+    //   for (const auto &entry_kv : m_neighbor_db) {
+    //       auto tlv = cmdu_tx.addClass<vendor_specific::tlvNeighborInformation>();
+    //       // populate tlv from entry_kv.second.report_data ...
+    //   }
+    //   database.send_cmdu_to_broker(cmdu_tx, agent_alid, database.get_local_bridge_mac());
+}
+
+void NeighborDbCtrlTask::update_local_neighbor_db(const sMacAddr &agent_alid,
+                                                  const std::vector<uint8_t> &report_data)
+{
+    auto &entry        = m_neighbor_db[agent_alid];
+    entry.agent_alid   = agent_alid;
+    entry.report_data  = report_data;
+    entry.last_updated = std::chrono::steady_clock::now();
+
+    TASK_LOG(INFO) << "AP_DEBUG: Local neighbor DB updated for agent " << agent_alid
+                   << " (NRE bytes=" << report_data.size() << ")";
+
+    // [STUB] In the full implementation, after updating the local DB we would
+    // call the hostapd API to set the neighbor report element so that hostapd
+    // can use it for 802.11 neighbor reports to clients.
+    //
+    // Example (API TBD):
+    //   hostapd_iface.set_neighbor_report_element(agent_alid, report_data);
+    TASK_LOG(DEBUG) << "AP_DEBUG: [STUB] Calling hostapd API: set_neighbor_report_element("
+                    << "alid=" << agent_alid << ", nre_bytes=" << report_data.size() << ")";
+}
+
+void NeighborDbCtrlTask::propagate_neighbor_info_to_all_agents(const sMacAddr &reporting_agent_alid)
+{
+    TASK_LOG(INFO) << "AP_DEBUG: Propagating updated neighbor DB to all agents except "
+                   << reporting_agent_alid;
+
+    int propagated_count  = 0;
+    auto connected_agents = database.get_all_connected_agents();
+    for (const auto &agent : connected_agents) {
+        if (!agent || agent->al_mac == reporting_agent_alid) {
+            continue;
+        }
+        TASK_LOG(DEBUG) << "AP_DEBUG: Propagating aggregated neighbor info to agent "
+                        << agent->al_mac;
+        send_aggregated_neighbor_info(agent->al_mac);
+        ++propagated_count;
+    }
+
+    TASK_LOG(INFO) << "AP_DEBUG: Propagation complete: sent aggregated neighbor info to "
+                   << propagated_count << " agent(s)";
+}
