 namespace {
 
 struct sPerLinkStaInfo {
@@ -1676,13 +1678,72 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
                 continue;
             }
 
-            auto assoc_client = radio->associated_clients.find(affl_sta_metrics->sta_mac_addr());
+            const sMacAddr &sta_mac = affl_sta_metrics->sta_mac_addr();
+            bool            metric_matches_association = false;
+
+            /* Keep the legacy/SLO lookup first. For an MLO STA, however, the
+             * monitor reports the affiliated link MAC while associated_clients
+             * is keyed by the STA MLD MAC and is populated only on the radio
+             * which received the association notification. Requiring the link
+             * MAC to exist in this response radio's associated_clients drops
+             * valid TLV 0xe4 data from the other affiliated radios. */
+            auto assoc_client = radio->associated_clients.find(sta_mac);
             if (assoc_client != radio->associated_clients.end() &&
                 (assoc_client->second.bssid == metric.bssid ||
                  (bss_apmld_mac != net::network_utils::ZERO_MAC &&
                   assoc_client->second.bssid == bss_apmld_mac))) {
+                metric_matches_association = true;
+            }
+
+            /* Resolve MLO stations globally. The monitor may report either the
+             * STA MLD MAC or an affiliated link MAC, so handle both forms. The
+             * metric is accepted only if this AP Metrics response belongs to
+             * the same AP MLD, or to one of the MLD's affiliated BSSes. */
+            const AgentDB::sAssociatedStaMld *mld_info_ptr = nullptr;
+            if (!metric_matches_association) {
+                for (const auto &mld_entry : db->associated_sta_mlds) {
+                    const auto &mld_info = mld_entry.second;
+                    if (mld_info.mld_config.sta_mld_mac == sta_mac) {
+                        mld_info_ptr = &mld_info;
+                        break;
+                    }
+
+                    for (const auto &aff_sta : mld_info.affiliated_stas) {
+                        if (aff_sta.affiliated_sta_mac == sta_mac) {
+                            mld_info_ptr = &mld_info;
+                            break;
+                        }
+                    }
+                    if (mld_info_ptr) {
+                        break;
+                    }
+                }
+            }
+
+            if (mld_info_ptr) {
+                const bool ap_mld_matches =
+                    bss_apmld_mac != net::network_utils::ZERO_MAC &&
+                    mld_info_ptr->mld_config.ap_mld_mac != net::network_utils::ZERO_MAC &&
+                    bss_apmld_mac == mld_info_ptr->mld_config.ap_mld_mac;
+                const bool affiliated_bss_matches =
+                    std::any_of(mld_info_ptr->affiliated_stas.begin(),
+                                mld_info_ptr->affiliated_stas.end(),
+                                [&metric](const AgentDB::sAssociatedStaMld::sAffiliatedSta &sta) {
+                                    return sta.bssid == metric.bssid;
+                                });
+
+                metric_matches_association = ap_mld_matches || affiliated_bss_matches;
+                if (metric_matches_association) {
+                    LOG(DEBUG) << "Accepting TLV 0xe4 via MLD registry: sta=" << sta_mac
+                               << " sta_mld=" << mld_info_ptr->mld_config.sta_mld_mac
+                               << " bssid=" << metric.bssid
+                               << " ap_mld=" << bss_apmld_mac;
+                }
+            }
+
+            if (metric_matches_association) {
                 affiliated_sta_metrics.push_back({
-                    affl_sta_metrics->sta_mac_addr(),
+                    sta_mac,
                     affl_sta_metrics->bytes_sent(),
                     affl_sta_metrics->bytes_received(),
                     affl_sta_metrics->packets_sent(),
