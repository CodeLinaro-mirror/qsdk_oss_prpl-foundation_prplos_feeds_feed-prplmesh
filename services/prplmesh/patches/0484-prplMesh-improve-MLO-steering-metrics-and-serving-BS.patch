+    constexpr uint32_t default_unassoc_roc_duration_ms = 500;
+    constexpr uint32_t min_unassoc_roc_duration_ms     = 10;
+    constexpr uint32_t max_unassoc_roc_duration_ms     = 5000;
+    uint32_t unassoc_roc_duration_ms                   = default_unassoc_roc_duration_ms;
+    if (!beerocks_slave_conf.unassoc_sta_roc_duration_ms.empty()) {
+        auto configured_duration =
+            string_utils::stoi(beerocks_slave_conf.unassoc_sta_roc_duration_ms);
+        if (configured_duration < static_cast<int>(min_unassoc_roc_duration_ms) ||
+            configured_duration > static_cast<int>(max_unassoc_roc_duration_ms)) {
+            LOG(WARNING) << "Invalid unassoc_sta_roc_duration_ms value: "
+                         << configured_duration << ", using default "
+                         << default_unassoc_roc_duration_ms << " ms";
+        } else {
+            unassoc_roc_duration_ms = static_cast<uint32_t>(configured_duration);
+        }
+    }
+    LOG(INFO) << "Unassociated STA ROC measurement duration: "
+              << unassoc_roc_duration_ms << " ms";
+    bwl::nl80211::set_unassoc_sta_roc_duration_ms(unassoc_roc_duration_ms);
+
