From c03dfb7eab4e42aee5001db93052dbce12eeaae2 Mon Sep 17 00:00:00 2001
From: nushanth <nushanth@qti.qualcomm.com>
Date: Fri, 14 Nov 2025 22:05:32 +0530
Subject: [PATCH] Steering changes for persistent enable in BML after
 controller reboot

Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 framework/platform/bpl/cfg/dm/bpl_cfg.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
index b56e57d..1d8db8c 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
@@ -85,7 +85,7 @@ int cfg_is_onboarding() { return 0; }
 
 bool cfg_get_band_steering(bool &band_steering)
 {
-    return read_agent_config_param("BandSteeringEnabled", band_steering);
+    return read_controller_config_param("BandSteeringEnabled", band_steering);
 }
 
 bool cfg_set_band_steering(bool band_steering)
@@ -105,7 +105,7 @@ bool cfg_set_daisy_chaining_disabled(bool daisy_chaining_disabled)
 
 bool cfg_get_client_11k_roaming(bool &eleven_k_roaming)
 {
-    return read_agent_config_param("Client11kRoamingEnabled", eleven_k_roaming);
+    return read_controller_config_param("Client11kRoamingEnabled", eleven_k_roaming);
 }
 
 bool cfg_set_client_11k_roaming(bool eleven_k_roaming)
@@ -115,7 +115,7 @@ bool cfg_set_client_11k_roaming(bool eleven_k_roaming)
 
 bool cfg_get_client_roaming(bool &client_roaming)
 {
-    return read_agent_config_param("ClientRoamingEnabled", client_roaming);
+    return read_controller_config_param("ClientRoamingEnabled", client_roaming);
 }
 
 bool cfg_set_client_roaming(bool client_roaming)
-- 
