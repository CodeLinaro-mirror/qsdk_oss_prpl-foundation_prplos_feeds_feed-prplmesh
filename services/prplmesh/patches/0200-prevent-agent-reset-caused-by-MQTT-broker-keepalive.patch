@@ -88,9 +88,9 @@ void MQTTClient::process()
 
     int rc = mosquitto_loop_read(mosq, 1);
     if (rc == MOSQ_ERR_CONN_LOST) {
-        LOG(ERROR) << "MQTT connection lost";
+        LOG(ERROR) << "MQTT connection lost during read";
     }
-    
+
     if (mosquitto_want_write(mosq)) {
         rc = mosquitto_loop_write(mosq, 1);
         if (rc == MOSQ_ERR_CONN_LOST) {
@@ -109,6 +109,17 @@ void MQTTClient::cleanup()
     mqtt_fd = -1;
 }
 
+void MQTTClient::ping()
+{
+    if (!mosq || mqtt_fd == -1) {
+        return;
+    }
+    // mosquitto_loop_misc() handles time-based tasks including sending PINGREQ
+    // when the keepalive timer is due. Calling it here sends the keepalive ping
+    // without reading or writing application data.
+    mosquitto_loop_misc(mosq);
+}
+
 int MQTTClient::publish(const std::string& topic, const void* payload, int payload_len, int qos, bool retain)
 {
     if (!mosq) return MOSQ_ERR_NO_CONN;
@@ -151,4 +162,3 @@ void MQTTClient::on_message(const struct mosquitto_message* msg)
 
 } // namespace mqttapi
 } // namespace beerocks
