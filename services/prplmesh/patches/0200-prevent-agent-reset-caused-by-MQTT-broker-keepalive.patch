                                    const bwl::hal_conf_t &hal_conf)
-    : base_wlan_hal(bwl::HALType::Slave, iface_name, IfaceType::Intel, callback, hal_conf)
+    : base_wlan_hal(bwl::HALType::Slave, iface_name, IfaceType::Intel, callback, hal_conf),
+      last_ping_time_(std::chrono::steady_clock::now())
 {
     int fd = mqtt_client.init(iface_name, "localhost", 1883,
         [this](const char* topic, const void* payload, int payload_len) {
@@ -73,12 +74,27 @@ int slave_wlan_hal_nl80211::smd_set_neighbor(const void* payload, int payload_le
 bool slave_wlan_hal_nl80211::process_ext_events(int fd)
 {
     if (fd == mqtt_client.get_fd()) {
+        // Readable event on the MQTT socket — always process to consume incoming data.
         mqtt_client.process();
         return true;
     }
     return false;
 }
 
+void slave_wlan_hal_nl80211::send_ping()
+{
+    // Send MQTT PINGREQ every 30 seconds to keep the broker connection alive.
+    constexpr int MQTT_PING_INTERVAL_SEC = 30;
+    auto now = std::chrono::steady_clock::now();
+    auto elapsed_sec = std::chrono::duration_cast<std::chrono::seconds>(
+        now - last_ping_time_).count();
+    if (elapsed_sec >= MQTT_PING_INTERVAL_SEC) {
+        LOG(DEBUG) << "MQTT keepalive: sending PINGREQ (elapsed=" << elapsed_sec << "s)";
+        mqtt_client.ping();
+        last_ping_time_ = now;
+    }
+}
+
