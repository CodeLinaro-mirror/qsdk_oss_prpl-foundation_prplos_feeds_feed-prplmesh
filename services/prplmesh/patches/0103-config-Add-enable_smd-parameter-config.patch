From 737af3d3aea4e886e391c16e6ae6c4b5d11fec1a Mon Sep 17 00:00:00 2001
From: Vignesh Sridharan <vignsrid@qti.qualcomm.com>
Date: Mon, 6 Apr 2026 09:52:11 +0530
Subject: [PATCH 3/9] config: Add enable_smd parameter config

Add enable_smd configuration parameter (default: 0) to control SMD
feature enablement in both agent and controller. This allows conditional
registration of SMD TLV handlers based on deployment requirements.

- Add to beerocks_agent.conf.in and beerocks_controller.conf.in
- Add to config structures (sConfigSlave, sDbMasterConfig, sDeviceConf)
- Parse and store in agent/controller initialization

Signed-off-by: Vignesh Sridharan <vignsrid@qti.qualcomm.com>
---
 agent/config/beerocks_agent.conf.in                     | 1 +
 agent/src/beerocks/slave/agent_db.h                     | 1 +
 agent/src/beerocks/slave/beerocks_agent_main.cpp        | 1 +
 common/beerocks/bcl/include/bcl/beerocks_config_file.h  | 2 ++
 common/beerocks/bcl/source/beerocks_config_file.cpp     | 2 ++
 controller/config/beerocks_controller.conf.in           | 3 +++
 controller/src/beerocks/master/beerocks_master_main.cpp | 1 +
 controller/src/beerocks/master/db/db.h                  | 1 +
 8 files changed, 12 insertions(+)

diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index c158c3c80..1f3a03dcc 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -17,6 +17,7 @@ bridge_iface=@BEEROCKS_BRIDGE_IFACE@
 enable_system_hang_test=0 # 0 - disabled
 monitor_polling_rate_msec=@BEEROCKS_MONITOR_POLLING_RATE_MSEC@
 enable_auto_chansel_handling=0 # 0 - disabled
+enable_smd=0 # 0 - disabled, 1 - enabled (SMD - Seamless Mobility Domain)
 
 # This variable is a workaround that turn on the profile_x_disallow flag when configuring the
 # traffic separation, if the Controller sent unsupported configuration on the profile disallow
diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index 0b80e8a6f..1daf24243 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -181,6 +181,7 @@ public:
         uint8_t ap_maximum_links     = 0;
         uint8_t bsta_maximum_links   = 0;
         bool enable_auto_chansel_handling;
+        bool enable_smd                             = false;
         int8_t num_of_bands = 0;
         uint8_t beacon_11k_default_measurement_mode = 2;
 
diff --git a/agent/src/beerocks/slave/beerocks_agent_main.cpp b/agent/src/beerocks/slave/beerocks_agent_main.cpp
index 437c2f00f..4f3177f1b 100644
--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -560,6 +560,7 @@ static int run_beerocks_slave(beerocks::config_file::sConfigSlave &beerocks_slav
 
         db->device_conf.enable_auto_chansel_handling =
             beerocks_slave_conf.enable_auto_chansel_handling == "1";
+        db->device_conf.enable_smd = beerocks_slave_conf.enable_smd == "1";
         {
             bool uci_enabled = false;
             if (beerocks::bpl::cfg_get_traffic_separation_bridge_mapping_enabled(uci_enabled)) {
diff --git a/common/beerocks/bcl/include/bcl/beerocks_config_file.h b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
index e3fcf5a5f..b611a4b46 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_config_file.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
@@ -40,6 +40,7 @@ public:
         std::string model;
         std::string ucc_listener_port;
         std::string load_legacy_client_roaming;
+        std::string enable_smd;
         std::string load_service_fairness;
         std::string load_backhaul_measurements;
         std::string load_front_measurements;
@@ -96,6 +97,7 @@ public:
         std::string on_boot_scan;
         std::string dwell_time;
         std::string enable_auto_chansel_handling;
+        std::string enable_smd;
         std::string clients_unicast_measurements;
