diff --git a/common/beerocks/bcl/source/beerocks_config_file.cpp b/common/beerocks/bcl/source/beerocks_config_file.cpp
index f6808e8bc..7994f9176 100644
--- a/common/beerocks/bcl/source/beerocks_config_file.cpp
+++ b/common/beerocks/bcl/source/beerocks_config_file.cpp
@@ -53,6 +53,7 @@ bool config_file::read_master_config_file(const std::string &config_file_path, s
         std::make_tuple("ucc_listener_port=", &conf.ucc_listener_port, mandatory_master),
         std::make_tuple("load_legacy_client_roaming=", &conf.load_legacy_client_roaming,
                         mandatory_master),
+        std::make_tuple("enable_smd=", &conf.enable_smd, 0),
         std::make_tuple("load_service_fairness=", &conf.load_service_fairness, mandatory_master),
         std::make_tuple("load_backhaul_measurements=", &conf.load_backhaul_measurements, 0),
         std::make_tuple("load_front_measurements=", &conf.load_front_measurements, 0),
@@ -148,6 +149,7 @@ bool config_file::read_slave_config_file(const std::string &config_file_path, sC
             std::make_tuple("on_boot_scan=", &conf.on_boot_scan, 0),
             std::make_tuple("dwell_time=", &conf.dwell_time, 0),
             std::make_tuple("enable_auto_chansel_handling=", &conf.enable_auto_chansel_handling, 0),
+            std::make_tuple("enable_smd=", &conf.enable_smd, 0),
             std::make_tuple("clients_unicast_measurements=", &conf.clients_unicast_measurements, 0),
             std::make_tuple("send_btm_to_non_11v_sta=", &conf.send_btm_to_non_11v_sta, 0),
             std::make_tuple("beacon_11k_default_measurement_mode=", &conf.beacon_11k_default_measurement_mode, 0),
diff --git a/controller/config/beerocks_controller.conf.in b/controller/config/beerocks_controller.conf.in
index 89904c35a..63c1faae6 100644
--- a/controller/config/beerocks_controller.conf.in
+++ b/controller/config/beerocks_controller.conf.in
@@ -15,6 +15,9 @@ ucc_listener_port=8002 # 0 - disabled
 #   Client steering feature:
 load_legacy_client_roaming=1
 
+#   SMD feature:
+enable_smd=0 # 0 - disabled, 1 - enabled (SMD - Seamless Mobility Domain)
+
 #   Measurement feature:
