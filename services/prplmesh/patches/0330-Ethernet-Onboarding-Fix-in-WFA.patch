-void cfg_wifi_reset_wps_credentials() { LOG(INFO) << __func__ << " NOT IMPLEMENTED"; }
+void cfg_wifi_reset_wps_credentials()
+{
+    // Clear the persistent bSTA (EndPoint) credentials learned through WPS/WSC.
+    //
+    // The dm/ambiorix backend does this by removing every WiFi.EndPoint.*.Profile.*
+    // instance. On UCI there is no separate profile object: the credentials the
+    // supplicant onboarded with are stored directly on the "mode=sta" wifi-iface
+    // sections of /etc/config/wireless. So the equivalent reset is to strip the
+    // credential options from those sections, leaving the section itself (ifname,
+    // device, multi_ap, wds, wps_pushbutton, ...) intact so the bSTA can onboard
+    // again after the reset.
+    //
+    // uci_set_section() removes any option whose value is an empty string, which is
+    // exactly the semantics needed here.
+    const std::string package_name = "wireless";
+    const std::string section_type = "wifi-iface";
+
+    std::vector<std::string> sections;
+    if (!uci_get_all_sections(package_name, section_type, sections)) {
+        LOG(ERROR) << __func__ << ": failed to get " << package_name << "." << section_type
+                   << " section names";
+        return;
+    }
+
+    // Credential options written when a bSTA onboards. Setting each to an empty
+    // string deletes the option from the section.
+    //
+    // This list mirrors exactly the credential options written by
+    // bpl_cfg_set_sta_vap_bh_credentials() when a bSTA onboards: ssid, encryption,
+    // sae_pwe, sae and key. "multi_ap" and "wds" are deliberately NOT cleared - they
+    // describe the interface's role, not the learned credentials, and the bSTA needs
+    // them to remain a backhaul STA after the reset.
+    const OptionsUnorderedMap cleared_options = {
+        {"ssid", ""}, {"key", ""}, {"encryption", ""}, {"sae", ""}, {"sae_pwe", ""},
+    };
+
+    unsigned int reset_count = 0;
+    for (const auto &section_name : sections) {
+        std::string mode;
+        if (!uci_get_option(package_name, section_type, section_name, "mode", mode)) {
+            LOG(DEBUG) << __func__ << ": no 'mode' in section " << section_name << ", skipping";
+            continue;
+        }
+
+        // Only the bSTA (EndPoint) sections hold WPS-learned credentials.
+        if (mode != "sta") {
+            continue;
+        }
+
+        // Defer the commit until every section has been updated, so netifd sees a
+        // single wireless reload instead of one per bSTA.
+        if (!uci_set_section(package_name, section_type, section_name, cleared_options, false)) {
+            LOG(ERROR) << __func__ << ": failed to clear credentials in section " << section_name;
+            continue;
+        }
+
+        LOG(DEBUG) << __func__ << ": cleared WPS credentials in section " << section_name;
+        reset_count++;
+    }
+
+    if (reset_count == 0) {
+        LOG(INFO) << __func__ << ": no 'mode=sta' sections to reset";
+        return;
+    }
+
+    if (!uci_commit_changes(package_name)) {
+        LOG(ERROR) << __func__ << ": failed to commit " << package_name << " changes";
+        return;
+    }
+
+    LOG(INFO) << __func__ << ": reset wps credentials on " << reset_count << " bSTA section(s)";
+}
 
