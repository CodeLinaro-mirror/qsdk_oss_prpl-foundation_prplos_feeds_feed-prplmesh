-bool sta_wlan_hal_nl80211::enable_disable_ep(bool enable) { return true; }
+bool sta_wlan_hal_nl80211::enable_disable_ep(bool enable)
+{
+    // WHM sets WiFi.EndPoint.*.Enable on the datamodel. The nl80211 equivalent of the
+    // EndPoint administrative state is the wpa_supplicant network block, so drive
+    // ENABLE_NETWORK / DISABLE_NETWORK here.
+    //
+    // dev_reset_default calls this with enable=true after disconnect() has already run
+    // REMOVE_NETWORK and cleared m_active_network_id. In that case there is no network
+    // block left to enable and nothing to do — the bSTA is re-armed when
+    // add_new_network()/connect() installs a fresh network block during dev_set_config.
+    if (m_active_network_id < 0) {
+        LOG(DEBUG) << "enable_disable_ep(" << enable << "): no active network on "
+                   << get_iface_name() << ", nothing to do";
+        return true;
+    }
+
+    LOG(DEBUG) << "enable_disable_ep(): iface=" << get_iface_name() << " enable=" << int(enable)
+               << " network_id=" << m_active_network_id;
+
+    if (enable) {
+        return enable_network(m_active_network_id);
+    }
+
+    const std::string cmd = "DISABLE_NETWORK " + std::to_string(m_active_network_id);
+    if (!wpa_ctrl_send_msg(cmd)) {
+        LOG(ERROR) << "WPA command '" << cmd << "' failed";
+        return false;
+    }
+
+    return true;
+}
 
