-bool sta_wlan_hal_nl80211::clear_non_associated_devices() { return true; }
+bool sta_wlan_hal_nl80211::clear_non_associated_devices()
+{
+    // The WHM backend calls NaStaMonitor.clearNonAssociatedDevices() on the radio to
+    // drop the unassociated-STA monitor list. There is no equivalent pwhm object on
+    // nl80211: the unassociated-STA measurement is driven entirely from this HAL via
+    // unassoc_rssi_measurement(), and its state lives in the m_unassoc_measure_*
+    // members below. Resetting them is therefore the nl80211 equivalent — without it
+    // a measurement window armed before dev_reset_default stays armed across the
+    // reset and its results get attributed to the next test case.
+    LOG(DEBUG) << "Clearing unassociated-device measurement state on " << get_iface_name();
+
+    m_unassoc_measure_start       = std::chrono::steady_clock::time_point();
+    m_unassoc_measure_window_size = 0;
+    m_unassoc_measure_delay       = 0;
+
+    return true;
+}
 
