+int ap_wlan_hal_nl80211::wait_for_added_bss_ready(const std::string &ifname)
+{
+    if (ifname.empty()) {
+        LOG(ERROR) << "Cannot wait for registration of an empty BSS name";
+        return beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+
+    std::string kernel_ifname;
+    extractLinkBaseInterface(ifname, kernel_ifname);
+
+    for (int attempt = 1; attempt <= BSS_REGISTRATION_MAX_ATTEMPTS; ++attempt) {
+        const auto ifindex = if_nametoindex(kernel_ifname.c_str());
+
+        if (ifindex != 0) {
+            // add_interface() also waits for the dedicated hostapd socket and
+            // rebinds a temporary global-socket registration when it appears.
+            const int fd = base_wlan_hal_nl80211::add_interface(ifname);
+            if (fd >= 0) {
+                parsed_obj_map_t status;
+
+                // STATUS on the expected per-interface socket confirms that
+                // hostapd has registered this exact name. Registration alone
+                // is not sufficient: hostapd can respond while the BSS is
+                // still in HT_SCAN. Accept ENABLED and DFS; DFS is valid
+                // while CAC is in progress.
+                if (wpa_ctrl_send_msg("STATUS", status, ifname)) {
+                    const auto state_it = status.find("state");
+                    const std::string state =
+                        state_it != status.end() ? state_it->second : std::string();
+                    const std::string state_for_log =
+                        state.empty() ? std::string("unknown") : state;
+
+                    LOG(INFO) << "BSS " << ifname
+                              << " is registered with hostapd, ifindex=" << ifindex
+                              << ", state=" << state_for_log;
+
+                    if (state == "ENABLED" || state == "DFS") {
+                        return fd;
+                    }
+
+                    LOG(DEBUG) << "BSS " << ifname
+                               << " is registered but not ready, state="
+                               << state_for_log;
+                }
+            }
+        }
+
+        if (attempt < BSS_REGISTRATION_MAX_ATTEMPTS) {
+            std::this_thread::sleep_for(BSS_REGISTRATION_POLL_DELAY);
+        }
+    }
+
+    LOG(WARNING) << "BSS " << ifname
+                 << " did not become registered and ready within the timeout";
+    return beerocks::net::FileDescriptor::invalid_descriptor;
+}
