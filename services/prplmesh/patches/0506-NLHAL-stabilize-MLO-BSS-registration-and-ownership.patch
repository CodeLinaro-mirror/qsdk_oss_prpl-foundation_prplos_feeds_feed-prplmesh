+bool ap_wlan_hal_nl80211::resolve_sta_connected_interface(
+    const std::string &event_iface,
+    int event_link_id,
+    std::string &resolved_iface)
+{
+    resolved_iface = event_iface;
+
+    std::string base_iface;
+    extractLinkBaseInterface(event_iface, base_iface);
+
+    if (base_iface.empty() || m_hal_conf.phy_name.empty()) {
+        LOG(DEBUG) << "Cannot validate STA_Connected ownership for " << event_iface;
+        return false;
+    }
+
+    // Reuse the already registered hostapd command socket. Do not register,
+    // connect, or remove a socket in this event path.
+    parsed_obj_map_t status;
+    if (!wpa_ctrl_send_msg("STATUS", status, base_iface)) {
+        LOG(DEBUG) << "STATUS unavailable for " << base_iface
+                   << "; ignoring STA_Connected";
+        return false;
+    }
+
+    int num_links = 0;
+    const auto links_it = status.find("num_links");
+    if (links_it != status.end() && !links_it->second.empty() &&
+        std::all_of(links_it->second.begin(), links_it->second.end(),
+                    [](unsigned char c) { return std::isdigit(c); })) {
+        num_links = beerocks::string_utils::stoi(links_it->second);
+    }
+
+    const auto phy_it = status.find("phy");
+    // SLO and single-link operation: with at most one operational link,
+    // hostapd's PHY field is authoritative. Preserve the event interface name.
+    if (num_links <= 1) {
+        const bool owns_phy =
+            phy_it != status.end() && phy_it->second == m_hal_conf.phy_name;
+
+        if (!owns_phy) {
+            LOG(DEBUG) << "Ignoring STA_Connected for foreign PHY: " << base_iface
+                       << ", event_phy="
+                       << (phy_it != status.end() ? phy_it->second : "<missing>")
+                       << ", local_phy=" << m_hal_conf.phy_name;
+            return false;
+        }
+
+        resolved_iface = event_iface;
+        return true;
+    }
+
+    // A true MLO event must identify the affiliated link.
+    if (event_link_id < 0) {
+        LOG(DEBUG) << "Ignoring MLO STA_Connected without LINKID for " << base_iface;
+        return false;
+    }
+
+    int radio_idx = -1;
+    if (!get_this_radio_idx(radio_idx)) {
+        LOG(DEBUG) << "Cannot determine radio index for " << m_hal_conf.phy_name;
+        return false;
+    }
+
+    std::string local_link_iface;
+    if (!m_nl80211_client->get_iface_with_link_idx(
+            base_iface + "##" + std::to_string(radio_idx), local_link_iface)) {
+        LOG(DEBUG) << "No local MLO link found for " << base_iface
+                   << " on radio index " << radio_idx;
+        return false;
+    }
+
+    const std::string expected_iface =
+        base_iface + "_link" + std::to_string(event_link_id);
+
+    if (local_link_iface != expected_iface) {
+        LOG(DEBUG) << "Ignoring STA_Connected for foreign MLO link: local="
+                   << local_link_iface << ", event=" << expected_iface;
+        return false;
+    }
+
+    resolved_iface = local_link_iface;
+    return true;
+}
