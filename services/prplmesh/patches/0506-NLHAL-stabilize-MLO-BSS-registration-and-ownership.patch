+++ b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
@@ -21,6 +21,7 @@
 #include <easylogging++.h>
 
 #include <algorithm>
+#include <cctype>
 #include <chrono>
 #include <cmath>
 #include <cstring>
@@ -1852,6 +1853,66 @@ bool mon_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
     switch (event) {
 
     case Event::STA_Connected: {
+        const std::string event_iface = interface;
+
+        int event_link_id = -1;
+        const auto from_global_it =
+            parsed_obj.find(EVENT_PARAM_FROM_GLOBAL_SOCK);
+        const bool from_global_sock =
+            from_global_it != parsed_obj.end() &&
+            from_global_it->second == "1";
+
+        if (from_global_sock) {
+            const auto linkid_it = parsed_obj.find("LINKID");
+            if (linkid_it != parsed_obj.end() && !linkid_it->second.empty() &&
+                std::all_of(linkid_it->second.begin(), linkid_it->second.end(),
+                            [](unsigned char c) { return std::isdigit(c); })) {
+                event_link_id = beerocks::string_utils::stoi(linkid_it->second);
+            }
+        }
+
+        int interface_link_id = -1;
+        extractLinkId(event_iface, interface_link_id);
+
+        if (event_link_id < 0) {
+            event_link_id = interface_link_id;
+        }
+
+        if (event_link_id >= 0 && interface_link_id >= 0 &&
+            event_link_id != interface_link_id) {
+            LOG(DEBUG) << "STA_Connected link mismatch: iface=" << event_iface
+                       << ", event_link_id=" << event_link_id
+                       << ", interface_link_id=" << interface_link_id;
+            return true;
+        }
+
+        std::string base_iface;
+        extractLinkBaseInterface(event_iface, base_iface);
+
+        std::string expected_iface = event_iface;
+        if (event_link_id >= 0 && !base_iface.empty()) {
+            expected_iface =
+                base_iface + "_link" + std::to_string(event_link_id);
+        }
+
+        int owned_vap_id = get_vap_id_with_bss(expected_iface);
+
+        // SLO may use the base interface even when LINKID=0 is reported.
+        if (owned_vap_id < 0 && event_iface == base_iface) {
+            owned_vap_id = get_vap_id_with_bss(base_iface);
+        }
+
+        if (owned_vap_id < 0) {
+            LOG(DEBUG) << "Ignoring STA_Connected for foreign link: iface="
+                       << event_iface << ", link_id=" << event_link_id
+                       << ", expected_iface=" << expected_iface;
+            return true;
+        }
+
+        // Override the generic first-link fallback with the exact local VAP.
+        vap_id = owned_vap_id;
+        LOG(DEBUG) << "Accepted STA_Connected: iface=" << expected_iface
+                   << ", link_id=" << event_link_id << ", vap_id=" << vap_id;
 
         // TODO: Change to HAL objects
         auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION));
