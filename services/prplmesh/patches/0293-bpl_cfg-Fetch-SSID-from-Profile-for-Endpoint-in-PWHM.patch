From b3ef418efec9517e8121c453a88a969f4581f26d Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Thu, 23 Jul 2026 12:19:19 +0530
Subject: [PATCH] bpl_cfg: Fetch SSID from Profile for Endpoint in PWHM

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../platform/bpl/cfg/dm/bpl_cfg_wifi.cpp      | 71 ++++++++-----------
 1 file changed, 31 insertions(+), 40 deletions(-)

diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
index 898b685fd..af5b9a932 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
@@ -59,49 +59,30 @@ static AmbiorixVariantSmartPtr bpl_cfg_get_wifi_radio_object(const AmbiorixVaria
     return m_ambiorix_cl.get_object(wbapi_utils::get_path_radio_reference(ap_obj));
 }
 
+static std::string bpl_cfg_get_wifi_endpoint_profile_path(const std::string &iface,
+                                                           const std::string &profile_alias)
+{
+    return wbapi_utils::search_path_ep_profiles_by_iface(iface) + "[Alias == '" + profile_alias +
+           "'].";
+}
+
+static AmbiorixVariantSmartPtr bpl_cfg_get_wifi_endpoint_profile_object(const std::string &iface,
+                                                                        const std::string &profile_alias)
+{
+    return m_ambiorix_cl.get_object(bpl_cfg_get_wifi_endpoint_profile_path(iface, profile_alias));
+}
+
 static AmbiorixVariantSmartPtr bpl_cfg_get_wifi_security_object(const std::string &iface)
 {
-    // First, try to get Security object for AccessPoint (AP interface)
-    auto ap_sec_obj = m_ambiorix_cl.get_object(wbapi_utils::search_path_ap_by_iface(iface) + "Security.");
-    if (ap_sec_obj) {
-        MAPF_DBG("Found AP Security object for interface: " << iface);
-        return ap_sec_obj;
-    }
-
-    // If not found as AP, try to get Security object for EndPoint (STA interface)
-    // For EndPoint, we need to find the Profile with Alias "prplMesh" and return its Security object
-    MAPF_DBG("Interface " << iface << " not found as AP, trying as EndPoint (STA)");
-
-    // Get the EndPoint object for this interface
-    auto ep_path = wbapi_utils::search_path_ep_by_iface(iface);
-    auto ep_obj = m_ambiorix_cl.get_object(ep_path);
-    if (!ep_obj) {
-        MAPF_ERR("Failed to find EndPoint object for interface: " << iface);
-        return nullptr;
-    }
-
-    // Get all profiles for this EndPoint
-    auto profiles_path = wbapi_utils::search_path_ep_profiles_by_iface(iface);
-    auto profiles = m_ambiorix_cl.get_object_multi<AmbiorixVariantMapSmartPtr>(profiles_path);
-    if (!profiles) {
-        MAPF_ERR("Failed to get profiles for EndPoint interface: " << iface);
-        return nullptr;
-    }
-
-    // Find the profile with Alias "prplMesh"
-    for (auto const &it : *profiles) {
-        auto &profile = it.second;
-        std::string alias;
-        if (profile.read_child(alias, "Alias") && alias == "prplMesh") {
-            // Found prplMesh profile, return its Security object
-            std::string profile_sec_path = it.first + "Security.";
-            MAPF_DBG("Found Profile with Alias 'prplMesh' Security object at: " << profile_sec_path);
-            return m_ambiorix_cl.get_object(profile_sec_path);
-        }
+    // AccessPoint interface: Security object lives directly under the AccessPoint
+    auto sec_obj = m_ambiorix_cl.get_object(wbapi_utils::search_path_ap_by_iface(iface) + "Security.");
+    if (sec_obj) {
+        return sec_obj;
     }
 
-    MAPF_ERR("No Profile with Alias 'prplMesh' found for EndPoint interface: " << iface);
-    return nullptr;
+    // EndPoint interface: Security object lives under its "prplMesh" Profile
+    return m_ambiorix_cl.get_object(bpl_cfg_get_wifi_endpoint_profile_path(iface, "prplMesh") +
+                                     "Security.");
 }
 
 int cfg_get_all_prplmesh_wifi_interfaces(BPL_WLAN_IFACE *interfaces, int *num_of_interfaces)
@@ -308,11 +289,21 @@ bool bpl_cfg_get_wifi_credentials(const std::string &iface,
 
     auto sec_obj = bpl_cfg_get_wifi_security_object(iface);
     if (!sec_obj) {
+        LOG(ERROR) << "Failed to get security obj of iface " << iface;
         return false;
     }
 
     configuration.bssid = tlvf::mac_from_string(wbapi_utils::get_ssid_mac(*ssid_obj));
-    ssid_obj->read_child(configuration.ssid, "SSID");
+
+    // An EndPoint interface has a Profile with Alias "prplMesh"; an AccessPoint does not.
+    auto profile_obj = bpl_cfg_get_wifi_endpoint_profile_object(iface, "prplMesh");
+    if (profile_obj) {
+        // EndPoint interface: Fetch SSID from its Profile
+        profile_obj->read_child(configuration.ssid, "SSID");
+    } else {
+        // AccessPoint interface: Fetch SSID from the SSID object
+        ssid_obj->read_child(configuration.ssid, "SSID");
+    }
 
     std::string mode_enabled;
     if (sec_obj->read_child(mode_enabled, "ModeEnabled")) {
-- 
2.34.1

