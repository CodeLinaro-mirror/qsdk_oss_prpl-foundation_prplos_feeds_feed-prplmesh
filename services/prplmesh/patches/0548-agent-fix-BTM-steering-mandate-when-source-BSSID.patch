From 0e945eaead2c52b8b03025c7231ef7f43b5f47d3 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Sat, 17 Oct 2026 11:44:59 +0530
Subject: [PATCH] Agent: fix BTM steering mandate dropping request on BSSID
 mismatch

When the agent receives a CLIENT_STEERING_REQUEST (Steering Mandate)
whose source BSSID does not match the BSSID currently tracked for the
STA in the agent DB (e.g. after a roam, or when the controller sends
a wildcard-target request with source_bssid=wlan1 while the agent DB
still shows the STA on wlan2), the previous code rejected the request
with error code STA_NOT_ASSOCIATED_WITH_ANY_BSS_OPERATED_BY_THE_AGENT
and sent no BTM Report.

The Airties DV test_11v_command_3 exercises exactly this scenario:
source BSSID = 02:03:7f:4e:70:cb, target BSSID = ff:ff:ff:ff:ff:ff
(wildcard, op-class 115, channel 0).  No BTM Report was observed in
the pcap, causing the test to fail.

Fix: remove the !is_requested_bssid_mld_partner rejection.  Forward
the BTM request as received to the ap_manager that owns the source
BSSID specified in the TLV.  Only reject if the STA is not associated
to any BSS operated by this agent at all.

The HAL-level wildcard-target fix in ap_wlan_hal_whm::sta_bss_steer()
(omitting target/channel from pWHM sendBssTransferRequest when target
BSSID is ff:ff:ff:ff:ff:ff) was already present; this change ensures
the request reaches the HAL instead of being dropped at validation.

Fixes: Airties DV test_11v_command_3 (no BTM Report in pcap)

Files changed:
  agent/src/beerocks/slave/son_slave_thread.cpp

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp | 36 ++++++++-----------
 1 file changed, 15 insertions(+), 21 deletions(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index bda6b8c03..93d36c87a 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -8235,27 +8235,21 @@ bool slave_thread::handle_client_steering_request(ieee1905_1::CmduMessageRx &cmd
         }
 
         if (!sta_info.is_requested_bssid_mld_partner) {
-            LOG(ERROR) << "BTM Steering: STA " << sta_mac
-                       << " is associated to BSSID " << sta_info.associated_link_mac
-                       << " which is not the requested BSSID " << source_bssid
-                       << " or its partner link";
-            if (!cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE)) {
-                LOG(ERROR) << "cmdu creation of type ACK_MESSAGE, has failed";
-                return false;
-            }
-            auto error_code_tlv = cmdu_tx.addClass<wfa_map::tlvErrorCode>();
-            if (!error_code_tlv) {
-                LOG(ERROR) << "addClass wfa_map::tlvErrorCode has failed";
-                return false;
-            }
-            error_code_tlv->reason_code() =
-                wfa_map::tlvErrorCode::STA_NOT_ASSOCIATED_WITH_ANY_BSS_OPERATED_BY_THE_AGENT;
-            error_code_tlv->sta_mac() = sta_mac;
-            LOG(DEBUG) << "sending ACK message back to controller with mid: " << std::hex << mid;
-            return send_cmdu_to_controller({}, cmdu_tx);
-        }
-
-        // Both checks passed - proceed with steering request
+            // STA is associated to a different BSSID on this agent than the requested
+            // source BSSID (e.g. after a roam, or a wildcard-target BTM request where
+            // the controller sends source_bssid=wlan1 but the agent DB still shows the
+            // STA on wlan2). Per Multi-AP spec §17.1.33, if the STA is associated to
+            // any BSS operated by the agent the BTM Request must still be sent.
+            // Forward the request as received — using the source BSSID from the TLV —
+            // to the ap_manager that owns that BSSID. Do NOT redirect to the actual
+            // associated radio; the controller's view of the topology is authoritative.
+            LOG(INFO) << "BTM Steering: STA " << sta_mac
+                      << " tracked on BSSID " << sta_info.associated_link_mac
+                      << " but request specifies source BSSID " << source_bssid
+                      << " — forwarding BTM request as received to source BSSID radio";
+        }
+
+        // Validation passed - proceed with steering request
         LOG(DEBUG) << "BTM Steering: Validation passed for STA " << sta_mac
                    << ", forwarding request to driver";
 
-- 
2.34.1

