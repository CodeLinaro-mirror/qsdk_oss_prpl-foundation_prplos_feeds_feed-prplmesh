From 4cdbf3e16f179f65470750002c9dfa1928497545 Mon Sep 17 00:00:00 2001
From: Ameya Phadke <phadke@qti.qualcomm.com>
Date: Mon, 21 Sep 2026 22:20:53 -0700
Subject: [PATCH] Use macros for NeighborDB event IDs

Signed-off-by: Ameya Phadke <phadke@qti.qualcomm.com>
---
 common/beerocks/bwl/include/bwl/slave_wlan_hal.h |  6 +++---
 common/beerocks/bwl/include/bwl/smd_nbr_db_tlv.h | 10 ++++++----
 2 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/common/beerocks/bwl/include/bwl/slave_wlan_hal.h b/common/beerocks/bwl/include/bwl/slave_wlan_hal.h
index 9286d3d72..7ec7a3092 100644
--- a/common/beerocks/bwl/include/bwl/slave_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/slave_wlan_hal.h
@@ -31,9 +31,9 @@ public:
 
         // SMD Events
         SMD_Roaming_Completed,
-        SMD_NbrDbSetResp,    // EVT_ID_NEIGHBOR_DB_SET_RESP (0x0081) received
-        SMD_NbrDbGetResp,    // EVT_ID_NEIGHBOR_DB_GET_RESP (0x0082) received
-        SMD_NbrDbClearResp,  // EVT_ID_NEIGHBOR_DB_CLEAR_RESP (0x0083) received
+        SMD_NbrDbSetResp,    // EVT_ID_NEIGHBOR_DB_SET_RESP (0x8201) received
+        SMD_NbrDbGetResp,    // EVT_ID_NEIGHBOR_DB_GET_RESP (0x8202) received
+        SMD_NbrDbClearResp,  // EVT_ID_NEIGHBOR_DB_CLEAR_RESP (0x8203) received
 
         // DPP-over-TCP relay events
         Dpp_Client_Connected,
diff --git a/common/beerocks/bwl/include/bwl/smd_nbr_db_tlv.h b/common/beerocks/bwl/include/bwl/smd_nbr_db_tlv.h
index 1d7b8fecb..6fbc13699 100644
--- a/common/beerocks/bwl/include/bwl/smd_nbr_db_tlv.h
+++ b/common/beerocks/bwl/include/bwl/smd_nbr_db_tlv.h
@@ -44,15 +44,17 @@ static constexpr uint16_t TLV_GLOBAL_MSG_ID_TYPE = 0x8001;
 static constexpr uint16_t TLV_GLOBAL_MSG_ID_LEN  = 2;
 static constexpr size_t   MSG_HDR_SIZE           = 6; // type(2) + len(2) + value(2)
 
-// MSG_IDs encode FEATURE nibble (bits 14:8) | OPERATION (bits 7:0).
+// MSG_IDs encode DIR bit (bit 15) | FEATURE nibble (bits 14:8) | OPERATION (bits 7:0).
 // MQTT_FEAT_SMD = 2 per hostapd mqtt_feature_map.h, so all SMD CMDs have high byte 0x02.
 static constexpr uint16_t CMD_ID_NEIGHBOR_DB_SET   = 0x0201;
 static constexpr uint16_t CMD_ID_NEIGHBOR_DB_GET   = 0x0202;
 static constexpr uint16_t CMD_ID_NEIGHBOR_DB_CLEAR = 0x0203;
 
-static constexpr uint16_t EVT_ID_NEIGHBOR_DB_SET_RESP   = 0x0081;
-static constexpr uint16_t EVT_ID_NEIGHBOR_DB_GET_RESP   = 0x0082;
-static constexpr uint16_t EVT_ID_NEIGHBOR_DB_CLEAR_RESP = 0x0083;
+// EVT_IDs mirror hostapd's MQTT_EVT_ID(MQTT_FEAT_SMD, op) macro output
+// (DIR bit 0x8000 | FEATURE 0x02 << 8 | op) per mqtt_feature_map.h.
+static constexpr uint16_t EVT_ID_NEIGHBOR_DB_SET_RESP   = 0x8201;
+static constexpr uint16_t EVT_ID_NEIGHBOR_DB_GET_RESP   = 0x8202;
+static constexpr uint16_t EVT_ID_NEIGHBOR_DB_CLEAR_RESP = 0x8203;
 
 // ---------------------------------------------------------------------------
 // Status codes
