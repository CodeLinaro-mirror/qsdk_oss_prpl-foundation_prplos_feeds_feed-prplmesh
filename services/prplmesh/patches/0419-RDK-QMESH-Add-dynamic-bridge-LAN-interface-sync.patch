 #include <btl/broker_client_factory_factory.h>
 #include <easylogging++.h>
 
@@ -336,6 +342,74 @@ bool BackhaulManager::thread_init()
         return false;
     }
 
+#ifdef BEEROCKS_RDKB
+    // Build a NETLINK_ROUTE listener and BridgeStateManager so we can react to bridge
+    // membership changes (RTM_NEWLINK) instead of polling. When a new interface is attached
+    // to the bridge at runtime (e.g. a veth pair brought up by a co-located controller),
+    // sync_bridge_lan_interfaces() updates db->ethernet.lan so link metric responses and
+    // topology reports cover all bridge members from that point on.
+    {
+        auto netlink_socket = std::make_shared<beerocks::net::NetlinkRouteSocket>();
+        // client is stack-local and used only for bind(); the fd stays open because
+        // netlink_socket is kept alive by connection -> netlink_listener below.
+        beerocks::net::ClientSocketImpl<beerocks::net::NetlinkRouteSocket> client(netlink_socket);
+        if (client.bind(beerocks::net::NetlinkAddress(RTMGRP_LINK))) {
+            auto connection =
+                std::make_shared<beerocks::net::SocketConnectionImpl>(netlink_socket);
+            auto netlink_listener =
+                std::make_shared<beerocks::net::NetlinkEventListenerImpl>(connection, m_event_loop);
+            auto monitor =
+                std::make_unique<beerocks::net::BridgeStateMonitorImpl>(netlink_listener);
+            auto reader = std::make_unique<beerocks::net::BridgeStateReaderImpl>();
+            m_bridge_state_manager = std::make_shared<beerocks::net::BridgeStateManagerImpl>(
+                std::move(monitor), std::move(reader));
+            transaction.add_rollback_action([&]() { m_bridge_state_manager.reset(); });
+            m_bridge_state_manager->set_handler(
+                [this](const std::string &bridge_name, const std::string &iface_name,
+                       bool iface_added) {
+                    auto db = AgentDB::get();
+                    if (bridge_name != db->bridge.iface_name) {
+                        return;
+                    }
+                    if (iface_added) {
+                        LOG(DEBUG) << "Bridge member added: " << iface_name << " -> "
+                                   << bridge_name << "; refreshing LAN interface list";
+                        sync_bridge_lan_interfaces();
+                    } else {
+                        LOG(DEBUG) << "Bridge member removed: " << iface_name << " from "
+                                   << bridge_name << "; removing from LAN interface list";
+                        auto &lan = db->ethernet.lan;
+                        auto it = std::find_if(lan.begin(), lan.end(), [&](const auto &port) {
+                            return port.iface_name == iface_name;
+                        });
+                        if (it != lan.end()) {
+                            LOG(INFO) << "LAN interface dynamically removed: " << iface_name;
+                            lan.erase(it);
+                        }
+                    }
+                });
+
+            // Prime the BridgeStateManagerImpl cache so that bridge netlink events are not
+            // silently discarded. The manager only forwards events for bridges whose state has
+            // been read at least once (cache-gate in bridge_state_manager_impl.cpp).
+            std::string bridge_iface;
+            std::set<std::string> initial_bridge_members;
+            auto bridge_state_ok =
+                bpl::cfg_get_private_bridge_iface(bridge_iface) &&
+                m_bridge_state_manager->read_state(bridge_iface, initial_bridge_members);
+            LOG_IF(!bridge_state_ok, ERROR)
+                << "Unable to read initial bridge state for " << bridge_iface
+                << "; bridge netlink events will be silently discarded";
+            LOG_IF(bridge_state_ok, INFO)
+                << "Bridge state event monitor started for " << bridge_iface
+                << " (" << initial_bridge_members.size() << " initial members)";
+        } else {
+            LOG(WARNING) << "Failed to bind NETLINK_ROUTE socket; bridge member changes will "
+                            "not update db->ethernet.lan dynamically";
+        }
+    }
+#endif
+
     transaction.commit();
 
     LOG(DEBUG) << "started";
@@ -349,6 +423,15 @@ void BackhaulManager::on_thread_stop()
         m_cmdu_server->disconnect(m_agent_fd);
     }
 
+#ifdef BEEROCKS_RDKB
+    // clear_handler() deregisters the lambda before the shared_ptr refcount drops,
+    // ensuring no callback fires during teardown.
+    if (m_bridge_state_manager) {
+        m_bridge_state_manager->clear_handler();
+        m_bridge_state_manager.reset();
+    }
+#endif
+
     while (m_radios_info.size() > 0) {
         auto radio_info = m_radios_info.back();
         if (radio_info) {
@@ -5823,6 +5906,56 @@ bool BackhaulManager::is_collocated_veth_wired_onboarding() const
     return true;
 }
 
+#ifdef BEEROCKS_RDKB
+void BackhaulManager::sync_bridge_lan_interfaces()
+{
+    // In RDKB co-located controller+agent setups, interfaces such as veth pairs may be
+    // attached to the bridge dynamically at runtime (after agent startup). The static
+    // read_platform_configuration() only captures interfaces present at boot time, so
+    // any interface added later would be missing from db->ethernet.lan. This function
+    // is called from the bridge state event handler when a new interface is added to the
+    // bridge, ensuring topology reporting and link metric response cover all bridge members.
+    auto db = AgentDB::get();
+
+    // Physical ethernet interfaces from bridge (same filter as read_platform_configuration).
+    auto lan_ifaces = beerocks::net::network_utils::linux_get_lan_interfaces();
+    for (const auto &iface : lan_ifaces) {
+        std::string iface_mac;
+        if (!beerocks::net::network_utils::linux_iface_get_mac(iface, iface_mac)) {
+            continue;
+        }
+        auto mac = tlvf::mac_from_string(iface_mac);
+        auto it  = std::find_if(db->ethernet.lan.begin(), db->ethernet.lan.end(),
+                                [&](const auto &port) { return port.iface_name == iface; });
+        if (it == db->ethernet.lan.end()) {
+            db->ethernet.lan.emplace_back(iface, mac);
+            LOG(INFO) << "LAN interface dynamically added: " << iface << " - " << iface_mac;
+        }
+    }
+
+    // veth interfaces from config (same as read_platform_configuration BEEROCKS_RDKB block).
+    std::vector<std::string> veth_ifaces;
+    if (!bpl::cfg_get_veth_ifaces(veth_ifaces)) {
+        LOG(WARNING) << "Failed to read veth interfaces from config; skipping veth LAN sync";
+        return;
+    }
+    for (const auto &veth_iface : veth_ifaces) {
+        std::string iface_mac;
+        if (!beerocks::net::network_utils::linux_iface_get_mac(veth_iface, iface_mac)) {
+            continue;
+        }
+        auto mac = tlvf::mac_from_string(iface_mac);
+        auto it  = std::find_if(db->ethernet.lan.begin(), db->ethernet.lan.end(),
+                                [&](const auto &port) { return port.iface_name == veth_iface; });
+        if (it == db->ethernet.lan.end()) {
+            db->ethernet.lan.emplace_back(veth_iface, mac);
+            LOG(INFO) << "veth LAN interface dynamically added: " << veth_iface
+                      << " - " << iface_mac;
+        }
+    }
+}
+#endif
+
 bool BackhaulManager::select_gateway_reachable_eth_interface(std::string &selected_iface)
 {
     auto db = AgentDB::get();
