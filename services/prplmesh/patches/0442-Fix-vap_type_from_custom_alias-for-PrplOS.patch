From: nushanth <nushanth@qti.qualcomm.com>
Date: Thu, 17 Sep 2026 13:22:06 +0530
Subject: [PATCH] Fix vap_type_from_custom_alias for PrplOS

Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 framework/platform/wbapi/wbapi_utils.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/framework/platform/wbapi/wbapi_utils.cpp b/framework/platform/wbapi/wbapi_utils.cpp
index d4cafc5..924b10f 100644
--- a/framework/platform/wbapi/wbapi_utils.cpp
+++ b/framework/platform/wbapi/wbapi_utils.cpp
@@ -254,7 +254,7 @@ WSC::eWscEncr wbapi_utils::encryption_type_from_auth(WSC::eWscAuth auth)

 eVapType wbapi_utils::vap_type_from_custom_alias(const std::string &custom_alias)
 {
-#ifdef USE_PRPLMESH_WHM
+#ifdef USE_PRPLMESH_NLHAL
     std::string alias_lc = custom_alias;
     std::transform(alias_lc.begin(), alias_lc.end(), alias_lc.begin(),
                    [](unsigned char c) { return std::tolower(c); });
