+
+class ScopedRegistryLock {
+public:
+    ScopedRegistryLock()
+    {
+        m_fd = open(registry_path().c_str(), O_CREAT | O_RDWR | O_CLOEXEC, 0644);
+        if (m_fd < 0) {
+            return;
+        }
+
+        struct flock lock {};
+        lock.l_type   = F_WRLCK;
+        lock.l_whence = SEEK_SET;
+        lock.l_start  = 0;
+        lock.l_len    = 0;
+
+        const auto deadline = std::chrono::steady_clock::now() + REGISTRY_LOCK_TIMEOUT;
+        while (true) {
+            const int ret = fcntl(m_fd, F_SETLK, &lock);
+            if (ret == 0) {
+                m_locked = true;
+                return;
+            }
+            if (errno != EAGAIN && errno != EACCES && errno != EINTR) {
+                break;
+            }
+            if (std::chrono::steady_clock::now() >= deadline) {
+                break;
+            }
+            std::this_thread::sleep_for(REGISTRY_LOCK_POLL_INTERVAL);
+        }
+
+        close(m_fd);
+        m_fd = -1;
+    }
+
+    ~ScopedRegistryLock()
+    {
+        if (m_fd < 0) {
+            return;
+        }
+
+        if (m_locked) {
+            struct flock lock {};
+            lock.l_type   = F_UNLCK;
+            lock.l_whence = SEEK_SET;
+            lock.l_start  = 0;
+            lock.l_len    = 0;
+            fcntl(m_fd, F_SETLK, &lock);
+        }
+        close(m_fd);
+    }
+
+    bool valid() const { return m_fd >= 0 && m_locked; }
+    int fd() const { return m_fd; }
+
+private:
+    int m_fd       = -1;
+    bool m_locked  = false;
+};
