+bool read_registry(int fd, std::vector<Reservation> &reservations,
+                   std::vector<RangeReservation> &ranges)
+{
+    reservations.clear();
+    ranges.clear();
+    if (lseek(fd, 0, SEEK_SET) < 0) {
+        return false;
+    }
+
+    std::string content;
+    char buffer[512];
+    while (true) {
+        const ssize_t bytes_read = read(fd, buffer, sizeof(buffer));
+        if (bytes_read == 0) {
+            break;
+        }
+        if (bytes_read < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        content.append(buffer, static_cast<size_t>(bytes_read));
+    }
+
+    std::istringstream input(content);
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream line_stream(line);
+        std::string record_type;
+        if (!(line_stream >> record_type)) {
+            continue;
+        }
+
+        if (record_type == "R") {
+            RangeReservation range {};
+            std::string addresses;
+            if (!(line_stream >> range.pid >> range.owner_id >> addresses) ||
+                !owner_is_alive(range.pid) || range.owner_id.empty() || addresses.empty()) {
+                continue;
+            }
+
+            std::stringstream address_stream(addresses);
+            std::string address;
+            while (std::getline(address_stream, address, ',')) {
+                std::string normalized;
+                if (normalize_mac_address(address, normalized)) {
+                    range.addresses.push_back(normalized);
+                }
+            }
+            if (!range.addresses.empty()) {
+                ranges.push_back(std::move(range));
+            }
+            continue;
+        }
+
+        Reservation reservation {};
+        if (record_type == "A") {
+            if (!(line_stream >> reservation.pid >> reservation.radio_id >> reservation.mac_address)) {
+                continue;
+            }
+        } else {
+            // The first token was the legacy PID.
+            std::istringstream pid_stream(record_type);
+            if (!(pid_stream >> reservation.pid)) {
+                continue;
+            }
+            std::string rest;
+            std::getline(line_stream, rest);
+            std::istringstream legacy_stream(rest);
+            if (!(legacy_stream >> reservation.radio_id >> reservation.mac_address)) {
+                continue;
+            }
+        }
+
+        if (owner_is_alive(reservation.pid) && !reservation.radio_id.empty() &&
+            !reservation.mac_address.empty()) {
+            std::string normalized;
+            if (normalize_mac_address(reservation.mac_address, normalized)) {
+                reservation.mac_address = normalized;
+                reservations.push_back(std::move(reservation));
+            }
+        }
+    }
+    return true;
+}
+
+bool write_registry(int fd, const std::vector<Reservation> &reservations,
+                    const std::vector<RangeReservation> &ranges)
+{
+    std::ostringstream output;
+    for (const auto &reservation : reservations) {
+        output << "A " << reservation.pid << ' ' << reservation.radio_id << ' '
+               << reservation.mac_address << '\n';
+    }
+    for (const auto &range : ranges) {
+        output << "R " << range.pid << ' ' << range.owner_id << ' ';
+        for (size_t index = 0; index < range.addresses.size(); ++index) {
+            if (index != 0) {
+                output << ',';
+            }
+            output << range.addresses[index];
+        }
+        output << '\n';
+    }
+
+    const std::string content = output.str();
+    if (ftruncate(fd, 0) < 0 || lseek(fd, 0, SEEK_SET) < 0) {
+        return false;
+    }
+
+    size_t offset = 0;
+    while (offset < content.size()) {
+        const ssize_t bytes_written =
+            write(fd, content.data() + offset, content.size() - offset);
+        if (bytes_written < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        offset += static_cast<size_t>(bytes_written);
+    }
+    return true;
+}
+
+} // namespace
+
+bool normalize_mac_address(const std::string &value, std::string &normalized)
+{
+    if (value.empty()) {
+        return false;
+    }
+
+    const auto mac = tlvf::mac_from_string(value);
+    if (mac == beerocks::net::network_utils::ZERO_MAC) {
+        return false;
+    }
+
+    normalized = tlvf::mac_to_string(mac);
+    return !normalized.empty();
+}
+
+void sync_addresses(const std::string &owner_id, const std::set<std::string> &addresses)
+{
+    if (owner_id.empty()) {
+        return;
+    }
+
+    ScopedRegistryLock lock;
+    if (!lock.valid()) {
+        return;
+    }
+
+    std::vector<Reservation> reservations;
+    std::vector<RangeReservation> ranges;
+    if (!read_registry(lock.fd(), reservations, ranges)) {
+        return;
+    }
+
+    const pid_t current_pid = getpid();
+    reservations.erase(std::remove_if(reservations.begin(), reservations.end(),
+                                      [&](const Reservation &reservation) {
+                                          return reservation.pid == current_pid &&
+                                                 reservation.radio_id == owner_id;
+                                      }),
+                       reservations.end());
+
+    for (const auto &mac_address : addresses) {
+        std::string normalized_mac_address;
+        if (normalize_mac_address(mac_address, normalized_mac_address)) {
+            reservations.push_back({current_pid, owner_id, normalized_mac_address});
+        }
+    }
+
+    write_registry(lock.fd(), reservations, ranges);
+}
+
+void sync_mld_addresses(const std::string &radio_id,
+                        const std::set<std::string> &mld_addresses)
+{
+    sync_ap_addresses(radio_id, mld_addresses);
+}
+
+void sync_ap_addresses(const std::string &radio_id,
+                       const std::set<std::string> &ap_addresses)
+{
+    sync_addresses("ap:" + radio_id, ap_addresses);
+}
+
+void sync_sta_addresses(const std::string &sta_iface,
+                        const std::set<std::string> &sta_addresses)
+{
+    sync_addresses("sta:" + sta_iface, sta_addresses);
+}
+
+bool is_address_reserved(const std::string &mac_address)
+{
+    std::string normalized_mac_address;
+    if (!normalize_mac_address(mac_address, normalized_mac_address)) {
+        return false;
+    }
+
+    ScopedRegistryLock lock;
+    if (!lock.valid()) {
+        return false;
+    }
+
+    std::vector<Reservation> reservations;
+    std::vector<RangeReservation> ranges;
+    if (!read_registry(lock.fd(), reservations, ranges)) {
+        return false;
+    }
+
+    for (const auto &reservation : reservations) {
+        if (reservation.mac_address == normalized_mac_address) {
+            return true;
+        }
+    }
+    for (const auto &range : ranges) {
+        if (std::find(range.addresses.begin(), range.addresses.end(), normalized_mac_address) !=
+            range.addresses.end()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool is_address_reserved_by_other(const std::string &owner_id,
+                                  const std::string &mac_address)
+{
+    std::string normalized_mac_address;
+    if (!normalize_mac_address(mac_address, normalized_mac_address)) {
+        return false;
+    }
+
+    ScopedRegistryLock lock;
+    if (!lock.valid()) {
+        return false;
+    }
+
+    std::vector<Reservation> reservations;
+    std::vector<RangeReservation> ranges;
+    if (!read_registry(lock.fd(), reservations, ranges)) {
+        return false;
+    }
+
+    const pid_t current_pid = getpid();
+    const std::string reservation_owner = "ap:" + owner_id;
+    for (const auto &reservation : reservations) {
+        if (reservation.mac_address == normalized_mac_address &&
+            !(reservation.pid == current_pid && reservation.radio_id == reservation_owner)) {
+            return true;
+        }
+    }
+    for (const auto &range : ranges) {
+        if (range.owner_id != reservation_owner &&
+            std::find(range.addresses.begin(), range.addresses.end(), normalized_mac_address) !=
+                range.addresses.end()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool claim_bssid_range(const std::string &owner_id,
+                       const std::vector<std::vector<std::string>> &candidate_ranges,
+                       std::vector<std::string> &assigned_range)
+{
+    assigned_range.clear();
+    if (owner_id.empty() || candidate_ranges.empty()) {
+        return false;
+    }
+
+    ScopedRegistryLock lock;
+    if (!lock.valid()) {
+        return false;
+    }
+
+    std::vector<Reservation> reservations;
+    std::vector<RangeReservation> ranges;
+    if (!read_registry(lock.fd(), reservations, ranges)) {
+        return false;
+    }
+
+    const pid_t current_pid = getpid();
+    const std::string range_owner = "ap:" + owner_id;
+
+    // A manager keeps the same range for its lifetime. This is important when the local pool is
+    // rebuilt after a hostapd reconfiguration: changing the range would make already configured
+    // BSSIDs appear to belong to a different radio. Discard an old/malformed record rather than
+    // allowing a previous implementation to expand this manager's allocation beyond 16 entries.
+    for (auto range_it = ranges.begin(); range_it != ranges.end();) {
+        if (range_it->pid == current_pid && range_it->owner_id == range_owner) {
+            const std::set<std::string> unique_addresses(range_it->addresses.begin(),
+                                                         range_it->addresses.end());
+            if (range_it->addresses.size() == MAX_BSSID_ADDRESSES_PER_RADIO &&
+                unique_addresses.size() == MAX_BSSID_ADDRESSES_PER_RADIO) {
+                assigned_range = range_it->addresses;
+                return true;
+            }
+            range_it = ranges.erase(range_it);
+        } else {
+            ++range_it;
+        }
+    }
+
+    std::set<std::string> used_by_other_managers;
+    for (const auto &reservation : reservations) {
+        if (!(reservation.pid == current_pid && reservation.radio_id == range_owner)) {
+            used_by_other_managers.insert(reservation.mac_address);
+        }
+    }
+
+    std::set<std::string> range_addresses;
+    for (const auto &range : ranges) {
+        if (!(range.pid == current_pid && range.owner_id == range_owner)) {
+            range_addresses.insert(range.addresses.begin(), range.addresses.end());
+        }
+    }
+
+    for (const auto &candidate : candidate_ranges) {
+        std::vector<std::string> normalized_candidate;
+        std::set<std::string> candidate_set;
+        bool valid = candidate.size() == MAX_BSSID_ADDRESSES_PER_RADIO;
+        for (const auto &address : candidate) {
+            std::string normalized;
+            if (!normalize_mac_address(address, normalized) ||
+                !candidate_set.insert(normalized).second) {
+                valid = false;
+                break;
+            }
+            normalized_candidate.push_back(normalized);
+        }
+
+        if (!valid || candidate_set.size() != candidate.size()) {
+            continue;
+        }
+
+        bool overlaps = false;
+        for (const auto &address : candidate_set) {
+            if (used_by_other_managers.count(address) != 0 ||
+                range_addresses.count(address) != 0) {
+                overlaps = true;
+                break;
+            }
+        }
+        if (overlaps) {
+            continue;
+        }
+
+        ranges.push_back({current_pid, range_owner, normalized_candidate});
+        if (!write_registry(lock.fd(), reservations, ranges)) {
+            return false;
+        }
+        assigned_range = std::move(normalized_candidate);
+        return true;
+    }
+
+    return false;
+}
+
+} // namespace bssid_pool_registry
+} // namespace nl80211
+} // namespace bwl
