+
+/**
+ * Build disjoint range candidates for one radio.  The first-octet high bits and the second
+ * octet provide the global range number; the remaining bytes come from the radio's preferred
+ * BSSID base.  Each candidate is still generated with the normal MBSSID/non-MBSSID transform,
+ * so all addresses in one range retain the prefix rules expected by hostapd.
+ */
+static std::vector<std::vector<std::string>> build_bssid_range_candidates(
+    sMacAddr preferred_base, size_t radio_count, bool mbssid, int mbssid_group_size)
+{
+    std::vector<std::vector<std::string>> candidates;
+
+    // Create one global candidate slot per currently configured radio manager. Each slot contains
+    // exactly the 16 BSSID addresses available to one radio. Only the selected slot is persisted
+    // and exposed to this radio manager.
+    const size_t range_candidate_count = std::max<size_t>(1, radio_count);
+    candidates.reserve(range_candidate_count);
+    for (size_t range_id = 0; range_id < range_candidate_count; ++range_id) {
+        auto range_base = preferred_base;
+        range_base.oct[0] = static_cast<uint8_t>(((range_id & 0x3) << 6) |
+                                                  (preferred_base.oct[0] & 0x3c) | 0x2);
+        range_base.oct[1] = static_cast<uint8_t>(preferred_base.oct[1] ^ (range_id >> 2));
+
+        std::vector<std::string> range;
+        range.reserve(bssid_pool_registry::MAX_BSSID_ADDRESSES_PER_RADIO);
+        range.push_back(tlvf::mac_to_string(range_base));
+        for (int idx = 1;
+             idx < static_cast<int>(bssid_pool_registry::MAX_BSSID_ADDRESSES_PER_RADIO); ++idx) {
+            range.push_back(tlvf::mac_to_string(
+                derive_bssid_pool_address(range_base, idx, mbssid, mbssid_group_size)));
+        }
+        candidates.push_back(std::move(range));
+    }
+    return candidates;
