+void sta_wlan_hal_nl80211::sync_bssid_pool_reservations(const parsed_obj_map_t &status)
+{
+    if (m_sta_registry_iface.empty()) {
+        return;
+    }
+
+    std::set<std::string> addresses;
+    std::string normalized_address;
+    if (bssid_pool_registry::normalize_mac_address(status.count("address")
+                                                        ? status.at("address")
+                                                        : std::string(),
+                                                    normalized_address)) {
+        addresses.insert(normalized_address);
+    }
+
+    std::string normalized_ap_mld_address;
+    const bool has_ap_mld_address =
+        bssid_pool_registry::normalize_mac_address(status.count("ap_mld_addr")
+                                                       ? status.at("ap_mld_addr")
+                                                       : std::string(),
+                                                   normalized_ap_mld_address);
+    if (!has_ap_mld_address) {
+        // Without a valid AP MLD address, this is a non-MLO/disconnected snapshot. Any old
+        // affiliated-link reservations must therefore be released, while the local STA address
+        // remains reserved when STATUS still reports it.
+        bssid_pool_registry::sync_sta_addresses(m_sta_registry_iface, addresses);
+        m_sta_reservation_snapshot_valid = true;
+        return;
+    }
+
+    addresses.insert(normalized_ap_mld_address);
+
+    parsed_obj_listed_map_t mlo_status;
+    if (!wpa_ctrl_send_msg("MLO_STATUS", mlo_status, m_sta_registry_iface)) {
+        // Do not replace a known complete MLO snapshot with a partial one while supplicant is
+        // transiently restarting/reconfiguring. If this is the first snapshot, retain at least
+        // the STA and AP MLD reservations; a later successful MLO_STATUS replaces them with the
+        // complete link set.
+        if (!m_sta_reservation_snapshot_valid) {
+            bssid_pool_registry::sync_sta_addresses(m_sta_registry_iface, addresses);
+            m_sta_reservation_snapshot_valid = true;
+        }
+        LOG(DEBUG) << __func__ << " MLO_STATUS failed for " << m_sta_registry_iface
+                   << ", retaining previous STA address reservation snapshot";
+        return;
+    }
+
+    for (const auto &entry : mlo_status) {
+        for (const auto &field : entry) {
+            if (field.first != "sta_link_addr" && field.first.find("sta_link_addr[") != 0) {
+                continue;
+            }
+
+            std::string normalized_link_address;
+            if (bssid_pool_registry::normalize_mac_address(field.second,
+                                                            normalized_link_address)) {
+                addresses.insert(normalized_link_address);
+            }
+        }
+    }
+
+    bssid_pool_registry::sync_sta_addresses(m_sta_registry_iface, addresses);
+    m_sta_reservation_snapshot_valid = true;
+}
