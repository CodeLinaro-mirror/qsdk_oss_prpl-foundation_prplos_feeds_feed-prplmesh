+        // Keep the monitor from interpreting the intentionally empty authoritative hostapd
+        // config as a permanent no-VAP/disabled state while a valid M2 re-enable is waiting for
+        // the powersave settle interval or is being applied.  Teardown-only updates do not set
+        // this guard because no VAP can legitimately appear from those credentials.
+        const bool has_valid_vap_credentials = std::any_of(
+            bss_info_conf_list.begin(), bss_info_conf_list.end(),
+            [](const son::wireless_utils::sBssInfoConf &bss) {
+                return !bss.teardown && !bss.ssid.empty();
+            });
+        std::unique_ptr<ScopedAtomicFlagReset> pending_vap_configuration_guard;
+        if (has_valid_vap_credentials) {
+            m_vap_configuration_pending->store(true, std::memory_order_release);
+            pending_vap_configuration_guard =
+                std::make_unique<ScopedAtomicFlagReset>(*m_vap_configuration_pending);
+            LOG(DEBUG) << "Valid M2 VAP credentials pending on " << m_iface
+                       << " - monitor will preserve radio_disable until update completes";
+        }
