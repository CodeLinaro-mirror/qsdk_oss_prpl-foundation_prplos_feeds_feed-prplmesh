+bool bpl_cfg_set_radio_mac_by_phy(const std::string &phy_name, const std::string &mac)
+{
+    if (phy_name.empty() || mac.empty()) {
+        LOG(ERROR) << "bpl_cfg_set_radio_mac_by_phy: empty PHY or MAC";
+        return false;
+    }
+
+    std::string section_name;
+    if (!uci_find_section_by_option("prplmesh", "wifi-device", "phy_name", phy_name,
+                                    section_name) ||
+        section_name.empty()) {
+        LOG(ERROR) << "bpl_cfg_set_radio_mac_by_phy: no wifi-device section for phy_name="
+                   << phy_name;
+        return false;
+    }
+
+    OptionsUnorderedMap options;
+    options["macaddr"] = mac;
+    if (!uci_set_section("prplmesh", "wifi-device", section_name, options, true)) {
+        LOG(ERROR) << "bpl_cfg_set_radio_mac_by_phy: failed to persist macaddr=" << mac
+                   << " for " << section_name;
+        return false;
+    }
+
+    LOG(INFO) << "bpl_cfg_set_radio_mac_by_phy: persisted RUID " << mac << " for " << phy_name;
+    return true;
+}
