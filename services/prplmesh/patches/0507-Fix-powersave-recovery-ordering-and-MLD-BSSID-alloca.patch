+int base_wlan_hal_nl80211::refresh_wpa_ctrl_interface(const std::string &interface)
+{
+    if (interface.empty()) {
+        return beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+
+    // The pathname can be unchanged while hostapd has replaced the underlying Unix socket.
+    // Reconnecting only the command socket is insufficient because the event socket and its
+    // poll fd may refer to the old endpoint as well. Remove the complete mapping first; the
+    // wpa_ctrl_client destructor path closes both sockets and unregisters the event fd.
+    if (m_wpa_ctrl_client.has_interface(interface)) {
+        LOG(INFO) << "Refreshing recreated WPA ctrl sockets for " << interface;
+        if (!m_wpa_ctrl_client.del_interface(interface)) {
+            LOG(WARNING) << "Could not remove stale WPA ctrl mapping for " << interface;
+        }
+    }
+
+    // A recreated netdev may have a new ifindex even when its name is unchanged. Force
+    // add_interface() to resolve the current index instead of reusing the cached one.
+    std::string base_iface_name;
+    extractLinkBaseInterface(interface, base_iface_name);
+    m_iface_index.erase(base_iface_name);
+
+    // ADD BSS is sent through the global socket, and hostapd creates the dedicated socket
+    // asynchronously. Do not let add_interface() fall back to the global socket for a newly
+    // created BSS: STATUS is a per-interface command and would then fail even though the path
+    // appears a moment later.
+    if (interface != global_iface) {
+        std::string ctrl_dir;
+        const auto path_pos = m_hal_conf.wpa_ctrl_path.find_last_of('/');
+        if (path_pos != std::string::npos) {
+            ctrl_dir = m_hal_conf.wpa_ctrl_path.substr(0, path_pos + 1);
+        }
+        if (ctrl_dir.empty()) {
+            ctrl_dir = "/var/run/hostapd/";
+        }
+
+        const auto dedicated_path = ctrl_dir + interface;
+        bool dedicated_socket_ready = false;
+        constexpr int CTRL_SOCKET_READY_RETRIES = 10;
+        constexpr auto CTRL_SOCKET_READY_DELAY = std::chrono::milliseconds(100);
+        for (int attempt = 0; attempt < CTRL_SOCKET_READY_RETRIES; ++attempt) {
+            if (beerocks::os_utils::wpa_ctrl_skt_exists(dedicated_path)) {
+                dedicated_socket_ready = true;
+                break;
+            }
+            if (attempt + 1 < CTRL_SOCKET_READY_RETRIES) {
+                std::this_thread::sleep_for(CTRL_SOCKET_READY_DELAY);
+            }
+        }
+
+        if (!dedicated_socket_ready) {
+            LOG(WARNING) << "Dedicated WPA ctrl socket did not appear for recreated interface "
+                         << interface << " at " << dedicated_path;
+            return beerocks::net::FileDescriptor::invalid_descriptor;
+        }
+    }
+
+    return add_interface(interface);
+}
