+#ifndef _BWL_NL80211_BSSID_POOL_REGISTRY_H_
+#define _BWL_NL80211_BSSID_POOL_REGISTRY_H_
+
+#include <set>
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace bwl {
+namespace nl80211 {
+namespace bssid_pool_registry {
+
+// The NL80211 AP implementation allocates a fixed 16-address BSSID range to each
+// radio manager. A manager must never claim or expose a larger range.
+constexpr std::size_t MAX_BSSID_ADDRESSES_PER_RADIO = 16;
+
+/**
+ * @brief Normalize a hostapd MAC value and reject empty/zero addresses.
+ */
+bool normalize_mac_address(const std::string &value, std::string &normalized);
+
+/**
+ * @brief Legacy alias for replacing AP-side addresses reported by one radio manager.
+ */
+void sync_mld_addresses(const std::string &radio_id,
+                        const std::set<std::string> &mld_addresses);
+
+/**
+ * @brief Replace all AP-side addresses reported by one radio manager.
+ *
+ * The set must include ordinary BSSIDs as well as AP MLD addresses.  Keeping both in the
+ * shared namespace prevents a zero-VAP radio from reusing a BSSID that is already live on
+ * another radio.
+ */
+void sync_ap_addresses(const std::string &radio_id,
+                       const std::set<std::string> &ap_addresses);
+
+/**
+ * @brief Replace the station-side addresses reported by one supplicant interface.
+ *
+ * The set may contain the local STA MLD address, its affiliated link addresses, and the
+ * associated AP MLD address. All entries share the same global reservation namespace as AP MLD
+ * addresses so an AP BSSID candidate cannot collide with any of them.
+ */
+void sync_sta_addresses(const std::string &sta_iface,
+                        const std::set<std::string> &sta_addresses);
+
+/**
+ * @brief Check whether an address is reserved by any AP or STA manager.
+ */
+bool is_address_reserved(const std::string &mac_address);
+
+/**
+ * @brief Check whether an address is reserved by a different manager.
+ */
+bool is_address_reserved_by_other(const std::string &owner_id,
+                                  const std::string &mac_address);
+
+/**
+ * @brief Claim one globally disjoint BSSID range for an AP radio manager.
+ *
+ * @param owner_id Stable AP owner identity, normally the phy name.
+ * @param candidate_ranges Ordered 16-address range candidates generated for this radio. The
+ *                         first range that does not overlap another live range or address
+ *                         reservation wins.
+ * @param assigned_range Existing range is returned for an already-registered owner.
+ */
+bool claim_bssid_range(const std::string &owner_id,
+                       const std::vector<std::vector<std::string>> &candidate_ranges,
+                       std::vector<std::string> &assigned_range);
+
+/**
+ * @brief Backward-compatible name for callers that only deal with AP MLD addresses.
+ */
+inline bool is_mld_address_reserved(const std::string &mac_address)
+{
+    return is_address_reserved(mac_address);
+}
+
+} // namespace bssid_pool_registry
+} // namespace nl80211
+} // namespace bwl
+
+#endif // _BWL_NL80211_BSSID_POOL_REGISTRY_H_
