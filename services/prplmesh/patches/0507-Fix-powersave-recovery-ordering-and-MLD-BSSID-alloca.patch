+/**
+ * Derive one address from the generated AP BSSID pool.
+ *
+ * This transformation is used both before onboarding (when a colliding RUID is
+ * replaced) and when the pool is populated after hostapd has attached.
+ */
+static sMacAddr derive_bssid_pool_address(sMacAddr candidate_base, int idx, bool mbssid,
+                                          int mbssid_group_size)
+{
+    int bss_idx = idx;
+
+    int maxbssid_ind  = 0;
+    int num_bss_nontx = mbssid ? mbssid_group_size - 1 : 0;
+    while (num_bss_nontx > 0) {
+        maxbssid_ind++;
+        num_bss_nontx >>= 1;
+    }
+
+    const int maxbssid = std::pow(2, maxbssid_ind);
+    if (mbssid && bss_idx >= maxbssid) {
+        candidate_base.oct[5] = ((candidate_base.oct[5] >> maxbssid_ind)
+                                 << maxbssid_ind);
+        candidate_base.oct[5] += (bss_idx / maxbssid) * maxbssid;
+        bss_idx %= maxbssid;
+    }
+
+    if (mbssid) {
+        const int size = maxbssid;
+        const int B    = candidate_base.oct[5] % size;
+        const int loct = candidate_base.oct[5];
+        candidate_base.oct[0] |= 2;
+        candidate_base.oct[5] = loct - B + ((B + bss_idx) % size);
+    } else {
+        // The generated pool uses the locally-administered bit and then advances
+        // the first octet in the same way as the original pool implementation.
+        if (!(candidate_base.oct[0] & 2)) {
+            bss_idx--;
+        }
+        candidate_base.oct[0] |= 2;
+        candidate_base.oct[0] ^= bss_idx << 2;
+    }
+
+    return candidate_base;
+}
