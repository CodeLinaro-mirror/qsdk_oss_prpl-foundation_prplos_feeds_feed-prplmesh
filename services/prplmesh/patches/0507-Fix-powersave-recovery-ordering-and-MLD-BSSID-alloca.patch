+constexpr auto REGISTRY_LOCK_TIMEOUT       = std::chrono::seconds(2);
+constexpr auto REGISTRY_LOCK_POLL_INTERVAL = std::chrono::milliseconds(20);
+
+std::string registry_path()
+{
+#ifdef BEEROCKS_TMP_PATH
+    return std::string(BEEROCKS_TMP_PATH) + "/bssid_pool_mld_reservations";
+#else
