 #include "mlo_utils.h"
 #include <bwl/assoc_frame_db.h>
 #include <bcl/beerocks_os_utils.h>
+#include <bcl/beerocks_string_utils.h>
 #include <bcl/beerocks_utils.h>
 #include <bcl/network/network_utils.h>
 #include <bcl/son/son_assoc_frame_utils.h>
@@ -8693,6 +8694,54 @@ bool ap_wlan_hal_nl80211::configure_service_priority(const uint8_t *data)
     return false;
 }
 
+bool ap_wlan_hal_nl80211::handle_qos_management_descriptor(
+    const sMacAddr &bssid, uint16_t qmid, const sMacAddr &client_mac,
+    const sMacAddr &peer_mac,
+    const std::vector<uint8_t> &descriptor_element)
+{
+    auto vap_id = get_vap_id_with_mac(tlvf::mac_to_string(bssid));
+    if (!check_vap_id(vap_id)) {
+        LOG(ERROR) << "handle_qos_management_descriptor: invalid vap_id for bssid " << bssid;
+        return false;
+    }
+    const std::string ifname = m_radio_info.available_vaps[vap_id].bss;
+
+    if (descriptor_element.empty() || descriptor_element.size() > 256) {
+        LOG(ERROR) << "handle_qos_management_descriptor: invalid descriptor length "
+                   << descriptor_element.size() << " (must be 1..256) for bssid " << bssid;
+        return false;
+    }
+
+    if (qmid > 0xFF) {
+        LOG(ERROR) << "handle_qos_management_descriptor: qmid " << qmid
+                   << " out of range (must be <= 0xFF) for bssid " << bssid;
+        return false;
+    }
+
+    const auto descriptor_hex = beerocks::string_utils::bytes_to_hex_string(
+        descriptor_element.data(), descriptor_element.size());
+
+    // SCS_CONFIGURE <peer_mac> <scs_sta_mac> <qm_id> <scs_desc_hex>
+    // peer_mac    -> bSTA MAC of the immediate downstream agent through which
+    //               the client is reachable (resolved by the caller from
+    //               AgentDB::remote_stations).
+    // scs_sta_mac -> the end client STA MAC
+    const std::string cmd = "SCS_CONFIGURE " + tlvf::mac_to_string(peer_mac) + " " +
+                            tlvf::mac_to_string(client_mac) + " " + std::to_string(qmid) + " " +
+                            descriptor_hex;
+
+    if (!wpa_ctrl_send_msg(cmd, ifname)) {
+        LOG(ERROR) << "handle_qos_management_descriptor: SCS_CONFIGURE failed on " << ifname
+                   << " (peer=" << peer_mac << " sta=" << client_mac << " qmid=" << qmid << ")";
+        return false;
+    }
+
+    LOG(DEBUG) << "handle_qos_management_descriptor: programmed SCS descriptor on " << ifname
+               << " (peer=" << peer_mac << " sta=" << client_mac << " qmid=" << qmid
+               << " desc_len=" << descriptor_element.size() << ")";
+    return true;
+}
+
 bool ap_wlan_hal_nl80211::set_hop_count(uint8_t hop_count)
 {
     LOG(DEBUG) << "Setting hop_count=" << int(hop_count) << " on radio " << get_iface_name();
