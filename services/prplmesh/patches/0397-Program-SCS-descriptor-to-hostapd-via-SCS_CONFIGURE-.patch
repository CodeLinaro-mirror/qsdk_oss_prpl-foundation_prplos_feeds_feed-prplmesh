@@ -2961,6 +2961,8 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             return;
         }
 
+        const sMacAddr peer_mac = msg->peer_mac();
+
         auto descriptor_tlvs = cmdu_rx.getClassList<wfa_map::tlvQoSManagementDescriptor>();
         if (descriptor_tlvs.empty()) {
             LOG(ERROR) << "No tlvQoSManagementDescriptor found";
@@ -2995,7 +2997,7 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
             if (!ap_wlan_hal->handle_qos_management_descriptor(
                     descriptor_tlv->bssid(), descriptor_tlv->qmid(), descriptor_tlv->client_mac(),
-                    descriptor_element)) {
+                    peer_mac, descriptor_element)) {
                 LOG(ERROR) << "handle_qos_management_descriptor failed for BSSID "
                            << descriptor_tlv->bssid() << ", client "
                            << descriptor_tlv->client_mac();
diff --git a/agent/src/beerocks/slave/tasks/service_prioritization_task.cpp b/agent/src/beerocks/slave/tasks/service_prioritization_task.cpp
index 1c1112681..e70240617 100644
--- a/agent/src/beerocks/slave/tasks/service_prioritization_task.cpp
+++ b/agent/src/beerocks/slave/tasks/service_prioritization_task.cpp
@@ -401,13 +401,25 @@ bool ServicePrioritizationTask::handle_qos_management_descriptors(
             return false;
         }
 
+        /*
+         * Resolve the bSTA MAC of the immediate downstream agent through which
+         * this client is reachable.  For a directly-associated client the entry
+         * is absent from remote_stations; use the client MAC itself as peer_mac
+         * (hostapd treats it as a directly-connected STA).
+         */
+        sMacAddr peer_mac = descriptor_tlv->client_mac();
+        auto rs_it = db->remote_stations.find(descriptor_tlv->client_mac());
+        if (rs_it != db->remote_stations.end()) {
+            peer_mac = rs_it->second.bsta_mac;
+        }
+
         auto descriptor_request = message_com::create_vs_message<
             beerocks_message::cACTION_APMANAGER_QOS_MANAGEMENT_DESCRIPTOR_REQUEST>(m_cmdu_tx);
         if (!descriptor_request) {
             LOG(ERROR) << "Failed building QoS management descriptor request";
             return false;
         }
-        (void)descriptor_request;
+        descriptor_request->peer_mac() = peer_mac;
 
         auto descriptor_out = m_cmdu_tx.addClass<wfa_map::tlvQoSManagementDescriptor>();
         if (!descriptor_out) {
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
