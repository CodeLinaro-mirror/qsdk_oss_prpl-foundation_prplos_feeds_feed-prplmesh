+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -738,11 +738,17 @@ public:
      * @param [in] bssid BSSID for which the descriptor applies.
      * @param [in] qmid QoS Management ID assigned by the controller.
      * @param [in] client_mac Client MAC address.
+     * @param [in] peer_mac bSTA MAC of the immediate downstream agent through
+     *             which the client is reachable.  For a directly-associated
+     *             client this equals the client_mac.  For a remote client
+     *             behind a downstream agent this is the bSTA MAC reported in
+     *             AgentDB::remote_stations.
      * @param [in] descriptor_element SCS/MSCS descriptor element bytes.
      * @return true on success or false on error.
      */
     virtual bool handle_qos_management_descriptor(const sMacAddr &bssid, uint16_t qmid,
                                                   const sMacAddr &client_mac,
+                                                  const sMacAddr &peer_mac,
                                                   const std::vector<uint8_t> &descriptor_element)
     {
         return false;
