diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index 57e1759b9..0a97d5a6e 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -70,6 +70,165 @@
 #include <math.h>
 namespace bwl {
 
+namespace {
+
+constexpr size_t EXT_CAP_QOS_MAP_BYTE         = 4;
+constexpr uint8_t EXT_CAP_QOS_MAP_MASK        = 0x01;
+constexpr size_t EXT_CAP_SCS_BYTE             = 6;
+constexpr uint8_t EXT_CAP_SCS_MASK            = 0x40;
+constexpr size_t EXT_CAP_MSCS_BYTE            = 10;
+constexpr uint8_t EXT_CAP_MSCS_MASK           = 0x20;
+constexpr size_t EHT_MAC_QM_SCS_TRAFFIC_BYTE  = 0;
+constexpr uint8_t EHT_MAC_QM_SCS_TRAFFIC_MASK = 0x20;
+constexpr uint32_t QCA_VENDOR_OUI             = 0x001374;
+constexpr uint32_t QCA_NL80211_VENDOR_SUBCMD_SCS_RULE_CONFIG = 218;
+
+static void update_qos_management_support_from_ext_capa(nl80211_client::radio_info &radio_info,
+                                                        const uint8_t *ext_capability,
+                                                        size_t actual_length,
+                                                        const std::string &source)
+{
+    const uint8_t qos_map_byte =
+        (actual_length > EXT_CAP_QOS_MAP_BYTE) ? ext_capability[EXT_CAP_QOS_MAP_BYTE] : 0;
+    const uint8_t scs_byte =
+        (actual_length > EXT_CAP_SCS_BYTE) ? ext_capability[EXT_CAP_SCS_BYTE] : 0;
+    const uint8_t mscs_byte =
+        (actual_length > EXT_CAP_MSCS_BYTE) ? ext_capability[EXT_CAP_MSCS_BYTE] : 0;
+
+    radio_info.qos_map_supported |= (qos_map_byte & EXT_CAP_QOS_MAP_MASK);
+    radio_info.scs_supported |= (scs_byte & EXT_CAP_SCS_MASK);
+    radio_info.mscs_supported |= (mscs_byte & EXT_CAP_MSCS_MASK);
+
+    LOG(DEBUG) << "QoS management " << source << ": ext_capa_len=" << actual_length
+               << " byte[" << EXT_CAP_QOS_MAP_BYTE << "]=0x" << std::hex
+               << int(qos_map_byte) << " byte[" << EXT_CAP_SCS_BYTE << "]=0x" << int(scs_byte)
+               << " byte[" << EXT_CAP_MSCS_BYTE << "]=0x" << int(mscs_byte) << std::dec
+               << " => qos_map=" << radio_info.qos_map_supported
+               << " scs=" << radio_info.scs_supported << " mscs=" << radio_info.mscs_supported;
+}
+
+static void update_qos_map_support_from_supported_commands(nl80211_client::radio_info &radio_info,
+                                                           struct nlattr *supported_commands)
+{
+    if (!supported_commands) {
+        LOG(DEBUG) << "QoS management NL80211_ATTR_SUPPORTED_COMMANDS not present";
+        return;
+    }
+
+    struct nlattr *nl_cmd;
+    int rem_cmd;
+    bool found_set_qos_map = false;
+    bool found_frame          = false;
+    bool found_register_frame = false;
+    size_t command_count      = 0;
+
+    nla_for_each_nested(nl_cmd, supported_commands, rem_cmd) {
+        command_count++;
+        switch (nla_get_u32(nl_cmd)) {
+        case NL80211_CMD_SET_QOS_MAP:
+            found_set_qos_map = true;
+            radio_info.qos_map_supported = true;
+            break;
+        case NL80211_CMD_FRAME:
+            found_frame = true;
+            break;
+        case NL80211_CMD_REGISTER_FRAME:
+            found_register_frame = true;
+            break;
+        default:
+            break;
+        }
+    }
+
+    radio_info.dscp_policy_supported |= found_frame && found_register_frame;
+
+    LOG(DEBUG) << "QoS management NL80211_ATTR_SUPPORTED_COMMANDS: command_count="
+               << command_count << " SET_QOS_MAP(" << NL80211_CMD_SET_QOS_MAP
+               << ")=" << found_set_qos_map << " FRAME(" << NL80211_CMD_FRAME
+               << ")=" << found_frame << " REGISTER_FRAME(" << NL80211_CMD_REGISTER_FRAME
+               << ")=" << found_register_frame << " => qos_map="
+               << radio_info.qos_map_supported << " dscp_policy="
+               << radio_info.dscp_policy_supported;
+}
+
+static void update_qos_management_support_from_vendor_data(nl80211_client::radio_info &radio_info,
+                                                           struct nlattr *vendor_data)
+{
+    if (!vendor_data) {
+        LOG(DEBUG) << "QoS management NL80211_ATTR_VENDOR_DATA not present";
+        return;
+    }
+
+    struct nlattr *nl_vendor;
+    int rem_vendor;
+    bool found_qca_scs_rule_config = false;
+    size_t vendor_command_count    = 0;
+
+    nla_for_each_nested(nl_vendor, vendor_data, rem_vendor) {
+        vendor_command_count++;
+        if (nla_len(nl_vendor) != sizeof(struct nl80211_vendor_cmd_info)) {
+            LOG(DEBUG) << "QoS management vendor command entry has unexpected len="
+                       << nla_len(nl_vendor) << " expected="
+                       << sizeof(struct nl80211_vendor_cmd_info);
+            continue;
+        }
+
+        auto *vendor_cmd =
+            static_cast<const struct nl80211_vendor_cmd_info *>(nla_data(nl_vendor));
+        if (vendor_cmd->vendor_id == QCA_VENDOR_OUI &&
+            vendor_cmd->subcmd == QCA_NL80211_VENDOR_SUBCMD_SCS_RULE_CONFIG) {
+            found_qca_scs_rule_config = true;
+            break;
+        }
+    }
+
+    radio_info.scs_supported |= found_qca_scs_rule_config;
+    radio_info.mscs_supported |= found_qca_scs_rule_config;
+    radio_info.qm_scs_traffic_description_supported |= found_qca_scs_rule_config;
+
+    LOG(DEBUG) << "QoS management NL80211_ATTR_VENDOR_DATA: vendor_command_count="
+               << vendor_command_count << " QCA_SCS_RULE_CONFIG("
+               << QCA_NL80211_VENDOR_SUBCMD_SCS_RULE_CONFIG << ")="
+               << found_qca_scs_rule_config << " => scs=" << radio_info.scs_supported
+               << " mscs=" << radio_info.mscs_supported
+               << " qm_scs_traffic_description="
+               << radio_info.qm_scs_traffic_description_supported;
+}
+
+static void update_traffic_separation_support_from_iftypes(nl80211_client::radio_info &radio_info,
+                                                           struct nlattr *supported_iftypes)
+{
+    if (!supported_iftypes) {
+        LOG(DEBUG) << "AP Radio Advanced Capabilities NL80211_ATTR_SUPPORTED_IFTYPES not present";
+        return;
+    }
+
+    struct nlattr *nl_iftype;
+    int rem_iftype;
+    bool ap_supported      = false;
+    bool ap_vlan_supported = false;
+
+    nla_for_each_nested(nl_iftype, supported_iftypes, rem_iftype) {
+        if (nla_type(nl_iftype) == NL80211_IFTYPE_AP) {
+            ap_supported = true;
+        } else if (nla_type(nl_iftype) == NL80211_IFTYPE_AP_VLAN) {
+            ap_vlan_supported = true;
+        }
+    }
+
+    radio_info.traffic_separation_combined_front_back_supported |= ap_supported;
+    radio_info.traffic_separation_combined_profile1_profile2_supported |=
+        ap_supported && ap_vlan_supported;
+
+    LOG(DEBUG) << "AP Radio Advanced Capabilities NL80211_ATTR_SUPPORTED_IFTYPES: AP="
+               << ap_supported << " AP_VLAN=" << ap_vlan_supported
+               << " => combined_front_back="
+               << radio_info.traffic_separation_combined_front_back_supported
+               << " combined_profile1_and_profile2="
+               << radio_info.traffic_separation_combined_profile1_profile2_supported;
+}
