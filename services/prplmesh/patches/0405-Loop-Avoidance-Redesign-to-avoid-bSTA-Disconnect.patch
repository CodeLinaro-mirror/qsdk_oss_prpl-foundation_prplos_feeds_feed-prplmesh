+bool sta_wlan_hal_dwpal::pin_bssid(const sMacAddr &bssid)
+{
+    if (m_active_network_id < 0) {
+        LOG(ERROR) << "Failed pinning bssid on interface " << get_iface_name()
+                   << ": no active network";
+        return false;
+    }
+    return set_network(m_active_network_id, "bssid", tlvf::mac_to_string(bssid));
+}
+
+bool sta_wlan_hal_dwpal::unpin_bssid()
+{
+    if (m_active_network_id < 0) {
+        LOG(ERROR) << "Failed unpinning bssid on interface " << get_iface_name()
+                   << ": no active network";
+        return false;
+    }
+    return set_network(m_active_network_id, "bssid", "any");
+}
+
+bool sta_wlan_hal_dwpal::disconnect_backhaul_sta() { return disconnect(); }
+
+bool sta_wlan_hal_dwpal::reconnect_backhaul_sta()
+{
+    if (m_active_network_id < 0) {
+        LOG(ERROR) << "Failed reconnecting backhaul sta on interface " << get_iface_name()
+                   << ": no active network";
+        return false;
+    }
+    return enable_network(m_active_network_id);
+}
+
+bool sta_wlan_hal_dwpal::is_disconnected() { return !is_connected(); }
+
+static WiFiSec wsc_to_wifi_sec(WSC::eWscAuth auth)
+{
+    using W = WSC::eWscAuth;
+
+    // OPEN
+    if (auth == W::WSC_AUTH_OPEN) {
+        return WiFiSec::None;
+    }
+
+    // WPA3 Transition (SAE + WPA2PSK)
+    if ((auth & W::WSC_AUTH_SAE) && (auth & W::WSC_AUTH_WPA2PSK)) {
+        return WiFiSec::WPA2_WPA3_PSK;
+    }
+
+    // WPA3 only
+    if (auth & W::WSC_AUTH_SAE) {
+        return WiFiSec::WPA3_PSK;
+    }
+
+    // WPA2
+    if (auth & W::WSC_AUTH_WPA2PSK) {
+        return WiFiSec::WPA2_PSK;
+    }
+
+    // Legacy WPA
+    if (auth & W::WSC_AUTH_WPAPSK) {
+        return WiFiSec::WPA_PSK;
+    }
+
+    return WiFiSec::Invalid;
+}
+
+bool sta_wlan_hal_dwpal::add_new_network(son::wireless_utils::sBssInfoConf bSta_conf)
+{
+    if (bSta_conf.ssid.empty()) {
+        LOG(ERROR) << "add_new_network(): empty BSTA SSID";
+        return false;
+    }
+
+    WiFiSec sec = wsc_to_wifi_sec(bSta_conf.authentication_type);
+    if (sec == WiFiSec::Invalid) {
+        LOG(ERROR) << "add_new_network(): invalid authentication type";
+        return false;
+    }
+
+    bool hidden_ssid = false;
+    if (bSta_conf.hidden_ssid != WSC::eWscVendorExtHiddenSsid::UNSET) {
+        hidden_ssid = static_cast<bool>(bSta_conf.hidden_ssid);
+    }
+
+    return connect(bSta_conf.ssid, bSta_conf.network_key, sec, false /* mem_only_psk */,
+                   (bSta_conf.bssid == beerocks::net::network_utils::ZERO_MAC)
+                       ? std::string("")
+                       : tlvf::mac_to_string(bSta_conf.bssid),
+                   ChannelFreqPair{0, eFreqType::FREQ_UNKNOWN}, hidden_ssid);
+}
