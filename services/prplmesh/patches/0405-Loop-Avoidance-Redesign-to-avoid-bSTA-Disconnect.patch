@@ -1311,12 +1311,9 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         if (!ap_wlan_hal->set_hop_count(hop_count)) {
             LOG(ERROR) << "Setting hop count failed on backhaul BSSes of radio " << m_iface;
         }
-        if (!notification->connected()) {
-            // Disconnect all bSTAs connected to this agent's backhaul BSSes
-            // This prevents loop formation when the agent tries to reconnect
-            LOG(INFO) << "Disconnecting all bSTAs from backhaul BSSes to prevent mesh loops";
-            disconnect_all_backhaul_stas();
-        }
+        // Downstream bSTAs stay connected across a backhaul disconnect/reconnect cycle
+        // (loop-avoidance now relies on BSSID pinning + WIRELESS_WAIT_FOR_RECONNECT, not
+        // on tearing down the fronthaul).
         return;
     }
     case beerocks_message::ACTION_APMANAGER_UPDATE_HIDDEN_SSID_REQUEST: {
@@ -5504,42 +5501,3 @@ void ApManager::start_csa_notification_timer(
             return true;
         });
 }
-
-void ApManager::disconnect_all_backhaul_stas()
-{
-    LOG(INFO) << "Disconnecting all bSTAs from backhaul BSSes on radio " << m_iface;
-
-    if (!ap_wlan_hal) {
-        LOG(WARNING) << "ap_wlan_hal not initialized, cannot disconnect bSTAs";
-        return;
-    }
-
-    const auto &vap_unordered_map = ap_wlan_hal->get_radio_info().available_vaps;
-
-    // Iterate through all VAPs and disconnect clients from backhaul BSSes
-    for (const auto &vap_entry : vap_unordered_map) {
-        const auto &vap = vap_entry.second;
-
-        // Only process backhaul BSSes
-        if (!vap.backhaul) {
-            continue;
-        }
-
-        LOG(INFO) << "Disconnecting all clients from backhaul BSS: " << vap.bss
-                  << " (BSSID: " << vap.mac << ")";
-
-        // Deauthenticate all stations on this backhaul BSS
-        // Using wildcard MAC address to disconnect all connected stations
-        if (!ap_wlan_hal->sta_deauth(vap_entry.first,
-                                     beerocks::net::network_utils::WILD_MAC_STRING,
-                                     wfa_map::tlvProfile2ReasonCode::LEAVING_NETWORK_DEAUTH)) {
-            LOG(ERROR) << "Failed to deauthenticate all stations from backhaul BSS "
-                       << vap.bss;
-        } else {
-            LOG(INFO) << "Successfully deauthenticated all stations from backhaul BSS "
-                      << vap.bss;
-        }
-    }
-
-    LOG(INFO) << "Completed disconnecting all bSTAs from backhaul BSSes";
-}
