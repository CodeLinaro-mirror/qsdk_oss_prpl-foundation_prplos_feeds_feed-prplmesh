+bool sta_wlan_hal_whm::pin_bssid(const sMacAddr &bssid)
+{
+    if (m_ep_path.empty() || m_active_profile_id <= 0) {
+        LOG(ERROR) << "pin_bssid(): no active profile/EP for iface " << get_iface_name();
+        return false;
+    }
+
+    std::string profile_path = m_ep_path + "Profile." + std::to_string(m_active_profile_id) + ".";
+    AmbiorixVariant params(AMXC_VAR_ID_HTABLE);
+    params.add_child("ForceBSSID", tlvf::mac_to_string(bssid));
+
+    if (!m_ambiorix_cl.update_object(profile_path, params)) {
+        LOG(ERROR) << "pin_bssid(): failed to set ForceBSSID on " << profile_path;
+        return false;
+    }
+
+    return true;
+}
+
+bool sta_wlan_hal_whm::unpin_bssid()
+{
+    if (m_ep_path.empty() || m_active_profile_id <= 0) {
+        LOG(ERROR) << "unpin_bssid(): no active profile/EP for iface " << get_iface_name();
+        return false;
+    }
+
+    std::string profile_path = m_ep_path + "Profile." + std::to_string(m_active_profile_id) + ".";
+    AmbiorixVariant params(AMXC_VAR_ID_HTABLE);
+    params.add_child("ForceBSSID", std::string());
+
+    if (!m_ambiorix_cl.update_object(profile_path, params)) {
+        LOG(ERROR) << "unpin_bssid(): failed to clear ForceBSSID on " << profile_path;
+        return false;
+    }
+
+    return true;
+}
