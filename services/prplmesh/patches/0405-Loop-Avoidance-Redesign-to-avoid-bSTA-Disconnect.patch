@@ -2065,6 +2065,17 @@ bool BackhaulManager::backhaul_fsm_wireless(bool &skip_select)
         if (now > state_time_stamp_timeout) {
             LOG(DEBUG) << "reconnect wait timed out";
 
+            // The reconnect timeout has elapsed - clear the BSSID pin so the bSTA is free
+            // to scan and connect to other BSSes instead of continuing to retry the same one.
+            {
+                auto db        = AgentDB::get();
+                auto iface_hal = get_wireless_hal(db->backhaul.selected_iface_name);
+                if (iface_hal && !iface_hal->unpin_bssid()) {
+                    LOG(ERROR) << "Failed to unpin bssid on iface "
+                               << db->backhaul.selected_iface_name;
+                }
+            }
+
             // Before scanning, check if ethernet is now available.
             if (try_switch_to_wired_backhaul()) {
                 break;
@@ -2933,6 +2944,21 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
             break;
         }
 
+        // Pin the bSTA to this BSSID so that, if it later gets disconnected, it keeps
+        // retrying the same node rather than roaming away immediately (loop-avoidance:
+        // gives the other agents' heartbeat mechanism a chance to detect loss of
+        // controller reachability before this bSTA connects elsewhere).
+        // Only pin if the BSSID is a valid unicast MAC - a zero/broadcast BSSID would
+        // otherwise pin the bSTA to an unusable address, blocking any real connection.
+        if (bssid != beerocks::net::network_utils::ZERO_MAC &&
+            bssid != beerocks::net::network_utils::WILD_MAC) {
+            if (!iface_hal->pin_bssid(bssid)) {
+                LOG(ERROR) << "Failed to pin bssid " << bssid << " on iface " << iface;
+            }
+        } else {
+            LOG(WARNING) << "Skipping pin_bssid: invalid BSSID " << bssid << " on iface " << iface;
+        }
+
         if (db->device_conf.certification_mode) {
             /* When the station is connected we wanted to enable
                3addr multicast packets entering the system.
@@ -3273,6 +3299,17 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
                 }
 #endif
 
+                // Re-assert the BSSID pin (defensively, in case it was not already set or
+                // was cleared) so that the bSTA keeps retrying this same node while we wait
+                // for reconnection below, instead of roaming away immediately.
+                if (db->backhaul.backhaul_bssid != beerocks::net::network_utils::ZERO_MAC) {
+                    auto iface_hal = get_wireless_hal(iface);
+                    if (iface_hal && !iface_hal->pin_bssid(db->backhaul.backhaul_bssid)) {
+                        LOG(ERROR) << "Failed to re-pin bssid " << db->backhaul.backhaul_bssid
+                                   << " on iface " << iface;
+                    }
+                }
+
                 if (m_backhaul_steering_bssid == beerocks::net::network_utils::ZERO_MAC) {
                     platform_notify_error(bpl::eErrorCode::BH_DISCONNECTED,
                                           "Backhaul disconnected on operational state");
