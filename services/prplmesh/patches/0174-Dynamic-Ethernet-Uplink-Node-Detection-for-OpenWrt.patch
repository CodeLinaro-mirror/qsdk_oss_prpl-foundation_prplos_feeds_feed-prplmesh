From 4d90782a987d2cb286deb2b6250859177a8a5ccd Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Mon, 25 May 2026 17:39:13 +0530
Subject: [PATCH] Dynamic Ethernet Uplink Node Detection for OpenWrt

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     | 152 +++++++++++++-----
 .../slave/backhaul_manager/backhaul_manager.h |  41 +++--
 2 files changed, 144 insertions(+), 49 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 12eb55471..0c0a6d62e 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -797,6 +797,14 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
         auto ifaces =
             beerocks::net::network_utils::linux_get_iface_list_from_bridge(db->bridge.iface_name);
 
+        std::string selected_eth_iface;
+        if(select_gateway_reachable_eth_interface(selected_eth_iface)) {
+            db->ethernet.wan.iface_name = selected_eth_iface;
+            LOG(DEBUG) << "Dynamically selected ETH interface " << db->ethernet.wan.iface_name << " for WIRED Backhaul";
+        } else {
+            LOG(WARNING) << "No ETH interface is gateway reachable for WIRED Backhaul";
+        }
+
         // If a wired (WAN) interface was provided, try it first, check if the interface is UP
         wan_monitor::ELinkState wired_link_state = wan_monitor::ELinkState::eInvalid;
         if (!db->device_conf.local_gw && !db->ethernet.wan.iface_name.empty()) {
@@ -888,19 +896,18 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
 
         if (!db->device_conf.local_gw) {
             if (db->ethernet.wan.iface_name.empty()) {
-                LOG(WARNING) << "WAN interface is empty on Repeater platform configuration!";
+                LOG(WARNING) << "WAN interface is empty!";
             }
             eth_link_poll_timer = std::chrono::steady_clock::now();
-            m_eth_link_up       = beerocks::net::network_utils::linux_iface_is_up_and_running(
-                db->ethernet.wan.iface_name) && is_ethernet_gateway_reachable();
+            m_eth_link_up       = beerocks::net::network_utils::linux_iface_is_up_and_running(db->ethernet.wan.iface_name)
+                                    && is_gateway_reachable_via_interface(db->ethernet.wan.iface_name);
             LOG(DEBUG) << "WIRED_BACKHAUL_INTERFACE STATE:" << m_eth_link_up << " SELECTED BACKHAUL: " << db->backhaul.connection_type;
         }
 
         // Added logic to disconnect the STA interface when backhaul_wired_iface is UP:
         // - If already in wired_backhaul FSM: simply disconnect the STA interface.
         // - If currently in wireless_backhaul FSM: disconnect the STA interface and transition to wired_backhaul FSM.
-        if (((!db->device_conf.local_gw) && wired_backhaul && !m_backhaul_switch) ||
-           ((!db->device_conf.local_gw) && (!wired_backhaul) && (m_eth_link_up))) {
+        if ((!db->device_conf.local_gw) && m_eth_link_up) {
             for (auto &radio_info : m_radios_info) {
                 auto radio = db->radio(radio_info->sta_iface);
                 if (!radio) {
@@ -986,29 +993,34 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
         //  * check if a timeout has expired to perform periodic actions.
         //  */
         auto db = AgentDB::get();
+        if (db->device_conf.local_gw) break;
 
         auto now = std::chrono::steady_clock::now();
 
-        if (!db->device_conf.local_gw) {
-            if (db->ethernet.wan.iface_name.empty()) {
-                LOG(WARNING) << "WAN interface is empty on Repeater platform configuration!";
-            }
         int time_elapsed_ms =
             std::chrono::duration_cast<std::chrono::milliseconds>(now - eth_link_poll_timer)
                 .count();
-        // //pooling eth link status every second to notice if there been a change.
+        // polling eth link status every second to notice if there been a change.
         if (time_elapsed_ms > POLL_TIMER_TIMEOUT_MS) {
 
             eth_link_poll_timer = now;
-            bool eth_link_up = beerocks::net::network_utils::linux_iface_is_up_and_running(db->ethernet.wan.iface_name);
-            if (eth_link_up != m_eth_link_up) {
-                // check if link is up and gateway is reachable
-                if (eth_link_up && !(is_ethernet_gateway_reachable())) {
-                    // if link is up but gateway not reachable
-                    LOG(DEBUG) << "ETH link is up, but gateway not reachable";
-                    break;
+            bool eth_link_up = false;
+
+            // Check if ethernet interface is up and gateway-reachable
+            if (m_eth_link_up) {
+                // wired backhaul
+                eth_link_up = beerocks::net::network_utils::linux_iface_is_up_and_running(db->ethernet.wan.iface_name) && is_gateway_reachable();
+            } else {
+                // wireless backhaul
+                std::string selected_eth_iface;
+                if (select_gateway_reachable_eth_interface(selected_eth_iface)) {
+                    db->ethernet.wan.iface_name = selected_eth_iface;
+                    eth_link_up = beerocks::net::network_utils::linux_iface_is_up_and_running(db->ethernet.wan.iface_name) && is_gateway_reachable_via_interface(db->ethernet.wan.iface_name);
                 }
-                //update the previous bh connection
+            }
+
+            if (eth_link_up != m_eth_link_up) {
+                // Update the previous bh connection
                 std::string timestamp = beerocks::os_utils::get_timestamp();
                 std::string msg =
                     "echo '" + timestamp + "Backhaul state change detected:' > /dev/console";
@@ -1020,7 +1032,7 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
                 } else {
                     m_prev_bh_connection = backhaul_connection::Wireless;
                 }
-                m_eth_link_up = beerocks::net::network_utils::linux_iface_is_up_and_running(db->ethernet.wan.iface_name);
+                m_eth_link_up = eth_link_up;
 
                 m_backhaul_switch = true;
 
@@ -1128,7 +1140,12 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
 
                 FSM_MOVE_STATE(RESTART);
             }
-        }
+
+            if (m_eth_link_up) {
+                LOG(INFO) << "Backhaul: Wired (" << db->ethernet.wan.iface_name << ")";
+            } else {
+                LOG(INFO) << "Backhaul: Wireless";
+            }
         }
         break;
     }
@@ -1823,7 +1840,7 @@ bwl::WiFiSec BackhaulManager::wsc_to_bwl_authentication(WSC::eWscAuth authtype)
     }
 }
 
-bool BackhaulManager::resolve_gateway_ip(std::string &gw_ip) const
+bool BackhaulManager::resolve_gateway_ip(std::string &gw_ip)
 {
     std::string cmd = "ip r | awk '/^def/{print $3}'";
     FILE *fp = popen(cmd.c_str(), "r");
@@ -1847,7 +1864,7 @@ bool BackhaulManager::resolve_gateway_ip(std::string &gw_ip) const
 }
 
 bool BackhaulManager::verify_route_via_wan(const std::string &gw_ip, const std::string &wan_iface,
-                                           const std::string &bridge_iface) const
+                                           const std::string &bridge_iface)
 {
     std::string route_check_cmd = "ip route get " + gw_ip + " 2>/dev/null";
     FILE *fp = popen(route_check_cmd.c_str(), "r");
@@ -1924,7 +1941,7 @@ bool BackhaulManager::verify_route_via_wan(const std::string &gw_ip, const std::
 }
 
 bool BackhaulManager::resolve_gateway_mac(const std::string &gw_ip, const std::string &bridge_iface,
-                                          std::string &gw_mac) const
+                                          std::string &gw_mac)
 {
     // Command to get full neighbor entry for debugging
     std::string neigh_cmd = "ip neigh show dev " + bridge_iface + " " + gw_ip + " 2>/dev/null";
@@ -2012,7 +2029,7 @@ bool BackhaulManager::resolve_gateway_mac(const std::string &gw_ip, const std::s
 }
 
 bool BackhaulManager::verify_gateway_on_wan_port(const std::string &gw_mac, const std::string &wan_iface,
-                                                 const std::string &bridge_iface) const
+                                                 const std::string &bridge_iface)
 {
     std::string fdb_cmd = "bridge fdb show br " + bridge_iface + " 2>/dev/null | grep -i '" + gw_mac + "'";
     FILE *fp = popen(fdb_cmd.c_str(), "r");
@@ -2055,7 +2072,7 @@ bool BackhaulManager::verify_gateway_on_wan_port(const std::string &gw_mac, cons
     return found_on_wan;
 }
 
-bool BackhaulManager::ping_gateway(const std::string &gw_ip) const
+bool BackhaulManager::ping_gateway(const std::string &gw_ip)
 {
     std::string ping_cmd = "ping -c 1 -W 1 " + gw_ip + " > /dev/null 2>&1";
     int ping_result = system(ping_cmd.c_str());
@@ -4283,45 +4300,100 @@ void BackhaulManager::create_sta_hal_for_bh_switching()
     }
 }
 
-bool BackhaulManager::is_ethernet_gateway_reachable() const
+bool BackhaulManager::is_gateway_reachable()
 {
 #ifndef USE_PRPLMESH_NLHAL
-    // TODO: Implement is_ethernet_gateway_reachable logic for WHM HAL
+    // TODO: Implement is_gateway_reachable logic for WHM HAL
     return true;
 #else
-    auto db = AgentDB::get();
-    const std::string wan_iface    = db->ethernet.wan.iface_name;
-    const std::string bridge_iface = db->bridge.iface_name;
-
-    if (wan_iface.empty()) {
-        LOG(WARNING) << "WAN interface name is empty";
+    if (m_gateway_ip.empty()) {
+        LOG(WARNING) << "Gateway IP not set, cannot check reachability";
         return false;
     }
 
-    // Resolve default gateway IP
+    return ping_gateway(m_gateway_ip);
+#endif
+}
+
+bool BackhaulManager::is_gateway_reachable_via_interface(const std::string &iface)
+{
+#ifndef USE_PRPLMESH_NLHAL
+    // TODO: Implement is_ethernet_gateway_reachable logic for WHM HAL
+    return true;
+#else
+    // Get bridge interface from database
+    auto db = AgentDB::get();
+    const std::string &bridge_iface = db->bridge.iface_name;
+
+    // Resolve gateway IP
     std::string gw_ip;
     if (!resolve_gateway_ip(gw_ip)) {
         return false;
     }
 
-    // Verify the route egresses via the wired path (WAN or bridge containing WAN)
-    if (!verify_route_via_wan(gw_ip, wan_iface, bridge_iface)) {
+    // Store the resolved gateway IP in the member variable
+    m_gateway_ip = gw_ip;
+
+    // Verify route goes via this interface
+    if (!verify_route_via_wan(gw_ip, iface, bridge_iface)) {
         return false;
     }
 
-    // If the default route device is the bridge, confirm MAC learned on WAN port
+    // If bridge is involved, check FDB
     if (!bridge_iface.empty()) {
         std::string gw_mac;
         if (!resolve_gateway_mac(gw_ip, bridge_iface, gw_mac)) {
             return false;
         }
-        if (!verify_gateway_on_wan_port(gw_mac, wan_iface, bridge_iface)) {
+        if (!verify_gateway_on_wan_port(gw_mac, iface, bridge_iface)) {
             return false;
         }
     }
 
-    // Final reachability check via ping
-    return ping_gateway(gw_ip);
+    // check reachability using gateway IP
+    return is_gateway_reachable();
+#endif
+}
+
+bool BackhaulManager::select_gateway_reachable_eth_interface(std::string &selected_iface)
+{
+    auto db = AgentDB::get();
+
+#ifndef USE_PRPLMESH_NLHAL
+    // TODO: Implement select_gateway_reachable_eth_interface logic for WHM HAL
+    selected_iface = db->ethernet.wan.iface_name;
+    return true;
+#else
+    const std::string &bridge_iface = db->bridge.iface_name;
+
+    auto bridge_members = beerocks::net::network_utils::linux_get_iface_list_from_bridge(bridge_iface);
+    if (bridge_members.empty()) {
+        LOG(WARNING) << "No interfaces found on bridge " << bridge_iface;
+        return false;
+    }
+    LOG(DEBUG) << "Checking " << bridge_members.size()
+               << " interface(s) on bridge for ethernet interface";
+
+    for (const auto &iface : bridge_members) {
+        if (iface.find("eth") != 0) {
+            continue;
+        }
+        LOG(DEBUG) << "Checking ethernet interface: " << iface;
+        if (!beerocks::net::network_utils::linux_iface_is_up_and_running(iface)) {
+            LOG(DEBUG) << "Interface " << iface << " is not UP, skipping";
+            continue;
+        }
+        if (is_gateway_reachable_via_interface(iface)) {
+            LOG(INFO) << "Selected ethernet interface: " << iface
+                      << " (UP and gateway reachable)";
+            selected_iface = iface;
+            return true;
+        } else {
+            LOG(DEBUG) << "Interface " << iface << " is UP but gateway not reachable";
+        }
+    }
+    LOG(WARNING) << "No ethernet interface is gateway reachable";
+    return false;
 #endif
 }
 
diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h
index 7491e855b..45babb9d6 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h
@@ -316,14 +316,23 @@ private:
     bwl::WiFiSec wsc_to_bwl_authentication(WSC::eWscAuth authtype);
 
     /**
-     * @brief Checks if the ethernet gateway is reachable.
+     * @brief Selects an available ethernet interface with gateway reachability.
      *
-     * This method verifies that the default gateway can be reached via the ethernet interface
-     * by resolving the gateway IP and performing an ICMP ping test.
+     * Looks for interfaces with "eth" prefix on the bridge, checks if they are UP
+     * and if gateway is reachable. Returns the first interface that meets criteria.
      *
+     * @param selected_iface Output parameter for selected interface
+     * @return true if a suitable interface was found, false otherwise
+     */
+    bool select_gateway_reachable_eth_interface(std::string &selected_iface);
+
+    /**
+     * @brief Checks if gateway is reachable via specific interface.
+     *
+     * @param iface Interface to check
      * @return true if gateway is reachable, false otherwise
      */
-    bool is_ethernet_gateway_reachable() const;
+    bool is_gateway_reachable_via_interface(const std::string &iface);
 
     /**
      * @brief Resolves the default gateway IP address.
@@ -331,7 +340,7 @@ private:
      * @param[out] gw_ip The resolved gateway IP address.
      * @return true if gateway IP was resolved successfully, false otherwise.
      */
-    bool resolve_gateway_ip(std::string &gw_ip) const;
+    bool resolve_gateway_ip(std::string &gw_ip);
 
     /**
      * @brief Verifies that the route to the gateway goes via the WAN interface.
@@ -342,7 +351,7 @@ private:
      * @return true if route goes via WAN, false otherwise.
      */
     bool verify_route_via_wan(const std::string &gw_ip, const std::string &wan_iface,
-                              const std::string &bridge_iface) const;
+                              const std::string &bridge_iface);
 
     /**
      * @brief Resolves the gateway MAC address from the neighbor table.
@@ -353,7 +362,7 @@ private:
      * @return true if MAC was resolved successfully, false otherwise.
      */
     bool resolve_gateway_mac(const std::string &gw_ip, const std::string &bridge_iface,
-                             std::string &gw_mac) const;
+                             std::string &gw_mac);
 
     /**
      * @brief Verifies that the gateway MAC is learned on the WAN port in bridge FDB.
@@ -364,7 +373,7 @@ private:
      * @return true if gateway MAC is on WAN port, false otherwise.
      */
     bool verify_gateway_on_wan_port(const std::string &gw_mac, const std::string &wan_iface,
-                                    const std::string &bridge_iface) const;
+                                    const std::string &bridge_iface);
 
     /**
      * @brief Performs ICMP ping to verify gateway reachability.
@@ -372,7 +381,15 @@ private:
      * @param[in] gw_ip The gateway IP address.
      * @return true if gateway responds to ping, false otherwise.
      */
-    bool ping_gateway(const std::string &gw_ip) const;
+    bool ping_gateway(const std::string &gw_ip);
+
+    /**
+     * @brief Checks if the stored gateway is reachable via ICMP ping.
+     *
+     * Uses the gateway IP stored in m_gateway_ip member variable.
+     * @return true if gateway responds to ping, false otherwise.
+     */
+    bool is_gateway_reachable();
 
 private:
     /**
@@ -724,6 +741,12 @@ private:
 
     bool m_remove_platform_manager_client = false;
 
+    /**
+     * Cached gateway IP address resolved from the routing table.
+     * Updated when gateway reachability checks are performed.
+     */
+    std::string m_gateway_ip;
+
     void create_sta_hal_for_bh_switching();
 };
 
