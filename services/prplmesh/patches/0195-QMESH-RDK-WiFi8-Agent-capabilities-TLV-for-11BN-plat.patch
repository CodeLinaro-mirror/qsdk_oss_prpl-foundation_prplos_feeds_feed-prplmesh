+#
+---
+_namespace: wfa_map
+
+tlvWifi8AgentCapabilities:
+  _type: class
+  _is_tlv_class : True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_WIFI_8_AGENT_CAPABILITIES
+  length: uint16_t
+  num_radio:
+    _type: uint8_t
+    _length_var: True
+  radio_wifi8_capabilities:
+    _type: cRadioWifi8Capabilities
+    _length: [ num_radio ]
+
+cRadioWifi8Capabilities:
+  _type: class
+  ruid:
+    _type: sMacAddr
+  flags1: sWifi8Flags1
+  flags2: sWifi8Flags2
+  reserved:
+    _type: uint8_t
+
+sWifi8Flags1:
+  _type: struct
+  _bit_field: uint8_t
+  smd_capable:
+    _bit_range: [7,7]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates whether AP supports SMD
+  smd_dl_forwarding:
+    _bit_range: [6,6]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates whether AP supports DL forwarding for SMD
+  per_smd_ptk_support:
+    _bit_range: [5,5]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates the support for per SMD PTK mode by the Agent
+  per_ap_ptk_support:
+    _bit_range: [4,4]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates the support for per AP PTK mode by the Agent
+  per_ap_mac_sap:
+    _bit_range: [3,3]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates the support for per AP Mac SAP by the Agent
+  per_smd_mac_sap:
+    _bit_range: [2,2]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates the support for per SMD Mac SAP by the Agent
+  coord_bf_support:
+    _bit_range: [1,1]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates whether AP supports Co-ordinated BF
+  coord_tdma_support:
+    _bit_range: [0,0]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates whether AP supports Co-ordinated TDMA
+
+sWifi8Flags2:
+  _type: struct
+  _bit_field: uint8_t
+  npca_support:
+    _bit_range: [7,7]
+    _comment: |
+      0: Not supported
+      1: Supported - Indicates whether AP supports Non-primary channel access (NPCA)
+  reserved:
+    _bit_range: [6,0]
