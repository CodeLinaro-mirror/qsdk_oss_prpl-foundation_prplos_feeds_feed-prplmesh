+#if defined(IEEE80211_BN)
+bool CapabilityReportingTask::add_wifi8_agent_capabilities_tlv(
+    ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto db = AgentDB::get();
+
+    auto wifi8_agent_capabilities_tlv = cmdu_tx.addClass<wfa_map::tlvWifi8AgentCapabilities>();
+    if (!wifi8_agent_capabilities_tlv) {
+        LOG(ERROR) << "Error creating TLV_WIFI8_AGENT_CAPABILITIES";
+        return false;
+    }
+
+    for (auto radio : db->get_radios_list()) {
+        if (!radio) {
+            LOG(ERROR) << "radio does not exist in the db";
+            continue;
+        }
+
+        auto radio_wifi8_cap = wifi8_agent_capabilities_tlv->create_radio_wifi8_capabilities();
+        if (!radio_wifi8_cap) {
+            LOG(ERROR) << "create_radio_wifi8_capabilities() failed";
+            return false;
+        }
+
+        radio_wifi8_cap->ruid() = radio->front.iface_mac;
+
+        /*
+         * Hardcode all Wi-Fi 8 capability bits as supported/capable.
+         *
+         * flags1 (Byte 1):
+         *   Bit 7: smd_capable           - AP supports SMD
+         *   Bit 6: smd_dl_forwarding     - AP supports DL forwarding for SMD
+         *   Bit 5: per_smd_ptk_support   - per SMD PTK mode support
+         *   Bit 4: per_ap_ptk_support    - per AP PTK mode support
+         *   Bit 3: per_ap_mac_sap        - per AP Mac SAP support
+         *   Bit 2: per_smd_mac_sap       - per SMD Mac SAP support
+         *   Bit 1: coord_bf_support      - Co-ordinated BF support
+         *   Bit 0: coord_tdma_support    - Co-ordinated TDMA support
+         *
+         * flags2 (Byte 2):
+         *   Bit 7: npca_support          - Non-primary channel access support
+         *   Bits 6:0: reserved
+         *
+         * reserved (Byte 3): reserved for other Wi-Fi 8 features
+         */
+        radio_wifi8_cap->flags1().smd_capable         = 1;
+        radio_wifi8_cap->flags1().smd_dl_forwarding   = 1;
+        radio_wifi8_cap->flags1().per_smd_ptk_support = 1;
+        radio_wifi8_cap->flags1().per_ap_ptk_support  = 1;
+        radio_wifi8_cap->flags1().per_ap_mac_sap      = 1;
+        radio_wifi8_cap->flags1().per_smd_mac_sap     = 1;
+        radio_wifi8_cap->flags1().coord_bf_support    = 1;
+        radio_wifi8_cap->flags1().coord_tdma_support  = 1;
+
+        radio_wifi8_cap->flags2().npca_support = 1;
+        radio_wifi8_cap->flags2().reserved     = 0;
+
+        radio_wifi8_cap->reserved() = 0;
+
+        if (!wifi8_agent_capabilities_tlv->add_radio_wifi8_capabilities(radio_wifi8_cap)) {
+            LOG(ERROR) << "add_radio_wifi8_capabilities() failed in tlvWifi8AgentCapabilities";
+            return false;
+        }
+    }
+
+    LOG(INFO) << "Add WiFi 8 capabilities TLV";
+    return true;
+}
+#endif /* defined(IEEE80211_BN) */
