+        }
+        if (!add_radio_wifi8_capabilities(radio_wifi8_capabilities)) {
+            TLVF_LOG(ERROR) << "add_radio_wifi8_capabilities() failed";
+            return false;
+        }
+        // swap back since radio_wifi8_capabilities will be swapped as part of the whole class swap
+        radio_wifi8_capabilities->class_swap();
+    }
+    if (m_parse__) { class_swap(); }
+    if (m_parse__) {
+        if (*m_type != eTlvTypeMap::TLV_WIFI_8_AGENT_CAPABILITIES) {
+            TLVF_LOG(ERROR) << "TLV type mismatch. Expected value: " << int(eTlvTypeMap::TLV_WIFI_8_AGENT_CAPABILITIES) << ", received value: " << int(*m_type);
+            return false;
+        }
+    }
+    return true;
+}
+
+cRadioWifi8Capabilities::cRadioWifi8Capabilities(uint8_t* buff, size_t buff_len, bool parse) :
+    BaseClass(buff, buff_len, parse) {
+    m_init_succeeded = init();
+}
+cRadioWifi8Capabilities::cRadioWifi8Capabilities(std::shared_ptr<BaseClass> base, bool parse) :
+BaseClass(base->getBuffPtr(), base->getBuffRemainingBytes(), parse){
+    m_init_succeeded = init();
+}
+cRadioWifi8Capabilities::~cRadioWifi8Capabilities() {
+}
+sMacAddr& cRadioWifi8Capabilities::ruid() {
+    return (sMacAddr&)(*m_ruid);
+}
+
+cRadioWifi8Capabilities::sWifi8Flags1& cRadioWifi8Capabilities::flags1() {
+    return (sWifi8Flags1&)(*m_flags1);
+}
+
+cRadioWifi8Capabilities::sWifi8Flags2& cRadioWifi8Capabilities::flags2() {
+    return (sWifi8Flags2&)(*m_flags2);
+}
+
+uint8_t& cRadioWifi8Capabilities::reserved() {
+    return (uint8_t&)(*m_reserved);
+}
+
+void cRadioWifi8Capabilities::class_swap()
+{
+    m_ruid->struct_swap();
+    m_flags1->struct_swap();
+    m_flags2->struct_swap();
+}
+
+bool cRadioWifi8Capabilities::finalize()
+{
+    if (m_parse__) {
+        TLVF_LOG(DEBUG) << "finalize() called but m_parse__ is set";
+        return true;
+    }
+    if (m_finalized__) {
+        TLVF_LOG(DEBUG) << "finalize() called for already finalized class";
+        return true;
+    }
+    if (!isPostInitSucceeded()) {
+        TLVF_LOG(ERROR) << "post init check failed";
+        return false;
+    }
+    if (m_inner__) {
+        if (!m_inner__->finalize()) {
+            TLVF_LOG(ERROR) << "m_inner__->finalize() failed";
+            return false;
+        }
+        auto tailroom = m_inner__->getMessageBuffLength() - m_inner__->getMessageLength();
+        m_buff_ptr__ -= tailroom;
+    }
+    class_swap();
+    m_finalized__ = true;
+    return true;
+}
+
+size_t cRadioWifi8Capabilities::get_initial_size()
+{
+    size_t class_size = 0;
+    class_size += sizeof(sMacAddr); // ruid
+    class_size += sizeof(sWifi8Flags1); // flags1
+    class_size += sizeof(sWifi8Flags2); // flags2
+    class_size += sizeof(uint8_t); // reserved
+    return class_size;
+}
+
+bool cRadioWifi8Capabilities::init()
+{
+    if (getBuffRemainingBytes() < get_initial_size()) {
+        TLVF_LOG(ERROR) << "Not enough available space on buffer. Class init failed";
+        return false;
+    }
+    m_ruid = reinterpret_cast<sMacAddr*>(m_buff_ptr__);
+    if (!buffPtrIncrementSafe(sizeof(sMacAddr))) {
+        LOG(ERROR) << "buffPtrIncrementSafe(" << std::dec << sizeof(sMacAddr) << ") Failed!";
+        return false;
+    }
+    if (!m_parse__) { m_ruid->struct_init(); }
+    m_flags1 = reinterpret_cast<sWifi8Flags1*>(m_buff_ptr__);
+    if (!buffPtrIncrementSafe(sizeof(sWifi8Flags1))) {
+        LOG(ERROR) << "buffPtrIncrementSafe(" << std::dec << sizeof(sWifi8Flags1) << ") Failed!";
+        return false;
+    }
+    if (!m_parse__) { m_flags1->struct_init(); }
+    m_flags2 = reinterpret_cast<sWifi8Flags2*>(m_buff_ptr__);
+    if (!buffPtrIncrementSafe(sizeof(sWifi8Flags2))) {
+        LOG(ERROR) << "buffPtrIncrementSafe(" << std::dec << sizeof(sWifi8Flags2) << ") Failed!";
+        return false;
+    }
+    if (!m_parse__) { m_flags2->struct_init(); }
+    m_reserved = reinterpret_cast<uint8_t*>(m_buff_ptr__);
+    if (!buffPtrIncrementSafe(sizeof(uint8_t))) {
+        LOG(ERROR) << "buffPtrIncrementSafe(" << std::dec << sizeof(uint8_t) << ") Failed!";
+        return false;
+    }
+    if (m_parse__) { class_swap(); }
+    return true;
+}
