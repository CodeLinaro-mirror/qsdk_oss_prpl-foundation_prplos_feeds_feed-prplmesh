From 86336c37ace0d0db6726f53c42bb7e1addaa6bab Mon Sep 17 00:00:00 2001
From: Vignesh Sridharan <vignsrid@qti.qualcomm.com>
Date: Fri, 17 Apr 2026 14:10:42 +0530
Subject: [PATCH] config: Add mld_id to SMD profile config for per-MLD matching

SSID-only matching in the agent AP MLD config TLV fails when
multiple radios have individual VAPs with the same SSID (non-MLO
case), since all of them match the same SMD profile.

Add a new 'mld_id' parameter to each SMD profile in the controller
config. The value matches 'option mld' in the wireless UCI file
(e.g. mld0, mld1). During config parsing the "mld" prefix is
stripped to produce the internal numeric string ("0", "1", ...)
used as the key in mld_infos_global.

Both SSID and mld_id must match when looking up the SMD profile
to populate affiliated_ap_smd_mac_addr in the Agent AP MLD
Configuration TLV.

Signed-off-by: Vignesh Sridharan <vignsrid@qti.qualcomm.com>
---
 .../bcl/include/bcl/beerocks_config_file.h    |  1 +
 .../bcl/source/beerocks_config_file.cpp       |  1 +
 controller/config/beerocks_controller.conf.in |  1 +
 .../beerocks/master/beerocks_master_main.cpp  | 13 ++++++++-
 controller/src/beerocks/master/controller.cpp | 27 +++++++++++++------
 controller/src/beerocks/master/db/db.h        |  1 +
 6 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/common/beerocks/bcl/include/bcl/beerocks_config_file.h b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
index 153c4e6bf..6c5029a22 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_config_file.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
@@ -47,6 +47,7 @@ public:
         std::string smd_profile_count;
         std::string smd_identifier[MAX_SMD_PROFILES];
         std::string smd_ssid[MAX_SMD_PROFILES];
+        std::string smd_mld_id[MAX_SMD_PROFILES];
         std::string smd_timeout[MAX_SMD_PROFILES];
         std::string smd_max_prepared_ap_mlds[MAX_SMD_PROFILES];
         std::string smd_dl_forwarding[MAX_SMD_PROFILES];
diff --git a/common/beerocks/bcl/source/beerocks_config_file.cpp b/common/beerocks/bcl/source/beerocks_config_file.cpp
index 74c798953..98b2c516f 100644
--- a/common/beerocks/bcl/source/beerocks_config_file.cpp
+++ b/common/beerocks/bcl/source/beerocks_config_file.cpp
@@ -124,6 +124,7 @@ bool config_file::read_master_config_file(const std::string &config_file_path, s
         std::string prefix = "smd_" + std::to_string(i) + "_";
         master_conf_args.emplace_back(prefix + "identifier=", &conf.smd_identifier[i], 0);
         master_conf_args.emplace_back(prefix + "ssid=", &conf.smd_ssid[i], 0);
+        master_conf_args.emplace_back(prefix + "mld_id=", &conf.smd_mld_id[i], 0);
         master_conf_args.emplace_back(prefix + "timeout=", &conf.smd_timeout[i], 0);
         master_conf_args.emplace_back(
             prefix + "max_prepared_ap_mlds=", &conf.smd_max_prepared_ap_mlds[i], 0);
diff --git a/controller/config/beerocks_controller.conf.in b/controller/config/beerocks_controller.conf.in
index defb47fda..c37d906f5 100644
--- a/controller/config/beerocks_controller.conf.in
+++ b/controller/config/beerocks_controller.conf.in
@@ -26,6 +26,7 @@ smd_profile_count=0 # Number of active SMD profiles
 # Example SMD Profile 0 (uncomment and configure as needed):
 # smd_0_identifier=00:11:22:33:44:55  # Unique MAC address identifying this SMD
 # smd_0_ssid=MyNetwork                # SSID associated with this SMD profile
+# smd_0_mld_id=mld0                   # MLD ID matching 'option mld' in wireless UCI (e.g. mld0, mld1)
 # smd_0_timeout=100                   # ST preparation to execution timeout (TU units)
 # smd_0_max_prepared_ap_mlds=3        # Max number of prepared target AP MLDs
 # smd_0_dl_forwarding=1               # DL data forwarding support (1=yes, 0=no)
diff --git a/controller/src/beerocks/master/beerocks_master_main.cpp b/controller/src/beerocks/master/beerocks_master_main.cpp
index f7b8d8b03..2dfe2043f 100644
--- a/controller/src/beerocks/master/beerocks_master_main.cpp
+++ b/controller/src/beerocks/master/beerocks_master_main.cpp
@@ -180,6 +180,16 @@ static void fill_master_config(son::db::sDbMasterConfig &master_conf,
                                                ? beerocks::net::network_utils::ZERO_MAC
                                                : tlvf::mac_from_string(main_master_conf.smd_identifier[i]);
             profile.ssid                 = main_master_conf.smd_ssid[i];
+            // Normalize mld_id: strip "mld" prefix so "mld0" -> "0", "mld1" -> "1"
+            // This matches the internal numeric representation used in mld_infos_global
+            {
+                const std::string &raw = main_master_conf.smd_mld_id[i];
+                if (raw.size() > 3 && raw.substr(0, 3) == "mld") {
+                    profile.mld_id = raw.substr(3);
+                } else {
+                    profile.mld_id = raw;
+                }
+            }
             profile.timeout              = main_master_conf.smd_timeout[i].empty()
                                                ? 0
                                                : static_cast<uint16_t>(beerocks::string_utils::stoi(
@@ -206,7 +216,8 @@ static void fill_master_config(son::db::sDbMasterConfig &master_conf,
                     : static_cast<uint8_t>(beerocks::string_utils::stoi(
                           main_master_conf.smd_default_dl_drain_time[i]));
             LOG(DEBUG) << "Loaded SMD profile[" << i << "]: identifier=" << profile.identifier
-                       << ", ssid=" << profile.ssid << ", timeout=" << profile.timeout
+                       << ", ssid=" << profile.ssid << ", mld_id=" << profile.mld_id
+                       << ", timeout=" << profile.timeout
                        << ", max_prepared_ap_mlds=" << int(profile.max_prepared_ap_mlds);
             master_conf.smd_profiles.push_back(profile);
         }
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index a182c8217..43d098d41 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -1460,14 +1460,15 @@ static bool add_agent_ap_mld_configuration_tlv(db &database, ieee1905_1::CmduMes
         ap_mld->modes().emlsr = mld.second.emlsr;
         ap_mld->modes().emlmr = mld.second.emlmr;
 
-        // Look up SMD profile by SSID and populate affiliated_ap_smd_mac_addr
+        // Look up SMD profile by SSID and mld_id, then populate affiliated_ap_smd_mac_addr
         ap_mld->modes().affiliated_ap_smd_mac_addr_valid = 0;
         for (const auto &smd_profile : database.config.smd_profiles) {
-            if (!smd_profile.ssid.empty() && smd_profile.ssid == mld.second.ssid) {
+            if (!smd_profile.ssid.empty() && smd_profile.ssid == mld.second.ssid &&
+                !smd_profile.mld_id.empty() && smd_profile.mld_id == mld.first) {
                 ap_mld->affiliated_ap_smd_mac_addr()             = smd_profile.identifier;
                 ap_mld->modes().affiliated_ap_smd_mac_addr_valid = 1;
-                LOG(DEBUG) << "Set SMD MAC " << smd_profile.identifier << " for MLD SSID "
-                           << mld.second.ssid;
+                LOG(DEBUG) << "Set SMD MAC " << smd_profile.identifier << " for MLD SSID="
+                           << mld.second.ssid << " mld_id=" << mld.first;
                 break;
             }
         }
@@ -4824,14 +4825,24 @@ bool Controller::reconfig_apmld(const sMacAddr &al_mac, const sMacAddr &mld_mac,
             ap_mld->modes().emlmr = 1;
         }
 
-        // Look up SMD profile by SSID and populate affiliated_ap_smd_mac_addr
+        // Find the mld_id for this AP MLD from mld_infos_global by matching SSID
+        std::string ap_mld_id;
+        for (const auto &mld_entry : database.get_mld_info_configuration()) {
+            if (mld_entry.second.ssid == db_ap_mld.mld_info.mld_ssid) {
+                ap_mld_id = mld_entry.first;
+                break;
+            }
+        }
+
+        // Look up SMD profile by SSID and mld_id, then populate affiliated_ap_smd_mac_addr
         ap_mld->modes().affiliated_ap_smd_mac_addr_valid = 0;
         for (const auto &smd_profile : database.config.smd_profiles) {
-            if (!smd_profile.ssid.empty() && smd_profile.ssid == db_ap_mld.mld_info.mld_ssid) {
+            if (!smd_profile.ssid.empty() && smd_profile.ssid == db_ap_mld.mld_info.mld_ssid &&
+                !smd_profile.mld_id.empty() && smd_profile.mld_id == ap_mld_id) {
                 ap_mld->affiliated_ap_smd_mac_addr()             = smd_profile.identifier;
                 ap_mld->modes().affiliated_ap_smd_mac_addr_valid = 1;
-                LOG(DEBUG) << "Set SMD MAC " << smd_profile.identifier << " for MLD SSID "
-                           << db_ap_mld.mld_info.mld_ssid;
+                LOG(DEBUG) << "Set SMD MAC " << smd_profile.identifier << " for MLD SSID="
+                           << db_ap_mld.mld_info.mld_ssid << " mld_id=" << ap_mld_id;
                 break;
             }
         }
diff --git a/controller/src/beerocks/master/db/db.h b/controller/src/beerocks/master/db/db.h
index bc4501eea..a1e0cafcc 100644
--- a/controller/src/beerocks/master/db/db.h
+++ b/controller/src/beerocks/master/db/db.h
@@ -128,6 +128,7 @@ public:
         struct sSmdProfileConfig {
             sMacAddr identifier;               ///< SMD identifier as MAC address
             std::string ssid;                  ///< SSID associated with this SMD profile
+            std::string mld_id;                ///< MLD ID (numeric string, e.g. "0", "1"), derived from 'option mld mldX' in wireless UCI
             uint16_t timeout              = 0; ///< ST prep-to-execution timeout (TU units)
             uint8_t max_prepared_ap_mlds  = 0; ///< Max number of prepared target AP MLDs
             uint8_t dl_forwarding         = 0; ///< DL data forwarding support (1=yes, 0=no)
-- 
2.34.1

