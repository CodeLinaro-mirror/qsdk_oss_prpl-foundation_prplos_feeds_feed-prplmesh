+/**
+ * @brief Triggers a Remain-on-Channel (ROC) scan using NL80211.
+ */
+#include <chrono>
+#include <thread>
+
+bool mon_wlan_hal_nl80211::trigger_roc_scan(uint8_t channel, uint32_t duration_ms)
+{
+    LOG(DEBUG) << "Triggering ROC scan on channel " << int(channel) << " for " << duration_ms
+        << "ms";
+
+    std::string interface_name = get_iface_name();
+    std::string base_interface;
+    extractBase1Interface(interface_name, base_interface);
+
+    // Get the interface index required for the NL80211 command
+    int iface_index = if_nametoindex(base_interface.c_str());
+    if (0 == iface_index) {
+        LOG(ERROR) << "Failed to read the index of interface " << interface_name
+            << " base_interface: " << base_interface << ": " << strerror(errno);
+        return false;
+    }
+
+    // Get radio info to determine the frequency for the given channel
+    auto &radio_info = get_radio_info();
+
+    // Find the channel in the supported channels list to convert channel number to frequency
+    uint32_t freq = 0;
+    // Calculate frequency from channel number and band
+    freq = son::wireless_utils::channel_to_freq(channel, radio_info.frequency_band);
+
+    if (freq == 0) {
+        LOG(ERROR) << "Channel " << int(channel) << " is not supported by interface "
+            << interface_name;
+        return false;
+    }
+
+    LOG(DEBUG) << "Requesting remain-on-channel on interface " << interface_name << " (idx "
+        << iface_index << ") for " << duration_ms << "ms on channel " << int(channel)
+        << " (freq " << freq << " MHz)";
+
+    // Send the NL80211_CMD_REMAIN_ON_CHANNEL command to the kernel
+    auto ret = send_nl80211_msg(
+            NL80211_CMD_REMAIN_ON_CHANNEL, 0,
+            // Lambda to populate the netlink message with necessary attributes
+            [&](struct nl_msg *msg) -> bool {
+            nla_put_u32(msg, NL80211_ATTR_IFINDEX, iface_index);
+            nla_put_u32(msg, NL80211_ATTR_WIPHY_FREQ, freq);
+            nla_put_u32(msg, NL80211_ATTR_DURATION, duration_ms);
+            return true;
+            },
+            // No response is expected for a successful command, only an error on failure.
+            // This callback is a placeholder.
+            [&](struct nl_msg *msg) -> bool { return true; }, base_interface);
+
+    if (!ret) {
+        LOG(ERROR) << "Failed to send NL80211_CMD_REMAIN_ON_CHANNEL command";
+        return false;
+    }
+
+    // -----------------------------------------------
+    // Workaround: create a sleeper thread to trigger ROC event manually
+    // -----------------------------------------------
+    std::thread([this, duration_ms]() {
+            constexpr uint32_t buffer_period_ms = 500;
+            LOG(DEBUG) << "[ROC] Sleeper thread started for " << duration_ms << "ms + buffer "
+            << buffer_period_ms << "ms";
+            std::this_thread::sleep_for(std::chrono::milliseconds(duration_ms + buffer_period_ms));
+            LOG(INFO) << "[ROC] Sleeper thread expired after " << (duration_ms + buffer_period_ms)
+            << "ms. Triggering process_roc_expired_event().";
+            this->process_roc_expired_event();
+            }).detach();
+    // -----------------------------------------------
+
+    return true;
+}
+
+/**
+ * @brief Processes the ROC (Remain-on-Channel) expired event.
+ */
+/**
+ * @brief Utility function to convert RSSI in dB to dBm.
+ */
+static inline int rssi_db_to_dbm(int rssi_db, int noise_floor_to_chanwidth = 94)
+{
+    return rssi_db - noise_floor_to_chanwidth;
+}
+
+bool mon_wlan_hal_nl80211::process_roc_expired_event()
+{
+    LOG(DEBUG) << "ROC expired, reading RSSI values";
+
+    sUnassociatedStationsStats stats_out;
+
+    // Iterate through all STAs that were pending measurement
+    for (auto &measurement : m_pending_unassoc_measurements) {
+        int8_t rssi = 0;
+        if (read_peer_neighbor_rssi(measurement.mac_address, rssi)) {
+            sUnassociatedStationStats new_stat;
+            new_stat.mac_adress = tlvf::mac_from_string(measurement.mac_address);
+
+            // Convert RSSI-dB to dBm (using noise_floor_to_chanwidth = 94)
+            int rssi_dbm = rssi_db_to_dbm(rssi, 94);
+
+            // Convert to RCPI: RCPI = (RSSI_dBm + 110) * 2
+            new_stat.signal_strength = (rssi_dbm + 110) * 2;
+            new_stat.channel         = measurement.channel;
+
+            // Derive operating_class from channel
+            new_stat.operating_class = GET_OP_CLASS(measurement.channel);
+            // Note: operating_class was not stored in UnassocMeasurementContext
+            // It should be derived from the channel if needed by the caller
+
+            // Calculate time elapsed since measurement was initiated
+            auto time_delta = std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::steady_clock::now() - measurement.start_time);
+            new_stat.time_stamp = time_delta.count();
+
+            stats_out.un_stations_stats.push_back(new_stat);
+
+            LOG(DEBUG) << "STA " << measurement.mac_address << " RSSI(raw dB): " << int(rssi)
+                << " RSSI[dBm]: " << rssi_dbm << " RCPI: " << int(new_stat.signal_strength)
+                << ", channel: " << int(new_stat.channel);
+        } else {
+            LOG(ERROR) << "Failed to read RSSI for STA: " << measurement.mac_address;
+        }
+        // Clean up by removing the peer from the debugfs list
+        remove_peer_neighbor(measurement.mac_address);
+    }
+    // Clear the pending measurements list
+    m_pending_unassoc_measurements.clear();
+
+    // Allocate buffer for the event data
+    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(stats_out));
+    if (!msg_buff) {
+        LOG(FATAL) << "Memory allocation failed for sUnassociatedStationsStats!";
+        return false;
+    }
+    auto msg = reinterpret_cast<sUnassociatedStationsStats *>(msg_buff.get());
+    memset(msg_buff.get(), 0, sizeof(stats_out));
+    *msg = stats_out;
+
+    // Push the stats to the event queue
+    event_queue_push(Event::Unassociation_Stations_Stats, msg_buff);
+
+    LOG(DEBUG) << "Pushed Unassociation_Stations_Stats event with "
+        << stats_out.un_stations_stats.size() << " entries";
+
+    // All timerfd-based ROC cleanup removed; rely only on kernel event.
+
+    return true;
+}
