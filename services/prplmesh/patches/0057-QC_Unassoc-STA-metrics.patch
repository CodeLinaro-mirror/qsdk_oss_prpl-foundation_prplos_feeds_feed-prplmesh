+/**
+ * @brief Initiates RSSI measurement for a list of unassociated STAs.
+ */
 bool mon_wlan_hal_nl80211::sta_unassoc_rssi_measurement(
-    std::unordered_map<std::string, uint8_t> &new_list)
+        std::unordered_map<std::string, uint8_t> &new_list)
 {
-    new_list.clear();
-    LOG(DEBUG) << __func__ << " - NOT IMPLEMENTED";
+    LOG(DEBUG) << "sta_unassoc_rssi_measurement: Starting measurement for " << new_list.size()
+        << " STAs";
+    if (new_list.empty()) {
+        return true;
+    }
+
+    uint8_t first_channel = 0;
+
+    // Prepare all STAs for measurement
+    for (auto &sta : new_list) {
+        const std::string &mac_address = sta.first;
+        uint8_t channel                = sta.second;
+
+        // Validate channel number
+        if (channel == 0) {
+            LOG(ERROR) << "Invalid channel (0) for STA: " << mac_address;
+            continue;
+        }
+
+        // Add STA to the driver's debugfs list for monitoring
+        if (!add_peer_neighbor(mac_address)) {
+            LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+            continue;
+        }
+
+        // Use the channel of the first valid STA for the ROC scan
+        if (first_channel == 0) {
+            first_channel = channel;
+        }
+
+        // Store context for this measurement
+        UnassocMeasurementContext ctx;
+        ctx.mac_address = mac_address;
+        ctx.channel     = channel;
+        ctx.start_time  = std::chrono::steady_clock::now();
+        m_pending_unassoc_measurements.push_back(ctx);
+    }
+
+    if (m_pending_unassoc_measurements.empty()) {
+        LOG(ERROR) << "No valid STAs to measure";
+        return false;
+    }
+
+    // Trigger a single ROC scan. All measurements will be based on this scan.
+    uint32_t roc_duration_ms = 100;
+    if (!trigger_roc_scan(first_channel, roc_duration_ms)) {
+        LOG(ERROR) << "Failed to trigger ROC scan on channel " << int(first_channel);
+        // Clean up all pending measurements if ROC scan fails
+        for (auto &measurement : m_pending_unassoc_measurements) {
+            remove_peer_neighbor(measurement.mac_address);
+        }
+        m_pending_unassoc_measurements.clear();
+        return false;
+    }
+
+    LOG(DEBUG) << "Triggered ROC scan on channel " << int(first_channel) << " for "
+        << roc_duration_ms << "ms";
+
     return true;
 }
 
