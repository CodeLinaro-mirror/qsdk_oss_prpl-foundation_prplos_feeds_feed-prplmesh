     return true;
 }
 
+bool ap_wlan_hal_nl80211::simulate_awgn()
+{
+    // Send DCS command to hostapd via wpa_ctrl socket.
+    // This is the socket-based equivalent of: hostapd_cli -i <iface> dcs sim 4
+    // The command triggers an AWGN simulation event in hostapd's DCS module.
+    //
+    // wpa_ctrl_send_msg() with no ifname argument sends to the radio/MainBSS interface,
+    // which is the same target as "hostapd_cli -i <iface>".
+    const std::string cmd = "DCS sim 4";
+    LOG(INFO) << "simulate_awgn: sending '" << cmd << "' via wpa_ctrl socket";
+
+    if (!wpa_ctrl_send_msg(cmd)) {
+        LOG(ERROR) << "simulate_awgn: wpa_ctrl_send_msg('" << cmd << "') failed!";
+        return false;
+    }
+
+    LOG(INFO) << "simulate_awgn: DCS sim 4 command sent successfully";
+    return true;
+}
