+/**
+ * @brief Simulate AWGN (Additive White Gaussian Noise) on 6 GHz radio
+ *
+ * This function triggers AWGN simulation on the specified radio if it's 6 GHz.
+ * It sends a vendor-specific message to the colocated Agent which executes:
+ * hostapd_cli -i wlan3 -l 0 dcs sim 4
+ *
+ * Example usage:
+ * ubus call Device.WiFi.DataElements.Network.Device.1.Radio.1 SimulateAWGN
+ *
+ * @param object The data model object (Radio instance)
+ * @param func The function being called
+ * @param args Function arguments (none required)
+ * @param ret Return value
+ * @return amxd_status_ok on success, error code otherwise
+ */
+amxd_status_t simulate_awgn_6ghz(amxd_object_t *object, amxd_function_t *func,
+                                 amxc_var_t *args, amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "SimulateAWGN: Failed to get controller context";
+        return amxd_status_unknown_error;
+    }
+
+    // Get the radio ID from the object path
+    amxc_var_t value;
+    amxc_var_init(&value);
+    amxd_object_get_param(object, "ID", &value);
+    std::string radio_mac_str = amxc_var_constcast(cstring_t, &value);
+    amxc_var_clean(&value);
+
+    if (radio_mac_str.empty()) {
+        LOG(ERROR) << "SimulateAWGN: radio MAC is empty";
+        return amxd_status_parameter_not_found;
+    }
+
+    sMacAddr radio_mac = tlvf::mac_from_string(radio_mac_str);
+
+    LOG(INFO) << "SimulateAWGN: Request for radio: " << radio_mac_str;
+
+    // Get agent that owns this radio
+    auto agent = g_database->get_agent_by_radio_uid(radio_mac);
+    if (!agent) {
+        LOG(ERROR) << "SimulateAWGN: Agent not found for radio: " << radio_mac_str;
+        return amxd_status_object_not_found;
+    }
+
+    // Get radio to check if it's 6 GHz
+    auto radio = agent->radios.get(radio_mac);
+    if (!radio) {
+        LOG(ERROR) << "SimulateAWGN: Radio not found: " << radio_mac_str;
+        return amxd_status_object_not_found;
+    }
+
+    // Verify radio is 6 GHz band
+    if (!radio->supports_6ghz || radio->band != beerocks::FREQ_6G) {
+        LOG(ERROR) << "SimulateAWGN: Radio is not 6 GHz band: " << radio_mac_str;
+        return amxd_status_invalid_value;
+    }
+
+    LOG(INFO) << "SimulateAWGN: Verified radio is 6 GHz: " << radio_mac_str;
+
+    // Create CMDU message
+    uint8_t tx_buffer[beerocks::message::MESSAGE_BUFFER_LENGTH];
+    ieee1905_1::CmduMessageTx cmdu_tx(tx_buffer, sizeof(tx_buffer));
+
+    // Create AWGN simulate request
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_CONTROL_AWGN_SIMULATE_REQUEST>(cmdu_tx);
+
+    if (!request) {
+        LOG(ERROR) << "SimulateAWGN: Failed to create AWGN_SIMULATE_REQUEST";
+        return amxd_status_unknown_error;
+    }
+
+    // Set radio MAC
+    request->radio_mac() = radio_mac;
+
+    // Send to agent using the helper function
+    if (!son_actions::send_cmdu_to_agent(agent->al_mac, cmdu_tx, *g_database, radio_mac_str)) {
+        LOG(ERROR) << "SimulateAWGN: Failed to send message to agent: " << agent->al_mac;
+        return amxd_status_unknown_error;
+    }
+
+    LOG(INFO) << "SimulateAWGN: Sent AWGN simulation request to agent: " << agent->al_mac
+              << " for radio: " << radio_mac_str;
+
+    return amxd_status_ok;
+}
