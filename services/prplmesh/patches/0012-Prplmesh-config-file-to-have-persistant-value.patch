diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
index d06c5046a..04d5d3238 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
@@ -1109,5 +1109,14 @@ bool cfg_get_traffic_separation_guest_vid(int &guest_vid)
 
 bool cfg_commit_changes() { return uci_commit_changes("prplmesh"); }
 
+bool cfg_update_prplmesh_option(const std::string &package_name,
+                            const std::string &section_type,
+                            const std::string &option_name,
+                            const std::string &old_value,
+                            const std::string &new_value)
+{
+    return cfg_update_prplmesh_option_commit(package_name, section_type, option_name, old_value, new_value);
+}
+
 } // namespace bpl
 } // namespace beerocks
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_helper.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_helper.cpp
index 49c850893..ec32d0424 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_helper.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_helper.cpp
@@ -145,5 +145,38 @@ int cfg_set_prplmesh_config_no_commit(const std::string &option, const std::stri
     return uci_set_section("prplmesh", "", "config", options, false);
 }
 
+bool cfg_update_prplmesh_option_commit(const std::string &package_name,
+                            const std::string &section_type,
+                            const std::string &option_name,
+                            const std::string &old_value,
+                            const std::string &new_value)
+{
+    std::string section_name;
+
+    if (!uci_find_section_by_option(package_name, section_type, option_name, old_value, section_name)) {
+        LOG(ERROR) << "Failed to find configuration section for option " << option_name
+                   << " with value " << old_value;
+        return false;
+    }
+
+    if (section_name.empty()) {
+        LOG(ERROR) << "Section not found for " << option_name << " = " << old_value;
+        return false;
+    }
+
+    OptionsUnorderedMap options{{option_name, new_value}};
+
+    if (!uci_set_section(package_name, section_type, section_name, options, true)) {
+        LOG(ERROR) << "Failed to set configuration for option " << option_name
+                   << " to " << new_value << " at section " << section_name;
+        return false;
+    }
+
+    LOG(INFO) << "Successfully updated " << option_name << " to " << new_value
+              << " in section " << section_name;
+    return true;
+}
+
+
 } // namespace bpl
 } // namespace beerocks
