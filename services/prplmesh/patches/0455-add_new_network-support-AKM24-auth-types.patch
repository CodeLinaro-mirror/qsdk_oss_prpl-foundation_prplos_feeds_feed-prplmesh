From a291b26badb9a192a18ae08ae5a21583b44a3280 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Sat, 26 Sep 2026 17:37:18 +0530
Subject: [PATCH] add_new_network: support AKM24 auth types for bSTA

- Add handling for WSC_AUTH_WPA2PSK|SAE|SAE_AKM24 (0x160):
  key_mgmt=WPA-PSK SAE SAE-EXT-KEY, pairwise=GCMP CCMP GCMP-256
- Add handling for WSC_AUTH_SAE|SAE_AKM24 (0x140):
  key_mgmt=SAE, ieee80211w=2
- Fix: use 'psk' variable instead of hardcoded string so SAE
  auth types correctly use 'sae_password'

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../bwl/nl80211/sta_wlan_hal_nl80211.cpp      | 34 +++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
index d296b836e..aa0b34e71 100644
--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
@@ -975,6 +975,32 @@ bool sta_wlan_hal_nl80211::add_new_network(son::wireless_utils::sBssInfoConf bSt
     if (base_auth_type == WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
         key_mgmt = "WPA-PSK";
         psk = "psk";
+    } else if (base_auth_type ==
+               WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE |
+                             WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+        key_mgmt = "WPA-PSK SAE SAE-EXT-KEY";
+        psk = "psk";
+        pairwise = "GCMP CCMP GCMP-256";
+        if (!set_network(network_id, "ieee80211w", "1")) {
+            LOG(ERROR) << "Failed setting ieee80211w on interface " << sta_iface;
+            return false;
+        }
+        if (!set_network(network_id, "sae_pwe", "2")) {
+            LOG(ERROR) << "Failed setting sae_pwe on interface " << sta_iface;
+            return false;
+        }
+    } else if (base_auth_type == WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_SAE |
+                                               WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+        key_mgmt = "SAE";
+        psk = "sae_password";
+        if (!set_network(network_id, "ieee80211w", "2")) {
+            LOG(ERROR) << "Failed setting ieee80211w on interface " << sta_iface;
+            return false;
+        }
+        if (!set_network(network_id, "sae_pwe", "2")) {
+            LOG(ERROR) << "Failed setting sae_pwe on interface " << sta_iface;
+            return false;
+        }
     } else if (base_auth_type == WSC::eWscAuth::WSC_AUTH_SAE) {
         key_mgmt = "SAE";
         psk = "sae_password";
@@ -1007,8 +1033,12 @@ bool sta_wlan_hal_nl80211::add_new_network(son::wireless_utils::sBssInfoConf bSt
         return false;
     }
 
-    if ((!bSta_conf.network_key.empty()) && (!set_network(network_id, "psk", "\"" + bSta_conf.network_key + "\""))) {
-        LOG(ERROR) << "Failed setting psk on interface " << sta_iface;
+    // Use the correct wpa_supplicant parameter name for the password:
+    //   WPA2PSK  → "psk"          (set above)
+    //   SAE      → "sae_password" (set above)
+    //   SAE-MIX  → "sae_password" (set above)
+    if ((!bSta_conf.network_key.empty()) && (!set_network(network_id, psk, "\"" + bSta_conf.network_key + "\""))) {
+        LOG(ERROR) << "Failed setting " << psk << " on interface " << sta_iface;
         return false;
     }
 
-- 
