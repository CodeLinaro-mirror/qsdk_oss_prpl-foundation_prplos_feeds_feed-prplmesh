+bool DppKeyStore::clear_peer_uris() const
+{
+    constexpr const char *uris_file       = "/etc/prplmesh/dpp_uri";
+    constexpr const char *local_agent_tag = "# local-agent";
+
+    if (access(uris_file, F_OK) != 0) {
+        return true; // nothing to clear
+    }
+
+    FILE *f = fopen(uris_file, "r+");
+    if (!f) {
+        MAPF_ERR("DppKeyStore: failed to open " << uris_file << " to clear peer URIs");
+        return false;
+    }
+    flock(fileno(f), LOCK_EX);
+
+    // Preserve only the co-located agent's own "# local-agent"-tagged line, if present -
+    // never wipe it: regenerating it would change the chirp hash already provisioned on
+    // some other controller (see dpp_bootstrap_utils.cpp).
+    std::string local_agent_line;
+    {
+        char rd_buf[1024];
+        std::string prev;
+        while (fgets(rd_buf, sizeof(rd_buf), f)) {
+            std::string line(rd_buf);
+            while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
+                line.pop_back();
+            if (prev == local_agent_tag) {
+                local_agent_line = line;
+            }
+            prev = line;
+        }
+    }
+
+    if (ftruncate(fileno(f), 0) != 0) {
+        MAPF_ERR("DppKeyStore: failed to truncate " << uris_file);
+        flock(fileno(f), LOCK_UN);
+        fclose(f);
+        return false;
+    }
+    rewind(f);
+
+    if (!local_agent_line.empty()) {
+        fprintf(f, "%s\n%s\n", local_agent_tag, local_agent_line.c_str());
+    }
+    fflush(f);
+    bool ok = (ferror(f) == 0);
+    flock(fileno(f), LOCK_UN);
+    fclose(f);
+    if (ok) {
+        LOG(INFO) << "DppKeyStore: cleared all peer-provisioned URIs from " << uris_file;
+    }
+    return ok;
+}
