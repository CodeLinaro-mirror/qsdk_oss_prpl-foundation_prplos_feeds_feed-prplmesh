+#ifndef __DPP_BOOTSTRAP_UTILS_H__
+#define __DPP_BOOTSTRAP_UTILS_H__
+
+#include <string>
+
+namespace beerocks {
+namespace dpp {
+
+/**
+ * @brief Ensures this agent has its own DPP bootstrapping key pair and URI.
+ *
+ * Generates a P-256 key pair and a "DPP:V:3;K:...;;" URI on first use (persisted to
+ * /etc/prplmesh/dpp/bootstrap_key.pem and /etc/prplmesh/dpp_uri, tagged "# local-agent"),
+ * or reuses the existing ones if already present. Safe to call repeatedly - it will not
+ * regenerate a key/URI that already exists.
+ *
+ * @param[out] uri_out The local agent's own bootstrapping URI, e.g. "DPP:V:3;K:...;;".
+ * @return true on success, false otherwise.
+ */
+bool ensure_local_bootstrap_uri(std::string &uri_out);
+
+/**
+ * @brief Ensures this agent has its own DPP bootstrap key/URI (see
+ * ensure_local_bootstrap_uri()), then loads the private key, validates it against the
+ * URI's K: field, computes its chirp_hash/pubkey_hash, and populates
+ * AgentDB::get()->dpp_bootstrap so the agent is immediately able to act as DPP responder
+ * (chirp, authentication, etc.) without requiring a restart.
+ *
+ * Safe to call repeatedly - re-validates and re-populates AgentDB::dpp_bootstrap every call.
+ *
+ * @param[out] uri_out The local agent's own bootstrapping URI, e.g. "DPP:V:3;K:...;;".
+ * @return true on success, false otherwise.
+ */
+bool load_local_bootstrap_into_agentdb(std::string &uri_out);
+
+} // namespace dpp
+} // namespace beerocks
+
+#endif // __DPP_BOOTSTRAP_UTILS_H__
