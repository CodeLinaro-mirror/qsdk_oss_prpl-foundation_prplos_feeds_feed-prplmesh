@@ -1379,6 +1379,11 @@ public:
         std::array<uint8_t, 32> pmk_1905 = {};
         bool pmk_valid = false;
 
+        // PMKID = Truncate-128(SHA-256(min(NK.x, PK.x) | max(NK.x, PK.x))), computed with the
+        // PMK. A Supplicant puts it in the RSNE of EAPOL-Key M2, which the Authenticator
+        // compares byte-for-byte against the RSNE it built from its own PMKID.
+        std::array<uint8_t, 16> pmkid = {};
+
         // 1905 PTK (512-bit, derived during 4-way handshake)
         std::array<uint8_t, 64> ptk_1905 = {};
 
