+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -8,6 +8,7 @@
 
 #include "backhaul_manager.h"
 #include "../agent_db.h"
+#include "../dpp_bootstrap_utils.h"
 
 #include <algorithm>
 
@@ -1268,6 +1269,7 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
                 LOG(INFO) << timestamp << "Backhaul Type: Invalid/Unknown";
             }
         }
+
         FSM_MOVE_STATE(OPERATIONAL);
         break;
     }
@@ -6223,6 +6225,61 @@ void BackhaulManager::handle_dev_reset_default(
     db->controller_info.early_ap_capability_report_sent = false;
     db->steering_policy.btm_steering_disallowed.clear();
 
+    // Undo the OnboardingType=DPP forced by GetLocalBootstrap for the previous test case -
+    // both the persisted config and the live, already-cached AgentDB flag (the DPP consumers
+    // - dpp_agent_task, backhaul_manager, ap_autoconfiguration_task, topology_task - gate on
+    // the in-memory flag right now, in this session, not on the persisted value). Without this,
+    // a WSC-only test run right after a DPP test would silently inherit DPP onboarding, since
+    // dev_set_config never carries this field itself.
+    bool was_dpp_onboarding = (db->dpp_extender_config.onboarding_type == AgentDB::OnboardingType::DPP);
+
+    bpl::cfg_set_onboarding_type("WSC");
+    db->dpp_extender_config.onboarding_type = AgentDB::OnboardingType::WSC;
+
+    if (was_dpp_onboarding) {
+        // Clear stale DPP state left over from the previous test case so the chirp gate
+        // (ap_autoconfiguration_task.cpp: dpp_onboarding_active) can re-arm cleanly on the
+        // next GetLocalBootstrap/dev_set_config,...,type,dpp cycle. Without this,
+        // dpp_1905_credentials.initialized stays permanently true once a DPP run completes,
+        // which would suppress the Chirp TLV on every subsequent Search in this boot even
+        // though onboarding_type is being forced back to DPP for the new test case.
+        db->dpp_bootstrap.valid = false;
+
+        auto controller_mac = db->controller_info.bridge_mac;
+        if (controller_mac != beerocks::net::network_utils::ZERO_MAC) {
+            // Remove the stale 1905-layer transport key (TK) derived for the previous
+            // DPP-onboarded controller - it no longer applies once this reset takes effect.
+            db->peer_1905_security.erase(controller_mac);
+            if (m_broker_client) {
+                m_broker_client->install_security_key(controller_mac, {}, {}, 0, false);
+            }
+        }
+
+        if (db->dpp_1905_credentials.nak_pkey) {
+            EVP_PKEY_free(db->dpp_1905_credentials.nak_pkey);
+            db->dpp_1905_credentials.nak_pkey = nullptr;
+        }
+        db->dpp_1905_credentials.connector.clear();
+        db->dpp_1905_credentials.nak_private_der.clear();
+        db->dpp_1905_credentials.c_sign_key_der.clear();
+        db->dpp_1905_credentials.c_sign_key_jwk.clear();
+        db->dpp_1905_credentials.pp_key_jwk.clear();
+        db->dpp_1905_credentials.initialized = false;
+
+        // dpp_wired_session.active is only ever cleared by DppAgentTask::reset_onboarding_progress()
+        // on a wireless<->wired connection-type switch, and is never cleared on successful
+        // completion of a wired DPP Auth exchange - a device that stays wired the whole session
+        // (the certification setup here) would otherwise have every subsequent Auth Request
+        // silently dropped as a "duplicate delivery" (see handle_dpp_wired_auth_request()'s
+        // guard), so no Auth Response would ever be sent on a repeated test cycle.
+        if (db->dpp_wired_session.active) {
+            db->dpp_wired_session.reset();
+        }
+
+        LOG(INFO) << "dev_reset_default: cleared stale DPP 1905 security state from the "
+                     "previous test case (bootstrap invalidated, 1905 TK removed)";
+    }
+
     //check if wired interface is enabled or try to enable it.
     if (!beerocks::net::network_utils::linux_iface_is_up_and_running(eth_iface)) {
         LOG(INFO) << "The wired interface " << eth_iface << " is not up, lets try to enable it";
@@ -6368,6 +6425,73 @@ bool BackhaulManager::handle_dev_set_config(int fd,
         return false;
     }
 
+    // "Type" is the WFA CAPI-documented onboarding-mechanism selector for this backhaul
+    // connection (Wi-Fi Test Suite Control API Specification: "The onboarding mechanism
+    // utilized by the Agent to onboard to the Controller" - only defined value is "DPP";
+    // absent means the default Profile-1/Profile-2 (WSC) onboarding). Force both the
+    // persisted platform config and the live AgentDB flag - DPP consumers (dpp_agent_task,
+    // backhaul_manager, ap_autoconfiguration_task, topology_task) gate on the in-memory
+    // flag within this session, while other code (e.g. ap_wlan_hal_nl80211.cpp) reads the
+    // platform value fresh - both must agree or the two layers would disagree on mode.
+    auto type_it = params.find("type");
+    if (type_it != params.end()) {
+        auto type_value = type_it->second;
+        std::transform(type_value.begin(), type_value.end(), type_value.begin(), ::tolower);
+        if (type_value == "dpp") {
+            auto db = AgentDB::get();
+            if (db->device_conf.certification_mode) {
+                bpl::cfg_set_onboarding_type("DPP");
+                db->dpp_extender_config.onboarding_type = AgentDB::OnboardingType::DPP;
+
+                // Defensive re-arm of the chirp gate (ap_autoconfiguration_task.cpp:
+                // dpp_onboarding_active) for this transition into DPP mode:
+                // - dpp_bootstrap.valid is normally already true here because
+                //   GetLocalBootstrap runs before this command in the WFA CAPI sequence,
+                //   but re-validate/populate it defensively in case this command arrives
+                //   without a preceding GetLocalBootstrap - load_local_bootstrap_into_agentdb()
+                //   is documented safe to call repeatedly (re-validates every call, only
+                //   generates a new key/URI if none exists yet).
+                // - dpp_1905_credentials.initialized (and the rest of the credential set)
+                //   can only legitimately be non-empty after a completed DPP 1905 handshake,
+                //   which cannot have happened yet at the moment we are just now switching
+                //   onboarding_type to DPP, so clear all of it unconditionally here too as a
+                //   second line of defense alongside the dev_reset_default reset - this is
+                //   what makes a repeated dev_reset_default -> GetLocalBootstrap ->
+                //   dev_set_config,...,type,dpp cycle (same boot, no restart) work again:
+                //   without this, stale credentials from the previous successful run remain,
+                //   and dpp_wired_session.active stays latched true from that prior Auth
+                //   exchange, so the next Auth Request is silently dropped as a "duplicate"
+                //   (see the guard at the top of handle_dpp_wired_auth_request) and no Auth
+                //   Response is ever sent.
+                std::string local_bootstrap_uri;
+                if (!beerocks::dpp::load_local_bootstrap_into_agentdb(local_bootstrap_uri)) {
+                    LOG(ERROR) << "Failed to load/generate local DPP bootstrap key/URI while "
+                                  "switching onboarding to DPP";
+                }
+                if (db->dpp_1905_credentials.nak_pkey) {
+                    EVP_PKEY_free(db->dpp_1905_credentials.nak_pkey);
+                    db->dpp_1905_credentials.nak_pkey = nullptr;
+                }
+                db->dpp_1905_credentials.connector.clear();
+                db->dpp_1905_credentials.nak_private_der.clear();
+                db->dpp_1905_credentials.c_sign_key_der.clear();
+                db->dpp_1905_credentials.c_sign_key_jwk.clear();
+                db->dpp_1905_credentials.pp_key_jwk.clear();
+                db->dpp_1905_credentials.initialized = false;
+
+                if (db->dpp_wired_session.active) {
+                    LOG(INFO) << "DPP: clearing stale wired session (controller="
+                              << db->dpp_wired_session.controller_mac
+                              << ") before starting a new DPP onboarding cycle";
+                    db->dpp_wired_session.reset();
+                }
+            }
+        } else {
+            err_string = "parameter 'type' has invalid value '" + type_it->second + "'";
+            return false;
+        }
+    }
+
     // Get the selected backhaul specified in received command.
     auto backhaul = backhaul_it->second;
     std::transform(backhaul.begin(), backhaul.end(), backhaul.begin(), ::tolower);
diff --git a/agent/src/beerocks/slave/dpp_bootstrap_utils.cpp b/agent/src/beerocks/slave/dpp_bootstrap_utils.cpp
new file mode 100644
index 000000000..a8d752dbd
--- /dev/null
+++ b/agent/src/beerocks/slave/dpp_bootstrap_utils.cpp
@@ -0,0 +1,408 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "dpp_bootstrap_utils.h"
+
+#include "agent_db.h"
+
+#include <easylogging++.h>
+
+#include <openssl/core_names.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/sha.h>
+
+#include <array>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <vector>
+
+namespace beerocks {
+namespace dpp {
+
+static const std::string KEY_DIR  = "/etc/prplmesh/dpp";
+static const std::string KEY_PATH = KEY_DIR + "/bootstrap_key.pem";
+static const std::string URI_PATH = "/etc/prplmesh/dpp_uri";
+
+bool ensure_local_bootstrap_uri(std::string &uri_out)
+{
+    bool key_missing = (access(KEY_PATH.c_str(), F_OK) != 0);
+    bool uri_missing = (access(URI_PATH.c_str(), F_OK) != 0);
+
+    if (key_missing || uri_missing) {
+        LOG(INFO) << "DPP: bootstrap " << (key_missing ? "key" : "URI") << " not found — "
+                  << (key_missing ? "generating new key pair"
+                                  : "regenerating URI from existing key");
+
+        // Create parent directory and key directory if needed (mkdir -p equivalent)
+        const std::string parent_dir = "/etc/prplmesh";
+        struct stat st {};
+        if (stat(parent_dir.c_str(), &st) != 0) {
+            if (mkdir(parent_dir.c_str(), 0755) != 0 && errno != EEXIST) {
+                LOG(ERROR) << "DPP: failed to create directory: " << parent_dir;
+                return false;
+            }
+        }
+        if (stat(KEY_DIR.c_str(), &st) != 0) {
+            if (mkdir(KEY_DIR.c_str(), 0700) != 0 && errno != EEXIST) {
+                LOG(ERROR) << "DPP: failed to create directory: " << KEY_DIR;
+                return false;
+            }
+        }
+
+        EVP_PKEY *new_key = nullptr;
+
+        if (!key_missing) {
+            // Key exists but URI is missing — load the existing key to regenerate URI.
+            // DO NOT generate a new key: that would change the chirp hash and break
+            // any controller that already has the old URI provisioned.
+            FILE *fp = fopen(KEY_PATH.c_str(), "r");
+            if (fp) {
+                new_key = PEM_read_PrivateKey(fp, nullptr, nullptr, nullptr);
+                fclose(fp);
+            }
+            if (!new_key) {
+                LOG(WARNING) << "DPP: failed to load existing key from " << KEY_PATH
+                             << " — generating new key pair";
+            } else {
+                LOG(INFO) << "DPP: loaded existing key, regenerating URI from it";
+            }
+        }
+
+        if (!new_key) {
+            // Either key is missing or loading failed — generate a new key pair
+            EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_id(EVP_PKEY_EC, nullptr);
+            if (pctx && EVP_PKEY_keygen_init(pctx) == 1 &&
+                EVP_PKEY_CTX_set_ec_paramgen_curve_nid(pctx, NID_X9_62_prime256v1) == 1) {
+                EVP_PKEY_keygen(pctx, &new_key);
+            }
+            if (pctx) EVP_PKEY_CTX_free(pctx);
+            if (!new_key) {
+                LOG(ERROR) << "DPP: EC P-256 key generation failed";
+                return false;
+            }
+
+            // Save new private key as PEM (only when key was missing/invalid)
+            FILE *fp = fopen(KEY_PATH.c_str(), "w");
+            if (!fp) {
+                LOG(ERROR) << "DPP: cannot create " << KEY_PATH;
+                EVP_PKEY_free(new_key);
+                return false;
+            }
+            if (PEM_write_PrivateKey(fp, new_key, nullptr, nullptr, 0, nullptr, nullptr) != 1) {
+                LOG(ERROR) << "DPP: PEM_write_PrivateKey failed";
+                fclose(fp);
+                EVP_PKEY_free(new_key);
+                return false;
+            }
+            fclose(fp);
+            chmod(KEY_PATH.c_str(), 0600);
+        } // end if (!new_key) — new key generation
+
+        // Export compressed SPKI DER for the URI K: field.
+        // hostapd uses compressed point form → shorter URI (~88 chars).
+        // Use OpenSSL 3.x EVP_PKEY_todata to get the compressed point, then
+        // build the SPKI DER manually (avoids deprecated EC_KEY APIs).
+        unsigned char *spki_der_ptr = nullptr;
+        int spki_len = 0;
+        {
+            // Request compressed public key via OSSL_PKEY_PARAM_EC_POINT_CONVERSION_FORMAT
+            // then export pub key. OpenSSL 3.x EVP_PKEY_todata approach:
+            OSSL_PARAM params[] = {OSSL_PARAM_construct_utf8_string(
+                                       OSSL_PKEY_PARAM_EC_POINT_CONVERSION_FORMAT,
+                                       const_cast<char *>("compressed"), 0),
+                                   OSSL_PARAM_END};
+            EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_from_pkey(nullptr, new_key, nullptr);
+            if (pctx) {
+                // Get compressed pubkey point (33 bytes for P-256)
+                uint8_t compressed[33] = {};
+                size_t comp_len        = 0;
+                // Set point format on a duplicate key
+                EVP_PKEY *dup = EVP_PKEY_dup(new_key);
+                if (dup) {
+                    // Use OSSL params to set compressed format
+                    if (EVP_PKEY_set_params(dup, params) == 1) {
+                        EVP_PKEY_get_octet_string_param(dup, OSSL_PKEY_PARAM_PUB_KEY, nullptr, 0,
+                                                         &comp_len);
+                        if (comp_len == 33) {
+                            EVP_PKEY_get_octet_string_param(dup, OSSL_PKEY_PARAM_PUB_KEY,
+                                                             compressed, 33, &comp_len);
+                        }
+                    }
+                    EVP_PKEY_free(dup);
+                }
+                EVP_PKEY_CTX_free(pctx);
+
+                if (comp_len == 33) {
+                    // Build SPKI DER for P-256 compressed point:
+                    // SEQUENCE(57) { SEQUENCE(19) { OID ecPublicKey, OID prime256v1 }
+                    //                BIT STRING(34) { 0x00 || compressed(33) } }
+                    static const uint8_t hdr[] = {0x30, 0x39, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86,
+                                                   0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a,
+                                                   0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03,
+                                                   0x22, 0x00};
+                    spki_len       = static_cast<int>(sizeof(hdr) + 33);
+                    spki_der_ptr   = static_cast<unsigned char *>(OPENSSL_malloc(spki_len));
+                    if (spki_der_ptr) {
+                        memcpy(spki_der_ptr, hdr, sizeof(hdr));
+                        memcpy(spki_der_ptr + sizeof(hdr), compressed, 33);
+                    } else {
+                        spki_len = 0;
+                    }
+                }
+            }
+            // Fallback to uncompressed SPKI DER
+            if (spki_len <= 0) {
+                spki_len = i2d_PUBKEY(new_key, &spki_der_ptr);
+            }
+        }
+        if (spki_len <= 0 || !spki_der_ptr) {
+            LOG(ERROR) << "DPP: i2d_PUBKEY failed";
+            EVP_PKEY_free(new_key);
+            return false;
+        }
+
+        // Base64url-encode for DPP URI (standard base64, URI uses std encoding with padding)
+        BIO *b64  = BIO_new(BIO_f_base64());
+        BIO *bmem = BIO_new(BIO_s_mem());
+        b64       = BIO_push(b64, bmem);
+        BIO_set_flags(b64, BIO_FLAGS_BASE64_NO_NL);
+        BIO_write(b64, spki_der_ptr, spki_len);
+        (void)BIO_flush(b64);
+        BUF_MEM *bptr = nullptr;
+        BIO_get_mem_ptr(bmem, &bptr);
+        std::string key_b64(bptr->data, bptr->length);
+        BIO_free_all(b64);
+        OPENSSL_free(spki_der_ptr);
+
+        // Build DPP URI
+        std::string new_uri = "DPP:V:3;K:" + key_b64 + ";;";
+
+        // Save URI to the shared whitelist file, which the co-located Controller's
+        // DppConfiguratorTask also reads/rewrites. Open with "a+" (not "w") and read the
+        // existing content first, under the same flock() the Controller uses in
+        // write_dpp_uris() (dpp_key_store.cpp), so any admin-provisioned ProvisionDPP
+        // entries the Controller already synced into this file survive this rewrite
+        // instead of being silently truncated away.
+        FILE *uf = fopen(URI_PATH.c_str(), "a+");
+        if (!uf) {
+            LOG(ERROR) << "DPP: cannot open " << URI_PATH;
+            EVP_PKEY_free(new_key);
+            return false;
+        }
+        flock(fileno(uf), LOCK_EX);
+
+        constexpr const char *local_agent_tag = "# local-agent";
+        std::vector<std::string> other_lines;
+        rewind(uf);
+        {
+            char rd_buf[1024];
+            bool skip_next = false;
+            while (fgets(rd_buf, sizeof(rd_buf), uf)) {
+                std::string line(rd_buf);
+                while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
+                    line.pop_back();
+                if (skip_next) {
+                    skip_next = false; // this line was the previous local-agent tag's URI
+                    continue;
+                }
+                if (line == local_agent_tag) {
+                    skip_next = true;
+                    continue;
+                }
+                if (!line.empty()) {
+                    other_lines.push_back(line);
+                }
+            }
+        }
+
+        if (ftruncate(fileno(uf), 0) != 0) {
+            LOG(ERROR) << "DPP: failed to truncate " << URI_PATH;
+            flock(fileno(uf), LOCK_UN);
+            fclose(uf);
+            EVP_PKEY_free(new_key);
+            return false;
+        }
+        rewind(uf);
+
+        fprintf(uf, "%s\n%s\n", local_agent_tag, new_uri.c_str());
+        for (const auto &line : other_lines) {
+            fprintf(uf, "%s\n", line.c_str());
+        }
+        flock(fileno(uf), LOCK_UN);
+        fclose(uf);
+
+        LOG(INFO) << "DPP: generated bootstrap key pair";
+        LOG(INFO) << "DPP: URI saved to " << URI_PATH;
+        LOG(INFO) << "DPP: URI=" << new_uri;
+        LOG(WARNING) << "DPP: IMPORTANT — back up " << KEY_PATH << " and " << URI_PATH
+                     << " before factory reset to preserve the same chirp hash";
+        LOG(WARNING) << "DPP: Provide this URI to the controller: " << new_uri;
+
+        EVP_PKEY_free(new_key);
+        // Fall through — the file now exists, read it back below
+    }
+
+    // Read back the local agent's own URI: the "# local-agent" tag is always written
+    // immediately followed by its URI as the first two lines of the file (whether just
+    // generated above, or already present from a previous run/process).
+    std::ifstream uri_file(URI_PATH);
+    if (!uri_file.is_open()) {
+        LOG(ERROR) << "DPP: cannot open DPP URI file: " << URI_PATH;
+        return false;
+    }
+    std::string uri_line;
+    while (std::getline(uri_file, uri_line)) {
+        uri_line.erase(uri_line.find_last_not_of(" \t\n\r") + 1);
+        if (uri_line.empty() || uri_line[0] == '#') {
+            continue;
+        }
+        break;
+    }
+    if (uri_line.empty()) {
+        LOG(ERROR) << "DPP: no bootstrap URI found in " << URI_PATH;
+        return false;
+    }
+
+    uri_out = uri_line;
+    return true;
+}
+
+bool load_local_bootstrap_into_agentdb(std::string &uri_out)
+{
+    if (!ensure_local_bootstrap_uri(uri_out)) {
+        return false;
+    }
+
+    // 1. Load private key from PEM file
+    FILE *fp = fopen(KEY_PATH.c_str(), "r");
+    if (!fp) {
+        LOG(ERROR) << "DPP: cannot open bootstrap key: " << KEY_PATH;
+        return false;
+    }
+    EVP_PKEY *pkey = PEM_read_PrivateKey(fp, nullptr, nullptr, nullptr);
+    fclose(fp);
+    if (!pkey) {
+        LOG(ERROR) << "DPP: failed to parse bootstrap private key from " << KEY_PATH;
+        return false;
+    }
+
+    // 2. Parse DPP URI — extract K: field → decode SPKI DER
+    const std::string k_prefix = "K:";
+    auto k_pos                 = uri_out.find(k_prefix);
+    if (k_pos == std::string::npos) {
+        LOG(ERROR) << "DPP: DPP URI missing K: field: " << uri_out;
+        EVP_PKEY_free(pkey);
+        return false;
+    }
+    k_pos += k_prefix.size();
+    auto k_end = uri_out.find(';', k_pos);
+    if (k_end == std::string::npos) k_end = uri_out.size();
+    std::string key_b64 = uri_out.substr(k_pos, k_end - k_pos);
+
+    // Base64-decode (standard + url-safe variants)
+    // Replace url-safe chars
+    for (char &c : key_b64) {
+        if (c == '-') c = '+';
+        if (c == '_') c = '/';
+    }
+    // Pad if needed
+    while (key_b64.size() % 4) key_b64 += '=';
+
+    std::vector<uint8_t> spki_der;
+    {
+        // Use OpenSSL BIO for base64 decode
+        BIO *b64  = BIO_new(BIO_f_base64());
+        BIO *bmem = BIO_new_mem_buf(key_b64.data(), static_cast<int>(key_b64.size()));
+        bmem      = BIO_push(b64, bmem);
+        BIO_set_flags(bmem, BIO_FLAGS_BASE64_NO_NL);
+        spki_der.resize(key_b64.size()); // upper bound
+        int decoded_len = BIO_read(bmem, spki_der.data(), static_cast<int>(spki_der.size()));
+        BIO_free_all(bmem);
+        if (decoded_len <= 0) {
+            LOG(ERROR) << "DPP: failed to base64-decode K: field from URI";
+            EVP_PKEY_free(pkey);
+            return false;
+        }
+        spki_der.resize(static_cast<size_t>(decoded_len));
+    }
+
+    // 3. Validate: derive public key from private key and compare with URI SPKI DER.
+    // The URI K: field uses compressed SPKI DER (59 bytes for P-256).
+    // i2d_PUBKEY exports uncompressed SPKI DER (91 bytes). Build compressed form
+    // to match the URI encoding before comparing.
+    {
+        bool match             = false;
+        unsigned char *pub_ptr = nullptr;
+        int pub_len            = i2d_PUBKEY(pkey, &pub_ptr);
+        if (pub_len > 0 && pub_ptr) {
+            // Uncompressed SPKI DER for P-256 ends with: 04 || x(32) || y(32)
+            if (pub_len >= 65) {
+                const unsigned char *point = pub_ptr + (pub_len - 65);
+                if (point[0] == 0x04) {
+                    const unsigned char *x = point + 1;
+                    const unsigned char *y = point + 33;
+                    unsigned char prefix   = (y[31] & 1) ? 0x03 : 0x02;
+                    // Compressed SPKI DER for P-256 (59 bytes):
+                    // 30 39 30 13 06 07 2a864 8ce3d020106082a8648ce3d030107 03 22 00 prefix x[32]
+                    static const unsigned char spki_prefix[] = {
+                        0x30, 0x39, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02,
+                        0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03,
+                        0x22, 0x00};
+                    std::vector<uint8_t> compressed_spki(sizeof(spki_prefix) + 1 + 32);
+                    memcpy(compressed_spki.data(), spki_prefix, sizeof(spki_prefix));
+                    compressed_spki[sizeof(spki_prefix)] = prefix;
+                    memcpy(compressed_spki.data() + sizeof(spki_prefix) + 1, x, 32);
+                    match = (compressed_spki.size() == spki_der.size() &&
+                             memcmp(compressed_spki.data(), spki_der.data(), spki_der.size()) == 0);
+                }
+            }
+            OPENSSL_free(pub_ptr);
+        }
+        if (!match) {
+            LOG(ERROR) << "DPP: bootstrap key mismatch — private key public point "
+                          "does not match K: field in DPP URI. "
+                          "Check /etc/prplmesh/dpp/ and /etc/prplmesh/dpp_uri";
+            EVP_PKEY_free(pkey);
+            return false;
+        }
+    }
+
+    // 4. Compute chirp_hash = SHA256("chirp" || SPKI_DER)
+    //    and pubkey_hash   = SHA256(SPKI_DER)  (hostapd pkhash for dpp_controller)
+    std::array<uint8_t, 32> chirp_hash{};
+    std::array<uint8_t, 32> pubkey_hash{};
+    {
+        std::vector<uint8_t> input;
+        const std::string chirp_prefix = "chirp";
+        input.insert(input.end(), chirp_prefix.begin(), chirp_prefix.end());
+        input.insert(input.end(), spki_der.begin(), spki_der.end());
+        SHA256(input.data(), input.size(), chirp_hash.data());
+    }
+    SHA256(spki_der.data(), spki_der.size(), pubkey_hash.data());
+
+    // 5. Store in AgentDB
+    auto db = AgentDB::get();
+    if (db->dpp_bootstrap.private_key) {
+        EVP_PKEY_free(db->dpp_bootstrap.private_key);
+    }
+    db->dpp_bootstrap.private_key = pkey;
+    db->dpp_bootstrap.key_der     = std::move(spki_der);
+    db->dpp_bootstrap.chirp_hash  = chirp_hash;
+    db->dpp_bootstrap.pubkey_hash = pubkey_hash;
+    db->dpp_bootstrap.dpp_uri     = uri_out;
+    db->dpp_bootstrap.valid       = true;
+
+    LOG(INFO) << "DPP: loaded bootstrap key from " << KEY_PATH;
+
+    return true;
+}
+
+} // namespace dpp
+} // namespace beerocks
