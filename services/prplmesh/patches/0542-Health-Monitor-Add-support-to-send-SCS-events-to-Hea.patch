+void db::notify_sp_request_sent(const sMacAddr &client_mac, uint8_t scsid, uint16_t qmid,
+                                 const std::vector<sMacAddr> &path)
+{
+    int task_id = health_monitoring_task_id;
+    if (task_id <= 0 || !m_controller_ctx) {
+        return;
+    }
+
+    HealthMonitoringTask::sSpRequestSentEvent event;
+    event.client_mac = client_mac;
+    event.scsid      = scsid;
+    event.qmid       = qmid;
+    event.path       = path;
+
+    m_controller_ctx->push_event_to_task(
+        task_id, static_cast<int>(HealthMonitoringTask::eEvent::SP_REQUEST_SENT), &event);
+}
