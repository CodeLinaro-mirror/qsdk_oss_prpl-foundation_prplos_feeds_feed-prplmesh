+void db::dm_trigger_sp_request_event(uint64_t incident_id, const std::string &detected_by,
+                                     const sMacAddr &client_mac, uint8_t scsid, uint16_t qmid)
+{
+#ifdef ENABLE_NBAPI
+    const std::string client_mac_str = tlvf::mac_to_string(client_mac);
+
+    std::string sta_dm_path;
+    auto sta = get_station(client_mac);
+    if (sta) {
+        sta_dm_path = sta->dm_path;
+    }
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", client_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",     sta_dm_path.c_str());
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID", incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy", detected_by.c_str());
+    amxc_var_add_key(uint32_t,  &event_data, "SCSID",      scsid);
+    amxc_var_add_key(uint32_t,  &event_data, "QMID",       qmid);
+
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.SPRequestFromController";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_sp_request_event: failed to trigger SPRequestFromController"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " client_mac=" << client_mac_str
+                   << " scsid=" << int(scsid) << " qmid=" << qmid;
+    } else {
+        LOG(DEBUG) << "dm_trigger_sp_request_event: triggered SPRequestFromController"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " client_mac=" << client_mac_str
+                   << " scsid=" << int(scsid) << " qmid=" << qmid;
+    }
+#else // !ENABLE_NBAPI
+    (void)incident_id;
+    (void)detected_by;
+    (void)client_mac;
+    (void)scsid;
+    (void)qmid;
+#endif // ENABLE_NBAPI
+}
