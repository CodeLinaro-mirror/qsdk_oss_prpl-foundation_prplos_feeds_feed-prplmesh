diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 023ed6dba..901180068 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -5576,6 +5576,45 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
             LOG(ERROR) << "send_cmdu_to_controller failed";
             return false;
         }
+
+        break;
+    }
+    case beerocks_message::ACTION_APMANAGER_QOS_MANAGEMENT_DESCRIPTOR_RESPONSE: {
+        /* Sent by ap_manager after each SCS_CONFIGURE hostapd call completes.
+         * Carries the actual install result — use it to notify the health monitoring
+         * task so it can restore the agent log level and send the SCSInstallResult
+         * notification to the controller. */
+        auto response = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_QOS_MANAGEMENT_DESCRIPTOR_RESPONSE>();
+        if (!response) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_QOS_MANAGEMENT_DESCRIPTOR_RESPONSE failed";
+            return false;
+        }
+
+        LOG(DEBUG) << "Received QoS Management Descriptor Response: qmid=" << response->qmid()
+                   << " client_mac=" << response->client_mac()
+                   << " success=" << int(response->success());
+
+        auto db = AgentDB::get();
+        const uint16_t qmid = response->qmid();
+        auto it = db->service_prioritization.pending_sp_incidents.find(qmid);
+        if (it != db->service_prioritization.pending_sp_incidents.end()) {
+            const auto &incident = it->second;
+            HealthMonitoringTask::sScsInstallResultEvent result_event;
+            result_event.incident_id = incident.incident_id;
+            result_event.client_mac  = incident.client_mac;
+            result_event.scsid       = incident.scsid;
+            result_event.qmid        = qmid;
+            result_event.success     = response->success() != 0;
+            task_pool_try_send_event(
+                eTaskType::HEALTH_MONITORING,
+                static_cast<uint8_t>(HealthMonitoringTask::eEvent::SCS_INSTALL_RESULT),
+                &result_event);
+            db->service_prioritization.pending_sp_incidents.erase(it);
+        } else {
+            LOG(DEBUG) << "QoS descriptor response: no pending SP incident for qmid=" << qmid
+                       << ", skipping SCSInstallResult notification";
+        }
         break;
     }
     case beerocks_message::ACTION_APMANAGER_MAPC_NEGOTIATION_STATUS_NOTIFICATION: {
