From 09a530c1b69dbf6adc6a4993517639fab9aa08e6 Mon Sep 17 00:00:00 2001
From: mpaluri <mpaluri@qti.qualcomm.com>
Date: Tue, 20 Oct 2026 14:48:56 -0700
Subject: [PATCH] Health Monitor: Add support to send SCS events to Health 
 Monitor

Send SCS event notification to Health Monitor in Controller. Also, send
1905 notifications to Health Monitor that are in the path to the client
while sending Service Prioritization Requests to them.

Signed-off-by: Manaswini Paluri <mpaluri@qti.qualcomm.com>

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 602c2c99a..2700d676c 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -3596,12 +3596,33 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                 return;
             }
 
-            if (!ap_wlan_hal->handle_qos_management_descriptor(
+            const bool install_ok = ap_wlan_hal->handle_qos_management_descriptor(
                     descriptor_tlv->bssid(), descriptor_tlv->qmid(), descriptor_tlv->client_mac(),
-                    peer_mac, descriptor_element, 1)) {
+                    peer_mac, descriptor_element, 1);
+
+            if (!install_ok) {
                 LOG(ERROR) << "handle_qos_management_descriptor failed for BSSID "
                            << descriptor_tlv->bssid() << ", client "
                            << descriptor_tlv->client_mac();
+            }
+
+            /* Send the install result back to son_slave_thread regardless of success/failure
+             * so it can notify the health monitoring task (Debug Agent log level restore). */
+            auto response = message_com::create_vs_message<
+                beerocks_message::cACTION_APMANAGER_QOS_MANAGEMENT_DESCRIPTOR_RESPONSE>(cmdu_tx);
+            if (!response) {
+                LOG(ERROR) << "Failed building QoS management descriptor response";
+                if (!install_ok) {
+                    return;
+                }
+            } else {
+                response->qmid()       = descriptor_tlv->qmid();
+                response->client_mac() = descriptor_tlv->client_mac();
+                response->success()    = install_ok ? 1 : 0;
+                send_cmdu(cmdu_tx);
+            }
+
+            if (!install_ok) {
                 return;
             }
         }
