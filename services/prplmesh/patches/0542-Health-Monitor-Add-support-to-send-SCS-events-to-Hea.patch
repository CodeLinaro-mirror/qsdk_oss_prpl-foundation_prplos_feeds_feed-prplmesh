+bool HealthMonitoringTask::handle_sp_request_notification(
+    const sMacAddr &src_mac, std::shared_ptr<beerocks_header> beerocks_header)
+{
+    auto notification = beerocks_header->addClass<
+        beerocks_message::cACTION_CONTROL_HEALTH_MONITOR_SP_REQUEST_NOTIFICATION>();
+    if (!notification) {
+        LOG(ERROR) << "HEALTH_MONITORING: addClass "
+                      "cACTION_CONTROL_HEALTH_MONITOR_SP_REQUEST_NOTIFICATION failed";
+        return false;
+    }
+
+    auto db                  = AgentDB::get();
+    const auto controller_id = tlvf::mac_to_string(db->controller_info.bridge_mac);
+
+    LOG(DEBUG) << "HEALTH_MONITORING: received SPRequestFromController notification from "
+                  "controller "
+               << src_mac << " incident_id=" << notification->incident_id()
+               << " client_mac=" << notification->client_mac()
+               << " scsid=" << int(notification->scsid())
+               << " qmid=" << notification->qmid();
+
+    /* Store the incident context keyed by qmid so son_slave_thread can
+     * look it up when the QoS descriptor install completes. */
+    decltype(db->service_prioritization.pending_sp_incidents)::mapped_type incident;
+    incident.incident_id = notification->incident_id();
+    incident.client_mac  = notification->client_mac();
+    incident.scsid       = notification->scsid();
+    db->service_prioritization.pending_sp_incidents[notification->qmid()] = incident;
+
+    db->dm_trigger_sp_request_event(notification->incident_id(), controller_id,
+                                    notification->client_mac(), notification->scsid(),
+                                    notification->qmid());
+
+    return true;
+}
+
+bool HealthMonitoringTask::send_scs_install_result_notification(uint64_t incident_id,
+                                                                const sMacAddr &client_mac,
+                                                                uint8_t scsid, uint16_t qmid,
+                                                                bool success)
+{
+    auto notification = beerocks::message_com::create_vs_message<
+        beerocks_message::cACTION_CONTROL_HEALTH_MONITOR_SCS_INSTALL_RESULT_NOTIFICATION>(
+        m_cmdu_tx);
+    if (!notification) {
+        LOG(ERROR) << "HEALTH_MONITORING: Failed building "
+                      "cACTION_CONTROL_HEALTH_MONITOR_SCS_INSTALL_RESULT_NOTIFICATION";
+        return false;
+    }
+    notification->incident_id() = incident_id;
+    notification->client_mac()  = client_mac;
+    notification->scsid()       = scsid;
+    notification->qmid()        = qmid;
+    notification->success()     = success ? 1 : 0;
+
+    auto db = AgentDB::get();
+    if (!m_btl_ctx.send_cmdu_to_controller(db->backhaul.selected_iface_name, m_cmdu_tx)) {
+        LOG(ERROR) << "HEALTH_MONITORING: Failed sending SCSInstallResult notification"
+                   << " incident_id=" << incident_id
+                   << " client_mac=" << client_mac
+                   << " scsid=" << int(scsid) << " qmid=" << qmid
+                   << " success=" << success;
+        return false;
+    }
+    LOG(DEBUG) << "HEALTH_MONITORING: sent SCSInstallResult notification"
+               << " incident_id=" << incident_id
+               << " client_mac=" << client_mac
+               << " scsid=" << int(scsid) << " qmid=" << qmid
+               << " success=" << success;
+    return true;
+}
