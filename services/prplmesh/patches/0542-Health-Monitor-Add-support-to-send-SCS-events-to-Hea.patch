+
+bool HealthMonitoringTask::send_sp_request_notification(const sMacAddr &agent_al_mac,
+                                                        uint64_t incident_id,
+                                                        const sMacAddr &client_mac, uint8_t scsid,
+                                                        uint16_t qmid)
+{
+    auto notification = beerocks::message_com::create_vs_message<
+        beerocks_message::cACTION_CONTROL_HEALTH_MONITOR_SP_REQUEST_NOTIFICATION>(m_cmdu_tx);
+    if (!notification) {
+        LOG(ERROR) << "HEALTH_MONITORING: Failed building "
+                      "cACTION_CONTROL_HEALTH_MONITOR_SP_REQUEST_NOTIFICATION for agent "
+                   << agent_al_mac;
+        return false;
+    }
+    notification->incident_id() = incident_id;
+    notification->client_mac()  = client_mac;
+    notification->scsid()       = scsid;
+    notification->qmid()        = qmid;
+
+    if (!son_actions::send_cmdu_to_agent(agent_al_mac, m_cmdu_tx, m_database)) {
+        LOG(ERROR) << "HEALTH_MONITORING: Failed to send SPRequest notification to agent "
+                   << agent_al_mac;
+        return false;
+    }
+    LOG(DEBUG) << "HEALTH_MONITORING: sent SPRequest notification to agent "
+               << agent_al_mac << " incident_id=" << incident_id
+               << " client_mac=" << client_mac
+               << " scsid=" << int(scsid) << " qmid=" << qmid;
+    return true;
+}
