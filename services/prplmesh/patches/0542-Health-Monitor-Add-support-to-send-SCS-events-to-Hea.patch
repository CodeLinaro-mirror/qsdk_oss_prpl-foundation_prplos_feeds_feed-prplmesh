+void HealthMonitoringTask::enqueue_agent_notification(const sMacAddr &agent_al_mac,
+                                                      uint64_t incident_id,
+                                                      const sMacAddr &client_mac, uint8_t scsid,
+                                                      uint16_t qmid)
+{
+    sPendingAgentNotification pending;
+    pending.agent_al_mac = agent_al_mac;
+    pending.send_time    = std::chrono::steady_clock::now() + AGENT_NOTIFICATION_DELAY;
+    pending.send_fn      = [this, agent_al_mac, incident_id, client_mac, scsid, qmid]() {
+        send_sp_request_notification(agent_al_mac, incident_id, client_mac, scsid, qmid);
+    };
+
+    m_pending_agent_notifications.push_back(pending);
+
+    LOG(DEBUG) << "HEALTH_MONITORING: enqueued SPRequest notification for agent "
+               << agent_al_mac << " incident_id=" << incident_id
+               << " client_mac=" << client_mac
