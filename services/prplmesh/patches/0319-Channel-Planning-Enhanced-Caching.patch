+    // Helper: 320MHz-1 and 320MHz-2 are physically distinct 320MHz-wide blocks (offset by 160MHz;
+    // different center frequencies; different beacon-channel coverage). Both have bw_mhz==320, so a
+    // pure-numeric-MHz comparison in the exact-match branch below would silently leak a rank from
+    // one variant into the other's cache cell (e.g. driver ranks (chan=101, 320MHz-2) at rank=7 and
+    // the projection then applies rank=7 to (chan=101, 320MHz-1) too, which is a completely
+    // different physical spectrum slice the driver never scanned). The exact-match branch must
+    // therefore require SAME-VARIANT identity for the two 320MHz variants, not just same MHz.
+    const auto is_same_320_variant_class = [](beerocks::eWiFiBandwidth a,
+                                              beerocks::eWiFiBandwidth b) -> bool {
+        const bool a_is_320 = (a == beerocks::eWiFiBandwidth::BANDWIDTH_320 ||
+                               a == beerocks::eWiFiBandwidth::BANDWIDTH_320_1 ||
+                               a == beerocks::eWiFiBandwidth::BANDWIDTH_320_2);
+        const bool b_is_320 = (b == beerocks::eWiFiBandwidth::BANDWIDTH_320 ||
+                               b == beerocks::eWiFiBandwidth::BANDWIDTH_320_1 ||
+                               b == beerocks::eWiFiBandwidth::BANDWIDTH_320_2);
+        if (!a_is_320 || !b_is_320) {
+            // Not a 320MHz comparison -> nothing to guard here; the numeric MHz check in the
+            // caller is sufficient for all other widths (20/40/80/160 have a single enum each).
+            return true;
+        }
+        // Both sides are 320MHz. Only the two SPECIFIC variants must be kept apart. Treat the
+        // generic BANDWIDTH_320 as compatible with either specific variant so that any legacy
+        // callers that store rank under the generic enum are not accidentally dropped.
+        if (a == beerocks::eWiFiBandwidth::BANDWIDTH_320 ||
+            b == beerocks::eWiFiBandwidth::BANDWIDTH_320) {
+            return true;
+        }
+        return a == b;
+    };
