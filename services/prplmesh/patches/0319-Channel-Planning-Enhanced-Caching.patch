index 071cb5d..f83fb78 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -453,11 +453,45 @@ public:
             uint8_t preference                         = 0;
             wfa_map::cPreferenceOperatingClasses::eReasonCode reason =
                 wfa_map::cPreferenceOperatingClasses::eReasonCode::UNSPECIFIED;
+
+            // Best (lowest positive) DIRECT driver rank observed for this PRIMARY channel across
+            // ANY bandwidth in the CBS report, independent of the projection. This is used as a
+            // secondary tie-break in select_best_channel_from_cbs when multiple primaries share
+            // the same projected wide-BW rank_key: prefer the primary the driver ACTUALLY ranked
+            // (positive direct rank) over primaries that only got a rank via wider-op-class MIN
+            // projection (where the wide 80MHz block's rank leaks onto every 20MHz sub-channel it
+            // covers).
+            //
+            // Example (5GHz): driver ranks (chan=60, 40MHz) at rank=3. The 80MHz block containing
+            // {52,56,60,64} then projects rank=3 onto ALL four 80MHz entries. Without this field,
+            // the winner-selection tie-break picks whichever chan iterates first (chan=52).
+            // With this field, chan=60 wins because it has a positive DIRECT driver rank and the
+            // others don't, honouring the driver's actual best-primary decision.
+            //
+            // Semantics: 0 = no positive direct rank on this primary at any bandwidth (rank was
+            //                purely projected from a wider block); INT32_MAX = same as 0 sentinel;
+            //            >0 = the best positive direct rank the driver reported for this primary
+            //                 on any single (chan, bw) row.
+            int32_t direct_rank_min_bw = 0;
         };
 
         struct sPreferenceTable {
-            // key: op_class -> (channel -> entry)
-            std::map<uint8_t, std::map<uint8_t, sPreferenceEntry>> by_opclass_channel;
+            // key: op_class -> (channel -> (bandwidth -> entry))
+            //
+            // The third dimension (bandwidth) is REQUIRED for 6GHz op-class 137 (320MHz), which
+            // has two physically distinct variants (BANDWIDTH_320_1 and BANDWIDTH_320_2) that
+            // both map to the SAME op-class number but differ in center frequency, beacon-channel
+            // coverage and the driver's per-block CBS rank. A 2-level map keyed only on
+            // (op_class, chan) collapsed both variants into ONE cell, so whichever the
+            // supported_bw_list iterated LAST silently overwrote the other, dropping the
+            // positive rank of the actually-scanned variant. For all other op-classes the
+            // (chan) already uniquely identifies the bandwidth (e.g. op-class 131 -> 20MHz
+            // only, 132 -> 40MHz only, ...) so the inner map has a single entry per (op_class,
+            // chan). Keying on (op_class, chan, bw) is the general, variant-safe shape.
+            std::map<uint8_t,
+                     std::map<uint8_t,
+                              std::map<beerocks::eWiFiBandwidth, sPreferenceEntry>>>
+                by_opclass_channel;
             bool valid = false;
             std::chrono::steady_clock::time_point last_cbs_complete{};
             beerocks::eWiFiBandwidth cbs_measurement_bw = beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN;
