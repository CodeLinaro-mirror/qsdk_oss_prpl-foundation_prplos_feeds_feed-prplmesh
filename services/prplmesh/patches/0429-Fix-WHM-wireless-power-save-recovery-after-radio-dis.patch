-void BackhaulManager::maybe_start_backhaul_recovery_cycle()
+bool BackhaulManager::all_radios_teardown_confirmed()
+{
+    if (m_radios_info.empty()) {
+        return false;
+    }
+
+    return std::all_of(m_radios_info.begin(), m_radios_info.end(),
+                       [](const std::shared_ptr<sRadioInfo> &radio_info) {
+                           return radio_info->radio_disabled &&
+                                  radio_info->vaps_teardown_confirmed;
+                       });
+}
+
+void BackhaulManager::maybe_start_backhaul_recovery_cycle_if_ready()
+{
+    LOG(DEBUG) << "Recovery readiness: all_radios_disabled=" << all_radios_disabled()
+               << ", all_vaps_teardown_confirmed=" << all_radios_teardown_confirmed()
+               << ", fully_disconnected=" << is_backhaul_fully_disconnected();
+
+    if (!all_radios_disabled() || !all_radios_teardown_confirmed() ||
+        !is_backhaul_fully_disconnected()) {
+        return;
+    }
+
+    maybe_start_backhaul_recovery_cycle();
+}
+
+bool BackhaulManager::is_wifi8_platform()
+{
+    auto db = AgentDB::get();
+    for (const auto &radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        std::string htmode;
+        if (beerocks::bpl::bpl_cfg_get_radio_htmode(radio->front.iface_name, htmode) &&
+            htmode.size() >= 3 && htmode.compare(0, 3, "UHR") == 0) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+void BackhaulManager::send_powersave_request(eFreqType freq, bool enable)
+{
+    auto radio_mac = freq_to_radio_mac(freq);
+    if (radio_mac.empty()) {
+        LOG(DEBUG) << "No " << (freq == eFreqType::FREQ_5G ? "5 GHz" : "6 GHz")
+                   << " radio found for powersave request";
+        return;
+    }
+
+    auto radio = std::find_if(m_radios_info.begin(), m_radios_info.end(),
+                              [&](const std::shared_ptr<sRadioInfo> &info) {
+                                  return info->radio_mac == tlvf::mac_from_string(radio_mac);
+                              });
+    if (radio == m_radios_info.end()) {
+        LOG(DEBUG) << (freq == eFreqType::FREQ_5G ? "5 GHz" : "6 GHz") << " radio " << radio_mac
+                   << " not present in m_radios_info";
+        return;
+    }
+
+    if (enable) {
+        auto request = message_com::create_vs_message<
+            beerocks_message::cACTION_BACKHAUL_RADIO_POWERSAVE_ENABLE_REQUEST>(cmdu_tx);
+        if (!request) {
+            LOG(ERROR) << "Failed building powersave-enable request for "
+                       << (freq == eFreqType::FREQ_5G ? "5 GHz" : "6 GHz");
+            return;
+        }
+        request->set_iface((*radio)->hostap_iface);
+    } else {
+        auto request = message_com::create_vs_message<
+            beerocks_message::cACTION_BACKHAUL_RADIO_POWERSAVE_DISABLE_REQUEST>(cmdu_tx);
+        if (!request) {
+            LOG(ERROR) << "Failed building powersave-disable request for "
+                       << (freq == eFreqType::FREQ_5G ? "5 GHz" : "6 GHz");
+            return;
+        }
+        request->set_iface((*radio)->hostap_iface);
+    }
+    send_cmdu(m_agent_fd, cmdu_tx);
+    LOG(INFO) << "Sent " << (freq == eFreqType::FREQ_5G ? "5 GHz" : "6 GHz")
+              << " powersave-" << (enable ? "enable" : "disable")
+              << " request for " << (*radio)->hostap_iface;
+}
+
+void BackhaulManager::send_5g_powersave_request(bool enable)
+{
+    send_powersave_request(eFreqType::FREQ_5G, enable);
+}
+
+void BackhaulManager::send_6g_powersave_request(bool enable)
+{
+    send_powersave_request(eFreqType::FREQ_6G, enable);
+}
+
+void BackhaulManager::schedule_wired_teardown_powersave_enable()
+{
+    if (!m_eth_link_up || !all_radios_disabled() || !all_radios_teardown_confirmed()) {
+        return;
+    }
+
+    if (m_wired_teardown_powersave_enabled ||
+        m_wired_teardown_powersave_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        return;
+    }
+
+    LOG(INFO) << "All APs/endpoints are torn down with wired backhaul available - scheduling "
+                 "powersave-enable after 15 seconds";
+    m_wired_teardown_powersave_timer = m_timer_manager->add_timer(
+        "Wired Teardown Powersave Enable", std::chrono::seconds(15),
+        std::chrono::milliseconds::zero(), [this](int fd, beerocks::EventLoop &loop) {
+            m_timer_manager->remove_timer(fd);
+            m_wired_teardown_powersave_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+            if (!m_eth_link_up || !all_radios_disabled() || !all_radios_teardown_confirmed()) {
+                LOG(INFO) << "Wired teardown powersave-enable cancelled because conditions changed";
+                return true;
+            }
