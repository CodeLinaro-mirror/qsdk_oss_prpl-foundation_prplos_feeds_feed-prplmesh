 // "one MLD reconfiguration in-flight" guard, which stays busy for a short async tail
@@ -56,6 +57,89 @@ static constexpr auto LINK_REMOVE_LOCK_POLL_INTERVAL = std::chrono::milliseconds
 // a few times with a short delay rather than treating the first rejection as final.
 static constexpr int  LINK_REMOVE_CMD_MAX_ATTEMPTS = 3;
 static constexpr auto LINK_REMOVE_CMD_RETRY_DELAY  = std::chrono::milliseconds(300);
+static constexpr int  MLD_ADD_CTRL_READY_MAX_RETRIES = 25;
+static constexpr auto MLD_ADD_CTRL_READY_RETRY_DELAY  = std::chrono::milliseconds(200);
+static constexpr int  MLD_ADD_TARGET_READY_MAX_RETRIES = 50;
+static constexpr auto MLD_ADD_TARGET_READY_RETRY_DELAY = std::chrono::milliseconds(200);
+static constexpr char MLD_RECONFIG_LOCK_PATH[] =
+    "/var/lock/prplmesh-mld-reconfig.lock";
+
+class ScopedMldReconfigLock {
+public:
+    ScopedMldReconfigLock(const std::string &iface, const char *operation)
+        : m_iface(iface), m_operation(operation)
+    {
+        // All radios share one hostapd instance and one driver MLO reconfiguration
+        // state machine. A per-interface lock is insufficient: ADD/MLD_ADD_LINK for
+        // different MLDs can still run concurrently and exhaust the driver or make
+        // hostapd create the same cross-radio interface twice.
+        m_fd = open(MLD_RECONFIG_LOCK_PATH, O_CREAT | O_RDWR, 0644);
+        if (m_fd < 0) {
+            LOG(WARNING) << m_operation << " lock open failed for " << m_iface << ": "
+                         << strerror(errno);
+            return;
+        }
+
+        struct flock lk {};
+        lk.l_type   = F_WRLCK;
+        lk.l_whence = SEEK_SET;
+        lk.l_start  = 0;
+        lk.l_len    = 0;
+
+        int ret;
+        const auto deadline = std::chrono::steady_clock::now() + MLD_RECONFIG_LOCK_TIMEOUT;
+        while (true) {
+            ret = fcntl(m_fd, F_SETLK, &lk);
+            if (ret >= 0 || (errno != EAGAIN && errno != EACCES && errno != EINTR)) {
+                break;
+            }
+            if (std::chrono::steady_clock::now() >= deadline) {
+                errno = ETIMEDOUT;
+                break;
+            }
+            std::this_thread::sleep_for(MLD_RECONFIG_LOCK_POLL_INTERVAL);
+        }
+
+        if (ret < 0) {
+            LOG(WARNING) << m_operation << " lock acquire failed for " << m_iface << ": "
+                         << strerror(errno);
+            close(m_fd);
+            m_fd = -1;
+            return;
+        }
+
+        m_locked = true;
+        LOG(INFO) << m_operation << " lock acquired for " << m_iface;
+    }
+
+    ~ScopedMldReconfigLock()
+    {
+        if (m_fd < 0) {
+            return;
+        }
+
+        if (m_locked) {
+            struct flock lk {};
+            lk.l_type   = F_UNLCK;
+            lk.l_whence = SEEK_SET;
+            lk.l_start  = 0;
+            lk.l_len    = 0;
+            if (fcntl(m_fd, F_SETLK, &lk) < 0) {
+                LOG(WARNING) << m_operation << " lock release failed for " << m_iface << ": "
+                             << strerror(errno);
+            } else {
+                LOG(INFO) << m_operation << " lock released for " << m_iface;
+            }
+        }
+        close(m_fd);
+    }
+
+private:
+    std::string m_iface;
+    const char *m_operation = nullptr;
+    int m_fd                = -1;
+    bool m_locked           = false;
+};
 
