From 91c9d2ac01fa517ca734e8b14d8e26dcc358f12b Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 14 Jan 2026 11:27:24 +0530
Subject: [PATCH] fetching sta_iface from prplmesh config using radio_id

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../beerocks/slave/beerocks_agent_main.cpp    | 47 +++++++++++++++++--
 .../platform_manager/platform_manager.cpp     | 35 +++++++++++---
 2 files changed, 72 insertions(+), 10 deletions(-)

diff --git a/agent/src/beerocks/slave/beerocks_agent_main.cpp b/agent/src/beerocks/slave/beerocks_agent_main.cpp
index 4a877cfbb..891a2bb33 100644
--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -158,14 +158,21 @@ static bool parse_arguments(int argc, char *argv[])
     return true;
 }
 
-static std::string get_sta_iface_from_hostap_iface(const std::string &hostap_iface)
+
+#ifdef USE_PRPLMESH_NLHAL
+static std::string get_sta_iface_from_hostap_iface(const std::string &hostap_iface, int radio_num)
 {
+    LOG(INFO) << "BEEROCKS_AGENT: get_sta_iface radio_num: " << radio_num << " hostapd_iface:" << hostap_iface;
+
     // read the sta_iface from bpl and verify it is available
+    char sta_iface_str[BPL_IFNAME_LEN];
     std::string sta_iface;
-    if (beerocks::bpl::cfg_get_sta_iface(hostap_iface, sta_iface) < 0) {
+
+    if (beerocks::bpl::cfg_get_sta_iface_with_radio_id(radio_num, sta_iface_str) < 0){
         LOG(ERROR) << "failed to read sta_iface for slave ";
         return std::string();
     } else {
+        sta_iface = std::string(sta_iface_str);
         if (!beerocks::net::network_utils::linux_iface_exists(sta_iface)) {
             LOG(DEBUG) << "sta iface " << sta_iface << " does not exist, clearing it from config";
             sta_iface.clear();
@@ -173,16 +180,37 @@ static std::string get_sta_iface_from_hostap_iface(const std::string &hostap_ifa
         }
 
         LOG(DEBUG) << "sta iface " << sta_iface << " exist in interface list";
-#ifdef USE_PRPLMESH_NLHAL        
         if (!beerocks::net::network_utils::linux_iface_is_up(sta_iface)) {
             LOG(DEBUG) << "sta iface " << sta_iface << " is not in up state, clearing it from config";
             sta_iface.clear();
             return std::string();
         }
-#endif
     }
     return sta_iface;
 }
+#else
+static std::string get_sta_iface_from_hostap_iface(const std::string &hostap_iface)
+{
+    // read the sta_iface from bpl and verify it is available
+    char sta_iface_str[BPL_IFNAME_LEN];
+    std::string sta_iface;
+
+    if (beerocks::bpl::cfg_get_sta_iface(hostap_iface.c_str(), sta_iface_str) < 0) {
+        LOG(ERROR) << "failed to read sta_iface for slave ";
+        return std::string();
+    } else {
+        sta_iface = std::string(sta_iface_str);
+        if (!beerocks::net::network_utils::linux_iface_exists(sta_iface)) {
+            LOG(DEBUG) << "sta iface " << sta_iface << " does not exist, clearing it from config";
+            sta_iface.clear();
+            return std::string();
+        }
+
+        LOG(DEBUG) << "sta iface " << sta_iface << " exist in interface list";
+    }
+    return sta_iface;
+}
+#endif
 
 static void fill_son_slave_config(const beerocks::config_file::sConfigSlave &beerocks_slave_conf,
                                   beerocks::slave_thread::sAgentConfig &agent_conf,
@@ -245,8 +273,13 @@ static void fill_son_slave_config(const beerocks::config_file::sConfigSlave &bee
                 (!beerocks_slave_conf.hostap_ant_gain[fronthaul_num].empty())
                     ? beerocks::string_utils::stoi(beerocks_slave_conf.hostap_ant_gain[fronthaul_num])
                     : 0;
+#ifdef USE_PRPLMESH_NLHAL
+            agent_conf.radios[fronthaul_iface].backhaul_wireless_iface =
+                get_sta_iface_from_hostap_iface(iface_element.second,iface_element.first);
+#else
             agent_conf.radios[fronthaul_iface].backhaul_wireless_iface =
                 get_sta_iface_from_hostap_iface(iface_element.second);
+#endif
             agent_conf.radios[fronthaul_iface].backhaul_wireless_iface_filter_low =
                 (!beerocks_slave_conf.sta_iface_filter_low[fronthaul_num].empty())
                     ? beerocks::string_utils::stoi(
@@ -381,6 +414,12 @@ static int run_beerocks_slave(beerocks::config_file::sConfigSlave &beerocks_slav
     }
     g_loggers.push_back(agent_logger);
 
+    for (const auto& it : interfaces_map) {
+        LOG(INFO) << "RADIO_ID: " << it.first
+                  << ", HOSTAP_IFACE: " << it.second;
+    }
+
+
     // Write pid file
     beerocks::os_utils::write_pid_file(beerocks_slave_conf.temp_path, BEEROCKS_AGENT);
     std::string pid_file_path =
diff --git a/agent/src/beerocks/slave/platform_manager/platform_manager.cpp b/agent/src/beerocks/slave/platform_manager/platform_manager.cpp
index f951a143b..3926aa22c 100644
--- a/agent/src/beerocks/slave/platform_manager/platform_manager.cpp
+++ b/agent/src/beerocks/slave/platform_manager/platform_manager.cpp
@@ -47,27 +47,47 @@ constexpr std::chrono::milliseconds check_wlan_params_changed_timer_interval(500
 //////////////////////////////////////////////////////////////////////////////
 /////////////////////////// Local Module Functions ///////////////////////////
 //////////////////////////////////////////////////////////////////////////////
-static std::string get_sta_iface(const std::string &hostap_iface)
+#ifdef USE_PRPLMESH_NLHAL
+static std::string get_sta_iface(const std::string &hostap_iface, int radio_num)
 {
-    std::string sta_iface;
-    if (bpl::cfg_get_sta_iface(hostap_iface, sta_iface) < 0) {
+    LOG(INFO) << "CCNS PLATFORM_MANAGER: get_sta_iface radio_num: " << radio_num << " hostadp_iface:" << hostap_iface;
+
+    char sta_iface_str[BPL_IFNAME_LEN];
+    if (bpl::cfg_get_sta_iface_with_radio_id(radio_num, sta_iface_str) < 0){
         LOG(DEBUG) << "failed to read sta_iface for slave ";
         return std::string();
     }
+    auto sta_iface = std::string(sta_iface_str);
     if (!beerocks::net::network_utils::linux_iface_exists(sta_iface)) {
         LOG(DEBUG) << "sta iface " << sta_iface << " does not exist, clearing it from config";
         return std::string();
     }
 
     LOG(DEBUG) << "sta iface " << sta_iface << " exist in interface list";
-#ifdef USE_PRPLMESH_NLHAL
     if (!beerocks::net::network_utils::linux_iface_is_up(sta_iface)) {
         LOG(DEBUG) << "sta iface " << sta_iface << " is not in up state, clearing it from config";
         return std::string();
     }
-#endif
     return sta_iface;
 }
+#else
+static std::string get_sta_iface(const std::string &hostap_iface)
+{
+    char sta_iface_str[BPL_IFNAME_LEN];
+    if (bpl::cfg_get_sta_iface(hostap_iface.c_str(), sta_iface_str) < 0) {
+        LOG(DEBUG) << "failed to read sta_iface for slave ";
+        return std::string();
+    }
+    auto sta_iface = std::string(sta_iface_str);
+    if (!beerocks::net::network_utils::linux_iface_exists(sta_iface)) {
+        LOG(DEBUG) << "sta iface " << sta_iface << " does not exist, clearing it from config";
+        return std::string();
+    }
+
+    LOG(DEBUG) << "sta iface " << sta_iface << " exist in interface list";
+    return sta_iface;
+}
+#endif
 
 //////////////////////////////////////////////////////////////////////////////
 /////////////////////////////// Implementation ///////////////////////////////
@@ -177,8 +197,11 @@ bool PlatformManager::start()
         if (hostap_iface_elm == interfaces_map.end() || hostap_iface_elm->second.empty())
             continue;
 
+#ifdef USE_PRPLMESH_NLHAL
+        config.sta_iface[slave_num] = get_sta_iface(hostap_iface_elm->second,hostap_iface_elm->first);
+#else
         config.sta_iface[slave_num] = get_sta_iface(hostap_iface_elm->second);
-
+#endif
         if (config.sta_iface[slave_num].empty())
             continue;
 
