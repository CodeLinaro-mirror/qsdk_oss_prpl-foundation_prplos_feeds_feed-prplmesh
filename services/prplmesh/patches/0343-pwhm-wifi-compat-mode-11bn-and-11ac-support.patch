From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 13 Aug 2026 11:44:14 +0530
Subject: [PATCH] pwhm wifi compat mode 11bn and 11ac support

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp |   6 +-
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp   | 182 ++++++++++++++----
 controller/whm/wifi_manager.cpp               |  11 +-
 .../platform/bpl/cfg/dm/bpl_cfg_wifi.cpp      |  81 ++++++--
 4 files changed, 225 insertions(+), 55 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 24ede6033..780e3f345 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -5458,10 +5458,14 @@ bool ApAutoConfigurationTask::handle_wifi_compat_mode_tlv(
         std::string ssid(bss_entry.ssid(), bss_entry.ssid_length());
 
         const char *mode_str =
-            (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX))
+            (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC))
+                ? "11ac (Wi-Fi 5)"
+            : (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX))
                 ? "11ax (Wi-Fi 6)"
             : (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE))
                 ? "11be (Wi-Fi 7)"
+            : (wifi_mode == static_cast<uint8_t>(WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN))
+                ? "11bn (Wi-Fi 8)"
                 : "unknown";
         LOG(INFO) << "  WiFi Compat Mode: SSID='" << ssid
                   << "' wifi_mode=0x" << std::hex << int(wifi_mode) << std::dec
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 463f39ae0..ad412fc35 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -852,6 +852,13 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         params_retrieved &= m_ambiorix_cl.get_param(current_mldID, wifi_ssid_path, "MLDUnit");
         m_ambiorix_cl.get_param(current_ssid_adv, wifi_vap_path, "SSIDAdvertisementEnabled");
         m_ambiorix_cl.get_param(current_disable11be, wifi_vap_path, "Disable11be");
+        int current_disable11ax = -1; // -1 means not yet fetched / unknown
+        m_ambiorix_cl.get_param(current_disable11ax, wifi_vap_path, "Disable11ax");
+        int current_disable11bn = -1; // -1 means not yet fetched / unknown
+        // If Disable11bn is absent from the DM (Wi-Fi 7-only device), treat as "no check":
+        // reset expected_disable11bn to -1 so the skip guard does not force an update
+        // every cycle just because current (-1) never equals expected (0 or 1).
+        bool has_disable11bn = m_ambiorix_cl.get_param(current_disable11bn, wifi_vap_path, "Disable11bn");
 
         // Derive the expected SSIDAdvertisementEnabled from bss_info_conf.hidden_ssid
         // hidden_ssid=ENABLED  → SSIDAdvertisementEnabled should be false (0)
@@ -863,16 +870,53 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         }
 
         // Derive the expected Disable11be from bss_info_conf.wifi_compat_mode:
+        //   WIFI_COMPAT_MODE_11AC → Disable11be=1
         //   WIFI_COMPAT_MODE_11AX → Disable11be=1
         //   WIFI_COMPAT_MODE_11BE → Disable11be=0
+        //   WIFI_COMPAT_MODE_11BN → Disable11be=0
         //   WIFI_COMPAT_MODE_UNSET → -1 (no change expected, skip this check)
         int expected_disable11be = -1;
-        if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX) {
+        if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX ||
+            bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC) {
             expected_disable11be = 1;
-        } else if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
+        } else if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE ||
+                   bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN) {
             expected_disable11be = 0;
         }
 
+        // Derive the expected Disable11ax from bss_info_conf.wifi_compat_mode:
+        //   WIFI_COMPAT_MODE_11AC → Disable11ax=1 (Wi-Fi 5 compat: HE disabled)
+        //   WIFI_COMPAT_MODE_11AX → Disable11ax=0 (clear if previously set for 11AC)
+        //   WIFI_COMPAT_MODE_11BE → Disable11ax=0 (clear if previously set for 11AC)
+        //   WIFI_COMPAT_MODE_11BN → Disable11ax=0 (clear if previously set for 11AC)
+        //   WIFI_COMPAT_MODE_UNSET → -1 (no change expected, skip this check)
+        int expected_disable11ax = -1;
+        if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC) {
+            expected_disable11ax = 1;
+        } else if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX ||
+                   bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE ||
+                   bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN) {
+            expected_disable11ax = 0;
+        }
+
+        // Derive the expected Disable11bn from bss_info_conf.wifi_compat_mode:
+        //   WIFI_COMPAT_MODE_11BN  → Disable11bn=0 (Wi-Fi 8 fully enabled)
+        //   WIFI_COMPAT_MODE_11BE  → Disable11bn=1 (Wi-Fi 8 disabled, Wi-Fi 7 enabled)
+        //   WIFI_COMPAT_MODE_11AX  → Disable11bn=1 (Wi-Fi 8 disabled)
+        //   WIFI_COMPAT_MODE_11AC  → Disable11bn=1 (Wi-Fi 8 disabled)
+        //   WIFI_COMPAT_MODE_UNSET → -1 (no change expected, skip this check)
+        // If Disable11bn is absent from the DM, always use -1 (skip check) regardless of mode.
+        int expected_disable11bn = -1;
+        if (has_disable11bn) {
+            if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN) {
+                expected_disable11bn = 0;
+            } else if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE ||
+                       bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX ||
+                       bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC) {
+                expected_disable11bn = 1;
+            }
+        }
+
         // Compute the intended ModeEnabled string BEFORE the change-detection comparison.
         //
         // WPA3-PCM (MRSNO, R6.1 §17.2.105): security_mode_to_string() collapses the AKM8/AKM24/
@@ -925,7 +969,9 @@ bool ap_wlan_hal_whm::update_vap_credentials(
             current_mode == security_mode &&
                 current_mldID == mld_unit &&
                 current_ssid_adv == expected_ssid_adv &&
-                (expected_disable11be == -1 || current_disable11be == expected_disable11be)) {
+                (expected_disable11be == -1 || current_disable11be == expected_disable11be) &&
+                (expected_disable11ax == -1 || current_disable11ax == expected_disable11ax) &&
+                (expected_disable11bn == -1 || current_disable11bn == expected_disable11bn)) {
             LOG(DEBUG) << "No changes detected for " << ifname
                        << ". Skipping update for VAP: " << wifi_vap_path;
              continue; // Skip updating this VAP
@@ -994,61 +1040,121 @@ bool ap_wlan_hal_whm::update_vap_credentials(
                        << "); will be applied at AP_ENABLED from stashed security_ies";
         }
 
-        // Set Disable11be based on wifi_compat_mode:
-        //   WIFI_COMPAT_MODE_11AX (802.11ax / Wi-Fi 6) -> Disable11be=1
-        //   WIFI_COMPAT_MODE_11BE (802.11be / Wi-Fi 7) -> Disable11be=0
+        // Set Disable11be/Disable11ax/Disable11bn based on wifi_compat_mode:
+        //   WIFI_COMPAT_MODE_11AC (802.11ac / Wi-Fi 5) -> Disable11be=1, Disable11bn=1, Disable11ax=1
+        //   WIFI_COMPAT_MODE_11AX (802.11ax / Wi-Fi 6) -> Disable11be=1, Disable11bn=1, Disable11ax=0
+        //   WIFI_COMPAT_MODE_11BE (802.11be / Wi-Fi 7) -> Disable11be=0, Disable11bn=1, Disable11ax=0
+        //   WIFI_COMPAT_MODE_11BN (802.11bn / Wi-Fi 8) -> Disable11be=0, Disable11bn=0, Disable11ax=0
         //   WIFI_COMPAT_MODE_UNSET                     -> no change
         if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX ||
-            bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
+            bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE ||
+            bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC ||
+            bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN) {
             int new_disable11be =
-                (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX)
+                (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX ||
+                 bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC)
+                    ? 1
+                    : 0;
+            int new_disable11ax =
+                (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC)
                     ? 1
                     : 0;
-            // current_disable11be was already fetched above; reuse it here.
-            // If fetch failed it stays -1, which won't equal 0 or 1, so update proceeds.
-            if (current_disable11be == new_disable11be) {
-                LOG(DEBUG) << "Disable11be=" << new_disable11be << " already set for "
-                           << wifi_vap_path << ", skipping update";
+            // Compute new_disable11bn here (before the skip check) so that a transition
+            // from 11BN→11BE (where Disable11be and Disable11ax both stay 0) still triggers
+            // the write block to set Disable11bn=1.
+            // -1 means "not applicable" (Disable11bn absent from DM).
+            int new_disable11bn = has_disable11bn
+                ? ((bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN)
+                       ? 0
+                       : 1)
+                : -1;
+
+            // current_disable11be and current_disable11ax were already fetched above; reuse here.
+            // If fetch failed they stay -1, which won't equal 0 or 1, so update proceeds.
+            // Also include Disable11bn in the skip check: if it needs to change (e.g. 11BN→11BE),
+            // the write block must execute even when Disable11be/Disable11ax are unchanged.
+            if (current_disable11be == new_disable11be &&
+                current_disable11ax == new_disable11ax &&
+                (new_disable11bn == -1 || current_disable11bn == new_disable11bn)) {
+                LOG(DEBUG) << "Disable11be=" << new_disable11be
+                           << " Disable11ax=" << new_disable11ax
+                           << " Disable11bn=" << new_disable11bn
+                           << " already set for " << wifi_vap_path << ", skipping update";
             } else {
-                LOG(DEBUG) << "wifi_compat_mode=" << (new_disable11be ? "11ax" : "11be")
-                           << ": setting Disable11be=" << new_disable11be << " for " << wifi_vap_path
-                           << " (current=" << current_disable11be << ")";
-
-                // When disabling 11be (Disable11be=1), first set Disable11bn=1 if the
-                // parameter exists in the DM at wifi_vap_path.
-                if (new_disable11be == 1) {
-                    int current_disable11bn = -1;
-                    bool has_disable11bn =
-                        m_ambiorix_cl.get_param(current_disable11bn, wifi_vap_path, "Disable11bn");
-                    if (has_disable11bn) {
-                        LOG(DEBUG) << "Disable11bn present in DM: setting Disable11bn=1 before"
-                                   << " Disable11be=1 for " << wifi_vap_path;
+                const std::string mode_str =
+                    (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC)
+                        ? "11ac"
+                        : (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX)
+                            ? "11ax"
+                            : (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE)
+                                ? "11be"
+                                : "11bn";
+                LOG(DEBUG) << "wifi_compat_mode=" << mode_str
+                           << ": setting Disable11be=" << new_disable11be
+                           << " Disable11ax=" << new_disable11ax
+                           << " for " << wifi_vap_path
+                           << " (current_disable11be=" << current_disable11be
+                           << " current_disable11ax=" << current_disable11ax << ")";
+
+                // Handle Disable11bn based on mode (reuse has_disable11bn / current_disable11bn
+                // and new_disable11bn already computed above — no second get_param needed):
+                //   11AC/11AX/11BE: set Disable11bn=1 (if present in DM)
+                //   11BN:           set Disable11bn=0 (clear, if present in DM)
+                if (has_disable11bn) {
+                    if (current_disable11bn != new_disable11bn) {
+                        LOG(DEBUG) << "Disable11bn present in DM: setting Disable11bn="
+                                   << new_disable11bn << " for " << wifi_vap_path;
                         AmbiorixVariant disable11bn_obj(AMXC_VAR_ID_HTABLE);
-                        disable11bn_obj.add_child("Disable11bn", 1);
+                        disable11bn_obj.add_child("Disable11bn", new_disable11bn);
                         if (!m_ambiorix_cl.update_object(wifi_vap_path, disable11bn_obj)) {
-                            LOG(WARNING) << "Failed to set Disable11bn=1 for " << wifi_vap_path;
+                            LOG(WARNING) << "Failed to set Disable11bn=" << new_disable11bn
+                                         << " for " << wifi_vap_path;
                         }
-                    } else {
-                        LOG(DEBUG) << "Disable11bn not present in DM for " << wifi_vap_path
-                                   << ", skipping";
+                    }
+                } else {
+                    LOG(DEBUG) << "Disable11bn not present in DM for " << wifi_vap_path
+                               << ", skipping";
+                }
+
+                // Set Disable11be if changed.
+                if (current_disable11be != new_disable11be) {
+                    AmbiorixVariant disable11be_obj(AMXC_VAR_ID_HTABLE);
+                    disable11be_obj.add_child("Disable11be", new_disable11be);
+                    if (!m_ambiorix_cl.update_object(wifi_vap_path, disable11be_obj)) {
+                        LOG(WARNING) << "Failed to set Disable11be=" << new_disable11be << " for "
+                                     << wifi_vap_path;
                     }
                 }
 
-                AmbiorixVariant disable11be_obj(AMXC_VAR_ID_HTABLE);
-                disable11be_obj.add_child("Disable11be", new_disable11be);
-                if (!m_ambiorix_cl.update_object(wifi_vap_path, disable11be_obj)) {
-                    LOG(WARNING) << "Failed to set Disable11be=" << new_disable11be << " for "
-                                 << wifi_vap_path;
+                // Set or clear Disable11ax based on wifi_compat_mode.
+                // Disable11ax=1 is only set for WIFI_COMPAT_MODE_11AC (Wi-Fi 5 compat mode).
+                // For all other modes (11AX, 11BE, 11BN), Disable11ax is cleared (set to 0).
+                // Skip clearing if the parameter was never fetched (current == -1 and new == 0).
+                if (current_disable11ax != new_disable11ax) {
+                    if (new_disable11ax == 0 && current_disable11ax == -1) {
+                        LOG(DEBUG) << "Disable11ax not present in DM for " << wifi_vap_path
+                                   << " and new value is 0, skipping";
+                    } else {
+                        LOG(DEBUG) << "Disable11ax: setting Disable11ax=" << new_disable11ax
+                                   << " for " << wifi_vap_path
+                                   << " (current=" << current_disable11ax << ")";
+                        AmbiorixVariant disable11ax_obj(AMXC_VAR_ID_HTABLE);
+                        disable11ax_obj.add_child("Disable11ax", new_disable11ax);
+                        if (!m_ambiorix_cl.update_object(wifi_vap_path, disable11ax_obj)) {
+                            LOG(WARNING) << "Failed to set Disable11ax=" << new_disable11ax
+                                         << " for " << wifi_vap_path;
+                        }
+                    }
                 }
 
-                // For 11be (Disable11be=0): re-apply MLDUnit after the mode transition.
+                // For 11be/11bn (Disable11be=0): re-apply MLDUnit after the mode transition.
                 // pWHM rejects MLDUnit assignment while the VAP is still in 11ax mode
                 // (Disable11be=1). The initial MLDUnit write (above) may have been silently
                 // ignored, leaving the VAP as a standalone SLO instead of joining the
                 // existing 11be MLD. Re-writing MLDUnit now that Disable11be=0 is committed
                 // ensures the 2G VAP is correctly added to the multi-link group.
                 if (new_disable11be == 0 && mld_unit != DISABLED_MLDUNIT) {
-                    LOG(INFO) << "11be mode set: re-applying MLDUnit=" << int(mld_unit)
+                    LOG(INFO) << "11be/11bn mode set: re-applying MLDUnit=" << int(mld_unit)
                               << " for SSID " << bss_info_conf.ssid
                               << " path=" << wifi_ssid_path;
                     AmbiorixVariant mld_unit_obj(AMXC_VAR_ID_HTABLE);
diff --git a/controller/whm/wifi_manager.cpp b/controller/whm/wifi_manager.cpp
index 473e45116..c5e28f5a7 100644
--- a/controller/whm/wifi_manager.cpp
+++ b/controller/whm/wifi_manager.cpp
@@ -171,9 +171,10 @@ void WifiManager::subscribe_to_bss_info_config_change()
 
     // subscribe for VAPs enabling to re-trigger autoConf when new BSS is enabled
     // and potentially resume previously timeouted agent configuration.
-    // Also subscribe to Disable11be changes so that switching between Wi-Fi 6 / Wi-Fi 7
-    // compatibility modes triggers an autoconfig renew to propagate the new compat mode
-    // to all agents via the tlvBeerocksWifiCompatMode vendor extension in WSC M2.
+    // Also subscribe to Disable11be/Disable11bn/Disable11ax changes so that switching
+    // between Wi-Fi 5 / Wi-Fi 6 / Wi-Fi 7 / Wi-Fi 8 compatibility modes triggers an
+    // autoconfig renew to propagate the new compat mode to all agents via the
+    // tlvBeerocksWifiCompatMode vendor extension in WSC M2.
     filter = "(path matches '" + wbapi_utils::search_path_ap() +
              "[0-9]+.$')"
              " && (notification == '" +
@@ -181,7 +182,9 @@ void WifiManager::subscribe_to_bss_info_config_change()
              "')"
              " && (contains('parameters.Enable')"
              " || contains('parameters.SSIDAdvertisementEnabled')"
-             " || contains('parameters.Disable11be'))";
+             " || contains('parameters.Disable11be')"
+             " || contains('parameters.Disable11bn')"
+             " || contains('parameters.Disable11ax'))";
 
     if (!m_ambiorix_cl->subscribe_to_object_event(wbapi_utils::search_path_ap(), event_handler,
                                                   filter)) {
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
index c83b7be32..bdd090f86 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
@@ -359,18 +359,75 @@ bool bpl_cfg_get_wireless_settings(std::list<son::wireless_utils::sBssInfoConf>
                    << " ssid_advertisement=" << ssid_adv_enabled
                    << " for iface=" << iface;
 
-        // Read Disable11be and map to wifi_compat_mode for the tlvBeerocksWifiCompatMode VS TLV.
-        // Disable11be=true  → WIFI_COMPAT_MODE_11AX (Wi-Fi 6 / 802.11ax, disable_11be=1)
-        // Disable11be=false → WIFI_COMPAT_MODE_11BE (Wi-Fi 7 / 802.11be, disable_11be=0)
-        // Disable11be absent → WIFI_COMPAT_MODE_UNSET (TLV entry omitted for this BSS)
-        bool disable11be = false;
-        if (ap.read_child(disable11be, "Disable11be")) {
-            configuration.wifi_compat_mode = disable11be
-                ? WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX
-                : WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE;
-            LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11be=" << disable11be
-                       << " -> wifi_compat_mode=" << static_cast<int>(configuration.wifi_compat_mode)
-                       << " for iface=" << iface;
+        // Read Disable11be, Disable11bn, and Disable11ax to determine wifi_compat_mode.
+        // Mirrors the UCI backend's three-step logic:
+        //
+        //   Step 1 — Disable11bn (Wi-Fi 8 specific):
+        //     Disable11bn=false → 11BN (Wi-Fi 8 fully enabled)
+        //     Disable11bn=true  → 11BE (Wi-Fi 8 disabled, Wi-Fi 7 enabled)
+        //     absent            → UNSET (no Wi-Fi 8 option present)
+        //
+        //   Step 2 — Disable11be (overrides to 11AX if set):
+        //     Disable11be=true  → 11AX (overwrite whatever Step 1 produced)
+        //     Disable11be=false and Step 1 was UNSET → 11BE (Wi-Fi 7-only device)
+        //     absent/false      → keep Step 1 result
+        //
+        //   Step 3 — Disable11ax (overrides to 11AC if set):
+        //     Disable11ax=true AND current mode is 11AX → 11AC (Wi-Fi 5 only)
+        {
+            // Step 1: check Disable11bn
+            bool disable11bn = false;
+            if (ap.read_child(disable11bn, "Disable11bn")) {
+                if (!disable11bn) {
+                    configuration.wifi_compat_mode =
+                        WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN;
+                    LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11bn=false"
+                               << " -> wifi_compat_mode=11BN for iface=" << iface;
+                } else {
+                    configuration.wifi_compat_mode =
+                        WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE;
+                    LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11bn=true"
+                               << " -> wifi_compat_mode=11BE for iface=" << iface;
+                }
+            } else {
+                configuration.wifi_compat_mode = WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_UNSET;
+                LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11bn absent"
+                           << " -> wifi_compat_mode=UNSET (checking Disable11be)"
+                           << " for iface=" << iface;
+            }
+
+            // Step 2: check Disable11be
+            bool disable11be = false;
+            if (ap.read_child(disable11be, "Disable11be")) {
+                if (disable11be) {
+                    configuration.wifi_compat_mode =
+                        WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX;
+                    LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11be=true"
+                               << " -> wifi_compat_mode=11AX (overwrite) for iface=" << iface;
+                } else if (configuration.wifi_compat_mode ==
+                           WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_UNSET) {
+                    // Disable11be=false and no Disable11bn: Wi-Fi 7-only device.
+                    configuration.wifi_compat_mode =
+                        WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE;
+                    LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11be=false"
+                               << " (no Disable11bn) -> wifi_compat_mode=11BE for iface="
+                               << iface;
+                }
+            }
+
+            // Step 3: check Disable11ax
+            bool disable11ax = false;
+            if (ap.read_child(disable11ax, "Disable11ax")) {
+                if (disable11ax &&
+                    configuration.wifi_compat_mode ==
+                        WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX) {
+                    configuration.wifi_compat_mode =
+                        WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC;
+                    LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11ax=true"
+                               << " (with Disable11be=true) -> wifi_compat_mode=11AC"
+                               << " (Wi-Fi 5 only) for iface=" << iface;
+                }
+            }
         }
 
         bool ap_enable = false;
