+bool cfg_get_1905_security_enabled(){
+    char buf[8] = {0};
+    if (cfg_get_prplmesh_param("Enable1905Security", buf, sizeof(buf)) < 0) {
+        return true; // default: enabled
+    }
+    // Disabled only if explicitly set to "0"
+    return std::string(buf) != "0";
+}
