+std::string cfg_get_onboarding_type()
+{
+    char buf[32] = {0};
+    if (cfg_get_prplmesh_param("onboardingtype", buf, sizeof(buf)) < 0) {
+        return "WSC"; // default: standard WSC onboarding
+    }
+    std::string val(buf);
+    // Trim whitespace
+    val.erase(val.find_last_not_of(" \t\n\r") + 1);
+    if (val == "DPP") {
+        return "DPP";
+    }
+    return "WSC";
+}
