+DppConfiguratorTask::DppConfiguratorTask(db &database, ieee1905_1::CmduMessageTx &cmdu_tx,
+                                         std::shared_ptr<beerocks::btl::BrokerClient> broker_client,
+                                         std::shared_ptr<beerocks::EventLoop> event_loop)
+    : task("DppConfiguratorTask"), m_database(database), m_cmdu_tx(cmdu_tx),
+      m_keystore("/etc/prplmesh/dpp"), m_broker_client(broker_client), m_event_loop(event_loop)
+{
+    m_gtk.fill(0);
+
+    // Initialize key store
+    if (!m_keystore.init()) {
+        LOG(ERROR) << "DppConfiguratorTask: failed to initialize key store";
+    } else {
+        LOG(INFO) << "DppConfiguratorTask: key store initialized";
+        LOG(INFO) << "DppConfiguratorTask: pkhash=" << m_keystore.bootstrapping_hash_hex();
+
+        // Load all enrollee URIs into the in-memory cache and set up file watcher.
+        setup_uri_file_watcher();
+        load_dpp_uris();
+
+        // Send CCE indication to all agents on startup
+        send_dpp_cce_indication(true);
+    }
+}
+
+DppConfiguratorTask::~DppConfiguratorTask()
+{
+    if (m_inotify_fd >= 0 && m_event_loop)
+        m_event_loop->remove_handlers(m_inotify_fd);
+    if (m_inotify_wd >= 0 && m_inotify_fd >= 0)
+        inotify_rm_watch(m_inotify_fd, m_inotify_wd);
+    if (m_inotify_fd >= 0)
+        ::close(m_inotify_fd);
+}
+
+// ============================================================================
+// task::work() — periodic cleanup only; URI file changes are handled
+// event-driven via the inotify fd registered with the event loop.
+// ============================================================================
+
+void DppConfiguratorTask::work()
+{
+    cleanup_timed_out_sessions();
+    set_task_timeout(5000); // run every 5 seconds
+}
