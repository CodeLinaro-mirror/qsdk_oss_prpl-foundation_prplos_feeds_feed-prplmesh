+    case ieee1905_1::eMessageType::IEEE1905_DECRYPTION_FAILURE_MESSAGE:
+        LOG(DEBUG) << "DPP: dispatching IEEE1905_DECRYPTION_FAILURE_MESSAGE to "
+                      "handle_1905_decryption_failure";
+        return handle_1905_decryption_failure(src_mac, cmdu_rx);
+    default:
+        LOG(TRACE) << "DPP: message type 0x" << std::hex << int(cmdu_rx.getMessageType())
+                   << " not handled by DppConfiguratorTask";
+        return false;
+    }
+}
+
+// ============================================================================
+// handle_chirp_notification — Wi-Fi DPP path trigger
+// ============================================================================
+
+bool DppConfiguratorTask::handle_chirp_notification(const sMacAddr &src_mac,
+                                                      ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto chirp_tlv = cmdu_rx.getClass<wfa_map::tlvDppChirpValue>();
+    if (!chirp_tlv) {
+        LOG(ERROR) << "DPP: CHIRP_NOTIFICATION missing tlvDppChirpValue";
+        return false;
+    }
+
+    if (!chirp_tlv->flags().hash_validity) {
+        LOG(DEBUG) << "DPP: Chirp with hash_validity=0 — ignoring";
+        return true;
+    }
+
+    // Extract hash (32 bytes)
+    std::array<uint8_t, 32> hash;
+    if (chirp_tlv->hash_length() < 32) {
+        LOG(WARNING) << "DPP: Chirp hash too short (" << (int)chirp_tlv->hash_length() << ")";
+        return true;
+    }
+    memcpy(hash.data(), chirp_tlv->hash(), 32);
+
+    LOG(DEBUG) << "DPP: CHIRP from proxy=" << src_mac
+               << " hash=" << DppCryptoHelper::to_hex(hash.data(), 8) << "...";
+
+    // Check if already in session
+    if (get_session_by_hash(hash)) {
+        LOG(DEBUG) << "DPP: session already active for this hash — ignoring duplicate chirp";
+        return true;
+    }
+
+    // Look up enrollee bootstrap key derived from cached DPP URI
+    std::vector<uint8_t> bs_key_der;
+    if (!find_enrollee_by_hash(hash, bs_key_der)) {
+        LOG(DEBUG) << "DPP: no matching enrollee for chirp hash — ignoring";
+        return true;
+    }
+
+    // Get Enrollee MAC from TLV
+    sMacAddr enrollee_mac = {};
+    if (chirp_tlv->flags().enrollee_mac_address_present) {
+        enrollee_mac = *chirp_tlv->dest_sta_mac();
+    }
+
+    LOG(INFO) << "DPP: starting Wi-Fi onboarding for enrollee=" << enrollee_mac
+              << " proxy=" << src_mac;
+
+    // Create session (Wi-Fi path)
+    auto *session = create_session(enrollee_mac, src_mac, hash, bs_key_der, false);
+    if (!session) return false;
+
+    session->state = eDppSessionState::PRESENCE_RECEIVED;
+    return send_auth_request(*session);
+}
+
+// ============================================================================
+// handle_wired_dpp_chirp — Wired DPP path trigger
+// ============================================================================
+
+bool DppConfiguratorTask::handle_wired_dpp_chirp(const sMacAddr &agent_mac,
+                                                   wfa_map::tlvDppChirpValue *chirp_tlv)
+{
+    if (!chirp_tlv) return true;
+
+    std::array<uint8_t, 32> hash = {};
+    if (chirp_tlv->hash_length() < 32) return true;
+    memcpy(hash.data(), chirp_tlv->hash(), 32);
+
+    LOG(DEBUG) << "DPP: wired chirp from " << agent_mac
+               << " hash=" << DppCryptoHelper::to_hex(hash.data(), 8) << "...";
+
+    auto *existing = get_session_by_hash(hash);
+    if (existing) {
+        if (existing->state == eDppSessionState::AUTH_REQUEST_SENT) {
+            // Ignore duplicate chirps that arrive within 2s of sending Auth Request.
+            // The extender sends one Search per radio band simultaneously — both carry
+            // the same chirp hash. Resetting on the duplicate discards the live session
+            // and sends a new Auth Request with a different pI, causing k2 mismatch.
+            auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - existing->last_activity).count();
+            if (elapsed < 2000) {
+                LOG(DEBUG) << "DPP: wired chirp duplicate (same hash, "
+                           << elapsed << "ms after Auth Request) — ignoring";
+                return true;
+            }
+            LOG(INFO) << "DPP: wired chirp received while stuck in AUTH_REQUEST_SENT for "
+                      << agent_mac << " (" << elapsed << "ms) — resetting and retrying"
+                      << " (if extender bootstrap key changed, a new URI notification is needed)";
+            cleanup_session(hash);
+        } else {
+            LOG(DEBUG) << "DPP: wired session already active (state="
+                       << static_cast<int>(existing->state) << ") — ignoring chirp";
+            return true;
+        }
+    }
+
+    std::vector<uint8_t> bs_key_der;
+    if (!find_enrollee_by_hash(hash, bs_key_der)) {
+        LOG(DEBUG) << "DPP: no matching enrollee for wired chirp hash";
+        return true;
+    }
+
+    LOG(INFO) << "DPP: starting WIRED onboarding for " << agent_mac;
+
+    // Create session (wired path — no proxy, direct to agent)
+    auto *session = create_session(agent_mac, agent_mac, hash, bs_key_der, true);
+    if (!session) return false;
+
+    LOG(DEBUG) << "DPP: waiting 500ms before sending Auth Request to " << agent_mac;
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+
+    session->state = eDppSessionState::PRESENCE_RECEIVED;
+    return send_auth_request(*session);
+}
+
+// ============================================================================
+// handle_proxied_encap_dpp — Wi-Fi DPP frames from Enrollee via Proxy Agent
+// ============================================================================
+
+bool DppConfiguratorTask::handle_proxied_encap_dpp(const sMacAddr &src_mac,
+                                                     ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto encap_tlv = cmdu_rx.getClass<wfa_map::tlv1905EncapDpp>();
+    if (!encap_tlv) {
+        LOG(ERROR) << "DPP: PROXIED_ENCAP_DPP missing tlv1905EncapDpp";
+        return false;
+    }
+
+    const uint8_t *frame = encap_tlv->encapsulated_frame();
+    size_t frame_len     = encap_tlv->encapsulated_frame_length();
+
+    if (!frame || frame_len < 7) {
+        LOG(ERROR) << "DPP: PROXIED_ENCAP_DPP frame too short";
+        return false;
+    }
+
+    // Get Enrollee MAC from TLV
+    sMacAddr enrollee_mac = {};
+    if (encap_tlv->frame_flags().enrollee_mac_address_present) {
+        enrollee_mac = *encap_tlv->dest_sta_mac();
+    }
+
+    bool is_gas = (encap_tlv->frame_flags().dpp_frame_indicator == 1);
+
+    // Drop downlink-only frames that must never appear in an uplink
+    // PROXIED_ENCAP_DPP_MESSAGE from an Agent.
+    //
+    // Auth Request (DPP subtype 0x00), Auth Confirm (DPP subtype 0x02), and
+    // GAS Response (GAS Initial Response 0x0B / GAS Comeback Response 0x0D)
+    // are all sent FROM the Controller TO the Enrollee.  If an Agent echoes
+    // one of these frames back uplink, discard it here before any session lookup.
+    if (!is_gas && frame_len > 6) {
+        // Public Action frame: frame[0]=0x09, frame[6]=DPP subtype
+        uint8_t subtype = frame[6];
+        if (subtype == DPP_PA_AUTHENTICATION_REQUEST ||
+            subtype == DPP_PA_AUTHENTICATION_CONFIRM) {
+            LOG(WARNING)
+                << "DPP: handle_proxied_encap_dpp: dropping uplink "
+                << (subtype == DPP_PA_AUTHENTICATION_REQUEST ? "Auth Request" : "Auth Confirm")
+                << " (subtype=0x" << std::hex << static_cast<int>(subtype) << std::dec
+                << ") — downlink-only frame from " << src_mac
+                << " (mid=0x" << std::hex << cmdu_rx.getMessageId() << std::dec << ")";
+            return true;
+        }
+    } else if (is_gas && frame_len > 2) {
+        // GAS frame: frame[0]=0x0A (type byte), frame[1]=0x04 (Category), frame[2]=Action
+        uint8_t gas_action = frame[2];
+        if (gas_action == GAS_INITIAL_RESPONSE || gas_action == GAS_COMEBACK_RESPONSE) {
+            LOG(WARNING)
+                << "DPP: handle_proxied_encap_dpp: dropping uplink GAS Response"
+                << " (action=0x" << std::hex << static_cast<int>(gas_action) << std::dec
+                << ") — downlink-only frame from " << src_mac
+                << " (mid=0x" << std::hex << cmdu_rx.getMessageId() << std::dec << ")";
+            return true;
+        }
+    }
+
+    if (is_gas) {
+        // GAS frame = DPP Configuration Request
+        auto *session = get_session_by_agent(src_mac);
+        if (!session) {
+            // Try by enrollee MAC
+            if (enrollee_mac != sMacAddr{}) {
+                for (auto &session_pair : m_sessions) {
+                    auto &s = session_pair.second;
+                    if (s->enrollee_mac == enrollee_mac) { session = s.get(); break; }
+                }
+            }
+        }
+        if (!session) {
+            LOG(WARNING) << "DPP: GAS Config Request with no active session from " << src_mac;
+            return false;
+        }
+        // State check: Config Request (GAS) is only valid in AUTH_COMPLETE state
+        if (session->state != eDppSessionState::AUTH_COMPLETE) {
+            LOG(WARNING) << "DPP: GAS Config Request received in wrong state ("
+                         << static_cast<int>(session->state)
+                         << ") — expected AUTH_COMPLETE; ignoring (state already passed)";
+            return true;
+        }
+        return handle_config_request(*session, frame, frame_len);
+    }
+
+    // Public Action frame — check DPP frame type
+    uint8_t frame_type = get_dpp_frame_type(frame, frame_len);
+
+    // Find session by enrollee MAC or proxy MAC
+    sDppSession *session = nullptr;
+    if (enrollee_mac != sMacAddr{}) {
+        for (auto &session_pair : m_sessions) {
+            auto &s = session_pair.second;
+            if (s->enrollee_mac == enrollee_mac) { session = s.get(); break; }
+        }
+    }
+    if (!session) session = get_session_by_agent(src_mac);
+
+    switch (frame_type) {
+    case DPP_PA_AUTHENTICATION_RESPONSE:
+        if (!session) {
+            LOG(WARNING) << "DPP: Auth Response with no active session";
+            return false;
+        }
+        // State check: Auth Response is only valid in AUTH_REQUEST_SENT state
+        if (session->state != eDppSessionState::AUTH_REQUEST_SENT) {
+            LOG(WARNING) << "DPP: Auth Response received in wrong state ("
+                         << static_cast<int>(session->state)
+                         << ") — expected AUTH_REQUEST_SENT; ignoring (state already passed)";
+            return true;
+        }
+        return handle_auth_response(*session, frame, frame_len);
+
+    case DPP_PA_CONFIGURATION_RESULT:
+        if (!session) {
+            LOG(WARNING) << "DPP: Config Result with no active session";
+            return false;
+        }
+        // State check: Config Result is only valid in CONFIG_SENT state
+        if (session->state != eDppSessionState::CONFIG_SENT) {
+            LOG(WARNING) << "DPP: Config Result received in wrong state ("
+                         << static_cast<int>(session->state)
+                         << ") — expected CONFIG_SENT; ignoring (state already passed)";
+            return true;
+        }
+        return handle_config_result(*session, frame, frame_len);
+
+    case DPP_PA_PRESENCE_ANNOUNCEMENT:
+        // Presence Announcement from Enrollee - initial onboarding
+        LOG(INFO) << "DPP: Presence Announcement (0x0D) from proxy=" << src_mac;
+        // The Presence Announcement should have been converted to a CHIRP_NOTIFICATION
+        // by the Agent. If we receive it here as a PROXIED frame, log and ignore.
+        LOG(DEBUG) << "DPP: Presence Announcement received as PROXIED frame - "
+                   << "should have been converted to CHIRP_NOTIFICATION by Agent";
+        return true;
+
+    case DPP_PA_RECONFIG_ANNOUNCEMENT:
+        // Reconfig Announcement from previously configured Enrollee
+        LOG(INFO) << "DPP: Reconfig Announcement (0x0E) from proxy=" << src_mac;
+        LOG(INFO) << "DPP: Device requesting reconfiguration (was previously onboarded)";
+        // TODO: Implement DPP Reconfig Protocol (Easy Connect v2.0)
+        // For now, log and ignore - full reconfig protocol requires:
+        // 1. Verify device was previously configured (check connector)
+        // 2. Use DPP Reconfig Auth instead of regular DPP Auth
+        // 3. Send new configuration without full authentication
+        LOG(WARNING) << "DPP: Reconfig Protocol not yet implemented - ignoring";
+        return true;
+
+    default:
+        LOG(DEBUG) << "DPP: unhandled PROXIED frame type 0x" << std::hex << (int)frame_type;
+        return true;
+    }
+}
+
+// ============================================================================
+// handle_direct_encap_dpp — Wired DPP + 1905 Network Introduction
+// ============================================================================
+
+bool DppConfiguratorTask::handle_direct_encap_dpp(const sMacAddr &src_mac,
+                                                    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto dpp_msg_tlv = cmdu_rx.getClass<wfa_map::tlvDppMessage>();
+    if (!dpp_msg_tlv) {
+        LOG(ERROR) << "DPP: DIRECT_ENCAP_DPP missing tlvDppMessage";
+        return false;
+    }
+
+    const uint8_t *frame = dpp_msg_tlv->dpp_frame();
+    size_t frame_len     = dpp_msg_tlv->dpp_frame_length();
+
+    if (!frame || frame_len < 7) {
+        LOG(ERROR) << "DPP: DIRECT_ENCAP_DPP frame too short";
+        return false;
+    }
+
+    LOG(DEBUG) << "DPP: handle_direct_encap_dpp frame (" << frame_len << " bytes) from "
+               << src_mac << ": " << DppCryptoHelper::to_hex(frame, frame_len);
+
+    uint8_t frame_type = get_dpp_frame_type(frame, frame_len);
+    auto *session      = get_session_by_agent(src_mac);
+
+    switch (frame_type) {
+    case DPP_PA_AUTHENTICATION_RESPONSE:
+        if (!session) {
+            LOG(WARNING) << "DPP: wired Auth Response with no active session from " << src_mac;
+            return false;
+        }
+        return handle_auth_response(*session, frame, frame_len);
+
+    case DPP_PA_CONFIGURATION_RESULT:
+        if (!session) return false;
+        return handle_config_result(*session, frame, frame_len);
+
+    case DPP_PA_PEER_DISCOVERY_REQUEST:
+        // 1905 Network Introduction request from Agent
+        return handle_peer_discovery_request(src_mac, frame, frame_len);
+
+    case DPP_PA_PEER_DISCOVERY_RESPONSE:
+        // 1905 Network Introduction response
+        return handle_peer_discovery_response(src_mac, frame, frame_len);
+
+    default:
+        // Check for GAS frame (Config Request): Action byte 0x0A or 0x0C
+        if (is_gas_frame(frame, frame_len)) {
+            LOG(DEBUG) << "DPP: GAS frame (Action=0x" << std::hex << (int)frame[0]
+                       << ") from " << src_mac << " — routing to handle_config_request";
+            if (!session) {
+                LOG(ERROR) << "DPP: GAS Config Request with no active session from " << src_mac;
+                return false;
+            }
+            return handle_config_request(*session, frame, frame_len);
+        }
+        LOG(DEBUG) << "DPP: unhandled DIRECT frame type 0x" << std::hex << (int)frame_type
+                   << " from " << src_mac;
+        return true;
+    }
+}
+
+// ============================================================================
+// handle_dpp_bootstrapping_uri_notification
+// ============================================================================
+
+bool DppConfiguratorTask::handle_dpp_bootstrapping_uri_notification(
+    const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // FIX: use getClass<> with the correct TLV type, not getClassByMessageType<>
+    auto uri_tlv = cmdu_rx.getClass<wfa_map::tlvDppBootstrappingUriNotification>();
+    if (!uri_tlv) {
+        LOG(ERROR) << "DPP: DPP_BOOTSTRAPPING_URI_NOTIFICATION missing "
+                      "tlvDppBootstrappingUriNotification from " << src_mac;
+        return false;
+    }
+
+    // Build DPP URI string from TLV fields
+    // The TLV contains: RUID(6) + BSSID(6) + bSTA_Address(6) + DPP_URI(variable)
+    size_t uri_len = uri_tlv->dpp_uri_length();
+    if (uri_len == 0) {
+        LOG(WARNING) << "DPP: received URI notification with empty DPP URI from " << src_mac;
+        return false;
+    }
+    std::string dpp_uri(reinterpret_cast<const char *>(uri_tlv->dpp_uri()), uri_len);
+
+    LOG(INFO) << "DPP: received DPP URI notification from " << src_mac
+              << " ruid=" << uri_tlv->ruid()
+              << " bssid=" << uri_tlv->bssid()
+              << " bh_sta=" << uri_tlv->backhaul_sta_address();
+
+    // Persist URI under /etc/prplmesh/dpp_uri for later retrieval
+    if (!m_keystore.save_dpp_uri(dpp_uri)) {
+        LOG(ERROR) << "DPP: failed to persist DPP URI to /etc/prplmesh/dpp_uri";
+        return false;
+    }
+
+    // Update controller bootstrap metadata if available
+    m_database.dpp_bootstrapping_info.info = dpp_uri;
+
+    // Re-advertise CCE availability
+    send_dpp_cce_indication(true);
+    return true;
+}
+
+// ============================================================================
+// handle_bss_configuration_result
+// ============================================================================
+
+bool DppConfiguratorTask::handle_bss_configuration_result(const sMacAddr &src_mac,
+                                                            ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    LOG(INFO) << "DPP: BSS_CONFIGURATION_RESULT from " << src_mac;
+
+    sDppSession *session = get_session_by_agent(src_mac);
+    if (session) {
+        session->state = eDppSessionState::BSS_CONFIG_SENT;
+    }
+
+    // Per EasyMesh Figure 17: controller sends Agent List after receiving BSS Config Result.
+    // The extender receives Agent List and responds with BSS Config Request.
+    LOG(INFO) << "DPP: sending Agent List after BSS Config Result from " << src_mac;
+    if (!send_agent_list_message(src_mac)) {
+        return false;
+    }
+
+    // DPP extenders never send WSC M1, so the agent_monitoring_task deferred queries
+    // (AP_CAPABILITY_QUERY, Topology Query, Channel Preference Query) are never triggered.
+    // Send them now so the controller learns the extender's radio capabilities and the
+    // topology map is populated.
+    LOG(INFO) << "DPP: sending initial capability/topology queries to extender " << src_mac;
+
+    // AP Capability Query — triggers AP Capability Report from extender
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::AP_CAPABILITY_QUERY_MESSAGE)) {
+        LOG(ERROR) << "DPP: failed to create AP_CAPABILITY_QUERY_MESSAGE";
+    } else {
+        son_actions::send_cmdu_to_agent(src_mac, m_cmdu_tx, m_database);
+    }
+
+    // Topology Query — triggers Topology Response (populates radio/BSS map)
+    son_actions::send_topology_query_msg(src_mac, m_cmdu_tx, m_database);
+
+    // Channel Preference Query — populates channel info
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::CHANNEL_PREFERENCE_QUERY_MESSAGE)) {
+        LOG(ERROR) << "DPP: failed to create CHANNEL_PREFERENCE_QUERY_MESSAGE";
+    } else {
+        son_actions::send_cmdu_to_agent(src_mac, m_cmdu_tx, m_database);
+    }
+
+    return true;
+}
+
+// ============================================================================
+// handle_1905_encap_eapol — 4-way handshake
+// ============================================================================
+
+bool DppConfiguratorTask::handle_1905_encap_eapol(const sMacAddr &src_mac,
+                                                    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto eapol_tlv = cmdu_rx.getClass<wfa_map::tlv1905EncapEapol>();
+    if (!eapol_tlv) return false;
+
+    const uint8_t *eapol_frame = eapol_tlv->payload();
+    size_t eapol_len           = eapol_tlv->payload_length();
+
+    uint8_t msg_num = get_eapol_key_msg_num(eapol_frame, eapol_len);
+    LOG(DEBUG) << "DPP: EAPOL M" << (int)msg_num << " from " << src_mac;
+
+    auto *session = get_session_by_agent(src_mac);
+
+    // M1 from the agent means the agent is acting as Authenticator and wants to initiate
+    // a new 4-way handshake (e.g. after reconnect). The controller responds as Supplicant.
+    // This happens when:
+    //   a) The extender reboots and starts a fresh 4-way using its stored PMK, OR
+    //   b) The agent-to-agent path where the peer is Authenticator.
+    if (msg_num == 1) {
+        // If no session exists, create one using the stored PMK from a previous session.
+        // The agent must have been previously onboarded (PMK was established then).
+        if (!session) {
+            // Try to find a stored PMK for this agent in the database
+            // For now, create a minimal session so the M1/M2/M3/M4 can proceed
+            std::array<uint8_t, 32> dummy_hash{};
+            session = create_session(src_mac, src_mac, dummy_hash, {}, false);
+            if (!session) {
+                LOG(ERROR) << "DPP: could not create session for incoming M1 from " << src_mac;
+                return false;
+            }
+            // Restore PMK from database if available
+            auto agent = m_database.m_agents.get(src_mac);
+            if (agent && agent->pmk_1905_valid) {
+                session->pmk_1905 = agent->pmk_1905;
+                session->pmk_1905_valid = true;
+                LOG(INFO) << "DPP: M1 from reconnecting agent " << src_mac
+                          << " — restored PMK from database";
+            } else {
+                LOG(WARNING) << "DPP: M1 from " << src_mac
+                             << " but no stored PMK — 4-way will fail";
+            }
+        }
+        // Handle M1: extract ANonce, generate SNonce, derive PTK, send M2
+        return handle_eapol_m1_as_supplicant(src_mac, *session, eapol_frame, eapol_len);
+    }
+
+    if (!session) {
+        LOG(WARNING) << "DPP: EAPOL M" << (int)msg_num << " with no active session from " << src_mac;
+        return false;
+    }
+
+    if (msg_num == 2) {
+        return handle_eapol_m2(src_mac, *session, eapol_frame, eapol_len);
+    } else if (msg_num == 3) {
+        // M3 received when controller is acting as Supplicant (extender is Authenticator)
+        return handle_eapol_m3_as_supplicant(src_mac, *session, eapol_frame, eapol_len);
+    } else if (msg_num == 4) {
+        return handle_eapol_m4(src_mac, *session, eapol_frame, eapol_len);
+    }
+
+    LOG(WARNING) << "DPP: unexpected EAPOL message number " << (int)msg_num;
+    return false;
+}
+
+// ============================================================================
+// handle_1905_decryption_failure
+// ============================================================================
+
+bool DppConfiguratorTask::handle_1905_decryption_failure(const sMacAddr &src_mac,
+                                                           ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    LOG(WARNING) << "DPP: 1905 Decryption Failure from " << src_mac;
+    // TODO: trigger rekey if threshold exceeded
+    return true;
+}
+
+// Per EasyMesh spec Table 6 and Easy Connect spec §4.2:
+//   000FAC02 = WPA2-PSK (AKM suite 2)
+//   000FAC08 = SAE      (AKM suite 8)
+//   000FAC24 = SAE-EXT-KEY (AKM suite 24, WPA3-PCM)
+//   506F9A02 = DPP      (Wi-Fi Alliance OUI, type 2)
+static std::string wsc_auth_to_fh_akm(WSC::eWscAuth auth)
+{
+    switch (auth) {
+    case WSC::eWscAuth::WSC_AUTH_WPA2PSK:
+        return "000FAC02";
+    case WSC::eWscAuth::WSC_AUTH_SAE:
+        return "000FAC08";
+    case WSC::eWscAuth::WSC_AUTH_SAE_AKM24:
+        return "000FAC24";
+    case WSC::eWscAuth::WSC_AUTH_RSN:
+        return "000FAC08+000FAC24";
+    default:
+        // Handle combined SAE+PSK (sae-mixed) which is a bitfield combination
+        if ((auth & WSC::eWscAuth::WSC_AUTH_SAE) && (auth & WSC::eWscAuth::WSC_AUTH_WPA2PSK)) {
+            return "000FAC08+000FAC02";
+        }
+        LOG(WARNING) << "DPP: unknown WSC auth type 0x" << std::hex << int(auth)
+                     << " — defaulting FH AKM to SAE+SAE-EXT-KEY";
+        return "000FAC08+000FAC24";
+    }
+}
+
+// For BH BSS, DPP is always prepended (agent uses DPP connector to authenticate).
+static std::string wsc_auth_to_bh_akm(WSC::eWscAuth auth)
+{
+    return "506F9A02+" + wsc_auth_to_fh_akm(auth);
+}
+
+bool DppConfiguratorTask::add_bss_config_response_tlvs(const sMacAddr &agent_mac,
+                                                         ieee1905_1::CmduMessageTx &cmdu_tx,
+                                                         const std::vector<sMacAddr> &radio_uids)
+{
+    if (!m_keystore.is_initialized()) {
+        LOG(ERROR) << "DPP: key store not initialized — cannot generate BSS Config Response";
+        return false;
+    }
+
+    // Find session for this agent
+    sDppSession *session = get_session_by_agent(agent_mac);
+    if (!session || !session->enrollee_protocol_key) {
+        // No DPP Auth session (non-secure path: no 0xA9 TLV, no Peer Discovery).
+        // Create a minimal session with an ephemeral key so connectors can be signed.
+        // The netAccessKey in the connector will be this ephemeral key — the agent
+        // uses it for network identity only (no ECDH/EAPOL in non-secure mode).
+        LOG(INFO) << "DPP: no active session for " << agent_mac
+                  << " — creating ephemeral session for non-secure BSS Config Response";
+        std::array<uint8_t, 32> dummy_hash{};
+        dummy_hash[0] = agent_mac.oct[0]; dummy_hash[1] = agent_mac.oct[1];
+        dummy_hash[2] = agent_mac.oct[2]; dummy_hash[3] = agent_mac.oct[3];
+        dummy_hash[4] = agent_mac.oct[4]; dummy_hash[5] = agent_mac.oct[5];
+        session = create_session(agent_mac, agent_mac, dummy_hash, {}, true);
+        if (!session) {
+            LOG(ERROR) << "DPP: failed to create ephemeral session for " << agent_mac;
+            return false;
+        }
+        // Generate an ephemeral P-256 key as the enrollee's netAccessKey
+        EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_id(EVP_PKEY_EC, nullptr);
+        EVP_PKEY *eph_key = nullptr;
+        if (pctx &&
+            EVP_PKEY_keygen_init(pctx) == 1 &&
+            EVP_PKEY_CTX_set_ec_paramgen_curve_nid(pctx, NID_X9_62_prime256v1) == 1) {
+            EVP_PKEY_keygen(pctx, &eph_key);
+        }
+        if (pctx) EVP_PKEY_CTX_free(pctx);
+        if (!eph_key) {
+            LOG(ERROR) << "DPP: failed to generate ephemeral key for " << agent_mac;
+            cleanup_session(dummy_hash);
+            return false;
+        }
+        session->enrollee_protocol_key = eph_key;
+    }
+
+    // Get network configuration from DB
+    const auto &bss_info = m_database.get_bss_info_configuration(agent_mac);
+
+    LOG(ERROR) << "DPP: BSS Config Response for " << agent_mac
+               << " bss_info_count=" << bss_info.size();
+    for (const auto &bss : bss_info) {
+        LOG(ERROR) << "DPP: BSS entry ssid=" << bss.ssid
+                   << " backhaul=" << bss.backhaul
+                   << " auth=0x" << std::hex << int(bss.authentication_type) << std::dec;
+    }
+
+    // Per EasyMesh spec §5.3.3/§5.3.5 (see INTEROP-10/qca-ezmesh interop notes): the
+    // 1905-layer DPP Configuration Object (netRole="mapAgent") belongs in the DPP
+    // Configuration exchange (GAS Config Response, see send_config_response()), not in
+    // the BSS Configuration Response. Sending it here as a no-SSID entry alongside real
+    // BSS configs causes qca-ezmesh's agent to permanently block BSS Config Result: its
+    // csign JWK's "kid" field (added for INTEROP-04) makes qca-ezmesh mark this entry
+    // "waiting for csign from hostapd", but hostapd never emits that event for a non-BSS
+    // (no-SSID) entry, so mapConfigAgentCheckBSSConfigResponse() blocks forever on it.
+
+    static constexpr uint16_t DPP_CONFIG_OBJECT_TYPE = 0x100c;
+
+    auto mac_to_ruid = [](const sMacAddr &mac) -> std::string {
+        char buf[13];
+        snprintf(buf, sizeof(buf), "%02x%02x%02x%02x%02x%02x",
+                 mac.oct[0], mac.oct[1], mac.oct[2],
+                 mac.oct[3], mac.oct[4], mac.oct[5]);
+        return std::string(buf);
+    };
+
+    // Get radio UIDs for RUID field — prefer from BSS Config Request (passed in),
+    // fall back to agent DB, then empty string.
+    std::vector<std::string> radio_ruids;
+    for (const auto &uid : radio_uids) {
+        radio_ruids.push_back(mac_to_ruid(uid));
+        LOG(ERROR) << "DPP: BSS Config Response: using RUID from request=" << uid
+                   << " ruid=" << radio_ruids.back();
+    }
+    if (radio_ruids.empty()) {
+        // Fall back to agent DB radios
+        auto agent_entry = m_database.m_agents.get(agent_mac);
+        if (agent_entry) {
+            for (const auto &radio_pair : agent_entry->radios) {
+                radio_ruids.push_back(mac_to_ruid(radio_pair.first));
+                LOG(ERROR) << "DPP: BSS Config Response: radio_uid from DB=" << radio_pair.first
+                           << " ruid=" << radio_ruids.back();
+            }
+        }
+    }
+    if (radio_ruids.empty()) {
+        LOG(WARNING) << "DPP: BSS Config Response: no radios found for agent " << agent_mac
+                     << " — using empty RUID";
+        radio_ruids.push_back("");
+    }
+
+    // Collect all JSON config strings — one per radio per unique BSS profile
+    std::vector<std::string> configs;
+
+    // BH and FH configs — one entry per radio
+    std::set<std::string> seen_bh, seen_fh;
+    auto agent_entry = m_database.m_agents.get(agent_mac);
+    for (size_t ri = 0; ri < radio_ruids.size(); ri++) {
+        const std::string &ruid = radio_ruids[ri];
+
+        // Get radio band so we can apply the 6GHz SAE-only rule (same as WSC path).
+        // radio->band is set in the WSC M1 path; for DPP extenders infer from op_classes.
+        beerocks::eFreqType radio_band = beerocks::FREQ_UNKNOWN;
+        if (agent_entry && ri < radio_uids.size()) {
+            auto radio_ptr = agent_entry->radios.get(radio_uids[ri]);
+            if (radio_ptr) {
+                radio_band = radio_ptr->band;
+                if (radio_band == beerocks::FREQ_UNKNOWN) {
+                    // Infer from operating classes: 6GHz uses op_class 131–135
+                    for (auto oc : radio_ptr->ap_basic_caps_operating_classes) {
+                        if (oc >= 131 && oc <= 137) {
+                            radio_band = beerocks::FREQ_6G;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+
+        auto adjust_auth = [radio_band](WSC::eWscAuth auth) -> WSC::eWscAuth {
+            // On 6GHz, downgrade SAE+PSK (sae-mixed, 0x60) to SAE-only.
+            // Mirrors adjust_security_mode_for_agent() in controller.cpp.
+            if (radio_band == beerocks::FREQ_6G &&
+                (auth & WSC::eWscAuth::WSC_AUTH_SAE) &&
+                (auth & WSC::eWscAuth::WSC_AUTH_WPA2PSK)) {
+                return WSC::eWscAuth::WSC_AUTH_SAE;
+            }
+            return auth;
+        };
+
+        for (const auto &bss : bss_info) {
+            if (bss.backhaul && seen_bh.insert(ruid + bss.ssid).second) {
+                std::string akm = wsc_auth_to_bh_akm(adjust_auth(bss.authentication_type));
+                std::string custom_alias = son::wireless_utils::vap_type_to_string(bss.vap_type);
+                std::string cfg = generate_backhaul_bss_config(*session, ruid, bss.ssid,
+                                                                bss.network_key, akm, custom_alias);
+                if (!cfg.empty()) configs.push_back(cfg);
+            }
+        }
+        for (const auto &bss : bss_info) {
+            if (!bss.backhaul && seen_fh.insert(ruid + bss.ssid).second) {
+                std::string akm = wsc_auth_to_fh_akm(adjust_auth(bss.authentication_type));
+                // Only prepend the DPP AKM for fronthaul BSSes explicitly flagged DPP
+                // (option dpp '1' on the gateway, or akm=dpp parsed by an extender) —
+                // unlike backhaul, which always uses a DPP connector by design.
+                if (bss.additional_auth == son::wireless_utils::eAdditionalAuth::DPP) {
+                    akm = "506F9A02+" + akm;
+                }
+                std::string custom_alias = son::wireless_utils::vap_type_to_string(bss.vap_type);
+                std::string cfg = generate_fronthaul_bss_config(*session, ruid, bss.ssid,
+                                                                  bss.network_key, akm, custom_alias);
+                if (!cfg.empty()) configs.push_back(cfg);
+            }
+        }
+    }
+
+    // Serialize all configs into one tlvBssConfigurationResponse as DPP sub-TLVs:
+    // type(2LE) + len(2LE) + json.  Single TLV required for interop with qca-ezmesh.
+    if (!configs.empty()) {
+        std::vector<uint8_t> payload;
+        for (const auto &json_str : configs) {
+            uint16_t type_le = DPP_CONFIG_OBJECT_TYPE;
+            uint16_t len_le  = static_cast<uint16_t>(json_str.size());
+            payload.push_back(type_le & 0xFF);
+            payload.push_back((type_le >> 8) & 0xFF);
+            payload.push_back(len_le & 0xFF);
+            payload.push_back((len_le >> 8) & 0xFF);
+            payload.insert(payload.end(), json_str.begin(), json_str.end());
+        }
+
+        auto tlv = cmdu_tx.addClass<wfa_map::tlvBssConfigurationResponse>();
+        if (tlv) {
+            if (!tlv->set_dpp_configuration_object(payload.data(), payload.size())) {
+                LOG(ERROR) << "DPP: set_dpp_configuration_object failed (payload="
+                           << payload.size() << "B) — CMDU buffer too small";
+            } else {
+                LOG(INFO) << "DPP: BSS Config Response TLV payload=" << payload.size()
+                          << "B configs=" << configs.size()
+                          << " radios=" << radio_ruids.size() << " for " << agent_mac;
+            }
+        } else {
+            LOG(ERROR) << "DPP: failed to add tlvBssConfigurationResponse";
+        }
+        // Dump each JSON config in full (chunked to avoid log truncation)
+        for (size_t ci = 0; ci < configs.size(); ci++) {
+            const std::string &js = configs[ci];
+            static constexpr size_t CHUNK = 512;
+            LOG(ERROR) << "DPP: config[" << ci << "] len=" << js.size();
+            for (size_t off = 0; off < js.size(); off += CHUNK) {
+                LOG(ERROR) << "DPP: config[" << ci << "][" << off << "]="
+                           << js.substr(off, CHUNK);
+            }
+        }
+    }
+
+    return true;
+}
+
+// ============================================================================
+// DPP Authentication — send_auth_request
+// ============================================================================
+
+bool DppConfiguratorTask::send_auth_request(sDppSession &session)
+{
+    if (!m_keystore.is_initialized()) return false;
+
+    // 1. Generate ephemeral protocol key pair (PI/pI)
+    session.initiator_protocol_key = DppCryptoHelper::generate_ec_key();
+    if (!session.initiator_protocol_key) {
+        LOG(ERROR) << "DPP: failed to generate initiator protocol key";
+        return false;
+    }
+
+    // 2. Compute M = pI * BR (ECDH with Enrollee's bootstrap key)
+    session.M_x = DppCryptoHelper::ecdh(session.initiator_protocol_key,
+                                          session.enrollee_bootstrap_key_der);
+    if (session.M_x.empty()) {
+        LOG(ERROR) << "DPP: ECDH(pI, BR) failed";
+        return false;
+    }
+
+    // 3. Derive k1 = HKDF(<>, "first intermediate key", M.x)
+    if (!DppCryptoHelper::hkdf(session.M_x, "first intermediate key", session.k1.data(), 32)) {
+        LOG(ERROR) << "DPP: k1 derivation failed";
+        return false;
+    }
+
+    // 4. Generate I-nonce (16 bytes random)
+    DppCryptoHelper::random_bytes(session.i_nonce.data(), 16);
+
+    // 5. Build Auth Request frame
+    std::vector<uint8_t> frame = build_auth_request_frame(session);
+    if (frame.empty()) return false;
+
+    LOG(DEBUG) << "DPP: Auth Request frame (" << frame.size() << " bytes): "
+               << DppCryptoHelper::to_hex(frame.data(), frame.size());
+    LOG(DEBUG) << "DPP: Auth Request i_nonce: "
+               << DppCryptoHelper::to_hex(session.i_nonce.data(), 16);
+    LOG(DEBUG) << "DPP: Auth Request k1: "
+               << DppCryptoHelper::to_hex(session.k1.data(), 32);
+    LOG(DEBUG) << "DPP: Auth Request M_x: "
+               << DppCryptoHelper::to_hex(session.M_x.data(), session.M_x.size());
+
+    session.state = eDppSessionState::AUTH_REQUEST_SENT;
+    LOG(INFO) << "DPP: sending Auth Request to enrollee=" << session.enrollee_mac;
+    return send_dpp_frame(session, frame, false);
+}
+
+// ============================================================================
+// DPP Authentication — handle_auth_response
+// ============================================================================
+
+bool DppConfiguratorTask::handle_auth_response(sDppSession &session, const uint8_t *frame,
+                                                 size_t len)
+{
+    LOG(DEBUG) << "DPP: processing Auth Response";
+    LOG(DEBUG) << "DPP: Auth Response frame (" << len << " bytes): "
+               << DppCryptoHelper::to_hex(frame, len);
+
+    // Parse attributes (after DPP header: Action[1] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1] = 7 bytes)
+    if (len < 7) return false;
+    const uint8_t *attrs     = frame + 7;
+    size_t attrs_len         = len - 7;
+
+    // Check DPP Status
+    uint16_t status_len = 0;
+    const uint8_t *status_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_STATUS, &status_len);
+    if (!status_val || status_len < 1 || status_val[0] != DPP_STATUS_OK) {
+        LOG(ERROR) << "DPP: Auth Response status != OK";
+        return send_auth_confirm(session, false);
+    }
+
+    // Extract Responder Protocol Key (PR)
+    uint16_t pr_len = 0;
+    const uint8_t *pr_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_R_PROTOCOL_KEY, &pr_len);
+    if (!pr_val || pr_len < 64) {
+        LOG(ERROR) << "DPP: Auth Response missing R-Protocol-Key";
+        return false;
+    }
+
+    // Import PR as EC key (uncompressed point: 04 || x || y)
+    // Build a SubjectPublicKeyInfo DER from the raw point
+    // For P-256: the point is 64 bytes (x || y), we need to add 04 prefix
+    std::vector<uint8_t> pr_point(65);
+    pr_point[0] = 0x04;
+    memcpy(pr_point.data() + 1, pr_val, 64);
+
+    // Create EVP_PKEY from uncompressed point (04 || x || y) using EVP_PKEY_fromdata
+    {
+        OSSL_PARAM_BLD *bld = OSSL_PARAM_BLD_new();
+        OSSL_PARAM *params_arr = nullptr;
+        EVP_PKEY_CTX *fctx = nullptr;
+        EVP_PKEY *pr_pkey_tmp = nullptr;
+
+        if (bld &&
+            OSSL_PARAM_BLD_push_utf8_string(bld, OSSL_PKEY_PARAM_GROUP_NAME, "P-256", 0) == 1 &&
+            OSSL_PARAM_BLD_push_octet_string(bld, OSSL_PKEY_PARAM_PUB_KEY,
+                                              pr_point.data(), pr_point.size()) == 1 &&
+            (params_arr = OSSL_PARAM_BLD_to_param(bld)) != nullptr &&
+            (fctx = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr)) != nullptr &&
+            EVP_PKEY_fromdata_init(fctx) == 1 &&
+            EVP_PKEY_fromdata(fctx, &pr_pkey_tmp, EVP_PKEY_PUBLIC_KEY, params_arr) == 1) {
+            session.enrollee_protocol_key = pr_pkey_tmp;
+        } else {
+            LOG(ERROR) << "DPP: failed to import R-Protocol-Key point";
+        }
+        if (fctx) EVP_PKEY_CTX_free(fctx);
+        if (params_arr) OSSL_PARAM_free(params_arr);
+        if (bld) OSSL_PARAM_BLD_free(bld);
+        if (!session.enrollee_protocol_key) return false;
+    }
+
+    // Compute N = pI * PR
+    std::vector<uint8_t> N_x = DppCryptoHelper::ecdh(session.initiator_protocol_key, session.enrollee_protocol_key);
+    if (N_x.empty()) {
+        LOG(ERROR) << "DPP: ECDH(pI, PR) failed";
+        return false;
+    }
+
+    // Derive k2 = HKDF(<>, "second intermediate key", N.x)
+    if (!DppCryptoHelper::hkdf(N_x, "second intermediate key", session.k2.data(), 32)) {
+        LOG(ERROR) << "DPP: k2 derivation failed";
+        return false;
+    }
+
+    // Extract wrapped data (outer)
+    uint16_t wrapped_len = 0;
+    const uint8_t *wrapped_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_WRAPPED_DATA, &wrapped_len);
+    if (!wrapped_val || wrapped_len < 16) {
+        LOG(ERROR) << "DPP: Auth Response missing Wrapped Data";
+        return false;
+    }
+
+    // Build AAD for outer unwrap:
+    // AD1 = OUI header (6 bytes: OUI+OUI_Type+CryptoSuite+FrameType) per Easy Connect §6.3.3
+    // Note: Action byte (frame[0]=0x09) is NOT part of the AAD per the spec
+    std::vector<uint8_t> aad1(frame + 1, frame + 7);
+    size_t wrapped_offset = (wrapped_val - 4) - attrs; // offset of attr ID field
+    std::vector<uint8_t> aad2(attrs, attrs + wrapped_offset);
+
+    std::vector<uint8_t> wrapped_data(wrapped_val, wrapped_val + wrapped_len);
+    LOG(DEBUG) << "DPP: outer decrypt k2:          " << DppCryptoHelper::to_hex(session.k2.data(), 32);
+    LOG(DEBUG) << "DPP: outer decrypt aad1:        " << DppCryptoHelper::to_hex(aad1.data(), aad1.size());
+    LOG(DEBUG) << "DPP: outer decrypt aad2:        " << DppCryptoHelper::to_hex(aad2.data(), aad2.size());
+    LOG(DEBUG) << "DPP: outer decrypt wrapped (" << wrapped_len << " bytes): "
+               << DppCryptoHelper::to_hex(wrapped_data.data(), wrapped_len);
+    std::vector<uint8_t> outer = DppCryptoHelper::aes_siv_decrypt(
+        session.k2.data(), 32, wrapped_data, {aad1, aad2});
+
+    if (outer.empty()) {
+        LOG(ERROR) << "DPP: outer AES-SIV decrypt failed";
+        return false;
+    }
+
+    // Parse outer: R-nonce, I-nonce, R-capabilities, {R-auth}ke
+    const uint8_t *outer_attrs = outer.data();
+    size_t outer_len           = outer.size();
+
+    uint16_t r_nonce_len = 0;
+    const uint8_t *r_nonce_val = find_dpp_attr(outer_attrs, outer_len, DPP_ATTR_R_NONCE, &r_nonce_len);
+    if (!r_nonce_val || r_nonce_len < 16) {
+        LOG(ERROR) << "DPP: missing R-nonce in outer wrapped data";
+        return false;
+    }
+    memcpy(session.r_nonce.data(), r_nonce_val, 16);
+
+    // Verify I-nonce
+    uint16_t i_nonce_len = 0;
+    const uint8_t *i_nonce_val = find_dpp_attr(outer_attrs, outer_len, DPP_ATTR_I_NONCE, &i_nonce_len);
+    if (!i_nonce_val || i_nonce_len < 16 ||
+        memcmp(i_nonce_val, session.i_nonce.data(), 16) != 0) {
+        LOG(ERROR) << "DPP: I-nonce mismatch in Auth Response";
+        return send_auth_confirm(session, false);
+    }
+
+    // Derive ke (mutual auth: Controller has Enrollee bootstrap key)
+    // L = bI * (BR + PR)
+    // bk = HKDF-Extract(I-nonce | R-nonce, M.x | N.x | L.x)
+    // ke = HKDF-Expand(bk, "DPP Key", 32)
+    std::vector<uint8_t> L_x;
+    {
+        // Compute L = bI * (BR + PR) using EC point addition
+        // import_ec_key_der returns EVP_PKEY* (modern API)
+        EVP_PKEY *br_pkey = DppCryptoHelper::import_ec_key_der(
+            session.enrollee_bootstrap_key_der.data(),
+            session.enrollee_bootstrap_key_der.size());
+        if (br_pkey) {
+            uint8_t br_raw[65] = {}, pr_raw[65] = {};
+            size_t br_len = 65, pr_len = 65;
+            bool ok = (EVP_PKEY_get_octet_string_param(br_pkey, OSSL_PKEY_PARAM_PUB_KEY,
+                                                        br_raw, 65, &br_len) == 1 &&
+                       EVP_PKEY_get_octet_string_param(session.enrollee_protocol_key,
+                                                        OSSL_PKEY_PARAM_PUB_KEY,
+                                                        pr_raw, 65, &pr_len) == 1);
+            if (ok) {
+                // EC point addition BR+PR has no direct EVP equivalent in OpenSSL 3.x.
+                // EC_GROUP/EC_POINT are deprecated but still available; suppressed via
+                // -Wno-error=deprecated-declarations in the build.
+                EC_GROUP *g = EC_GROUP_new_by_curve_name(NID_X9_62_prime256v1);
+                EC_POINT *Br = EC_POINT_new(g);
+                EC_POINT *Pr = EC_POINT_new(g);
+                EC_POINT *sum = EC_POINT_new(g);
+                if (EC_POINT_oct2point(g, Br, br_raw, br_len, nullptr) == 1 &&
+                    EC_POINT_oct2point(g, Pr, pr_raw, pr_len, nullptr) == 1 &&
+                    EC_POINT_add(g, sum, Br, Pr, nullptr) == 1) {
+                    // Build EVP_PKEY for sum point so we can call ecdh()
+                    uint8_t sum_raw[65] = {};
+                    size_t sum_len = EC_POINT_point2oct(g, sum, POINT_CONVERSION_UNCOMPRESSED,
+                                                         sum_raw, 65, nullptr);
+                    if (sum_len == 65) {
+                        OSSL_PARAM_BLD *bld = OSSL_PARAM_BLD_new();
+                        OSSL_PARAM *par = nullptr;
+                        EVP_PKEY_CTX *fctx = nullptr;
+                        EVP_PKEY *sum_pkey = nullptr;
+                        if (bld &&
+                            OSSL_PARAM_BLD_push_utf8_string(bld, OSSL_PKEY_PARAM_GROUP_NAME,
+                                                             "P-256", 0) == 1 &&
+                            OSSL_PARAM_BLD_push_octet_string(bld, OSSL_PKEY_PARAM_PUB_KEY,
+                                                              sum_raw, sum_len) == 1 &&
+                            (par = OSSL_PARAM_BLD_to_param(bld)) != nullptr &&
+                            (fctx = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr)) != nullptr &&
+                            EVP_PKEY_fromdata_init(fctx) == 1 &&
+                            EVP_PKEY_fromdata(fctx, &sum_pkey,
+                                              EVP_PKEY_PUBLIC_KEY, par) == 1) {
+                            L_x = DppCryptoHelper::ecdh(m_keystore.bootstrapping_key(), sum_pkey);
+                            if (L_x.empty())
+                                LOG(ERROR) << "DPP: ECDH(bI, BR+PR) for L.x failed";
+                            EVP_PKEY_free(sum_pkey);
+                        } else {
+                            LOG(ERROR) << "DPP: failed to build EVP_PKEY for sum point (BR+PR)";
+                        }
+                        if (fctx) EVP_PKEY_CTX_free(fctx);
+                        if (par) OSSL_PARAM_free(par);
+                        if (bld) OSSL_PARAM_BLD_free(bld);
+                    } else {
+                        LOG(ERROR) << "DPP: EC_POINT_point2oct for sum (BR+PR) failed";
+                    }
+                } else {
+                    LOG(ERROR) << "DPP: EC point import or addition (BR+PR) failed";
+                }
+                EC_POINT_free(sum);
+                EC_POINT_free(Pr);
+                EC_POINT_free(Br);
+                EC_GROUP_free(g);
+            } else {
+                LOG(ERROR) << "DPP: failed to extract BR or PR uncompressed point for L computation";
+            }
+            EVP_PKEY_free(br_pkey);
+        } else {
+            LOG(ERROR) << "DPP: failed to import enrollee bootstrap key DER for L computation";
+        }
+    }
+
+    // bk = HKDF-Extract(I-nonce | R-nonce, M.x | N.x [| L.x])
+    // Per Easy Connect §6.3.3: L.x is only included when both sides have each other's bootstrap
+    // key (mutual authentication). In the EasyMesh DPP wired flow the enrollee (hostapd) has no
+    // controller bootstrap key → auth->peer_bi is NULL on the enrollee side → it skips L.x in
+    // dpp_derive_bk_ke() (hostapd dpp_crypto.c line 470: "if (peer_bi && own_bi)").
+    // Including L.x here while the enrollee omits it produces a different bk/ke, causing the
+    // inner {R-auth}ke AES-SIV decrypt to fail. L_x is computed above only to keep the code
+    // path intact; it must not be fed into bk for the non-mutual-auth case.
+    std::vector<uint8_t> salt;
+    salt.insert(salt.end(), session.i_nonce.begin(), session.i_nonce.end());
+    salt.insert(salt.end(), session.r_nonce.begin(), session.r_nonce.end());
+
+    std::vector<uint8_t> ikm;
+    ikm.insert(ikm.end(), session.M_x.begin(), session.M_x.end());
+    ikm.insert(ikm.end(), N_x.begin(), N_x.end());
+    // L_x intentionally omitted: no mutual authentication in EasyMesh DPP wired flow.
+
+    std::vector<uint8_t> bk;
+    if (!DppCryptoHelper::hkdf_extract(salt, ikm, bk)) {
+        LOG(ERROR) << "DPP: bk extraction failed";
+        return false;
+    }
+
+    std::vector<uint8_t> ke_vec;
+    if (!DppCryptoHelper::hkdf_expand(bk, "DPP Key", 32, ke_vec)) {
+        LOG(ERROR) << "DPP: ke expansion failed";
+        return false;
+    }
+    memcpy(session.ke.data(), ke_vec.data(), 32);
+
+    // Extract and verify R-auth from inner wrapped data.
+    // R-auth = SHA-256(I-nonce || R-nonce || PI.x || PR.x || BR.x || 0x00)
+    // BI.x is omitted: the enrollee (wired path) has no controller bootstrap key,
+    // matching hostapd dpp_gen_r_auth() when peer_bi == NULL.
+    uint16_t inner_wrapped_len = 0;
+    const uint8_t *inner_wrapped_val = find_dpp_attr(outer_attrs, outer_len,
+                                                       DPP_ATTR_WRAPPED_DATA, &inner_wrapped_len);
+    if (inner_wrapped_val && inner_wrapped_len >= 16) {
+        std::vector<uint8_t> inner_ct(inner_wrapped_val, inner_wrapped_val + inner_wrapped_len);
+        LOG(DEBUG) << "DPP: inner decrypt ke:           " << DppCryptoHelper::to_hex(session.ke.data(), 32);
+        LOG(DEBUG) << "DPP: inner decrypt ciphertext (" << inner_wrapped_len << " bytes): "
+                   << DppCryptoHelper::to_hex(inner_ct.data(), inner_wrapped_len);
+        std::vector<uint8_t> inner = DppCryptoHelper::aes_siv_decrypt(
+            session.ke.data(), 32, inner_ct, {});
+
+        if (!inner.empty()) {
+            uint16_t r_auth_len = 0;
+            const uint8_t *r_auth_val = find_dpp_attr(inner.data(), inner.size(),
+                                                        DPP_ATTR_R_AUTH_TAG, &r_auth_len);
+            if (!r_auth_val || r_auth_len < 32) {
+                LOG(ERROR) << "DPP: R-auth tag missing or too short in inner wrapped data";
+                return send_auth_confirm(session, false);
+            }
+
+            // Helper: extract x-coordinate (32 B) from an EVP_PKEY.
+            // Handles both uncompressed SPKI (91 B) and compressed SPKI (59 B).
+            // For both forms x lives at der[27..58] — the offset is identical.
+            // Also handles OSSL_PKEY_PARAM_PUB_KEY returning a compressed point (33 B).
+            auto get_x = [](const EVP_PKEY *key, uint8_t out[32]) -> bool {
+                unsigned char *der = nullptr;
+                int der_len = i2d_PUBKEY(const_cast<EVP_PKEY *>(key), &der);
+                bool ok = false;
+                if (der && der_len == 91 && der[26] == 0x04) {
+                    // Uncompressed SPKI: 04 || x(32) || y(32)
+                    memcpy(out, der + 27, 32);
+                    ok = true;
+                } else if (der && der_len == 59 &&
+                           (der[26] == 0x02 || der[26] == 0x03)) {
+                    // Compressed SPKI: 02/03 || x(32) — same x offset as uncompressed
+                    memcpy(out, der + 27, 32);
+                    ok = true;
+                } else if (der) {
+                    // Fallback: ask OpenSSL for the raw point bytes
+                    size_t len = 0;
+                    EVP_PKEY_get_octet_string_param(const_cast<EVP_PKEY *>(key),
+                                                    OSSL_PKEY_PARAM_PUB_KEY, nullptr, 0, &len);
+                    if (len > 0) {
+                        std::vector<uint8_t> buf(len);
+                        EVP_PKEY_get_octet_string_param(const_cast<EVP_PKEY *>(key),
+                                                        OSSL_PKEY_PARAM_PUB_KEY,
+                                                        buf.data(), len, &len);
+                        if (len == 65 && buf[0] == 0x04) {
+                            // Uncompressed raw point
+                            memcpy(out, buf.data() + 1, 32);
+                            ok = true;
+                        } else if (len == 33 &&
+                                   (buf[0] == 0x02 || buf[0] == 0x03)) {
+                            // Compressed raw point — x is the next 32 bytes
+                            memcpy(out, buf.data() + 1, 32);
+                            ok = true;
+                        }
+                    }
+                }
+                if (der) OPENSSL_free(der);
+                return ok;
+            };
+
+            uint8_t pi_x[32] = {}, pr_x[32] = {}, br_x[32] = {};
+            bool ok = get_x(session.initiator_protocol_key, pi_x)
+                   && get_x(session.enrollee_protocol_key,  pr_x);
+
+            // BR.x from enrollee bootstrap key DER.
+            // Uncompressed SPKI = 91 bytes, point at [26] = 0x04, x at [27..58].
+            // Compressed SPKI   = 59 bytes, point at [26] = 0x02/03, x at [27..58].
+            const auto &bkd = session.enrollee_bootstrap_key_der;
+            if (ok && ((bkd.size() == 91 && bkd[26] == 0x04) ||
+                       (bkd.size() == 59 && (bkd[26] == 0x02 || bkd[26] == 0x03)))) {
+                memcpy(br_x, bkd.data() + 27, 32);
+            } else if (ok) {
+                EVP_PKEY *br_key = DppCryptoHelper::import_ec_key_der(
+                    bkd.data(), bkd.size());
+                ok = br_key && get_x(br_key, br_x);
+                if (br_key) EVP_PKEY_free(br_key);
+            }
+
+            if (!ok) {
+                LOG(ERROR) << "DPP: R-auth: failed to extract key x-coordinates";
+                return send_auth_confirm(session, false);
+            }
+
+            // Compute expected R-auth
+            uint8_t expected[32];
+            uint8_t zero = 0;
+            EVP_MD_CTX *md = EVP_MD_CTX_new();
+            unsigned int out_len = 32;
+            EVP_DigestInit_ex(md, EVP_sha256(), nullptr);
+            EVP_DigestUpdate(md, session.i_nonce.data(), 16);
+            EVP_DigestUpdate(md, session.r_nonce.data(), 16);
+            EVP_DigestUpdate(md, pi_x, 32);
+            EVP_DigestUpdate(md, pr_x, 32);
+            EVP_DigestUpdate(md, br_x, 32);
+            EVP_DigestUpdate(md, &zero, 1);
+            EVP_DigestFinal_ex(md, expected, &out_len);
+            EVP_MD_CTX_free(md);
+
+            if (memcmp(r_auth_val, expected, 32) != 0) {
+                LOG(ERROR) << "DPP: R-auth mismatch — enrollee identity not verified";
+                LOG(DEBUG) << "DPP:   received = "
+                           << DppCryptoHelper::to_hex(r_auth_val, 32);
+                LOG(DEBUG) << "DPP:   expected = "
+                           << DppCryptoHelper::to_hex(expected, 32);
+                return send_auth_confirm(session, false);
+            }
+
+            LOG(DEBUG) << "DPP: R-auth verified OK";
+        } else {
+            LOG(ERROR) << "DPP: inner AES-SIV decrypt of {R-auth}ke failed — ke may be wrong";
+            return send_auth_confirm(session, false);
+        }
+    }
+
+    LOG(INFO) << "DPP: Auth Response validated, sending Auth Confirm";
+    return send_auth_confirm(session, true);
+}
+
+// ============================================================================
+// DPP Authentication — send_auth_confirm
+// ============================================================================
+
+bool DppConfiguratorTask::send_auth_confirm(sDppSession &session, bool success)
+{
+    std::vector<uint8_t> frame = build_auth_confirm_frame(session, success);
+    if (frame.empty()) return false;
+
+    LOG(DEBUG) << "DPP: Auth Confirm frame (" << frame.size() << " bytes): "
+               << DppCryptoHelper::to_hex(frame.data(), frame.size());
+
+    if (success) {
+        session.state = eDppSessionState::AUTH_COMPLETE;
+        LOG(INFO) << "DPP: Auth Confirm sent (success)";
+    } else {
+        LOG(WARNING) << "DPP: Auth Confirm sent (failure)";
+        cleanup_session(session.bootstrap_hash);
+    }
+
+    return send_dpp_frame(session, frame, false);
+}
+
+// ============================================================================
+// DPP Configuration — handle_config_request
+// ============================================================================
+
+bool DppConfiguratorTask::handle_config_request(sDppSession &session, const uint8_t *frame,
+                                                  size_t len)
+{
+    LOG(INFO) << "DPP: GAS Config Request received from enrollee=" << session.enrollee_mac
+              << " frame_len=" << len;
+    LOG(DEBUG) << "DPP: Config Request frame (" << len << " bytes): "
+               << DppCryptoHelper::to_hex(frame, len);
+
+    // Debug: Print first 16 bytes of received frame
+    {
+        std::ostringstream hex_dump;
+        size_t dump_len = std::min(static_cast<size_t>(16), len);
+        for (size_t i = 0; i < dump_len; ++i) {
+            hex_dump << std::hex << std::setw(2) << std::setfill('0')
+                     << static_cast<int>(frame[i]) << " ";
+        }
+        LOG(DEBUG) << "DPP: controller received GAS Request, first " << dump_len << " bytes: "
+                   << hex_dump.str();
+    }
+
+    // GAS Initial Request: Category(1) + Action(1) + DialogToken(1) + AdvProto(var) + QueryLen(2) + Query
+    // The DPP attributes start after the GAS header
+    // For simplicity, find the wrapped data attribute in the frame
+    if (len < 10) return false;
+
+    // Per EasyMesh spec, the encapsulated frame is the raw GAS frame (no TCP type byte, no Category byte).
+    // GAS Initial Request does NOT include Category byte in 1905 encapsulation:
+    //   frame[0] = 0x0A  (Action: GAS Initial Request)
+    //   frame[1] = Dialog Token
+    //   frame[2] = AdvProto length
+    //   ...
+    // Note: GAS frames (both Request and Response) do NOT include Category byte in 1905 encapsulation.
+    // Save the dialog token so we can echo it back in the GAS Response.
+    if (len > 1) {
+        session.gas_dialog_token = frame[1];
+        LOG(DEBUG) << "DPP: GAS Config Request dialog_token=0x"
+                   << std::hex << static_cast<int>(session.gas_dialog_token) << std::dec;
+    }
+
+    // Skip GAS header to find DPP attributes
+    // GAS Initial Request structure:
+    //   Action(1) + DialogToken(1) + AdvProto_Element(var) + QueryReqLen(2) + QueryReq(var)
+    // AdvProto Element structure (802.11-2016 §9.4.2.26):
+    //   Element_ID(1=0x6C) + Length(1) + AdvProto_Tuple(var)
+    // For DPP: Element_ID=0x6C, Length=0x08, Tuple=8 bytes
+    size_t offset = 2; // Action + DialogToken
+    if (offset + 2 >= len) return false;
+
+    // Parse Advertisement Protocol Element: skip Element_ID(1) + Length(1) + Tuple(Length bytes)
+    // frame[offset] = Element_ID (0x6C), frame[offset+1] = Length (0x08)
+    uint8_t advproto_element_len = frame[offset + 1];
+    offset += 2 + advproto_element_len; // skip Element_ID + Length + AdvProto_Tuple
+
+    if (offset + 2 >= len) return false;
+    uint16_t query_len = (frame[offset] | (frame[offset + 1] << 8));
+    offset += 2;
+
+    if (offset >= len) return false;
+    const uint8_t *attrs = frame + offset;
+    size_t attrs_len     = std::min(static_cast<size_t>(query_len), len - offset);
+
+    LOG(DEBUG) << "DPP: Config Request GAS header parsed: dialog_token=0x"
+               << std::hex << static_cast<int>(session.gas_dialog_token)
+               << " advproto_len=" << std::dec << static_cast<int>(advproto_element_len)
+               << " query_len=" << query_len << " attrs_offset=" << offset;
+
+    // Find wrapped data
+    uint16_t wrapped_len = 0;
+    const uint8_t *wrapped_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_WRAPPED_DATA, &wrapped_len);
+    if (!wrapped_val || wrapped_len < 16) {
+        LOG(ERROR) << "DPP: Config Request missing Wrapped Data";
+        return false;
+    }
+
+    // Decrypt with ke
+    std::vector<uint8_t> wrapped_data(wrapped_val, wrapped_val + wrapped_len);
+    std::vector<uint8_t> plaintext = DppCryptoHelper::aes_siv_decrypt(
+        session.ke.data(), 32, wrapped_data, {});
+
+    if (plaintext.empty()) {
+        LOG(ERROR) << "DPP: Config Request AES-SIV decrypt failed"
+                   << " ke=" << DppCryptoHelper::to_hex(session.ke.data(), 32)
+                   << " wrapped=" << DppCryptoHelper::to_hex(wrapped_val, std::min(wrapped_len, uint16_t(32)));
+        return false;
+    }
+    LOG(DEBUG) << "DPP: Config Request decrypted (" << plaintext.size() << " bytes): "
+               << DppCryptoHelper::to_hex(plaintext.data(), plaintext.size());
+
+    // Extract E-nonce
+    uint16_t e_nonce_len = 0;
+    const uint8_t *e_nonce_val = find_dpp_attr(plaintext.data(), plaintext.size(),
+                                                 DPP_ATTR_ENROLLEE_NONCE, &e_nonce_len);
+    if (e_nonce_val && e_nonce_len >= 16) {
+        memcpy(session.e_nonce.data(), e_nonce_val, 16);
+    }
+
+    // Extract configRequest JSON
+    uint16_t config_req_len = 0;
+    const uint8_t *config_req_val = find_dpp_attr(plaintext.data(), plaintext.size(),
+                                                    DPP_ATTR_CONFIG_REQUEST_OBJ, &config_req_len);
+    if (config_req_val && config_req_len > 0) {
+        session.config_request_json = std::string(
+            reinterpret_cast<const char *>(config_req_val), config_req_len);
+        // Print configRequest in chunks to avoid syslog line-length truncation
+        {
+            constexpr size_t CHUNK = 512;
+            const std::string &s   = session.config_request_json;
+            LOG(DEBUG) << "DPP: configRequest (" << s.size() << " bytes):";
+            for (size_t off = 0; off < s.size(); off += CHUNK) {
+                LOG(DEBUG) << "  [" << (off / CHUNK) << "] " << s.substr(off, CHUNK);
+            }
+        }
+    }
+
+    session.state = eDppSessionState::CONFIG_REQUEST_RECEIVED;
+    return send_config_response(session);
+}
+
+// ============================================================================
+// DPP Configuration — send_config_response
+// ============================================================================
+
+bool DppConfiguratorTask::send_config_response(sDppSession &session)
+{
+    LOG(INFO) << "DPP: send_config_response called — enrollee=" << session.enrollee_mac
+              << " is_wired=" << session.is_wired
+              << " keystore_init=" << m_keystore.is_initialized()
+              << " enrollee_protocol_key=" << (session.enrollee_protocol_key ? "SET" : "NULL");
+
+    if (!m_keystore.is_initialized() || !session.enrollee_protocol_key) {
+        LOG(ERROR) << "DPP: cannot generate Config Response — keys not ready";
+        return false;
+    }
+
+    // Generate Configuration Objects
+    // Get backhaul SSID/passphrase from DB first — needed by generate_1905_layer_config
+    std::string config_bsta;
+    std::string bh_ssid, bh_passphrase, bh_akm;
+    const auto &bss_info = m_database.get_bss_info_configuration(session.enrollee_mac);
+    for (const auto &bss : bss_info) {
+        if (bss.backhaul) {
+            bh_ssid       = bss.ssid;
+            bh_passphrase = bss.network_key;
+            bh_akm        = wsc_auth_to_bh_akm(bss.authentication_type);
+            config_bsta   = generate_backhaul_sta_config(session, bh_ssid, bh_passphrase, bh_akm);
+            LOG(INFO) << "DPP: GAS Config — bh_ssid='" << bh_ssid
+                      << "' auth=0x" << std::hex << int(bss.authentication_type) << std::dec
+                      << " bh_akm='" << bh_akm << "'";
+            break;
+        }
+    }
+
+    std::string config_1905 = generate_1905_layer_config(session);
+
+    LOG(INFO) << "DPP: Config Response objects — config_1905_len=" << config_1905.size()
+              << " config_bsta_len=" << config_bsta.size()
+              << " bh_ssid='" << bh_ssid << "'";
+
+    // Build payload JSON: {e_nonce, configObjects}
+    // Encode e_nonce as hex
+    std::string e_nonce_hex = DppCryptoHelper::to_hex(session.e_nonce.data(), 16);
+
+    // Build configObjects array
+    std::string config_objects_json = "[";
+    if (!config_1905.empty()) {
+        config_objects_json += "\"" + config_1905 + "\"";
+    }
+    if (!config_bsta.empty()) {
+        if (config_objects_json.size() > 1) config_objects_json += ",";
+        config_objects_json += "\"" + config_bsta + "\"";
+    }
+    config_objects_json += "]";
+
+    // Log the prepared Config Response JSON objects for diagnostics.
+    // Print in 512-byte chunks to avoid syslog line-length truncation.
+    auto log_chunked = [](const std::string &label, const std::string &s) {
+        constexpr size_t CHUNK = 512;
+        LOG(INFO) << label << " (" << s.size() << " bytes):";
+        for (size_t off = 0; off < s.size(); off += CHUNK) {
+            LOG(INFO) << "  [" << (off / CHUNK) << "] " << s.substr(off, CHUNK);
+        }
+    };
+
+    LOG(INFO) << "DPP: Config Response — enrollee=" << session.enrollee_mac;
+    if (!config_1905.empty()) {
+        log_chunked("DPP: Config Response — 1905-layer config object", config_1905);
+    } else {
+        LOG(WARNING) << "DPP: Config Response — 1905-layer config object is empty";
+    }
+    if (!config_bsta.empty()) {
+        log_chunked("DPP: Config Response — backhaul STA config object", config_bsta);
+    } else {
+        LOG(DEBUG) << "DPP: Config Response — no backhaul STA config object";
+    }
+    log_chunked("DPP: Config Response — configObjects JSON", config_objects_json);
+
+    // Build DPP Config Object attributes
+    std::vector<uint8_t> plaintext;
+
+    // Add E-nonce attribute
+    append_dpp_attr(plaintext, DPP_ATTR_ENROLLEE_NONCE, session.e_nonce.data(), 16);
+
+    // Add each config object as a separate attribute.
+    // For wired extenders, skip the backhaul STA config — there is no wireless backhaul
+    // STA on a wired extender, and including it pushes the GAS Response over the 1500-byte
+    // MTU causing the transport fragmentation to drop the packet.
+    if (!config_1905.empty()) {
+        append_dpp_attr(plaintext, DPP_ATTR_CONFIG_OBJ,
+                        reinterpret_cast<const uint8_t *>(config_1905.data()),
+                        static_cast<uint16_t>(config_1905.size()));
+    }
+    if (!config_bsta.empty() && !session.is_wired) {
+        append_dpp_attr(plaintext, DPP_ATTR_CONFIG_OBJ,
+                        reinterpret_cast<const uint8_t *>(config_bsta.data()),
+                        static_cast<uint16_t>(config_bsta.size()));
+    }
+
+    // Debug: log plaintext size before encryption
+    LOG(DEBUG) << "DPP: Config Response plaintext size=" << plaintext.size()
+               << " bytes before AES-SIV encryption";
+    LOG(DEBUG) << "DPP: Config Response ke: " << DppCryptoHelper::to_hex(session.ke.data(), 32);
+    LOG(DEBUG) << "DPP: Config Response plaintext: "
+               << DppCryptoHelper::to_hex(plaintext.data(), plaintext.size());
+
+    // Build Status attribute (this will be the AAD for encryption)
+    // Per hostapd dpp_conf_resp_rx() line 3406-3408: AAD = all attributes before Wrapped Data
+    uint8_t status_val = DPP_STATUS_OK;
+    std::vector<uint8_t> status_attr;
+    append_dpp_attr(status_attr, DPP_ATTR_STATUS, &status_val, 1);
+
+    // Encrypt with ke using Status attribute as AAD
+    // This matches hostapd's dpp_conf_resp_rx() which uses:
+    //   addr[0] = wpabuf_head(resp);
+    //   len[0] = wrapped_data - 4 - (const u8 *) wpabuf_head(resp);
+    // i.e., all DPP attributes before Wrapped Data (including Status)
+    std::vector<uint8_t> wrapped = DppCryptoHelper::aes_siv_encrypt(
+        session.ke.data(), 32, plaintext, {status_attr});
+
+    if (wrapped.empty()) {
+        LOG(ERROR) << "DPP: Config Response AES-SIV encrypt failed";
+        return false;
+    }
+
+    LOG(DEBUG) << "DPP: Config Response wrapped data size=" << wrapped.size()
+               << " bytes after AES-SIV encryption";
+
+    // Build complete DPP attributes: Status + Wrapped Data
+    std::vector<uint8_t> response_attrs = status_attr;
+    append_dpp_attr(response_attrs, DPP_ATTR_WRAPPED_DATA, wrapped.data(),
+                    static_cast<uint16_t>(wrapped.size()));
+
+    LOG(DEBUG) << "DPP: Config Response DPP attributes size=" << response_attrs.size() << " bytes";
+
+    std::vector<uint8_t> gas_frame = build_gas_response_frame(DPP_STATUS_OK, response_attrs);
+    LOG(DEBUG) << "DPP: Config Response GAS frame size=" << gas_frame.size() << " bytes";
+
+    // Patch in the dialog token from the GAS Request.
+    // Since Category byte is not included in 1905 encapsulation, dialog token is at offset 1
+    // (after Action byte 0x0B)
+    if (gas_frame.size() > 1) {
+        gas_frame[1] = session.gas_dialog_token;
+    }
+
+    // Debug: Print full GAS response frame
+    LOG(DEBUG) << "DPP: Config Response GAS frame (" << gas_frame.size() << " bytes): "
+               << DppCryptoHelper::to_hex(gas_frame.data(), gas_frame.size());
+    {
+        std::ostringstream hex_dump;
+        size_t dump_len = std::min(static_cast<size_t>(32), gas_frame.size());
+        for (size_t i = 0; i < dump_len; ++i) {
+            hex_dump << std::hex << std::setw(2) << std::setfill('0')
+                     << static_cast<int>(gas_frame[i]) << " ";
+        }
+        LOG(DEBUG) << "DPP: Config Response GAS frame first " << dump_len << " bytes: "
+                   << hex_dump.str();
+    }
+
+    session.state = eDppSessionState::CONFIG_SENT;
+    LOG(INFO) << "DPP: sending Config Response to enrollee=" << session.enrollee_mac
+              << " dialog_token=0x" << std::hex << static_cast<int>(session.gas_dialog_token)
+              << std::dec;
+    return send_dpp_frame(session, gas_frame, true);
+}
