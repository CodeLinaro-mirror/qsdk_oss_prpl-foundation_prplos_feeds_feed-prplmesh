+// ============================================================================
+// URI cache management
+// ============================================================================
+
+void DppConfiguratorTask::setup_uri_file_watcher()
+{
+    m_inotify_fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
+    if (m_inotify_fd < 0) {
+        LOG(WARNING) << "DPP: inotify_init1 failed — URI file changes will not be detected";
+        return;
+    }
+    // Watch for close-write and moved-to (editors often replace files atomically).
+    m_inotify_wd = inotify_add_watch(m_inotify_fd, DPP_URIS_FILE,
+                                      IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE);
+    if (m_inotify_wd < 0) {
+        // File may not exist yet — watch the directory instead and reload on any event.
+        m_inotify_wd = inotify_add_watch(m_inotify_fd, "/etc/prplmesh",
+                                          IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE);
+        if (m_inotify_wd < 0)
+            LOG(WARNING) << "DPP: inotify_add_watch failed — URI file changes will not be detected";
+        else
+            LOG(DEBUG) << "DPP: watching /etc/prplmesh for URI file creation";
+    } else {
+        LOG(INFO) << "DPP: watching " << DPP_URIS_FILE << " for changes";
+    }
+
+    if (m_inotify_fd < 0 || !m_event_loop) return;
+
+    beerocks::EventLoop::EventHandlers handlers{
+        .name    = "DPP URI file watcher",
+        .on_read = [this](int fd, beerocks::EventLoop &loop) {
+            poll_uri_file_changes();
+            return true;
+        },
+    };
+    if (!m_event_loop->register_handlers(m_inotify_fd, handlers)) {
+        LOG(WARNING) << "DPP: failed to register inotify fd with the event loop — "
+                        "URI file changes will not be detected";
+    }
+}
+
+void DppConfiguratorTask::poll_uri_file_changes()
+{
+    if (m_inotify_fd < 0) return;
+
+    // Non-blocking read — drain all pending events.
+    char buf[sizeof(inotify_event) + NAME_MAX + 1];
+    bool changed  = false;
+    bool watch_ignored = false;
+    for (;;) {
+        ssize_t n = ::read(m_inotify_fd, buf, sizeof(buf));
+        if (n < 0) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK) break; // no more events
+            LOG(WARNING) << "DPP: inotify read error: " << strerror(errno);
+            break;
+        }
+        if (n == 0) break;
+        // Any event on the watched path means the URI file was modified.
+        changed = true;
+        // IN_IGNORED means the watch itself was removed (e.g. the watched file was
+        // deleted/replaced) — this is generated by the kernel, but ALSO by our own
+        // inotify_rm_watch() call below, so only rearm when we actually see it,
+        // never unconditionally (else rm+add generates a fresh IN_IGNORED every time,
+        // which would re-trigger this handler forever).
+        for (const uint8_t *p = reinterpret_cast<uint8_t *>(buf);
+             p + sizeof(inotify_event) <= reinterpret_cast<uint8_t *>(buf) + n;) {
+            const auto *ev = reinterpret_cast<const inotify_event *>(p);
+            if (ev->mask & IN_IGNORED) watch_ignored = true;
+            p += sizeof(inotify_event) + ev->len;
+        }
+    }
+
+    if (changed) {
+        LOG(INFO) << "DPP: URI file change detected — reloading enrollee URIs";
+        load_dpp_uris();
+    }
+
+    // Only re-arm the watch if it was actually invalidated (file watch removed by the
+    // kernel on delete/atomic-replace). Re-adding unconditionally would generate a new
+    // IN_IGNORED via inotify_rm_watch() and loop forever.
+    if (watch_ignored) {
+        if (m_inotify_wd >= 0) inotify_rm_watch(m_inotify_fd, m_inotify_wd);
+        m_inotify_wd = inotify_add_watch(m_inotify_fd, DPP_URIS_FILE,
+                                          IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE);
+        if (m_inotify_wd < 0)
+            m_inotify_wd = inotify_add_watch(m_inotify_fd, "/etc/prplmesh",
+                                              IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE);
+    }
+}
+
+bool DppConfiguratorTask::add_uri_to_cache(const std::string &uri)
+{
+    if (uri.empty() || uri[0] == '#') return false; // skip blank lines and comments
+
+    const std::string k_prefix = "K:";
+    auto k_pos = uri.find(k_prefix);
+    if (k_pos == std::string::npos) {
+        LOG(WARNING) << "DPP: URI missing K: field — skipping: " << uri.substr(0, 40);
+        return false;
+    }
+    k_pos += k_prefix.size();
+    auto k_end = uri.find(';', k_pos);
+    if (k_end == std::string::npos) k_end = uri.size();
+
+    const std::string key_b64 = uri.substr(k_pos, k_end - k_pos);
+    std::vector<uint8_t> der  = DppCryptoHelper::base64url_decode(key_b64);
+    if (der.empty()) {
+        LOG(WARNING) << "DPP: failed to decode K: field in URI — skipping";
+        return false;
+    }
+
+    // Compute chirp hash = SHA-256("chirp" || DER)
+    static const std::string chirp_prefix = "chirp";
+    std::vector<uint8_t> input;
+    input.reserve(chirp_prefix.size() + der.size());
+    input.insert(input.end(), chirp_prefix.begin(), chirp_prefix.end());
+    input.insert(input.end(), der.begin(), der.end());
+
+    std::array<uint8_t, 32> chirp_hash{};
+    if (!DppCryptoHelper::sha256(input.data(), input.size(), chirp_hash.data())) {
+        LOG(WARNING) << "DPP: SHA-256 failed for URI — skipping";
+        return false;
+    }
+
+    m_uri_cache[chirp_hash] = std::move(der);
+    return true;
+}
+
+void DppConfiguratorTask::load_dpp_uris()
+{
+    m_uri_cache.clear();
+
+    // /etc/prplmesh/dpp_uri — one DPP URI per line; blank lines and '#' comments skipped.
+    std::ifstream f(DPP_URIS_FILE);
+    if (!f.good()) {
+        LOG(DEBUG) << "DPP: " << DPP_URIS_FILE << " not found — no enrollee URIs loaded";
+        return;
+    }
+    std::string line;
+    int loaded = 0, skipped = 0;
+    while (std::getline(f, line)) {
+        // Strip trailing CR/space
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+            line.pop_back();
+        if (add_uri_to_cache(line)) ++loaded; else ++skipped;
+    }
+    LOG(INFO) << "DPP: loaded " << loaded << " URI(s) from " << DPP_URIS_FILE
+              << " (" << skipped << " skipped)";
+}
