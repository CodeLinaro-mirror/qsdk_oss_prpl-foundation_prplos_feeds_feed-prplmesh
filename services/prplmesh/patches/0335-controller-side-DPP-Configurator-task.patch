+void Controller::apply_pending_dpp_radio_info(const sMacAddr &radio_mac)
+{
+    auto it = m_pending_dpp_radio_info.find(radio_mac);
+    if (it == m_pending_dpp_radio_info.end()) {
+        return;
+    }
+
+    if (!database.get_radio_by_uid(radio_mac)) {
+        return; // still not registered — stay pending until add_radio() runs
+    }
+
+    const auto &info = it->second;
+    database.set_radio_iface_name(radio_mac, info.iface_name);
+
+    auto agent = database.get_agent_by_radio_uid(radio_mac);
+    if (agent) {
+        std::string bridge_ipv4 = beerocks::net::network_utils::ipv4_to_string(info.bridge_ipv4);
+        database.set_agent_ipv4(tlvf::mac_to_string(agent->al_mac), bridge_ipv4);
+        LOG(DEBUG) << "DPP: applied pending radio info for " << radio_mac
+                   << " iface_name=" << info.iface_name << " agent_ipv4=" << bridge_ipv4;
+
+        // Establish agent->parent_mac + a backhaul Station record so the BML topology
+        // dump can print Eth_BACKHAUL/WiFi_BACKHAUL for this agent, the same way
+        // handle_intel_slave_join() does for WSC agents (controller.cpp, WSC-only path).
+        sMacAddr backhaul_mac = info.backhaul_mac;
+        if (backhaul_mac != beerocks::net::network_utils::ZERO_MAC) {
+            if (!database.has_station(backhaul_mac)) {
+                auto gw = database.get_gw();
+                if (gw && !gw->eth_switches.empty()) {
+                    database.add_backhaul_station(backhaul_mac, gw->eth_switches.begin()->first);
+                    database.set_sta_state(tlvf::mac_to_string(backhaul_mac),
+                                           beerocks::STATE_CONNECTED);
+                }
+            }
+            auto bh_sta = database.get_station(backhaul_mac);
+            if (bh_sta) {
+                bh_sta->set_bSta(true);
+                bh_sta->iface_type = info.backhaul_is_wireless
+                                         ? beerocks::IFACE_TYPE_WIFI_INTEL
+                                         : beerocks::IFACE_TYPE_ETHERNET;
+            }
+
+            if (agent->parent_mac != backhaul_mac) {
+                database.add_agent(agent->al_mac, backhaul_mac);
+            }
+
+            // Mirror handle_intel_slave_join()'s stray-station cleanup (controller.cpp,
+            // WSC-only path): on some devices backhaul_mac == the agent's own al_mac
+            // (e.g. wired extenders where ethernet.wan.mac equals the bridge MAC), in
+            // which case the backhaul Station record above collides with the agent's own
+            // identity and is removed, matching WSC's rendering for this device class.
+            if (backhaul_mac == agent->al_mac && database.has_station(backhaul_mac)) {
+                database.remove_sta(backhaul_mac);
+            }
+        }
+    }
+
+    m_pending_dpp_radio_info.erase(it);
+}
