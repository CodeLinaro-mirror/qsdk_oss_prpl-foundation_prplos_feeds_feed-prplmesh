+
+bool DppConfiguratorTask::handle_peer_discovery_request(const sMacAddr &agent_mac,
+                                                          const uint8_t *frame, size_t len)
+{
+    LOG(INFO) << "DPP: Peer Discovery Request from " << agent_mac;
+
+    // Parse attributes (after Action[1] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1] = 7 bytes)
+    if (len < 7) return false;
+    const uint8_t *attrs = frame + 7;
+    size_t attrs_len     = len - 7;
+
+    // Extract Agent's Connector
+    uint16_t connector_len = 0;
+    const uint8_t *connector_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_CONNECTOR,
+                                                   &connector_len);
+    if (!connector_val || connector_len == 0) {
+        LOG(ERROR) << "DPP: Peer Discovery Request missing Connector";
+        return false;
+    }
+
+    std::string agent_connector(reinterpret_cast<const char *>(connector_val), connector_len);
+
+    // Log connector for debugging
+    LOG(DEBUG) << "DPP: Agent Connector (first 100 chars): "
+               << agent_connector.substr(0, std::min(size_t(100), agent_connector.size()));
+    LOG(DEBUG) << "DPP: Agent Connector length: " << agent_connector.size();
+
+    // Verify Connector signature
+    if (!m_keystore.C_sign_key()) {
+        LOG(ERROR) << "DPP: Controller C-sign key not initialized";
+        return false;
+    }
+
+    if (!DppCryptoHelper::verify_connector(agent_connector, m_keystore.C_sign_key())) {
+        LOG(ERROR) << "DPP: Agent Connector signature verification failed";
+        return false;
+    }
+
+    // Parse Connector to get netRole and netAccessKey
+    std::string net_role, group_id, expiry;
+    EVP_PKEY *agent_nak = nullptr;
+    if (!DppCryptoHelper::parse_connector(agent_connector, net_role, group_id, &agent_nak,
+                                           expiry)) {
+        LOG(ERROR) << "DPP: failed to parse Agent Connector";
+        return false;
+    }
+
+    if (net_role != "mapAgent") {
+        LOG(ERROR) << "DPP: Agent Connector netRole=" << net_role << " (expected mapAgent)";
+        EVP_PKEY_free(agent_nak);
+        return false;
+    }
+
+    // Find or create session
+    auto *session = get_session_by_agent(agent_mac);
+    if (session) {
+        // EXT sent PeerDiscReq — always clear the old session and restart.
+        // GW never initiates PeerDiscReq; EXT always drives this exchange.
+        // Any existing session (in-progress or completed) is stale and must be cleared.
+        LOG(INFO) << "DPP: Agent " << agent_mac << " PeerDiscReq received — clearing session (state="
+                  << static_cast<int>(session->state) << ") and restarting";
+        if (m_broker_client) {
+            m_broker_client->install_security_key(agent_mac, {}, {}, 0, false);
+        }
+        // Invalidate stored PMK in Agent DB — a new PMK will be derived below
+        auto stale_agent = m_database.m_agents.get(agent_mac);
+        if (stale_agent) {
+            stale_agent->pmk_1905_valid = false;
+        }
+        // Remove the stale session so a fresh one is created below
+        for (auto it = m_sessions.begin(); it != m_sessions.end(); ) {
+            auto &s = it->second;
+            if (s && (s->proxy_agent_mac == agent_mac || s->enrollee_mac == agent_mac)) {
+                it = m_sessions.erase(it);
+            } else {
+                ++it;
+            }
+        }
+        session = nullptr;
+    }
+
+    // Create a new session for the 4-way handshake
+    LOG(DEBUG) << "DPP: Creating new session for Peer Discovery Request from " << agent_mac;
+    std::array<uint8_t, 32> dummy_hash{};
+    session = create_session(agent_mac, agent_mac, dummy_hash, {}, false);
+    if (!session) {
+        EVP_PKEY_free(agent_nak);
+        return false;
+    }
+
+    // Calculate PMKID for debugging BEFORE freeing agent_nak
+    // DPP PMKID = Truncate-128(SHA-256(min(NK.x, PK.x) || max(NK.x, PK.x)))
+    // Where NK.x = own netAccessKey x-coordinate, PK.x = peer netAccessKey x-coordinate
+    // Reference: hostapd src/common/dpp_crypto.c dpp_derive_pmkid()
+
+    // Get own netAccessKey x-coordinate (Controller's netAccessKey)
+    std::vector<uint8_t> own_nak_x = DppCryptoHelper::get_pubkey_x_coordinate(
+        m_keystore.controller_net_access_key());
+
+    // Get peer netAccessKey x-coordinate (Agent's netAccessKey) - BEFORE freeing agent_nak
+    std::vector<uint8_t> peer_nak_x = DppCryptoHelper::get_pubkey_x_coordinate(agent_nak);
+
+    // Compute 1905 PMK: N = controller_nak_private * agent_nak_public
+    std::vector<uint8_t> N_x = DppCryptoHelper::ecdh(m_keystore.controller_net_access_key(),
+                                                        agent_nak);
+
+    // Store agent_nak as enrollee_protocol_key so add_bss_config_response_tlvs can sign
+    // connectors using the agent's netAccessKey. Ownership transferred — do not free.
+    session->enrollee_protocol_key = agent_nak;
+    agent_nak = nullptr;
+
+    if (N_x.empty()) {
+        LOG(ERROR) << "DPP: ECDH for 1905 PMK failed";
+        return false;
+    }
+
+    LOG(INFO) << "DPP: ECDH shared secret N.x = " << DppCryptoHelper::to_hex(N_x.data(), 32);
+
+    // 1905 PMK = HKDF(<>, "DPP PMK", N.x)
+    if (!DppCryptoHelper::hkdf(N_x, "DPP PMK", session->pmk_1905.data(), 32)) {
+        LOG(ERROR) << "DPP: 1905 PMK derivation failed";
+        return false;
+    }
+    session->pmk_1905_valid = true;
+
+    // Persist PMK in Agent DB so it can be reused after agent reconnect
+    auto agent_entry = m_database.m_agents.get(agent_mac);
+    if (agent_entry) {
+        agent_entry->pmk_1905       = session->pmk_1905;
+        agent_entry->pmk_1905_valid = true;
+        LOG(INFO) << "DPP: PMK stored in Agent DB for " << agent_mac;
+    }
+
+    LOG(INFO) << "DPP: Derived PMK = " << DppCryptoHelper::to_hex(session->pmk_1905.data(), 32);
+
+    // Build PMKID input: min(NK.x, PK.x) || max(NK.x, PK.x)
+    std::vector<uint8_t> pmkid_input;
+    if (own_nak_x.size() == 32 && peer_nak_x.size() == 32) {
+        if (memcmp(own_nak_x.data(), peer_nak_x.data(), 32) < 0) {
+            // own < peer: min=own, max=peer
+            pmkid_input.insert(pmkid_input.end(), own_nak_x.begin(), own_nak_x.end());
+            pmkid_input.insert(pmkid_input.end(), peer_nak_x.begin(), peer_nak_x.end());
+        } else {
+            // peer <= own: min=peer, max=own
+            pmkid_input.insert(pmkid_input.end(), peer_nak_x.begin(), peer_nak_x.end());
+            pmkid_input.insert(pmkid_input.end(), own_nak_x.begin(), own_nak_x.end());
+        }
+
+        // Calculate PMKID = Truncate-128(SHA-256(input))
+        uint8_t pmkid_hash[32];
+        DppCryptoHelper::sha256(pmkid_input.data(), pmkid_input.size(), pmkid_hash);
+
+        LOG(DEBUG) << "DPP: PMKID = " << DppCryptoHelper::to_hex(pmkid_hash, 16);
+    } else {
+        LOG(WARNING) << "DPP: Failed to extract netAccessKey x-coordinates for PMKID calculation";
+    }
+
+    session->state = eDppSessionState::PMK_1905_ESTABLISHED;
+    LOG(INFO) << "DPP: 1905 PMK established with " << agent_mac;
+    LOG(INFO) << "DPP: PMK (from Peer Discovery) = " << DppCryptoHelper::to_hex(session->pmk_1905.data(), 32);
+
+    // Build and send Peer Discovery Response
+    // Per hostapd wpa_supplicant/dpp_supplicant.c, the response must contain:
+    //   1. DPP_ATTR_TRANSACTION_ID (echo from request)
+    //   2. DPP_ATTR_STATUS = DPP_STATUS_OK  ← mandatory, checked before Connector
+    //   3. DPP_ATTR_CONNECTOR (Controller's connector)
+    std::vector<uint8_t> response_frame = build_dpp_action_header(DPP_PA_PEER_DISCOVERY_RESPONSE);
+
+    // Transaction ID (echo from request)
+    uint16_t trans_id_len = 0;
+    const uint8_t *trans_id_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_TRANSACTION_ID,
+                                                  &trans_id_len);
+    if (trans_id_val && trans_id_len > 0) {
+        append_dpp_attr(response_frame, DPP_ATTR_TRANSACTION_ID, trans_id_val, trans_id_len);
+    }
+
+    // Status = DPP_STATUS_OK (mandatory — hostapd fails with "missing_status" without this)
+    uint8_t status_ok = DPP_STATUS_OK;
+    append_dpp_attr(response_frame, DPP_ATTR_STATUS, &status_ok, 1);
+
+    // Controller's 1905 Connector
+    const std::string &connector = m_keystore.controller_connector();
+    if (!connector.empty()) {
+        append_dpp_attr(response_frame, DPP_ATTR_CONNECTOR,
+                        reinterpret_cast<const uint8_t *>(connector.data()),
+                        static_cast<uint16_t>(connector.size()));
+    }
+
+    // Send Peer Discovery Response
+    LOG(ERROR) << "DPP: sending Peer Discovery Response to " << agent_mac
+               << " connector_len=" << connector.size()
+               << " response_len=" << response_frame.size();
+    if (!send_direct_encap_dpp(agent_mac, response_frame)) {
+        LOG(ERROR) << "DPP: failed to send Peer Discovery Response to " << agent_mac;
+        return false;
+    }
+
+    LOG(DEBUG) << "DPP: waiting 500ms before sending EAPOL M1 to " << agent_mac;
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+
+    return initiate_1905_4way_handshake(agent_mac, *session);
+}
+
+bool DppConfiguratorTask::handle_peer_discovery_response(const sMacAddr &agent_mac,
+                                                           const uint8_t *frame, size_t len)
+{
+    LOG(INFO) << "DPP: Peer Discovery Response from " << agent_mac;
+
+    // Parse attributes (after Action[1] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1] = 7 bytes)
+    if (len < 7) return false;
+    const uint8_t *attrs = frame + 7;
+    size_t attrs_len     = len - 7;
+
+    // Extract Agent's Connector
+    uint16_t connector_len = 0;
+    const uint8_t *connector_val = find_dpp_attr(attrs, attrs_len, DPP_ATTR_CONNECTOR,
+                                                   &connector_len);
+    if (!connector_val || connector_len == 0) {
+        LOG(ERROR) << "DPP: Peer Discovery Response missing Connector";
+        return false;
+    }
+
+    std::string agent_connector(reinterpret_cast<const char *>(connector_val), connector_len);
+
+    // Verify Connector signature
+    if (!DppCryptoHelper::verify_connector(agent_connector, m_keystore.C_sign_key())) {
+        LOG(ERROR) << "DPP: Agent Connector signature verification failed";
+        return false;
+    }
+
+    // Parse Connector to get netRole and netAccessKey
+    std::string net_role, group_id, expiry;
+    EVP_PKEY *agent_nak = nullptr;
+    if (!DppCryptoHelper::parse_connector(agent_connector, net_role, group_id, &agent_nak,
+                                           expiry)) {
+        LOG(ERROR) << "DPP: failed to parse Agent Connector";
+        return false;
+    }
+
+    if (net_role != "mapAgent") {
+        LOG(ERROR) << "DPP: Agent Connector netRole=" << net_role << " (expected mapAgent)";
+        EVP_PKEY_free(agent_nak);
+        return false;
+    }
+
+    // Find session
+    auto *session = get_session_by_agent(agent_mac);
+    if (!session) {
+        LOG(WARNING) << "DPP: Peer Discovery Response with no active session for " << agent_mac;
+        // Create a minimal session for the 4-way handshake
+        std::array<uint8_t, 32> dummy_hash{};
+        session = create_session(agent_mac, agent_mac, dummy_hash, {}, false);
+        if (!session) {
+            EVP_PKEY_free(agent_nak);
+            return false;
+        }
+    }
+
+    // Compute 1905 PMK: N = controller_nak_private * agent_nak_public
+    std::vector<uint8_t> N_x = DppCryptoHelper::ecdh(m_keystore.controller_net_access_key(),
+                                                        agent_nak);
+
+    // Store agent_nak as enrollee_protocol_key so BSS Config Response can sign connectors.
+    session->enrollee_protocol_key = agent_nak;
+    agent_nak = nullptr;
+
+    if (N_x.empty()) {
+        LOG(ERROR) << "DPP: ECDH for 1905 PMK failed";
+        return false;
+    }
+
+    // 1905 PMK = HKDF(<>, "DPP PMK", N.x)
+    if (!DppCryptoHelper::hkdf(N_x, "DPP PMK", session->pmk_1905.data(), 32)) {
+        LOG(ERROR) << "DPP: 1905 PMK derivation failed";
+        return false;
+    }
+
+    session->state = eDppSessionState::PMK_1905_ESTABLISHED;
+    LOG(INFO) << "DPP: 1905 PMK established with " << agent_mac;
+
+    // Persist PMK in Agent DB so it can be reused after agent reconnect
+    auto agent_entry = m_database.m_agents.get(agent_mac);
+    if (agent_entry) {
+        agent_entry->pmk_1905       = session->pmk_1905;
+        agent_entry->pmk_1905_valid = true;
+        LOG(INFO) << "DPP: PMK stored in Agent DB for " << agent_mac;
+    }
+
+    LOG(INFO) << "DPP: sending EAPOL M1 immediately to " << agent_mac;
+    return initiate_1905_4way_handshake(agent_mac, *session);
+}
+
+bool DppConfiguratorTask::handle_eapol_m1_as_supplicant(const sMacAddr &agent_mac,
+                                                          sDppSession &session,
+                                                          const uint8_t *eapol_frame,
+                                                          size_t len)
+{
+    LOG(INFO) << "DPP: M1 from " << agent_mac << " — responding as Supplicant";
+
+    if (!session.pmk_1905_valid) {
+        LOG(ERROR) << "DPP: M1 Supplicant: no valid PMK for " << agent_mac;
+        return false;
+    }
+
+    // Extract ANonce from M1 (offset 17, 32 bytes)
+    if (len < 49) { LOG(ERROR) << "DPP: M1 too short"; return false; }
+    memcpy(session.a_nonce.data(), eapol_frame + 17, 32);
+
+    // Generate fresh SNonce
+    std::array<uint8_t, 32> s_nonce;
+    DppCryptoHelper::random_bytes(s_nonce.data(), 32);
+
+    // Derive PTK (Supplicant: AA=agent (Authenticator), SPA=controller)
+    const uint8_t *aa  = agent_mac.oct;
+    const uint8_t *spa = m_database.get_local_bridge_mac().oct;
+    std::array<uint8_t, 64> ptk_64;
+    if (!DppCryptoHelper::kdf_sha256_512(session.pmk_1905, "Pairwise key expansion",
+                                          aa, spa, session.a_nonce, s_nonce, ptk_64)) {
+        LOG(ERROR) << "DPP: M1 Supplicant: PTK derivation failed";
+        return false;
+    }
+    memcpy(session.ptk_1905.data(), ptk_64.data(), 32);
+    memcpy(session.tk_1905.data(),  ptk_64.data() + 32, 32);
+
+    // Replay counter from M1 (offset 9, 8 bytes BE)
+    uint64_t replay_counter = 0;
+    for (int i = 0; i < 8; i++)
+        replay_counter = (replay_counter << 8) | eapol_frame[9 + i];
+
+    // Build M2
+    std::vector<uint8_t> m2 = build_eapol_key_m2(s_nonce, ptk_64, replay_counter);
+    if (m2.empty()) return false;
+
+    session.state = eDppSessionState::PMK_1905_ESTABLISHED;
+    if (!send_1905_encap_eapol(agent_mac, m2)) return false;
+
+    LOG(INFO) << "DPP: M2 sent to " << agent_mac << " [Supplicant role]";
+    return true;
+}
+
+bool DppConfiguratorTask::handle_eapol_m3_as_supplicant(const sMacAddr &agent_mac,
+                                                          sDppSession &session,
+                                                          const uint8_t *eapol_frame,
+                                                          size_t len)
+{
+    LOG(INFO) << "DPP: M3 from " << agent_mac << " [Supplicant role — sending M4]";
+
+    // Verify MIC using KCK = ptk_1905[0:16]
+    if (!verify_eapol_mic(eapol_frame, len, session.ptk_1905.data())) {
+        LOG(ERROR) << "DPP: M3 Supplicant: MIC verification failed from " << agent_mac;
+        return false;
+    }
+
+    // Build and send M4
+    uint64_t replay_counter = 0;
+    if (len >= 17) {
+        for (int i = 0; i < 8; i++)
+            replay_counter = (replay_counter << 8) | eapol_frame[9 + i];
+    }
+    std::vector<uint8_t> m4 = build_eapol_key_m4_supplicant(session.ptk_1905, replay_counter);
+    if (m4.empty() || !send_1905_encap_eapol(agent_mac, m4)) {
+        LOG(ERROR) << "DPP: M3 Supplicant: failed to send M4";
+        return false;
+    }
+
+    // Install keys
+    session.enc_tx_counter = 1;
+    session.enc_rx_counter = 0;
+    session.int_rx_counter = 0;
+    session.state          = eDppSessionState::ONBOARDING_DONE;
+
+    if (m_broker_client) {
+        if (!m_broker_client->install_security_key(
+                agent_mac, session.tk_1905, m_gtk, m_gtk_key_id, true)) {
+            LOG(ERROR) << "DPP: M3 Supplicant: failed to install keys for " << agent_mac;
+        } else {
+            LOG(INFO) << "DPP: M3 Supplicant: keys installed for " << agent_mac;
+            auto agent = m_database.m_agents.get(agent_mac);
+            if (agent) {
+                agent->dpp_security_required = false;
+                agent->tk_1905_installed     = true;
+            }
+        }
+    }
+
+    LOG(INFO) << "DPP: M4 sent, 4-way complete with " << agent_mac << " [Supplicant role]";
+    // Agent List is sent after BSS Config Result (per EasyMesh Figure 17),
+    // not here — the extender will send BSS Config Request after receiving Agent List.
+    return true;
+}
+
+bool DppConfiguratorTask::initiate_1905_4way_handshake(const sMacAddr &agent_mac,
+                                                         sDppSession &session)
+{
+    LOG(INFO) << "DPP: initiating 1905 4-way handshake with " << agent_mac;
+
+    // Generate ANonce
+    DppCryptoHelper::random_bytes(session.a_nonce.data(), 32);
+
+    // Build EAPOL-Key M1
+    std::vector<uint8_t> m1 = build_eapol_key_m1(session.a_nonce);
+    return send_1905_encap_eapol(agent_mac, m1);
+}
+
+bool DppConfiguratorTask::handle_eapol_m2(const sMacAddr &agent_mac, sDppSession &session,
+                                            const uint8_t *eapol_frame, size_t len)
+{
+    LOG(DEBUG) << "DPP: processing EAPOL M2 from " << agent_mac;
+
+    // Dump full M2 frame for analysis
+    LOG(DEBUG) << "DPP: M2 frame length = " << len << " bytes";
+    LOG(DEBUG) << "DPP: M2 frame hex dump:";
+    for (size_t i = 0; i < len; i += 32) {
+        size_t chunk_len = std::min(size_t(32), len - i);
+        LOG(DEBUG) << "  [" << i << "] " << DppCryptoHelper::to_hex(eapol_frame + i, chunk_len);
+    }
+
+    // Parse Key Info to check for encryption flag
+    if (len >= 7) {
+        uint16_t key_info = (static_cast<uint16_t>(eapol_frame[5]) << 8) | eapol_frame[6];
+        bool encrypted_key_data = (key_info >> 12) & 1;
+        LOG(DEBUG) << "DPP: M2 Key Info = 0x" << std::hex << key_info << std::dec;
+        LOG(DEBUG) << "DPP: M2 Encrypted Key Data flag = " << (encrypted_key_data ? "YES" : "NO");
+    }
+
+    // Parse Key Data Length
+    if (len >= 99) {
+        uint16_t key_data_len = (static_cast<uint16_t>(eapol_frame[97]) << 8) | eapol_frame[98];
+        LOG(DEBUG) << "DPP: M2 Key Data Length = " << key_data_len << " bytes";
+        if (key_data_len > 0 && len >= static_cast<size_t>(99 + key_data_len)) {
+            LOG(DEBUG) << "DPP: M2 Key Data hex dump:";
+            for (size_t i = 0; i < static_cast<size_t>(key_data_len); i += 32) {
+                size_t chunk_len = std::min(size_t(32), static_cast<size_t>(key_data_len) - i);
+                LOG(DEBUG) << "  [" << i << "] " << DppCryptoHelper::to_hex(eapol_frame + 99 + i, chunk_len);
+            }
+        }
+    }
+
+    // Extract SNonce from M2 (offset 17 in EAPOL-Key frame)
+    std::array<uint8_t, 32> s_nonce;
+    if (!extract_snonce(eapol_frame, len, s_nonce)) {
+        LOG(ERROR) << "DPP: failed to extract SNonce from M2";
+        return false;
+    }
+
+    // Extract Replay Counter from M2 (offset 9-16, 8 bytes)
+    uint64_t replay_counter = 0;
+    if (len >= 17) {
+        for (int i = 0; i < 8; i++) {
+            replay_counter = (replay_counter << 8) | eapol_frame[9 + i];
+        }
+        LOG(DEBUG) << "DPP: M2 Replay Counter = " << replay_counter;
+    }
+
+    // Derive 1905 PTK using SHA256-PRF-512 (matches agent's libwpa2 sha256_prf)
+    const uint8_t *aa  = m_database.get_local_bridge_mac().oct; // Controller AL MAC
+    const uint8_t *spa = agent_mac.oct;                          // Agent AL MAC
+
+    LOG(DEBUG) << "DPP: PTK derivation inputs:";
+    LOG(DEBUG) << "  AA (Controller AL MAC) = " << DppCryptoHelper::to_hex(aa, 6);
+    LOG(DEBUG) << "  SPA (Agent AL MAC) = " << DppCryptoHelper::to_hex(spa, 6);
+    LOG(DEBUG) << "  ANonce = " << DppCryptoHelper::to_hex(session.a_nonce.data(), 32);
+    LOG(DEBUG) << "  SNonce = " << DppCryptoHelper::to_hex(s_nonce.data(), 32);
+    LOG(INFO) << "DPP: PMK (used for PTK derivation) = " << DppCryptoHelper::to_hex(session.pmk_1905.data(), 32);
+
+    // Use kdf_sha256_512 to derive 64-byte PTK (matches agent's sha256_prf)
+    std::array<uint8_t, 64> ptk_64;
+    if (!DppCryptoHelper::kdf_sha256_512(session.pmk_1905, "Pairwise key expansion",
+                                          aa, spa, session.a_nonce, s_nonce, ptk_64)) {
+        LOG(ERROR) << "DPP: PTK derivation failed";
+        return false;
+    }
+
+    LOG(DEBUG) << "DPP: PTK derivation output:";
+    LOG(DEBUG) << "  PTK (64 bytes) = " << DppCryptoHelper::to_hex(ptk_64.data(), 64);
+
+    // Extract KCK, KEK, TK from 64-byte PTK
+    // For DPP with 32-byte PMK: KCK=PTK[0:16], KEK=PTK[16:32], TK=PTK[32:64]
+    memcpy(session.ptk_1905.data(), ptk_64.data(), 32); // Store first 32 bytes for KCK/KEK
+    memcpy(session.tk_1905.data(), ptk_64.data() + 32, 32); // TK = PTK[32:64]
+
+    LOG(DEBUG) << "DPP: Extracted keys:";
+    LOG(DEBUG) << "  KCK (16 bytes) = " << DppCryptoHelper::to_hex(ptk_64.data(), 16);
+    LOG(DEBUG) << "  KEK (16 bytes) = " << DppCryptoHelper::to_hex(ptk_64.data() + 16, 16);
+    LOG(DEBUG) << "  TK (32 bytes) = " << DppCryptoHelper::to_hex(session.tk_1905.data(), 32);
+
+    // Verify MIC in M2 using KCK (first 16 bytes of PTK for DPP)
+    if (!verify_eapol_mic(eapol_frame, len, session.ptk_1905.data())) {
+        LOG(ERROR) << "DPP: M2 MIC verification failed";
+        return false;
+    }
+
+    // Generate GTK if not already done
+    if (!m_gtk_valid) {
+        DppCryptoHelper::random_bytes(m_gtk.data(), 32);
+        m_gtk_key_id = 1;
+        m_gtk_valid  = true;
+        LOG(INFO) << "DPP: generated new 1905 GTK";
+    }
+
+    // Build and send M3 (replay counter must be > M2's counter)
+    // Per WPA spec, Authenticator increments replay counter for each new message
+    // Use the 64-byte PTK we already derived for M3
+    std::vector<uint8_t> m3 = build_eapol_key_m3(session.a_nonce, s_nonce, ptk_64,
+                                                   m_gtk, m_gtk_key_id, replay_counter + 1);
+    return send_1905_encap_eapol(agent_mac, m3);
+}
+
+bool DppConfiguratorTask::handle_eapol_m4(const sMacAddr &agent_mac, sDppSession &session,
+                                            const uint8_t *eapol_frame, size_t len)
+{
+    LOG(DEBUG) << "DPP: processing EAPOL M4 from " << agent_mac;
+
+    // Verify MIC
+    if (!verify_eapol_mic(eapol_frame, len, session.ptk_1905.data())) {
+        LOG(ERROR) << "DPP: M4 MIC verification failed";
+        return false;
+    }
+
+    // Install keys
+    session.enc_tx_counter = 1;
+    session.enc_rx_counter = 0;
+    session.int_rx_counter = 0;
+    session.state          = eDppSessionState::ONBOARDING_DONE;
+
+    LOG(INFO) << "DPP: 1905 4-way handshake complete with " << agent_mac;
+
+    // Install keys in transport layer via broker
+    if (m_broker_client) {
+        // Log TK for debugging (first 16 bytes only for security)
+        LOG(ERROR) << "DPP: TK for " << agent_mac << " = "
+                   << std::hex << std::setfill('0')
+                   << std::setw(2) << (int)session.tk_1905[0]
+                   << std::setw(2) << (int)session.tk_1905[1]
+                   << std::setw(2) << (int)session.tk_1905[2]
+                   << std::setw(2) << (int)session.tk_1905[3]
+                   << std::setw(2) << (int)session.tk_1905[4]
+                   << std::setw(2) << (int)session.tk_1905[5]
+                   << std::setw(2) << (int)session.tk_1905[6]
+                   << std::setw(2) << (int)session.tk_1905[7]
+                   << std::setw(2) << (int)session.tk_1905[8]
+                   << std::setw(2) << (int)session.tk_1905[9]
+                   << std::setw(2) << (int)session.tk_1905[10]
+                   << std::setw(2) << (int)session.tk_1905[11]
+                   << std::setw(2) << (int)session.tk_1905[12]
+                   << std::setw(2) << (int)session.tk_1905[13]
+                   << std::setw(2) << (int)session.tk_1905[14]
+                   << std::setw(2) << (int)session.tk_1905[15]
+                   << "..." << std::dec;
+
+        if (!m_broker_client->install_security_key(
+                agent_mac, session.tk_1905, m_gtk, m_gtk_key_id, true)) {
+            LOG(ERROR) << "DPP: Failed to install 1905 security keys in transport for agent " << agent_mac;
+        } else {
+            LOG(INFO) << "DPP: Installed 1905 security keys in transport for agent " << agent_mac;
+            auto agent = m_database.m_agents.get(agent_mac);
+            if (agent) {
+                agent->dpp_security_required = false;
+                agent->tk_1905_installed     = true;
+                LOG(INFO) << "DPP: 1905 link encrypted for " << agent_mac;
+            }
+        }
+    } else {
+        LOG(WARNING) << "DPP: Broker client not available - keys not installed for " << agent_mac;
+    }
+
+    LOG(INFO) << "DPP: Agent " << agent_mac << " 4-way handshake complete";
+
+    // Per EasyMesh Figure 17: Agent List is sent after BSS Config Result,
+    // not after 4-way handshake. BSS Config Request/Response/Result follow.
+    return true;
+}
+
+// ============================================================================
+// Agent List + CCE Indication
+// ============================================================================
+
+bool DppConfiguratorTask::send_agent_list_message(const sMacAddr &dest_mac)
+{
+    LOG(INFO) << "DPP: sending Agent List to newly onboarded agent " << dest_mac;
+
+    // Per EasyMesh Figure 17: the Agent List message is sent only to the newly onboarded
+    // Enrollee Multi-AP Agent (the one that just sent BSS Configuration Result). The
+    // Agent List TLV itself lists all OTHER agents in the network — the local (gateway)
+    // agent is excluded because it shares its AL MAC with the Controller itself, so
+    // including it as a network "agent" entry would be misleading/duplicate.
+    const auto &all_agents = m_database.m_agents;
+    size_t agent_count = 0;
+    for (const auto &src_pair : all_agents) {
+        if (!src_pair.second->is_gateway) ++agent_count;
+    }
+    if (agent_count == 0) return true;
+
+    auto cmdu_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::AGENT_LIST_MESSAGE);
+    if (!cmdu_header) return false;
+
+    auto agent_list_tlv = m_cmdu_tx.addClass<wfa_map::tlvAgentList>();
+    if (!agent_list_tlv) return false;
+
+    if (!agent_list_tlv->alloc_agents(agent_count)) return false;
+
+    size_t idx = 0;
+    for (const auto &src_pair : all_agents) {
+        const auto &src_mac   = src_pair.first;
+        const auto &src_agent = src_pair.second;
+        if (src_agent->is_gateway) continue;
+
+        auto entry = agent_list_tlv->agents(idx++);
+        if (!std::get<0>(entry)) continue;
+        auto &e    = std::get<1>(entry);
+        e.al_mac   = src_mac;
+        e.multi_ap_profile =
+            static_cast<wfa_map::tlvAgentList::eMultiApProfile>(src_agent->profile);
+        e.security = src_agent->tk_1905_installed
+                         ? wfa_map::tlvAgentList::IEEE1905_ENABLED
+                         : wfa_map::tlvAgentList::IEEE1905_NOT_ENABLED;
+    }
+
+    return son_actions::send_cmdu_to_agent(dest_mac, m_cmdu_tx, m_database);
+}
+
+bool DppConfiguratorTask::send_dpp_cce_indication(bool advertise)
+{
+    for (const auto &agent_pair : m_database.m_agents) {
+            const auto &agent_mac = agent_pair.first;
+            auto cmdu_header =
+            m_cmdu_tx.create(0, ieee1905_1::eMessageType::DPP_CCE_INDICATION_MESSAGE);
+        if (!cmdu_header) continue;
+
+        auto cce_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppCceIndication>();
+        if (!cce_tlv) continue;
+
+        cce_tlv->advertise_cee() = advertise ? wfa_map::tlvDppCceIndication::eAdvertiseCee::ENABLE : wfa_map::tlvDppCceIndication::eAdvertiseCee::DISABLE;
+        son_actions::send_cmdu_to_agent(agent_mac, m_cmdu_tx, m_database);
+    }
+    return true;
+}
+
+// ============================================================================
+// Frame send helpers
+// ============================================================================
+
+bool DppConfiguratorTask::send_dpp_frame(const sDppSession &session,
+                                          const std::vector<uint8_t> &frame, bool is_gas)
+{
+    // For Auth Request frames (non-GAS, DPP frame type 0x00 at frame[6]),
+    // include the chirp hash in a tlvDppChirpValue (0xD3) so the Agent
+    // can cache the Auth Request and replay it when needed.
+    // The chirp hash = session.bootstrap_hash = SHA-256("chirp" || DER).
+    const std::array<uint8_t, 32> *chirp_hash = nullptr;
+    if (!is_gas && frame.size() > 6 &&
+        frame[6] == DPP_PA_AUTHENTICATION_REQUEST) {
+        chirp_hash = &session.bootstrap_hash;
+    }
+
+    if (session.is_wired) {
+        return send_direct_encap_dpp(session.enrollee_mac, frame, chirp_hash);
+    } else {
+        return send_proxied_encap_dpp(session.proxy_agent_mac, session.enrollee_mac,
+                                       frame, is_gas, chirp_hash);
+    }
+}
+
+bool DppConfiguratorTask::send_proxied_encap_dpp(const sMacAddr &proxy_mac,
+                                                   const sMacAddr &enrollee_mac,
+                                                   const std::vector<uint8_t> &frame, bool is_gas,
+                                                   const std::array<uint8_t, 32> *chirp_hash)
+{
+    auto cmdu_header =
+        m_cmdu_tx.create(0, ieee1905_1::eMessageType::PROXIED_ENCAP_DPP_MESSAGE);
+    if (!cmdu_header) return false;
+
+    auto encap_tlv = m_cmdu_tx.addClass<wfa_map::tlv1905EncapDpp>();
+    if (!encap_tlv) return false;
+
+    // Only set enrollee_mac_address_present when the MAC is non-zero.
+    // Per EasyMesh §17.2.79: if the Enrollee MAC is unknown (all-zeros),
+    // enrollee_mac_address_present shall be 0 and dest_sta_mac is absent.
+    static const sMacAddr zero_mac = {};
+    bool mac_present = (enrollee_mac != zero_mac);
+    encap_tlv->frame_flags().enrollee_mac_address_present = mac_present ? 1 : 0;
+    if (mac_present) {
+        encap_tlv->set_dest_sta_mac(enrollee_mac);
+    }
+    encap_tlv->frame_flags().dpp_frame_indicator = is_gas ? 1 : 0;
+    // The agent's handle_proxied_encap_dpp_from_controller identifies GAS frames by
+    // checking frame_type == 0xFF (a sentinel it uses internally — not the spec-defined
+    // GAS_FRAME=0x1).  Use 0xFF here so the agent routes the Config Response correctly
+    // to WLAN_PA_GAS_INITIAL_RESP (0x0B) instead of WLAN_PA_VENDOR_SPECIFIC (0x09).
+    encap_tlv->frame_type() = is_gas
+        ? static_cast<wfa_map::tlv1905EncapDpp::eFrameType>(0xFF)
+        : wfa_map::tlv1905EncapDpp::DPP_PUBLIC_ACTION_FRAME;
+
+    // Per EasyMesh spec, the 1905 encapsulated frame contains the raw 802.11 frame
+    // (GAS or DPP Public Action) without any TCP type byte prefix.
+    // The TCP type byte is only used in the TCP wire format between hostapd and agent,
+    // NOT in the 1905 encapsulation.
+    if (!encap_tlv->alloc_encapsulated_frame(frame.size())) return false;
+    memcpy(encap_tlv->encapsulated_frame(), frame.data(), frame.size());
+
+    LOG(DEBUG) << "DPP: send_proxied_encap_dpp"
+               << " mid=0x" << std::hex << m_cmdu_tx.getMessageId()
+               << " msg_type=0x8029"
+               << std::dec
+               << " dst=" << proxy_mac
+               << " enrollee=" << enrollee_mac
+               << " is_gas=" << is_gas
+               << " frame_len=" << frame.size()
+               << " enrollee_mac_present=" << (mac_present ? 1 : 0);
+
+    // Add tlvDppChirpValue (0xD3) when a chirp hash is provided (Auth Request frames).
+    // The Proxy Agent uses this TLV to cache the Auth Request keyed by the chirp hash,
+    // enabling replay when hostapd reconnects after a Presence Announcement on a new radio.
+    if (chirp_hash) {
+        auto chirp_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppChirpValue>();
+        if (chirp_tlv) {
+            chirp_tlv->flags().hash_validity              = true;
+            chirp_tlv->flags().enrollee_mac_address_present = false;
+            if (chirp_tlv->set_hash(chirp_hash->data(), 32)) {
+                chirp_tlv->hash_length() = 32;
+                LOG(DEBUG) << "DPP: added tlvDppChirpValue (0xD3) to PROXIED_ENCAP_DPP_MESSAGE"
+                           << " hash=" << DppCryptoHelper::to_hex(chirp_hash->data(), 8) << "...";
+            }
+        }
+    }
+
+    return son_actions::send_cmdu_to_agent(proxy_mac, m_cmdu_tx, m_database);
+}
+
+bool DppConfiguratorTask::send_direct_encap_dpp(const sMacAddr &agent_mac,
+                                                  const std::vector<uint8_t> &frame,
+                                                  const std::array<uint8_t, 32> *chirp_hash)
+{
+    auto cmdu_header =
+        m_cmdu_tx.create(0, ieee1905_1::eMessageType::DIRECT_ENCAP_DPP_MESSAGE);
+    if (!cmdu_header) return false;
+
+    auto dpp_msg_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppMessage>();
+    if (!dpp_msg_tlv) return false;
+
+    if (!dpp_msg_tlv->alloc_dpp_frame(frame.size())) return false;
+    memcpy(dpp_msg_tlv->dpp_frame(), frame.data(), frame.size());
+
+    LOG(DEBUG) << "DPP: send_direct_encap_dpp"
+               << " mid=0x" << std::hex << m_cmdu_tx.getMessageId()
+               << " msg_type=0x802A"
+               << std::dec
+               << " dst=" << agent_mac
+               << " frame_len=" << frame.size();
+
+    // Add tlvDppChirpValue (0xD3) when a chirp hash is provided (Auth Request frames).
+    // The Agent uses this TLV to match the Auth Request to the correct DPP session
+    // and cache it for replay if needed (wired DPP onboarding per EasyMesh §5.3.5).
+    if (chirp_hash) {
+        auto chirp_tlv = m_cmdu_tx.addClass<wfa_map::tlvDppChirpValue>();
+        if (chirp_tlv) {
+            chirp_tlv->flags().hash_validity              = true;
+            chirp_tlv->flags().enrollee_mac_address_present = false;
+            if (chirp_tlv->alloc_hash(32)) {
+                memcpy(chirp_tlv->hash(), chirp_hash->data(), 32);
+                LOG(DEBUG) << "DPP: added tlvDppChirpValue (0xD3) to DIRECT_ENCAP_DPP_MESSAGE"
+                           << " hash=" << DppCryptoHelper::to_hex(chirp_hash->data(), 8) << "...";
+            }
+        }
+    }
+
+    return son_actions::send_cmdu_to_agent(agent_mac, m_cmdu_tx, m_database);
+}
+
+bool DppConfiguratorTask::send_1905_encap_eapol(const sMacAddr &agent_mac,
+                                                  const std::vector<uint8_t> &eapol_frame)
+{
+    auto cmdu_header =
+        m_cmdu_tx.create(0, ieee1905_1::eMessageType::IEEE1905_ENCAP_EAPOL_MESSAGE);
+    if (!cmdu_header) return false;
+
+    auto eapol_tlv = m_cmdu_tx.addClass<wfa_map::tlv1905EncapEapol>();
+    if (!eapol_tlv) return false;
+
+    if (!eapol_tlv->alloc_payload(eapol_frame.size())) return false;
+    memcpy(eapol_tlv->payload(), eapol_frame.data(), eapol_frame.size());
+
+    return son_actions::send_cmdu_to_agent(agent_mac, m_cmdu_tx, m_database);
+}
+
+// ============================================================================
+// DPP frame builders
+// ============================================================================
+
+std::vector<uint8_t> DppConfiguratorTask::build_dpp_action_header(uint8_t frame_type)
+{
+    // Action[1] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1] = 7 bytes
+    // Per EasyMesh §17.2.79: encapsulated frame starts from the Action field (0x09)
+    // Per 802.11: Action = 0x09 (Vendor Specific Public Action)
+    return {0x09, 0x50, 0x6F, 0x9A, 0x1A, 0x01, frame_type};
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_dpp_attr(uint16_t id, const uint8_t *value,
+                                                           uint16_t len)
+{
+    std::vector<uint8_t> attr(4 + len);
+    attr[0] = id & 0xFF;
+    attr[1] = (id >> 8) & 0xFF;
+    attr[2] = len & 0xFF;
+    attr[3] = (len >> 8) & 0xFF;
+    if (value && len > 0) memcpy(attr.data() + 4, value, len);
+    return attr;
+}
+
+void DppConfiguratorTask::append_dpp_attr(std::vector<uint8_t> &frame, uint16_t id,
+                                           const uint8_t *value, uint16_t len)
+{
+    auto attr = build_dpp_attr(id, value, len);
+    frame.insert(frame.end(), attr.begin(), attr.end());
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_auth_request_frame(const sDppSession &session)
+{
+    if (!session.initiator_protocol_key) return {};
+
+    // Get uncompressed PI (64 bytes: x || y)
+    std::vector<uint8_t> pi_uncompressed = DppCryptoHelper::get_uncompressed_pubkey(
+        session.initiator_protocol_key);
+    if (pi_uncompressed.size() < 65) {
+        LOG(ERROR) << "DPP: build_auth_request_frame: failed to get uncompressed PI key";
+        return {};
+    }
+    const uint8_t *pi_xy = pi_uncompressed.data() + 1; // skip 04 prefix
+
+    // Compute BR hash = SHA-256(DER(SubjectPublicKeyInfo(BR)))
+    // Per Easy Connect §6.3.2: DPP_ATTR_R_BOOTSTRAP_KEY_HASH = SHA-256(DER) — no "chirp" prefix.
+    // Note: session.bootstrap_hash is the CHIRP hash (SHA-256("chirp" || DER)) used only for
+    // Presence Announcement matching. The Auth Request needs the plain SHA-256(DER).
+    std::array<uint8_t, 32> br_hash_computed = {};
+    if (session.enrollee_bootstrap_key_der.empty() ||
+        !DppCryptoHelper::sha256(session.enrollee_bootstrap_key_der.data(),
+                                  session.enrollee_bootstrap_key_der.size(),
+                                  br_hash_computed.data())) {
+        LOG(ERROR) << "DPP: build_auth_request_frame: failed to compute BR hash";
+        return {};
+    }
+    const uint8_t *br_hash = br_hash_computed.data();
+
+    // Get bootstrapping hash of Controller (BI hash)
+    const uint8_t *bi_hash = m_keystore.bootstrapping_hash().data();
+
+    LOG(DEBUG) << "DPP: Auth Request BR_hash (enrollee): "
+               << DppCryptoHelper::to_hex(br_hash, 32);
+    LOG(DEBUG) << "DPP: Auth Request BI_hash (controller): "
+               << DppCryptoHelper::to_hex(bi_hash, 32);
+
+    // Build inner wrapped data: {I-nonce, I-capabilities}k1
+    std::vector<uint8_t> inner_plain;
+    append_dpp_attr(inner_plain, DPP_ATTR_I_NONCE, session.i_nonce.data(), 16);
+    uint8_t caps = DPP_CAPABILITIES_CONFIGURATOR;
+    append_dpp_attr(inner_plain, DPP_ATTR_I_CAPABILITIES, &caps, 1);
+
+    // Build frame header: Action(0x09) + OUI(50:6F:9A) + OUI_Type(0x1A) + CryptoSuite(0x01) + FrameType
+    std::vector<uint8_t> header = build_dpp_action_header(DPP_PA_AUTHENTICATION_REQUEST);
+
+    // AAD for AES-SIV per Easy Connect §6.3.2:
+    // AD1 = OUI header (6 bytes: OUI+OUI_Type+CryptoSuite+FrameType), NOT including Action byte
+    std::vector<uint8_t> oui_header(header.begin() + 1, header.end());
+
+    // Pre-build attrs before wrapped data (for AAD)
+    std::vector<uint8_t> pre_attrs;
+    append_dpp_attr(pre_attrs, DPP_ATTR_R_BOOTSTRAP_HASH, br_hash, 32);
+    append_dpp_attr(pre_attrs, DPP_ATTR_I_BOOTSTRAP_HASH, bi_hash, 32);
+    append_dpp_attr(pre_attrs, DPP_ATTR_I_PROTOCOL_KEY, pi_xy, 64);
+    // DPP Protocol Version = 3 (DPP3 / EasyMesh Profile-3).
+    // Required so extender's hostapd sets auth->peer_version=3, which triggers
+    // DPP Protocol Version = 2 per EasyMesh v6.1 §5.3.3.
+    // qca-ezmesh hostapd defaults to version 2; version 3 causes Auth Request rejection.
+    // peer_version >= 2 is sufficient to trigger connect_on_tx_status in hostapd so that
+    // DPP_PA_CONFIGURATION_RESULT is sent automatically after the GAS exchange.
+    uint8_t dpp_version = 2;
+    append_dpp_attr(pre_attrs, DPP_ATTR_PROTOCOL_VERSION, &dpp_version, 1);
+
+    std::vector<uint8_t> wrapped = DppCryptoHelper::aes_siv_encrypt(
+        session.k1.data(), 32, inner_plain, {oui_header, pre_attrs});
+
+    if (wrapped.empty()) {
+        LOG(ERROR) << "DPP: build_auth_request_frame: AES-SIV encrypt of {I-nonce, I-caps}k1 failed";
+        return {};
+    }
+
+    // Build complete frame (starts with Action byte per EasyMesh §17.2.79)
+    std::vector<uint8_t> frame = header;
+    frame.insert(frame.end(), pre_attrs.begin(), pre_attrs.end());
+    append_dpp_attr(frame, DPP_ATTR_WRAPPED_DATA, wrapped.data(),
+                    static_cast<uint16_t>(wrapped.size()));
+
+    return frame;
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_auth_confirm_frame(const sDppSession &session,
+                                                                     bool success)
+{
+    std::vector<uint8_t> header = build_dpp_action_header(DPP_PA_AUTHENTICATION_CONFIRM);
+
+    // AAD for AES-SIV per Easy Connect §6.3.4:
+    // AD1 = OUI header (6 bytes), NOT including Action byte (frame[0]=0x09)
+    std::vector<uint8_t> oui_header(header.begin() + 1, header.end());
+
+    uint8_t status_val = success ? DPP_STATUS_OK : DPP_STATUS_AUTH_FAILURE;
+
+    std::vector<uint8_t> frame = header;
+    append_dpp_attr(frame, DPP_ATTR_STATUS, &status_val, 1);
+    // Compute BR hash = SHA-256(DER) — no "chirp" prefix, per Easy Connect §6.3.4
+    std::array<uint8_t, 32> br_hash_confirm = {};
+    if (!session.enrollee_bootstrap_key_der.empty()) {
+        DppCryptoHelper::sha256(session.enrollee_bootstrap_key_der.data(),
+                                 session.enrollee_bootstrap_key_der.size(),
+                                 br_hash_confirm.data());
+    }
+    append_dpp_attr(frame, DPP_ATTR_R_BOOTSTRAP_HASH, br_hash_confirm.data(), 32);
+    // DPP_ATTR_I_BOOTSTRAP_HASH is only included for mutual authentication (when the Enrollee
+    // also has the Controller's bootstrapping public key). In the EasyMesh DPP flow the Enrollee
+    // does NOT have the Controller's bootstrap key, so mutual auth is not used and the attribute
+    // must be omitted. Including it causes "Initiator Bootstrapping Key Hash mismatch" on the
+    // Enrollee side because auth->peer_bi is NULL (hostapd dpp_auth_conf_rx line 1890).
+    // Per Easy Connect §6.3.4: include I_BOOTSTRAP_HASH only if mutual authentication is used.
+
+    if (!success) {
+        // Per Easy Connect §6.3.4: on failure, Wrapped Data = {R-nonce}k2
+        // This mirrors hostapd dpp_auth_build_conf() failure path (dpp_auth.c:1095-1109).
+        std::vector<uint8_t> pre_attrs_fail;
+        append_dpp_attr(pre_attrs_fail, DPP_ATTR_STATUS, &status_val, 1);
+        append_dpp_attr(pre_attrs_fail, DPP_ATTR_R_BOOTSTRAP_HASH, br_hash_confirm.data(), 32);
+
+        std::vector<uint8_t> r_nonce_plain;
+        append_dpp_attr(r_nonce_plain, DPP_ATTR_R_NONCE, session.r_nonce.data(), 16);
+
+        std::vector<uint8_t> wrapped = DppCryptoHelper::aes_siv_encrypt(
+            session.k2.data(), 32, r_nonce_plain, {oui_header, pre_attrs_fail});
+
+        if (!wrapped.empty()) {
+            append_dpp_attr(frame, DPP_ATTR_WRAPPED_DATA, wrapped.data(),
+                            static_cast<uint16_t>(wrapped.size()));
+        } else {
+            LOG(ERROR) << "DPP: build_auth_confirm_frame: AES-SIV encrypt of {R-nonce}k2 failed";
+        }
+    } else {
+        // Per Easy Connect §6.3.4: on success, Wrapped Data = {I-auth}ke
+        // Compute I-auth = H(R-nonce | I-nonce | PR.x | PI.x | BR.x | 1)
+
+        // Get PR.x — Enrollee's protocol key x-coordinate (skip 04 prefix)
+        std::vector<uint8_t> pr_unc = DppCryptoHelper::get_uncompressed_pubkey(
+            session.enrollee_protocol_key);
+        // Get PI.x — Controller's (Initiator) protocol key x-coordinate
+        std::vector<uint8_t> pi_unc = DppCryptoHelper::get_uncompressed_pubkey(
+            session.initiator_protocol_key);
+        // Get BR.x — Enrollee's bootstrap key x-coordinate (import from DER)
+        std::vector<uint8_t> br_unc;
+        {
+            EVP_PKEY *br_key = DppCryptoHelper::import_ec_key_der(
+                session.enrollee_bootstrap_key_der.data(),
+                session.enrollee_bootstrap_key_der.size());
+            if (br_key) {
+                br_unc = DppCryptoHelper::get_uncompressed_pubkey(br_key);
+                EVP_PKEY_free(br_key);
+            }
+        }
+        // Get BI.x — Controller's bootstrapping key x-coordinate
+        std::vector<uint8_t> bi_unc = DppCryptoHelper::get_uncompressed_pubkey(
+            m_keystore.bootstrapping_key());
+
+        if (pr_unc.size() >= 65 && pi_unc.size() >= 65 &&
+            br_unc.size() >= 65 && bi_unc.size() >= 65) {
+
+            // Build input: R-nonce(16) | I-nonce(16) | PR.x(32) | PI.x(32) | BR.x(32) | 1
+            // Per Easy Connect §6.3.4: BI.x is only included if mutual authentication is used
+            // (i.e., the Responder also has the Initiator's bootstrap key). In the EasyMesh DPP
+            // flow the Enrollee does NOT have the Controller's bootstrap key, so auth->peer_bi
+            // is NULL on the Enrollee side and dpp_gen_i_auth() sets bix=NULL → BI.x omitted.
+            // Including BI.x here would cause "Mismatching Initiator Authenticating Tag".
+            std::vector<uint8_t> i_auth_input;
+            i_auth_input.insert(i_auth_input.end(),
+                                session.r_nonce.begin(), session.r_nonce.end());
+            i_auth_input.insert(i_auth_input.end(),
+                                session.i_nonce.begin(), session.i_nonce.end());
+            i_auth_input.insert(i_auth_input.end(), pr_unc.begin() + 1, pr_unc.begin() + 33);
+            i_auth_input.insert(i_auth_input.end(), pi_unc.begin() + 1, pi_unc.begin() + 33);
+            i_auth_input.insert(i_auth_input.end(), br_unc.begin() + 1, br_unc.begin() + 33);
+            // BI.x omitted — no mutual authentication in EasyMesh DPP flow
+            i_auth_input.push_back(0x01);
+
+            uint8_t i_auth_tag[32];
+            if (DppCryptoHelper::sha256(i_auth_input.data(), i_auth_input.size(), i_auth_tag)) {
+                // Wrap {I-auth}ke with AES-SIV
+                // AAD = DPP header (6 bytes) + all attrs before Wrapped Data
+                std::vector<uint8_t> pre_attrs;
+                append_dpp_attr(pre_attrs, DPP_ATTR_STATUS, &status_val, 1);
+                append_dpp_attr(pre_attrs, DPP_ATTR_R_BOOTSTRAP_HASH,
+                                br_hash_confirm.data(), 32);
+                // I_BOOTSTRAP_HASH omitted (no mutual auth in EasyMesh DPP flow)
+
+                std::vector<uint8_t> i_auth_plain;
+                append_dpp_attr(i_auth_plain, DPP_ATTR_I_AUTH_TAG, i_auth_tag, 32);
+
+                std::vector<uint8_t> wrapped = DppCryptoHelper::aes_siv_encrypt(
+                    session.ke.data(), 32, i_auth_plain, {oui_header, pre_attrs});
+
+                if (!wrapped.empty()) {
+                    append_dpp_attr(frame, DPP_ATTR_WRAPPED_DATA, wrapped.data(),
+                                    static_cast<uint16_t>(wrapped.size()));
+                } else {
+                    LOG(ERROR) << "DPP: build_auth_confirm_frame: AES-SIV encrypt of {I-auth}ke failed";
+                }
+            } else {
+                LOG(ERROR) << "DPP: build_auth_confirm_frame: SHA-256 for I-auth tag failed";
+            }
+        } else {
+            LOG(ERROR) << "DPP: build_auth_confirm_frame: failed to extract key coordinates for I-auth"
+                       << " pr=" << pr_unc.size() << " pi=" << pi_unc.size()
+                       << " br=" << br_unc.size() << " bi=" << bi_unc.size();
+        }
+    }
+
+    return frame;
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_peer_discovery_request()
+{
+    std::vector<uint8_t> header = build_dpp_action_header(DPP_PA_PEER_DISCOVERY_REQUEST);
+
+    // Transaction ID (1 byte)
+    uint8_t trans_id = 1;
+    std::vector<uint8_t> frame = header;
+    append_dpp_attr(frame, DPP_ATTR_TRANSACTION_ID, &trans_id, 1);
+
+    // Controller's 1905 Connector
+    const std::string &connector = m_keystore.controller_connector();
+    if (!connector.empty()) {
+        append_dpp_attr(frame, DPP_ATTR_CONNECTOR,
+                        reinterpret_cast<const uint8_t *>(connector.data()),
+                        static_cast<uint16_t>(connector.size()));
+    }
+
+    return frame;
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_gas_response_frame(
+    uint8_t status, const std::vector<uint8_t> &payload)
+{
+    // GAS Initial Response for 1905 encapsulation (per EasyMesh spec):
+    // The Category byte (0x04) is NOT included in the 1905 encapsulated frame.
+    // Frame starts with: Action(1) + DialogToken(1) + StatusCode(2) +
+    //                    GASComebackDelay(2) + AdvProto(var) + QueryRespLen(2) + QueryResp
+    std::vector<uint8_t> frame;
+
+    // Action=0x0B (GAS Initial Response) - Category byte NOT included per EasyMesh spec
+    frame.push_back(0x0B);
+    frame.push_back(0x00); // Dialog Token
+
+    // Status Code (2 bytes LE)
+    frame.push_back(0x00);
+    frame.push_back(0x00);
+
+    // GAS Comeback Delay (2 bytes LE) = 0
+    frame.push_back(0x00);
+    frame.push_back(0x00);
+
+    // Advertisement Protocol element (802.11-2016 §9.4.2.26):
+    // Element ID (0x6C) + Length + Advertisement Protocol Tuple
+    // Advertisement Protocol Tuple: Query Response Info + Advertisement Protocol ID
+    // For DPP: Query Response Info (0x00) + Vendor Specific (0xDD) + Length (0x05) + OUI (50:6F:9A) + OUI Type (0x1A) + DPP Version (0x01)
+    static const uint8_t adv_proto[] = {
+        0x6C,       // Element ID: Advertisement Protocol
+        0x08,       // Length: 8 bytes
+        0x00,       // Query Response Info (no PAME-BI)
+        0xDD,       // Advertisement Protocol ID: Vendor Specific
+        0x05,       // Vendor Specific Content Length
+        0x50, 0x6F, 0x9A,  // OUI: Wi-Fi Alliance
+        0x1A,       // OUI Type: DPP
+        0x01        // DPP Protocol Version
+    };
+    frame.insert(frame.end(), adv_proto, adv_proto + sizeof(adv_proto));
+
+    // Query Response Length (2 bytes LE)
+    uint16_t qr_len = static_cast<uint16_t>(payload.size());
+    frame.push_back(qr_len & 0xFF);
+    frame.push_back((qr_len >> 8) & 0xFF);
+
+    // Query Response (DPP attributes)
+    frame.insert(frame.end(), payload.begin(), payload.end());
+
+    return frame;
+}
+
+// ============================================================================
+// EAPOL-Key frame builders
+// ============================================================================
+
+std::vector<uint8_t> DppConfiguratorTask::build_eapol_key_m1(
+    const std::array<uint8_t, 32> &anonce)
+{
+    // EAPOL-Key frame layout (per struct wpa_eapol_key in hostapd/src/common/wpa_common.h):
+    // Offset  0: EAPOL Version (1)
+    // Offset  1: EAPOL Type    (1) = 0x03 (Key)
+    // Offset  2: EAPOL Length  (2) = 95   (big-endian, body after 4-byte header)
+    // Offset  4: Key Descriptor Type (1)
+    // Offset  5: Key Info      (2)
+    // Offset  7: Key Length    (2)
+    // Offset  9: Replay Counter(8)
+    // Offset 17: Key Nonce     (32)
+    // Offset 49: Key IV        (16)
+    // Offset 65: Key RSC       (8)
+    // Offset 73: Reserved      (8)
+    // Offset 81: Key MIC       (16)
+    // Offset 97: Key Data Len  (2)
+    // Total: 99 bytes
+    std::vector<uint8_t> frame(99, 0);
+
+    frame[0] = 0x02; // EAPOL version 2
+    frame[1] = 0x03; // EAPOL-Key
+    // EAPOL Length = total(99) - header(4) = 95
+    frame[2] = 0x00;
+    frame[3] = 0x5F; // 95
+
+    frame[4] = 0x02; // Descriptor Type: RSN
+    // Key Info: Pairwise=1, ACK=1, Version=0 (AKM-defined for DPP)
+    // 0x0088 = Pairwise(bit3) | ACK(bit7) | Version=0
+    uint16_t key_info = 0x0088;
+    frame[5] = (key_info >> 8) & 0xFF;
+    frame[6] = key_info & 0xFF;
+
+    // Key Length = 32 (AES-256)
+    frame[7] = 0x00;
+    frame[8] = 0x20;
+
+    // Replay Counter (8 bytes at offset 9-16) = 1
+    frame[16] = 0x01;
+
+    // ANonce (32 bytes at offset 17)
+    memcpy(frame.data() + 17, anonce.data(), 32);
+
+    // Key MIC at offset 81 = 0 (no MIC in M1)
+    // Key Data Length at offset 97-98 = 0 (no Key Data in M1)
+
+    return frame;
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_eapol_key_m2(
+    const std::array<uint8_t, 32> &snonce,
+    const std::array<uint8_t, 64> &ptk,
+    uint64_t replay_counter)
+{
+    // EAPOL-Key M2: Supplicant→Authenticator with SNonce + MIC
+    // key_info = 0x0108 = Pairwise(bit3) | MIC(bit8)
+    std::vector<uint8_t> frame(99, 0);
+
+    frame[0] = 0x02; frame[1] = 0x03;
+    uint16_t eapol_len = 95;
+    frame[2] = (eapol_len >> 8) & 0xFF; frame[3] = eapol_len & 0xFF;
+    frame[4] = 0x02; // RSN descriptor
+    uint16_t key_info = 0x0108;
+    frame[5] = (key_info >> 8) & 0xFF; frame[6] = key_info & 0xFF;
+    frame[7] = 0x00; frame[8] = 0x20; // Key Length=32
+
+    // Replay counter = same as M1
+    for (int i = 7; i >= 0; i--)
+        frame[9 + (7-i)] = (replay_counter >> (i*8)) & 0xFF;
+
+    // SNonce at offset 17
+    memcpy(frame.data() + 17, snonce.data(), 32);
+    // Key Data Length = 0
+    frame[97] = 0; frame[98] = 0;
+
+    // MIC using KCK=ptk[0:16]: zero the MIC field, compute, write back
+    uint8_t saved_mic[16];
+    memcpy(saved_mic, frame.data() + 81, 16);
+    memset(frame.data() + 81, 0, 16);
+    uint8_t mic[32] = {};
+    DppCryptoHelper::hmac_sha256(ptk.data(), 16, frame.data(), frame.size(), mic);
+    memcpy(frame.data() + 81, mic, 16);
+    (void)saved_mic;
+    memcpy(frame.data() + 81, mic, 16);
+
+    return frame;
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_eapol_key_m4_supplicant(
+    const std::array<uint8_t, 32> &ptk_kck,
+    uint64_t replay_counter)
+{
+    // M4: key_info=0x0308 Pairwise+MIC+Secure, no Key Data
+    std::vector<uint8_t> frame(99, 0);
+    frame[0] = 0x02; frame[1] = 0x03;
+    uint16_t eapol_len = 95;
+    frame[2] = (eapol_len >> 8) & 0xFF; frame[3] = eapol_len & 0xFF;
+    frame[4] = 0x02;
+    uint16_t key_info = 0x0308;
+    frame[5] = (key_info >> 8) & 0xFF; frame[6] = key_info & 0xFF;
+    frame[7] = 0x00; frame[8] = 0x20;
+    for (int i = 7; i >= 0; i--)
+        frame[9 + (7-i)] = (replay_counter >> (i*8)) & 0xFF;
+    // MIC: zero field, compute, write back
+    memset(frame.data() + 81, 0, 16);
+    uint8_t mic[32] = {};
+    DppCryptoHelper::hmac_sha256(ptk_kck.data(), 16, frame.data(), frame.size(), mic);
+    memcpy(frame.data() + 81, mic, 16);
+    return frame;
+}
+
+std::vector<uint8_t> DppConfiguratorTask::build_eapol_key_m3(
+    const std::array<uint8_t, 32> &anonce, const std::array<uint8_t, 32> &snonce,
+    const std::array<uint8_t, 64> &ptk, const std::array<uint8_t, 32> &gtk, uint8_t gtk_key_id,
+    uint64_t replay_counter)
+{
+    // Build 1905 GTK KDE (EasyMesh v6.1 §5.3.7.3 Tables 11 and 12)
+    // KDE format: Type(1) + Length(1) + OUI(3) + DataType(1) + KeyID(1) + GTK(32)
+    // (single KeyID header byte, no separate Reserved byte, per MAP_KEY_DATA_GROUPKEY)
+    // OUI = 50:6F:9A (Wi-Fi Alliance), DataType = 0x00 (1905 GTK KDE)
+    // Table 12: KeyID bits 0-1 = Key ID, bits 2-7 = Reserved
+    std::vector<uint8_t> gtk_kde;
+    gtk_kde.push_back(0xDD);                    // Type: Vendor Specific
+    gtk_kde.push_back(0x25);                    // Length: 37 bytes (5 header + 32 GTK)
+    gtk_kde.push_back(0x50);                    // OUI: 50:6F:9A (EasyMesh 1905 GTK KDE)
+    gtk_kde.push_back(0x6F);
+    gtk_kde.push_back(0x9A);
+    gtk_kde.push_back(0x00);                    // Data Type: 0x00 (1905 GTK KDE per Table 11)
+    gtk_kde.push_back(gtk_key_id & 0x03);       // Key ID (bits 0-1); bits 2-7 Reserved
+    gtk_kde.insert(gtk_kde.end(), gtk.begin(), gtk.end()); // GTK (32 bytes)
+
+    // Pad to AES block size (16 bytes) - GTK KDE is 39 bytes, needs 9 bytes padding
+    // Padding format: 0xDD followed by zeros
+    size_t pad_len = (16 - (gtk_kde.size() % 16)) % 16;
+    if (pad_len > 0) {
+        gtk_kde.push_back(0xDD);
+        for (size_t i = 1; i < pad_len; i++) {
+            gtk_kde.push_back(0x00);
+        }
+    }
+
+    // Encrypt Key Data using KEK = PTK[16:32] (AES-WRAP)
+    // For DPP: KEK = PTK[16:32] (16 bytes)
+    const uint8_t *kek = ptk.data() + 16;
+    std::vector<uint8_t> encrypted_key_data = DppCryptoHelper::aes_wrap(kek, 16, gtk_kde);
+
+    if (encrypted_key_data.empty()) {
+        LOG(ERROR) << "DPP: AES-WRAP encryption of GTK KDE failed";
+        // Fall back to unencrypted (should not happen in production)
+        encrypted_key_data = gtk_kde;
+    }
+
+    // Build M3 frame: 99 bytes header + encrypted Key Data
+    size_t key_data_len = encrypted_key_data.size();
+    size_t frame_len = 99 + key_data_len;
+    std::vector<uint8_t> frame(frame_len, 0);
+
+    frame[0] = 0x02;
+    frame[1] = 0x03;
+    // EAPOL Length = frame_len - 4 (EAPOL header)
+    uint16_t eapol_len = frame_len - 4;
+    frame[2] = (eapol_len >> 8) & 0xFF;
+    frame[3] = eapol_len & 0xFF;
+
+    frame[4] = 0x02; // Descriptor Type: RSN
+    // Key Info: Pairwise=1, Install=1, ACK=1, MIC=1, Secure=1, Encrypted Key Data=1, Version=0
+    // 0x13C8 = Pairwise(bit3)|Install(bit6)|ACK(bit7)|MIC(bit8)|Secure(bit9)|Enc(bit12)|Version=0
+    uint16_t key_info = 0x13C8;
+    frame[5] = (key_info >> 8) & 0xFF;
+    frame[6] = key_info & 0xFF;
+
+    frame[7] = 0x00;
+    frame[8] = 0x20; // Key Length = 32
+
+    // Replay Counter (big-endian, 8 bytes at offset 9-16)
+    for (int i = 7; i >= 0; i--) {
+        frame[9 + (7 - i)] = (replay_counter >> (i * 8)) & 0xFF;
+    }
+
+    // ANonce at offset 17
+    memcpy(frame.data() + 17, anonce.data(), 32);
+
+    // Key Data Length at offset 97-98
+    frame[97] = (key_data_len >> 8) & 0xFF;
+    frame[98] = key_data_len & 0xFF;
+
+    // Key Data at offset 99
+    memcpy(frame.data() + 99, encrypted_key_data.data(), key_data_len);
+
+    // Compute MIC using KCK = PTK[0:16] (DPP KCK = PMK/2 = 16 bytes)
+    // MIC is computed over the entire frame with MIC field zeroed
+    uint8_t mic[32] = {0};
+    DppCryptoHelper::hmac_sha256(ptk.data(), 16, frame.data(), frame.size(), mic);
+    memcpy(frame.data() + 81, mic, 16); // MIC at offset 81
+
+    return frame;
+}
+
+// ============================================================================
+// EAPOL-Key parsing helpers
+// ============================================================================
+
+uint8_t DppConfiguratorTask::get_eapol_key_msg_num(const uint8_t *eapol_frame, size_t len)
+{
+    if (!eapol_frame || len < 7) return 0;
+
+    // EAPOL-Key: Version(1) + Type(1) + Length(2) + DescType(1) + KeyInfo(2)
+    uint16_t key_info = (static_cast<uint16_t>(eapol_frame[5]) << 8) | eapol_frame[6];
+
+    bool pairwise = (key_info >> 3) & 1;
+    bool install  = (key_info >> 6) & 1;
+    bool ack      = (key_info >> 7) & 1;
+    bool mic      = (key_info >> 8) & 1;
+    bool secure   = (key_info >> 9) & 1;
+
+    if (pairwise && !install && ack && !mic && !secure) return 1; // M1
+    if (pairwise && !install && !ack && mic && !secure) return 2; // M2
+    if (pairwise && install && ack && mic && secure) return 3;    // M3
+    if (pairwise && !install && !ack && mic && secure) return 4;  // M4
+
+    return 0;
+}
+
+bool DppConfiguratorTask::extract_snonce(const uint8_t *eapol_frame, size_t len,
+                                          std::array<uint8_t, 32> &snonce)
+{
+    // SNonce is at offset 17 in EAPOL-Key frame (after header)
+    if (!eapol_frame || len < 49) return false;
+    memcpy(snonce.data(), eapol_frame + 17, 32);
+    return true;
+}
+
+bool DppConfiguratorTask::verify_eapol_mic(const uint8_t *eapol_frame, size_t len,
+                                             const uint8_t *kck)
+{
+    // Minimum frame size: 4 (EAPOL header) + 77 (wpa_eapol_key) + 16 (MIC) + 2 (DataLen) = 99
+    if (!eapol_frame || len < 99 || !kck) return false;
+
+    // For DPP (AKM-defined, PMK=32 bytes):
+    //   KCK = PTK[0:16] (wpa_kck_len(DPP, 32) = 32/2 = 16 bytes)
+    //   MIC = first 16 bytes of HMAC-SHA256(KCK[0:16], frame_with_mic_zeroed)
+    // See hostapd src/common/wpa_common.c rsn_eapol_key_mic_hash()
+    const size_t kck_len = 16; // DPP KCK = PMK/2 = 16 bytes
+
+    // MIC is at offset 81 (4 EAPOL header + 77 wpa_eapol_key struct), length 16
+    // Extract received MIC before zeroing
+    uint8_t received_mic[16];
+    memcpy(received_mic, eapol_frame + 81, 16);
+
+    // Zero out MIC field, compute HMAC, compare
+    std::vector<uint8_t> frame_copy(eapol_frame, eapol_frame + len);
+    memset(frame_copy.data() + 81, 0, 16);
+
+    uint8_t computed_mic[32];
+    DppCryptoHelper::hmac_sha256(kck, kck_len, frame_copy.data(), frame_copy.size(), computed_mic);
+
+    LOG(DEBUG) << "DPP: MIC verification:";
+    LOG(DEBUG) << "  KCK (16 bytes) = " << DppCryptoHelper::to_hex(kck, 16);
+    LOG(DEBUG) << "  Received MIC   = " << DppCryptoHelper::to_hex(received_mic, 16);
+    LOG(DEBUG) << "  Computed MIC   = " << DppCryptoHelper::to_hex(computed_mic, 16);
+    LOG(DEBUG) << "  Frame length   = " << len;
+
+    bool match = memcmp(computed_mic, received_mic, 16) == 0;
+    LOG(DEBUG) << "  MIC match      = " << (match ? "YES" : "NO");
+
+    return match;
+}
+
+// ============================================================================
+// DPP frame parsing helpers
+// ============================================================================
+
+uint8_t DppConfiguratorTask::get_dpp_frame_type(const uint8_t *frame, size_t len)
+{
+    // DPP frame: Action[1] + OUI[3] + OUI_Type[1] + CryptoSuite[1] + FrameType[1] = 7 bytes
+    // Per EasyMesh §17.2.79: encapsulated frame starts from the Action field
+    if (!frame || len < 7) return 0xFF;
+
+    // Validate Action byte: must be 0x09 (Vendor Specific Public Action)
+    if (frame[0] != 0x09) {
+        LOG(WARNING) << "DPP: get_dpp_frame_type: missing Action byte"
+                     << " (expected 0x09, got 0x" << std::hex << (int)frame[0] << std::dec
+                     << ") — returning 0xFF";
+        return 0xFF;
+    }
+
+    // Validate OUI header: OUI[1-3]=50:6F:9A, OUI_Type[4]=0x1A, CryptoSuite[5]=0x01
+    // Per Wi-Fi Easy Connect §8.2.1
+    static const uint8_t expected_oui[] = {0x50, 0x6F, 0x9A, 0x1A, 0x01};
+    if (memcmp(frame + 1, expected_oui, sizeof(expected_oui)) != 0) {
+        LOG(WARNING) << "DPP: get_dpp_frame_type: invalid OUI header"
+                     << " (expected 50:6F:9A 0x1A 0x01) — returning 0xFF";
+        return 0xFF;
+    }
+
+    return frame[6];
+}
+
+bool DppConfiguratorTask::is_gas_frame(const uint8_t *frame, size_t len)
+{
+    if (!frame || len < 1) return false;
+    // Per EasyMesh §17.2.79: encapsulated frame starts from the Action field (no Category byte).
+    // GAS Initial Request Action = 0x0A, GAS Comeback Request Action = 0x0C.
+    return frame[0] == 0x0A || frame[0] == 0x0C;
+}
+
+const uint8_t *DppConfiguratorTask::find_dpp_attr(const uint8_t *attrs, size_t attrs_len,
+                                                    uint16_t attr_id, uint16_t *attr_len)
+{
+    if (!attrs || attrs_len < 4) return nullptr;
+
+    size_t offset = 0;
+    while (offset + 4 <= attrs_len) {
+        uint16_t id  = attrs[offset] | (static_cast<uint16_t>(attrs[offset + 1]) << 8);
+        uint16_t len = attrs[offset + 2] | (static_cast<uint16_t>(attrs[offset + 3]) << 8);
+
+        if (id == attr_id) {
+            if (attr_len) *attr_len = len;
+            if (offset + 4 + len <= attrs_len) {
+                return attrs + offset + 4;
+            }
+            return nullptr;
+        }
+        offset += 4 + len;
+    }
+    return nullptr;
+}
+
+// ============================================================================
+// Session management
+// ============================================================================
+
+DppConfiguratorTask::sDppSession *DppConfiguratorTask::create_session(
+    const sMacAddr &enrollee_mac, const sMacAddr &proxy_mac,
+    const std::array<uint8_t, 32> &hash, const std::vector<uint8_t> &enrollee_bs_key_der,
+    bool is_wired)
+{
+    auto session                       = std::make_unique<sDppSession>();
+    session->enrollee_mac              = enrollee_mac;
+    session->proxy_agent_mac           = proxy_mac;
+    session->bootstrap_hash            = hash;
+    session->enrollee_bootstrap_key_der = enrollee_bs_key_der;
+    session->is_wired                  = is_wired;
+    session->last_activity             = std::chrono::steady_clock::now();
+
+    auto *ptr        = session.get();
+    m_sessions[hash] = std::move(session);
+    return ptr;
+}
+
+DppConfiguratorTask::sDppSession *DppConfiguratorTask::get_session_by_hash(
+    const std::array<uint8_t, 32> &hash)
+{
+    auto it = m_sessions.find(hash);
+    return (it != m_sessions.end()) ? it->second.get() : nullptr;
+}
+
+DppConfiguratorTask::sDppSession *DppConfiguratorTask::get_session_by_agent(
+    const sMacAddr &agent_mac)
+{
+    for (auto &session_pair : m_sessions) {
+        auto &session = session_pair.second;
+        if (session->proxy_agent_mac == agent_mac || session->enrollee_mac == agent_mac) {
+            return session.get();
+        }
+    }
+    return nullptr;
+}
+
+void DppConfiguratorTask::cleanup_session(const std::array<uint8_t, 32> &hash)
+{
+    auto it = m_sessions.find(hash);
+    if (it != m_sessions.end()) {
+        // Clear dpp_security_required so WSC M2 is not blocked if DPP auth failed.
+        // The extender may retry via WSC after DPP failure.
+        auto agent = m_database.m_agents.get(it->second->enrollee_mac);
+        if (agent && agent->dpp_security_required) {
+            agent->dpp_security_required = false;
+            LOG(INFO) << "DPP: cleanup_session — cleared dpp_security_required for "
+                      << it->second->enrollee_mac << " (DPP auth failed, WSC fallback allowed)";
+        }
+        m_sessions.erase(it);
+    }
+}
+
+void DppConfiguratorTask::cleanup_timed_out_sessions()
+{
+    auto now = std::chrono::steady_clock::now();
+    for (auto it = m_sessions.begin(); it != m_sessions.end();) {
+        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
+                           now - it->second->last_activity)
+                           .count();
+        if (elapsed > SESSION_TIMEOUT_SEC) {
+            LOG(WARNING) << "DPP: session timeout for enrollee=" << it->second->enrollee_mac;
+            // Clear dpp_security_required so WSC fallback is not blocked after timeout.
+            auto agent = m_database.m_agents.get(it->second->enrollee_mac);
+            if (agent && agent->dpp_security_required) {
+                agent->dpp_security_required = false;
+                LOG(INFO) << "DPP: timeout — cleared dpp_security_required for "
+                          << it->second->enrollee_mac;
+            }
+            it = m_sessions.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+// ============================================================================
+// Enrollee lookup
+// ============================================================================
+
+bool DppConfiguratorTask::find_enrollee_by_hash(const std::array<uint8_t, 32> &hash,
+                                                  std::vector<uint8_t> &bs_key_der) const
+{
+    auto it = m_uri_cache.find(hash);
+    if (it == m_uri_cache.end()) {
+        LOG(DEBUG) << "DPP: no matching enrollee for chirp hash "
+                   << DppCryptoHelper::to_hex(hash.data(), 8) << "... "
+                   << "(cache has " << m_uri_cache.size() << " entr"
+                   << (m_uri_cache.size() == 1 ? "y" : "ies") << ")";
+        return false;
+    }
+    bs_key_der = it->second;
+    return true;
+}
+
+} // namespace son
