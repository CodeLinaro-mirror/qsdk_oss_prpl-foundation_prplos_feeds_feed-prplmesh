+
+std::string DppConfiguratorTask::generate_1905_layer_config(const sDppSession &session,
+                                                              uint16_t df_counter_threshold) const
+{
+    if (!session.enrollee_protocol_key) return {};
+
+    std::string connector = m_keystore.sign_connector("mapAgent", "mapNW",
+                                                        session.enrollee_protocol_key);
+    if (connector.empty()) return {};
+
+    // Per EasyMesh spec Table 6: the 1905-layer DPP Configuration Object contains only
+    // wi-fi_tech, dfCounterThreshold, and the Credential Object (akm/Connector/csign) —
+    // no "discovery" (ssid/BSSID), "map_bss_type", or "ppKey". qca-ezmesh's hostapd
+    // matches this exactly (dpp_build_conf_start() returns immediately after
+    // dfCounterThreshold for netrole=mapAgent, before the discovery node is added).
+    std::string config = "{\"wi-fi_tech\":\"map\""
+                         ",\"dfCounterThreshold\":" + std::to_string(df_counter_threshold) + ","
+                         "\"cred\":{"
+                         "\"akm\":\"dpp\","
+                         "\"signedConnector\":\"" + connector + "\","
+                         "\"csign\":" + m_keystore.c_sign_key_jwk() +
+                         "}}";
+    return config;
+}
