+
+#ifndef _DPP_KEY_STORE_H_
+#define _DPP_KEY_STORE_H_
+
+#include "dpp_crypto_helper.h"
+
+#include <array>
+#include <memory>
+#include <string>
+
+namespace son {
+
+/**
+ * @brief DPP Key Store
+ *
+ * Manages persistent cryptographic key material for the DPP Configurator role.
+ *
+ * Keys are stored as PEM files under a configurable directory (default: /etc/prplmesh/dpp/).
+ * On first boot, all key pairs are generated automatically.
+ * On subsequent boots, keys are loaded from storage.
+ *
+ * Key material managed:
+ *   - c-sign-key / C-sign-key  (Configurator signing key pair)
+ *   - privacy-protection-key   (Reconfiguration privacy key pair)
+ *   - bootstrapping key pair   (DPP Authentication Initiator key)
+ *   - Controller netAccessKey  (1905-layer Network Introduction key)
+ *   - Controller 1905 Connector (JWS, netRole="mapController")
+ *   - Configurator Connector   (JWS, netRole="configurator")
+ */
+class DppKeyStore {
+public:
+    /**
+     * @brief Constructor.
+     * @param storage_dir  Directory for PEM key files (default: /etc/prplmesh/dpp)
+     */
+    explicit DppKeyStore(const std::string &storage_dir = "/etc/prplmesh/dpp");
+
+    ~DppKeyStore();
+
+    // Non-copyable
+    DppKeyStore(const DppKeyStore &) = delete;
+    DppKeyStore &operator=(const DppKeyStore &) = delete;
+
+    /**
+     * @brief Initialize the key store.
+     *
+     * Loads existing keys from storage, or generates new ones if not found.
+     * Also writes pkhash to hostapd config if hostapd_conf_path is set.
+     *
+     * @return true on success
+     */
+    bool init();
+
+    /**
+     * @brief Check if the key store is initialized.
+     */
+    bool is_initialized() const { return m_initialized; }
+
+    // -------------------------------------------------------------------------
+    // Key accessors (read-only)
+    // -------------------------------------------------------------------------
+
+    /** @brief Configurator signing private key (c-sign-key). */
+    const EVP_PKEY *c_sign_key() const { return m_c_sign_key; }
+
+    /** @brief Configurator signing public key (C-sign-key). */
+    const EVP_PKEY *C_sign_key() const { return m_c_sign_key; } // same object, public key accessible
+
+    /** @brief Privacy-protection private key. */
+    const EVP_PKEY *privacy_protection_key() const { return m_privacy_protection_key; }
+
+    /** @brief Privacy-protection public key. */
+    const EVP_PKEY *Privacy_protection_key() const { return m_privacy_protection_key; }
+
+    /** @brief Bootstrapping private key. */
+    const EVP_PKEY *bootstrapping_key() const { return m_bootstrapping_key; }
+
+    /** @brief Controller netAccessKey (for 1905 Network Introduction). */
+    const EVP_PKEY *controller_net_access_key() const { return m_controller_net_access_key; }
+
+    /** @brief Controller's 1905 Connector JWS (netRole="mapController"). */
+    const std::string &controller_connector() const { return m_controller_connector; }
+
+    /** @brief Configurator Connector JWS (netRole="configurator"). */
+    const std::string &configurator_connector() const { return m_configurator_connector; }
+
+    /** @brief JWS kid = base64url(SHA-256(uncompressed(C-sign-key))). */
+    const std::string &kid() const { return m_kid; }
+
+    /** @brief SHA-256 hash of DER(SubjectPublicKeyInfo(Bootstrapping-key)). */
+    const std::array<uint8_t, 32> &bootstrapping_hash() const { return m_bootstrapping_hash; }
+
+    /** @brief Bootstrapping hash as lowercase hex string (for hostapd pkhash). */
+    const std::string &bootstrapping_hash_hex() const { return m_bootstrapping_hash_hex; }
+
+    /** @brief C-sign-key as JWK JSON string. */
+    const std::string &c_sign_key_jwk() const { return m_c_sign_key_jwk; }
+
+    /** @brief Privacy-protection-key as JWK JSON string. */
+    const std::string &privacy_protection_key_jwk() const { return m_privacy_protection_key_jwk; }
+
+    // -------------------------------------------------------------------------
+    // DPP URI persistence
+    // -------------------------------------------------------------------------
+
+    /** @brief Save the DPP Bootstrapping URI to /etc/prplmesh/dpp_uri. */
+    bool save_dpp_uri(const std::string &dpp_uri) const;
+
+    /** @brief Load the DPP Bootstrapping URI from /etc/prplmesh/dpp_uri. */
+    std::string load_dpp_uri() const;
+
+    // -------------------------------------------------------------------------
+    // Connector signing
+    // -------------------------------------------------------------------------
+
+    /**
+     * @brief Sign a DPP Connector (JWS ES256).
+     *
+     * Creates a JWS compact serialization:
+     *   base64url(header) . base64url(payload) . base64url(signature)
+     *
+     * @param net_role          netRole value (e.g. "mapAgent", "mapBackhaulSta")
+     * @param group_id          groupId value (e.g. "mapNW")
+     * @param enrollee_nak      Enrollee's netAccessKey (EC public key)
+     * @param expiry            Optional expiry timestamp (ISO 8601)
+     * @return JWS compact serialization, empty on failure
+     */
+    std::string sign_connector(const std::string &net_role, const std::string &group_id,
+                                const EVP_PKEY *enrollee_nak,
+                                const std::string &expiry = "") const;
+
+private:
+    std::string m_storage_dir;
+    bool m_initialized = false;
+
+    // Key pairs (private + public in same EVP_PKEY object)
+    EVP_PKEY *m_c_sign_key              = nullptr;
+    EVP_PKEY *m_privacy_protection_key  = nullptr;
+    EVP_PKEY *m_bootstrapping_key       = nullptr;
+    EVP_PKEY *m_controller_net_access_key = nullptr;
+
+    // Derived values
+    std::string m_kid;                              // base64url(SHA-256(uncompressed(C-sign-key)))
+    std::array<uint8_t, 32> m_bootstrapping_hash;  // SHA-256(DER(bootstrapping pubkey))
+    std::string m_bootstrapping_hash_hex;           // hex string for hostapd pkhash
+    std::string m_c_sign_key_jwk;                   // C-sign-key as JWK
+    std::string m_privacy_protection_key_jwk;       // Privacy-protection-key as JWK
+
+    // Connectors (JWS compact serialization)
+    std::string m_controller_connector;    // netRole="mapController"
+    std::string m_configurator_connector;  // netRole="configurator"
+
+    // -------------------------------------------------------------------------
+    // Internal helpers
+    // -------------------------------------------------------------------------
+
+    /** @brief Generate all key pairs and save to storage. */
+    bool generate_and_save_all();
+
+    /** @brief Load all key pairs from storage. */
+    bool load_all();
+
+    /** @brief Save a private key to PEM file. */
+    bool save_private_key(const EVP_PKEY *key, const std::string &filename) const;
+
+    /** @brief Load a private key from PEM file. */
+    EVP_PKEY *load_private_key(const std::string &filename) const;
+
+    /** @brief Compute derived values (kid, hashes, JWKs) from loaded keys. */
+    bool compute_derived_values();
+
+    /** @brief Create and sign the Controller and Configurator Connectors. */
+    bool create_connectors();
+
+    /** @brief Save a string to a file. */
+    bool save_string(const std::string &content, const std::string &filename) const;
+
+    /** @brief Load a string from a file. */
+    std::string load_string(const std::string &filename) const;
+
+    /** @brief Check if a file exists. */
+    bool file_exists(const std::string &filename) const;
+
+    /** @brief Ensure the storage directory exists. */
+    bool ensure_storage_dir() const;
+
+    /** @brief Full path for a filename in storage dir. */
+    std::string path(const std::string &filename) const;
+};
+
+} // namespace son
+
+#endif // _DPP_KEY_STORE_H_
