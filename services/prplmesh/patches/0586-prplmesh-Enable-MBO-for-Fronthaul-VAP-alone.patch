-                        }
+                    // MBO and Interworking are enabled on every fronthaul VAP so
+                    // the corresponding IEs appear in all FH beacons and probe
+                    // responses.
+                    conf.set_create_vap_value(vap_id, "interworking", "1");
+                    conf.set_create_vap_value(vap_id, "mbo", "1");
+                    // MBO requires PMF (ieee80211w >= 1) when using WPA2.
+                    // assign_auth_encr_parameters() sets ieee80211w=0 for WPA2PSK,
+                    // which causes hostapd to reject the configuration.
+                    // Upgrade to optional PMF if it is not already enabled;
+                    // WPA3 modes already set ieee80211w=2.
+                    auto current_pmf = conf.get_vap_value(vap_id, "ieee80211w");
+                    if (current_pmf.empty() || current_pmf == "0") {
+                        conf.set_create_vap_value(vap_id, "ieee80211w", "1");
                     }
                 }
+                // Remove stale MBO settings from non-fronthaul BSSes.
+                if (!bss_it.fronthaul) {
+                    conf.set_create_vap_value(vap_id, "interworking", "");
+                    conf.set_create_vap_value(vap_id, "mbo", "");
+                }
                 // Enable hostapd reporting of connection failures
                 conf.set_create_vap_value(vap_id, "report_connection_failures", "1");
                 if (get_hal_conf().enable_cotdma && conf.get_vap_value(vap_id, "deferred_scs") != "1") {
@@ -10696,24 +10697,24 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
                              << m_radio_info.iface_name;
             }
         }
-        if (get_hal_conf().certification_mode) {
-            // MBO and Interworking must be enabled on every fronthaul VAP so that
-            // the MBO IE and Interworking IE appear in beacons/probe-responses for
-            // all FH BSSes, not just the first one that triggers WPS pushbutton setup.
-            LOG(DEBUG) << "certification-mode: "  << get_hal_conf().certification_mode;
-            conf.set_create_vap_value(vap_id, "interworking", "1");
-            conf.set_create_vap_value(vap_id, "mbo", "1");
-            // MBO requires PMF (ieee80211w >= 1) when using WPA2.
-            // assign_auth_encr_parameters() sets ieee80211w=0 for WPA2PSK, which
-            // causes hostapd to reject the config with:
-            //   "MBO: PMF needs to be enabled whenever using WPA2 with MBO"
-            // Upgrade to optional PMF (ieee80211w=1) if not already enabled.
-            // WPA3 modes already set ieee80211w=2, so only WPA2PSK needs fixing.
-            auto current_pmf = conf.get_vap_value(vap_id, "ieee80211w");
-            if (current_pmf.empty() || current_pmf == "0") {
-                conf.set_create_vap_value(vap_id, "ieee80211w", "1");
-            }
-        }
+        // MBO and Interworking are enabled on every fronthaul VAP so the
+        // corresponding IEs appear in all FH beacons and probe responses.
+        conf.set_create_vap_value(vap_id, "interworking", "1");
+        conf.set_create_vap_value(vap_id, "mbo", "1");
+        // MBO requires PMF (ieee80211w >= 1) when using WPA2.
+        // assign_auth_encr_parameters() sets ieee80211w=0 for WPA2PSK,
+        // which causes hostapd to reject the configuration.
+        // Upgrade to optional PMF if it is not already enabled;
+        // WPA3 modes already set ieee80211w=2.
+        auto current_pmf = conf.get_vap_value(vap_id, "ieee80211w");
+        if (current_pmf.empty() || current_pmf == "0") {
+            conf.set_create_vap_value(vap_id, "ieee80211w", "1");
+        }
+    }
+    // Do not carry MBO settings into non-fronthaul BSSes.
+    if (!bss_conf.fronthaul) {
+        conf.set_create_vap_value(vap_id, "interworking", "");
+        conf.set_create_vap_value(vap_id, "mbo", "");
     }
 
     //Enable hostapd reporting of connection failures
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 554c573c5..de677f1a1 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -45,6 +45,35 @@ namespace bpl {
 // ---------------------------------------------------------------------------
 namespace {
 
+// Return the PMF policy that should be persisted alongside the UCI encryption
+// selector.  This mirrors assign_auth_encr_parameters() in the AP HAL while
+// accounting for the PMF policy required by the fronthaul security mode.
+static std::string ieee80211w_for_uci(const std::string &encryption)
+{
+    if (encryption.empty() || encryption == "none") {
+        return "";
+    }
+
+    // Pure WPA3/SAE and SAE-EXT-KEY require PMF.
+    if (encryption == "sae" || encryption == "sae-ext-key" ||
+        encryption == "sae-sae-ext-key") {
+        return "2";
+    }
+
+    // Transition modes use optional PMF.  This also covers WPA2-PSK + SAE-EXT-KEY.
+    if (encryption == "sae-mixed" || encryption == "akm24-sae-mixed" ||
+        encryption.find("gcmp-256") != std::string::npos) {
+        return "1";
+    }
+
+    // Fronthaul WPA2-PSK uses optional PMF because MBO is enabled.
+    if (encryption.find("psk2") == 0) {
+        return "1";
+    }
+
+    return "";
+}
+
 // Map a hostapd key_mgmt token to its 00-0F-AC AKM suite selector byte.
 static bool rsn_km_to_akm(const std::string &km, uint8_t &akm)
 {
@@ -1463,16 +1492,19 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             options["ieee80211k"] = "1";
             options["disabled"] = "0";
 
-            // MBO Interworking related options for AP-mode VAPs.
-            // These are added whenever the Agent applies the M2 credentials to the
-            // /etc/config/wireless wifi-iface section (mode = "ap"), so that the
-            // corresponding IEs (MBO, Interworking) are advertised in beacons.
-            //
-            // Dependency: hostapd requires interworking=1 BEFORE mbo=1 can take effect.
-            // Without interworking=1, hostapd will NOT include the MBO IE in beacons
-            // even when mbo=1 is set.
-            options["interworking"] = "1";  // MUST: prerequisite for MBO IE
-            options["mbo"]          = "1";  // MUST: enables MBO IE in beacons/probe responses
+            // MBO/Interworking apply only to fronthaul BSSes.  Never persist
+            // them on a backhaul BSS: a later
+            // hostapd configuration regeneration can combine mbo=1 with the
+            // WPA2 default ieee80211w=0 and make RELOAD_CONFIG fail.  Persist
+            // the matching PMF policy after selecting the MBO state.
+            if (configuration.fronthaul) {
+                options["interworking"] = "1";
+                options["mbo"]          = "1";
+                options["ieee80211w"] = ieee80211w_for_uci(options["encryption"]);
+            } else {
+                options["interworking"] = "";
+                options["mbo"]          = "";
+            }
 
             // Enable hostapd reporting of connection failures.
             options["report_connection_failures"] = "1";
@@ -1806,15 +1838,17 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             options["ieee80211k"] = "1";
             options["disabled"] = "0";
 
-            // MBO / Interworking related options for AP-mode (MLD) VAPs.
-            // Added when the Agent applies the M2 credentials to the
-            // /etc/config/wireless wifi-iface section (mode = "ap").
-            //
-            // Dependency: hostapd requires interworking=1 BEFORE mbo=1 can take effect.
-            // Without interworking=1, hostapd will NOT include the MBO IE in beacons
-            // even when mbo=1 is set.
-            options["interworking"] = "1";  // MUST: prerequisite for MBO IE
-            options["mbo"]          = "1";  // MUST: enables MBO IE in beacons/probe responses
+            // Keep the MLO/AP path consistent with the non-MLO path above.  MBO
+            // must only be persisted for fronthaul BSSes.  Persist the matching
+            // PMF policy after selecting the MBO state.
+            if (config.fronthaul) {
+                options["interworking"] = "1";
+                options["mbo"]          = "1";
+                options["ieee80211w"] = ieee80211w_for_uci(options["encryption"]);
+            } else {
+                options["interworking"] = "";
+                options["mbo"]          = "";
+            }
 
             // Enable hostapd reporting of connection failures (MLD path).
             options["report_connection_failures"] = "1";
@@ -2186,7 +2220,6 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 	mldOptions["bss_transition"] = "1";
 	mldOptions["ieee80211k"] = "1";
         mldOptions["disabled"] = "0";
