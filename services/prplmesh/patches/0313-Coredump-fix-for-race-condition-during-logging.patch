From 1eb4a0e3c97335281f5cd3ea0cbaff89e6eb580b Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Tue, 4 Aug 2026 14:22:56 +0530
Subject: [PATCH] Coredump fix for race condition during logging

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 common/beerocks/bcl/source/beerocks_logging.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/common/beerocks/bcl/source/beerocks_logging.cpp b/common/beerocks/bcl/source/beerocks_logging.cpp
index af2cff0e6..b2cee1420 100644
--- a/common/beerocks/bcl/source/beerocks_logging.cpp
+++ b/common/beerocks/bcl/source/beerocks_logging.cpp
@@ -13,6 +13,7 @@
 #include <algorithm>
 #include <iostream>
 #include <linux/limits.h>
+#include <mutex>
 #include <unistd.h>
 
 #include <easylogging++.h>
@@ -24,6 +25,9 @@ class RollMonitor : public el::LogDispatchCallback {
 public:
     void enable(bool enable)
     {
+        // Recursive: handle() (below) also calls enable(false) while already
+        // holding this lock when it triggers a roll.
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
         m_enabled = enable;
         if (!m_enabled) {
             m_fsLogFileStream   = nullptr;
@@ -38,6 +42,13 @@ public:
         // DO NOT USE LOGGING HERE! //
         //////////////////////////////
 
+        // Serializes against enable(false), called from logging::apply_settings()
+        // on a log-roll (SIGUSR1), which the easylogging++ configure() path uses
+        // to tear down and rebuild the fstream m_fsLogFileStream points at. Without
+        // this lock, a concurrent handle() on another thread can dereference
+        // m_fsLogFileStream after it has been freed (use-after-free).
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+
         if (!m_enabled) {
             return;
         }
@@ -91,6 +102,7 @@ public:
     }
 
 private:
+    std::recursive_mutex m_mutex;
     el::base::type::fstream_t *m_fsLogFileStream = nullptr;
     std::size_t m_szRollLogFileSize              = 0;
     bool m_enabled                               = true;
-- 
2.34.1

