+bool ap_wlan_hal_nl80211::handle_mld_reconfig(std::string target_ssid, int8_t mld_unit)
+{
+    std::string mld_iface;
+
+    //fetch mld iface name using ssid
+    if (!fetch_mld_iface_by_ssid(target_ssid,mld_iface)) {
+        LOG(ERROR) << " Failed to get mld iface for SSID:" << target_ssid;
+        return false;
+    }
+
+    LOG(INFO) << "MLD_IFACE: " << mld_iface << " SSID:" << target_ssid << " MLD_UNIT:" << mld_unit;
+
+    std::string base_interface="";
+    extractLinkBaseInterface(m_radio_info.iface_name, base_interface);
+
+    // Load hostapd default config for the radio
+    prplmesh::hostapd::Configuration base_conf = load_hostapd_config(m_radio_info.iface_name,"");
+    if (!base_conf) {
+        LOG(ERROR) << "Autoconfiguration: no hostapd config to apply configuration!";
+        return false;
+    }
+
+    if (mld_unit == beerocks::DISABLED_MLDUNIT) {
+        LOG(DEBUG) << " REMOVE MLD LINK";
+
+        const auto vap_iter = 
+            std::find_if(m_radio_info.available_vaps.begin(),m_radio_info.available_vaps.end(),
+                        [&target_ssid](const std::pair<int, bwl::VAPElement> &elem) {
+                            return (elem.second.ssid == target_ssid);
+                        });
+       
+        // check ssid exists in available
+        if (vap_iter != m_radio_info.available_vaps.end()) {
+            auto &vap_info     = vap_iter->second;
+            LOG(INFO) << "REMOVE " << vap_info.bss << "MAC ADDR: "<< vap_info.mac << "AP_MLD_MAC: " << vap_info.ap_mld_mac;
+            
+            if (m_radio_info.iface_name == vap_info.bss) {
+                LOG(ERROR) << "Can't remove management vap which is bss[0]";
+                return false;
+            }
+
+            std::stringstream remove_cmd;
+            remove_cmd << "LINK_REMOVE " << HOST_MIN_ML_RECONF_COUNT;
+
+            LOG(DEBUG) << "CMD framed : " << remove_cmd.str();
+            if (!wpa_ctrl_send_msg(remove_cmd.str(), vap_info.bss)) {
+                LOG(ERROR) << "Failed to remove link of " << vap_info.bss;
+                return false;
+            }
+
+            // remove the fd for this link iface
+            base_wlan_hal_nl80211::remove_interface(vap_info.bss);
+
+            auto &vap_id = base_conf.get_vap_by_bssid(vap_info.mac);
+                LOG(INFO) << "vap_id: " << vap_id;
+            if (vap_id.empty()) {
+                LOG(ERROR) << "Failed to remove bss info from default config";
+                return false;
+            }
+ 
+            // store the removed bss config for creating SLO iface
+            m_radio_info.hostapd_new_bss_config.clear();
+
+            base_conf.remove_bss_config(vap_id);
+
+            if (!base_conf.store(vap_id)) {
+                LOG(ERROR) << "Failed to update default config file";
+                return false;
+            }
+
+            // mark bssid usage as false for non ap-mld-mac
+            if (vap_info.ap_mld_mac == vap_info.mac) {
+                LOG(INFO) << "LINK MAC and AP_MLD_MAC both are same";
+            } else {
+                LOG(INFO) << "LINK MAC is not AP_MLD_MAC ";
+                m_radio_info.bssid_pool[vap_info.mac] = false;
+            }
+            return true;
+        } else {
+            LOG(ERROR) << "MLD with SSID " << target_ssid << "does not exist skip REMOVE_LINK";
+            return false;
+        }
+    } else {
+        LOG(DEBUG) << " ADD MLD LINK";
+
+        const auto vap_iter =
+          std::find_if(m_radio_info.available_vaps.begin(),m_radio_info.available_vaps.end(),
+                      [&target_ssid](const std::pair<int, bwl::VAPElement> &elem) {
+                          return (elem.second.ssid == target_ssid);
+                      });
+
+        // check ssid exists in available
+        if (vap_iter != m_radio_info.available_vaps.end()) {
+            LOG(ERROR) << "SSID " << target_ssid << "is already present skip ADD_MLD_LINK";
+            return false;
+        }
+
+        std::string link_mac;
+        if (!m_nl80211_client->getMLDLinkIfaceMacAddr(mld_iface, link_mac)) {
+            LOG(ERROR) << "Unable to read interface info of " << mld_iface;
+            return false;
+        }
+            
+        // get bss config for link_mac
+        prplmesh::hostapd::Configuration mld_conf = load_hostapd_config(link_mac);
+ 
+        if (!mld_conf) {
+            LOG(ERROR) << "Unable to load hostapd config for interface " << mld_iface;
+            return false;
+        }
+            
+        std::vector<std::pair<std::string, std::vector<std::string>>> mld_info = mld_conf.get_hostapd_bss_config(mld_iface);
+        if (!mld_info.empty()) { 
+            m_radio_info.hostapd_new_bss_config = std::move(mld_info);
+
+            std::string conf_path =
+            std::string(bwl::nl80211::base_ctrl_path) + "hostapd-" + m_radio_info.phy_name + "." + mld_iface + ".conf";
+            // create new hostapd conf file
+            prplmesh::hostapd::Configuration new_conf(conf_path);
+
+            new_conf.set_hostapd_radio_config(m_radio_info.hostapd_radio_config);
+            
+            sMacAddr new_bssid;
+
+            if (!ap_wlan_hal_nl80211::generate_new_bssid(new_bssid)) {
+                LOG(ERROR) << " Failed to assign new bssid " ;
+                return false;
+            }
+
+            LOG(INFO) << "New BSSID: " << new_bssid;
+
+            // Add new bss configuration to default hostapd_config file
+            if (!m_radio_info.hostapd_new_bss_config.empty()) {
+                auto& new_vap = m_radio_info.hostapd_new_bss_config.front();
+                std::vector<std::string>& config_lines = new_vap.second;
+                
+                // remove multi_ap_backhaul_ssid
+                config_lines.erase(
+                    std::remove_if(config_lines.begin(), config_lines.end(),
+                        [](const std::string& line) {
+                            return line.rfind("multi_ap_backhaul_ssid=", 0) == 0; // starts with
+                        }),
+                    config_lines.end()
+                );
+                config_lines.erase(
+                    std::remove_if(config_lines.begin(), config_lines.end(),
+                        [](const std::string& line) {
+                            return line.rfind("multi_ap_backhaul_wpa_passphrase=", 0) == 0; // starts with
+                        }),
+                    config_lines.end()
+                );
+
+                for (auto& line : config_lines) {
+                    if (line.rfind("bss=", 0) == 0) { // starts with "bss="
+                        line = "interface=" + mld_iface;      // replace with "interface=<vap_name>"
+                    }
+                    if (line.rfind("bssid=", 0) == 0) { // starts with "bssid="
+                        line = "bssid=" + tlvf::mac_to_string(new_bssid);      // replace with new_bssid"
+                    }
+                }
+                new_conf.add_new_vap_to_default_config(new_vap);
+
+                if (!new_conf.store(mld_iface)) {
+                    LOG(ERROR) << "Failed to store the hostapd configuration!";
+                    return false;
+                }
+            }
+            // Create a WPA control socket for the existing interface where a new link is being added
+            int fd = base_wlan_hal_nl80211::add_interface(mld_iface);
+            if (fd < 0) {
+                LOG(ERROR) << "Failed to register and connect the new BSS interface!";
+                return false;
+            }
+            std::stringstream cmd;
+            cmd << "MLD_ADD_LINK bss_config=" <<m_radio_info.phy_name<< ":" <<conf_path;
+            if (!wpa_ctrl_send_msg(cmd.str(),mld_iface)) {
+                LOG(ERROR) << "Failed to add link to the BSS: " << mld_iface;
+                return false;
+            }
+
+            std::string new_bss_link = mld_iface;
+            std::string bssid = tlvf::mac_to_string(new_bssid);
+            int8_t link_id = 0;
+
+            if (!m_nl80211_client->get_bss_link_id(new_bss_link,bssid,link_id)) {
+                    LOG(ERROR) << " get_bss_link_id failed " ;
+            }
+
+            LOG(INFO) << "link_id updated to: " << link_id;
+            LOG(INFO) << "bss updated to: " << new_bss_link;
+            fd = base_wlan_hal_nl80211::add_interface(new_bss_link);
+            if (fd < 0) {
+                LOG(ERROR) << "Failed to register and connect the Link of new BSS interface!";
+                return false;
+            }
+            // Add new bss configuration to default hostapd_config file
+            if (!m_radio_info.hostapd_new_bss_config.empty()) {
+                auto& new_vap = m_radio_info.hostapd_new_bss_config.front();
+                std::vector<std::string>& config_lines = new_vap.second;
+
+                for (auto& line : config_lines) {
+                    if (line.rfind("interface=", 0) == 0) { // starts with "interface="
+                        line = "bss=" + new_vap.first;      // replace with "bss=<vap_name>"
+                        break;
+                    }
+                }
+                if (base_conf) {
+                    base_conf.add_new_vap_to_default_config(new_vap);
+                    m_radio_info.hostapd_new_bss_config.clear();
+                    // store the default config
+                    if (!base_conf.append_new_bss_to_default_hostapd_conf()) {
+                        LOG(ERROR) << "Autoconfiguration: failed to add new bss in default config file!";
+                    }
+                } else {
+                    LOG(ERROR) << "Default config file is not updated!";
+                }
+            }
+        } else {
+            LOG(ERROR) << "Failed to get mld info";
+            return false;
+        }
+    }
+    return true;
+}
