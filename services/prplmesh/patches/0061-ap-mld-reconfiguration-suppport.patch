+prplmesh::hostapd::Configuration ap_wlan_hal_nl80211::load_hostapd_config(const std::string &bssid)
+{
+    std::vector<std::string> hostapd_cfg_names;
+    std::string path = "/var/run/";
+    
+    auto hasExtension = [] (const std::string& filename, const std::string& extension) {
+        if (filename.length() >= extension.length()) {
+            return filename.compare(filename.length() - extension.length(), extension.length(), extension) == 0;
+        }
+        return false;
+    };
+
+    DIR* dir = opendir(path.c_str());
+    if (!dir) {
+        LOG(ERROR) << "can't open the directory" ;
+        return prplmesh::hostapd::Configuration("file not found");
+    }
+
+    struct dirent* entry;
+    std::string hostapd_phy = "hostapd-phy";
+    LOG(DEBUG) << " Load hostapd files startes with " << hostapd_phy;
+    while ((entry = readdir(dir)) != nullptr) {
+        if (entry->d_type == DT_REG && (strncmp(entry->d_name,hostapd_phy.c_str(),11) == 0) && hasExtension(entry->d_name,".conf")) {
+            std::string hostapd_conf_file = path + entry->d_name;
+            hostapd_cfg_names.push_back(hostapd_conf_file);
+        }
+    }
+
+    closedir(dir);
+
+    // sorting the filenames
+    std::sort(hostapd_cfg_names.begin(), hostapd_cfg_names.end());
+
+    for (const auto &try_fname : hostapd_cfg_names) {
+        LOG(DEBUG) << "Trying to load " << try_fname << "...";
+
+        if (!beerocks::os_utils::file_exists(try_fname)) {
+            continue;
+        }
+
+        prplmesh::hostapd::Configuration hostapd_conf(try_fname);
+
+        // try loading
+        if (!hostapd_conf.load("interface=", "bss=")) {
+            LOG(ERROR) << "Failed to load hostapd config file: " << hostapd_conf;
+            continue;
+        }
+
+        LOG(DEBUG) << " check bssid exists in conf file " ;
+        if (hostapd_conf.get_vap_by_bssid(bssid).empty()) {
+            LOG(DEBUG) << bssid << " does not exists in " << try_fname;
+            continue;
+        }
+        // all is good, return the conf
+        return hostapd_conf;
+    }
+
+    // return an empty one since we couldn't find the
+    return prplmesh::hostapd::Configuration("file not found");
+}
