From 6ba0c67a1c5734de6c9771b0316071c3e5e30062 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Fri, 31 Jul 2026 12:22:46 +0530
Subject: [PATCH] fix IFNAMSIZ redefinition build error

  Move <net/if.h> before the libnl3 headers in
  link_metrics_collection_task.cpp. netlink-compat.h defines IFNAMSIZ 16
  without an include guard, and net/if.h redefines it unconditionally,
  causing a -Werror redefinition failure. Including net/if.h first lets
  netlink-compat.h's #ifndef IFNAMSIZ guard skip the duplicate definition.

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
index ab1342513..4fd76019d 100644
--- a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
@@ -51,11 +51,11 @@
  *
  * This is the same approach `iw dev wlan1_link0 station get <link_mac>` uses.
  */
+#include <net/if.h>
 #include <netlink/netlink.h>
 #include <netlink/genl/genl.h>
 #include <netlink/genl/ctrl.h>
 #include <linux/nl80211.h>
-#include <net/if.h>
 #include <climits>
 
 namespace {
-- 
2.34.1

