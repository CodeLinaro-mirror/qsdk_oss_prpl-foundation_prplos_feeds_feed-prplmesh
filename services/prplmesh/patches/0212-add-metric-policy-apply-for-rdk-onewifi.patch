From b2bc50d8984048f7eecf32ba2375f2b954f486d8 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Thu, 25 Jun 2026 15:04:11 +0530
Subject: [PATCH] apply metric policy

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 22 +++++++++++++
 .../slave/tasks/ap_autoconfiguration_task.cpp | 33 +++++++++++++++++++
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h | 11 +++++++
 .../tlvf/beerocks_message_action.yaml         |  3 +-
 .../tlvf/beerocks_message_apmanager.yaml      |  5 +++
 5 files changed, 73 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index dd1e7ad6d..36bc128cf 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1250,6 +1250,28 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         }
         return;
     }
+#ifdef BEEROCKS_RDKB
+    case beerocks_message::ACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST: {
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST failed";
+            return;
+        }
+        if (!ap_wlan_hal) {
+            LOG(WARNING) << "ap_wlan_hal not ready, skipping set_ap_metrics_reporting_interval";
+            return;
+        }
+        const int interval_sec        = request->interval_sec();
+        const bool report_ind_ch_scan = (request->report_ind_ch_scan() != 0);
+        LOG(INFO) << "ACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST: interval=" << interval_sec
+                  << " sec, report_ind_ch_scan=" << report_ind_ch_scan;
+        if (!ap_wlan_hal->set_ap_metrics_reporting_interval(interval_sec, report_ind_ch_scan)) {
+            LOG(ERROR) << "set_ap_metrics_reporting_interval failed";
+        }
+        return;
+    }
+#endif // BEEROCKS_RDKB
     case beerocks_message::ACTION_APMANAGER_CONFIGURE: {
         LOG(TRACE) << "ACTION_APMANAGER_CONFIGURE";
 
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 1c99dd72e..8eb34e65a 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2363,6 +2363,39 @@ void ApAutoConfigurationTask::handle_multi_ap_policy_config_request(
                       "policy unchanged and already applied";
     }
 
+#ifdef BEEROCKS_RDKB
+    // Send AP metrics policy to all AP managers from db
+    if (db->link_metrics_policy.reporting_interval_sec > 0) {
+        for (auto radio : db->get_radios_list()) {
+            if (!radio) {
+                continue;
+            }
+            auto ap_manager_fd = m_btl_ctx.get_ap_manager_fd(radio->front.iface_name);
+            if (ap_manager_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+                LOG(WARNING) << "AP manager fd invalid for " << radio->front.iface_name;
+                continue;
+            }
+
+            auto request = message_com::create_vs_message<
+                beerocks_message::cACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST>(m_cmdu_tx);
+            if (!request) {
+                LOG(ERROR) << "Failed building cACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST!";
+                continue;
+            }
+
+            request->interval_sec() = static_cast<int32_t>(db->link_metrics_policy.reporting_interval_sec);
+            request->report_ind_ch_scan() = db->link_metrics_policy.report_independent_channel_scans ? 1 : 0;
+
+            LOG(DEBUG) << "Sending AP metrics policy to AP manager for radio "
+                       << radio->front.iface_name
+                       << ": interval=" << request->interval_sec()
+                       << " sec, report_ind_ch_scan=" << int(request->report_ind_ch_scan());
+
+            m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
+        }
+    }
+#endif // BEEROCKS_RDKB
+
     return;
 }
 
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index dc4346d5d..0a1f7bab8 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -752,6 +752,17 @@ public:
      */
     virtual bool set_hop_count(uint8_t hop_count) { return true; }
 
+#ifdef BEEROCKS_RDKB
+    /**
+     * @brief Set AP metrics reporting interval (OneWifi/RDKB-specific).
+     *
+     * @param interval_sec AP metrics reporting interval in seconds
+     * @param report_ind_ch_scan Whether to report independent channel scans
+     * @return true on success, false otherwise.
+     */
+    virtual bool set_ap_metrics_reporting_interval(int interval_sec, bool report_ind_ch_scan) { return true; }
+#endif
+
     /**
      * @brief Enable all fronthaul VAPs on this radio.
      *
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
index 86387df38..3753e119f 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
@@ -290,7 +290,8 @@ eActionOp_APMANAGER:
   ACTION_APMANAGER_HOSTAP_AWGN_DETECTED_NOTIFICATION: 88
   ACTION_APMANAGER_HOSTAP_AWGN_SIMULATE_REQUEST: 89
   ACTION_APMANAGER_HOSTAP_AWGN_SIMULATE_RESPONSE: 90
-  ACTION_APMANAGER_ENUM_END: 91
+  ACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST: 91
+  ACTION_APMANAGER_ENUM_END: 92
 
 ####################################################
 ####################################################
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 8d358c533..4c98dccf1 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -432,6 +432,11 @@ cACTION_APMANAGER_HOSTAP_AWGN_DETECTED_NOTIFICATION:
   _type: class
   params: sAwgnDetectedParams
 
+cACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST:
+  _type: class
+  interval_sec: int32_t  # AP metrics reporting interval in seconds (from TLV_METRIC_REPORTING_POLICY)
+  report_ind_ch_scan: uint8_t  # 0=do not report independent channel scans, 1=report independent channel scans (from TLV_CHANNEL_SCAN_REPORTING_POLICY)
+
 #################################################
 # AWGN SIMULATION (via wpa_ctrl DCS_SIM command)
 #################################################
-- 
