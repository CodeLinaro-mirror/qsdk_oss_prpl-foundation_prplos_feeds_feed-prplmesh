-# If running on OpenWrt, perform UCI operations and reload wireless
+# reset_default_htmode <current_htmode>
+# Echoes the target htmode:
+#   EHT<width> if current starts with "EHT" (11be), else HE<width> (11ax).
+# Width is taken from the leading digits of the current htmode (default 80);
+# HE is clamped to a max width of 160.
+reset_default_htmode() {
+    cur="$1"
+
+    # Extract leading numeric width (e.g. "EHT160" -> 160, "HT20" -> 20).
+    width=$(echo "$cur" | sed -n 's/^[A-Za-z]*\([0-9][0-9]*\).*/\1/p')
+    [ -z "$width" ] && width=80
+
+    case "$cur" in
+    EHT*)
+        echo "EHT${width}"
+        ;;
+    *)
+        # HE (11ax) has no 320 MHz; clamp.
+        if [ "$width" -gt 160 ] 2>/dev/null; then
+            width=160
+        fi
+        echo "HE${width}"
+        ;;
+    esac
+}
