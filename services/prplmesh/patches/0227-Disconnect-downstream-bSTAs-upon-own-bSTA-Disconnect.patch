From ee66ce5de0350e5f23a05e4976da65101fff1f6e Mon Sep 17 00:00:00 2001
From: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
Date: Wed, 27 May 2026 08:55:21 +0530
Subject: [PATCH] Disconnect downstream bSTAs upon own bSTA Disconnect

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 45 +++++++++++++++++++
 .../fronthaul_manager/ap_manager/ap_manager.h |  9 ++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       |  2 +-
 3 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index cca60b21e..ad61e72da 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1180,6 +1180,12 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         if (!ap_wlan_hal->set_hop_count(hop_count)) {
             LOG(ERROR) << "Setting hop count failed on interface" << m_iface;
         };
+        if (!notification->connected()) {
+            // Disconnect all bSTAs connected to this agent's backhaul BSSes
+            // This prevents loop formation when the agent tries to reconnect
+            LOG(INFO) << "Disconnecting all bSTAs from backhaul BSSes to prevent mesh loops";
+            disconnect_all_backhaul_stas();
+        }
         return;
     }
     case beerocks_message::ACTION_APMANAGER_UPDATE_HIDDEN_SSID_REQUEST: {
@@ -4354,3 +4360,42 @@ void ApManager::start_csa_notification_timer(
             return true;
         });
 }
+
+void ApManager::disconnect_all_backhaul_stas()
+{
+    LOG(INFO) << "Disconnecting all bSTAs from backhaul BSSes on radio " << m_iface;
+
+    if (!ap_wlan_hal) {
+        LOG(WARNING) << "ap_wlan_hal not initialized, cannot disconnect bSTAs";
+        return;
+    }
+
+    const auto &vap_unordered_map = ap_wlan_hal->get_radio_info().available_vaps;
+
+    // Iterate through all VAPs and disconnect clients from backhaul BSSes
+    for (const auto &vap_entry : vap_unordered_map) {
+        const auto &vap = vap_entry.second;
+
+        // Only process backhaul BSSes
+        if (!vap.backhaul) {
+            continue;
+        }
+
+        LOG(INFO) << "Disconnecting all clients from backhaul BSS: " << vap.bss
+                  << " (BSSID: " << vap.mac << ")";
+
+        // Deauthenticate all stations on this backhaul BSS
+        // Using wildcard MAC address to disconnect all connected stations
+        if (!ap_wlan_hal->sta_deauth(vap_entry.first,
+                                     beerocks::net::network_utils::WILD_MAC_STRING,
+                                     wfa_map::tlvProfile2ReasonCode::AP_INITIATED)) {
+            LOG(ERROR) << "Failed to deauthenticate all stations from backhaul BSS "
+                       << vap.bss;
+        } else {
+            LOG(INFO) << "Successfully deauthenticated all stations from backhaul BSS "
+                      << vap.bss;
+        }
+    }
+
+    LOG(INFO) << "Completed disconnecting all bSTAs from backhaul BSSes";
+}
diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
index c254c1b64..dce190b0d 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
@@ -167,6 +167,15 @@ private:
     void allow_expired_clients();
     bool register_ext_events_handlers(int fd);
 
+    /**
+     * @brief Disconnect all bSTAs connected to this agent's backhaul BSSes.
+     *
+     * This method is called when the agent loses controller connectivity or loses
+     * connection on its bSTA. Disconnecting all downstream bSTAs prevents loop
+     * formation in the mesh network by forcing all agents to set hop count to 255.
+     */
+    void disconnect_all_backhaul_stas();
+
     /**
      * @brief Create a new BSS and register handlers for it.
      *
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 34113f024..eaeabb74e 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1887,7 +1887,7 @@ bool ap_wlan_hal_nl80211::sta_deauth(int8_t vap_id, const std::string &mac, uint
     }
 
     // Build command string
-    const std::string cmd = "DEAUTHENTICATE " + mac + " reason=" + std::to_string(reason) + " tx=0";
+    const std::string cmd = "DEAUTHENTICATE " + mac + " reason=" + std::to_string(reason);
 
     // Send command
     if (!wpa_ctrl_send_msg(cmd, ifname)) {
-- 
