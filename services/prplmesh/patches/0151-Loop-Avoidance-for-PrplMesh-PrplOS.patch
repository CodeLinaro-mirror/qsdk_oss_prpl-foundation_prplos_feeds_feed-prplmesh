Subject: [PATCH] Loop Avoidance for PrplMesh-PrplOS

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 65 +++++++++++++++++++++
 common/beerocks/bwl/whm/ap_wlan_hal_whm.h   |  3 +
 2 files changed, 68 insertions(+)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index a67bb1953..d72d6eadd 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -2627,6 +2627,71 @@ bool ap_wlan_hal_whm::change_radio_mode_config(
     return true;
 }
 
+std::string ap_wlan_hal_whm::build_multiap_assocresp_ie_hex(uint8_t hop_count)
+{
+    // The WHM createVendorIE takes OUI ("00:13:74" or "001374") and the remaining data payload.
+    // The data payload for Multi-AP Extension Sub-element is OUI Type (0x1b) + hop_count.
+    char buf[16];
+    int written = snprintf(buf, sizeof(buf), "1b%02x", hop_count);
+    if (written < 0 || static_cast<size_t>(written) >= sizeof(buf)) {
+        LOG(ERROR) << "build_multiap_assocresp_ie_hex: buffer too small or encoding error";
+        return {};
+    }
+    return std::string(buf);
+}
+
+bool ap_wlan_hal_whm::set_hop_count(uint8_t hop_count)
+{
+    LOG(DEBUG) << "WHM: Setting hop_count=" << int(hop_count)
+               << " on backhaul BSSes of radio " << get_iface_name();
+
+    std::string ie_data = build_multiap_assocresp_ie_hex(hop_count);
+    if (ie_data.empty()) {
+        return false;
+    }
+
+    bool success = true;
+
+    for (const auto &vap_entry : m_radio_info.available_vaps) {
+        const auto &vap = vap_entry.second;
+
+        if (vap.bss.empty()) {
+            continue;
+        }
+        if (!vap.backhaul) {  // Only update backhaul BSSes
+            continue;
+        }
+
+        // Resolve the TR-181 path for this AccessPoint (e.g., Device.WiFi.AccessPoint.2.)
+        std::string ap_path = wbapi_utils::search_path_ap_by_iface(vap.bss);
+        if (ap_path.empty()) {
+            LOG(ERROR) << "Failed to resolve AP path for BSS " << vap.bss;
+            success = false;
+            continue;
+        }
+
+        // Prepare Ambiorix arguments for the createVendorIE method
+        beerocks::wbapi::AmbiorixVariant args(AMXC_VAR_ID_HTABLE);
+        args.add_child("oui", "00:13:74");
+        args.add_child("data", ie_data);
+        args.add_child("frame_type", "AssocResp");
+
+        beerocks::wbapi::AmbiorixVariant result;
+        std::string target_obj = ap_path + "VendorIEs.";
+
+        // Invoke the method via Ambiorix Client
+        if (!m_ambiorix_cl.call(target_obj, "createVendorIE", args, result)) {
+            LOG(ERROR) << "Failed to call createVendorIE on " << target_obj;
+            success = false;
+        } else {
+            LOG(DEBUG) << "Successfully set hop_count=" << int(hop_count)
+                       << " on BSS " << vap.bss;
+        }
+    }
+
+    return success;
+}
+
 } // namespace whm
 
