From 2621e1f77412815cbe58efac60a5508a64a4330b Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 10 Sep 2026 10:54:28 +0530
Subject: [PATCH] nl80211: restore WDS interface events

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h |  5 ++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 71 +++++++++++++++++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.h         |  3 +
 3 files changed, 79 insertions(+)

diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index c20036489..e4254fbad 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -851,6 +851,11 @@ public:
 
 #ifdef USE_PRPLMESH_NLHAL
     virtual bool handle_mld_reconfig(std::string target_ssid, int8_t mld_unit) = 0;
+
+    virtual bool get_wds_interface_name(const std::string &sta_mac,
+                                        const std::string &bss,
+                                        std::string &wds_iface) = 0;
+
 #endif
     /**
      * @brief Dynamically update the Multi-AP hop count in the assocresp_elements
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 5208a8d7a..97a05c6a5 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -6987,6 +6987,37 @@ bool ap_wlan_hal_nl80211::generate_connected_clients_events(
             }
 
             LOG(DEBUG) << "client_mac: " << client_mac;
+
+            if (vap.second.backhaul) {
+                std::string wds_iface;
+                if (get_wds_interface_name(client_mac, vap.second.bss, wds_iface)) {
+
+                    auto wds_msg_buff =
+                        ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_WDS_IFACE_NOTIFICATION));
+
+                    auto wds_msg =
+                        reinterpret_cast<sACTION_APMANAGER_WDS_IFACE_NOTIFICATION *>(
+                            wds_msg_buff.get());
+
+                    LOG_IF(!wds_msg, FATAL) << "Memory allocation failed!";
+
+                    memset(wds_msg_buff.get(), 0,
+                           sizeof(sACTION_APMANAGER_WDS_IFACE_NOTIFICATION));
+
+                    wds_msg->params.mac    = tlvf::mac_from_string(client_mac);
+                    wds_msg->params.bssid  = tlvf::mac_from_string(vap.second.mac);
+                    wds_msg->params.vap_id = vap.first;
+
+                    strlcpy(wds_msg->params.wds_iface_name, wds_iface.c_str(),
+                            sizeof(wds_msg->params.wds_iface_name));
+
+                    LOG(INFO) << "Recovered WDS interface for STA " << client_mac
+                              << " bssid=" << vap.second.mac
+                              << " wds_iface=" << wds_iface;
+
+                    event_queue_push(Event::STA_WDS_Iface_Ready, wds_msg_buff);
+                }
+            }
             auto msg_buff =
                 ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
             auto msg =
@@ -10062,6 +10093,46 @@ bool ap_wlan_hal_nl80211::process_scan_nl_event(struct nl_msg *msg, void *arg)
     return false;
 }
 
+bool ap_wlan_hal_nl80211::get_wds_interface_name(const std::string &sta_mac,
+                                                 const std::string &bss,
+                                                 std::string &wds_iface)
+{
+    char *reply = nullptr;
+    std::string cmd = "STA " + sta_mac;
+
+    if (!wpa_ctrl_send_msg(cmd, &reply, bss)) {
+        LOG(ERROR) << "Failed to execute '" << cmd << "'";
+        return false;
+    }
+
+    if (!reply || !std::strlen(reply)) {
+        return false;
+    }
+
+    constexpr const char *wds_field = "wds_sta_ifname=";
+
+    std::stringstream ss(reply);
+    std::string line;
+
+    while (std::getline(ss, line)) {
+        if (line.find(wds_field) == 0) {
+            wds_iface = line.substr(std::strlen(wds_field));
+
+            // hostapd replies may be CRLF-terminated; strip the trailing '\r'.
+            if (!wds_iface.empty() && wds_iface.back() == '\r') {
+                wds_iface.pop_back();
+            }
+
+            LOG(DEBUG) << "Found WDS interface for STA " << sta_mac
+                       << ": " << wds_iface;
+
+            return true;
+        }
+    }
+
+    return false;
+}
+
 } // namespace nl80211
 
 std::shared_ptr<ap_wlan_hal> ap_wlan_hal_create(std::string iface_name, hal_conf_t hal_conf,
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index f7e88056a..055cbb9b5 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -224,6 +224,9 @@ public:
 protected:
     virtual bool process_nl80211_event(parsed_obj_map_t &parsed_obj) override;
 
+    virtual bool get_wds_interface_name(const std::string &sta_mac, const std::string &bss,
+                                         std::string &wds_iface) override;
+
     // Overload for AP events
     bool event_queue_push(ap_wlan_hal::Event event, std::shared_ptr<void> data = {})
     {
-- 
