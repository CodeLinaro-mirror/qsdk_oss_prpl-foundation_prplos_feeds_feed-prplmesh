From 0f872dc3ae382885aa17b65118c91acd56bae0a0 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Wed, 14 Oct 2026 13:52:16 +0530
Subject: [PATCH] BTM report dupelicate fix for MLO STAs

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 30 +++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 0000e0f85..ae6a68c2f 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -8707,8 +8707,7 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         // global socket does not carry it. Dropping all per-VAP-socket deliveries would
         // break SLO steering entirely.
         //
-        // Fix: drop the duplicate only when the event arrives on a per-link socket
-        // (interface name contains "_link"), which is the MLO-specific delivery path.
+        // Fix 1: drop the per-link socket duplicate (MLO-specific delivery path).
         // SLO VAP interfaces (e.g. "wlan0.1") do not have "_link" in their name and
         // are therefore unaffected.
         if (!from_global_sock && interface.find("_link") != std::string::npos) {
@@ -8716,6 +8715,33 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
             break;
         }
 
+        // Fix 2: MLO global-socket ownership guard.
+        //
+        // On MLO hardware the global hostapd socket delivers BSS-TM-RESP with
+        // "IFNAME=<base_iface> LINKID=<N>" to EVERY AP manager instance that has
+        // the base interface (e.g. "wlan0") in its available_vaps map.  Because the
+        // base interface is shared across all per-link AP managers, get_vap_id_with_bss()
+        // returns a valid vap_id for all of them, so the general vap_id < 0 guard does
+        // not filter out the non-owning instances.  Without this guard every AP manager
+        // processes the event and sends a duplicate CLIENT_STEERING_BTM_REPORT_MESSAGE.
+        //
+        // Use the LINKID field carried in the global-socket event to restrict processing
+        // to the AP manager that owns that specific link (own_link_id, derived from
+        // m_radio_info.iface_name, e.g. "wlan0_link0" → own_link_id=0).
+        // SLO radios have own_link_id < 0 and are unaffected by this guard.
+        if (from_global_sock && own_link_id >= 0) {
+            auto linkid_it = parsed_obj.find("LINKID");
+            if (linkid_it != parsed_obj.end() && !linkid_it->second.empty()) {
+                int event_link_id = beerocks::string_utils::stoi(linkid_it->second);
+                if (event_link_id != own_link_id) {
+                    LOG(DEBUG) << "Ignoring BSS-TM-RESP on global socket: LINKID="
+                               << event_link_id << " != own_link_id=" << own_link_id
+                               << " for interface=" << interface;
+                    break;
+                }
+            }
+        }
+
         // TODO: Change to HAL objects
         auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_BSS_STEER_RESPONSE));
         auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_BSS_STEER_RESPONSE *>(msg_buff.get());
-- 
