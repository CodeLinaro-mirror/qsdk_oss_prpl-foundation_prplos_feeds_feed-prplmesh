diff --git a/common/beerocks/bwl/nl80211/mlo_utils.h b/common/beerocks/bwl/nl80211/mlo_utils.h
new file mode 100644
index 000000000..e4b67480b
--- /dev/null
+++ b/common/beerocks/bwl/nl80211/mlo_utils.h
@@ -0,0 +1,74 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+#ifndef _BWL_MLO_UTILS_H_
+#define _BWL_MLO_UTILS_H_
+
+#include <string>
+#include <memory>
+#include <tlvf/common/sMacAddr.h>
+
+namespace bwl {
+
+// Forward declaration
+class nl80211_client;
+
+namespace nl80211 {
+
+/**
+ * @brief Get the Link ID from a BSSID
+ *
+ * This function queries the nl80211 interface to determine which Link ID
+ * corresponds to a given BSSID in an MLO (Multi-Link Operation) setup.
+ *
+ * @param ifname Base interface name (e.g., "wlan0")
+ * @param bssid The BSSID to look up
+ * @param nl80211_client Pointer to the nl80211 client for querying
+ * @return int8_t The Link ID (0-based), or -1 if not found or not MLO
+ */
+inline int8_t get_link_id_from_bssid(const std::string &ifname, const sMacAddr &bssid,
+                                     bwl::nl80211_client *nl80211_client)
+{
+    int8_t link_id = -1;
+
+    if (!nl80211_client) {
+        return link_id;
+    }
+
+    // Query the nl80211 client to get the link ID for this BSSID
+    // Create mutable copies for the API call
+    std::string ifname_copy = ifname;
+    std::string bssid_str = tlvf::mac_to_string(bssid);
+    if (!nl80211_client->get_bss_link_id(ifname_copy, bssid_str, link_id)) {
+        // If query fails, assume non-MLO (link_id = -1)
+        return -1;
+    }
+
+    return link_id;
+}
+
+/**
+ * @brief Get the interface name for a specific link
+ *
+ * This function constructs the interface name for a specific link in an MLO setup.
+ * For non-MLO or invalid link IDs, it returns the base interface name.
+ *
+ * @param base_ifname Base interface name (e.g., "wlan0")
+ * @param link_id The Link ID (0-based)
+ * @return std::string The link-specific interface name (e.g., "wlan0_link0") or base name
+ */
+inline std::string get_interface_for_link(const std::string &base_ifname, int8_t link_id)
+{
+    // If link_id is invalid or -1 (non-MLO), return base interface
+    if (link_id < 0) {
+        return base_ifname;
+    }
+
+    // Construct link-specific interface name
+    return base_ifname + "_link" + std::to_string(link_id);
+}
