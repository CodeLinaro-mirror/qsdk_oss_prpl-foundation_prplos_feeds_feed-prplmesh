From 4b8495891a74f21a1dfe4cf2bb8cc1e326e8cf5e Mon Sep 17 00:00:00 2001
From: Ritanya Thangavel <rthangav@qti.qualcomm.com>
Date: Wed, 8 Apr 2026 12:35:16 +0530
Subject: [PATCH] Buffer Overflow fix

Signed-off-by: Ritanya Thangavel <rthangav@qti.qualcomm.com>
---
 .../bcl/source/network/get_iface_stats.cpp    |  7 ++++
 .../platform/bpl/cfg/rdk/bpl_cfg_helper.cpp   |  6 +++
 tools/qmesh_cli/qmesh_cli.c                   | 42 +++++++++++++------
 3 files changed, 43 insertions(+), 12 deletions(-)

diff --git a/common/beerocks/bcl/source/network/get_iface_stats.cpp b/common/beerocks/bcl/source/network/get_iface_stats.cpp
index a43016734..5ab47c82b 100644
--- a/common/beerocks/bcl/source/network/get_iface_stats.cpp
+++ b/common/beerocks/bcl/source/network/get_iface_stats.cpp
@@ -10,6 +10,7 @@
 
 #include <easylogging++.h>
 
+#include <climits>
 #include <errno.h>
 #include <linux/netlink.h>
 #include <linux/rtnetlink.h>
@@ -172,6 +173,12 @@ static bool get_iface_stats(int fd, const std::string &iface_name, sInterfaceSta
             break;
         }
 
+        // Check for overflow before casting to unsigned int
+        if (static_cast<uint64_t>(recv_len) > static_cast<uint64_t>(UINT_MAX)) {
+            LOG(ERROR) << "recvmsg() returned value too large: " << recv_len;
+            break;
+        }
+
         unsigned int length = static_cast<unsigned int>(recv_len);
 
         for (const nlmsghdr *msg_ptr            = reinterpret_cast<const nlmsghdr *>(reply);
diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp
index eaae63de9..515b8e1fb 100644
--- a/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp
@@ -26,6 +26,7 @@ static cJSON* load_json_config()
 
     std::stringstream buffer;
     buffer << file.rdbuf();
+    file.close(); // Explicitly close before parsing
 
     cJSON *json = cJSON_Parse(buffer.str().c_str());
     if (!json) {
@@ -203,6 +204,11 @@ int cfg_get_channel(const std::string &interface_name, int *channel)
         return RETURN_ERR;
     }
 
+    if (interface_name.empty()) {
+        MAPF_ERR("cfg_get_channel: interface_name is empty");
+        return RETURN_ERR;
+    }
+
     cJSON *json = load_json_config();
     if (!json) return RETURN_ERR;
 
diff --git a/tools/qmesh_cli/qmesh_cli.c b/tools/qmesh_cli/qmesh_cli.c
index c349e32d9..3dbb6a581 100644
--- a/tools/qmesh_cli/qmesh_cli.c
+++ b/tools/qmesh_cli/qmesh_cli.c
@@ -131,21 +131,30 @@ static int save_json(cJSON *json)
  */
 static int cmd_get(const char *key)
 {
-    char section[64] = {0};
-    char param[64] = {0};
+    char section[128] = {0};
+    char param[128] = {0};
     const char *dot = strchr(key, '.');
     cJSON *json = NULL;
     cJSON *section_obj = NULL;
     cJSON *item = NULL;
 
-    if (!dot) {
+    if (!dot || dot == key || *(dot + 1) == '\0') {
         fprintf(stderr, "qmesh_cli: invalid key '%s', expected <section>.<param>\n", key);
         return 1;
     }
 
-    strlcpy(section, key, (size_t)(dot - key));
-    section[dot - key] = '\0';
-    strlcpy(param, dot + 1, sizeof(param) - 1);
+    size_t section_len = (size_t)(dot - key);
+    size_t param_len = strlen(dot + 1);
+
+    if (section_len >= sizeof(section) || param_len >= sizeof(param)) {
+        fprintf(stderr, "qmesh_cli: key components too long\n");
+        return 1;
+    }
+
+    memcpy(section, key, section_len);
+    section[section_len] = '\0';
+    memcpy(param, dot + 1, param_len);
+    param[param_len] = '\0';
 
     json = load_json();
     if (!json) {
@@ -197,8 +206,8 @@ static int cmd_get(const char *key)
  */
 static int cmd_set(const char *key, const char *value)
 {
-    char section[64] = {0};
-    char param[64] = {0};
+    char section[128] = {0};
+    char param[128] = {0};
     const char *dot = strchr(key, '.');
     cJSON *json = NULL;
     cJSON *section_obj = NULL;
@@ -206,14 +215,23 @@ static int cmd_set(const char *key, const char *value)
     char *endptr = NULL;
     long int_val = 0;
 
-    if (!dot) {
+    if (!dot || dot == key || *(dot + 1) == '\0') {
         fprintf(stderr, "qmesh_cli: invalid key '%s', expected <section>.<param>\n", key);
         return 1;
     }
 
-    strlcpy(section, key, (size_t)(dot - key));
-    section[dot - key] = '\0';
-    strlcpy(param, dot + 1, sizeof(param) - 1);
+    size_t section_len = (size_t)(dot - key);
+    size_t param_len = strlen(dot + 1);
+
+    if (section_len >= sizeof(section) || param_len >= sizeof(param)) {
+        fprintf(stderr, "qmesh_cli: key components too long\n");
+        return 1;
+    }
+
+    memcpy(section, key, section_len);
+    section[section_len] = '\0';
+    memcpy(param, dot + 1, param_len);
+    param[param_len] = '\0';
 
     json = load_json();
     if (!json) {
-- 
2.34.1

