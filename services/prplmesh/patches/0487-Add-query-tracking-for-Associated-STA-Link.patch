From d9d92fe4289c9b49c1f9dd206513ca6329b2461b Mon Sep 17 00:00:00 2001
From: Mahitha M <mmaddulu@qti.qualcomm.com>
Date: Sun, 4 Oct 2026 00:27:53 +0530
Subject: [PATCH] Add query tracking for Associated STA Link

Signed-off-by: Mahitha M <mmaddulu@qti.qualcomm.com>
---
 .../slave/tasks/link_metrics_collection_task.cpp     |  4 ++++
 .../slave/tasks/link_metrics_collection_task.h       | 12 ++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
index 28abb39d9..a13c9aea5 100644
--- a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
@@ -870,6 +870,7 @@ void LinkMetricsCollectionTask::handle_associated_sta_link_metrics_query(
             }
             request_out->sta_mac() = mac->sta_mac();
 
+            m_associated_sta_link_metrics_query[mid] = {mac->sta_mac(), std::chrono::steady_clock::now()};
             auto monitor_fd = m_btl_ctx.get_monitor_fd(radio->front.iface_name);
             m_btl_ctx.send_cmdu(monitor_fd, m_cmdu_tx);
             return;
@@ -2554,6 +2555,9 @@ void LinkMetricsCollectionTask::handle_event(uint8_t event_enum_value, const voi
         m_ap_metric_query.clear();
         m_ap_metric_query_pending_responses.clear();
         m_ap_metrics_reporting_info.reporting_interval_s = 0;
+        
+        // Clear pending Associated STA Link Metrics queries
+        m_associated_sta_link_metrics_query.clear();
 
         break;
     }
diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.h b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.h
index 20655b7c6..46630ac01 100644
--- a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.h
+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.h
@@ -359,6 +359,18 @@ private:
     /* To store the Beacon Metrics Queries to be sent */
     std::vector<sBeaconMetricsQuery> m_beacon_metrics_query;
 
+    /**
+     * @brief Pending Associated STA Link Metrics queries.
+     * 
+     * Maps message ID to the STA MAC and timestamp when the query was sent to monitor.
+     * This allows correlating monitor responses back to the original controller query.
+     */
+    struct sAssociatedStaLinkMetricsQuery {
+        sMacAddr sta_mac;
+        std::chrono::steady_clock::time_point query_time;
+    };
+    std::unordered_map<uint16_t, sAssociatedStaLinkMetricsQuery> m_associated_sta_link_metrics_query;
+
     /* Timer callback for scheduled Beacon Metrics Queries */
     bool beacon_metrics_query_cb(int fd);
     bool schedule_beacon_metrics_query(wfa_map::tlvBeaconMetricsQuery &beacon_metrics_query,
-- 
2.34.1

