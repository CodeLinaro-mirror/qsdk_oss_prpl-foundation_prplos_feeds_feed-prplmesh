+
+void AgentDB::dm_trigger_client_steering_failed_event(uint64_t incident_id,
+                                                      const std::string &detected_by,
+                                                      const sMacAddr &sta_mac,
+                                                      const sMacAddr &source_bssid,
+                                                      const sMacAddr &target_bssid,
+                                                      const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    LOG_IF(!m_ambiorix_datamodel, FATAL) << "m_ambiorix_datamodel not set";
+
+    std::string sta_mac_str      = tlvf::mac_to_string(sta_mac);
+    std::string source_bssid_str = tlvf::mac_to_string(source_bssid);
+    std::string target_bssid_str = tlvf::mac_to_string(target_bssid);
+    const std::string controller_id = tlvf::mac_to_string(controller_info.bridge_mac);
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress",   controller_id.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",       AGENT_ROOT_DM ".QCOM_Vendor.");
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID",   incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy",   detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "STAMACAddress", sta_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "SourceBSSID",  source_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "TargetBSSID",  target_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason",       reason.c_str());
+
+    const std::string vendor_event_obj = AGENT_ROOT_DM ".QCOM_Vendor.ClientSteeringFailed";
+    const bool ok = m_ambiorix_datamodel->trigger_event_with_data(
+        vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_client_steering_failed_event: failed to trigger"
+                      " ClientSteeringFailed"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " sta_mac=" << sta_mac_str
+                   << " source_bssid=" << source_bssid_str
+                   << " target_bssid=" << target_bssid_str << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_client_steering_failed_event: triggered"
+                      " ClientSteeringFailed"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " sta_mac=" << sta_mac_str
+                   << " source_bssid=" << source_bssid_str
+                   << " target_bssid=" << target_bssid_str << " reason=" << reason;
+    }
+#else
+    (void)incident_id;
+    (void)detected_by;
+    (void)sta_mac;
+    (void)source_bssid;
+    (void)target_bssid;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
