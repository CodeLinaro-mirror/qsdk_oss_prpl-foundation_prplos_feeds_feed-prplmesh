+void AgentDB::dm_trigger_agent_restart_event(uint64_t incident_id,
+                                             const std::string &detected_by,
+                                             const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    LOG_IF(!m_ambiorix_datamodel, FATAL) << "m_ambiorix_datamodel not set";
+
+    const std::string controller_id = tlvf::mac_to_string(controller_info.bridge_mac);
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", controller_id.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", AGENT_ROOT_DM ".QCOM_Vendor.");
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID", incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy", detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason", reason.c_str());
+
+    const std::string vendor_event_obj = AGENT_ROOT_DM ".QCOM_Vendor.AgentRestart";
+    const bool ok = m_ambiorix_datamodel->trigger_event_with_data(
+        vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_agent_restart_event: failed to trigger AgentRestart"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_agent_restart_event: triggered AgentRestart"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " reason=" << reason;
+    }
+#else
+    (void)incident_id;
+    (void)detected_by;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
