+void db::dm_trigger_client_steering_rejected_event(uint64_t incident_id,
+                                                  const std::string &detected_by,
+                                                  const sMacAddr &sta_mac,
+                                                  const sMacAddr &target_bssid,
+                                                  const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    std::string sta_mac_str      = tlvf::mac_to_string(sta_mac);
+    std::string target_bssid_str = tlvf::mac_to_string(target_bssid);
+
+    std::string sta_dm_path;
+    auto sta = get_station(sta_mac);
+    if (sta) {
+        sta_dm_path = sta->dm_path;
+    }
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", sta_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", sta_dm_path.c_str());
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID", incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy", detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "TargetBSSID", target_bssid_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason", reason.c_str());
+
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.ClientSteeringRejected";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_client_steering_rejected_event: failed to trigger"
+                      " ClientSteeringRejected"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " sta_mac=" << sta_mac_str << " target_bssid=" << target_bssid_str
+                   << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_client_steering_rejected_event: triggered"
+                      " ClientSteeringRejected"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " sta_mac=" << sta_mac_str << " target_bssid=" << target_bssid_str
+                   << " reason=" << reason;
+    }
+#else // !ENABLE_NBAPI
+    (void)incident_id;
+    (void)detected_by;
+    (void)sta_mac;
+    (void)target_bssid;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
