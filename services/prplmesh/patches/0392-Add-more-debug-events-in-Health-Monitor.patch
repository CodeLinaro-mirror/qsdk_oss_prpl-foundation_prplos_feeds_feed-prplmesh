+
+bool HealthMonitoringTask::handle_client_steering_failed_notification(
+    const sMacAddr &src_mac, std::shared_ptr<beerocks_header> beerocks_header)
+{
+    auto notification = beerocks_header->addClass<
+        beerocks_message::cACTION_CONTROL_HEALTH_MONITOR_STEERING_NOTIFICATION>();
+    if (!notification) {
+        LOG(ERROR) << "HEALTH_MONITORING: addClass "
+                      "cACTION_CONTROL_HEALTH_MONITOR_STEERING_NOTIFICATION failed";
+        return false;
+    }
+
+    auto db = AgentDB::get();
+    const auto controller_id = tlvf::mac_to_string(db->controller_info.bridge_mac);
+
+    std::string reason;
+    switch (notification->reason()) {
+    case beerocks_message::eClientSteeringFailedReason_BTM_REJECTED:
+        reason = "btm_rejected";
+        break;
+    case beerocks_message::eClientSteeringFailedReason_WRONG_TARGET_BSSID:
+        reason = "wrong_target_bssid";
+        break;
+    case beerocks_message::eClientSteeringFailedReason_TIMEOUT_NO_RESPONSE:
+    default:
+        reason = "timeout_no_response";
+        break;
+    }
+
+    LOG(DEBUG) << "HEALTH_MONITORING: received ClientSteeringFailed notification from "
+                  "controller "
+               << src_mac << " incident_id=" << notification->incident_id()
+               << " sta_mac=" << notification->sta_mac()
+               << " source_bssid=" << notification->source_bssid()
+               << " target_bssid=" << notification->target_bssid() << " reason=" << reason;
+
+    db->dm_trigger_client_steering_failed_event(
+        notification->incident_id(), controller_id, notification->sta_mac(),
+        notification->source_bssid(), notification->target_bssid(), reason);
+
+    return true;
+}
