+void db::dm_trigger_missing_tlv_event(uint64_t incident_id, const std::string &detected_by,
+                                      const sMacAddr &src_mac,
+                                      ieee1905_1::eMessageType message_type,
+                                      const std::vector<std::string> &tlv_names)
+{
+#ifdef ENABLE_NBAPI
+    std::string src_mac_str = tlvf::mac_to_string(src_mac);
+
+    std::string src_dm_path;
+    auto agent = get_agent(src_mac);
+    if (agent) {
+        src_dm_path = agent->dm_path;
+    }
+
+    std::string tlv_names_str;
+    for (size_t i = 0; i < tlv_names.size(); i++) {
+        if (i > 0) {
+            tlv_names_str += ",";
+        }
+        tlv_names_str += tlv_names[i];
+    }
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", src_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", src_dm_path.c_str());
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID", incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy", detected_by.c_str());
+    amxc_var_add_key(uint32_t,  &event_data, "MessageType", static_cast<uint32_t>(message_type));
+    amxc_var_add_key(cstring_t, &event_data, "TlvNames", tlv_names_str.c_str());
+
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.MissingRequiredTlv";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_missing_tlv_event: failed to trigger MissingRequiredTlv"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " src_mac=" << src_mac_str
+                   << " message_type=0x" << std::hex << static_cast<uint32_t>(message_type)
+                   << std::dec << " tlv_names=" << tlv_names_str;
+    } else {
+        LOG(DEBUG) << "dm_trigger_missing_tlv_event: triggered MissingRequiredTlv"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " src_mac=" << src_mac_str
+                   << " message_type=0x" << std::hex << static_cast<uint32_t>(message_type)
+                   << std::dec << " tlv_names=" << tlv_names_str;
+    }
+#else // !ENABLE_NBAPI
+    (void)incident_id;
+    (void)detected_by;
+    (void)src_mac;
+    (void)message_type;
+    (void)tlv_names;
+#endif // ENABLE_NBAPI
+}
+
+void db::dm_trigger_controller_restart_event(uint64_t incident_id, const std::string &detected_by,
+                                             const std::string &reason)
+{
+#ifdef ENABLE_NBAPI
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.");
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID", incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy", detected_by.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "Reason", reason.c_str());
+
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.ControllerRestart";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "dm_trigger_controller_restart_event: failed to trigger ControllerRestart"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " reason=" << reason;
+    } else {
+        LOG(DEBUG) << "dm_trigger_controller_restart_event: triggered ControllerRestart"
+                   << " incident_id=" << incident_id << " detected_by=" << detected_by
+                   << " reason=" << reason;
+    }
+#else // !ENABLE_NBAPI
+    (void)incident_id;
+    (void)detected_by;
+    (void)reason;
+#endif // ENABLE_NBAPI
+}
