+void HealthMonitoringTask::handle_event(uint8_t event_enum_value, const void *event_obj)
+{
+    switch (static_cast<eEvent>(event_enum_value)) {
+    case eEvent::AGENT_RESTARTING: {
+        LOG(DEBUG) << "HEALTH_MONITORING: received AGENT_RESTARTING event";
+        auto db = AgentDB::get();
+        db->dm_trigger_agent_restart_event(generate_incident_id(),
+                                           tlvf::mac_to_string(db->bridge.mac),
+                                           "internal_failure");
+        break;
+    }
+    case eEvent::FRONTHAUL_STARTED: {
+        auto fronthaul_iface = static_cast<const std::string *>(event_obj);
+        if (!fronthaul_iface) {
+            LOG(ERROR) << "HEALTH_MONITORING: FRONTHAUL_STARTED event_obj is nullptr";
+            break;
+        }
+
+        // Distinguish a genuine restart (iface already seen before) from the very first
+        // launch (iface not yet in m_fronthaul_ever_started).
+        auto insert_result = m_fronthaul_ever_started.insert(*fronthaul_iface);
+        const bool is_restart = !insert_result.second;
+
+        if (is_restart) {
+            LOG(DEBUG) << "HEALTH_MONITORING: fronthaul restart detected for "
+                       << *fronthaul_iface;
+            auto db = AgentDB::get();
+            db->dm_trigger_fronthaul_restart_event(generate_incident_id(),
+                                                    tlvf::mac_to_string(db->bridge.mac),
+                                                    *fronthaul_iface, "unknown");
+        } else {
+            LOG(DEBUG) << "HEALTH_MONITORING: first launch of fronthaul " << *fronthaul_iface;
+        }
+        break;
+    }
+    }
+}
