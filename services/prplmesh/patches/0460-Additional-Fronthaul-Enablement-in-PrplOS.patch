-int8_t ApAutoConfigurationTask::find_or_allocate_ssid_mld_unit(const std::string &ssid)
+int8_t ApAutoConfigurationTask::allocate_mld_unit(const std::string &ssid)
 {
     auto db = AgentDB::get();
 
     auto existing_it = db->ssid_mld_unit_registry.find(ssid);
     if (existing_it != db->ssid_mld_unit_registry.end()) {
-        LOG(DEBUG) << "find_or_allocate_ssid_mld_unit: reusing mld_unit="
+        LOG(DEBUG) << "allocate_mld_unit: reusing mld_unit="
                    << static_cast<int>(existing_it->second) << " for ssid=" << ssid;
         return existing_it->second;
     }
 
-    // Values already reserved by the static role-based lookup table must never be handed
-    // out here, or a Tier-2 SSID could collide with a role-based SSID active on another
-    // radio.
-    std::set<int8_t> reserved_units;
-    for (const auto &row : m_mld_unit_lookup_table) {
-        for (int8_t unit : row) {
-            if (unit != DISABLED_MLDUNIT) {
-                reserved_units.insert(unit);
-            }
-        }
-    }
+    std::set<int8_t> used_units;
     for (const auto &registry_entry : db->ssid_mld_unit_registry) {
-        reserved_units.insert(registry_entry.second);
+        used_units.insert(registry_entry.second);
     }
 
-    for (int8_t candidate = 0; candidate < static_cast<int8_t>(db->max_mlds); ++candidate) {
-        if (reserved_units.find(candidate) == reserved_units.end()) {
+    for (int8_t candidate = 1; candidate <= MLD_UNIT_MAX; ++candidate) {
+        if (used_units.find(candidate) == used_units.end()) {
             db->ssid_mld_unit_registry[ssid] = candidate;
-            LOG(DEBUG) << "find_or_allocate_ssid_mld_unit: allocated new mld_unit="
+            LOG(DEBUG) << "allocate_mld_unit: allocated new mld_unit="
                        << static_cast<int>(candidate) << " for ssid=" << ssid;
             return candidate;
         }
     }
 
-    LOG(WARNING) << "find_or_allocate_ssid_mld_unit: no free mld_unit slot for ssid=" << ssid;
+    LOG(WARNING) << "allocate_mld_unit: no free mld_unit slot for ssid=" << ssid;
     return DISABLED_MLDUNIT;
 }
 
+void ApAutoConfigurationTask::release_mld_unit(const std::string &ssid)
+{
+    auto db = AgentDB::get();
+
+    auto it = db->ssid_mld_unit_registry.find(ssid);
+    if (it != db->ssid_mld_unit_registry.end()) {
+        LOG(DEBUG) << "release_mld_unit: releasing mld_unit=" << static_cast<int>(it->second)
+                   << " for ssid=" << ssid;
+        db->ssid_mld_unit_registry.erase(it);
+    }
+}
