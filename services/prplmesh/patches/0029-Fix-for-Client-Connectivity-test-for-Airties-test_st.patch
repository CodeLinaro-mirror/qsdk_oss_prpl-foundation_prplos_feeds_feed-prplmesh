From 189def06fe3b060827753d95939d4377487ad49e Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:25:13 +0530
Subject: [PATCH 29/31] Fix for Client Connectivity test for Airties
 (test_stations)

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
index 0f038b8ae..a005411dc 100644
--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
@@ -876,12 +876,16 @@ bool Monitor::create_ap_metrics_response(uint16_t mid, const std::vector<sMacAdd
         LOG(ERROR) << "Failed creating AP_METRICS_RESPONSE_MESSAGE";
         return false;
     }
-
     for (const auto &bssid : bssid_list) {
         auto vap_node = mon_db.get_vap_node(tlvf::mac_to_string(bssid));
         if (!vap_node) {
             LOG(WARNING) << "Unknown BSSID " << bssid << " - skipping";
-            continue;
+	    update_vaps_in_db();
+	    auto vap_node_refreshed = mon_db.get_vap_node(tlvf::mac_to_string(bssid));
+	    if(!vap_node_refreshed) {
+		    LOG(WARNING) << "Unknown BSSID even after updating the vaps in DB again." << bssid << " - skipping";
+		    continue;
+	    }
         }
 
         auto radio_node = mon_db.get_radio_node();
