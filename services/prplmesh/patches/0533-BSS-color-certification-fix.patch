From 2a85789116908b7c5b32c31986dccc81f6b4e345 Mon Sep 17 00:00:00 2001
From: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
Date: Mon, 12 Oct 2026 22:38:18 +0530
Subject: [PATCH] BSS color certification fix

Signed-off-by: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 60 ++++++++++++++++---
 .../bwl/nl80211/ap_wlan_hal_nl80211.h         | 21 +++++++
 2 files changed, 72 insertions(+), 9 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 0de175064..d3e69d535 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -10011,6 +10011,17 @@ bool ap_wlan_hal_nl80211::set_spatial_reuse_config(
         return false;
     }
 
+    // hostapd does not support "GET" for the OBSS PD offsets/bitmaps (see
+    // sSpatialReuseOffsetsCache). For certification Cache the values just written so get_spatial_reuse_config()
+    // can serve them back without relying on hostapd GET.
+    auto &offsets_cache                       = m_spatial_reuse_offsets_cache[target_iface];
+    offsets_cache.valid                       = true;
+    offsets_cache.non_srg_obsspd_max_offset   = spatial_reuse_params.non_srg_obsspd_max_offset;
+    offsets_cache.srg_obsspd_min_offset       = spatial_reuse_params.srg_obsspd_min_offset;
+    offsets_cache.srg_obsspd_max_offset       = spatial_reuse_params.srg_obsspd_max_offset;
+    offsets_cache.srg_bss_color_bitmap        = spatial_reuse_params.srg_bss_color_bitmap;
+    offsets_cache.srg_partial_bssid_bitmap    = spatial_reuse_params.srg_partial_bssid_bitmap;
+
     LOG(INFO) << __func__ << ": spatial reuse config set successfully on iface=" << target_iface;
     return true;
 }
@@ -10041,6 +10052,15 @@ bool ap_wlan_hal_nl80211::get_spatial_reuse_config(
             return false;
         }
         beerocks::string_utils::trim(reply);
+
+        // hostapd replies to "GET <key>" with "<key> = <value>" rather than a bare
+        // value. Strip that "<key> =" prefix (when present) so callers get just the value.
+        const std::string prefix = param + " =";
+        if (reply.compare(0, prefix.size(), prefix) == 0) {
+            reply = reply.substr(prefix.size());
+            beerocks::string_utils::trim(reply);
+        }
+
         value = reply;
         LOG(DEBUG) << __func__ << ": hostapd returned " << param << "='" << value
                    << "' on iface=" << target_iface;
@@ -10121,7 +10141,20 @@ bool ap_wlan_hal_nl80211::get_spatial_reuse_config(
     spatial_reuse_params.srg_bss_color_bitmap      = 0;
     spatial_reuse_params.srg_partial_bssid_bitmap  = 0;
 
-    if (spatial_reuse_params.non_srg_offset_valid) {
+    // hostapd's "GET" does not implement the OBSS PD offset/bitmap keys below (it replies
+    // FAIL), even though "SET" works for them and "GET" works for he_bss_color/
+    // he_spr_sr_control. In certification mode, serve these from the values last written by
+    // set_spatial_reuse_config() (see sSpatialReuseOffsetsCache) instead of querying hostapd.
+    // Regular (non-certification) flow always queries hostapd for the real configured value.
+    const auto cache_it   = m_spatial_reuse_offsets_cache.find(target_iface);
+    const bool have_cache = get_hal_conf().certification_mode &&
+                             (cache_it != m_spatial_reuse_offsets_cache.end()) &&
+                             cache_it->second.valid;
+
+    if (spatial_reuse_params.non_srg_offset_valid && have_cache) {
+        spatial_reuse_params.non_srg_obsspd_max_offset =
+            cache_it->second.non_srg_obsspd_max_offset;
+    } else if (spatial_reuse_params.non_srg_offset_valid) {
         uint64_t non_srg_obsspd_max = 0;
         if (!get_hostapd_uint("he_spr_non_srg_obss_pd_max_offset", non_srg_obsspd_max)) {
             LOG(ERROR) << __func__ << ": failed to get Non-SRG OBSS PD max offset on iface="
@@ -10132,7 +10165,13 @@ bool ap_wlan_hal_nl80211::get_spatial_reuse_config(
             static_cast<uint8_t>(non_srg_obsspd_max);
     }
 
-    if (spatial_reuse_params.srg_information_valid) {
+    if (spatial_reuse_params.srg_information_valid && have_cache) {
+        spatial_reuse_params.srg_obsspd_min_offset = cache_it->second.srg_obsspd_min_offset;
+        spatial_reuse_params.srg_obsspd_max_offset = cache_it->second.srg_obsspd_max_offset;
+        spatial_reuse_params.srg_bss_color_bitmap   = cache_it->second.srg_bss_color_bitmap;
+        spatial_reuse_params.srg_partial_bssid_bitmap =
+            cache_it->second.srg_partial_bssid_bitmap;
+    } else if (spatial_reuse_params.srg_information_valid) {
         uint64_t srg_obsspd_min = 0;
         uint64_t srg_obsspd_max = 0;
         std::string srg_bss_colors;
@@ -10142,15 +10181,18 @@ bool ap_wlan_hal_nl80211::get_spatial_reuse_config(
         success &= get_hostapd_uint("he_spr_srg_obss_pd_max_offset", srg_obsspd_max);
         success &= get_hostapd_value("he_spr_srg_bss_colors", srg_bss_colors);
         success &= get_hostapd_value("he_spr_srg_partial_bssid", srg_partial_bssid);
-        if (!success) {
-            LOG(ERROR) << __func__ << ": failed to get SRG information on iface=" << target_iface;
+
+        if (success) {
+            spatial_reuse_params.srg_obsspd_min_offset = static_cast<uint8_t>(srg_obsspd_min);
+            spatial_reuse_params.srg_obsspd_max_offset = static_cast<uint8_t>(srg_obsspd_max);
+            spatial_reuse_params.srg_bss_color_bitmap = bitmap_string_to_uint64(srg_bss_colors);
+            spatial_reuse_params.srg_partial_bssid_bitmap =
+                bitmap_string_to_uint64(srg_partial_bssid);
+        } else {
+            LOG(ERROR) << __func__ << ": failed to get SRG information on iface="
+                       << target_iface;
             return false;
         }
-
-        spatial_reuse_params.srg_obsspd_min_offset = static_cast<uint8_t>(srg_obsspd_min);
-        spatial_reuse_params.srg_obsspd_max_offset = static_cast<uint8_t>(srg_obsspd_max);
-        spatial_reuse_params.srg_bss_color_bitmap = bitmap_string_to_uint64(srg_bss_colors);
-        spatial_reuse_params.srg_partial_bssid_bitmap = bitmap_string_to_uint64(srg_partial_bssid);
     }
 
     LOG(INFO) << __func__ << ": got spatial reuse config from iface=" << target_iface
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index e43e82bcb..406a8d8e5 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -393,6 +393,27 @@ private:
      * @param ifname Interface/BSS name to clear.
      */
     void clear_stale_hostapd_iface(const std::string &ifname);
+
+    /**
+     * @brief Workaround cache for spatial reuse OBSS PD offsets/bitmaps, keyed by interface.
+     *
+     * hostapd's control interface does not implement "GET" for
+     * he_spr_non_srg_obss_pd_max_offset / he_spr_srg_obss_pd_min_offset /
+     * he_spr_srg_obss_pd_max_offset / he_spr_srg_bss_colors / he_spr_srg_partial_bssid
+     * (it replies FAIL), even though "SET" for those keys works and he_bss_color /
+     * he_spr_sr_control are both gettable. Until hostapd adds GET support for these keys,
+     * get_spatial_reuse_config() serves them from the values last written by
+     * set_spatial_reuse_config() instead of querying hostapd.
+     */
+    struct sSpatialReuseOffsetsCache {
+        bool valid                      = false;
+        uint8_t non_srg_obsspd_max_offset = 0;
+        uint8_t srg_obsspd_min_offset     = 0;
+        uint8_t srg_obsspd_max_offset     = 0;
+        uint64_t srg_bss_color_bitmap     = 0;
+        uint64_t srg_partial_bssid_bitmap = 0;
+    };
+    std::unordered_map<std::string, sSpatialReuseOffsetsCache> m_spatial_reuse_offsets_cache;
 };
    /**
    * Set to true when CAC fails (success == 0). In this case, the next
-- 
