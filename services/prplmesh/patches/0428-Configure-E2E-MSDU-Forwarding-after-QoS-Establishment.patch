 .../master/tasks/agent_monitoring_task.cpp    | 41 +++++++++++++++++++
 .../master/tasks/agent_monitoring_task.h      | 20 +++++++++
 2 files changed, 61 insertions(+)

diff --git a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
index 605bdb82d..b9a4f71a1 100644
--- a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
+++ b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
@@ -9,6 +9,7 @@
 #include "agent_monitoring_task.h"
 #include "../db/db_algo.h"
 #include "../son_actions.h"
+#include "coordinated_tdma_task.h"
 #include "neighbor_db_ctrl_task.h"
 #include <bcl/beerocks_qos_utils.h>
 #include <bcl/beerocks_string_utils.h>
@@ -880,6 +881,14 @@ bool agent_monitoring_task::send_prioritization(const Agent &agent)
             database.clear_need_send_network_level_descriptor(
                 descriptor.bssid, descriptor.client_mac, descriptor.descriptor_key);
         }
+
+        // If the client's backhaul path spans more than one agent, notify
+        // coordinated_tdma_task so that intermediate hops can be configured
+        // (via Co-TDMA sharing/shared BSS pairs) to forward DL SCS MSDUs for
+        // this QMID.
+        if (database.config.enable_cotdma && total_hops > 1) {
+            notify_coordinated_tdma_task_for_path(path, descriptor);
+        }
     }
 
     /* Pass 2: BSS-level batch — service prioritization rule + BSS_LEVEL TLVs
@@ -952,6 +961,38 @@ bool agent_monitoring_task::send_prioritization(const Agent &agent)
     return true;
 }
 
+void agent_monitoring_task::notify_coordinated_tdma_task_for_path(
+    const std::vector<std::shared_ptr<Agent>> &path,
+    const db::sControllerQmDescriptor &descriptor)
+{
+    auto cotdma_task_id = database.get_coordinated_tdma_task_id();
+    if (cotdma_task_id == db::TASK_ID_NOT_FOUND || !tasks.is_task_running(cotdma_task_id)) {
+        LOG(DEBUG) << "coordinated_tdma_task is not running, skipping Co-TDMA setup for "
+                      "client "
+                   << descriptor.client_mac;
+        return;
+    }
+
+    auto ev = std::make_unique<coordinated_tdma_task::sSetupCotdmaForQosPathEvent>();
+    ev->agent_path.reserve(path.size());
+    for (const auto &agent : path) {
+        if (agent) {
+            ev->agent_path.push_back(agent->al_mac);
+        }
+    }
+    ev->serving_bssid = descriptor.bssid;
+    ev->client_mac     = descriptor.client_mac;
+    ev->qmid           = descriptor.qmid;
+
+    LOG(DEBUG) << "Notifying coordinated_tdma_task to set up Co-TDMA for client "
+               << descriptor.client_mac << " qmid=" << descriptor.qmid
+               << " (path length=" << ev->agent_path.size() << ")";
+
+    tasks.push_event(cotdma_task_id,
+                     static_cast<int>(coordinated_tdma_task::eEvent::SETUP_COTDMA_FOR_QOS_PATH),
+                     ev.release()); // framework (handle_event) takes ownership
+}
+
 bool agent_monitoring_task::send_qos_management_settings(const Agent &agent)
 {
     const auto settings_list = database.get_bss_qos_management_settings(agent.al_mac);
diff --git a/controller/src/beerocks/master/tasks/agent_monitoring_task.h b/controller/src/beerocks/master/tasks/agent_monitoring_task.h
index f74c33db3..abca76157 100755
--- a/controller/src/beerocks/master/tasks/agent_monitoring_task.h
+++ b/controller/src/beerocks/master/tasks/agent_monitoring_task.h
@@ -180,6 +180,26 @@ private:
     */
     bool send_prioritization(const Agent &agent);
 
+    /**
+     * @brief Notify coordinated_tdma_task to set up Co-TDMA sharing/shared BSSID
+     * configuration for the multi-hop agent path of a NETWORK_LEVEL QoS descriptor.
+     *
+     * Called from send_prioritization() whenever the client's backhaul path spans
+     * 2 or more agents (i.e. path.size() > 1), so that intermediate hops can be
+     * configured (via coordinated_tdma_task) to forward DL SCS MSDUs for the
+     * associated QMID across Co-TDMA sharing/shared BSS pairs.
+     *
+     * This is a no-op (logs and returns) if coordinated_tdma_task is not
+     * registered/running in the task pool.
+     *
+     * @param path             Ordered vector of Agents from the client-serving
+     *                         agent (path[0]) to the root-most agent (path.back()).
+     * @param descriptor       The NETWORK_LEVEL QoS descriptor being propagated
+     *                         (its bssid, client_mac and qmid fields are used).
+     */
+    void notify_coordinated_tdma_task_for_path(const std::vector<std::shared_ptr<Agent>> &path,
+                                               const db::sControllerQmDescriptor &descriptor);
+
     /**
      * @brief Send QoS management enablement settings to an Agent.
      *
