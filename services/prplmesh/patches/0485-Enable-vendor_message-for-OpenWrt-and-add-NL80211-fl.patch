+ * See LICENSE file for more details.
+ */
+
+#include "../airties_utils.h"
+
+#include "ambiorix_client.h"
+#include "wbapi_utils.h"
+
+using namespace airties;
+
+namespace {
+
+beerocks::wbapi::AmbiorixClient &ambiorix_client()
+{
+    static beerocks::wbapi::AmbiorixClient client;
+    static const bool connected =
+        client.connect(AMBIORIX_WBAPI_BACKEND_PATH, AMBIORIX_WBAPI_BUS_URI);
+
+    LOG_IF(!connected, FATAL) << "Unable to connect to the ambiorix backend!";
+    return client;
+}
+
+} // namespace
+
+bool AirtiesUtils::handle_reboot_and_factory_reset(uint8_t action_value)
+{
+    beerocks::wbapi::AmbiorixVariant args, result;
+
+    switch (action_value) {
+    case REBOOT_ACTION_VALUE:
+        return ambiorix_client().call("Device.", "Reboot", args, result);
+    case FR_VALUE:
+        return ambiorix_client().call("Device.", "FactoryReset", args, result);
+    default:
+        LOG(INFO) << "\n Neither Reboot Nor Factory Reset";
+        return false;
+    }
+}
