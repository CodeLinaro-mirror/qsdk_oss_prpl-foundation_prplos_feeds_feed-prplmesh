+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ *
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * SPDX-FileCopyrightText: 2019-2022 the prplMesh contributors (see AUTHORS.md)
+ *
+ * This code is subject to the terms of the BSD+Patent license.
+ * See LICENSE file for more details.
+ */
+
+#include "../airties_utils.h"
+
+#include <cstdlib>
+
+using namespace airties;
+
+namespace {
+
+bool run_system_command(const char *command, uint8_t action_value)
+{
+    LOG(DEBUG) << "Airties action received: " << int(action_value)
+               << ", running command: " << command;
+
+    int ret = std::system(command);
+    if (ret != 0) {
+        LOG(ERROR) << "Failed running command: " << command << ", ret=" << ret;
+        return false;
+    }
+
+    return true;
+}
+
+} // namespace
+
+bool AirtiesUtils::handle_reboot_and_factory_reset(uint8_t action_value)
+{
+    switch (action_value) {
+    case REBOOT_ACTION_VALUE:
+        return run_system_command("reboot", action_value);
+    case FR_VALUE:
+        return run_system_command("firstboot -y", action_value) &&
+               run_system_command("reboot", action_value);
+    default:
+        LOG(INFO) << "\n Neither Reboot Nor Factory Reset";
+        return false;
+    }
+}
