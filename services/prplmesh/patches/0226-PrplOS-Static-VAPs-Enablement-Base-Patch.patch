From 332dd54a18812599cc462a96bab49cfc07512542 Mon Sep 17 00:00:00 2001
From: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
Date: Thu, 18 Jun 2026 21:19:39 +0530
Subject: [PATCH] PrplOS Static VAPs Enablement - Base Patch

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.h   | 19 +++++++++++++++++
 framework/platform/wbapi/wbapi_utils.cpp      | 21 +++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
index 63a84ae0c..d298fac05 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
@@ -515,6 +515,7 @@ private:
      * based on deployment requirements. Access via get_mld_unit_from_lookup_table()
      * which handles the eVapType to index mapping.
      */
+#ifdef USE_PRPLMESH_NLHAL
     static constexpr int8_t m_mld_unit_lookup_table[8]
         [static_cast<uint8_t>(eRadioType::RADIO_TYPE_MAX)] = {
         // Format: {MLO, SLO_2G, SLO_5G, SLO_6G, SLO_5GL}
@@ -528,6 +529,24 @@ private:
         /* ISOLATED */ {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
         /* OTHER */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT}
     };
+#else // USE_PRPLMESH_WHM
+    /**
+     * MLDUnit based on PWHM Data Model Max MLD support.
+     */
+    static constexpr int8_t m_mld_unit_lookup_table[8]
+        [static_cast<uint8_t>(eRadioType::RADIO_TYPE_MAX)] = {
+        // Format: {MLO, SLO_2G, SLO_5G, SLO_6G, SLO_5GL}
+
+        /* HOME */     {1, 6, 11, 16, 21},
+        /* GUEST */    {2, 7, 12, 17, 22},
+        /* VIDEO */    {3, 8, 13, 18, 23},
+        /* BACKHAUL */ {4, 9, 14, 19, 24},
+        /* HOTSPOT */  {5, 10, 15, 20, 25},
+        /* STAFF */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
+        /* ISOLATED */ {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
+        /* OTHER */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT}
+    };
+#endif
 
     /**
      * @brief Get MLD unit from lookup table based on VAP type and radio type.
diff --git a/framework/platform/wbapi/wbapi_utils.cpp b/framework/platform/wbapi/wbapi_utils.cpp
index e318403f5..ce3bd114d 100644
--- a/framework/platform/wbapi/wbapi_utils.cpp
+++ b/framework/platform/wbapi/wbapi_utils.cpp
@@ -205,10 +205,31 @@ WSC::eWscEncr wbapi_utils::encryption_type_from_auth(WSC::eWscAuth auth)
 
 eVapType wbapi_utils::vap_type_from_custom_alias(const std::string &custom_alias)
 {
+#ifndef USE_PRPLMESH_WHM
+    if (custom_alias.find("home") != std::string::npos)
+        return eVapType::HOME;
+    else if (custom_alias.find("guest") != std::string::npos)
+        return eVapType::GUEST;
+    else if (custom_alias.find("iot") != std::string::npos)
+        return eVapType::VIDEO;
+    else if (custom_alias.find("backhaul") != std::string::npos)
+        return eVapType::BACKHAUL;
+    else if (custom_alias.find("hotspot") != std::string::npos)
+        return eVapType::HOTSPOT;
+    else if (custom_alias.find("staff") != std::string::npos)
+        return eVapType::STAFF;
+    else if (custom_alias.find("isolated") != std::string::npos)
+        return eVapType::ISOLATED;
+    else
+        return eVapType::OTHER;
+#endif
+
+#ifdef USE_PRPLMESH_NLHAL
     std::string alias_lc = custom_alias;
     std::transform(alias_lc.begin(), alias_lc.end(), alias_lc.begin(),
                    [](unsigned char c) { return std::tolower(c); });
     return son::wireless_utils::string_to_vap_type(alias_lc);
+#endif
 }
 
 int wbapi_utils::get_object_id(const std::string &object_path)
