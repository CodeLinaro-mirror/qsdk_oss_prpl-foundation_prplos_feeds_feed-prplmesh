From accf9d72dae9012000db6724a32e56ed07decddc Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Wed, 30 Sep 2026 11:49:12 +0530
Subject: [PATCH] Add device info config support in prplmesh config

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../src/tlvf_airties_utils_nl80211.cpp        | 28 ++-------
 .../bpl/board/system_ubus/bpl_board.cpp       |  9 +++
 .../bpl/cfg/dm/bpl_cfg_device_info.cpp        | 22 +++++++
 .../platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp  | 24 +++++++
 .../bpl/cfg/uci/bpl_cfg_device_info.cpp       | 62 +++++++++++++++++--
 framework/platform/bpl/include/bpl/bpl_cfg.h  | 16 +++++
 6 files changed, 132 insertions(+), 29 deletions(-)

diff --git a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
index eebdafd11..ad0f580d8 100644
--- a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
+++ b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
@@ -32,9 +32,7 @@
 #include <tlvf/airties/tlvAirtiesEthNon1905NeighborDeviceList.h>
 #include <tlvf/ieee_1905_1/sVendorOUI.h>
 #include <tlvf/common/sMacAddr.h>
-#ifndef BEEROCKS_RDKB
-#include <bpl/cfg/uci/bpl_cfg_uci.h>
-#endif
+#include <bpl/bpl_cfg.h>
 
 #include <climits>
 #include <cstdlib>
@@ -483,31 +481,15 @@ void update_client_details(std::shared_ptr<airties::tlvAirtiesDeviceInfo> &tlvDe
     std::string client_id;
     std::string client_secret;
 
-#ifndef BEEROCKS_RDKB
-    const bool is_client_id_present =
-        beerocks::bpl::uci_get_string("client_id", client_id);
-    const bool is_client_secret_present =
-        beerocks::bpl::uci_get_string("client_password", client_secret);
-#else
-    const bool is_client_id_present = false;
-    const bool is_client_secret_present = false;
-#endif
+    const bool is_client_id_present = beerocks::bpl::cfg_get_client_id(client_id);
+    const bool is_client_secret_present = beerocks::bpl::cfg_get_client_password(client_secret);
 
     if (!is_client_id_present || client_id.empty()) {
-        LOG(WARNING) << "UCI: missing prplmesh.config.ClientID";
+        LOG(WARNING) << "BPL: missing or empty client_id, using default";
         client_id = kDefaultClientId;
     }
     if (!is_client_secret_present || client_secret.empty()) {
-        LOG(WARNING) << "UCI: missing prplmesh.config.ClientPassword";
-        client_secret = kDefaultClientSecret;
-    }
-
-    if (!is_client_id_present) {
-        LOG(WARNING) << "UCI: missing prplmesh.config.ClientID";
-        client_id = kDefaultClientId;
-    }
-    if (!is_client_secret_present) {
-        LOG(WARNING) << "UCI: missing prplmesh.config.ClientPassword";
+        LOG(WARNING) << "BPL: missing or empty client_password, using default";
         client_secret = kDefaultClientSecret;
     }
 
diff --git a/framework/platform/bpl/board/system_ubus/bpl_board.cpp b/framework/platform/bpl/board/system_ubus/bpl_board.cpp
index 44b12ca68..d097c5e5b 100644
--- a/framework/platform/bpl/board/system_ubus/bpl_board.cpp
+++ b/framework/platform/bpl/board/system_ubus/bpl_board.cpp
@@ -182,6 +182,15 @@ bool get_board_info(sBoardInfo &board_info)
 
     board_info.manufacturer = board_params.board_name.substr(0, board_params.board_name.find(","));
     board_info.manufacturer_model = board_params.model;
+
+    std::string value;
+    if (cfg_get_manufacturer_override(value)) {
+        board_info.manufacturer = value;
+    }
+    if (cfg_get_model_name_override(value)) {
+        board_info.manufacturer_model = value;
+    }
+
     beerocks::bpl::get_serial_number(board_info.serial_number);
     beerocks::bpl::get_model_number(board_info.model_number);
 
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_device_info.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_device_info.cpp
index cbd47a723..a0117157d 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_device_info.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_device_info.cpp
@@ -57,6 +57,11 @@ bool get_manufacturer(std::string &manufacturer)
     return true;
 }
 
+bool cfg_get_manufacturer_override(std::string &manufacturer)
+{
+    return get_string_value_dm("Manufacturer", manufacturer) && !manufacturer.empty();
+}
+
 bool get_model_name(std::string &model_name)
 {
     if (!get_string_value_dm("ModelName", model_name) || model_name.empty()) {
@@ -66,6 +71,11 @@ bool get_model_name(std::string &model_name)
     return true;
 }
 
+bool cfg_get_model_name_override(std::string &model_name)
+{
+    return get_string_value_dm("ModelName", model_name) && !model_name.empty();
+}
+
 bool get_model_number(std::string &model_number)
 {
     if (!get_string_value_dm("ModelNumber", model_number) || model_number.empty()) {
@@ -90,5 +100,17 @@ bool get_max_prioritization_rules(uint32_t &max_prioritization_rules)
     return true;
 }
 
+bool cfg_get_client_id(std::string &client_id)
+{
+    client_id.clear();
+    return false;
+}
+
+bool cfg_get_client_password(std::string &client_password)
+{
+    client_password.clear();
+    return false;
+}
+
 } // namespace bpl
 } // namespace beerocks
diff --git a/framework/platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp b/framework/platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp
index b65f517ad..24cba062c 100644
--- a/framework/platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp
+++ b/framework/platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp
@@ -99,12 +99,24 @@ bool get_manufacturer(std::string &manufacturer)
     return true;
 }
 
+bool cfg_get_manufacturer_override(std::string &manufacturer)
+{
+    manufacturer.clear();
+    return false;
+}
+
 bool get_model_name(std::string &model_name)
 {
     model_name = "Ubuntu";
     return true;
 }
 
+bool cfg_get_model_name_override(std::string &model_name)
+{
+    model_name.clear();
+    return false;
+}
+
 bool get_model_number(std::string &model_number)
 {
     model_number = "modelnumber12345";
@@ -129,5 +141,17 @@ bool cfg_get_dhcp_gateway_ip(const std::string &iface, std::string &gw_ip)
     return false;
 }
 
+bool cfg_get_client_id(std::string &client_id)
+{
+    client_id.clear();
+    return false;
+}
+
+bool cfg_get_client_password(std::string &client_password)
+{
+    client_password.clear();
+    return false;
+}
+
 } // namespace bpl
 } // namespace beerocks
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_device_info.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_device_info.cpp
index 70b358f37..3f6b60d75 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_device_info.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_device_info.cpp
@@ -10,16 +10,38 @@
 #include <bpl/bpl_cfg.h>
 #include <mapf/common/logger.h>
 
+#include "bpl_cfg_helper.h"
+#include "bpl_cfg_uci.h"
+
 namespace beerocks {
 namespace bpl {
 
+namespace {
+
+bool get_prplmesh_config_string(const std::string &param, std::string &value)
+{
+    char buf[MAX_UCI_BUF_LEN] = {0};
+
+    if (cfg_get_prplmesh_param(param, buf, sizeof(buf)) != RETURN_OK || buf[0] == '\0') {
+        value.clear();
+        return false;
+    }
+
+    value = buf;
+    return true;
+}
+
+} // namespace
+
 /*
  * Function to get the Serial Number
- * Returns default value for NLHAL builds
+ * Returns configured value or default value for NLHAL builds
  */
 bool get_serial_number(std::string &serial_number)
 {
-    serial_number = "prplmesh12345";
+    if (!get_prplmesh_config_string("serial_number", serial_number)) {
+        serial_number = "prplmesh12345";
+    }
     return true;
 }
 
@@ -29,7 +51,9 @@ bool get_serial_number(std::string &serial_number)
  */
 bool get_software_version(std::string &software_version)
 {
-    software_version = beerocks::version::get_module_version();
+    if (!get_prplmesh_config_string("software_version", software_version)) {
+        software_version = beerocks::version::get_module_version();
+    }
     return true;
 }
 
@@ -39,30 +63,56 @@ bool get_software_version(std::string &software_version)
  */
 bool get_manufacturer(std::string &manufacturer)
 {
-    manufacturer = "prplMesh";
+    if (!get_prplmesh_config_string("manufacturer", manufacturer)) {
+        manufacturer = "prplMesh";
+    }
     return true;
 }
 
+bool cfg_get_manufacturer_override(std::string &manufacturer)
+{
+    return get_prplmesh_config_string("manufacturer", manufacturer);
+}
+
 /*
  * Function to get the Model Name
  * Returns default value for NLHAL builds
  */
 bool get_model_name(std::string &model_name)
 {
-    model_name = "OpenWrt";
+    if (!get_prplmesh_config_string("model_name", model_name)) {
+        model_name = "OpenWrt";
+    }
     return true;
 }
 
+bool cfg_get_model_name_override(std::string &model_name)
+{
+    return get_prplmesh_config_string("model_name", model_name);
+}
+
 /*
  * Function to get the Model Number
  * Returns default value for NLHAL builds
  */
 bool get_model_number(std::string &model_number)
 {
-    model_number = "modelnumber12345";
+    if (!get_prplmesh_config_string("model_number", model_number)) {
+        model_number = "modelnumber12345";
+    }
     return true;
 }
 
+bool cfg_get_client_id(std::string &client_id)
+{
+    return get_prplmesh_config_string("client_id", client_id);
+}
+
+bool cfg_get_client_password(std::string &client_password)
+{
+    return get_prplmesh_config_string("client_password", client_password);
+}
+
 /*
  * Function to get max prioritization rules
  * Not supported in NLHAL builds
diff --git a/framework/platform/bpl/include/bpl/bpl_cfg.h b/framework/platform/bpl/include/bpl/bpl_cfg.h
index 734a612f8..5270f7a22 100644
--- a/framework/platform/bpl/include/bpl/bpl_cfg.h
+++ b/framework/platform/bpl/include/bpl/bpl_cfg.h
@@ -1435,6 +1435,14 @@ bool get_software_version(std::string &software_version);
  */
 bool get_manufacturer(std::string &manufacturer);
 
+/**
+ * @brief Get an optional configured manufacturer override.
+ *
+ * @param [out] manufacturer  configured manufacturer override.
+ * @return true if an override is present, otherwise false.
+ */
+bool cfg_get_manufacturer_override(std::string &manufacturer);
+
 /**
  * @brief Get a string identifying the model name
  *
@@ -1443,6 +1451,14 @@ bool get_manufacturer(std::string &manufacturer);
  */
 bool get_model_name(std::string &model_name);
 
+/**
+ * @brief Get an optional configured model name override.
+ *
+ * @param [out] model_name  configured model name override.
+ * @return true if an override is present, otherwise false.
+ */
+bool cfg_get_model_name_override(std::string &model_name);
+
 /**
  * @brief Get a string identifying the model number
  *
