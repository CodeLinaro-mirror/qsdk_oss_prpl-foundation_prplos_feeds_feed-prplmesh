From ae562f402343ae415d3edc0ccb9f6bddb00b0207 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 1 Oct 2026 11:47:31 +0530
Subject: [PATCH] nlhal update vap credentials process lock

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 845b024ae..5efd059ca 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -18,8 +18,12 @@
 #include <bcl/son/son_wireless_utils.h>
 #include <bpl/bpl_cfg.h>
 #include <bwl/key_value_parser.h>
+#include <cerrno>
 #include <chrono>
 #include <cmath>
+#include <fcntl.h>
+#include <cstring>
+#include <unistd.h>
 #include <cstdio>
 #include <iomanip>
 #include <sstream>
@@ -64,6 +68,76 @@ static constexpr auto MLD_ADD_TARGET_READY_RETRY_DELAY = std::chrono::millisecon
 static constexpr char MLD_RECONFIG_LOCK_PATH[] =
     "/var/lock/prplmesh-mld-reconfig.lock";
 
+// A credential update changes hostapd configuration shared by all radio processes and may
+// create/remove MLO links. Hold this lock for the complete transaction so another radio
+// cannot start an MLD operation against partially updated credentials.
+static constexpr const char *VAP_CREDENTIALS_LOCK_PATH =
+    "/var/lock/prplmesh-update-vap-credentials.lock";
+
+class vap_credentials_lock_guard {
+public:
+    explicit vap_credentials_lock_guard(const char *path)
+    {
+        m_fd = open(path, O_CREAT | O_RDWR, 0644);
+        if (m_fd < 0) {
+            LOG(ERROR) << "update_vap_credentials: failed to open lock " << path << ": "
+                       << strerror(errno);
+            return;
+        }
+
+        struct flock lock{};
+        lock.l_type   = F_WRLCK;
+        lock.l_whence = SEEK_SET;
+        lock.l_start  = 0;
+        lock.l_len    = 0;
+        while (fcntl(m_fd, F_SETLKW, &lock) < 0) {
+            if (errno != EINTR) {
+                LOG(ERROR) << "update_vap_credentials: failed to acquire lock " << path << ": "
+                           << strerror(errno);
+                close(m_fd);
+                m_fd = -1;
+                return;
+            }
+        }
+
+        m_locked = true;
+        LOG(DEBUG) << "update_vap_credentials: acquired lock " << path;
+    }
+
+    ~vap_credentials_lock_guard()
+    {
+        if (m_fd < 0) {
+            return;
+        }
+
+        if (m_locked) {
+            struct flock lock{};
+            lock.l_type   = F_UNLCK;
+            lock.l_whence = SEEK_SET;
+            lock.l_start  = 0;
+            lock.l_len    = 0;
+            if (fcntl(m_fd, F_SETLK, &lock) < 0) {
+                LOG(WARNING) << "update_vap_credentials: failed to release lock: "
+                             << strerror(errno);
+            } else {
+                LOG(DEBUG) << "update_vap_credentials: released lock";
+            }
+        }
+        close(m_fd);
+    }
+
+    vap_credentials_lock_guard(const vap_credentials_lock_guard &) = delete;
+    vap_credentials_lock_guard &operator=(const vap_credentials_lock_guard &) = delete;
+
+    bool locked() const { return m_locked; }
+
+private:
+    int  m_fd     = -1;
+    bool m_locked = false;
+};
+
+
+
 class ScopedMldReconfigLock {
 public:
     ScopedMldReconfigLock(const std::string &iface, const char *operation)
@@ -5240,6 +5314,13 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
 {
     LOG(INFO) << "Update vap credentials: " << m_radio_info.iface_name<<" freq of radio is: " << m_radio_info.frequency_band;
     
+    // Serialize the complete cross-radio transaction. The next process waits until this
+    // invocation has finished all credential, reload, and MLO link operations.
+    vap_credentials_lock_guard lock_guard(VAP_CREDENTIALS_LOCK_PATH);
+    if (!lock_guard.locked()) {
+        return false;
+    }
+
     std::string base_interface="";
     extractLinkBaseInterface(m_radio_info.iface_name, base_interface);
 
-- 
