From 551376000de5cb70593c6b1373bd47640542f992 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Mon, 2 Feb 2026 14:50:29 +0530
Subject: [PATCH 05/10] rador changes

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 |   1 +
 .../beerocks/slave/cac_status_database.cpp    |  23 +++-
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 126 ++++++++++++++++--
 .../bwl/nl80211/ap_wlan_hal_nl80211.h         |   6 +
 4 files changed, 142 insertions(+), 14 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 974df2bcb..bff381d5f 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2514,6 +2514,7 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
     } break;
 
     // ACS/CSA Completed
+    case Event::DFS_RADAR_Detected:
     case Event::ACS_Completed:
     case Event::CSA_Finished: {
 
diff --git a/agent/src/beerocks/slave/cac_status_database.cpp b/agent/src/beerocks/slave/cac_status_database.cpp
index 587ab9027..1f636185b 100644
--- a/agent/src/beerocks/slave/cac_status_database.cpp
+++ b/agent/src/beerocks/slave/cac_status_database.cpp
@@ -117,10 +117,25 @@ bool CacStatusDatabase::update_cac_status_db(const AgentDB::sRadio *radio)
                 active_channels.push_back(cac_status);
             }
             break;
-        case beerocks_message::eDfsState::NOT_DFS:
-            continue;
-        default:
-            LOG(ERROR) << "Undefined DFS state " << channel_info.dfs_state
+	case beerocks_message::eDfsState::NOT_DFS:
+	    // Added code for NOT DFS channels to get available channel count
+	    for (auto &bw_info : channel_info.supported_bw_list) {
+		    beerocks::WifiChannel wifi_ch(channel, freq_type, bw_info.bandwidth);
+		    cac_status.operating_class =
+			    son::wireless_utils::get_operating_class_by_channel(wifi_ch);
+		    if (!cac_status.operating_class) {
+			    LOG(WARNING) << "Skipping invalid operating class for channel: " << channel;
+			    continue;
+		    }
+		    cac_status.channel = channel;
+
+		    // TODO: calculate duration value
+		    cac_status.duration = std::chrono::seconds(0);
+		    available_channels.push_back(cac_status);
+	    }
+	    break;
+	default:
+	    LOG(ERROR) << "Undefined DFS state " << channel_info.dfs_state
                        << ", radio: " << radio->front.iface_mac;
             continue;
         }
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 6895c98bb..8d55fa033 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -82,6 +82,10 @@ static ap_wlan_hal::Event nl80211_to_bwl_event(const std::string &opcode)
         return ap_wlan_hal::Event::ACS_Failed;
     } else if (opcode == "AP-CSA-FINISHED") {
         return ap_wlan_hal::Event::CSA_Finished;
+    } else if (opcode == "DFS-RADAR-DETECTED") {
+	return ap_wlan_hal::Event::DFS_RADAR_Detected;
+    } else if (opcode == "DFS-CAC-START") {
+	return ap_wlan_hal::Event::DFS_CAC_Started;
     } else if (opcode == "CTRL-EVENT-CHANNEL-SWITCH") {
         return ap_wlan_hal::Event::CTRL_Channel_Switch;
     } else if (opcode == "BSS-TM-RESP") {
@@ -2470,21 +2474,123 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
             m_radio_info.is_5ghz = true;
         }
     } break;
-    // ACS/CSA Completed
+
+    case Event::DFS_CAC_Started: {
+	auto msg_buff =
+	ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_HOSTAP_DFS_CAC_STARTED_NOTIFICATION));
+	auto msg = reinterpret_cast<sACTION_APMANAGER_HOSTAP_DFS_CAC_STARTED_NOTIFICATION *>(
+	msg_buff.get());
+	LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+
+	// Initialize the message
+	memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_HOSTAP_DFS_CAC_STARTED_NOTIFICATION));
+
+	// Channel
+	msg->params.channel = beerocks::string_utils::stoi(parsed_obj["chan"]);
+
+	// Secondary Channel
+	std::string tmp_string = parsed_obj["sec_chan"];
+	beerocks::string_utils::rtrim(tmp_string, ",");
+	msg->params.secondary_channel = beerocks::string_utils::stoi(tmp_string);
+
+	// Bandwidth
+	std::string bandwidth = parsed_obj["ch_width"];
+	msg->params.bandwidth = beerocks::utils::convert_bandwidth_to_enum(wpa_bw_to_beerocks_bw(bandwidth));
+
+	// CAC Duration
+	tmp_string = parsed_obj["cac_time"];
+	beerocks::string_utils::rtrim(tmp_string, "s");
+	msg->params.cac_duration_sec = beerocks::string_utils::stoi(tmp_string);
+
+	// Reset the flag at CAC_Started. It will be updated again on CAC_Completed.
+	m_accept_dfs_channel_change_after_cac_failure = false;
+
+	// Add the message to the queue
+	event_queue_push(Event::DFS_CAC_Started, msg_buff);
+	} break;
+
+    case Event::DFS_CAC_Completed: {
+
+	if (!get_radio_info().is_5ghz) {
+		LOG(WARNING) << "interface: " << interface << " not 5GHz radio!";
+		return true;
+	 }
+	auto msg_buff =
+	ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_HOSTAP_DFS_CAC_COMPLETED_NOTIFICATION));
+	auto msg = reinterpret_cast<sACTION_APMANAGER_HOSTAP_DFS_CAC_COMPLETED_NOTIFICATION *>(
+	msg_buff.get());
+	LOG(INFO) << "Memory allocation failed!";
+
+	// Initialize the message
+	 memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_HOSTAP_DFS_CAC_COMPLETED_NOTIFICATION));
+
+	// CAC Status
+	std::string success = parsed_obj["cac_status"];
+	if (success.empty()) {
+		// Some wpaCtrl_events still received with "success" parameter and we should support it as well
+		success = parsed_obj["success"];
+	if (success.empty()) {
+		LOG(ERROR) << "Failed reading cac finished success parameter!";
+		return false;
+		}
+	}
+	msg->params.success = beerocks::string_utils::stoi(success);
+
+	/**
+	* CAC failed (success == 0), meaning the radio will switch to a non-DFS channel.
+	* In this case we expect a DFS-triggered channel change event, and we must
+	* accept it rather than ignore it.
+	*/
+	m_accept_dfs_channel_change_after_cac_failure = (msg->params.success == 0);
+
+	// Frequency
+	msg->params.frequency = beerocks::string_utils::stoi(parsed_obj["freq"]);
+
+	// Center frequency 1
+	msg->params.center_frequency1 = beerocks::string_utils::stoi(parsed_obj["cf1"]);
+
+	// Center frequency 2
+	msg->params.center_frequency2 = beerocks::string_utils::stoi(parsed_obj["cf2"]);
+
+	// Channel
+	msg->params.channel = son::wireless_utils::freq_to_channel(msg->params.frequency);
+
+	// Timeout
+	std::string timeout = parsed_obj["timeout"];
+	if (!timeout.empty()) {
+		msg->params.timeout = beerocks::string_utils::stoi(timeout);
+	 }
+	// Bandwidth
+	std::string bandwidth = parsed_obj["ch_width"];
+	msg->params.bandwidth = beerocks::utils::convert_bandwidth_to_enum(wpa_bw_to_beerocks_bw(bandwidth));
+
+	// Add the message to the queue
+	event_queue_push(Event::DFS_CAC_Completed, msg_buff);
+	} break;
+
+
+// ACS/CSA Completed
+    case Event::DFS_RADAR_Detected:
     case Event::ACS_Completed:
-    case Event::CSA_Finished:
-        event_queue_push(event);
-        break;
+    case Event::CSA_Finished: {
+	ChanSwReason chanSwReason = ChanSwReason::Unknown;
+	if (opcode == "DFS-RADAR-DETECTED") {
+		chanSwReason = ChanSwReason::Radar;
+	}
+	m_radio_info.last_csa_sw_reason = chanSwReason;
+	event_queue_push(event);
+	} break;
+
     case Event::Interface_Disabled:
     case Event::ACS_Failed: {
-        // Forward to the AP manager
-        event_queue_push(event);
-    } break;
+	 // Forward to the AP manager
+	 event_queue_push(event);
+	} break;
 
     case Event::AP_Disabled: {
-        auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sHOSTAP_DISABLED_NOTIFICATION));
-        auto msg      = reinterpret_cast<sHOSTAP_DISABLED_NOTIFICATION *>(msg_buff.get());
-        LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+	 auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sHOSTAP_DISABLED_NOTIFICATION));
+	 auto msg      = reinterpret_cast<sHOSTAP_DISABLED_NOTIFICATION *>(msg_buff.get());
+	 LOG_IF(!msg, FATAL) << "Memory allocation failed!";
 
         memset(msg_buff.get(), 0, sizeof(sHOSTAP_DISABLED_NOTIFICATION));
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index dbfe29e5e..9e81060f0 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -181,6 +181,12 @@ private:
         m_latest_assoc_frame = {};
     uint16_t m_aid           = 2007; // AIDs must be in the range 1-2007
 };
+   /**
+   * Set to true when CAC fails (success == 0). In this case, the next
+   * DFS-triggered channel change event is accepted and processed instead
+   * of being ignored.
+   */
+   bool m_accept_dfs_channel_change_after_cac_failure = false;
 
 } // namespace nl80211
 } // namespace bwl
-- 
2.34.1

