+ * @brief Gets the MLD ID for a given interface from the wifi-mld UCI section.
+ *
+ * Searches all wifi-mld sections for one whose ifname option matches @p iface.
+ * If found, derives the mld_id value (section digit minus 1) that is consistent
+ * with bpl_cfg_set_wifi_credentials so the existing section is reused.
+ *
+ * @param [in]  iface   Interface name to look up (e.g. "wlan0_1").
+ * @param [out] mld_id  MLD ID string if found (e.g. "0" for wifi-mld section "mld1").
+ * @return true if a matching wifi-mld section was found, false otherwise.
+ */
+bool bpl_cfg_get_mld_id_by_iface(const std::string &iface, std::string &mld_id);
+
+/**
+ * @brief Fetches the VAP interface name for a given SSID and radio_id from UCI wireless config.
+ *
+ * Steps:
+ * 1. Find the wifi-device section that has the given radio_id.
+ * 2. Check all wifi-iface sections that belong to that wifi-device.
+ * 3. If the SSID matches, check if ifname option is present:
+ *    - If present: set new_vap_iface_name to ifname.
+ *    - If not present: check if mld option is present.
+ *      - If mld option present: get ifname from the corresponding wifi-mld section.
+ *
+ * @param [in]  ssid               SSID to search for.
+ * @param [in]  radio_id           Radio identifier (e.g. "radio0").
+ * @param [out] new_vap_iface_name The fetched VAP interface name.
+ * @return true on success (name found), false otherwise.
+ */
+bool bpl_cfg_get_vap_ifname_by_ssid_and_radio(const std::string &ssid,
+                                               const std::string &radio_id,
+                                               std::string &new_vap_iface_name);
+
 } // namespace bpl
 } // namespace beerocks
 
