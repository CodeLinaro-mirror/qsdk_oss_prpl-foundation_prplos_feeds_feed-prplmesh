@@ -1752,6 +1752,27 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc_renew(
 
     db->statuses.controller_discovery_completed = false;
 
+    // Clear the MLD pair entrant file before starting the new autoconfiguration round.
+    // This file is used only by the NL80211 HAL to coordinate MLD group assignments
+    // across the radio processes; stale entries from the previous round must be removed
+    // so that the new round starts with a clean slate.  The clear is done here — once
+    // per AP_AUTOCONFIG_RENEW message, before the FSM is moved — rather than inside
+    // update_vap_credentials, to avoid the race that arises when all three radio
+    // processes call update_vap_credentials simultaneously.
+#ifdef USE_PRPLMESH_NLHAL
+    {
+        const char *mld_entrant_file = "/tmp/beerocks/mld_pair_entrant.txt";
+        FILE *f = fopen(mld_entrant_file, "w");
+        if (f) {
+            fclose(f);
+            LOG(INFO) << "handle_ap_autoconfiguration_wsc_renew: cleared " << mld_entrant_file;
+        } else {
+            LOG(WARNING) << "handle_ap_autoconfiguration_wsc_renew: failed to clear "
+                         << mld_entrant_file;
+        }
+    }
+#endif // USE_PRPLMESH_NLHAL
+
     for (const auto radio : db->get_radios_list()) {
         if (!radio) {
             return;
