+bool bpl_cfg_get_mld_id_by_iface(const std::string &iface, std::string &mld_id)
+{
+    const std::string package_name     = "wireless";
+    const std::string mld_section_type = "wifi-mld";
+
+    // Get all wifi-mld sections
+    std::vector<std::string> all_mld_sections;
+    if (!uci_get_all_sections(package_name, mld_section_type, all_mld_sections)) {
+        LOG(DEBUG) << "bpl_cfg_get_mld_id_by_iface: no wifi-mld sections found";
+        return false;
+    }
+
+    for (const auto &mld_sec : all_mld_sections) {
+        std::string ifname_val;
+        if (!uci_get_option(package_name, mld_section_type, mld_sec, "ifname", ifname_val)) {
+            continue;
+        }
+
+        if (ifname_val != iface) {
+            continue;
+        }
+
+        // Found a wifi-mld section whose ifname matches.
+        // Extract the numeric suffix from the section name (e.g. "mld1" -> 1).
+        // bpl_cfg_set_wifi_credentials creates sections as "mld" + (mld_id_val + 1),
+        // so we subtract 1 to recover the original mld_id_val.
+        std::string mld_index_str;
+        for (char ch : mld_sec) {
+            if (isdigit(static_cast<unsigned char>(ch))) {
+                mld_index_str += ch;
+            }
+        }
+
+        if (mld_index_str.empty()) {
+            LOG(WARNING) << "bpl_cfg_get_mld_id_by_iface: section " << mld_sec
+                         << " has no numeric suffix, skipping";
+            continue;
+        }
+
+        int mld_index = beerocks::string_utils::stoi(mld_index_str);
+        mld_id        = std::to_string(mld_index - 1);
+        LOG(INFO) << "bpl_cfg_get_mld_id_by_iface: iface=" << iface
+                  << " found in wifi-mld section=" << mld_sec
+                  << " -> mld_id=" << mld_id;
+        return true;
+    }
+
+    LOG(DEBUG) << "bpl_cfg_get_mld_id_by_iface: no wifi-mld section found for iface=" << iface;
+    return false;
+}
+
+bool bpl_cfg_get_vap_ifname_by_ssid_and_radio(const std::string &ssid,
+                                               const std::string &radio_id,
+                                               std::string &new_vap_iface_name)
+{
+    const std::string package_name    = "wireless";
+    const std::string section_type    = "wifi-iface";
+    const std::string mld_section_type = "wifi-mld";
+
+    // Step 1: Find the wifi-device section that has the given radio_id
+    std::string device_section;
+    if (!uci_find_section_by_option(package_name, "wifi-device", "radio", radio_id,
+                                    device_section) ||
+        device_section.empty()) {
+        LOG(ERROR) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: no wifi-device section found"
+                   << " for radio_id=" << radio_id;
+        return false;
+    }
+
+    LOG(DEBUG) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: device_section=" << device_section
+               << " for radio_id=" << radio_id;
+
+    // Step 2: Get all wifi-iface sections
+    std::vector<std::string> all_iface_sections;
+    if (!uci_get_all_sections(package_name, section_type, all_iface_sections)) {
+        LOG(ERROR) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: failed to get all wifi-iface sections";
+        return false;
+    }
+
+    // Step 3: Iterate over wifi-iface sections belonging to the target wifi-device
+    for (const auto &sec : all_iface_sections) {
+        // Check if this section belongs to the target wifi-device
+        std::string device_val;
+        if (!uci_get_option(package_name, section_type, sec, "device", device_val) ||
+            device_val != device_section) {
+            continue;
+        }
+
+        // Check if SSID matches
+        std::string ssid_val;
+        if (!uci_get_option(package_name, section_type, sec, "ssid", ssid_val) ||
+            ssid_val != ssid) {
+            continue;
+        }
+
+        // SSID matched - check if ifname option is present
+        std::string ifname_val;
+        if (uci_get_option(package_name, section_type, sec, "ifname", ifname_val) &&
+            !ifname_val.empty()) {
+            new_vap_iface_name = ifname_val;
+            LOG(DEBUG) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: found ifname="
+                       << new_vap_iface_name << " in section=" << sec
+                       << " for ssid=" << ssid;
+            return true;
+        }
+
+        // ifname not present - check if mld option is present
+        std::string mld_val;
+        if (uci_get_option(package_name, section_type, sec, "mld", mld_val) &&
+            !mld_val.empty()) {
+            // Get ifname from the corresponding wifi-mld section
+            std::string mld_ifname_val;
+            if (uci_get_option(package_name, mld_section_type, mld_val, "ifname",
+                               mld_ifname_val) &&
+                !mld_ifname_val.empty()) {
+                new_vap_iface_name = mld_ifname_val;
+                LOG(DEBUG) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: found ifname="
+                           << new_vap_iface_name << " from wifi-mld section=" << mld_val
+                           << " for ssid=" << ssid;
+                return true;
+            }
+            LOG(WARNING) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: wifi-mld section="
+                         << mld_val << " has no ifname for ssid=" << ssid;
+        }
+
+        LOG(DEBUG) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: section=" << sec
+                   << " matched ssid=" << ssid << " but has no ifname or mld option";
+    }
+
+    LOG(DEBUG) << "bpl_cfg_get_vap_ifname_by_ssid_and_radio: no match found for ssid=" << ssid
+               << " radio_id=" << radio_id;
+    return false;
+}
