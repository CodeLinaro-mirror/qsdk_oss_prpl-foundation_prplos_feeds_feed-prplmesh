+void coordinated_tdma_task::retry_pending_mapc_reports_for_bssid(const sMacAddr &bssid)
+{
+    for (auto it = m_pending_mapc_capability_updates.begin();
+         it != m_pending_mapc_capability_updates.end();) {
+        if (it->peer_bssid != bssid) {
+            ++it;
+            continue;
+        }
+
+        // Take a copy of the pending entry before erasing it below, since apply/finalize
+        // reference fields on it (and iterators into the vector may be invalidated by other
+        // erases in the same loop pass).
+        const sPendingMapcCapabilityUpdate pending = *it;
+
+        TASK_LOG(DEBUG) << "retry_pending_mapc_reports_for_bssid: peer_bssid=" << bssid
+                        << " now resolvable, re-applying deferred MAPC Capability Update "
+                           "entry (sharing_bssid="
+                        << pending.local_bssid << ", src_mac=" << pending.src_mac << ")";
+
+        // Re-verify the sharing BSSID (local_bssid) is still valid/fronthaul on the
+        // originally-reporting Agent - it may have been torn down in the interim.
+        auto local_bss = database.get_bss(pending.local_bssid, pending.src_mac);
+        if (!local_bss || !local_bss->fronthaul) {
+            TASK_LOG(WARNING) << "retry_pending_mapc_reports_for_bssid: sharing_bssid="
+                              << pending.local_bssid << " (agent " << pending.src_mac
+                              << ") no longer valid/fronthaul, dropping deferred entry for "
+                                 "peer_bssid="
+                              << bssid;
+            it = m_pending_mapc_capability_updates.erase(it);
+            continue;
+        }
+
+        auto &sharing_entry = local_bss->mapc_sharing_bss;
+        // The sharing BSSID must already have been marked valid when the original report
+        // was received (is_valid is set unconditionally in handle_mapc_capability_update()
+        // before any peer_bss_capabilities entry - resolvable or not - is processed), so
+        // is_new_sharing_bssid is always false here.
+        bool shared_bssid_list_changed = false;
+        std::vector<sMacAddr> new_cotdma_shared_bssids;
+
+        apply_mapc_peer_bss_entry(pending.local_bssid, sharing_entry, pending.peer_bssid,
+                                  pending.peer_mapc_capability_bitmap, shared_bssid_list_changed,
+                                  new_cotdma_shared_bssids);
+
+        finalize_mapc_capability_update(pending.src_mac, pending.local_bssid, sharing_entry,
+                                        /*is_new_sharing_bssid=*/false, shared_bssid_list_changed,
+                                        new_cotdma_shared_bssids);
+
+        it = m_pending_mapc_capability_updates.erase(it);
+    }
+}
