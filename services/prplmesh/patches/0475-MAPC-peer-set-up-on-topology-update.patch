+                          << it->local_bssid << " peer_bssid=" << it->peer_bssid << " src_mac="
+                          << it->src_mac << ") after " << PENDING_MAPC_REPORT_TIMEOUT.count()
+                          << "s without the peer BSSID becoming resolvable";
