+void coordinated_tdma_task::check_pending_mapc_report_timeouts()
+{
+    const auto now = std::chrono::steady_clock::now();
+
+    for (auto it = m_pending_mapc_capability_updates.begin();
+         it != m_pending_mapc_capability_updates.end();) {
