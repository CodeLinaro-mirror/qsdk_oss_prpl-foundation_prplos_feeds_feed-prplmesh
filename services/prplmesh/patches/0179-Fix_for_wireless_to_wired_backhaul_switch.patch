From 8ffd13bf16b1363bf242c1dbcfe7ea49b2eff342 Mon Sep 17 00:00:00 2001
From: Dhivya <dsankar@qti.qualcomm.com>
Date: Thu, 28 May 2026 16:03:55 +0530
Subject: [PATCH] Fix_for_wireless_to_wired_backhaul_switch

Signed-off-by: Dhivya <dsankar@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     |  6 ++++
 .../tasks/controller_connectivity_task.cpp    |  5 +++
 .../ieee1905_transport_network.cpp            | 35 +++++++++++--------
 3 files changed, 32 insertions(+), 14 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index a12868e..210d0eb 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1058,6 +1058,12 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
 
                     send_slaves_enable();
 
+                    // Mark the connection as WIRED
+                    db->backhaul.connection_type          = AgentDB::sBackhaul::eConnectionType::Wired;
+                    db->backhaul.selected_iface_name      = db->ethernet.wan.iface_name;
+                    db->backhaul.selected_iface_radio_mac = net::network_utils::ZERO_MAC;
+                    LOG(DEBUG) << "Moved to WIRED BACKHAUL";
+
                     // Wireless to wired switching - enable all FH VAPs after triggering STA disconnection
                     if (m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
                         auto fh_vaps_notif_wireless_to_wired = message_com::create_vs_message<
diff --git a/agent/src/beerocks/slave/tasks/controller_connectivity_task.cpp b/agent/src/beerocks/slave/tasks/controller_connectivity_task.cpp
index 345a2b1..e21ad48 100644
--- a/agent/src/beerocks/slave/tasks/controller_connectivity_task.cpp
+++ b/agent/src/beerocks/slave/tasks/controller_connectivity_task.cpp
@@ -125,6 +125,9 @@ void ControllerConnectivityTask::work()
     case eState::CONNECTION_TIMEOUT: {
         auto db = AgentDB::get();
 
+        if (db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wired) {
+        LOG(DEBUG) << "CONNECTION_TIMEOUT: Wired backhaul detected, restarting FSM";
+        } else {
         auto it =
             find_if(db->backhaul.backhaul_links.begin(), db->backhaul.backhaul_links.end(),
                     [&](const AgentDB::sBackhaul::sBackhaulLink &c) {
@@ -170,6 +173,8 @@ void ControllerConnectivityTask::work()
         send_disconnect_to_backhaul_manager();
         break;
     }
+ break;
+}
     case eState::BACKHAUL_LINK_DISCONNECTED: {
         break;
     }
diff --git a/framework/transport/ieee1905_transport/ieee1905_transport_network.cpp b/framework/transport/ieee1905_transport/ieee1905_transport_network.cpp
index a513c07..27d938a 100755
--- a/framework/transport/ieee1905_transport/ieee1905_transport_network.cpp
+++ b/framework/transport/ieee1905_transport/ieee1905_transport_network.cpp
@@ -283,31 +283,39 @@ bool Ieee1905Transport::attach_interface_socket_filter(NetworkInterface &interfa
     return true;
 }
 
-void Ieee1905Transport::handle_interface_state_change(const std::string &ifname, bool is_active)
+void Ieee1905Transport::handle_interface_state_change(const std::string &ifname,
+                                                      bool is_active)
 {
     auto it = network_interfaces_.find(ifname);
+
     if (it == network_interfaces_.end()) {
         MAPF_INFO("Ignoring event from untracked interface " << ifname << ".");
+        LOG(DEBUG) << "Ignoring event from untracked interface " << ifname << ".";
 
-        if (pending_network_interfaces_.empty())
-            return;
+        if (!pending_network_interfaces_.empty()) {
+
+            auto iter = std::find(pending_network_interfaces_.begin(),
+                                 pending_network_interfaces_.end(), ifname);
+
+            if (iter != pending_network_interfaces_.end() && is_active) {
 
-        auto iter = std::find(pending_network_interfaces_.begin(),
-                              pending_network_interfaces_.end(), ifname);
-        if (iter != pending_network_interfaces_.end() && is_active) {
-            if (update_network_interface(bridge_name_, ifname, true, false)) {
-                MAPF_INFO("Activated pending network interface " << ifname << ".");
-                pending_network_interfaces_.erase(iter);
-            } else {
-                MAPF_INFO("Failed to create raw socket for " << ifname << ".");
+                if (update_network_interface(bridge_name_, ifname, true, false)) {
+                    MAPF_INFO("Activated pending network interface " << ifname << ".");
+                    pending_network_interfaces_.erase(iter);
+                } else {
+                    MAPF_INFO("Failed to create raw socket for " << ifname << ".");
+                }
+                return;
             }
         }
+
         return;
     }
+
     auto &interface = it->second;
 
-    MAPF_INFO("Interface state change - interface " << ifname << " " << (is_active ? "up" : "down")
-                                                    << ".");
+    MAPF_INFO("Interface state change - interface "
+              << ifname << " " << (is_active ? "up" : "down") << ".");
 
     if (is_active) {
         activate_interface(interface);
@@ -315,7 +323,6 @@ void Ieee1905Transport::handle_interface_state_change(const std::string &ifname,
         deactivate_interface(interface);
     }
 }
-
 void Ieee1905Transport::handle_bridge_state_change(const std::string &bridge_name,
                                                    const std::string &iface_name, bool iface_added)
 {
