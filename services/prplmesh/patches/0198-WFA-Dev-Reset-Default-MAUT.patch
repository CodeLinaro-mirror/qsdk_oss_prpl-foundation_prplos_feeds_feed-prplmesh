diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index a8fe0f0..912202e 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -46,6 +46,7 @@
 #include <bpl/bpl_cfg.h>
 #include <bpl/bpl_err.h>
 
+#include <cstdlib>
 #include <net/if.h> // if_nametoindex
 
 namespace beerocks {
@@ -714,8 +715,31 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
 
                 // Tear down all VAPs in all radios to make sure no station can connect until APs
                 // are given a fresh configuration.
+                LOG(INFO) << "backhaul_fsm_main: FSM=ENABLED, dev_reset_default_completed=false"
+                          << " -> calling send_slaves_tear_down() to tear down all VAPs";
                 send_slaves_tear_down();
 
+                // Invoke reset_vaps.sh AFTER teardown, but only in certification mode
+                // and only via the dev_reset_default path (m_is_in_reset_state + !m_dev_reset_default_completed).
+                // This script must not be called in any other context.
+                {
+                    auto db = AgentDB::get();
+                    if (db->device_conf.certification_mode) {
+                        const std::string reset_vaps_script = "/opt/prplmesh/scripts/reset_vaps.sh";
+                        LOG(INFO) << "backhaul_fsm_main: certification mode - invoking "
+                                  << reset_vaps_script << " after send_slaves_tear_down()";
+                        int ret = std::system(reset_vaps_script.c_str());
+                        if (ret != 0) {
+                            LOG(ERROR) << "reset_vaps.sh returned non-zero exit code: " << ret;
+                        } else {
+                            LOG(INFO) << "backhaul_fsm_main: reset_vaps.sh completed successfully";
+                        }
+                    } else {
+                        LOG(DEBUG) << "backhaul_fsm_main: non-certification mode"
+                                   << " - skipping reset_vaps.sh";
+                    }
+                }
+
                 if (m_dev_reset_default_timer !=
                     beerocks::net::FileDescriptor::invalid_descriptor) {
                     // Send back second reply to UCC client.
@@ -4326,6 +4350,13 @@ void BackhaulManager::handle_dev_reset_default(
     m_selected_backhaul           = "";
     m_is_in_reset_state           = true;
     m_dev_reset_default_completed = false;
+
+    LOG(INFO) << "handle_dev_reset_default: completed"
+              << " | m_is_in_reset_state=" << m_is_in_reset_state
+              << " | m_selected_backhaul=" << (m_selected_backhaul.empty() ? "<empty>" : m_selected_backhaul)
+              << " | m_dev_reset_default_completed=" << m_dev_reset_default_completed;
+    LOG(INFO) << "handle_dev_reset_default: device reset sequence finished"
+              << " - reset_vaps.sh will be invoked after send_slaves_tear_down() in backhaul_fsm_main()";
 }
 
 bool BackhaulManager::handle_dev_set_config(
