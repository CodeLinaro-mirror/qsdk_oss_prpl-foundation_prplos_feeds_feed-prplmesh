diff --git a/controller/src/beerocks/master/controller_ucc_listener.cpp b/controller/src/beerocks/master/controller_ucc_listener.cpp
index fd708bc..682256a 100644
--- a/controller/src/beerocks/master/controller_ucc_listener.cpp
+++ b/controller/src/beerocks/master/controller_ucc_listener.cpp
@@ -439,6 +439,11 @@ void controller_ucc_listener::handle_dev_reset_default(
     // Clear configuration on Controller's database.
     clear_configuration();
 
+    // Reset the per-MAC cleared-set so that the next DEV_SET_CONFIG sequence
+    // unconditionally calls clear_configuration(mac) for every AL-MAC it encounters,
+    // regardless of what was processed in a previous test case.
+    m_bss_info_cleared_mac.clear();
+
     // Send back second reply to UCC client.
     send_reply(fd);
 }
