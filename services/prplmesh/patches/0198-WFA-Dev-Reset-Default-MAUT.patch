diff --git a/agent/config/scripts/reset_vaps.sh b/agent/config/scripts/reset_vaps.sh
new file mode 100644
index 0000000..bdc1000
--- /dev/null
+++ b/agent/config/scripts/reset_vaps.sh
@@ -0,0 +1,131 @@
+#!/bin/sh
+#Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+#SPDX-License-Identifier: ISC
+#
+# This script resets the VAP (Virtual Access Point) UCI configuration
+# for the wireless interface. It is invoked during the DEV_RESET_DEFAULT
+# flow from the prplmesh application.
+
+# Detect the OS type from uname -a output
+UNAME_OUTPUT=$(uname -a)
+
+if echo "$UNAME_OUTPUT" | grep -q "OpenWrt"; then
+    OS_TYPE="OpenWrt"
+elif echo "$UNAME_OUTPUT" | grep -q "prplOS"; then
+    OS_TYPE="PrplOS"
+else
+    OS_TYPE="Unknown"
+fi
+
+echo "reset_vaps.sh: Detected OS type: $OS_TYPE" > /dev/console
+
+# If running on OpenWrt, perform UCI operations and reload wireless
+if [ "$OS_TYPE" = "OpenWrt" ]; then
+    # Read machine ID from fw_printenv and set radio band names accordingly
+    MACHID=$(fw_printenv machid 2>/dev/null | cut -d'=' -f2)
+    echo "reset_vaps.sh: machid=$MACHID" > /dev/console
+
+    if [ "$MACHID" = "8071100" ] || [ "$MACHID" = "8050501" ] || [ "$MACHID" = "8050301" ] || [ "$MACHID" = "8070100" ]; then
+        radio2G="radio0_band0"
+        radio5G="radio0_band1"
+        radio6G="radio0_band2"
+        echo "reset_vaps.sh: machid=$MACHID - radio2G=$radio2G radio5G=$radio5G radio6G=$radio6G" > /dev/console
+    else
+        radio2G="default_radio0_band0"
+        radio5G="default_radio0_band1"
+        radio6G="default_radio0_band2"
+        echo "reset_vaps.sh: machid=$MACHID (default) - radio2G=$radio2G radio5G=$radio5G radio6G=$radio6G" > /dev/console
+    fi
+
+    # Step 1: Generate base config
+    wifi config > /etc/config/wireless
+
+    # Step 2: Enable radios
+    uci set wireless.${radio2G}.disabled='0'
+    uci set wireless.${radio5G}.disabled='0'
+    uci set wireless.${radio6G}.disabled='0'
+
+    # Step 3: Delete existing named wifi-iface sections
+    # (wifi config always names these default_radio0_band{0,1,2} regardless of machid)
+    uci delete wireless.default_radio0_band0 2>/dev/null
+    uci delete wireless.default_radio0_band1 2>/dev/null
+    uci delete wireless.default_radio0_band2 2>/dev/null
+
+    # Step 4: Add new anonymous wifi-iface sections
+
+    # wlan0 STA (2.4GHz, disabled)
+    uci add wireless wifi-iface
+    uci set wireless.@wifi-iface[0].device="${radio2G}"
+    uci set wireless.@wifi-iface[0].network='lan'
+    uci set wireless.@wifi-iface[0].ifname='wlan0'
+    uci set wireless.@wifi-iface[0].mode='sta'
+    uci set wireless.@wifi-iface[0].wps_pushbutton='1'
+    uci set wireless.@wifi-iface[0].multi_ap='1'
+    uci set wireless.@wifi-iface[0].wds='1'
+    uci set wireless.@wifi-iface[0].disabled='1'
+
+    # wlan0.1 AP (2.4GHz)
+    uci add wireless wifi-iface
+    uci set wireless.@wifi-iface[1].device="${radio2G}"
+    uci set wireless.@wifi-iface[1].network='lan'
+    uci set wireless.@wifi-iface[1].mode='ap'
+    uci set wireless.@wifi-iface[1].ssid='OpenWrt'
+    uci set wireless.@wifi-iface[1].ifname='wlan0.1'
+    uci set wireless.@wifi-iface[1].encryption='none'
+
+    # wlan1 STA (5GHz)
+    uci add wireless wifi-iface
+    uci set wireless.@wifi-iface[2].device="${radio5G}"
+    uci set wireless.@wifi-iface[2].network='lan'
+    uci set wireless.@wifi-iface[2].ifname='wlan1'
+    uci set wireless.@wifi-iface[2].mode='sta'
+    uci set wireless.@wifi-iface[2].wps_pushbutton='1'
+    uci set wireless.@wifi-iface[2].multi_ap='1'
+    uci set wireless.@wifi-iface[2].wds='1'
+
+    # wlan1.1 AP (5GHz)
+    uci add wireless wifi-iface
+    uci set wireless.@wifi-iface[3].device="${radio5G}"
+    uci set wireless.@wifi-iface[3].ifname='wlan1.1'
+    uci set wireless.@wifi-iface[3].network='lan'
+    uci set wireless.@wifi-iface[3].mode='ap'
+    uci set wireless.@wifi-iface[3].ssid='OpenWrt'
+    uci set wireless.@wifi-iface[3].encryption='sae'
+    uci set wireless.@wifi-iface[3].sae_pwe='1'
+    uci set wireless.@wifi-iface[3].key='0123456789'
+
+    # wlan2.1 AP (6GHz)
+    uci add wireless wifi-iface
+    uci set wireless.@wifi-iface[4].device="${radio6G}"
+    uci set wireless.@wifi-iface[4].ifname='wlan2.1'
+    uci set wireless.@wifi-iface[4].network='lan'
+    uci set wireless.@wifi-iface[4].mode='ap'
+    uci set wireless.@wifi-iface[4].ssid='OpenWrt'
+    uci set wireless.@wifi-iface[4].encryption='sae'
+    uci set wireless.@wifi-iface[4].sae_pwe='1'
+    uci set wireless.@wifi-iface[4].key='0123456789'
+
+    # wlan2 STA (6GHz, disabled)
+    uci add wireless wifi-iface
+    uci set wireless.@wifi-iface[5].device="${radio6G}"
+    uci set wireless.@wifi-iface[5].network='lan'
+    uci set wireless.@wifi-iface[5].ifname='wlan2'
+    uci set wireless.@wifi-iface[5].mode='sta'
+    uci set wireless.@wifi-iface[5].wps_pushbutton='1'
+    uci set wireless.@wifi-iface[5].multi_ap='1'
+    uci set wireless.@wifi-iface[5].disabled='1'
+    uci set wireless.@wifi-iface[5].wds='1'
+
+    # Step 5: Commit
+    uci commit wireless
+
+
+    echo "reset_vaps.sh: UCI wireless VAP entries deleted and committed" > /dev/console
+
+    echo "reset_vaps.sh: OpenWrt detected, invoking wifi..." > /dev/console
+    wifi
+    sleep 5
+    echo "reset_vaps.sh: wifi invoked and sleep completed" > /dev/console
+fi
+
+echo "reset_vaps.sh: Done" > /dev/console
