++        )
++
+ set(scripts ${CMAKE_CURRENT_BINARY_DIR}/prplmesh_utils.sh)
+ 
+ if (NOT TARGET_PLATFORM STREQUAL "linux")
+@@ -24,6 +30,7 @@ list(APPEND scripts ${CMAKE_CURRENT_BINARY_DIR}/beerocks_watchdog.sh)
+ endif()
+ 
+ list(APPEND scripts ${CMAKE_CURRENT_BINARY_DIR}/beerocks_agent_launcher.sh)
++list(APPEND scripts ${CMAKE_CURRENT_BINARY_DIR}/script_to_pull_prop.sh)
