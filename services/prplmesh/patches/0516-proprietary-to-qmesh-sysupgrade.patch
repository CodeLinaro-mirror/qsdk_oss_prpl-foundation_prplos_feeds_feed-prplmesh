+ install(PROGRAMS ${scripts} DESTINATION scripts)
+ file(COPY ${scripts} DESTINATION ${CMAKE_MULTIAP_OUTPUT_DIRECTORY}/scripts)
+diff --git a/common/beerocks/scripts/script_to_pull_prop.sh.in b/common/beerocks/scripts/script_to_pull_prop.sh.in
+new file mode 100755
+index 000000000..4cb6a57f6
+--- /dev/null
++++ b/common/beerocks/scripts/script_to_pull_prop.sh.in
+@@ -0,0 +1,843 @@
++#!/bin/sh
++#Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
++#SPDX-License-Identifier: ISC
++# Migrate proprietary EasyMesh role/configuration to prplMesh.
++#
++# Usage:
++#   migrate-easymesh-to-prplmesh [auto|agent|controller|ca] [wired|wireless]
++#
++# Examples:
++#   migrate-easymesh-to-prplmesh auto wired
++#   migrate-easymesh-to-prplmesh agent wireless
++#   migrate-easymesh-to-prplmesh controller wired
++#   migrate-easymesh-to-prplmesh ca wired
++
++PATH="/usr/sbin:/usr/bin:/sbin:/bin"
++
++# Keep migration output available after boot.  /overlay survives reboot on
++# OpenWrt; fall back to /tmp when persistent storage is not mounted yet.
++LOG_DIR="/overlay/var/log/prplmesh"
++LOG_FILE="$LOG_DIR/boot.log"
++if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
++        LOG_DIR="/tmp/prplmesh"
++        LOG_FILE="$LOG_DIR/boot.log"
++        mkdir -p "$LOG_DIR" || exit 1
++fi
++
++# Capture stdout/stderr from this script and every command it invokes.
++exec >>"$LOG_FILE" 2>&1
++printf '%s [INFO] migration script started (pid=%s)\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$$"
++logger -t easymesh-migration -p daemon.info \
++        "migration script started; file=$LOG_FILE"
++
++ROLE="${1-auto}"
++BACKHAUL="${2-wired}"
++
++PRPLMESH_INIT="/etc/init.d/prplmesh"
++PRPLMESH_UTILS="/opt/prplmesh/scripts/prplmesh_utils.sh"
++STEERING_CONFIG="/etc/config/steering_config.json"
++CS_CONFIG="/etc/config/cs_config.json"
++BEEROCKS_AGENT_CONFIG="/opt/prplmesh/config/beerocks_agent.conf"
++
++log()
++{
++        message="$*"
++        timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
++        logger -t easymesh-migration "$message"
++        printf '%s [INFO] %s\n' "$timestamp" "$message"
++}
++
++# Keep command traces in the persistent migration log for boot debugging.
++#set -x
++trap 'rc=$?; printf "%s [INFO] migration script exited rc=%s\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$rc"; logger -t easymesh-migration -p daemon.info "migration script exited rc=$rc"' EXIT
++
++log "migration arguments: role=$ROLE backhaul=$BACKHAUL"
++
++die()
++{
++        log "ERROR: $*"
++        exit 1
++}
++
++require_root()
++{
++        [ "$(id -u)" -eq 0 ] || die "this script must run as root"
++}
++
++uci_get()
++{
++        # Return the supplied default if the UCI option is absent.
++        value="$(uci -q get "$1" 2>/dev/null)"
++        if [ -n "$value" ]; then
++                printf '%s\n' "$value"
++        else
++                printf '%s\n' "${2-}"
++        fi
++}
++
++is_one()
++{
++        case "$1" in
++                1|yes|true|on|enabled)
++                        return 0
++                        ;;
++                *)
++                        return 1
++                        ;;
++        esac
++}
++
++validate_arguments()
++{
++        case "$ROLE" in
++                auto|agent|controller|ca)
++                        ;;
++                *)
++                        die "invalid role '$ROLE'; use auto, agent, controller, or ca"
++                        ;;
++        esac
++
++        case "$BACKHAUL" in
++                wired|wireless)
++                        ;;
++                *)
++                        die "invalid backhaul '$BACKHAUL'; use wired or wireless"
++                        ;;
++        esac
++}
++
++backup_config()
++{
++        timestamp="$(date +%Y%m%d-%H%M%S)"
++        backup_dir="/etc/config/easymesh-migration-$timestamp"
++
++        mkdir -p "$backup_dir" || die "cannot create backup directory"
++
++        for file in ezmesh repacd mesh_app network wireless prplmesh autorole; do
++                if [ -f "/etc/config/$file" ]; then
++                        cp -p "/etc/config/$file" "$backup_dir/$file" ||
++                                die "cannot back up /etc/config/$file"
++                fi
++        done
++
++        log "configuration backup: $backup_dir"
++}
++
++detect_role()
++{
++        controller_enabled="$(uci_get ezmesh.MultiAP.EnableController 0)"
++        agent_enabled="$(uci_get ezmesh.MultiAP.EnableAgent 0)"
++        standalone_controller="$(uci_get repacd.MAPConfig.StandaloneController 0)"
++
++        log "proprietary EasyMesh values:"
++        log "  EnableController=$controller_enabled"
++        log "  EnableAgent=$agent_enabled"
++        log "  StandaloneController=$standalone_controller"
++
++        if is_one "$controller_enabled" &&
++           is_one "$agent_enabled" &&
++           ! is_one "$standalone_controller"; then
++                ROLE="ca"
++        elif is_one "$controller_enabled"; then
++                ROLE="controller"
++        elif is_one "$agent_enabled"; then
++                ROLE="agent"
++        else
++                die "proprietary EasyMesh has neither Controller nor Agent enabled"
++        fi
++
++        log "detected role: $ROLE"
++}
++
++stop_old_services()
++{
++        # The exact service names can differ between images. Do not fail if a
++        # service is not installed.
++        for service in ezmesh mesh_app autorole; do
++                if [ -x "/etc/init.d/$service" ]; then
++                        log "stopping $service"
++                        "/etc/init.d/$service" stop >/dev/null 2>&1 || true
++                        "/etc/init.d/$service" disable >/dev/null 2>&1 || true
++                fi
++        done
++
++        if [ -x "$PRPLMESH_INIT" ]; then
++                log "stopping existing prplMesh instance"
++                "$PRPLMESH_INIT" stop >/dev/null 2>&1 || true
++        fi
++}
++
++set_traffic_separation_options()
++{
++        local traffic_separation_enabled private_vid guest_vid private_bridge guest_bridge guest_network
++
++        traffic_separation_enabled="$(uci_get ezmesh.MultiAP.Map2TrafficSepEnabled \
++                "$(uci_get repacd.MAPConfig.MapTrafficSeparationEnable 0)")"
++        private_vid="$(uci_get ezmesh.MultiAP.VlanIDNwPrimary \
++                "$(uci_get repacd.MAPConfig.VlanIDNwPrimary '')")"
++        guest_vid="$(uci_get ezmesh.MultiAP.VlanIDNwOne \
++                "$(uci_get repacd.MAPConfig.VlanIDNwOne '')")"
++        private_bridge="$(uci_get ezmesh.MultiAP.VlanNetworkPrimary \
++                "$(uci_get repacd.MAPConfig.VlanNetworkPrimary lan)")"
++        guest_network="$(uci_get repacd.MAPConfig.VlanNetworkOne guest)"
++        guest_bridge="$(uci_get network.$guest_network.device "br-$guest_network")"
++
++        case "$private_bridge" in
++                lan)
++                        private_bridge="$(uci_get network.lan.device br-lan)"
++                        ;;
++                '')
++                        private_bridge='br-lan'
++                        ;;
++        esac
++
++        case "$guest_bridge" in
++                '')
++                        guest_bridge='br-guest'
++                        ;;
++        esac
++
++        case "$private_bridge" in
++                ''|*[!A-Za-z0-9_.:-]*)
++                        log "traffic separation: invalid private bridge '$private_bridge'; using br-lan"
++                        private_bridge='br-lan'
++                        ;;
++        esac
++
++        case "$guest_bridge" in
++                ''|*[!A-Za-z0-9_.:-]*)
++                        log "traffic separation: invalid guest bridge '$guest_bridge'; using br-guest"
++                        guest_bridge='br-guest'
++                        ;;
++        esac
++
++        # The UD target expects the guest bridge name without the hyphen.
++        [ "$guest_bridge" = 'br-guest' ] && guest_bridge='brguest'
++
++        case "$traffic_separation_enabled" in
++
++                1|yes|true|on|enabled)
++                        traffic_separation_enabled=1
++                        ;;
++                *)
++                        traffic_separation_enabled=0
++                        ;;
++        esac
++
++        case "$private_vid" in
++                ''|*[!0-9]*)
++                        log "traffic separation: invalid private VLAN '$private_vid'; disabling"
++                        traffic_separation_enabled=0
++                        uci -q delete prplmesh.config.TrafficSeparation_PrivateVID
++                        ;;
++                *)
++                        uci set prplmesh.config.TrafficSeparation_PrivateVID="$private_vid"
++                        ;;
++        esac
++        # Guest VLAN must be a decimal VLAN ID from 1 through 4095.
++        case "$guest_vid" in
++                ''|*[!0-9]*)
++                        log "traffic separation: invalid guest VLAN '$guest_vid'; disabling"
++                        traffic_separation_enabled=0
++                        uci -q delete prplmesh.config.TrafficSeparation_GuestVID
++                        ;;
++                *)
++                        if [ "$guest_vid" -ge 1 ] 2>/dev/null &&
++                           [ "$guest_vid" -le 4095 ] 2>/dev/null; then
++                                uci set prplmesh.config.TrafficSeparation_GuestVID="$guest_vid"
++                        else
++                                log "traffic separation: guest VLAN '$guest_vid' must be between 1 and 4095; disabling"
++                                traffic_separation_enabled=0
++                                uci -q delete prplmesh.config.TrafficSeparation_GuestVID
++                        fi
++                        ;;
++        esac
++
++        uci set prplmesh.config.TrafficSeparation_enable="$traffic_separation_enabled"
++        uci set prplmesh.config.TrafficSeparation_bridge_mapping_enable="$traffic_separation_enabled"
++        uci set prplmesh.config.TrafficSeparation_persistence_enable="$traffic_separation_enabled"
++        uci set prplmesh.config.PrivateBridgeIface="$private_bridge"
++        private_vid="$(uci_get prplmesh.config.TrafficSeparation_PrivateVID '')"
++        guest_vid="$(uci_get prplmesh.config.TrafficSeparation_GuestVID '')"
++        uci set prplmesh.config.GuestBridgeIface="$guest_bridge"
++
++        log "traffic separation: enabled=$traffic_separation_enabled private_vid=$private_vid guest_vid=$guest_vid private_bridge=$private_bridge guest_bridge=$guest_bridge"
++}
++
++json_set()
++{
++        key="$1"
++        value="$2"
++        escaped_value=$(printf '%s' "$value" | sed 's/[\\&]/\\\\&/g')
++        sed -i "s|^  \"$key\": .*|  \"$key\": \"$escaped_value\",|" "$STEERING_CONFIG" ||
++                die "failed to update $key in $STEERING_CONFIG"
++}
++
++cs_json_set()
++{
++        key="$1"
++        value="$2"
++        escaped_value=$(printf '%s' "$value" | sed 's/[\\&]/\\\\&/g')
++        sed -i "s|^  \"$key\": .*|  \"$key\": \"$escaped_value\",|" "$CS_CONFIG" ||
++                die "failed to update $key in $CS_CONFIG"
++}
++
++set_rsn_overriding_supported()
++{
++        [ -f "$BEEROCKS_AGENT_CONFIG" ] ||
++                die "$BEEROCKS_AGENT_CONFIG not found; cannot enable RSN overriding"
++
++        if grep -q '^rsn_overriding_supported=' "$BEEROCKS_AGENT_CONFIG"; then
++                sed -i \
++                        's/^rsn_overriding_supported=.*/rsn_overriding_supported=1/' \
++                        "$BEEROCKS_AGENT_CONFIG" ||
++                        die "failed to enable RSN overriding in $BEEROCKS_AGENT_CONFIG"
++        else
++                sed -i '/^\[global\]/a\
++rsn_overriding_supported=1' \
++                        "$BEEROCKS_AGENT_CONFIG" ||
++                        die "failed to add RSN overriding to $BEEROCKS_AGENT_CONFIG"
++        fi
++
++        grep -q '^rsn_overriding_supported=1$' "$BEEROCKS_AGENT_CONFIG" ||
++                die "failed to verify RSN overriding in $BEEROCKS_AGENT_CONFIG"
++        log "RSNO: enabled rsn_overriding_supported=1"
++}
++
++wireless_radio_band()
++{
++        local device band
++
++        device="$1"
++        [ "$(uci -q get wireless.$device 2>/dev/null)" = "wifi-device" ] ||
++                return 1
++
++        band="$(uci -q get wireless.$device.band 2>/dev/null)"
++        case "$band" in
++                6g|6G|3)
++                        printf '%s\n' 6g
++                        return 0
++                        ;;
++                2g|2G)
++                        printf '%s\n' 2g
++                        return 0
++                        ;;
++                5g|5G)
++                        printf '%s\n' 5g
++                        return 0
++                        ;;
++        esac
++
++}
++
++set_rsn_override_options()
++{
++        local section band option value
++
++        section="$1"
++        band="$2"
++        case "$band" in
++                2g|5g)
++                        set -- \
++                                encryption psk2 \
++                                sae_pwe 1 \
++                                rsn_override_key_mgmt SAE \
++                                rsn_override_pairwise CCMP \
++                                rsn_override_mfp 2 \
++                                rsn_override_key_mgmt_2 SAE-EXT-KEY \
++                                rsn_override_pairwise_2 GCMP-256 \
++                                rsn_override_mfp_2 2
++                        ;;
++                6g)
++                        set -- \
++                                encryption sae \
++                                sae_pwe 1 \
++                                rsn_override_key_mgmt_2 SAE-EXT-KEY \
++                                rsn_override_pairwise_2 GCMP-256 \
++                                rsn_override_mfp_2 2
++                        ;;
++                *)
++                        return 1
++                        ;;
++        esac
++
++        while [ "$#" -gt 0 ]; do
++                option="$1"
++                value="$2"
++                uci set "wireless.$section.$option=$value" ||
++                        die "failed to set wireless.$section.$option"
++                shift 2
++        done
++}
++
++translate_rsno_wireless()
++{
++        local section sections mode device band updated=0 skipped=0
++
++        sections="$(uci show wireless 2>/dev/null | \
++                        sed -n 's/^wireless\.\(@wifi-iface\[[0-9]*\]\)=wifi-iface$/\1/p')"
++
++        [ -n "$sections" ] || {
++                log "RSNO: no wireless wifi-iface sections found"
++                return 0
++        }
++
++        for section in $sections; do
++                mode="$(uci -q get wireless.$section.mode 2>/dev/null)"
++                [ "$mode" = "ap" ] || {
++                        skipped=$((skipped + 1))
++                        continue
++                }
++
++                if is_one "$(uci_get wireless.$section.wsplcd_unmanaged 0)" ||
++                   is_one "$(uci_get wireless.$section.repacd_security_unmanaged 0)"; then
++                        skipped=$((skipped + 1))
++                        log "RSNO: skipped unmanaged VAP wireless.$section"
++                        continue
++                fi
++
++                device="$(uci -q get wireless.$section.device 2>/dev/null)"
++                band="$(wireless_radio_band "$device")" || {
++                        skipped=$((skipped + 1))
++                        log "RSNO: skipped wireless.$section; unable to determine band for device '$device'"
++                        continue
++                }
++
++                set_rsn_override_options "$section" "$band"
++                updated=$((updated + 1))
++                log "RSNO: configured wireless.$section for $band"
++        done
++
++        log "RSNO: configured=$updated skipped=$skipped"
++}
++
++translate_rsno()
++{
++        if ! is_one "$(uci_get repacd.MAPConfig.FronthaulRSNO 0)" ||
++           ! is_one "$(uci_get repacd.MAPConfig.BackhaulRSNO 0)"; then
++                log "RSNO: FronthaulRSNO and BackhaulRSNO are not both enabled; skipping"
++                return 0
++        fi
++
++        log "RSNO: translating enabled proprietary RSN overriding configuration"
++        set_rsn_overriding_supported
++        translate_rsno_wireless
++}
++
++set_channel_selection_options()
++{
++        local channel_selection afc_enabled afc_delay
++
++        [ -f "$CS_CONFIG" ] || die "$CS_CONFIG not found"
++
++        channel_selection="$(uci_get ezmesh.MultiAP.EnableChannelSelection 0)"
++        afc_enabled="$(uci_get ezmesh.AFCSettings.EnableAfcChannelSelection 0)"
++        afc_delay="$(uci_get ezmesh.AFCSettings.AfcChannelSelectionDelaySec 120)"
++
++        case "$channel_selection" in
++                1|yes|true|on|enabled) channel_selection=1 ;;
++                *) channel_selection=0 ;;
++        esac
++        case "$afc_enabled" in
++                1|yes|true|on|enabled) afc_enabled=1 ;;
++                *) afc_enabled=0 ;;
++        esac
++
++        cs_json_set "EnableChannelSelection" "$channel_selection"
++        cs_json_set "ChannelSelectionOnGlobalPref" "$channel_selection"
++        cs_json_set "EnableFileLogging" "$channel_selection"
++
++        # The UD delay is the AFC channel-selection delay. Keep the
++        # proprietary value instead of replacing it with the JSON default.
++        cs_json_set "ChannelSelectionDelaySec" "$afc_delay"
++
++        # wsplcd owns this proprietary AFC switch; UD has no wsplcd UCI
++        # equivalent, so retain the value in the migration log.
++        log "  EnableAfcChannelSelection=$afc_enabled"
++        log "  wsplcd.EnableAFCChannelSelection=$(uci_get wsplcd.config.EnableAFCChannelSelection 0)"
++
++        if [ -f "$BEEROCKS_AGENT_CONFIG" ]; then
++                sed -i \
++                        's/^cbs_trigger_periodic_interval=.*/cbs_trigger_periodic_interval=3600/' \
++                        "$BEEROCKS_AGENT_CONFIG"
++                sed -i \
++                        's/^chansel_preference_report_refresh_enable=.*/chansel_preference_report_refresh_enable=1/' \
++                        "$BEEROCKS_AGENT_CONFIG"
++                sed -i \
++                        's/^chansel_unsolicited_preference_report_enable=.*/chansel_unsolicited_preference_report_enable=1/' \
++                        "$BEEROCKS_AGENT_CONFIG"
++        else
++                log "warning: $BEEROCKS_AGENT_CONFIG not found; skipping channel-report settings"
++        fi
++
++        # wsplcd owns the proprietary AFC switch; UD's channel-selection app
++        # consumes the corresponding JSON setting above.
++        log "translated channel selection: enabled=$channel_selection afc_enabled=$afc_enabled afc_delay=$afc_delay"
++}
++
++set_wireless_custom_aliases()
++{
++        local section extension_id mode alias updated=0
++        local sections
++
++        sections="$(uci show wireless 2>/dev/null | \
++                        sed -n 's/^wireless\.\(@wifi-iface\[[0-9]*\]\)=wifi-iface$/\1/p')"
++
++      
++        [ -n "$sections" ] || {
++                log "custom_alias: no wireless wifi-iface sections found"
++                return 0
++        }
++
++        for section in $sections; do
++                extension_id="$(uci -q get "wireless.${section}.extension_id" 2>/dev/null)"
++                mode="$(uci -q get "wireless.${section}.mode" 2>/dev/null)"
++                # Smart-monitor, STA, and other unmanaged interfaces do not
++                # represent a Multi-AP VAP and must not receive an alias.
++                case "$mode" in
++                        monitor|ap_smart_monitor|sta|mesh)
++                                continue
++                                ;;
++                esac
++
++                case "$extension_id" in
++                        3)
++                                alias='home'
++                                ;;
++                        4)
++                                # Profile 4 is Additional Fronthaul 1.  The
++                                # proprietary profile index determines the role;
++                                # SSID content is intentionally not inspected.
++                                alias='home'
++                                ;;
++                        5|6)
++                                alias='home'
++                                ;;
++                        7|11)
++                                alias='backhaul'
++                                ;;
++                        8|9|10)
++                                alias='guest'
++                                ;;
++                        *)
++                                continue
++                                ;;
++                esac
++
++                uci set "wireless.${section}.custom_alias=$alias" ||
++                        die "failed to set custom_alias on wireless.${section}"
++                log "custom_alias: wireless.${section} extension_id=${extension_id} -> ${alias}"
++                updated=$((updated + 1))
++        done
++
++        log "custom_alias: translated ${updated} wireless wifi-iface section(s)"
++}
++
++set_steering_options()
++{
++        local ug dg
++
++        [ -f "$STEERING_CONFIG" ] || die "$STEERING_CONFIG not found"
++
++        # Translate proprietary steering values to the UD steering JSON. Values
++        # remain strings because that is the format consumed by qmesh-steering-app.
++        json_set "BhOptMeasurementWaitSec" \
++                "$(uci_get ezmesh.MultiAP.BackhaulSteeringRspSendTimeout 30)"
++
++        # UG/DG are the UD L1/L2 breach thresholds. Apply both class values to
++        # every supported band.
++        ug="$(uci_get ezlbd.IdleSteer.RSSISteeringPoint_UG "35 35")"
++        dg="$(uci_get ezlbd.IdleSteer.RSSISteeringPoint_DG "15 15")"
++        json_set "L1BreachRssiThresholdDb_2G" "$ug"
++        json_set "L1BreachRssiThresholdDb_5G" "$ug"
++        json_set "L1BreachRssiThresholdDb_6G" "$ug"
++        json_set "L2BreachRssiThresholdDb_2G" "$dg"
++        json_set "L2BreachRssiThresholdDb_5G" "$dg"
++        json_set "L2BreachRssiThresholdDb_6G" "$dg"
++
++        json_set "BTMSteeringProhibitShortTimeSec" \
++                "$(uci_get ezlbd.SteerExec.BTMSteeringProhibitShortTime "10")"
++        json_set "SteeringUnfriendlyTimeSec" \
++                "$(uci_get ezlbd.SteerExec_Adv.SteeringUnfriendlyTime "600 600")"
++        json_set "MaxSteeringUnfriendlyTimeSec" \
++                "$(uci_get ezlbd.SteerExec_Adv.MaxSteeringUnfriendly "3600 3600")"
++
++        # No one-to-one UD JSON keys exist for these proprietary controls. Log
++        # them for auditability instead of writing keys the UD app cannot read.
++        log "unmapped propmesh steering options:"
++        log "  SteeringProhibitTime=$(uci_get ezlbd.SteerExec.SteeringProhibitTime "60 120")"
++        log "  DisableSteering11kUnfriendlyClients=$(uci_get ezlbd.APSteer.DisableSteering11kUnfriendlyClients 0)"
++        log "  DisableSteeringInactiveLegacyClients=$(uci_get ezlbd.APSteer.DisableSteeringInactiveLegacyClients 0)"
++        log "  DisableSteeringActiveLegacyClients=$(uci_get ezlbd.APSteer.DisableSteeringActiveLegacyClients 0)"
++        log "  DisableLegacySteering=$(uci_get ezlbd.SteerExec.DisableLegacySteering "0 0")"
++        log "  SkipBTMSteeringAbortOnActivityChange=$(uci_get ezlbd.SteerExec_Adv.SkipBTMSteeringAbortOnActivityChange 1)"
++
++        log "translated supported proprietary steering options to $STEERING_CONFIG"
++}
++
++repacd_ezmesh_enabled()
++{
++        [ "$(uci_get repacd.repacd.Enable 0)" = "1" ] &&
++                [ "$(uci_get repacd.repacd.Ezmesh 0)" = "1" ]
++}
++
++set_prplmesh_enable()
++{
++        if repacd_ezmesh_enabled; then
++                uci set prplmesh.config.enable='1'
++                log "prplMesh enable set to 1: repacd Enable and Ezmesh are both 1"
++        else
++                log "prplMesh enable unchanged: repacd Enable and Ezmesh must both be 1"
++        fi
++}
++
++set_common_options()
++{
++        set_prplmesh_enable
++        uci set prplmesh.config.onboarding='0'
++        uci set prplmesh.config.certification_mode='0'
++        uci set prplmesh.config.operational='0'
++        uci set prplmesh.config.stop_on_failure_attempts='1'
++
++        set_traffic_separation_options
++
++        if [ "$BACKHAUL" = "wired" ]; then
++                # Keep the value used by the platform's repeater helper for
++                # wired backhaul. Gateway mode may intentionally use 0 here.
++                uci set prplmesh.config.wired_backhaul='1'
++
++                # Replace this with the actual interface expected by the
++                # target board if "br-lan" is not correct.
++                if [ -n "$(uci -q get network.lan.device 2>/dev/null)" ]; then
++                        uci set prplmesh.config.backhaul_wire_iface="$(uci get network.lan.device)"
++                else
++                        uci set prplmesh.config.backhaul_wire_iface='br-lan'
++                fi
++        else
++                uci set prplmesh.config.wired_backhaul='0'
++                uci set prplmesh.config.backhaul_wire_iface='none'
++        fi
++}
++
++set_agent_mode()
++{
++        log "configuring prplMesh Agent mode"
++
++        uci set prplmesh.config.management_mode='Multi-AP-Agent'
++        uci set prplmesh.config.operating_mode='WDS-Repeater'
++        uci set prplmesh.config.master='0'
++        uci set prplmesh.config.gateway='0'
++
++        set_common_options
++        log "set prplmesh set_agent_mode"
++}
++
++set_controller_mode()
++{
++        log "configuring prplMesh Controller-only mode"
++
++        uci set prplmesh.config.management_mode='Multi-AP-Controller'
++        uci set prplmesh.config.operating_mode='Gateway'
++        uci set prplmesh.config.master='1'
++        uci set prplmesh.config.gateway='1'
++
++        set_common_options
++        log "set prplmesh set_controller_mode"
++}
++
++set_controller_agent_mode()
++{
++        log "configuring prplMesh Controller + Agent mode"
++
++        uci set prplmesh.config.management_mode='Multi-AP-Controller-and-Agent'
++        uci set prplmesh.config.operating_mode='Gateway'
++        uci set prplmesh.config.master='1'
++        uci set prplmesh.config.gateway='1'
++
++        set_common_options
++        log "set prplmesh Controller + Agent in Gateway mode"
++}
++
++commit_config()
++{
++        uci commit wireless || die "failed to commit wireless configuration"
++        uci commit prplmesh || die "failed to commit prplMesh configuration"
++        # log "wireless custom_alias, RSNO, and prplMesh configuration committed"
++
++        log "resulting prplMesh role:"
++        uci -q get prplmesh.config.management_mode
++        uci -q get prplmesh.config.operating_mode
++        log "enable=$(uci -q get prplmesh.config.enable)"
++        log "master=$(uci -q get prplmesh.config.master)"
++        log "gateway=$(uci -q get prplmesh.config.gateway)"
++        log "wired_backhaul=$(uci -q get prplmesh.config.wired_backhaul)"
++        log "backhaul_wire_iface=$(uci -q get prplmesh.config.backhaul_wire_iface)"
++}
++
++wait_for_hostapd()
++{
++        local hostapd_ctrl_dir=/var/run/hostapd
++        local attempt=1
++
++        while [ "$attempt" -le 240 ]; do
++                if hostapd_cli -p "$hostapd_ctrl_dir" -i global ping 2>/dev/null |
++                        grep -q '^PONG$'; then
++                        log daemon.info "hostapd global control interface is ready after $attempt attempt(s)"
++                        return 0
++                fi
++
++                log daemon.info "waiting for hostapd global control interface (attempt $attempt/240)"
++                sleep 1
++                attempt=$((attempt + 1))
++
++        done
++
++        log daemon.err "hostapd global control interface did not become ready after 2400 attempt(s)"
++        return 1
++}
++
++wait_for_wireless_config()
++{
++        local attempt=1
++        local sections
++
++        while [ "$attempt" -le 120 ]; do
++
++                sections="$(uci show wireless 2>/dev/null | \
++                        sed -n 's/^wireless\.\(@wifi-iface\[[0-9]*\]\)=wifi-iface$/\1/p')"
++
++                log "[$sections]"
++
++                if [ -n "$sections" ]; then
++                        log daemon.info "wireless configuration is ready after $attempt attempt(s)"
++                        return 0
++                fi
++
++                log daemon.info "waiting for wireless wifi-iface configuration (attempt $attempt/120)"
++                sleep 1
++                attempt=$((attempt + 1))
++        done
++
++        log daemon.err "wireless wifi-iface configuration did not become ready after 120 attempt(s)"
++        return 1
++}
++
++start_agent()
++{
++        [ -x "$PRPLMESH_UTILS" ] || die "$PRPLMESH_UTILS not found"
++
++        log "starting prplMesh Agent"
++        # echo "starting prplMesh Agent"
++        "$PRPLMESH_UTILS" repeater_mode "$BACKHAUL"
++}
++
++start_controller()
++{
++        [ -x "$PRPLMESH_UTILS" ] || die "$PRPLMESH_UTILS not found"
++
++        log "starting prplMesh Controller"
++        # echo "starting prplMesh Controller"
++        "$PRPLMESH_UTILS" start -m C
++}
++
++start_controller_agent()
++{
++        [ -x "$PRPLMESH_INIT" ] || die "$PRPLMESH_INIT not found"
++
++        # gateway_mode applies Gateway mode and starts both Controller and Agent.
++        log "starting prplMesh Controller + Agent in Gateway mode"
++        # echo "starting prplMesh Controller + Agent in Gateway mode"
++        "$PRPLMESH_INIT" gateway_mode
++}
++
++
++enable_service()
++{
++        if [ ! -x "$PRPLMESH_INIT" ]; then
++                log "cannot enable prplMesh: init script not found or not executable: $PRPLMESH_INIT"
++                # echo "cannot enable prplMesh: init script not found or not executable"
++                return 1
++        fi
++
++        log "enabling prplMesh service: $PRPLMESH_INIT enable"
++        if "$PRPLMESH_INIT" enable; then
++                log "prplMesh service enabled successfully"
++                # echo "prplmesh service enabled successfully"
++                return 0
++        fi
++
++        log "failed to enable prplMesh service: $PRPLMESH_INIT enable"
++        # echo "failed to enable prplMesh service"
++        return 1
++}
++
++main()
++{
++        require_root
++        validate_arguments
++
++        [ -f /etc/config/ezmesh ] ||
++                die "/etc/config/ezmesh not found"
++
++        [ -f /etc/config/prplmesh ] ||
++                die "/etc/config/prplmesh not found"
++
++        # backup_config
++
++        if [ "$ROLE" = "auto" ]; then
++                detect_role
++        fi
++
++        stop_old_services
++        set_steering_options
++        set_channel_selection_options
++
++        case "$ROLE" in
++                agent)
++                        set_agent_mode
++                        ;;
++                controller)
++                        set_controller_mode
++                        ;;
++                ca)
++                        set_controller_agent_mode
++                        ;;
++        esac
++
++       
++        
++        enable_service
++
++        log "waiting for hostapd before starting prplMesh role=$ROLE"
++        wait_for_hostapd || die "hostapd global control interface did not become ready"
++
++        log "waiting for wireless configuration before translating properties"
++        wait_for_wireless_config || die "wireless wifi-iface configuration did not become ready"
++
++        set_wireless_custom_aliases
++        translate_rsno || die "RSNO translation failed"
++        commit_config
++
++        if repacd_ezmesh_enabled; then
++                case "$ROLE" in
++                        agent)
++                                start_agent
++                                ;;
++                        controller)
++                                start_controller
++                                ;;
++                        ca)
++                                start_controller_agent
++                                ;;
++                esac
++        else
++                log "prplMesh start skipped: repacd Enable and Ezmesh must both be 1"
++        fi
++
++        touch /etc/prplmesh/.proprietary_migration_done ||
++                die "cannot create migration marker: /etc/prplmesh/.proprietary_migration_done"
++        log "proprietary migration marker created"
++        log "EasyMesh to prplMesh migration completed"
++}
++
++main "$@"
-- 
