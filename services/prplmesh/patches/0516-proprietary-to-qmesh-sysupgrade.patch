---
 0516-sysupgrade.patch | 873 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 873 insertions(+)
 create mode 100644 0516-sysupgrade.patch

diff --git a/0516-sysupgrade.patch b/0516-sysupgrade.patch
new file mode 100644
index 000000000..eff7ca6ff
--- /dev/null
+++ b/0516-sysupgrade.patch
@@ -0,0 +1,873 @@
+diff --git a/common/beerocks/scripts/CMakeLists.txt b/common/beerocks/scripts/CMakeLists.txt
+index eec8e8190..906c4b8d6 100644
+--- a/common/beerocks/scripts/CMakeLists.txt
++++ b/common/beerocks/scripts/CMakeLists.txt
+@@ -17,6 +17,12 @@ configure_file(
+         @ONLY
+         )
+ 
++configure_file(
++        "${CMAKE_CURRENT_SOURCE_DIR}/script_to_pull_prop.sh.in"
++        "${CMAKE_CURRENT_BINARY_DIR}/script_to_pull_prop.sh"
