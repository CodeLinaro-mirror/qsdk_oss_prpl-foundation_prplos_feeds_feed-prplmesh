From 92d54135adb617305cd23ab706f86896515ce03c Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Tue, 13 Jan 2026 14:07:12 +0530
Subject: [PATCH 38/49] topology_update_for_link_addition and reload_config_bss
 support

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 11 ++++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 36 ++++++++++++++-----
 2 files changed, 38 insertions(+), 9 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 18cf45dfb..1a3b00fbe 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -636,6 +636,17 @@ bool ApAutoConfigurationTask::send_ap_mld_configuration_response_message()
     LOG(DEBUG) << "Sending AP_MLD_CONFIGURATION_RESPONSE_MESSAGE message";
     m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
 
+    //send vap list notification
+    for (const auto& radio_conf : m_radios_conf_params) {
+        const std::string& radio_iface = radio_conf.first;
+        if (!radio_iface.empty()) {
+            LOG(DEBUG) << "send update vap list request for " << radio_iface;
+            if (!send_ap_bss_info_update_request(radio_iface)) {
+                LOG(ERROR) << "send_ap_bss_info_update_request has failed on " << radio_iface;
+            }
+        }
+    }
+
     return true;
 }
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index f6886d9cf..8936d7e39 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1262,9 +1262,11 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
             //to update uci with whatever update name we get
             bss_it.old_iface_name = new_vap_name;
 
-            if (!m_nl80211_client->create_new_interface(new_vap_name)) {
-                LOG(ERROR) << "Unable to create new interface ";
-                continue;
+            if ((bss_it.mld_id < 0) || ((bss_it.mld_id >= 0) && (bss_name_changed == false))) {
+                if (!m_nl80211_client->create_new_interface(new_vap_name)) {
+                    LOG(ERROR) << "Unable to create new interface ";
+                    continue;
+                }
             }
 
             new_vap_index++;
@@ -1560,6 +1562,12 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                                     continue;
                                 }
                                 LOG(INFO) << "STOP_MLD successful";
+                                const std::string cmd_2("RELOAD_CONFIG");
+                                if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
+                                    LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
+                                    continue;
+                                }
+                                LOG(INFO) << "RELOAD_CONFIG successful";
                             } else {
                                 const std::string cmd("STOP_AP");
                                 if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
@@ -1567,13 +1575,23 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                                     continue;
                                 }
                                 LOG(INFO) << "STOP_AP successful";
+
+                                std::stringstream reload_bss;
+                                std::string conf_path =
+                                    std::string(bwl::nl80211::base_ctrl_path) + "hostapd-" + m_radio_info.phy_name + ".conf";
+                                reload_bss << "RELOAD_CONFIG_BSS bss_config=" <<conf_path;
+                                if (!wpa_ctrl_send_msg(reload_bss.str(),vap_info.bss)) {
+                                    LOG(ERROR) << reload_bss.str() << " command to hostapd has failed - send reload_config";
+
+                                    const std::string cmd_2("RELOAD_CONFIG");
+                                    if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
+                                        LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
+                                        continue;
+                                    }
+                                    LOG(INFO) << "RELOAD_CONFIG successful";
+                                }
+
                             }
-                            const std::string cmd_2("RELOAD_CONFIG");
-                            if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
-                                LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
-                                continue;
-                            }
-                            LOG(INFO) << "RELOAD_CONFIG successful";
                         }
                    }
                 }
