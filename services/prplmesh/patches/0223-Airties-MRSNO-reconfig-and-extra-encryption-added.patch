+/**
+* @brief Clear RSN override parameters (Override 1 and/or Override 2).
+*
+* @param conf the hostapd configuration to clear the parameters from.
+* @param vap_id the VAP id of the BSS.
+* @param clear_override_1 if true, clear Override 1 parameters (default: true).
+* @param clear_override_2 if true, clear Override 2 parameters (default: true).
+*/
+static void clear_rsn_override_parameters(prplmesh::hostapd::Configuration &conf,
+                                          const std::string &vap_id,
+                                          bool clear_override_1 = true,
+                                          bool clear_override_2 = true)
+{
+    // Clear Override 1 (rsn_override_*)
+    if (clear_override_1) {
+        conf.set_create_value(vap_id, "rsn_override_key_mgmt", "");
+        conf.set_create_value(vap_id, "rsn_override_pairwise", "");
+        conf.set_create_value(vap_id, "rsn_override_mfp", "");
+    }
+
+    // Clear Override 2 (rsn_override_*_2)
+    if (clear_override_2) {
+        conf.set_create_value(vap_id, "rsn_override_key_mgmt_2", "");
+        conf.set_create_value(vap_id, "rsn_override_pairwise_2", "");
+        conf.set_create_value(vap_id, "rsn_override_mfp_2", "");
+    }
+}
