From 921269cba9f5970cd5990d11beb19410c7f050e9 Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Tue, 3 Nov 2026 17:06:20 +0530
Subject: [PATCH] Fix for BridgeInterface update issue in WHM HAL

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../beerocks/fronthaul_manager/ap_manager/ap_manager.cpp | 9 +++------
 .../beerocks/slave/tasks/ap_autoconfiguration_task.cpp   | 5 +++++
 common/beerocks/bcl/include/bcl/son/son_wireless_utils.h | 1 +
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp              | 7 ++++---
 framework/tlvf/yaml/tlvf/WSC/WSC_Attributes.yaml         | 6 ++++++
 5 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 3ca436fae..850c453bd 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2657,6 +2657,7 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             bss_info_conf.eppke            = config_data.eppke() != 0;
             bss_info_conf.vap_type         = config_data.vap_type();
             bss_info_conf.vap_label        = config_data.vap_label_str();
+            bss_info_conf.guest_bridge     = config_data.guest_bridge_str();
             bss_info_conf.wifi_compat_mode = config_data.wifi_compat_mode();
 
             // Some initial configurations do not yet have the traffic-separation
@@ -2780,10 +2781,6 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         // classification is still unknown; existing hostapd configuration should then
         // be preserved, while new BSS creation will use bridge_name as a safe fallback.
         auto db = AgentDB::get();
-        std::string guest_bridge;
-        const bool have_guest_bridge =
-            beerocks::bpl::cfg_get_guest_bridge_iface(guest_bridge) && !guest_bridge.empty();
-
         for (auto &bss : bss_info_conf_list) {
             if (bss.teardown) {
                 continue;
@@ -2795,8 +2792,8 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                 db->traffic_separation.ssid_vid_mapping.find(bss.ssid) !=
                     db->traffic_separation.ssid_vid_mapping.end();
 
-            if (guest && have_guest_bridge) {
-                bss.effective_bridge = guest_bridge;
+            if (guest && !bss.guest_bridge.empty()) {
+                bss.effective_bridge = bss.guest_bridge;
             } else if (mapping_known) {
                 bss.effective_bridge = bridge_name;
             } else {
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index cca5f7234..507f56f6e 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -7448,6 +7448,11 @@ bool ApAutoConfigurationTask::send_ap_bss_configuration_message(
         c->eppke() = info.eppke ? 1 : 0;
         c->vap_type() = info.m2_config.vap_type;
         c->set_vap_label(info.m2_config.vap_label);
+        std::string guest_bridge;
+        if (info.m2_config.vap_type == eVapType::GUEST) {
+            beerocks::bpl::cfg_get_guest_bridge_iface(guest_bridge);
+        }
+        c->set_guest_bridge(guest_bridge);
         c->smd_mac()  = info.smd_mac;
         c->wifi_compat_mode() = info.wifi_compat_mode;
 
diff --git a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
index fe49d8a11..408856ec8 100644
--- a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
+++ b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
@@ -367,6 +367,7 @@ public:
         WSC::eWscVendorExtHiddenSsid hidden_ssid          = WSC::eWscVendorExtHiddenSsid::UNSET;
         eVapType vap_type                                 = eVapType::OTHER;
         std::string vap_label;
+        std::string guest_bridge;
         // Agent-local bridge selected for hostapd configuration. This field is not serialized
         // into any controller-facing TLV.
         std::string effective_bridge;
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 3487f7b97..7316b9d8b 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -953,8 +953,9 @@ bool ap_wlan_hal_whm::update_vap_credentials(
 
             args.set_type(AMXC_VAR_ID_HTABLE);
             std::string effective_bridge = bss_info_conf.effective_bridge;
-            if (effective_bridge.empty() && bss_info_conf.vap_type == eVapType::GUEST) {
-                bpl::cfg_get_guest_bridge_iface(effective_bridge);
+            if (effective_bridge.empty() && bss_info_conf.vap_type == eVapType::GUEST &&
+                !bss_info_conf.guest_bridge.empty()) {
+                effective_bridge = bss_info_conf.guest_bridge;
             }
             if (effective_bridge.empty()) {
                 effective_bridge = bridge_ifname;
@@ -965,7 +966,7 @@ bool ap_wlan_hal_whm::update_vap_credentials(
             if (!mld_ifname.empty()) {
                 // TODO: CustomNetDevName currently has no effect on the kernel netdev name;
                 // investigate the pWHM integration and implement the correct naming path.
-                args.add_child("CustomNetDevName", mld_ifname);
+                //args.add_child("CustomNetDevName", mld_ifname);
             }
             if (!m_ambiorix_cl.update_object(wifi_vap_path, args)) {
                 LOG(INFO) << "cannot set bridge, 11k and wds for " << wifi_vap_path;
diff --git a/framework/tlvf/yaml/tlvf/WSC/WSC_Attributes.yaml b/framework/tlvf/yaml/tlvf/WSC/WSC_Attributes.yaml
index 7a557d26a..d1f7e4568 100644
--- a/framework/tlvf/yaml/tlvf/WSC/WSC_Attributes.yaml
+++ b/framework/tlvf/yaml/tlvf/WSC/WSC_Attributes.yaml
@@ -181,6 +181,12 @@ cEncryptedSettingsPayload:
     _type: char
     _length: [vap_label_length]
     _length_max: WSC_MAX_VAP_LABEL_LENGTH
+  guest_bridge_length:
+    _type: uint8_t
+    _length_var: True
+  guest_bridge:
+    _type: char
+    _length: [guest_bridge_length]
   wifi_compat_mode:
     _type: eWscWifiCompatMode
     _value: eWscWifiCompatMode::WIFI_COMPAT_MODE_UNSET
-- 
2.34.1

