From cd06cc6ae016c4d48c9c7da61b66f322ddc60376 Mon Sep 17 00:00:00 2001
From: Mahitha M <mmaddulu@qti.qualcomm.com>
Date: Tue, 1 Sep 2026 10:47:11 +0530
Subject: [PATCH] Set ServicePrioritization with Args

Signed-off-by: Mahitha M <mmaddulu@qti.qualcomm.com>
---
 controller/nbapi/odl/controller.odl.in |  30 +++-
 controller/nbapi/on_action.cpp         | 213 ++++++++++++++++++++++++-
 2 files changed, 238 insertions(+), 5 deletions(-)

diff --git a/controller/nbapi/odl/controller.odl.in b/controller/nbapi/odl/controller.odl.in
index 20700fdcc..612a2d637 100644
--- a/controller/nbapi/odl/controller.odl.in
+++ b/controller/nbapi/odl/controller.odl.in
@@ -479,7 +479,35 @@
                         bool Enable;
                     }
 
-                    void SetServicePrioritization();
+                    string SetServicePrioritization(
+                        %in %mandatory bool    Enable,
+                        %in           string   DSCPMap,
+                        %in           list     SPRule,
+                        %in           string   spmode,
+                        %in           string   alId,
+                        %in           uint32   ID,
+                        %in           uint8    Precedence,
+                        %in           uint8    Output,
+                        %in           uint32   MatchFlags,
+                        %in           uint8    userPriority,
+                        %in           string   srcAddr,
+                        %in           string   dstAddr,
+                        %in           uint32   qmatchflags,
+                        %in           string   srcIPv4Addr,
+                        %in           string   srcIPv6Addr,
+                        %in           string   dstIPv4Addr,
+                        %in           string   dstIPv6Addr,
+                        %in           uint16   srcPort,
+                        %in           uint16   dstPort,
+                        %in           uint8    protocolNumber,
+                        %in           uint16   vlanID,
+                        %in           uint8    dscp,
+                        %in           uint8    serviceIntervalDl,
+                        %in           uint8    serviceIntervalUl,
+                        %in           uint32   burstSizeDl,
+                        %in           uint32   burstSizeUl,
+                        %in           bool     AlwaysMatch
+                    );
 
                     %read-only string MSCSDisallowedStaList = "";
 
diff --git a/controller/nbapi/on_action.cpp b/controller/nbapi/on_action.cpp
index a1d2f7aa0..a122dfd24 100644
--- a/controller/nbapi/on_action.cpp
+++ b/controller/nbapi/on_action.cpp
@@ -1332,24 +1332,229 @@ amxd_status_t set_qos_management(amxd_object_t *bss_instance, amxd_function_t *f
     return amxd_status_ok;
 }
 
-/**
- * @brief Trigger service prioritization and QoS management descriptor propagation.
- */
 amxd_status_t trigger_prioritization(amxd_object_t *object, amxd_function_t *func, amxc_var_t *args,
                                      amxc_var_t *ret)
 {
     if (!g_database) {
         LOG(ERROR) << "Invalid database access";
+        amxc_var_set(cstring_t, ret, "Error_Other");
         return amxd_status_unknown_error;
     }
 
     auto controller = g_database->get_controller_ctx();
     if (!controller) {
         LOG(ERROR) << "Failed to get controller context";
+        amxc_var_set(cstring_t, ret, "Error_Other");
         return amxd_status_unknown_error;
     }
 
-    g_database->dm_configure_service_prioritization();
+    const char *spmode_cstr = GET_CHAR(args, "spmode");
+    if (!spmode_cstr) {
+        LOG(ERROR) << "Missing mandatory argument 'spmode'";
+        return amxd_status_parameter_not_found;
+    }
+    const std::string spmode(spmode_cstr);
+
+    if (spmode != "bsp" && spmode != "esp" && spmode != "qsp") {
+        LOG(ERROR) << "Invalid spmode '" << spmode << "'. Must be 'bsp', 'esp', or 'qsp'";
+        return amxd_status_invalid_value;
+    }
+
+    amxc_var_t *enable_arg = GET_ARG(args, "Enable");
+    if (!enable_arg) {
+        LOG(ERROR) << "Missing mandatory argument 'Enable' for spmode=" << spmode;
+        return amxd_status_parameter_not_found;
+    }
+    const bool enable = GET_BOOL(args, "Enable");
+    LOG(DEBUG) << "trigger_prioritization: spmode=" << spmode
+               << " Enable=" << (enable ? "true" : "false");
+
+    if (spmode == "bsp") {
+        const char *alId_cstr = GET_CHAR(args, "alId");
+
+        // Derive rule fields from args now so the future TR-181
+        // SetServicePrioritization API call can be passed these directly.
+        const uint32_t ruleid           = amxc_var_dyncast(uint32_t, GET_ARG(args, "ID"));
+        const uint8_t  ruleprecedence   = amxc_var_dyncast(uint8_t,  GET_ARG(args, "Precedence"));
+        const uint8_t  ruleoutput       = amxc_var_dyncast(uint8_t,  GET_ARG(args, "Output"));
+        const char    *dscpmapping_cstr = GET_CHAR(args, "DSCPMap");
+        bool always_match = GET_BOOL(args, "AlwaysMatch");
+        /* GET_BOOL returns false when the key is absent; default to true */
+        if (!amxc_var_get_path(args, "AlwaysMatch", AMXC_VAR_FLAG_DEFAULT)) {
+            always_match = true;
+        }
+
+        LOG(DEBUG) << "trigger_prioritization: BSP mode"
+                   << " alId=" << (alId_cstr ? alId_cstr : "null")
+                   << " ruleid=" << ruleid
+                   << " precedence=" << (int)ruleprecedence
+                   << " output=" << (int)ruleoutput
+                   << " AlwaysMatch=" << (always_match ? "true" : "false")
+                   << " DSCPMap=" << (dscpmapping_cstr ? dscpmapping_cstr : "null");
+
+        // TODO: forward ruleid/ruleprecedence/ruleoutput/always_match/dscpmapping_cstr
+        // to the new TR-181 SetServicePrioritization API once it is implemented
+        // (per-agent when alId is set, network-wide otherwise).
+        g_database->dm_configure_service_prioritization();
+        controller->trigger_prioritization_config();
+        return amxd_status_ok;
+    }
+
+    // esp / qsp
+    const char *alId_cstr = GET_CHAR(args, "alId");
+    if (!alId_cstr) {
+        LOG(ERROR) << "Missing mandatory argument 'alId' for spmode=" << spmode;
+        return amxd_status_parameter_not_found;
+    }
+    const std::string alId_str(alId_cstr);
+    if (!network_utils::is_valid_mac(alId_str)) {
+        LOG(ERROR) << "Invalid MAC address for alId: " << alId_str;
+        return amxd_status_invalid_value;
+    }
+    const sMacAddr alId = tlvf::mac_from_string(alId_str);
+
+    const uint32_t ruleid        = amxc_var_dyncast(uint32_t, GET_ARG(args, "ID"));
+    const uint8_t  ruleprecedence = amxc_var_dyncast(uint8_t,  GET_ARG(args, "Precedence"));
+    const uint8_t  ruleoutput_common = amxc_var_dyncast(uint8_t, GET_ARG(args, "Output"));
+
+    auto agent = g_database->get_agent(alId);
+    if (!agent) {
+        LOG(ERROR) << "Agent not found for alId=" << alId_str;
+        return amxd_status_object_not_found;
+    }
+
+    bool always_match = GET_BOOL(args, "AlwaysMatch");
+    /* GET_BOOL returns false when the key is absent; default to true */
+    if (!amxc_var_get_path(args, "AlwaysMatch", AMXC_VAR_FLAG_DEFAULT)) {
+        always_match = true;
+    }
+
+    if (spmode == "esp") {
+        const char *src_mac_cstr  = GET_CHAR(args, "srcAddr");
+        const char *dest_mac_cstr = GET_CHAR(args, "dstAddr");
+        
+        // MAC addresses are optional - only validate if provided
+        if (src_mac_cstr && src_mac_cstr[0] != '\0') {
+            if (!network_utils::is_valid_mac(src_mac_cstr)) {
+                LOG(ERROR) << "esp mode: invalid MAC address for 'srcAddr': " << src_mac_cstr;
+                return amxd_status_invalid_value;
+            }
+        }
+        if (dest_mac_cstr && dest_mac_cstr[0] != '\0') {
+            if (!network_utils::is_valid_mac(dest_mac_cstr)) {
+                LOG(ERROR) << "esp mode: invalid MAC address for 'dstAddr': " << dest_mac_cstr;
+                return amxd_status_invalid_value;
+            }
+        }
+
+        const uint32_t matchflags   = amxc_var_dyncast(uint32_t, GET_ARG(args, "MatchFlags"));
+        const uint8_t  userpriority = amxc_var_dyncast(uint8_t,  GET_ARG(args, "userPriority"));
+
+        LOG(DEBUG) << "trigger_prioritization: ESP mode"
+                   << " alId=" << alId_str
+                   << " ruleid=" << ruleid
+                   << " precedence=" << (int)ruleprecedence
+                   << " src_mac=" << (src_mac_cstr ? src_mac_cstr : "(none)")
+                   << " dest_mac=" << (dest_mac_cstr ? dest_mac_cstr : "(none)")
+                   << " output=" << (int)ruleoutput_common
+                   << " matchflags=0x" << std::hex << matchflags << std::dec
+                   << " userpriority=" << (int)userpriority
+                   << " AlwaysMatch=" << (always_match ? "true" : "false");
+
+        // TODO: build the sServicePrioritizationRule and store it in
+        // agent->service_prioritization.rules — deferred to a follow-up commit.
+
+    } else { // qsp
+        const char *src_mac_cstr  = GET_CHAR(args, "srcAddr");
+        const char *dest_mac_cstr = GET_CHAR(args, "dstAddr");
+        
+        // MAC addresses are optional - only validate if provided
+        if (src_mac_cstr && src_mac_cstr[0] != '\0') {
+            if (!network_utils::is_valid_mac(src_mac_cstr)) {
+                LOG(ERROR) << "qsp mode: invalid MAC address for 'srcAddr': " << src_mac_cstr;
+                return amxd_status_invalid_value;
+            }
+        }
+        if (dest_mac_cstr && dest_mac_cstr[0] != '\0') {
+            if (!network_utils::is_valid_mac(dest_mac_cstr)) {
+                LOG(ERROR) << "qsp mode: invalid MAC address for 'dstAddr': " << dest_mac_cstr;
+                return amxd_status_invalid_value;
+            }
+        }
+
+        const uint32_t matchflags      = amxc_var_dyncast(uint32_t, GET_ARG(args, "MatchFlags"));
+        const uint32_t qmatchflags     = amxc_var_dyncast(uint32_t, GET_ARG(args, "qmatchflags"));
+        const uint8_t  userpriority    = amxc_var_dyncast(uint8_t,  GET_ARG(args, "userPriority"));
+        const char    *srcipv4_cstr    = GET_CHAR(args, "srcIPv4Addr");
+        const char    *srcipv6_cstr    = GET_CHAR(args, "srcIPv6Addr");
+        const char    *dstipv4_cstr    = GET_CHAR(args, "dstIPv4Addr");
+        const char    *dstipv6_cstr    = GET_CHAR(args, "dstIPv6Addr");
+        const uint16_t srcport              = amxc_var_dyncast(uint16_t, GET_ARG(args, "srcPort"));
+        const uint16_t dstport              = amxc_var_dyncast(uint16_t, GET_ARG(args, "dstPort"));
+        const uint8_t  protocolNumber       = amxc_var_dyncast(uint8_t,  GET_ARG(args, "protocolNumber"));
+        const uint16_t vlanid               = amxc_var_dyncast(uint16_t, GET_ARG(args, "vlanID"));
+        const uint8_t  dscp                 = amxc_var_dyncast(uint8_t,  GET_ARG(args, "dscp"));
+        const uint8_t  serviceIntervalDl    = amxc_var_dyncast(uint8_t,  GET_ARG(args, "serviceIntervalDl"));
+        const uint8_t  serviceIntervalUl    = amxc_var_dyncast(uint8_t,  GET_ARG(args, "serviceIntervalUl"));
+        const uint32_t burstSizeDl          = amxc_var_dyncast(uint32_t, GET_ARG(args, "burstSizeDl"));
+        const uint32_t burstSizeUl          = amxc_var_dyncast(uint32_t, GET_ARG(args, "burstSizeUl"));
+
+        LOG(DEBUG) << "trigger_prioritization: QSP mode"
+                   << " alId=" << alId_str
+                   << " ruleid=" << ruleid
+                   << " precedence=" << (int)ruleprecedence
+                   << " src_mac=" << (src_mac_cstr ? src_mac_cstr : "(none)")
+                   << " dest_mac=" << (dest_mac_cstr ? dest_mac_cstr : "(none)")
+                   << " output=" << (int)ruleoutput_common
+                   << " matchflags=0x" << std::hex << matchflags << std::dec
+                   << " qmatchflags=0x" << std::hex << qmatchflags << std::dec
+                   << " userpriority=" << (int)userpriority
+                   << " srcipv4=" << (srcipv4_cstr ? srcipv4_cstr : "null")
+                   << " srcipv6=" << (srcipv6_cstr ? srcipv6_cstr : "null")
+                   << " dstipv4=" << (dstipv4_cstr ? dstipv4_cstr : "null")
+                   << " dstipv6=" << (dstipv6_cstr ? dstipv6_cstr : "null")
+                   << " srcport=" << srcport
+                   << " dstport=" << dstport
+                   << " protocolNumber=" << (int)protocolNumber
+                   << " vlanid=" << vlanid
+                   << " dscp=" << (int)dscp
+                   << " serviceIntervalDl=" << (int)serviceIntervalDl
+                   << " serviceIntervalUl=" << (int)serviceIntervalUl
+                   << " burstSizeDl=" << burstSizeDl
+                   << " burstSizeUl=" << burstSizeUl
+                   << " AlwaysMatch=" << (always_match ? "true" : "false");
+
+        // TODO: build the sServicePrioritizationRule and store it in
+        // agent->service_prioritization.rules — deferred to a follow-up commit.
+    }
+
+    const char *dscpmapping_cstr = GET_CHAR(args, "DSCPMap");
+    const bool has_dscp_mapping  = dscpmapping_cstr && dscpmapping_cstr[0] != '\0';
+
+    // DSCPMap is optional even when Output=USE_DSCP (0x08)
+    // The agent will use default DSCP mapping if not provided
+
+    if (has_dscp_mapping) {
+        const std::string dscp_hex(dscpmapping_cstr);
+        const size_t expected_hex_len = beerocks::message::DSCP_MAPPING_LIST_LENGTH * 2;
+        if (dscp_hex.size() != expected_hex_len ||
+            !std::all_of(dscp_hex.begin(), dscp_hex.end(),
+                         [](unsigned char c) { return std::isxdigit(c) != 0; })) {
+            LOG(ERROR) << "Invalid DSCPMap: expected " << expected_hex_len
+                       << " hex characters, got '" << dscp_hex << "'";
+            return amxd_status_invalid_value;
+        }
+        const auto pcp_values =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(dscp_hex);
+        if (!std::all_of(pcp_values.begin(), pcp_values.end(),
+                         [](uint8_t pcp) { return pcp <= 7; })) {
+            LOG(ERROR) << "Invalid DSCPMap: PCP values must be in range 0-7";
+            return amxd_status_invalid_value;
+        }
+        // TODO: copy pcp_values into agent->service_prioritization.dscp_mapping_table
+        // — deferred to a follow-up commit.
+    }
+
     controller->trigger_prioritization_config();
     return amxd_status_ok;
 }
-- 
2.34.1

