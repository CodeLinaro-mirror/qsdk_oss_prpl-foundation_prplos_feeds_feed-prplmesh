From 8544ee6c6ab8f3b8fa7412a119f23a72b1feff98 Mon Sep 17 00:00:00 2001
From: Sandeep Tomer <stomer@qti.qualcomm.com>
Date: Fri, 9 Oct 2026 14:05:25 +0530
Subject: [PATCH] [prplmesh] backhaul steering: don't skip steer on stale
 cached bSTA BSSID

The "Current BSSID matches target, no steering required" check used the
NL HAL's cached m_active_bssid, which roam() set to the requested target
as soon as the ROAM command was accepted. If the roam then failed and
wpa_supplicant fell back to SCANNING, later steers to that target were
wrongly skipped.

- backhaul_manager: refresh status and skip only if the bSTA is really
  connected to the target.
- NL HAL: don't cache the BSSID on ROAM; clear it on disconnect.
- NL HAL update_status(): when not associated, clear only BSSID/channel
  and keep the network id/SSID.

Signed-off-by: Sandeep Tomer <stomer@qti.qualcomm.com>
---
 ...sh-fix-backhaul-steering-stale-bssid.patch | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)
 create mode 100644 0504-prplmesh-fix-backhaul-steering-stale-bssid.patch

diff --git a/0504-prplmesh-fix-backhaul-steering-stale-bssid.patch b/0504-prplmesh-fix-backhaul-steering-stale-bssid.patch
new file mode 100644
index 000000000..e92969330
--- /dev/null
+++ b/0504-prplmesh-fix-backhaul-steering-stale-bssid.patch
@@ -0,0 +1,69 @@
+diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+index 5f5aeda2d..9b0826542 100644
+--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
++++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+@@ -4718,9 +4718,23 @@ bool BackhaulManager::handle_backhaul_steering_request(ieee1905_1::CmduMessageRx
+         return true;
+     }
+ 
+-    // If current BSSID is the same as the specified target BSSID, then do not steer and send a
++    // Do not use the HAL's cached BSSID without first refreshing it. In particular, NL HAL used
++    // to retain the requested BSSID after accepting a ROAM command, even when the roam later
++    // failed and wpa_supplicant was scanning/disconnected. Treating that requested BSSID as the
++    // current BSSID suppresses all subsequent steering retries.
++    bool current_bssid_matches_target = false;
++    if (!active_hal->update_status()) {
++        // Fail open: without a current status, do not incorrectly report steering success and
++        // skip the scan/roam operation because of a stale cache entry.
++        LOG(WARNING) << "Failed to refresh bSTA status on " << active_hal->get_iface_name()
++                     << " before checking backhaul steering target " << bssid;
++    } else if (active_hal->is_connected()) {
++        current_bssid_matches_target = tlvf::mac_from_string(active_hal->get_bssid()) == bssid;
++    }
++
++    // If the bSTA is confirmed connected to the specified target BSSID, do not steer and send a
+     // response immediately.
+-    if (tlvf::mac_from_string(active_hal->get_bssid()) == bssid) {
++    if (current_bssid_matches_target) {
+         LOG(WARNING) << "Current BSSID matches target BSSID " << bssid << ". No steering required.";
+ 
+         auto response =
+diff --git a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+index aa0b34e71..45eb1a701 100644
+--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
++++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+@@ -223,7 +223,7 @@ bool sta_wlan_hal_nl80211::disconnect()
+     return true;
+ }
+ 
+-bool sta_wlan_hal_nl80211::roam(const sMacAddr &bssid, ChannelFreqPair channel)
++bool sta_wlan_hal_nl80211::roam(const sMacAddr &bssid, ChannelFreqPair /*channel*/)
+ {
+     if (m_active_network_id == -1) {
+         LOG(ERROR) << "Incorrect active network " << m_active_network_id;
+@@ -250,9 +250,10 @@ bool sta_wlan_hal_nl80211::roam(const sMacAddr &bssid, ChannelFreqPair channel)
+         return false;
+     }
+ 
+-    // Update the active channel and bssid
+-    m_active_bssid.assign(bssid_str);
+-    m_active_channel = channel.first;
++    // A successful control command only means that wpa_supplicant accepted the roam request.
++    // Keep the active BSSID/channel unchanged until CTRL-EVENT-CONNECTED confirms the new
++    // association and update_status() refreshes the cache. Otherwise a failed roam makes the
++    // requested target look like the current BSSID to callers.
+ 
+     return true;
+ }
+@@ -626,6 +627,11 @@ bool sta_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
+         msg->bssid             = tlvf::mac_from_string(parsed_obj["bssid"]);
+         msg->disconnect_reason = std::strtoul(parsed_obj["reason"].c_str(), nullptr, 10);
+ 
++        // No association remains after a disconnect. Clear the cached values as well, rather
++        // than letting a later operation use the BSSID/channel of the previous connection.
++        m_active_bssid.clear();
++        m_active_channel = 0;
++
+         // Forward the event
+         event_queue_push(event, msg_buff);
+ 
