 namespace beerocks {
 
 CapabilityReportingTask::CapabilityReportingTask(slave_thread &btl_ctx,
@@ -555,10 +559,33 @@ void CapabilityReportingTask::handle_ap_capability_query(ieee1905_1::CmduMessage
 
 bool CapabilityReportingTask::prepare_ap_capability_message(bool early)
 {
+    auto db = AgentDB::get();
+
     /**
      * The add_vs_tlv method invokes the handler to add Vendor specific TLVs to the
      * AP Capability Report message.
+     *
+     * For the EARLY_AP_CAPABILITY_REPORT_MESSAGE, the QCA SMD capabilities TLV handler
+     * (add_qca_smd_capabilities_tlv) reads its values from a static set by
+     * set_qca_agent_smd_capabilities(). Aggregate the SMD flags across all radios from
+     * the AgentDB and set them before invoking add_vs_tlv().
+     * This is only needed for the early report since the SMD capabilities TLV is only
+     * registered for EARLY_AP_CAPABILITY_REPORT_MESSAGE.
      */
+    if (early) {
+        bool smd_capable = false;
+        bool smd_dl_fwd  = false;
+        for (auto radio : db->get_radios_list()) {
+            if (radio) {
+                smd_capable |= radio->smd_support;
+                smd_dl_fwd  |= radio->smd_dl_data_fwd_support;
+            }
+        }
+        LOG(DEBUG) << "SMD capabilities for TLV: smd_capable=" << smd_capable
+                   << ", smd_dl_fwd=" << smd_dl_fwd;
+        set_qca_agent_smd_capabilities(smd_capable, smd_dl_fwd);
+    }
+
     auto message_type = early ? ieee1905_1::eMessageType::EARLY_AP_CAPABILITY_REPORT_MESSAGE
                               : ieee1905_1::eMessageType::AP_CAPABILITY_REPORT_MESSAGE;
     if (!multi_vendor::tlvf_handler::add_vs_tlv(m_cmdu_tx, message_type)) {
@@ -572,7 +599,6 @@ bool CapabilityReportingTask::prepare_ap_capability_message(bool early)
         LOG(ERROR) << "addClass wfa_map::tlvApCapability has failed";
