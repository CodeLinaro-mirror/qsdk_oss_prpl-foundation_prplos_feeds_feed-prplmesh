         qca::tlvf_qca_utils::set_current_agent_smd_capabilities(*caps);
     }
 }
+
+extern "C" void set_qca_agent_smd_capabilities(bool smd_capable, bool smd_dl_forwarding)
+{
+    qca::sQcaSmdCapabilities caps;
+    caps.smd_capable       = smd_capable;
+    caps.smd_dl_forwarding = smd_dl_forwarding;
+    qca::tlvf_qca_utils::set_current_agent_smd_capabilities(caps);
+}
diff --git a/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp b/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
index 0761febf6..a0b39becd 100644
--- a/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
+++ b/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
@@ -88,13 +88,34 @@ bool tlvf_qca_utils::add_qca_smd_capabilities_tlv(ieee1905_1::CmduMessageTx &cmd
     // This will be populated by the caller with the actual radio MAC address
     std::fill_n(tlv_smd_cap->ruid().oct, 6, 0);
 
-    // Set capabilities - default to 0 (both bits false)
-    // Bit 7: smdCapable = 0 (not supported)
-    // Bit 6: smdDlForwarding = 0 (not supported)
+    // Build capabilities byte from actual values stored in s_current_agent_smd_caps.
+    // These are set by the caller (capability_reporting_task) from the AgentDB radio fields
+    // (smd_support / smd_dl_data_fwd_support) before add_vs_tlv() is invoked.
+    // Bit 7: smdCapable
+    // Bit 6: smdDlForwarding
     // Bits 5-0: Reserved = 0
-    tlv_smd_cap->capabilities() = 0x00;
+    uint8_t capabilities = 0;
+#if 0
+    if (s_current_agent_smd_caps.smd_capable) {
+        capabilities |= 0x80; // Bit 7
+    }
+# else 
+    // TODO: remove this section if driver sets smd_capable flag correctly
+    LOG(INFO) << "Hardcoding smd_capable flag";
+    capabilities |= 0x80; // Bit 7
+#endif
+    if (s_current_agent_smd_caps.smd_dl_forwarding) {
+        capabilities |= 0x40; // Bit 6
+    }
+    tlv_smd_cap->capabilities() = capabilities;
+
+    LOG(INFO) << "Added QCA SMD capabilities TLV: smd_capable="
+              << s_current_agent_smd_caps.smd_capable
+              << ", smd_dl_forwarding=" << s_current_agent_smd_caps.smd_dl_forwarding;
+
+    // Reset per-invocation capabilities after use so they do not carry over to the next message
+    s_current_agent_smd_caps = {};
 
-    LOG(INFO) << "Added QCA SMD capabilities TLV";
     return true;
 }
 
@@ -275,4 +296,4 @@ tlvf_qca_utils::parse_qca_smd_policy_config_tlv(ieee1905_1::CmduMessageRx &cmdu_
               << ", defaultDlDrainTime=" << static_cast<int>(smd_default_dl_drain_time);
 
     return tlv;
-}
+}
