@@ -46,6 +46,24 @@
 #include <linux/if_ether.h>
 #include <linux/nl80211.h>
 #include <linux/version.h>
+
+/* SMD capability attributes - vendor extension not yet in upstream nl80211.h.
+ * Values match QCA internal nl80211_copy.h and will be removed once upstreamed. */
+#ifndef NL80211_ATTR_SMD_SUPPORT
+#define NL80211_ATTR_SMD_SUPPORT         382
+#endif
+#ifndef NL80211_ATTR_SMD_STA_DL_DATA_FWD
+#define NL80211_ATTR_SMD_STA_DL_DATA_FWD 386
+#endif
+/* Use a larger array size only when the vendor-specific SMD attributes
+ * exceed the standard NL80211_ATTR_MAX, to avoid -Werror=array-bounds.
+ * When these attributes are upstreamed and NL80211_ATTR_MAX grows to
+ * cover them, this automatically falls back to NL80211_ATTR_MAX. */
+#if NL80211_ATTR_MAX < NL80211_ATTR_SMD_STA_DL_DATA_FWD
+#define NL80211_ATTR_MAX_WITH_VENDOR NL80211_ATTR_SMD_STA_DL_DATA_FWD
+#else
+#define NL80211_ATTR_MAX_WITH_VENDOR NL80211_ATTR_MAX
+#endif
 #include <net/if.h>
 #include <netlink/genl/genl.h>
 
@@ -509,11 +527,11 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
             return true;
         },
         [&](struct nl_msg *msg) {
-            struct nlattr *tb[NL80211_ATTR_MAX + 1];
+            struct nlattr *tb[NL80211_ATTR_MAX_WITH_VENDOR + 1];
             struct genlmsghdr *gnlh = static_cast<genlmsghdr *>(nlmsg_data(nlmsg_hdr(msg)));
 
             // Parse the netlink message
-            if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
+            if (nla_parse(tb, NL80211_ATTR_MAX_WITH_VENDOR, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
                           NULL)) {
                 LOG(ERROR) << "Failed to parse netlink message!";
                 return;
@@ -1096,6 +1114,15 @@ bool nl80211_client_impl::get_radio_info(const std::string &interface_name, radi
               LOG(DEBUG) << "NUMBER OF BANDS: " << radio_info.num_of_bands;
           }
 
+          if (tb[NL80211_ATTR_SMD_SUPPORT]) {
+              radio_info.smd_cfg.smd_support = true;
+              LOG(DEBUG) << "nl80211: SMD support capability detected";
+          }
+
+          if (tb[NL80211_ATTR_SMD_STA_DL_DATA_FWD]) {
+              radio_info.smd_cfg.smd_dl_data_fwd_support = true;
+              LOG(DEBUG) << "nl80211: SMD DL data forwarding capability detected";
+          }
 
         });
 }
diff --git a/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp b/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp
