From 1a755b38dd36b0faf0e6e01206e7a1fa9dac91f9 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Thu, 8 Oct 2026 12:05:42 +0530
Subject: [PATCH] Prevent sending M1 for 6G band if certification program is
 not map6

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../beerocks/slave/tasks/ap_autoconfiguration_task.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index c37efcf..91e5675 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -3546,6 +3546,16 @@ void ApAutoConfigurationTask::restart_autoconfiguration_for_all_radios()
             continue;
         }
 
+        if (radio->wifi_channel.get_freq_type() == beerocks::eFreqType::FREQ_6G &&
+            db->device_conf.certification_mode &&
+            db->device_conf.certification_program != std::string("mapr6")) {
+            LOG(INFO) << "Certification mode: skipping AP-Autoconfiguration Search on 6GHz iface: "
+                      << radio->front.iface_name;
+            m_discovery_status[beerocks::eFreqType::FREQ_6G].skipped = true;
+            FSM_MOVE_STATE(radio->front.iface_name, eState::SKIPPED);
+            continue;
+        }
+
         m_task_is_active = true;
 
         // Clear completion data from the previous M2/AP-manager cycle. The
-- 
