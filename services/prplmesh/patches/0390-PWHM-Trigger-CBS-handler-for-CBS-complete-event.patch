                     if (bandw_iter > m_radio_info.max_bandwidth) {
                         continue;
                     }
-                    // Fill with the lowest operable preference value
-                    channel_info.bw_info_list[bandw_iter] = 1;
+                    // GATING: keep the original pre-CBS baseline of 1 when CBS is disabled
+                    // (default), so the reported multiap_preference/ranking is unaffected. Use
+                    // the CBS baseline of 0 (operable-but-unranked) ONLY when enabled;
+                    // read_acs_report() then overlays the driver ranks (>=0) on top of that
+                    // baseline -- otherwise a real driver rank (which starts at 0/1) could never
