From 86e55b783cb1c548fde23709bdfa7074fb310acb Mon Sep 17 00:00:00 2001
From: athitia prakash <athiprak@qti.qualcomm.com>
Date: Thu, 16 Jul 2026 19:38:46 +0530
Subject: [PATCH] mbo-interworking-pmf

Signed-off-by: athitia prakash <athiprak@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 41 +++++++++++++++++++
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 22 ++++++++++
 2 files changed, 63 insertions(+)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 5f12716ef..bb6f36634 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -2624,6 +2624,24 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 // we always need to get the mgmt frames (assoc req) for capability reports:
                 if (bss_it.fronthaul) {
                     conf.set_create_vap_value(vap_id, "notify_mgmt_frames", "1");
+                    if (get_hal_conf().certification_mode) {
+                        // MBO and Interworking must be enabled on every fronthaul VAP so that
+                        // the MBO IE and Interworking IE appear in beacons/probe-responses for
+                        // all FH BSSes, not just the first one that triggers WPS pushbutton setup.
+                        LOG(DEBUG) << "certification-mode: "  << get_hal_conf().certification_mode;
+                        conf.set_create_vap_value(vap_id, "interworking", "1");
+                        conf.set_create_vap_value(vap_id, "mbo", "1");
+                        // MBO requires PMF (ieee80211w >= 1) when using WPA2.
+                        // assign_auth_encr_parameters() sets ieee80211w=0 for WPA2PSK, which
+                        // causes hostapd to reject the config with:
+                        //   "MBO: PMF needs to be enabled whenever using WPA2 with MBO"
+                        // Upgrade to optional PMF (ieee80211w=1) if not already enabled.
+                        // WPA3 modes already set ieee80211w=2, so only WPA2PSK needs fixing.
+                        auto current_pmf = conf.get_vap_value(vap_id, "ieee80211w");
+                        if (current_pmf.empty() || current_pmf == "0") {
+                            conf.set_create_vap_value(vap_id, "ieee80211w", "1");
+                        }
+                    }
                 }
 
                 // finally enable the vap (remove any previously set start_disabled)
@@ -4723,6 +4741,29 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
         LOG(INFO) << "wps_pushbutton set to: " << bss_conf.wps_pushbutton;
         m_radio_info.wps_pushbutton_configured=true;
     }
+
+    if (bss_conf.fronthaul) {
+        conf.set_create_vap_value(vap_id, "notify_mgmt_frames", "1");
+        if (get_hal_conf().certification_mode) {
+            // MBO and Interworking must be enabled on every fronthaul VAP so that
+            // the MBO IE and Interworking IE appear in beacons/probe-responses for
+            // all FH BSSes, not just the first one that triggers WPS pushbutton setup.
+            LOG(DEBUG) << "certification-mode: "  << get_hal_conf().certification_mode;
+            conf.set_create_vap_value(vap_id, "interworking", "1");
+            conf.set_create_vap_value(vap_id, "mbo", "1");
+            // MBO requires PMF (ieee80211w >= 1) when using WPA2.
+            // assign_auth_encr_parameters() sets ieee80211w=0 for WPA2PSK, which
+            // causes hostapd to reject the config with:
+            //   "MBO: PMF needs to be enabled whenever using WPA2 with MBO"
+            // Upgrade to optional PMF (ieee80211w=1) if not already enabled.
+            // WPA3 modes already set ieee80211w=2, so only WPA2PSK needs fixing.
+            auto current_pmf = conf.get_vap_value(vap_id, "ieee80211w");
+            if (current_pmf.empty() || current_pmf == "0") {
+                conf.set_create_vap_value(vap_id, "ieee80211w", "1");
+            }
+        }
+    }
+
     std::string multi_ap;
     if (bss_conf.fronthaul) {
         if (bss_conf.backhaul) {
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 2def3bc76..5f594e65c 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -653,6 +653,18 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             options["ieee80211k"] = "1";
             options["disabled"] = "0";
 
+            // MBO Interworking related options for AP-mode VAPs.
+            // These are added whenever the Agent applies the M2 credentials to the
+            // /etc/config/wireless wifi-iface section (mode = "ap"), so that the
+            // corresponding IEs (MBO, Interworking) are advertised in beacons.
+            //
+            // Dependency: hostapd requires interworking=1 BEFORE mbo=1 can take effect.
+            // Without interworking=1, hostapd will NOT include the MBO IE in beacons
+            // even when mbo=1 is set.
+            options["interworking"] = "1";  // MUST: prerequisite for MBO IE
+            options["mbo"]          = "1";  // MUST: enables MBO IE in beacons/probe responses
+
+
             // Set hidden option based on hidden_ssid from BSS Advanced Configuration TLV
             // hidden_ssid ENABLED  → option hidden 1 (SSID not broadcast in beacons)
             // hidden_ssid DISABLED → option hidden 0 (SSID broadcast in beacons)
@@ -935,6 +947,16 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             options["ieee80211k"] = "1";
             options["disabled"] = "0";
 
+            // MBO / Interworking related options for AP-mode (MLD) VAPs.
+            // Added when the Agent applies the M2 credentials to the
+            // /etc/config/wireless wifi-iface section (mode = "ap").
+            //
+            // Dependency: hostapd requires interworking=1 BEFORE mbo=1 can take effect.
+            // Without interworking=1, hostapd will NOT include the MBO IE in beacons
+            // even when mbo=1 is set.
+            options["interworking"] = "1";  // MUST: prerequisite for MBO IE
+            options["mbo"]          = "1";  // MUST: enables MBO IE in beacons/probe responses
+
             // Persist SSID advertisement state in UCI.
             // hidden_ssid ENABLED  -> option hidden 1 (SSID not advertised)
             // hidden_ssid DISABLED -> option hidden 0 (SSID advertised)
-- 
2.34.1

