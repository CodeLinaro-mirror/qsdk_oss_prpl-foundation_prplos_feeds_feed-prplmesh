-                    continue;
-                }
-
                 LOG(DEBUG) << "Wireless BH Link is reported for agent=" << agent->al_mac
                            << " parent agent=" << parent_agent->al_mac
-                           << " parent's bss=" << parent_bss->bssid << " with bSTA=" << iface_mac;
+                           << " bssid=" << media_info->network_membership << " with bSTA=" << iface_mac;
 
                 agent->backhaul.parent_agent = parent_agent;
 
@@ -260,11 +243,11 @@ bool topology_task::handle_topology_response(const sMacAddr &src_mac,
     }
 
     // Update external agents multi ap backhaul datamodel only when the backhaul parent is already
-    // resolved. For wireless agents: the bSTA must already be in the DB (no race); for wired
-    // agents: parent resolution happens later via graph inference, which calls
-    // dm_set_device_multi_ap_backhaul itself. When the parent is unresolved here, the deferred
-    // path in handle_topology_notification will call dm_set_device_multi_ap_backhaul once the
-    // bSTA joins the parent BSS.
+    // resolved. For wireless agents: resolved directly from this TLV's network_membership above;
+    // for wired agents: parent resolution happens later via graph inference, which calls
+    // dm_set_device_multi_ap_backhaul itself. When the parent is unresolved here (e.g. the
+    // parent agent/BSS itself isn't known yet), the deferred path in handle_topology_notification
+    // will call dm_set_device_multi_ap_backhaul once the bSTA joins the parent BSS.
     if (!agent->is_gateway && !agent->backhaul.parent_agent.expired()) {
         database.dm_set_device_multi_ap_backhaul(*agent);
     }
@@ -878,6 +861,38 @@ bool topology_task::handle_associated_clients_tlv(ieee1905_1::CmduMessageRx &cmd
             continue;
         }
 
+        // Guard against stale TOPOLOGY_RESPONSE from a PREVIOUS parent agent.
+        //
+        // previous_connected/current_connected above are scoped to THIS agent's own
+        // radios/BSSes only (built from agent.radios).  If this bSTA had never been
+        // associated to THIS agent's BSSes before, it looks like a brand-new station
+        // from this agent's point of view -- even if the controller's global database
+        // already has it correctly associated with a DIFFERENT agent (e.g. it moved
+        // there via a TOPOLOGY_NOTIFICATION some time ago, but this agent's own
+        // TOPOLOGY_RESPONSE association table is stale/out-of-date and still lists it).
+        //
+        // Without this guard, such a stale report is misclassified as "new station"
+        // (rather than "moved BSS", which already has this guard) and unconditionally
+        // overwrites the correct, already-established BSS/agent association with wrong
+        // stale data - causing a wrong StationConnected NBAPI event and wrong
+        // ServingBSSID in the backhaul DM.
+        auto existing_sta_ptr = database.get_station(mac);
+        if (existing_sta_ptr && existing_sta_ptr->is_bSta()) {
+            auto existing_bss = existing_sta_ptr->get_bss();
+            if (existing_bss) {
+                auto existing_bss_agent = database.get_agent_by_bssid(existing_bss->bssid);
+                if (existing_bss_agent && existing_bss_agent->al_mac != agent.al_mac) {
+                    LOG(WARNING) << "Stale TOPOLOGY_RESPONSE 'new station' report suppressed:"
+                                 << " sta_mac=" << mac
+                                 << " DB already has it on agent=" << existing_bss_agent->al_mac
+                                 << " bssid=" << existing_bss->bssid
+                                 << " but stale TOPOLOGY_RESPONSE from agent=" << agent.al_mac
+                                 << " claims bssid=" << bssid;
+                    continue;
+                }
+            }
+        }
+
         database.add_station(agent.al_mac, mac, bssid);
     }
 
@@ -908,6 +923,32 @@ bool topology_task::handle_associated_clients_tlv(ieee1905_1::CmduMessageRx &cmd
             continue;
         }
 
+        // Guard against stale TOPOLOGY_RESPONSE: if this station is a backhaul STA
+        // and its current BSS in the DB belongs to a different agent than the one
+        // sending this TOPOLOGY_RESPONSE, the response is stale (the bSTA has already
+        // moved to a new parent agent via a TOPOLOGY_NOTIFICATION).  Applying the
+        // stale move would fire a wrong StationConnected NBAPI event and overwrite
+        // the correct ServingBSSID in the backhaul DM.
+        //
+        // Root cause: in MLD setups the previous parent agent still has the bSTA in
+        // its associated_clients list (DISASSOCIATE not yet processed) when it sends
+        // its TOPOLOGY_RESPONSE, causing handle_associated_clients_tlv to detect a
+        // spurious "BSS move" back to the old parent.
+        auto sta_ptr = database.get_station(sta_mac);
+        if (sta_ptr && sta_ptr->is_bSta()) {
+            auto current_bss_agent = database.get_agent_by_bssid(old_bssid);
+            if (current_bss_agent &&
+                current_bss_agent->al_mac != agent.al_mac) {
+                LOG(WARNING) << "Stale TOPOLOGY_RESPONSE bSTA move suppressed:"
+                             << " sta_mac=" << sta_mac
+                             << " DB has it on agent=" << current_bss_agent->al_mac
+                             << " bssid=" << old_bssid
+                             << " but TOPOLOGY_RESPONSE from agent=" << agent.al_mac
+                             << " claims bssid=" << current_bssid;
+                continue;
+            }
+        }
+
         database.add_station(agent.al_mac, sta_mac, current_bssid);
     }
 
@@ -1096,44 +1137,127 @@ bool topology_task::handle_topology_notification(const sMacAddr &src_mac,
         LOG(INFO) << "client connected, al_mac=" << src_mac << " mac=" << client_mac_str
                   << ", bssid=" << bssid_str;
 
+        // Proactively remove this bSTA from every OTHER agent's connected_stations list
+        // in the controller's own database.
+        //
+        // Root cause this guards against: when a bSTA roams to a new parent agent
+        // (src_mac), the DISASSOCIATE sent to the previous agent (below, via
+        // son_actions::handle_completed_connection) takes time to reach that agent and
+        // be processed there.  In that window, the previous agent may still send a
+        // TOPOLOGY_RESPONSE (built from its own, not-yet-updated associated_clients
+        // list) that still reports this bSTA as connected to its old BSS.  Without this
+        // proactive cleanup, handle_associated_clients_tlv() would see that stale BSSID
+        // as "unchanged" for the previous agent (since the controller DB itself still
+        // had it there) and skip the moved-BSS guard, causing the wrong StationConnected
+        // event / wrong ServingBSSID to reappear.
+        //
+        // By erasing the bSTA from every other agent's connected_stations here (as soon
+        // as the JOIN is processed for the new agent), the controller's own view becomes
+        // "previous_connected has NO entry for this bSTA" the next time a stale
+        // TOPOLOGY_RESPONSE from the old agent is processed - which correctly routes it
+        // through the "new station" guard (Fix 4) instead of silently matching stale
+        // data as unchanged.
+        if (client->is_bSta()) {
+            for (auto &agent_pair : database.m_agents) {
+                auto &other_agent = agent_pair.second;
+                if (!other_agent || other_agent->al_mac == src_mac) {
+                    continue; // skip the new (correct) parent agent
+                }
+                for (auto &radio_pair : other_agent->radios) {
+                    if (!radio_pair.second) {
+                        continue;
+                    }
+                    for (auto &bss_pair : radio_pair.second->bsses) {
+                        if (!bss_pair.second) {
+                            continue;
+                        }
+                        auto &connected_stations = bss_pair.second->connected_stations;
+                        if (connected_stations.erase(client_mac) > 0) {
+                            LOG(DEBUG) << "Proactively removed bSTA " << client_mac_str
+                                      << " from previous agent " << other_agent->al_mac
+                                      << " BSS " << bss_pair.second->bssid
+                                      << " after JOIN to new agent " << src_mac
+                                      << " BSS " << bssid_str;
+                        }
+                    }
+                }
+            }
+        }
+
         // If this STA is connecting to a backhaul BSS, it may be a backhaul STA (bSTA) of a
-        // child agent.  When the child agent's TOPOLOGY_RESPONSE was processed earlier, the bSTA
-        // was not yet in the database (timing: TOPOLOGY_RESPONSE arrives before TOPOLOGY_
-        // NOTIFICATION with JOIN), so parent_agent was left null and BackhaulDeviceID was set
-        // to "" in the DM.  Now that the bSTA has joined, re-resolve the parent and update the
-        // backhaul DM so that BackhaulDeviceID is correctly populated.
+        // child agent.  Re-resolve the parent and update the backhaul DM (ServingBSSID,
+        // BackhaulDeviceID, ParentALMAC) so that it always reflects the CURRENT parent/BSS.
+        //
+        // This must run UNCONDITIONALLY on every JOIN of a bSTA to a backhaul BSS, not only
+        // when parent_agent was previously unresolved.  Two distinct scenarios both rely on
+        // this block firing:
+        //
+        //   1) Initial connection: TOPOLOGY_RESPONSE from the child agent arrived before the
+        //      TOPOLOGY_NOTIFICATION JOIN (the bSTA wasn't in the DB yet), so parent_agent was
+        //      left null/expired and BackhaulDeviceID was "" in the DM.
+        //
+        //   2) Re-parenting (bSTA roams from one parent agent to another, e.g. GW -> agent07):
+        //      child_agent_ptr->backhaul.parent_agent is ALREADY resolved (points to the OLD
+        //      parent), so the previous "only if expired()" guard skipped this block entirely,
+        //      permanently leaving the backhaul DM (ServingBSSID/BackhaulDeviceID/ParentALMAC)
+        //      stuck on the stale, previous parent even though the bSTA correctly moved.
+        //
+        // Skip only when nothing actually changed (same parent + same BSS) to avoid redundant
+        // DM writes on every JOIN retry/duplicate notification for an already-correct mapping.
         {
             auto bss_ptr = database.get_bss(bssid);
             if (bss_ptr && bss_ptr->backhaul) {
-                // Find the child agent whose backhaul_interface matches this bSTA MAC
-                // and whose parent_agent is not yet resolved.
+                // Find the child agent whose backhaul_interface matches this bSTA MAC.
                 for (auto &agent_pair : database.m_agents) {
                     auto &child_agent_ptr = agent_pair.second;
                     if (!child_agent_ptr || child_agent_ptr->is_gateway) {
