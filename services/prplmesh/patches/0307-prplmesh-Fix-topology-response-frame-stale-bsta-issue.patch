From af06f90ced3166764b39a8a3d555d755641d9341 Mon Sep 17 00:00:00 2001
From: Sandeep Tomer <stomer@qti.qualcomm.com>
Date: Fri, 14 Aug 2026 14:31:48 +0530
Subject: [PATCH] [prplmesh] Fix topology response frame stale bsta issue an
 updating backhaul data model.

-Agent side__: Stale `radio->associated_clients` entries (MLD disconnect bug)
 causing the old agent to keep reporting the bSTA in `TOPOLOGY_RESPONSE` indefinitely.

-Agent side__: Stale `backhaul_bssid` in AgentDB after a steady-state roam,
 causing wrong `network_membership` in the topology report.

-Agent side (HAL)__: Duplicate `STA_Connected` events from multiple
 AP managers in MLD setups due to missing ownership guards.

-Controller side__: Race condition in parent agent resolution from
 `TOPOLOGY_RESPONSE` (Station DB dependency).

-Controller side__: Stale `TOPOLOGY_RESPONSE` from the old parent
 agent overwriting the correct BSS/agent association after a roam.

-Controller side__: Backhaul DM (`ServingBSSID`/`BackhaulDeviceID`)
 not updated on re-parenting.

Signed-off-by: Sandeep Tomer <stomer@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     |  19 +-
 agent/src/beerocks/slave/son_slave_thread.cpp |  23 +-
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       |  51 +++-
 controller/src/beerocks/master/db/db.cpp      |   8 +-
 .../src/beerocks/master/son_actions.cpp       |   3 +-
 .../beerocks/master/tasks/topology_task.cpp   | 236 +++++++++++++-----
 6 files changed, 271 insertions(+), 69 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 4b2357087..0476154f8 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -617,7 +617,6 @@ bool BackhaulManager::handle_backhaul_connect()
             LOG_IF(!radio_info->sta_wlan_hal, FATAL) << "selected sta_hal is nullptr";
             db->backhaul.backhaul_bssid =
                 tlvf::mac_from_string(radio_info->sta_wlan_hal->get_bssid());
-
             //This code segment is commented out to avoid missing EndPoint Object change event, when
             //BSTA disconnect
             /*if (!radio_info->sta_wlan_hal->unique_file_descriptors() &&
@@ -2910,6 +2909,24 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
 
             stop_on_failure_attempts = configuration_stop_on_failure_attempts;
             FSM_MOVE_STATE(CONNECTED);
+        } else if (iface == db->backhaul.selected_iface_name &&
+                  bssid != db->backhaul.backhaul_bssid) {
+            // Steady-state roam: the FSM is already OPERATIONAL/CONNECTED so none of the
+            // transitional branches above fired, but the bSTA's peer BSSID changed underneath
+            // us. handle_backhaul_connect() (the only other place backhaul_bssid gets updated)
+            // only runs on FSM entry into CONNECTED, so refresh AgentDB directly here.
+            //
+            // Guarded by "bssid != db->backhaul.backhaul_bssid" to avoid redundantly
+            // re-triggering this branch (and a fresh topology report) if wpa_supplicant
+            // delivers duplicate CTRL-EVENT-CONNECTED events for the same, already-known
+            // BSSID (e.g. a reconnect to the same AP without an actual roam).
+            db->backhaul.backhaul_bssid = bssid;
+            LOG(INFO) << "Backhaul roamed to new bssid=" << bssid << " on iface=" << iface;
+
+            // Push a fresh topology report now instead of waiting for the periodic
+            // (up to 60s) Topology Discovery, so the controller sees the corrected
+            // network_membership as soon as possible.
+            m_task_pool.send_event(eTaskType::TOPOLOGY, TopologyTask::eEvent::AGENT_RADIO_STATE_CHANGED);
         }
     } break;
 
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 4c0d37ece..4acdaa6a4 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4014,8 +4014,27 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
             }
         }
         // For non-MLD clients: call erase_client to remove from radio->associated_clients.
-        // For MLD clients: do NOT call erase_client(mld_mac) — it removes associated_sta_mlds.
-        if (!is_mld_client) {
+        //
+        // For MLD clients: erase_client() must still be called once ALL affiliated links
+        // have disconnected (send_leave == true), to remove the stale
+        // radio->associated_clients[mld_mac] entry created on connect (see
+        // process_client_association()).  Calling erase_client() here is safe even though
+        // the associated_sta_mlds entry was already explicitly erased above (Case A/B) —
+        // that second erase is simply a no-op.
+        //
+        // BUG FIXED: previously this call was skipped unconditionally for ANY MLD client
+        // (is_mld_client == true), so radio->associated_clients[mld_mac] was NEVER cleared
+        // on disconnect.  The agent's own TOPOLOGY_RESPONSE tlvAssociatedClients (built from
+        // radio->associated_clients — see add_associated_clients_tlv()) then kept reporting
+        // this stale, long-disconnected bSTA to the Controller indefinitely (elapsed_sec kept
+        // climbing in logs).  When the bSTA later associated with a *different* agent, the
+        // Controller received this stale report from the OLD agent and incorrectly
+        // overwrote the bSTA's correct BSS/agent association and ServingBSSID in the
+        // backhaul Data Model, and fired a wrong StationConnected NBAPI event.
+        //
+        // While still connected on other links (send_leave == false), the entry must be
+        // preserved, so erase_client() is skipped exactly as before in that case.
+        if (!is_mld_client || send_leave) {
             db->erase_client(client_mac);
         }
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index f0c777fe6..b7bdc8f6a 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -6302,14 +6302,36 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
 
     auto vap_id    = get_vap_id_with_bss(interface);
     auto iface_ids = beerocks::utils::get_ids_from_iface_string(interface);
+
+    // Compute this radio's own MLD link ID once (from m_radio_info.iface_name).
+    // Reused below both by the MLD vap_id fallback loop and by the
+    // WDS-STA-INTERFACE-ADDED handler's backhaul-VAP ownership guard, avoiding
+    // a redundant extractLinkId() call on the same (unchanging) iface_name.
+    int own_link_id = -1;
+    extractLinkId(m_radio_info.iface_name, own_link_id);
+
     if (vap_id < 0) {
         // Fallback: for MLD radios, the event may arrive with the bare radio name
         // (e.g. "wlan1mld1") or an MLD link pseudo-name, while available_vaps is keyed
         // by the link-specific name (e.g. "wlan1mld1_link0"). Retry with the
         // link-suffixed variants before giving up.
+        //
+        // MLD ownership guard: in MLD setups the global hostapd socket delivers
+        // AP-STA-CONNECTED for every link to every AP manager instance.  Each AP
+        // manager's available_vaps contains BSSes from all radios (shared hostapd
+        // instance), so without this guard the loop would find a valid vap_id on
+        // the first link regardless of which radio actually owns it, causing every
+        // AP manager to push a duplicate STA_Connected event.
+        // Fix: if this radio has a known link ID (MLD link interface), restrict the
+        // fallback to that specific link index only.  Non-MLD radios (link_id == -1)
+        // retain the original try-all behaviour.
         for (int link_idx = 0;
              link_idx < static_cast<int>(beerocks::message::DEV_MAX_RADIOS) && vap_id < 0;
              link_idx++) {
+            // For MLD radios only try the link that belongs to this radio.
+            if (own_link_id >= 0 && link_idx != own_link_id) {
+                continue;
+            }
             std::string candidate = interface + "_link" + std::to_string(link_idx);
             vap_id                = get_vap_id_with_bss(candidate);
             if (vap_id >= 0) {
@@ -7066,18 +7088,37 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         }
 
         // Resolve the backhaul BSS bssid and vap_id from available_vaps.
+        //
+        // MLD ownership guard: in MLD setups available_vaps contains backhaul BSSes
+        // from all radios (shared hostapd instance).  Without filtering, every AP
+        // manager would pick the first backhaul VAP it finds — which may belong to a
+        // different radio — and report the wrong BSSID for the WDS interface.
+        // Fix: if this radio has a known link ID (own_link_id, computed once above),
+        // only accept the backhaul VAP whose BSS interface has the same link ID.
+        // Non-MLD radios (own_link_id == -1) retain the original "first backhaul VAP"
+        // behaviour.
         sMacAddr bssid  = beerocks::net::network_utils::ZERO_MAC;
         int8_t bh_vap_id = beerocks::IFACE_ID_INVALID;
         for (const auto &vap_kv : m_radio_info.available_vaps) {
-            if (vap_kv.second.backhaul) {
-                bssid     = tlvf::mac_from_string(vap_kv.second.mac);
-                bh_vap_id = vap_kv.first;
-                break;
+            if (!vap_kv.second.backhaul) {
+                continue;
+            }
+            if (own_link_id >= 0) {
+                // MLD radio: only accept the backhaul VAP with the same link ID.
+                int vap_link_id = -1;
+                extractLinkId(vap_kv.second.bss, vap_link_id);
+                if (vap_link_id != own_link_id) {
+                    continue;
+                }
             }
+            bssid     = tlvf::mac_from_string(vap_kv.second.mac);
+            bh_vap_id = vap_kv.first;
+            break;
         }
 
         if (bh_vap_id == beerocks::IFACE_ID_INVALID) {
-            LOG(WARNING) << "WDS-STA-INTERFACE-ADDED: no backhaul VAP found on this radio";
+            LOG(DEBUG) << "WDS-STA-INTERFACE-ADDED: no matching backhaul VAP on this radio"
+                       << " (own_link_id=" << own_link_id << ") — ignoring";
             break;
         }
 
