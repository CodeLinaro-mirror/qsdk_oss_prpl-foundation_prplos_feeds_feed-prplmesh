@@ -3390,31 +3390,50 @@ std::vector<uint8_t> DppAgentTask::jwk_pubkey_to_der(const std::string &jwk_json
 
     std::string x_b64 = extract_jwk_field("x");
     std::string y_b64 = extract_jwk_field("y");
+    std::string crv   = extract_jwk_field("crv");
     if (x_b64.empty() || y_b64.empty()) {
         LOG(ERROR) << "jwk_pubkey_to_der: jwk missing x or y";
         return {};
     }
 
+    // DPP Configurators may sign with any of the curves listed in the DPP spec, not just
+    // P-256 -- the JWK's own "crv" tells us which one this key actually is. Coordinate byte
+    // length is curve-dependent (P-256: 32, P-384: 48, P-521: 66); getting it wrong truncates
+    // or misreads x/y for anything other than P-256. Default to P-256 only if "crv" is absent,
+    // matching the previous unconditional assumption for that one case.
+    size_t coord_len = 32;
+    if (crv.empty() || crv == "P-256") {
+        crv       = "P-256";
+        coord_len = 32;
+    } else if (crv == "P-384") {
+        coord_len = 48;
+    } else if (crv == "P-521") {
+        coord_len = 66;
+    } else {
+        LOG(ERROR) << "jwk_pubkey_to_der: unsupported jwk curve '" << crv << "'";
+        return {};
+    }
+
     std::vector<uint8_t> x_bytes = base64url_decode(x_b64);
     std::vector<uint8_t> y_bytes = base64url_decode(y_b64);
-    if (x_bytes.size() < 32 || y_bytes.size() < 32) {
-        LOG(ERROR) << "jwk_pubkey_to_der: x or y too short";
+    if (x_bytes.size() < coord_len || y_bytes.size() < coord_len) {
+        LOG(ERROR) << "jwk_pubkey_to_der: x or y too short for curve " << crv;
         return {};
     }
 
-    // Build uncompressed EC point: 0x04 || x(32) || y(32)
-    uint8_t pub[65];
+    // Build uncompressed EC point: 0x04 || x(coord_len) || y(coord_len)
+    std::vector<uint8_t> pub(1 + 2 * coord_len);
     pub[0] = 0x04;
-    memcpy(pub + 1,  x_bytes.data(), 32);
-    memcpy(pub + 33, y_bytes.data(), 32);
+    memcpy(pub.data() + 1, x_bytes.data(), coord_len);
+    memcpy(pub.data() + 1 + coord_len, y_bytes.data(), coord_len);
 
     EVP_PKEY *pkey = nullptr;
     OSSL_PARAM_BLD *bld = OSSL_PARAM_BLD_new();
     OSSL_PARAM *par     = nullptr;
     EVP_PKEY_CTX *fctx  = nullptr;
     if (bld) {
-        OSSL_PARAM_BLD_push_utf8_string(bld, OSSL_PKEY_PARAM_GROUP_NAME, "P-256", 0);
-        OSSL_PARAM_BLD_push_octet_string(bld, OSSL_PKEY_PARAM_PUB_KEY, pub, 65);
+        OSSL_PARAM_BLD_push_utf8_string(bld, OSSL_PKEY_PARAM_GROUP_NAME, crv.c_str(), 0);
+        OSSL_PARAM_BLD_push_octet_string(bld, OSSL_PKEY_PARAM_PUB_KEY, pub.data(), pub.size());
         par = OSSL_PARAM_BLD_to_param(bld);
     }
     fctx = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr);
diff --git a/common/beerocks/bcl/source/beerocks_event_loop_impl.cpp b/common/beerocks/bcl/source/beerocks_event_loop_impl.cpp
index a2fbd6d95..9db3bd0e6 100755
--- a/common/beerocks/bcl/source/beerocks_event_loop_impl.cpp
