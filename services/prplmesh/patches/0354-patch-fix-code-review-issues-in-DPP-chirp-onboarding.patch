@@ -68,12 +68,19 @@ bool EventLoopImpl::register_handlers(int fd, const EventLoop::EventHandlers &ha
     // (e.g. its destructor closed the underlying descriptor) without going through
     // remove_handlers() first. Trusting this bookkeeping over the kernel would make that fd
     // number permanently unusable for the rest of the process lifetime, since a new descriptor
-    // can be assigned the same (now free) number by the OS. So only warn here; epoll_ctl() below
-    // is the actual source of truth and will fail with EEXIST if the fd is genuinely still
-    // registered.
-    if (m_fd_to_event_handlers.find(fd) != m_fd_to_event_handlers.end()) {
+    // can be assigned the same (now free) number by the OS. So drop it from the map up front —
+    // epoll_ctl() below is the actual source of truth. If it fails with EEXIST the fd is
+    // genuinely still registered (not stale after all), so the erased entry is restored rather
+    // than leaving its real owner with dangling bookkeeping.
+    EventLoop::EventHandlers stale_handlers;
+    bool had_stale_entry = false;
+    auto stale_it        = m_fd_to_event_handlers.find(fd);
+    if (stale_it != m_fd_to_event_handlers.end()) {
         LOG(WARNING) << "FD (" << fd << ") already tracked in the poll — recovering if the "
                      << "kernel confirms it was actually released";
+        stale_handlers  = stale_it->second;
+        had_stale_entry = true;
+        m_fd_to_event_handlers.erase(stale_it);
     }
 
     LOG(INFO) << "Register handlers for FD (" << fd << ")" << get_fd_name_print(handlers.name);
