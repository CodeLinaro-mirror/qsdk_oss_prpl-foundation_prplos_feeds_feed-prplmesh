diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 2737a6db0..49fd2c9a4 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -5327,6 +5327,28 @@ void BackhaulManager::retry_dpp_chirp_after_failure(const std::string &sta_iface
 // DPP bootstrap key injection — wpa_supplicant setup for a wireless bSTA
 // ---------------------------------------------------------------------------
 
+// AKM OUI values (Wi-Fi Alliance DPP OUI 50:6F:9A type 2, IEEE 802.11 AKM suite selectors):
+//   506F9A02 = DPP, 000FAC02 = PSK (WPA2-Personal), 000FAC08 = SAE (WPA3-Personal).
+// DPP is always prepended for the BH bSTA (the agent authenticates via the DPP connector), then
+// the AKM(s) matching the backhaul network's actual configured security are appended — mirrors
+// wsc_auth_to_bh_akm()/wsc_auth_to_fh_akm() in the controller's dpp_configurator_task.cpp, just
+// driven by the agent's own bwl::WiFiSec config instead of a WSC::eWscAuth from a TLV.
+static std::string bwl_security_to_bh_akm(bwl::WiFiSec security_type)
+{
+    switch (security_type) {
+    case bwl::WiFiSec::WPA2_PSK:
+        return "506F9A02+000FAC02";
+    case bwl::WiFiSec::WPA3_PSK:
+        return "506F9A02+000FAC08";
+    case bwl::WiFiSec::WPA2_WPA3_PSK:
+        return "506F9A02+000FAC08+000FAC02";
+    default:
+        LOG(WARNING) << "DPP: unsupported backhaul security type " << security_type
+                     << " for bSTAList AKM — defaulting to DPP+SAE";
+        return "506F9A02+000FAC08";
+    }
+}
+
 bool BackhaulManager::inject_dpp_bootstrap_key_and_conf_req(
     const std::shared_ptr<sRadioInfo> &radio_info)
 {
@@ -5367,8 +5389,9 @@ bool BackhaulManager::inject_dpp_bootstrap_key_and_conf_req(
     db->dpp_bootstrap.dpp_uri = uri;
 
     // Set bSTAList for the EasyMesh config request.
+    std::string akm = bwl_security_to_bh_akm(db->device_conf.back_radio.security_type);
     std::string bsta_val = "[{\"netRole\":\"mapBackhaulSta\","
-                           "\"akm\":\"506F9A02+000FAC08\","
+                           "\"akm\":\"" + akm + "\","
                            "\"channelList\":\"81/1,6,11,115/36,121/100,125/149\"}]";
     radio_info->sta_wlan_hal->dpp_set_extra_conf_req_bsta_list(bsta_val);
 
@@ -5404,12 +5427,24 @@ std::string BackhaulManager::extract_net_role_from_connector(const std::string &
     while (s.size() % 4) {
         s += '=';
     }
+    // EVP_DecodeBlock() always returns a length that is a multiple of 3 (one full 4-char base64
+    // group -> 3 bytes), regardless of trailing '=' padding — it does NOT subtract the 1-2 bytes
+    // that padding indicates are not actually part of the payload. Callers must do that
+    // themselves, or the decoded buffer ends up with 1-2 bogus trailing bytes.
+    size_t pad_len = 0;
+    for (auto it = s.rbegin(); it != s.rend() && *it == '='; ++it) {
+        ++pad_len;
+    }
     std::vector<uint8_t> raw(s.size());
     int len = EVP_DecodeBlock(raw.data(), reinterpret_cast<const unsigned char *>(s.c_str()),
                                static_cast<int>(s.size()));
     if (len <= 0) {
         return {};
     }
+    len -= static_cast<int>(pad_len);
+    if (len <= 0) {
+        return {};
+    }
     std::string payload_json(reinterpret_cast<const char *>(raw.data()),
                              static_cast<size_t>(len));
 
