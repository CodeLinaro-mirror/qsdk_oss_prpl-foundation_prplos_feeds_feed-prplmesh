index e71757eb9..a90837899 100644
--- a/controller/nbapi/odl/controller.odl.in
+++ b/controller/nbapi/odl/controller.odl.in
@@ -514,6 +514,10 @@
                         %in %mandatory list SCSDisallowedStaList
                     );
 
+                    string SetEndToEndQMDescriptors(
+                        %in %mandatory list EndToEndQMDescriptor
+                    );
+
                     void ClientSteering(
                         %in %mandatory string station_mac,
                         %in %mandatory string target_bssid
@@ -727,3 +731,4 @@ include "agent_connected_event.odl";
 include "failed_connection_event.odl";
 include "agent_disconnected_event.odl";
 include "unassociated_sta.odl";
+include "end_to_end_qm.odl";
diff --git a/controller/nbapi/odl/end_to_end_qm.odl.in b/controller/nbapi/odl/end_to_end_qm.odl.in
new file mode 100644
index 000000000..97ca8cb54
--- /dev/null
+++ b/controller/nbapi/odl/end_to_end_qm.odl.in
@@ -0,0 +1,60 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+%define {
+    select @DATAELEMENTS_ROOT_DM@.Network {
+        /**
+         * @brief End-to-End QoS Management Descriptor entry.
+         *
+         * This object contains a descriptor element for MSCS, SCS, or QoS Management.
+         * The table MUST contain at least 1 entry with Instance Numbers 1, 2, 3...
+         * (assigned sequentially without gaps).
+         */
+        object EndToEndQMDescriptor {
+            /**
+             * End To End QoS Rule Identifier (0-255).
+             * Not filled when sending Device.WiFi.DataElements.Network.SetEndToEndQMDescriptors()
+             */
+            uint32 QMID {
+                on action validate call check_range [0, 255];
+            }
+
+            /**
+             * [MANDATORY] [MACAddress] MAC address of the "End Client" for which this descriptor applies.
+             */
+            string ClientMAC {
+                on action validate call check_maximum_length 17;
+            }
+
+            /**
+             * [MANDATORY] The descriptor element. One of:
+             * - MSCS descriptor element (as described in [Section 9.4.2.243/802.11-2020])
+             * - SCS descriptor element (as described in [Section 9.4.2.121/802.11-2020])
+             * - QoS Management DSCP policy element (as described in [Section 9.4.2.94/802.11-2020] and [Section 6.3/RFC8325])
+             */
+            string DescriptorElement;
+        }
+
+        /**
+         * @brief Configure End-to-End QoS Management Descriptors for a client.
+         *
+         * This command configures descriptor elements for Mirrored Stream Classification Service (MSCS),
+         * Stream Classification Service (SCS), or QoS Management for end-to-end path to a client.
+         *
+         * If Input.EndToEndQMDescriptor.{i}.DescriptorElement is for SCS or MSCS, the AP adds/changes/removes
+         * the rule according to the descriptor element request type. The QoS characteristics in descriptor
+         * are adjusted as per number of hops to the "End Client" and descriptor is installed in each of
+         * the AP in the path to "End Client".
+         *
+         * If Input.EndToEndQMDescriptor.{i}.DescriptorElement is a QoS Management DSCP Policy, the AP sends it
+         * to the STA identified by the Input.EndToEndQMDescriptor.{i}.ClientMAC.
+         *
+         * @param EndToEndQMDescriptor Table of descriptor elements (at least 1 entry required)
+         * @return Status indicating the outcome of the request (Success, Error_Invalid_Input, Error_Timeout, Error_Other)
+         */
+        string SetEndToEndQMDescriptors(
+            %in %mandatory list EndToEndQMDescriptor
+        );
+    }
+}
diff --git a/controller/nbapi/on_action.cpp b/controller/nbapi/on_action.cpp
index 117e70142..a58d0325e 100644
--- a/controller/nbapi/on_action.cpp
+++ b/controller/nbapi/on_action.cpp
@@ -1645,6 +1645,156 @@ amxd_status_t set_scs_disallowed(amxd_object_t *object, amxd_function_t *func, a
     controller->trigger_prioritization_config();
     return amxd_status_ok;
 }
+
+/**
+ * @brief Configure End-to-End QoS Management Descriptors.
+ *
+ * This command configures descriptor elements for MSCS, SCS, or QoS Management
+ * for end-to-end path to clients (referred as "End Clients").
+ *
+ * Example usage with single descriptor:
+ * ubus call Device.WiFi.DataElements.Network SetEndToEndQMDescriptors \
+ * '{"EndToEndQMDescriptor":[{"ClientMAC":"aa:bb:cc:dd:ee:ff","DescriptorElement":"0102030405"}]}'
+ *
+ * Example usage with multiple descriptors:
+ * ubus call Device.WiFi.DataElements.Network SetEndToEndQMDescriptors \
+ * '{"EndToEndQMDescriptor":[
+ *   {"ClientMAC":"aa:bb:cc:dd:ee:ff","DescriptorElement":"0102030405","QMID":1},
+ *   {"ClientMAC":"11:22:33:44:55:66","DescriptorElement":"0a0b0c0d0e"}
+ * ]}'
+ */
+amxd_status_t set_end_to_end_qm_descriptors(amxd_object_t *object, amxd_function_t *func,
+                                            amxc_var_t *args, amxc_var_t *ret)
+{
+    if (!g_database) {
+        LOG(ERROR) << "Invalid database access";
+        amxc_var_set(cstring_t, ret, "Error_Other");
+        return amxd_status_unknown_error;
+    }
+
+    auto controller = g_database->get_controller_ctx();
+    if (!controller) {
+        LOG(ERROR) << "Failed to get controller context";
+        amxc_var_set(cstring_t, ret, "Error_Other");
+        return amxd_status_unknown_error;
+    }
+
+    // Get the list of EndToEndQMDescriptor objects
+    auto descriptors = get_list_argument(args, "EndToEndQMDescriptor");
+    if (!descriptors) {
+        LOG(ERROR) << "EndToEndQMDescriptor list is missing";
+        amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+        return amxd_status_invalid_value;
+    }
+
+    // Validate that we have at least one descriptor (per spec requirement)
+    if (amxc_llist_size(amxc_var_constcast(amxc_llist_t, descriptors)) == 0) {
+        LOG(ERROR) << "EndToEndQMDescriptor list is empty (at least 1 entry required)";
+        amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+        return amxd_status_invalid_value;
+    }
+
+    std::vector<sPendingQmDescriptor> pending_descriptors;
+    std::unordered_set<std::string> client_macs;
+
+    // Process each descriptor in the list
+    amxc_var_for_each(entry, descriptors)
+    {
+        std::string client_mac_str;
+        std::string descriptor_element;
+
+        // Get mandatory ClientMAC and DescriptorElement
+        if (!read_string_value(entry, "ClientMAC", client_mac_str) ||
+            !read_string_value(entry, "DescriptorElement", descriptor_element)) {
+            LOG(ERROR) << "EndToEndQMDescriptor entry is missing required fields (ClientMAC or DescriptorElement)";
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        // Validate ClientMAC
+        if (!network_utils::is_valid_mac(client_mac_str)) {
+            LOG(ERROR) << "Invalid ClientMAC " << client_mac_str;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        const auto client_mac            = tlvf::mac_from_string(client_mac_str);
+        const auto normalized_client_mac = tlvf::mac_to_string(client_mac);
+
+        // Check for duplicate entries (same client MAC)
+        if (!client_macs.insert(normalized_client_mac).second) {
+            LOG(ERROR) << "Duplicate EndToEndQMDescriptor entry for client " << normalized_client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        // Get optional QMID parameter (range 0-255 per spec)
+        uint32_t qmid = amxc_var_dyncast(uint32_t, GET_ARG(entry, "QMID"));
+        if (qmid > 255) {
+            LOG(ERROR) << "Invalid QMID " << qmid << " for client " << normalized_client_mac << " (must be 0-255)";
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        // Log QMID if provided (note: per spec, QMID is typically not filled when sending)
+        if (qmid > 0) {
+            LOG(DEBUG) << "SetEndToEndQMDescriptors: QMID=" << qmid << " provided for client " 
+                       << normalized_client_mac;
+        }
+
+        // Validate DescriptorElement format
+        if (!is_strict_hex_string(descriptor_element)) {
+            LOG(ERROR) << "Invalid DescriptorElement format for client " << normalized_client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        // Validate DescriptorElement content
+        const auto descriptor_bytes =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(descriptor_element);
+        if (!qos_management::is_valid_qos_management_descriptor_element(descriptor_bytes)) {
+            LOG(ERROR) << "Invalid DescriptorElement content for client " << normalized_client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        pending_descriptors.push_back({client_mac, std::move(descriptor_element)});
+    }
+
+    // Now configure all validated descriptors
+    for (const auto &descriptor : pending_descriptors) {
+        // Find the BSS for the client
+        auto station = g_database->get_station(descriptor.client_mac);
+        if (!station) {
+            LOG(ERROR) << "Station not found for client " << descriptor.client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        auto bss = station->get_bss();
+        if (!bss) {
+            LOG(ERROR) << "BSS not found for client " << descriptor.client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        // Configure the descriptor
+        if (!g_database->set_controller_qm_descriptor(bss->bssid, descriptor.client_mac,
+                                                      descriptor.descriptor_element)) {
+            LOG(ERROR) << "Failed to configure controller QMDescriptor for client " 
+                       << descriptor.client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Other");
+            return amxd_status_unknown_error;
+        }
+
+        LOG(INFO) << "SetEndToEndQMDescriptors: Configured descriptor for client " 
+                  << descriptor.client_mac;
+    }
+
+    controller->trigger_prioritization_config();
+    amxc_var_set(cstring_t, ret, "Success");
+    return amxd_status_ok;
+}
 /**
  * @brief add an unassociated station using the channel given in the arguments
  * 
@@ -2708,6 +2858,8 @@ std::vector<beerocks::nbapi::sFunctions> get_func_list(void)
          set_mscs_disallowed},
         {"set_scs_disallowed", DATAELEMENTS_ROOT_DM ".Network.SetSCSDisallowed",
          set_scs_disallowed},
+        {"set_end_to_end_qm_descriptors", DATAELEMENTS_ROOT_DM ".Network.SetEndToEndQMDescriptors",
+         set_end_to_end_qm_descriptors},
         {"add_unassociated_station",
          DATAELEMENTS_ROOT_DM ".Network.Device.Radio.AddUnassociatedStation",
          add_unassociated_station},
