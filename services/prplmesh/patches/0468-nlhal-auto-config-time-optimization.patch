Subject: [PATCH 1/3] nlhal auto config time optimization

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 9c392b65c..bf96e29dd 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -1174,6 +1174,7 @@ void ApAutoConfigurationTask::configuration_complete_wait_action(const std::stri
         return;
     }
 
+#if !USE_PRPLMESH_NLHAL
     // Ap AutoConf starts to be applied once radio is up, i.e at least one BSS is enabled
     // So no need to require for all BBSs to be enabled, (or even timeouting here)
     // to follow up with auto conf completion
@@ -1187,6 +1188,7 @@ void ApAutoConfigurationTask::configuration_complete_wait_action(const std::stri
             return;
         }
     }
+#endif
 #endif
 
     LOG(INFO) << "num_of_bss_available " << radio_conf_params.num_of_bss_available
