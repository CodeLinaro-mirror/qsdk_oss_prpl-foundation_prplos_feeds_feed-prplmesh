From 3036c37aebc53b3581f01092fce5822eb1e327ae Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:11:22 +0530
Subject: [PATCH 14/54] Added newly created bss info to default hostapd config
 file

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../bwl/include/bwl/base_wlan_hal_types.h     |  2 ++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 27 +++++++++++++++++++
 .../hostapd/include/hostapd/configuration.h   |  4 +++
 .../beerocks/hostapd/source/configuration.cpp | 11 ++++++++
 4 files changed, 44 insertions(+)

diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index 4610fc5b8..394147d17 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -224,6 +224,8 @@ struct RadioInfo {
     bool eht_supported = false; ///< Is 802.11be (Extremely High Throughput) protocol supported
 
     std::vector<std::string> hostapd_radio_config;
+    std::vector<std::pair<std::string, std::vector<std::string>>> hostapd_new_bss_config;
+
     std::vector<std::string> active_BSSs;
     std::string phy_name;
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 2fef0710c..5ee1aeeb6 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -256,6 +256,9 @@ prplmesh::hostapd::Configuration ap_wlan_hal_nl80211::load_hostapd_config(const
 
     closedir(dir);
 
+    // sorting the filenames
+    std::sort(hostapd_cfg_names.begin(), hostapd_cfg_names.end());
+
     for (const auto &try_fname : hostapd_cfg_names) {
         LOG(DEBUG) << "Trying to load " << try_fname << "...";
 
@@ -1264,6 +1267,26 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
             }
 
             LOG(INFO) << "BSS Addtion success:  " << " bss: " << new_vap_name << " bssid: " <<new_bssid;
+
+            // Add new bss configuration to default hostapd_config file
+            if (!m_radio_info.hostapd_new_bss_config.empty()) {
+                auto& new_vap = m_radio_info.hostapd_new_bss_config.front();
+                std::vector<std::string>& config_lines = new_vap.second;
+
+                for (auto& line : config_lines) {
+                    if (line.rfind("interface=", 0) == 0) { // starts with "interface="
+                        line = "bss=" + new_vap.first;      // replace with "bss=<vap_name>"
+                        break;
+                    }
+                }
+                base_conf.add_new_vap_to_default_config(new_vap);
+                m_radio_info.hostapd_new_bss_config.clear();
+                // store the default config
+                if (!base_conf.store()) {
+                    LOG(ERROR) << "Autoconfiguration: failed to add new bss in default config file!";
+                }
+            }
+
         } else {
             LOG(DEBUG) << "Existing vap with bssid " << conf_bssid;
             prplmesh::hostapd::Configuration conf = load_hostapd_config("",tlvf::mac_to_string(bss_it.bssid));
@@ -2250,6 +2273,10 @@ int ap_wlan_hal_nl80211::add_bss(std::string &ifname, son::wireless_utils::sBssI
         LOG(DEBUG) << "Failed to register and connect the new BSS interface!";
         return false;
     }
+    //get new bss info 
+    m_radio_info.hostapd_new_bss_config.clear();
+    m_radio_info.hostapd_new_bss_config = conf.get_hostapd_bss_config();
+
     //set uci persist for the particular vapid
     set_wifi_credentials_from_vap(vap_id, bss_conf, conf);
     return fd;
diff --git a/common/beerocks/hostapd/include/hostapd/configuration.h b/common/beerocks/hostapd/include/hostapd/configuration.h
index 16ac44d14..4cb450464 100644
--- a/common/beerocks/hostapd/include/hostapd/configuration.h
+++ b/common/beerocks/hostapd/include/hostapd/configuration.h
@@ -220,6 +220,10 @@ public:
 
     std::vector<std::string> get_hostapd_radio_config();
     void set_hostapd_radio_config(std::vector<std::string> &config);
+   
+    std::vector<std::pair<std::string, std::vector<std::string>>> get_hostapd_bss_config();    
+ 
+    void add_new_vap_to_default_config (const std::pair<std::string, std::vector<std::string>>& new_vap);
 private:
     /**
      * @brief helper: load configuration based on array of strings
diff --git a/common/beerocks/hostapd/source/configuration.cpp b/common/beerocks/hostapd/source/configuration.cpp
index cb463968b..a743bd685 100644
--- a/common/beerocks/hostapd/source/configuration.cpp
+++ b/common/beerocks/hostapd/source/configuration.cpp
@@ -468,5 +468,16 @@ std::vector<std::string> Configuration::get_hostapd_radio_config()
     return m_hostapd_config_head; 
 }
 
+std::vector<std::pair<std::string, std::vector<std::string>>> Configuration::get_hostapd_bss_config()
+{
+    return m_hostapd_config_vaps; 
+}
+
+void Configuration::add_new_vap_to_default_config(const std::pair<std::string, std::vector<std::string>>& new_vap)
+{
+    LOG(DEBUG) << "add new vap section to default config file " ;
+    m_hostapd_config_vaps.push_back(new_vap);
+}
+
 } // namespace hostapd
 } // namespace prplmesh
-- 
2.34.1

