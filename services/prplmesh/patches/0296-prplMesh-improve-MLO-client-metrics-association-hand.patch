diff --git a/common/beerocks/bwl/include/bwl/assoc_frame_db.h b/common/beerocks/bwl/include/bwl/assoc_frame_db.h
new file mode 100644
index 000000000..9a4b28e82
--- /dev/null
+++ b/common/beerocks/bwl/include/bwl/assoc_frame_db.h
@@ -0,0 +1,84 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef BWL_ASSOC_FRAME_DB_H
+#define BWL_ASSOC_FRAME_DB_H
+
+/**
+ * @file assoc_frame_db.h
+ *
+ * Shared helpers for the per-STA association frame persistence file.
+ *
+ * The AP manager process (ap_wlan_hal_nl80211) writes frames to this file
+ * when AP-MGMT-FRAME-RECEIVED arrives.  The agent process
+ * (capability_reporting_task) reads from it when the in-memory frame is
+ * absent — which happens for MLO clients because AP-STA-CONNECTED fires
+ * before AP-MGMT-FRAME-RECEIVED, leaving association_frame_length == 0 in
+ * AgentDB at the time the CLIENT_CAPABILITY_QUERY arrives.
+ *
+ * File format (one line per STA):
+ *   <mac_address> <hex_encoded_frame_bytes>\n
+ *
+ * Example:
+ *   bc:cd:99:9f:94:77 0000301a...
+ */
+
+#include <cstdint>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace bwl {
+
+/// Path of the shared file that persists STA association frames across
+/// process boundaries (AP manager → agent) and agent restarts.
+static constexpr const char *ASSOC_FRAMES_DB_PATH = "/tmp/beerocks/sta_assoc_frames.txt";
+
+/**
+ * @brief Restore the association frame for one STA from the shared DB file.
+ *
+ * Looks up the file by @p sta_mac and decodes the hex-encoded frame bytes.
+ *
+ * For SLO clients @p sta_mac is the STA MAC address.
+ * For MLO clients @p sta_mac must be the **link MAC** (affiliated STA MAC),
+ * because AP-MGMT-FRAME-RECEIVED uses the link MAC as the key when writing
+ * the file — not the MLD MAC that AP-STA-CONNECTED carries.
+ *
+ * @param sta_mac  MAC address string to look up (e.g. "bc:cd:99:9f:94:77").
+ * @return         Raw frame bytes, or empty vector if not found.
+ */
+inline std::vector<uint8_t> restore_assoc_frame_from_db(const std::string &sta_mac)
+{
+    std::ifstream ifs(ASSOC_FRAMES_DB_PATH);
+    if (!ifs) {
+        return {};
+    }
+
+    std::string line;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) {
+            continue;
+        }
+        std::istringstream ss(line);
+        std::string mac, hex_str;
+        ss >> mac >> hex_str;
+        if (mac != sta_mac) {
+            continue;
+        }
+        // Decode hex string back to raw bytes
+        std::vector<uint8_t> frame;
+        frame.reserve(hex_str.size() / 2);
+        for (size_t i = 0; i + 1 < hex_str.size(); i += 2) {
+            frame.push_back(
+                static_cast<uint8_t>(std::stoi(hex_str.substr(i, 2), nullptr, 16)));
+        }
+        return frame;
+    }
+    return {};
+}
+
+} // namespace bwl
+
+#endif // BWL_ASSOC_FRAME_DB_H
