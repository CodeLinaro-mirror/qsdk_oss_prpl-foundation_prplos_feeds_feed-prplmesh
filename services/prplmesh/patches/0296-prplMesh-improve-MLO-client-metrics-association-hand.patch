+    link_map.clear();
+    for (const auto &p : link_iface_mac_pairs) {
+        sPerLinkStaInfo info;
+        get_sta_info_nl80211(p.first, p.second, info);
+        /* Store regardless of signal validity so traffic stats are available */
+        link_map[p.second] = info;
+    }
+}
