new file mode 100644
index 000000000..e3ad3ebe8
--- /dev/null
+++ b/agent/src/beerocks/fronthaul_manager/mlo_sta_registry.h
@@ -0,0 +1,92 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _MLO_STA_REGISTRY_H_
+#define _MLO_STA_REGISTRY_H_
+
+#include <mutex>
+#include <unordered_map>
+
+#include <tlvf/common/sMacAddr.h>
+#include <tlvf/tlvftypes.h>
+
+namespace beerocks {
+
+/**
+ * @brief Thread-safe registry of MLO-affiliation status per STA MAC address.
+ *
+ * Shared between ApManager and Monitor:
+ * - ApManager publishes MLO-affiliation status on STA_Connected / STA_Disconnected.
+ * - Monitor consults the registry in create_ap_metrics_response() to gate the
+ *   Affiliated STA Metrics TLV.
+ */
+class MloStaRegistry {
+public:
+    MloStaRegistry()  = default;
+    ~MloStaRegistry() = default;
+
+    /**
+     * @brief Set (or update) the MLO-affiliation status for a STA.
+     *
+     * @param mac       STA MAC address.
+     * @param is_mlo    Non-zero if the STA is MLO-affiliated.
+     */
+    void set_affiliated(const sMacAddr &mac, uint8_t is_mlo)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_registry[mac] = (is_mlo != 0);
+    }
+
+    /**
+     * @brief Remove a STA entry from the registry (on disconnect).
+     *
+     * @param mac STA MAC address.
+     */
+    void erase(const sMacAddr &mac)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_registry.erase(mac);
+    }
+
+    /**
+     * @brief Check whether a STA is MLO-affiliated.
+     *
+     * @param mac STA MAC address.
+     * @return true if the STA is known to be MLO-affiliated, false otherwise
+     *         (including if the STA is not in the registry).
+     */
+    bool is_affiliated(const sMacAddr &mac) const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        auto it = m_registry.find(mac);
+        return (it != m_registry.end()) && it->second;
+    }
+
+private:
+    mutable std::mutex m_mutex;
+
+    struct sMacAddrHash {
+        std::size_t operator()(const sMacAddr &mac) const
+        {
+            std::size_t seed = 0;
+            for (auto b : mac.oct) {
+                seed ^= std::hash<uint8_t>{}(b) + 0x9e3779b9 + (seed << 6) + (seed >> 2);
+            }
+            return seed;
+        }
+    };
+
+    struct sMacAddrEqual {
+        bool operator()(const sMacAddr &a, const sMacAddr &b) const
+        {
+            return std::equal(std::begin(a.oct), std::end(a.oct), std::begin(b.oct));
+        }
+    };
+
+    std::unordered_map<sMacAddr, bool, sMacAddrHash, sMacAddrEqual> m_registry;
+};
+
+} // namespace beerocks
+
+#endif // _MLO_STA_REGISTRY_H_
