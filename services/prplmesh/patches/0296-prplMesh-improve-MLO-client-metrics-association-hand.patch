+bool TopologyTask::add_mld_structure_tlvs()
+{
+    auto db(AgentDB::get());
+
+    // Emit one tlvMldStructure per AP MLD
+    for (const auto &ap_mld_conf : db->ap_mld_configurations) {
+        const sMacAddr &mld_mac = ap_mld_conf.mld_config.mld_mac;
+        if (mld_mac == net::network_utils::ZERO_MAC) {
+            continue;
+        }
+
+        auto tlv = m_cmdu_tx.addClass<wfa_map::tlvMldStructure>();
+        if (!tlv) {
+            LOG(ERROR) << "addClass wfa_map::tlvMldStructure failed for AP MLD " << mld_mac;
+            return false;
+        }
+        tlv->mld_mac_addr() = mld_mac;
+
+        for (const auto &affiliated_ap : ap_mld_conf.affiliated_aps) {
+            if (affiliated_ap.bssid == net::network_utils::ZERO_MAC) {
+                continue;
+            }
+            auto affiliated = tlv->create_affiliated();
+            if (!affiliated) {
+                LOG(ERROR) << "create_affiliated failed for AP MLD " << mld_mac;
+                return false;
+            }
+            affiliated->affiliated_mac_addr() = affiliated_ap.bssid;
+            if (!tlv->add_affiliated(std::move(affiliated))) {
+                LOG(ERROR) << "add_affiliated failed for AP MLD " << mld_mac;
+                return false;
+            }
+        }
+
+        LOG(DEBUG) << "Added tlvMldStructure for AP MLD " << mld_mac
+                   << " with " << ap_mld_conf.affiliated_aps.size() << " affiliated AP(s)";
+    }
+
+    // Emit one tlvMldStructure for the bSTA MLD (if present)
+    if (db->bsta_mld_configuration &&
+        db->bsta_mld_configuration->mld_config.mld_mac != net::network_utils::ZERO_MAC) {
+
+        const sMacAddr &bsta_mld_mac = db->bsta_mld_configuration->mld_config.mld_mac;
+        auto tlv = m_cmdu_tx.addClass<wfa_map::tlvMldStructure>();
+        if (!tlv) {
+            LOG(ERROR) << "addClass wfa_map::tlvMldStructure failed for bSTA MLD " << bsta_mld_mac;
+            return false;
+        }
+        tlv->mld_mac_addr() = bsta_mld_mac;
+
+        for (const auto &affiliated_bsta_kv : db->bsta_mld_configuration->affiliated_bstas) {
+            const sMacAddr &affiliated_mac = affiliated_bsta_kv.second.mac_addr;
+            if (affiliated_mac == net::network_utils::ZERO_MAC) {
+                continue;
+            }
+            auto affiliated = tlv->create_affiliated();
+            if (!affiliated) {
+                LOG(ERROR) << "create_affiliated failed for bSTA MLD " << bsta_mld_mac;
+                return false;
+            }
+            affiliated->affiliated_mac_addr() = affiliated_mac;
+            if (!tlv->add_affiliated(std::move(affiliated))) {
+                LOG(ERROR) << "add_affiliated failed for bSTA MLD " << bsta_mld_mac;
+                return false;
+            }
+        }
+
+        LOG(DEBUG) << "Added tlvMldStructure for bSTA MLD " << bsta_mld_mac
+                   << " with " << db->bsta_mld_configuration->affiliated_bstas.size()
+                   << " affiliated bSTA(s)";
+    }
+
+    return true;
+}
