+/* Direct NL80211 station GET for MLO per-link stats and signal.
+ *
+ * The QSDK kernel does not support NL80211_STA_INFO_MLD_LINK_INFO (upstream
+ * kernel 6.1+).  Instead, querying NL80211_CMD_GET_STATION on a link-specific
+ * interface (e.g. "wlan1_link0") with the affiliated link MAC returns the
+ * per-link stats using standard NL80211_STA_INFO_* attributes.
+ *
+ * This is the same approach `iw dev wlan1_link0 station get <link_mac>` uses.
+ */
+#include <netlink/netlink.h>
+#include <netlink/genl/genl.h>
+#include <netlink/genl/ctrl.h>
+#include <linux/nl80211.h>
+#include <net/if.h>
+#include <climits>
+
+namespace {
+
+/**
+ * Per-link station info populated by get_sta_info_nl80211().
+ */
+struct sPerLinkStaInfo {
+    int8_t   signal_dbm   = 0;      ///< NL80211_STA_INFO_SIGNAL (dBm)
+    bool     signal_valid = false;  ///< true if signal < 0 dBm (link is active)
+    uint64_t tx_bytes     = 0;      ///< NL80211_STA_INFO_TX_BYTES64
+    uint64_t rx_bytes     = 0;      ///< NL80211_STA_INFO_RX_BYTES64
+    uint32_t tx_packets   = 0;      ///< NL80211_STA_INFO_TX_PACKETS
+    uint32_t rx_packets   = 0;      ///< NL80211_STA_INFO_RX_PACKETS
+    uint32_t tx_failed    = 0;      ///< NL80211_STA_INFO_TX_FAILED
+};
+
+struct sStaGetCbData {
+    sPerLinkStaInfo *info = nullptr;
+};
+
+static int sta_get_cb(struct nl_msg *msg, void *arg)
+{
+    auto *cb_data = static_cast<sStaGetCbData *>(arg);
+    if (!cb_data || !cb_data->info) {
+        return NL_SKIP;
+    }
+
+    struct genlmsghdr *gnlh =
+        static_cast<struct genlmsghdr *>(nlmsg_data(nlmsg_hdr(msg)));
+
+    struct nlattr *tb[NL80211_ATTR_MAX + 1] = {};
+    nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+              genlmsg_attrlen(gnlh, 0), nullptr);
+
+    if (!tb[NL80211_ATTR_STA_INFO]) {
+        return NL_SKIP;
+    }
+
+    struct nlattr *sinfo[NL80211_STA_INFO_MAX + 1] = {};
+    static struct nla_policy sta_policy[NL80211_STA_INFO_MAX + 1] = {};
+    if (nla_parse_nested(sinfo, NL80211_STA_INFO_MAX,
+                         tb[NL80211_ATTR_STA_INFO], sta_policy) < 0) {
+        return NL_SKIP;
+    }
+
+    sPerLinkStaInfo &info = *cb_data->info;
+
+    if (sinfo[NL80211_STA_INFO_SIGNAL]) {
+        info.signal_dbm   = static_cast<int8_t>(nla_get_u8(sinfo[NL80211_STA_INFO_SIGNAL]));
+        info.signal_valid = (info.signal_dbm < 0);
+    }
+    if (sinfo[NL80211_STA_INFO_TX_BYTES64]) {
+        info.tx_bytes = nla_get_u64(sinfo[NL80211_STA_INFO_TX_BYTES64]);
+    }
+    if (sinfo[NL80211_STA_INFO_RX_BYTES64]) {
+        info.rx_bytes = nla_get_u64(sinfo[NL80211_STA_INFO_RX_BYTES64]);
+    }
+    if (sinfo[NL80211_STA_INFO_TX_PACKETS]) {
+        info.tx_packets = nla_get_u32(sinfo[NL80211_STA_INFO_TX_PACKETS]);
+    }
+    if (sinfo[NL80211_STA_INFO_RX_PACKETS]) {
+        info.rx_packets = nla_get_u32(sinfo[NL80211_STA_INFO_RX_PACKETS]);
+    }
+    if (sinfo[NL80211_STA_INFO_TX_FAILED]) {
+        info.tx_failed = nla_get_u32(sinfo[NL80211_STA_INFO_TX_FAILED]);
+    }
+
+    return NL_OK;
+}
+
+static bool get_sta_info_nl80211(
+    const std::string &link_iface,
+    const sMacAddr    &link_mac,
+    sPerLinkStaInfo   &info)
+{
+    info = sPerLinkStaInfo{};
+
+    struct nl_sock *sock = nl_socket_alloc();
+    if (!sock) {
+        return false;
+    }
+
+    if (genl_connect(sock) < 0) {
+        nl_socket_free(sock);
+        return false;
+    }
+
+    int nl80211_id = genl_ctrl_resolve(sock, "nl80211");
+    if (nl80211_id < 0) {
+        nl_socket_free(sock);
+        return false;
+    }
+
+    struct nl_msg *msg = nlmsg_alloc();
+    if (!msg) {
+        nl_socket_free(sock);
+        return false;
+    }
+
+    genlmsg_put(msg, 0, 0, nl80211_id, 0, 0, NL80211_CMD_GET_STATION, 0);
+
+    unsigned int ifindex = if_nametoindex(link_iface.c_str());
+    if (ifindex == 0) {
+        nlmsg_free(msg);
+        nl_socket_free(sock);
+        return false;
+    }
+    nla_put_u32(msg, NL80211_ATTR_IFINDEX, ifindex);
+    nla_put(msg, NL80211_ATTR_MAC, ETH_ALEN, link_mac.oct);
+
+    sStaGetCbData cb_data;
+    cb_data.info = &info;
+
+    nl_socket_modify_cb(sock, NL_CB_VALID, NL_CB_CUSTOM, sta_get_cb, &cb_data);
+
+    int ret = nl_send_auto(sock, msg);
+    if (ret >= 0) {
+        nl_recvmsgs_default(sock);
+    }
+
+    nlmsg_free(msg);
+    nl_socket_free(sock);
+
+    return info.signal_valid;
+}
