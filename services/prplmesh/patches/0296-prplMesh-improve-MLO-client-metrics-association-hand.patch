+bool LinkMetricsTask::handle_cmdu_1905_ap_metrics_response(const sMacAddr &src_mac,
+                                                           ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    const auto mid = cmdu_rx.getMessageId();
+    LOG(DEBUG) << "Received AP_METRICS_RESPONSE_MESSAGE mid=" << mid << " from " << src_mac;
+
+    /* -----------------------------------------------------------------------
+     * TLV 0xa2 — Associated STA Traffic Stats
+     * Written to BSS.STA.{BytesSent,BytesReceived,PacketsSent,PacketsReceived,...}
+     * and fires QCOM_Vendor.AssocStaTrafficStats vendor event.
+     * ----------------------------------------------------------------------- */
+    auto traffic_stats_tlvs = cmdu_rx.getClassList<wfa_map::tlvAssociatedStaTrafficStats>();
+    for (const auto &tlv : traffic_stats_tlvs) {
+        if (!tlv) { continue; }
+        const sMacAddr &sta_mac = tlv->sta_mac();
+        if (sta_mac == beerocks::net::network_utils::ZERO_MAC) { continue; }
+
+        db::sAssociatedStaTrafficStats stats;
+        stats.m_byte_sent            = tlv->byte_sent();
+        stats.m_byte_received        = tlv->byte_received();
+        stats.m_packets_sent         = tlv->packets_sent();
+        stats.m_packets_received     = tlv->packets_received();
+        stats.m_tx_packets_error     = tlv->tx_packets_error();
+        stats.m_rx_packets_error     = tlv->rx_packets_error();
+        stats.m_retransmission_count = tlv->retransmission_count();
+
+        if (!database.dm_set_sta_traffic_stats(sta_mac, stats)) {
+            LOG(DEBUG) << "AP_METRICS_RESPONSE: dm_set_sta_traffic_stats failed for STA "
+                       << sta_mac << " (may not be in DM yet)";
+        }
+    }
+
+    /* TLV 0x64 — Affiliated STA Metrics (EasyMesh R6 §17.2.95)
+     * Deferred: tlvAffiliatedStaMetrics is not yet auto-generated in this tlvf tree.
+     * The topology task's handle_ap_metrics_response_message() handles this TLV
+     * and calls db::dm_set_affiliated_sta_metrics() once the class is available. */
+    LOG(DEBUG) << "AP_METRICS_RESPONSE: TLV 0x64 (AffiliatedStaMetrics) parsing deferred "
+                  "to topology task (tlvAffiliatedStaMetrics not yet generated)";
+
+    /* -----------------------------------------------------------------------
+     * TLV 0xE2 — Associated STA MLD Configuration Report (EasyMesh R6 §17.2.96)
+     * Written to STAMLD.{k}.{MLDMACAddress,STAMLDConfig.*,AffiliatedSTA[]}
+     * and fires QCOM_Vendor.AssocStaMldConfigReport vendor event.
+     *
+     * NOTE: tlvAssocStaMldConfigReport is not yet auto-generated in this tlvf
+     * tree.  The topology task's handle_topology_response() already calls
+     * update_assoc_sta_mld() when it processes the Associated STA MLD
+     * Configuration Report TLV from the Topology Response message.
+     * This handler is a placeholder for when the TLV arrives in AP_METRICS_RESPONSE.
+     * ----------------------------------------------------------------------- */
+    LOG(DEBUG) << "AP_METRICS_RESPONSE: TLV 0xE2 (AssocStaMldConfigReport) parsing deferred "
+                  "to topology task (tlvAssocStaMldConfigReport not yet generated)";
+
+    return true;
+}
