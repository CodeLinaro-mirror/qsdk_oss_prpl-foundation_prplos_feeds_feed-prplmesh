 }
 
-bool TopologyTask::add_device_information_tlv()
+bool TopologyTask::add_device_information_and_bridging_capability_tlv()
 {
     auto tlvDeviceInformation = m_cmdu_tx.addClass<ieee1905_1::tlvDeviceInformation>();
     if (!tlvDeviceInformation) {
@@ -827,6 +836,70 @@ bool TopologyTask::add_device_information_tlv()
         tlvDeviceInformation->add_local_interface_list(localInterfaceInfo);
     }
 
+    //Bridging capability TLV is added only in certifiaction mode. TODO: Need to enable it for field use as well
+    if (bridges.empty() || !db->device_conf.certification_mode) {
+        return true;
+    }
+
+    LOG(DEBUG) << "Building Device Bridging Capability TLV from " << bridges.size()
+               << " Linux bridge(s)";
+
+    auto tlvBridgingCapability =
+        m_cmdu_tx.addClass<ieee1905_1::tlvDeviceBridgingCapability>();
+    if (!tlvBridgingCapability) {
+        LOG(ERROR) << "addClass ieee1905_1::tlvDeviceBridgingCapability failed";
+        return false;
+    }
+
+    for (const auto &bridge : bridges) {
+        const auto iface_names = network_utils::linux_get_iface_list_from_bridge(bridge);
+        if (iface_names.empty()) {
+            continue;
+        }
+
+        std::vector<sMacAddr> iface_macs;
+        for (const auto &iface_name : iface_names) {
+            std::string mac_str;
+            if (!network_utils::linux_iface_get_mac(iface_name, mac_str)) {
+                LOG(WARNING) << "Failed getting MAC address for bridge interface " << iface_name;
+                continue;
+            }
+
+            const auto iface_mac = tlvf::mac_from_string(mac_str);
+            if (iface_mac == network_utils::ZERO_MAC || iface_map.find(iface_mac) == iface_map.end()) {
+                continue;
+            }
+
+            if (std::find(iface_macs.begin(), iface_macs.end(), iface_mac) == iface_macs.end()) {
+                iface_macs.push_back(iface_mac);
+            }
+        }
+
+        if (iface_macs.empty()) {
+            continue;
+        }
+
+        auto mac_list = tlvBridgingCapability->create_bridging_tuples_list();
+        if (!mac_list || !mac_list->alloc_mac_list(iface_macs.size())) {
+            LOG(ERROR) << "Failed creating Device Bridging Capability MAC list";
+            return false;
+        }
+
+        for (size_t i = 0; i < iface_macs.size(); ++i) {
+            auto mac_tuple = mac_list->mac_list(i);
+            if (!std::get<0>(mac_tuple)) {
+                LOG(ERROR) << "Failed getting bridging tuple MAC element";
+                return false;
+            }
+            std::get<1>(mac_tuple) = iface_macs[i];
+        }
+
+        if (!tlvBridgingCapability->add_bridging_tuples_list(std::move(mac_list))) {
+            LOG(ERROR) << "Failed adding bridging tuple";
+            return false;
+        }
+    }
+
     return true;
 }
 
@@ -881,8 +954,11 @@ bool TopologyTask::add_1905_neighbor_device_tlv()
 
             auto &mac_al_1905_device = std::get<1>(mac_al_1905_device_tuple);
             mac_al_1905_device.mac   = neighbor_al_mac;
+            // In certification mode forcing it to 0x01 for interoperability with third party
             mac_al_1905_device.bridges_exist =
-                ieee1905_1::tlv1905NeighborDevice::eBridgesExist::AT_LEAST_ONE_BRIDGES_EXIST;
+                db->device_conf.certification_mode
+                    ? static_cast<ieee1905_1::tlv1905NeighborDevice::eBridgesExist>(0x01)
+                    : ieee1905_1::tlv1905NeighborDevice::eBridgesExist::AT_LEAST_ONE_BRIDGES_EXIST;
             index++;
         }
     }
@@ -891,6 +967,7 @@ bool TopologyTask::add_1905_neighbor_device_tlv()
 
 static void
 get_non_1905_neighbors(const std::string &bridge,
+                       const sMacAddr &excluded_al_mac,
                        std::unordered_map<sMacAddr, std::vector<sMacAddr>> &non_1905_neighbors)
 {
     auto fdb_table = network_utils::linux_get_bridge_forwarding_table(bridge);
@@ -912,7 +989,7 @@ get_non_1905_neighbors(const std::string &bridge,
                 /* 1905 neighbor */
                 if (al_mac == neighbor_entry.first) {
                     return true;
-                } else {
+                } else if (!db->device_conf.certification_mode) {
                     auto fdb_entry = network_utils::linux_get_bridge_forwarding_table(
                         bridge, neighbor_entry.first);
                     if (fdb_entry.size() == 0) {
@@ -938,6 +1015,17 @@ get_non_1905_neighbors(const std::string &bridge,
         auto entry_mac  = tlvf::mac_from_array(fdb_entry.mac_addr);
         auto entry_port = fdb_entry.port_no;
 
+        // The requester is a 1905 device and must not be advertised as a
+        // non-1905 neighbor.  This can occur before neighbor_devices has been
+        // populated during the initial topology response.  Also exclude the
+        // local AL MAC defensively if it is present in the bridge FDB.
+        if (db->device_conf.certification_mode &&
+            (entry_mac == excluded_al_mac || entry_mac == db->bridge.mac)) {
+            LOG(DEBUG) << "Skipping local/1905 AL MAC from Non-1905 neighbor list: "
+                       << tlvf::mac_to_string(entry_mac);
+            continue;
+        }
+
         /* Skip 1905 neighbor-related entries */
         if (is_mac_related_to_1905_neighbor(entry_mac, entry_port)) {
             continue;
@@ -963,7 +1051,7 @@ get_non_1905_neighbors(const std::string &bridge,
     }
 }
 
-bool TopologyTask::add_non_1905_neighbor_device_tlv()
+bool TopologyTask::add_non_1905_neighbor_device_tlv(const sMacAddr &excluded_al_mac)
 {
     auto bridges = network_utils::linux_get_bridges();
     if (bridges.empty()) {
@@ -974,7 +1062,7 @@ bool TopologyTask::add_non_1905_neighbor_device_tlv()
     std::unordered_map<sMacAddr, std::vector<sMacAddr>> non_1905_neighbors;
 
     for (const auto &bridge : bridges) {
-        get_non_1905_neighbors(bridge, non_1905_neighbors);
+        get_non_1905_neighbors(bridge, excluded_al_mac, non_1905_neighbors);
     }
 
     for (const auto &neighbors_entry : non_1905_neighbors) {
@@ -1033,9 +1121,9 @@ bool TopologyTask::add_supported_service_tlv()
     bool is_local_prpl_controller =
         db->device_conf.local_controller && !db->device_conf.local_non_prplmesh_controller;
 
-    // only for prplMesh Controller with local agent
+    // in certification third party EasyMesh AP will not understand service values EM_AP_CONTROLLER / EM_AP_AGENT, skip it.
     size_t number_of_supported_services = 2;
-    if (is_local_prpl_controller) {
+    if (is_local_prpl_controller && !db->device_conf.certification_mode) {
         number_of_supported_services += 2;
     }
 
