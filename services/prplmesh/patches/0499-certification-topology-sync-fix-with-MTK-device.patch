@@ -660,7 +660,18 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
             m_cmdu_tx.getMessageType() == ieee1905_1::eMessageType(message_type)) {
             m_cmdu_tx.setMessageId(g_mid); // force mid
             // For unicast, clear relay_indicator on the already-finalized CMDU header
-            apply_unicast_relay_flag(m_cmdu_tx.load());
+            // Loading a finalized CMDU puts it in parse mode. Only do that when the
+            // command explicitly requests unicast transmission; otherwise the
+            // finalized TX CMDU must remain in TX mode for serialization.
+            auto transmission_type_it = params.find("transmissiontype");
+            if (transmission_type_it != params.end()) {
+                auto transmission_type = transmission_type_it->second;
+                std::transform(transmission_type.begin(), transmission_type.end(),
