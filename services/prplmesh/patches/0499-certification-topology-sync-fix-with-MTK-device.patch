+                if (transmission_type == "unicast") {
+                    apply_unicast_relay_flag(m_cmdu_tx.load());
+                }
+            }
             LOG(DEBUG) << "Send preset cmdu with mid " << std::hex << g_mid;
             if (!send_cmdu_to_destination(m_cmdu_tx, dest_alid)) {
                 LOG(ERROR) << "Failed to send CMDU";
