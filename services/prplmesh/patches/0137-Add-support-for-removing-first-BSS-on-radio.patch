+static int remove_mld_entry_by_ifname(const std::string &ifname)
+{
+    const std::string filename = MLD_PAIR_ENTRANT_FILE;
+
+    int fd = open(filename.c_str(), O_RDWR | O_CREAT, 0666);
+    if (fd == -1) {
+        perror("open");
+        return -1;
+    }
+
+    struct flock lock{};
+    lock.l_type   = F_WRLCK;
+    lock.l_whence = SEEK_SET;
+    lock.l_start  = 0;
+    lock.l_len    = 0;
+
+    if (fcntl(fd, F_SETLKW, &lock) == -1) {
+        perror("fcntl - lock");
+        close(fd);
+        return -1;
+    }
+
+    std::ifstream infile(filename);
+    std::vector<std::string> lines;
+    std::string line;
+    bool removed = false;
+
+    while (std::getline(infile, line)) {
+        if (line.empty()) {
+            continue;
+        }
+        std::istringstream iss(line);
+        std::string id_str, ifname_str, ssid_str;
+
+        if (std::getline(iss, id_str, ',') &&
+            std::getline(iss, ifname_str, ',') &&
+            std::getline(iss, ssid_str)) {
+
+            if (ifname_str == ifname) {
+                LOG(INFO) << "remove_mld_entry_by_ifname: removing entry for ifname=" << ifname
+                          << " mld_id=" << id_str;
+                removed = true;
+                continue; // skip this line to remove it
+            }
+        }
+        lines.push_back(line);
+    }
+    infile.close();
+
+    std::ofstream outfile(filename, std::ios::trunc);
+    for (const auto &l : lines) {
+        outfile << l << "\n";
+    }
+    outfile.close();
+
+    lock.l_type = F_UNLCK;
+    fcntl(fd, F_SETLK, &lock);
+    close(fd);
+
+    return removed ? 0 : -1;
+}
