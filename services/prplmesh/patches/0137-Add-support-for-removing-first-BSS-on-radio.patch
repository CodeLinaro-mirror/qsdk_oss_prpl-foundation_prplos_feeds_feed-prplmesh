+        return false;
+    }
+
+    // Search all wifi-iface sections for one whose ifname matches and belongs to this device
+    std::vector<std::string> all_iface_sections;
+    if (!uci_get_all_sections(package_name, section_type, all_iface_sections)) {
+        LOG(ERROR) << "bpl_cfg_set_wifi_iface_teardown: failed to get all wifi-iface sections";
+        return false;
+    }
+
+    for (const auto &sec : all_iface_sections) {
+        std::string device_val, ifname_val;
+        if (!uci_get_option(package_name, section_type, sec, "device", device_val)) {
+            continue;
+        }
+        if (device_val != device_section) {
+            continue;
+        }
+        if (!uci_get_option(package_name, section_type, sec, "ifname", ifname_val)) {
+            continue;
+        }
+        if (ifname_val == iface) {
+            section_name = sec;
+            LOG(INFO) << "bpl_cfg_set_wifi_iface_teardown: found section " << sec
+                      << " for interface " << iface;
+            break;
+        }
+    }
+
+    if (section_name.empty()) {
+        LOG(ERROR) << "bpl_cfg_set_wifi_iface_teardown: section not found for interface "
+                   << iface << " on radio " << radio_id;
+        return false;
+    }
+
+    // Set only disabled=1 — do not touch any other credential fields
+    OptionsUnorderedMap options;
+    options["disabled"] = "1";
+
+    if (!uci_set_section(package_name, section_type, section_name, options, true)) {
+        LOG(ERROR) << "bpl_cfg_set_wifi_iface_teardown: failed to set disabled=1 for interface "
+                   << iface << " at section " << section_name;
+        return false;
+    }
+
+    LOG(INFO) << "bpl_cfg_set_wifi_iface_teardown: set disabled=1 for interface "
+              << iface << " at section " << section_name;
+
+    // For MLO interfaces, also set disabled=1 in the corresponding wifi-mld section
+    if (is_mlo) {
+        const std::string mld_section_type = "wifi-mld";
+        std::vector<std::string> all_mld_sections;
+        if (uci_get_all_sections(package_name, mld_section_type, all_mld_sections)) {
+            for (const auto &mld_sec : all_mld_sections) {
+                std::string mld_ifname_val;
+                if (!uci_get_option(package_name, mld_section_type, mld_sec, "ifname", mld_ifname_val)) {
+                    continue;
+                }
+                if (mld_ifname_val == iface) {
+                    OptionsUnorderedMap mld_options;
+                    mld_options["disabled"] = "1";
+                    if (!uci_set_section(package_name, mld_section_type, mld_sec, mld_options, true)) {
+                        LOG(WARNING) << "bpl_cfg_set_wifi_iface_teardown: failed to set disabled=1"
+                                     << " in wifi-mld section " << mld_sec
+                                     << " for interface " << iface;
+                    } else {
+                        LOG(INFO) << "bpl_cfg_set_wifi_iface_teardown: set disabled=1"
+                                  << " in wifi-mld section " << mld_sec
+                                  << " for interface " << iface;
+                    }
+                    break;
+                }
+            }
+        } else {
+            LOG(DEBUG) << "bpl_cfg_set_wifi_iface_teardown: no wifi-mld sections found for interface "
+                       << iface;
+        }
+    }
+
+    return true;
+}
