+std::string wireless_utils::vap_type_to_string(eVapType vap_type)
+{
+    switch (vap_type) {
+    case eVapType::HOME:     return "home";
+    case eVapType::GUEST:    return "guest";
+    case eVapType::VIDEO:    return "video";
+    case eVapType::BACKHAUL: return "backhaul";
+    case eVapType::HOTSPOT:  return "hotspot";
+    case eVapType::STAFF:    return "staff";
+    case eVapType::ISOLATED: return "isolated";
+    case eVapType::OTHER:
+    default:                 return "";
+    }
