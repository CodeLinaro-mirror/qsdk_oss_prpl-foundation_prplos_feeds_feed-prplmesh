From 6e78fac194248027ecf8b5d7a607ec6dd7b6ccf4 Mon Sep 17 00:00:00 2001
From: Kareti Pavani Sireesha Reddy <kpavanis@qti.qualcomm.com>
Date: Mon, 23 Feb 2026 21:23:32 +0530
Subject: [PATCH] Added ht mode based on driver capabilities
 and further bw

Issue: Hostapd CHAN_SWITCH command is always selecting vht mode for 5G

Root Cause: ht mode is selected based on freq and bw only , not considering driver capabilities.

Signed-off-by: Kareti Pavani Sireesha Reddy <kpavanis@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 68 +++++++++++++++++--
 1 file changed, 61 insertions(+), 7 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 65435d4b4..71c5a31de 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -2029,14 +2029,68 @@ bool ap_wlan_hal_nl80211::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
     cmd += " bandwidth=" + bw_str.erase(bw_str.size() - 3);
     // trim "MHz" from bw_str
 
-    // Supported Standard n/ac
-    if (freq_type == beerocks::FREQ_6G) {
-        cmd += " he";
-    } else if (bw == beerocks::BANDWIDTH_20 || bw == beerocks::BANDWIDTH_40) {
-        cmd += " ht"; //n
-    } else if (bw == beerocks::BANDWIDTH_80 || bw == beerocks::BANDWIDTH_160) {
-        cmd += " vht"; // ac
+    auto phy_valid_on_band = [&](const char* phy) -> bool {
+        if (freq_type == beerocks::FREQ_24G) {
+            // 2.4 GHz: allow HT/HE; avoid VHT/EHT
+            return (std::strcmp(phy, "he") == 0 && m_radio_info.he_supported) ||
+                (std::strcmp(phy, "ht") == 0 && m_radio_info.ht_supported);
+        }
+        if (freq_type == beerocks::FREQ_5G) {
+            // 5 GHz: prefer EHT, then HE, VHT, then HT as last resort
+            if (std::strcmp(phy, "eht") == 0) return m_radio_info.eht_supported;
+            if (std::strcmp(phy, "he")  == 0) return m_radio_info.he_supported;
+            if (std::strcmp(phy, "vht") == 0) return m_radio_info.vht_supported;
+            if (std::strcmp(phy, "ht")  == 0) return m_radio_info.ht_supported;
+            return false;
+        }
+        if (freq_type == beerocks::FREQ_6G) {
+            // 6 GHz: only HE/EHT are valid
+            if (std::strcmp(phy, "eht") == 0) return m_radio_info.eht_supported;
+            if (std::strcmp(phy, "he")  == 0) return m_radio_info.he_supported;
+            return false;
+        }
+        return false;
+    };
+    auto phy_valid_width = [&](const char* phy) -> bool {
+        // Basic PHY vs width gating (regulatory/DFS checks are out of scope here):
+        if (bw == beerocks::BANDWIDTH_320) return (std::strcmp(phy, "eht") == 0) && (freq_type == beerocks::FREQ_6G);
+        if (bw == beerocks::BANDWIDTH_160) return (std::strcmp(phy, "eht") == 0) ||
+            (std::strcmp(phy, "he")  == 0) ||
+                (std::strcmp(phy, "vht") == 0);
+        if (bw == beerocks::BANDWIDTH_80)  return (std::strcmp(phy, "eht") == 0) ||
+            (std::strcmp(phy, "he")  == 0) ||
+                (std::strcmp(phy, "vht") == 0);
+        if (bw == beerocks::BANDWIDTH_40)  return (std::strcmp(phy, "eht") == 0) ||
+            (std::strcmp(phy, "he")  == 0) ||
+                (std::strcmp(phy, "vht") == 0) ||
+                (std::strcmp(phy, "ht")  == 0);
+        if (bw == beerocks::BANDWIDTH_20)  return true; // all PHYs can do 20 if valid on band
+        return false;
+    };
+
+    std::string phy;
+    std::vector<const char*> pref;
+
+    if (freq_type == beerocks::FREQ_24G)
+        pref = {"he", "ht"};
+    else if (freq_type == beerocks::FREQ_5G)
+        pref = {"eht", "he", "vht", "ht"};
+    else if (freq_type == beerocks::FREQ_6G)
+        pref = {"eht", "he"};
+
+    for (auto p : pref) {
+        if (phy_valid_on_band(p) && phy_valid_width(p)) {
+            if (!phy.empty()) {
+                phy += ' ';
+            }
+            phy += p;
+        }
+    }
+    if (phy.empty()) {
+        LOG(ERROR) << "No valid PHY mode found";
+        return false;
     }
+    cmd += " " + phy;
 
     // Send command
     if (!wpa_ctrl_send_msg(cmd)) {
-- 
