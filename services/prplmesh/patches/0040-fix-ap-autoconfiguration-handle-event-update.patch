From: Praveen Babu <pravbabu@qti.qualcomm.com>
Date: Thu, 11 Sep 2025 15:19:18 +0530
Subject: [PATCH] fix ap autoconfiguration handle event update

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 14ffa3e4a..18cbba983 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -267,6 +267,11 @@ void ApAutoConfigurationTask::handle_event(uint8_t event_enum_value, const void
                 }
             }
 
+            if (m_radios_conf_params[radio->front.iface_name].state == eState::WAIT_FOR_CONTROLLER_DISCOVERY_COMPLETE)
+            {
+                m_discovery_status[radio->wifi_channel.get_freq_type()].msg_sent = false;
+            }
+
             LOG(DEBUG) << "starting discovery sequence on radio_iface=" << radio->front.iface_name;
             FSM_MOVE_STATE(radio->front.iface_name, eState::CONTROLLER_DISCOVERY);
             m_task_is_active = true;
