+bool son_actions::send_reconfiguration_trigger_msg(const sMacAddr &agent_mac,
+                                                    ieee1905_1::CmduMessageTx &cmdu_tx, db &database)
+{
+    // Per EasyMesh spec section 17.1.57, no TLVs are required in this message.
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::RECONFIGURATION_TRIGGER_MESSAGE)) {
+        LOG(ERROR) << "Failed building RECONFIGURATION_TRIGGER_MESSAGE";
+        return false;
+    }
+
+    LOG(INFO) << "Send RECONFIGURATION_TRIGGER_MESSAGE to agent " << agent_mac;
+    return son_actions::send_cmdu_to_agent(agent_mac, cmdu_tx, database);
+}
