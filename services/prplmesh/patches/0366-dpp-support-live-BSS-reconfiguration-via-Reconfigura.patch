+// ---------------------------------------------------------------------------
+// Public: handle_reconfiguration_trigger — Ack + (DPP-only) BSS Configuration Request
+// ---------------------------------------------------------------------------
+
+bool DppAgentTask::handle_reconfiguration_trigger(const sMacAddr &src_mac,
+                                                  ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received RECONFIGURATION_TRIGGER_MESSAGE, mid=" << std::hex << mid << std::dec;
+
+    // Spec section 5.3.10.1: respond within 1s with a 1905 Ack regardless of onboarding
+    // method — the Ack is a transport-layer receipt, not an action commitment. A failure
+    // to send it is a separate concern from the reconfiguration action itself, so it's
+    // only logged here, not treated as a reason to skip the BSS Configuration Request below.
+    if (!m_cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE)) {
+        LOG(ERROR) << "cmdu creation of type ACK_MESSAGE has failed";
+    } else if (!m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx)) {
+        LOG(ERROR) << "Failed sending ACK message to controller, mid=" << std::hex << mid
+                   << std::dec;
+    }
+
+    // Safety guard: only a DPP-onboarded agent should act on a Reconfiguration Trigger.
+    // The Controller only sends this to DPP-onboarded agents, but don't rely solely on
+    // the sender's judgement — a WSC-onboarded agent has no useful BSS Configuration
+    // Request path to send here.
+    auto db = AgentDB::get();
+    if (db->dpp_extender_config.onboarding_type != AgentDB::OnboardingType::DPP) {
+        LOG(WARNING) << "Received RECONFIGURATION_TRIGGER_MESSAGE but this agent is not "
+                        "DPP-onboarded — Acked, ignoring the reconfiguration action";
+        return true;
+    }
+
+    return trigger_bss_config_request(src_mac);
+}
