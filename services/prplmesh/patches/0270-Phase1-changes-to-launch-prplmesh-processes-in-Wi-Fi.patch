+/**
+ * @brief Returns the radio MAC address stored in the prplmesh UCI wifi-device section for the
+ * given phy name. Only available in UCI-based platforms; returns false on all others.
+ *
+ * @param [in] phy_name  PHY identifier (e.g. "phy00.0") matching the phy_name option in UCI.
+ * @param [out] mac      MAC address string (e.g. "aa:bb:cc:dd:ee:ff") on success.
+ * @return true on success, otherwise false.
+ */
+bool bpl_cfg_get_radio_mac_by_phy(const std::string &phy_name, std::string &mac);
+
+/**
+ * @brief Returns the phy_name configured in the prplmesh UCI wifi-device section that owns the
+ * given Linux interface name (matched against either its "hostap_iface" or "sta_iface" option).
+ * Only available in UCI-based platforms; returns false on all others.
+ *
+ * Intended as a generic, HAL-type-agnostic fallback so that any HAL (AP, STA/bSTA, monitor) can
+ * resolve its phy_name from the interface name alone when the caller did not already supply one.
+ *
+ * @param [in] iface_name Linux interface name (e.g. "wlan0").
+ * @param [out] phy_name  PHY identifier (e.g. "phy00.0") on success.
+ * @return true on success, otherwise false.
+ */
+bool bpl_cfg_get_phy_name_by_iface(const std::string &iface_name, std::string &phy_name);
+
+/**
+ * @brief Returns the frequency band string stored in the wireless UCI wifi-device section for the
+ * given phy name. Only available in UCI-based platforms; returns false on all others.
+ *
+ * @param [in] phy_name   PHY identifier (e.g. "phy0") matching the phy_name option in UCI.
+ * @param [out] freq_band Frequency band string (e.g. "2g", "5g", "6g") on success.
+ * @return true on success, otherwise false.
+ */
+bool bpl_cfg_get_freq_band_by_phy(const std::string &phy_name, std::string &freq_band);
+
+/**
+ * @brief Returns the frequency band string from the prplmesh UCI wifi-device section identified by
+ * phy_name or iface_name (hostap_iface fallback).
+ *
+ * @param [in] phy_name   PHY identifier (e.g. "phy0") matching the phy_name option in UCI.
+ * @param [in] iface_name Interface name used as hostap_iface fallback when phy_name lookup fails.
+ * @param [out] freq_band Frequency band string (e.g. "2g", "5g", "6g") on success.
+ * @return true on success, otherwise false.
+ */
+bool bpl_cfg_get_freq_band_by_phy(const std::string &phy_name, const std::string &iface_name,
+                                   std::string &freq_band);
+
+/**
+ * @brief Returns the channel from the prplmesh UCI wifi-device section identified by phy_name or
+ * iface_name (hostap_iface fallback).
+ *
+ * @param [in] phy_name   PHY identifier (e.g. "phy0") matching the phy_name option in UCI.
+ * @param [in] iface_name Interface name used as hostap_iface fallback when phy_name lookup fails.
+ * @param [out] channel   Channel number on success.
+ * @return true on success, otherwise false.
+ */
+bool bpl_cfg_get_channel_by_phy(const std::string &phy_name, const std::string &iface_name,
+                                 int &channel);
+
+/**
+ * @brief Returns the bandwidth string from the prplmesh UCI wifi-device section identified by
+ * phy_name or iface_name (hostap_iface fallback).
+ *
+ * @param [in] phy_name   PHY identifier (e.g. "phy0") matching the phy_name option in UCI.
+ * @param [in] iface_name Interface name used as hostap_iface fallback when phy_name lookup fails.
+ * @param [out] bandwidth Bandwidth string (e.g. "80MHz") on success.
+ * @return true on success, otherwise false.
+ */
+bool bpl_cfg_get_bandwidth_by_phy(const std::string &phy_name, const std::string &iface_name,
+                                   std::string &bandwidth);
+
+/**
+ * @brief Returns the radio_disable flag from the prplmesh UCI wifi-device section identified by
+ * phy_name.
+ *
+ * @param [in]  phy_name       PHY identifier (e.g. "phy00.2") matching the phy_name option in UCI.
+ * @param [out] radio_disable  Set to true when the option is present and equal to "1".
+ * @return true when the UCI section was found and the option was read, otherwise false.
+ */
+bool bpl_cfg_get_radio_disable_by_phy(const std::string &phy_name, bool &radio_disable);
