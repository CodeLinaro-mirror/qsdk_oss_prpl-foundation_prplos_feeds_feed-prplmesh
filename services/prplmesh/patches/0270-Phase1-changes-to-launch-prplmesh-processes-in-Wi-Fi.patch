From 85e8bcab5e389f2ece0b57aabc3a81a2316faee4 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Tue, 14 Jul 2026 10:09:17 +0530
Subject: [PATCH] Phase1 changes to launch prplmesh processes in  Wi-Fi disable
 state Phy_name based service launch instead of interface name based launch
 for NLHAL

agent interfaces_map
        phy_name = phy00.0(NLHAL) / empty(others)
        ifname = dummy_ap/wlan1  - uci hostap_iface(NLHAL) / DM(other HAL)
        sta_iface = dummy_sta/wlan0 - uci sta_iface(NLHAL) / DM(other HAL)

son_slave thread
        config.radios (Agent info)
        fronthaul_iface = phy00.0(NLHAL) / interface name(other HAL)

Fronthaul manager
        fronthaul_iface = phy00.0(NLHAL) / interface name(other HAL)
        base_ap_manager_name = beerocks_ap_manager_phy00.0(NLHAL)
        base_monitor_name = beerocks_monitor_phy00.0(NLHAL)
        base_fronthaul_name = beerocks_fronthaul_phy00.0(NLHAL)

ap_manager
        m_iface = phy00.0(NLHAL) / interface_name(other HAL)
        m_if_ref_of_phy_id = wlan1 (interface in hostapd_phy00.0.conf) only NLHAL
        hal_conf.phy_name = m_iface(phy00.0)(NLHAL)
        hal_conf.radio_disable = m_radio_disable (read from uci) (NLHAL)
        hal_iface = empty or m_if_ref_of_phy_id if valid (NLHAL)

base_wlan_hal_nl80211
        iface_name = empty or m_if_ref_of_phy_id(wlan1) if valid
        hal_conf = sent from ap_manager
        m_radio_info.iface_name = iface_name
        m_radio_info.phy_name = m_hal_conf.phy_name
        get_iface_name returns iface_name

fsm_setup
        derives m_interface_index if iface_name not empty
        Attaches to global cmd iface, global event iface
        if iface_name not empty attaches to interface(if non-mld) or interface_link<linkid>(for mld iface)

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
