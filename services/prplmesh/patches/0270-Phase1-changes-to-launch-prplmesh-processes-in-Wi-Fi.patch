+void Monitor::register_new_ext_event_fds()
+{
+    const auto &all_fds = mon_wlan_hal->get_ext_events_fds();
+    for (int fd : all_fds) {
+        if (fd <= 0) {
+            continue;
+        }
+        // Skip FDs already tracked in the event loop.
+        if (std::find(m_mon_hal_ext_events.begin(), m_mon_hal_ext_events.end(), fd) !=
+            m_mon_hal_ext_events.end()) {
+            continue;
+        }
+        beerocks::EventLoop::EventHandlers handlers{
+            .name = "mon_hal_ext_events",
+            .on_read =
+                [&](int fd, EventLoop &) {
+                    if (!mon_wlan_hal->process_ext_events(fd)) {
+                        LOG(ERROR) << "process_ext_events(" << fd << ") failed!";
+                        return false;
+                    }
+                    return true;
+                },
+            .on_write = nullptr,
+            .on_disconnect =
+                [&](int fd, EventLoop &) {
+                    LOG(ERROR) << "mon_hal_ext_events disconnected! on fd " << fd;
+                    auto it = std::find(m_mon_hal_ext_events.begin(),
+                                        m_mon_hal_ext_events.end(), fd);
+                    if (it != m_mon_hal_ext_events.end()) {
+                        *it = beerocks::net::FileDescriptor::invalid_descriptor;
+                    }
+                    return false;
+                },
+            .on_error =
+                [&](int fd, EventLoop &) {
+                    LOG(ERROR) << "mon_hal_ext_events error! on fd " << fd;
+                    auto it = std::find(m_mon_hal_ext_events.begin(),
+                                        m_mon_hal_ext_events.end(), fd);
+                    if (it != m_mon_hal_ext_events.end()) {
+                        *it = beerocks::net::FileDescriptor::invalid_descriptor;
+                    }
+                    return false;
+                },
+        };
+        if (m_event_loop->register_handlers(fd, handlers)) {
+            m_mon_hal_ext_events.push_back(fd);
+            LOG(INFO) << "Registered new ext event FD " << fd << " in event loop";
+        } else {
+            LOG(ERROR) << "Failed to register new ext event FD " << fd;
+        }
+    }
+}
