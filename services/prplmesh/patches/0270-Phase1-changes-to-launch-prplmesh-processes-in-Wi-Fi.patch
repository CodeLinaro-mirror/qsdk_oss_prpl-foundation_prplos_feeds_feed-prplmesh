+void os_utils::resolve_iface_from_hostapd_conf(const std::string &iface,
+                                                std::string &resolved_iface)
+{
+    const std::string conf_path = "/var/run/hostapd-" + iface + ".conf";
+    std::ifstream conf_file(conf_path);
+    if (!conf_file.is_open()) {
+        LOG(INFO) << "hostapd conf not found for " << iface << " (" << conf_path
+                  << "), no VAP available — will use global ctrl socket";
+        resolved_iface.clear();
+        return;
+    }
+
+    resolved_iface.clear();
+    std::string line;
+    while (std::getline(conf_file, line)) {
+        const std::string key = "interface=";
+        if (line.compare(0, key.size(), key) == 0) {
+            resolved_iface = line.substr(key.size());
+            auto trim_pos  = resolved_iface.find_last_not_of(" \t\r\n");
+            if (trim_pos != std::string::npos) {
+                resolved_iface.erase(trim_pos + 1);
+            } else {
+                resolved_iface.clear();
+            }
+            break;
+        }
+    }
+
+    if (resolved_iface.empty()) {
+        LOG(INFO) << "No 'interface=' in " << conf_path
+                  << " — no VAP available, will use global ctrl socket";
+    } else {
+        LOG(INFO) << "Resolved interface for " << iface << " from hostapd conf: "
+                  << resolved_iface;
+    }
+}
