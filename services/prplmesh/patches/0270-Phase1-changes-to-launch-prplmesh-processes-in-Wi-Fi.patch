+bool base_wlan_hal_nl80211::get_this_radio_idx(int &radio_idx)
+{
+    auto freq_band = m_radio_info.frequency_band;
+    if (freq_band == beerocks::eFreqType::FREQ_UNKNOWN) {
+        std::string freq_band_str;
+        if (beerocks::bpl::bpl_cfg_get_freq_band_by_phy(m_hal_conf.phy_name, freq_band_str)) {
+            if (freq_band_str == "2g") {
+                freq_band = beerocks::eFreqType::FREQ_24G;
+            } else if (freq_band_str == "5g") {
+                freq_band = beerocks::eFreqType::FREQ_5G;
+            } else if (freq_band_str == "6g") {
+                freq_band = beerocks::eFreqType::FREQ_6G;
+            }
+        }
+    }
+
+    switch (freq_band) {
+    case beerocks::eFreqType::FREQ_24G:
+        radio_idx = RADIOIDX_2G;
+        return true;
+    case beerocks::eFreqType::FREQ_5G:
+    case beerocks::eFreqType::FREQ_5GL:
+        radio_idx = RADIOIDX_5G;
+        return true;
+    case beerocks::eFreqType::FREQ_6G:
+        radio_idx = RADIOIDX_6G;
+        return true;
+    case beerocks::eFreqType::FREQ_5GH:
+        radio_idx = RADIOIDX_5GH;
+        return true;
+    default:
+        LOG(WARNING) << "Unknown frequency band for phy '" << m_hal_conf.phy_name << "'";
+        return false;
+    }
+}
+
+bool base_wlan_hal_nl80211::resolve_wpa_ctrl_iface_name(const std::string &interface,
+                                                         std::string &resolved_interface)
+{
+    resolved_interface = interface;
+
+    if (interface.empty() || interface == global_iface) {
+        return true;
+    }
+
+    // Only MLD interfaces need link-index resolution (which in turn needs the radio's
+    // frequency band via get_this_radio_idx()). Check num_links first, same as
+    // is_iface_of_this_phy(), so a plain non-MLD interface resolves successfully even when
+    // the radio band/phy_name cannot be determined.
+    // STATUS is only answered on the per-interface (base, non-link-suffixed) socket - the
+    // global socket does not support querying it via an IFNAME= prefix.
+    parsed_obj_map_t reply;
+    int num_links = 0;
+    if (wpa_ctrl_send_msg("STATUS", reply, interface)) {
+        auto it = reply.find("num_links");
+        if (it != reply.end() && !it->second.empty() &&
+            std::all_of(it->second.begin(), it->second.end(), ::isdigit)) {
+            num_links = beerocks::string_utils::stoi(it->second);
+        }
+    }
+
+    if (num_links <= 0) {
+        // Non-MLD - no link resolution needed.
+        return true;
+    }
+
+    int radio_idx;
+    if (!get_this_radio_idx(radio_idx)) {
+        LOG(WARNING) << "Cannot resolve MLD link for " << interface
+                     << " - unknown radio band";
+        return false;
+    }
+
+    if (!m_nl80211_client->get_iface_with_link_idx(interface + "##" + std::to_string(radio_idx),
+                                                    resolved_interface)) {
+        LOG(DEBUG) << "Interface " << interface << " has no link on this radio's band";
+        return false;
+    }
+
+    return true;
+}
+
+bool base_wlan_hal_nl80211::is_iface_of_this_phy(const std::string &interface,
+                                                  std::string &resolved_interface)
+{
+    resolved_interface = interface;
+
+    if (m_hal_conf.phy_name.empty()) {
+        // Nothing to compare against - do not filter out.
+        return true;
+    }
+
+    // This function only verifies phy ownership - it must not tear down a socket that
+    // was already registered before this call (e.g. this radio's own primary
+    // interface), only one it opens itself here. register_wpa_ctrl_interface() is a
+    // no-op (via has_interface()) when the interface is already registered, so capture
+    // that state first and only clean up on paths that actually registered it now.
+    // register_wpa_ctrl_interface() also records `interface` in m_radio_info.active_BSSs,
+    // so undo both together. The caller (add_interface(), on a confirmed match)
+    // re-registers/reconnects its own socket fresh afterwards.
+    bool was_already_registered = m_wpa_ctrl_client.has_interface(interface);
+    auto cleanup                = [this, &interface, was_already_registered]() {
+        if (was_already_registered) {
+            return;
+        }
+        m_wpa_ctrl_client.del_interface(interface);
+        auto &active_BSSs = m_radio_info.active_BSSs;
+        active_BSSs.erase(std::remove(active_BSSs.begin(), active_BSSs.end(), interface),
+                           active_BSSs.end());
+    };
+
+    // Query STATUS for this specific (not-yet-registered) interface. STATUS is only
+    // answered on the per-interface (base, non-link-suffixed) socket - the global socket
+    // does not support querying it via an IFNAME= prefix - so register and connect a
+    // per-interface socket for `interface` first.
+    if (!register_wpa_ctrl_interface(interface)) {
+        LOG(WARNING) << "Failed to register wpa_ctrl interface for " << interface
+                     << " - cannot verify phy ownership";
+        return false;
+    }
+
+    auto wpa_ctrl_cmd = m_wpa_ctrl_client.get_socket_cmd(interface);
+    if (!wpa_ctrl_cmd || !wpa_ctrl_cmd->connect()) {
+        LOG(WARNING) << "Failed to connect wpa_ctrl socket for " << interface
+                     << " - cannot verify phy ownership";
+        cleanup();
+        return false;
+    }
+
+    parsed_obj_map_t reply;
+    if (!wpa_ctrl_send_msg("STATUS", reply, interface)) {
+        LOG(WARNING) << "Failed to query STATUS for " << interface
+                     << " - cannot verify phy ownership";
+        cleanup();
+        return false;
+    }
+
+    int num_links = 0;
+    auto it        = reply.find("num_links");
+    if (it != reply.end() && !it->second.empty() &&
+        std::all_of(it->second.begin(), it->second.end(), ::isdigit)) {
+        num_links = beerocks::string_utils::stoi(it->second);
+    }
+
+    if (num_links <= 0) {
+        // Non-MLD - the "phy" field is trustworthy.
+        auto phy   = reply["phy"];
+        bool match = (phy == m_hal_conf.phy_name);
+        if (!match) {
+            LOG(DEBUG) << "Interface " << interface << " belongs to phy '" << phy
+                       << "', not this radio's phy '" << m_hal_conf.phy_name << "' - ignoring";
+        }
+        cleanup();
+        return match;
+    }
+
+    // MLD interface - "phy" only reports the anchor link's phy, so resolve the link that
+    // actually lives on this radio's band instead.
+    int radio_idx;
+    if (!get_this_radio_idx(radio_idx)) {
+        LOG(WARNING) << "Cannot resolve MLD link for " << interface << " - unknown radio band";
+        cleanup();
+        return false;
+    }
+
+    bool resolved = m_nl80211_client->get_iface_with_link_idx(
+        interface + "##" + std::to_string(radio_idx), resolved_interface);
+    if (!resolved) {
+        LOG(DEBUG) << "MLD interface " << interface
+                   << " has no link on this radio's band - ignoring";
+    } else {
+        LOG(DEBUG) << "MLD interface " << interface << " resolved to link " << resolved_interface
+                   << " for this radio's phy '" << m_hal_conf.phy_name << "'";
+    }
+    cleanup();
+    return resolved;
+}
+
+void base_wlan_hal_nl80211::remove_stale_mld_links(const std::string &interface)
+{
+    // STATUS is only answered on the per-interface (base, non-link-suffixed) socket - the
+    // global socket does not support querying it via an IFNAME= prefix - so register and
+    // connect a per-interface socket for `interface` first (has_interface() guards against
+    // re-registering/re-connecting an already-registered socket). Track whether this call
+    // is the one that opened it, so a socket opened purely for this STATUS query (as
+    // opposed to one already registered beforehand, e.g. this radio's own primary
+    // interface) gets torn down again once we're done with it.
+    bool was_already_registered = m_wpa_ctrl_client.has_interface(interface);
+    parsed_obj_map_t reply;
+    int num_links = 0;
+    if (register_wpa_ctrl_interface(interface)) {
+        auto wpa_ctrl_cmd = m_wpa_ctrl_client.get_socket_cmd(interface);
+        if (wpa_ctrl_cmd && wpa_ctrl_cmd->connect() &&
+            wpa_ctrl_send_msg("STATUS", reply, interface)) {
+            auto it = reply.find("num_links");
+            if (it != reply.end() && !it->second.empty() &&
+                std::all_of(it->second.begin(), it->second.end(), ::isdigit)) {
+                num_links = beerocks::string_utils::stoi(it->second);
+            }
+        } else {
+            LOG(WARNING) << "Failed to query STATUS for " << interface
+                         << " - assuming non-MLD";
+        }
+    } else {
+        LOG(WARNING) << "Failed to register wpa_ctrl interface for " << interface
+                     << " - assuming non-MLD";
+    }
+
+    if (num_links <= 0) {
+        // remove_interface() below already tears down the socket + active_BSSs entry
+        // for `interface` regardless of who registered it.
+        remove_interface(interface);
+        return;
+    }
+
+    // MLD interface - remove only the links that are no longer operational, keep the rest
+    // registered.
+    auto active_BSSs = m_radio_info.active_BSSs;
+    for (const auto &registered_iface : active_BSSs) {
+        std::string base_interface;
+        extractLinkBaseInterface(registered_iface, base_interface);
+        if (base_interface != interface) {
+            continue;
+        }
+
+        int link_id = -1;
+        extractLinkId(registered_iface, link_id);
+        if (link_id < 0) {
+            // Not a "_link<N>" suffixed entry (e.g. leftover base-name registration) -
+            // check_link_id_operational() cannot tell us anything about it, so fall back
+            // to checking whether the underlying Linux interface still exists at all.
+            if (!beerocks::net::network_utils::linux_iface_exists(registered_iface)) {
+                LOG(DEBUG) << "Stale registered interface " << registered_iface
+                           << " no longer exists - removing";
+                remove_interface(registered_iface);
+            }
+            continue;
+        }
+
+        if (!m_nl80211_client->check_link_id_operational(interface, link_id)) {
+            LOG(DEBUG) << "Link " << registered_iface << " is no longer operational - removing";
+            remove_interface(registered_iface);
+        }
+    }
+
+    // `interface` itself (the base, non-link-suffixed socket used only to query STATUS
+    // above) was never a real link - drop it again unless it was already registered
+    // before this call for another reason.
+    if (!was_already_registered) {
+        m_wpa_ctrl_client.del_interface(interface);
+        auto &base_active_BSSs = m_radio_info.active_BSSs;
+        base_active_BSSs.erase(
+            std::remove(base_active_BSSs.begin(), base_active_BSSs.end(), interface),
+            base_active_BSSs.end());
+    }
+}
