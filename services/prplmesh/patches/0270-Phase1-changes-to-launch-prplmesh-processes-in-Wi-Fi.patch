+bool BackhaulManager::try_switch_to_wired_backhaul()
+{
+    auto db = AgentDB::get();
+
+    if (db->device_conf.local_gw) {
+        return false;
+    }
+
+    std::string selected_eth_iface;
+    if (!select_gateway_reachable_eth_interface(selected_eth_iface)) {
+        return false;
+    }
+
+    db->ethernet.wan.iface_name = selected_eth_iface;
+    if (!beerocks::net::network_utils::linux_iface_is_up_and_running(selected_eth_iface) ||
+        !is_gateway_reachable_via_interface(selected_eth_iface)) {
+        return false;
+    }
+
+    LOG(INFO) << "Ethernet backhaul available on " << selected_eth_iface
+              << " — switching to wired, skipping wireless restart";
+
+    for (auto &radio_info : m_radios_info) {
+        if (radio_info->sta_wlan_hal) {
+            radio_info->sta_wlan_hal->disconnect_backhaul_sta();
+            radio_info->sta_hal_disconnected_for_eth = true;
+            LOG(DEBUG) << "Set sta_hal_disconnected_for_eth flag for " << radio_info->sta_iface;
+        }
+    }
+
+    m_eth_link_up                         = true;
+    m_backhaul_switch                     = true;
+    m_prev_bh_connection                  = backhaul_connection::Wireless;
+    db->backhaul.connection_type          = AgentDB::sBackhaul::eConnectionType::Wired;
+    db->backhaul.selected_iface_name      = selected_eth_iface;
+    db->backhaul.selected_iface_radio_mac = net::network_utils::ZERO_MAC;
+
+    send_slaves_enable();
+
+    stop_on_failure_attempts = configuration_stop_on_failure_attempts;
+    FSM_MOVE_STATE(CONNECTED);
+    return true;
+}
