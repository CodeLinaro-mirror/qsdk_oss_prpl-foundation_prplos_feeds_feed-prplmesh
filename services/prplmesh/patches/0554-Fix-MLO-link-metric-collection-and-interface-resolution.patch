+uint32_t network_utils::linux_get_iface_link(const std::string &iface_name)
+{
+    std::ifstream iflink_file("/sys/class/net/" + iface_name + "/iflink");
+
+    uint32_t iflink = 0;
+    iflink_file >> iflink;
+
+    if (!iflink_file || iflink == 0) {
+        return 0;
+    }
+
+    return iflink;
+}
