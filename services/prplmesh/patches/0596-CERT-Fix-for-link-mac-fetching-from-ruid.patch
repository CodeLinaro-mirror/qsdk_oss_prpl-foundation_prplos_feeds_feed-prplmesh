From 89a1c7d5b41382a09bf553675b598b7083c27414 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Tue, 10 Nov 2026 14:44:56 +0530
Subject: [PATCH] CERT: Fix for link mac fetching from ruid

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     | 41 +++++++++++++------
 1 file changed, 29 insertions(+), 12 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index f0755d3..9fe6a5b 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -4012,24 +4012,41 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
         sMacAddr ruid = msg ? msg->ruid : net::network_utils::ZERO_MAC;
         if (msg && ruid == net::network_utils::ZERO_MAC &&
             msg->affiliated_mac_address != net::network_utils::ZERO_MAC) {
-            // Match on the radio's own primary-channel frequency, not its (potentially
-            // wider, bandwidth-dependent) center frequency - msg->affiliated_link_frequency
-            // is NL80211_ATTR_WIPHY_FREQ, the link's primary/operating frequency, which for
-            // a bonded (40/80/160MHz) channel differs from wifi_channel's center frequency.
+            // Match on the frequency band, not on the radio's current channel: the local
+            // radios are not necessarily tuned to the bSTA's channel when the link connects
+            // (their wifi_channel can still be 0), so a channel-based match never resolves.
+            // Each local radio covers a distinct band in an MLO setup.
+            auto link_band = son::wireless_utils::which_freq_type(msg->affiliated_link_frequency);
+
+            // which_freq_type() reports both 5GHz sub-bands as FREQ_5G. On a quad-band platform
+            // the local radios are 5GL and 5GH, so split the link into the matching sub-band.
+            const bool quad_band_5g = std::any_of(
+                db->get_radios_list().begin(), db->get_radios_list().end(), [](const auto &r) {
+                    return r->frequency_band == beerocks::eFreqType::FREQ_5GL ||
+                           r->frequency_band == beerocks::eFreqType::FREQ_5GH;
+                });
+            if (link_band == beerocks::eFreqType::FREQ_5G && quad_band_5g) {
+                const auto link_channel =
+                    son::wireless_utils::freq_to_channel(msg->affiliated_link_frequency);
+                link_band = (link_channel <= int(END_OF_LOW_BAND)) ? beerocks::eFreqType::FREQ_5GL
+                                                                   : beerocks::eFreqType::FREQ_5GH;
+            }
+
+            uint8_t band_matches = 0;
             for (const auto radio : db->get_radios_list()) {
-                const auto &wifi_channel    = radio->wifi_channel;
-                const uint16_t primary_freq = son::wireless_utils::channel_to_freq(
-                    wifi_channel.get_channel(), wifi_channel.get_freq_type());
-                if (primary_freq != 0 && primary_freq == msg->affiliated_link_frequency) {
+                if (link_band != beerocks::eFreqType::FREQ_UNKNOWN &&
+                    radio->frequency_band == link_band) {
                     ruid = radio->front.iface_mac;
-                    break;
+                    ++band_matches;
                 }
             }
-            if (ruid == net::network_utils::ZERO_MAC) {
-                LOG(WARNING) << "Affiliated_Link_Connected: no local radio matches link "
-                                "frequency "
+            // The RUID is only valid if exactly one local radio covers the link's band.
+            if (band_matches != 1) {
+                LOG(WARNING) << "Affiliated_Link_Connected: " << int(band_matches)
+                             << " local radios match the band of link frequency "
                              << msg->affiliated_link_frequency << " - can't resolve RUID for "
                              << "affiliated mac " << msg->affiliated_mac_address;
+                ruid = net::network_utils::ZERO_MAC;
             }
         }
 
