From 292bb4f637f178cf3925332fbc0fc43f807ac537 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Sun, 11 Jan 2026 12:00:22 +0530
Subject: [PATCH] remove encryption parameters in mld section

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../src/beerocks/master/son_management.cpp    | 32 +++++++++++++++++++
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 11 +------
 2 files changed, 33 insertions(+), 10 deletions(-)

diff --git a/controller/src/beerocks/master/son_management.cpp b/controller/src/beerocks/master/son_management.cpp
index cd69ab072..fabeb324d 100644
--- a/controller/src/beerocks/master/son_management.cpp
+++ b/controller/src/beerocks/master/son_management.cpp
@@ -32,6 +32,8 @@
 #include <bcl/beerocks_utils.h>
 #include <bcl/beerocks_wifi_channel.h>
 #include <easylogging++.h>
+#include <bpl/bpl_cfg.h>
+
 using namespace beerocks;
 using namespace net;
 using namespace son;
@@ -1368,6 +1370,36 @@ void son_management::handle_bml_message(int sd, std::shared_ptr<beerocks_header>
             return;
         }
 
+        database.clear_bss_info_configuration();
+
+        std::list<son::wireless_utils::sBssInfoConf> wireless_settings;
+        if (beerocks::bpl::bpl_cfg_get_wireless_settings(wireless_settings)) {
+            for (const auto &configuration : wireless_settings) {
+                database.add_bss_info_configuration(configuration);
+
+                if (!configuration.mld_id.empty() &&
+                     configuration.mld_id != std::to_string(DISABLED_MLDUNIT)) {
+
+                     int mld_unit = -1;
+                     mld_unit = beerocks::string_utils::stoi(configuration.mld_id);
+                     if (mld_unit >= 0) {
+                             son::wireless_utils::sMldInfoConf mld_info;
+                             mld_info.ssid = configuration.ssid;
+
+                             // TODO: Read Modes from Configuration (PPM-3588)
+                             mld_info.str   = true;
+                             mld_info.nstr  = false;
+                             mld_info.emlsr = true;
+                             mld_info.emlmr = false;
+
+                             database.add_mld_info_configuration(mld_info,configuration.mld_id);
+                     }
+                }
+           }
+        } else {
+            LOG(DEBUG) << "failed to read wireless settings";
+        }
+
         ret = son_actions::send_ap_config_renew_msg(cmdu_tx, database);
         if (!ret) {
             LOG(ERROR) << "Failed son_actions::send_ap_config_renew_msg ! ";
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 6ca713dba..6f827fe5a 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -631,17 +631,8 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
         OptionsUnorderedMap mldOptions;
         mldOptions["ssid"] = configuration.ssid;
 
-        mldOptions["encryption"] = get_encryption(configuration.authentication_type, configuration.encryption_type);
-
-        // Set sae_pwe if encryption is SAE
-        if (mldOptions["encryption"] == "sae") {
-            mldOptions["sae_pwe"] = "2"; 
-            mldOptions["sae"] = "1";
-        }
-        if (mldOptions["encryption"] == "sae-mixed") {
-            mldOptions["sae_pwe"] = "2";
-        }
         mldOptions["key"] = configuration.network_key;
+
         mldOptions["ifname"] = iface;
         if(!configuration.multi_ap.empty()) {
                 mldOptions["multi_ap"] = configuration.multi_ap;
-- 
2.34.1

