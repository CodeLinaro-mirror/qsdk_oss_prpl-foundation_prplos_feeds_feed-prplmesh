From 5ab7b3140d26bed18087b208f95ed68016b29bb0 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Mon, 12 Jan 2026 19:28:16 +0530
Subject: [PATCH 32/54] Fixes PrplMesh Service Status Incorrect Display Also
 includes fix for agent process crash due to unhandled vap node updation

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
index 1f8809135..fd456c56c 100644
--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
@@ -881,8 +881,8 @@ bool Monitor::create_ap_metrics_response(uint16_t mid, const std::vector<sMacAdd
         if (!vap_node) {
             LOG(WARNING) << "Unknown BSSID " << bssid << " - skipping";
 	    update_vaps_in_db();
-	    auto vap_node_refreshed = mon_db.get_vap_node(tlvf::mac_to_string(bssid));
-	    if(!vap_node_refreshed) {
+	    vap_node = mon_db.get_vap_node(tlvf::mac_to_string(bssid));
+	    if(!vap_node) {
 		    LOG(WARNING) << "Unknown BSSID even after updating the vaps in DB again." << bssid << " - skipping";
 		    continue;
 	    }
-- 
2.34.1

