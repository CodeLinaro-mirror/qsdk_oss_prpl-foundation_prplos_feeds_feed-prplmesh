From fc0d308557eebb02034160eab7b38df4f76024d9 Mon Sep 17 00:00:00 2001
From: Shreeram Swaminathan <shrerama@qti.qualcomm.com>
Date: Fri, 31 Jul 2026 20:00:00 +0530
Subject: [PATCH] strlcpy backport shim for RDKB old-glibc toolchains

Change-Id: Icc8a0be24f489afe0591039148459ad9e2ca916a
Signed-off-by: Shreeram Swaminathan <shrerama@qti.qualcomm.com>
---
 CMakeLists.txt                                       |  5 +++++
 common/beerocks/bcl/include/bcl/beerocks_backport.h  | 25 ++++++++++++++++++++
 framework/platform/bpl/cfg/rdk/bpl_cfg.cpp           |  3 +++
 3 files changed, 33 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f972b881f..b8d08df79 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -199,6 +199,11 @@ if (TARGET_PLATFORM STREQUAL "linux")
     endif()
 elseif (TARGET_PLATFORM STREQUAL "rdkb")
     add_definitions(-DBEEROCKS_RDKB)
+    include(CheckSymbolExists)
+    check_symbol_exists(strlcpy "string.h" HAVE_STRLCPY)
+    if (HAVE_STRLCPY)
+        add_definitions(-DHAVE_STRLCPY)
+    endif()
     list(APPEND FEATURES "FEATURE_PRE_ASSOCIATION_STEERING")
     add_definitions(-DFEATURE_PRE_ASSOCIATION_STEERING)
     set(BEEROCKS_BRIDGE_IFACE  "brlan0" CACHE STRING "LAN bridge")
diff --git a/common/beerocks/bcl/include/bcl/beerocks_backport.h b/common/beerocks/bcl/include/bcl/beerocks_backport.h
index 8799eb5f7..2c560ea06 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_backport.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_backport.h
@@ -10,6 +10,7 @@
 #define _BEEROCKS_BACKPORT_H_

 #include <chrono>
+#include <cstring>
 #include <memory>
 #include <type_traits>

@@ -23,6 +24,30 @@ template <typename T, typename... Args> std::unique_ptr<T> make_unique(Args &&..
 } // namespace std
 #endif

+/*
+ * strlcpy() was added to glibc only in 2.38 (Aug 2023); older glibc toolchains
+ * (and only those - musl, BSD libc and macOS libc have always provided it)
+ * need this shim. Some vendor toolchains backport strlcpy() into an older
+ * glibc release, so the glibc version number alone can't be trusted; HAVE_STRLCPY
+ * is set by a CMake check_symbol_exists() probe of the actual target sysroot.
+ * Restricted to BEEROCKS_RDKB since that is the only platform currently built
+ * against a glibc toolchain old enough to lack strlcpy().
+ */
+#if defined(BEEROCKS_RDKB) && !defined(HAVE_STRLCPY)
+static inline size_t strlcpy(char *dest, const char *src, size_t size)
+{
+    size_t src_len = strlen(src);
+
+    if (size > 0) {
+        size_t copy_len = (src_len < size - 1) ? src_len : size - 1;
+        memcpy(dest, src, copy_len);
+        dest[copy_len] = '\0';
+    }
+
+    return src_len;
+}
+#endif
+
 // Until prplMesh will be built using C++20, there's no simple way to fail
 // the built if a template argument is not derived from std::chrono::duration.
 // This little trick allows using static_assert and fail the build in this case.
diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
index ab96de7bb..8c1e4f3ab 100644
--- a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
@@ -7,6 +7,9 @@
 #include <fstream>
 #include <cstring>
 #include <cjson/cJSON.h>
+#if defined(BEEROCKS_RDKB)
+#include <bcl/beerocks_backport.h>
+#endif
 #include <bcl/beerocks_version.h>
 // #include <rbus/rbus.h> // Will be used later

--
