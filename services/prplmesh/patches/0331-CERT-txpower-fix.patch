From e0a1232bed3da73c182838fcd1b7e73d4369fd4f Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Mon, 17 Aug 2026 11:17:27 +0530
Subject: [PATCH] Fixes

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../slave/tasks/channel_selection_task.cpp    | 25 ++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
index 40309f6..3265b36 100644
--- a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
@@ -2240,6 +2240,7 @@ void ChannelSelectionTask::handle_channel_selection_request(ieee1905_1::CmduMess
         // Only the two auto approaches drive the outgoing request specially. Every other
         // configuration falls through to the legacy channel-switch path below.
         if (cs_auto_active_acs || cs_auto_cbs) {
+            bool auto_path_dispatched = false;
             if (cs_auto_active_acs) {
                 if (radio_mac == m_acs_list.first) {
                     LOG(DEBUG) << "[ACTIVE_ACS] active_acs_chansel_enable=1 -> sending platform ACS"
@@ -2253,6 +2254,7 @@ void ChannelSelectionTask::handle_channel_selection_request(ieee1905_1::CmduMess
                     // Channel Report, reusing the existing CSA-notification flow.
                     request.chan_sel_state            = eRadioChanSwitchState::ACS_SENT;
                     m_pending_selection.last_chan_sel = std::chrono::steady_clock::now();
+                    auto_path_dispatched              = true;
                 }
             } else if (cs_auto_cbs && request.channel_switch_needed) {
                 // CBS-based selection already chose the best channel from the cache. Perform a
@@ -2271,9 +2273,30 @@ void ChannelSelectionTask::handle_channel_selection_request(ieee1905_1::CmduMess
                 } else {
                     request.chan_sel_state            = eRadioChanSwitchState::ACS_SENT;
                     m_pending_selection.last_chan_sel = std::chrono::steady_clock::now();
+                    auto_path_dispatched              = true;
                 }
             }
-            continue;
+
+            // The auto-selection branches above only dispatch when they actually picked a
+            // channel/ACS list. When the controller preference set left no operable channel
+            // (e.g. every operating class reported preference=0), neither branch fires and
+            // channel_switch_needed stays false - but a TX-power-limit / spatial-reuse / EHT
+            // update from THIS SAME request can still be pending (power_switch_received /
+            // spatial_reuse_request_received / eht_operations_received), independent of channel
+            // selection. Continuing unconditionally here silently drops that pending update, since
+            // it is never re-evaluated. Only skip the legacy dispatch below when the auto path
+            // already sent something, or when there is genuinely nothing left to send.
+            if (auto_path_dispatched ||
+                (!request.power_switch_received && !request.spatial_reuse_request_received &&
+                 !request.eht_operations_received)) {
+                continue;
+            }
+            LOG(DEBUG) << "auto-chansel enabled but no channel/ACS "
+                          "dispatched for radio "
+                       << radio_mac << " -- falling through to legacy dispatch for pending "
+                       << "power_switch_received=" << request.power_switch_received
+                       << " spatial_reuse_request_received=" << request.spatial_reuse_request_received
+                       << " eht_operations_received=" << request.eht_operations_received;
         }
 
         // Check if Channel-Switch is needed
-- 
