+    notification->params().ap_modes_support.str_support = ap_wlan_hal->get_radio_info().ap_modes_support.str_support;
+    notification->params().ap_modes_support.nstr_support = ap_wlan_hal->get_radio_info().ap_modes_support.nstr_support;
