@@ -196,6 +196,14 @@ struct RadioInfo {
     std::unordered_map<int, VAPElement> available_vaps; // key = vap_id
 
     uint8_t radio_max_bss_supported = 0;
+
+    struct sMloModesSupport {
+        bool str_support;
+        bool nstr_support;
+        bool emlsr_support;
+        bool emlmr_support;
+    } ap_modes_support, bsta_modes_support;
