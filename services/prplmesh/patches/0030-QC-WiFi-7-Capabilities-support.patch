+++ b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
@@ -654,6 +654,19 @@ bool base_wlan_hal_whm::refresh_radio_info()
         }
     }
 
+    // Wi-Fi 7 capabilities
+    m_radio_info.eht_supported = supported_standards.find("be") != std::string::npos ? 1 : 0;
+    if (m_radio_info.eht_supported) {
+        m_ambiorix_cl.get_param(m_radio_info.ap_modes_support.str_support, m_radio_path + "Capabilities.WiFi7APRole.", "STRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.ap_modes_support.nstr_support, m_radio_path + "Capabilities.WiFi7APRole.", "NSTRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.ap_modes_support.emlsr_support, m_radio_path + "Capabilities.WiFi7APRole.", "EMLSRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.ap_modes_support.emlmr_support, m_radio_path + "Capabilities.WiFi7APRole.", "EMLMRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.bsta_modes_support.str_support, m_radio_path + "Capabilities.WiFi7STARole.", "STRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.bsta_modes_support.nstr_support, m_radio_path + "Capabilities.WiFi7STARole.", "NSTRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.bsta_modes_support.emlsr_support, m_radio_path + "Capabilities.WiFi7STARole.", "EMLSRSupport");
+        m_ambiorix_cl.get_param(m_radio_info.bsta_modes_support.emlmr_support, m_radio_path + "Capabilities.WiFi7STARole.", "EMLMRSupport");
+    }
+
     if (radio->read_child(s_val, "ExtensionChannel")) {
         bool channel_ext_above = (s_val == "AboveControlChannel");
         if (!channel_ext_above && (s_val == "Auto") &&
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml
index b77ef9e07..23401cac5 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_common.yaml
@@ -49,6 +49,13 @@ sVapInfo:
     _type: int8_t
   ap_mld_mac: sMacAddr
 
+sMloModesSupport:
+  _type: struct
+  str_support: uint8_t #bool
+  nstr_support: uint8_t #bool
+  emlsr_support: uint8_t #bool
+  emlmr_support: uint8_t #bool
+
 sSonConfig:
   _type: struct
   monitor_total_ch_load_notification_lo_th_percent: uint8_t
@@ -260,6 +267,8 @@ sNodeHostap:
     _type: uint8_t
     _length: ["beerocks::message::HE_MCS_SET_SIZE"]
   eht_supported: uint8_t #bool
+  ap_modes_support: sMloModesSupport
+  bsta_modes_support: sMloModesSupport
   zwdfs:
     _type: uint8_t
     _comment: Boolean. When set to 'true', the radio can be used only for zwdfs purpose.
