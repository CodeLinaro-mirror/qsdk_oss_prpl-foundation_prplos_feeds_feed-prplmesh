- * the file — not the MLD MAC that AP-STA-CONNECTED carries.
+ * the file — not the MLD MAC that AP-STA-CONNECTED carries. Callers that
+ * only have the MLD MAC should fall back to
+ * restore_assoc_frame_from_db_by_mld_mac() on a miss here.
  *
  * @param sta_mac  MAC address string to look up (e.g. "bc:cd:99:9f:94:77").
  * @return         Raw frame bytes, or empty vector if not found.
@@ -67,14 +162,50 @@ inline std::vector<uint8_t> restore_assoc_frame_from_db(const std::string &sta_m
         if (mac != sta_mac) {
             continue;
         }
-        // Decode hex string back to raw bytes
-        std::vector<uint8_t> frame;
-        frame.reserve(hex_str.size() / 2);
-        for (size_t i = 0; i + 1 < hex_str.size(); i += 2) {
-            frame.push_back(
-                static_cast<uint8_t>(std::stoi(hex_str.substr(i, 2), nullptr, 16)));
+        return assoc_frame_db_internal::decode_hex_frame(hex_str);
+    }
+    return {};
+}
+
+/**
+ * @brief Restore the association frame for an MLO STA by its MLD MAC.
+ *
+ * The DB file is keyed by link MAC (see restore_assoc_frame_from_db()), so a
+ * direct lookup by MLD MAC always misses. This scans every entry, decodes it,
+ * and returns the first frame whose embedded Multi-Link Element MLD MAC
+ * (extract_mld_mac_from_assoc_frame()) matches @p mld_mac.
+ *
+ * Intended as a fallback after restore_assoc_frame_from_db(mld_mac) misses —
+ * cheap direct lookups still cover SLO clients without paying this scan.
+ *
+ * @param mld_mac  MLD MAC address string to look up (e.g. "02:14:5f:b8:ae:9f").
+ * @return         Raw frame bytes of the matching entry, or empty vector if
+ *                  no entry's embedded MLD MAC matches.
+ */
+inline std::vector<uint8_t> restore_assoc_frame_from_db_by_mld_mac(const std::string &mld_mac)
+{
+    std::ifstream ifs(ASSOC_FRAMES_DB_PATH);
+    if (!ifs) {
+        return {};
+    }
+
+    std::string line;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) {
+            continue;
+        }
+        std::istringstream ss(line);
+        std::string mac, hex_str;
+        ss >> mac >> hex_str;
+        if (mac.empty() || hex_str.empty()) {
+            continue;
+        }
+        auto frame = assoc_frame_db_internal::decode_hex_frame(hex_str);
+        std::string candidate_mld_mac;
+        if (extract_mld_mac_from_assoc_frame(frame, candidate_mld_mac) &&
+            candidate_mld_mac == mld_mac) {
+            return frame;
         }
-        return frame;
     }
     return {};
 }
