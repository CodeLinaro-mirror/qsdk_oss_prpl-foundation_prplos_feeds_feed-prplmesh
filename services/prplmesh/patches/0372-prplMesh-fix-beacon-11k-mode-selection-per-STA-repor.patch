 /// process boundaries (AP manager → agent) and agent restarts.
 static constexpr const char *ASSOC_FRAMES_DB_PATH = "/tmp/beerocks/sta_assoc_frames.txt";
 
+namespace assoc_frame_db_internal {
+inline std::vector<uint8_t> decode_hex_frame(const std::string &hex_str)
+{
+    std::vector<uint8_t> frame;
+    frame.reserve(hex_str.size() / 2);
+    for (size_t i = 0; i + 1 < hex_str.size(); i += 2) {
+        frame.push_back(static_cast<uint8_t>(std::stoi(hex_str.substr(i, 2), nullptr, 16)));
+    }
+    return frame;
+}
+} // namespace assoc_frame_db_internal
+
+/**
+ * @brief Extract the MLD MAC address from an association/reassociation request
+ * frame's Multi-Link Element (IEEE 802.11be, Extension IE 255/107), if present.
+ *
+ * The frame's 802.11 header is always addressed by the transmitting link STA
+ * (there is no MLD address in a MAC header) — the MLD MAC only appears inside
+ * the Multi-Link Element payload carried by the frame body. This helper digs
+ * it out so a link-MAC-keyed frame (as persisted by persist_assoc_frame() /
+ * restore_assoc_frame_from_db()) can still be matched against an MLD MAC.
+ *
+ * @param frame        Raw association/reassociation request frame bytes.
+ * @param mld_mac_out  Receives the MLD MAC as a colon-separated string on success.
+ * @return true if a Basic-variant MLE with a valid MLD MAC field was found,
+ *         false otherwise (frame too short, no MLE, or non-Basic variant).
+ */
+inline bool extract_mld_mac_from_assoc_frame(const std::vector<uint8_t> &frame,
+                                              std::string &mld_mac_out)
+{
+    static constexpr uint8_t IE_ID_EXTENSION      = 255;
+    static constexpr uint8_t IE_EXT_MULTI_LINK    = 107;
+    static constexpr size_t  MLE_MLCTRL_OFFSET    = 1;
+    static constexpr size_t  MLE_CINFO_LEN_OFFSET = 3;
+    static constexpr size_t  MLE_CINFO_MAC_OFFSET = 4;
+    static constexpr size_t  MLE_CINFO_MIN_LEN    = 7;
+
+    static constexpr uint16_t candidate_offsets[] = {4, 10};
+    size_t best_offset = 4;
+    int best_count      = -1;
+    for (uint16_t off : candidate_offsets) {
+        if (frame.size() <= (size_t)off + 2) { continue; }
+        size_t pos = off;
+        int count  = 0;
+        while (pos + 2 <= frame.size()) {
+            uint8_t elen = frame[pos + 1];
+            if (pos + 2 + elen > frame.size()) { break; }
+            count++;
+            pos += 2 + elen;
+        }
+        if (count > best_count) {
+            best_count  = count;
+            best_offset = off;
+        }
+    }
+
+    size_t pos = best_offset;
+    const uint8_t *mle    = nullptr;
+    size_t mle_elen        = 0;
+    while (pos + 2 <= frame.size()) {
+        uint8_t id   = frame[pos];
+        uint8_t elen = frame[pos + 1];
+        if (pos + 2 + elen > frame.size()) { break; }
+        if (id == IE_ID_EXTENSION && elen >= 1 && frame[pos + 2] == IE_EXT_MULTI_LINK) {
+            mle      = frame.data() + pos + 2;
+            mle_elen = elen;
+            break;
+        }
+        pos += 2 + elen;
+    }
+    if (!mle || mle_elen < MLE_CINFO_MAC_OFFSET + 6) {
+        return false;
+    }
+
+    if ((mle[MLE_MLCTRL_OFFSET] & 0x07) != 0) {
+        return false;
+    }
+
+    uint8_t cinfo_len = mle[MLE_CINFO_LEN_OFFSET];
+    if (cinfo_len < MLE_CINFO_MIN_LEN) {
+        return false;
+    }
+
+    char mac_buf[18];
+    snprintf(mac_buf, sizeof(mac_buf), "%02x:%02x:%02x:%02x:%02x:%02x",
+             mle[MLE_CINFO_MAC_OFFSET], mle[MLE_CINFO_MAC_OFFSET + 1],
+             mle[MLE_CINFO_MAC_OFFSET + 2], mle[MLE_CINFO_MAC_OFFSET + 3],
+             mle[MLE_CINFO_MAC_OFFSET + 4], mle[MLE_CINFO_MAC_OFFSET + 5]);
+    mld_mac_out = mac_buf;
+    return true;
+}
