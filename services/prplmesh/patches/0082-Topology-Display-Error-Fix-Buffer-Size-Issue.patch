From 6760ee6a04f5c762419cccf9cff73789d93b9c85 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 23 Feb 2026 17:13:19 +0530
Subject: [PATCH 2/7] Topology Display Error Fix Buffer Size Issue

Scenario:
In an edge-case scenario, a miscalculation in the buffer size caused topology updates to fail for a few agents.
The issue occurred because the message could not be sent due to insufficient buffer allocation.

Fix:
Added a reserved buffer margin to account for the overhead used by CMDU during Frame serialization.

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../src/beerocks/master/db/network_map.cpp    | 20 +++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/controller/src/beerocks/master/db/network_map.cpp b/controller/src/beerocks/master/db/network_map.cpp
index 752b42090..28fb99064 100644
--- a/controller/src/beerocks/master/db/network_map.cpp
+++ b/controller/src/beerocks/master/db/network_map.cpp
@@ -59,6 +59,11 @@ void network_map::send_bml_network_map_message(db &database, int fd,
     std::ptrdiff_t size = 0, size_left = 0, node_len = 0;
     response->node_num() = 0;
 
+    // Reserved size accounts for CMDU protocol overhead when sending messages.
+    // This includes UDS header, End-of-Message (EOM) marker, and other protocol headers
+    // that are added during transmission. We need to reserve this space to prevent buffer overflow.
+    const auto reserved_size =
+        message_com::get_vs_cmdu_size_on_buffer<beerocks_message::cACTION_BML_NW_MAP_RESPONSE>();
     auto send_nw_map_message_if_needed = [&]() -> bool {
         if (node_len > size_left) {
             if (response->node_num() == 0) {
@@ -71,7 +76,6 @@ void network_map::send_bml_network_map_message(db &database, int fd,
             response =
                 message_com::create_vs_message<beerocks_message::cACTION_BML_NW_MAP_RESPONSE>(
                     cmdu_tx, id);
-
             if (response == nullptr) {
                 LOG(ERROR) << "Failed building message ACTION_BML_NW_MAP_RESPONSE!";
                 return false;
@@ -82,16 +86,14 @@ void network_map::send_bml_network_map_message(db &database, int fd,
             response->node_num()                 = 0;
             data_start                           = nullptr;
             size                                 = 0;
-            size_left =
-                beerocks_header->getMessageBuffLength() - beerocks_header->getMessageLength();
+            size_left = cmdu_tx.getMessageBuffLength() - reserved_size;
         }
         return true;
     };
 
     auto process_agent = [&](const auto &agent) {
         node_len  = sizeof(BML_NODE);
-        size_left = beerocks_header->getMessageBuffLength() - beerocks_header->getMessageLength();
-
+        size_left = cmdu_tx.getMessageBuffLength() - reserved_size - size;
         if (!send_nw_map_message_if_needed()) {
             return;
         }
@@ -119,15 +121,13 @@ void network_map::send_bml_network_map_message(db &database, int fd,
             for (const auto &bss : radio.second->bsses) {
                 for (const auto &station_pair : bss.second->connected_stations) {
                     const auto &station = station_pair.second;
-                    LOG(ERROR) << "Handling station " << station->mac;
+                    LOG(INFO) << "Handling station " << station->mac;
                     if (station->state != beerocks::STATE_CONNECTED) {
                         LOG(ERROR) << "STA: " << station->mac << " not connected!";
                         continue;
                     }
                     node_len  = sizeof(BML_NODE) - sizeof(BML_NODE::N_DATA::N_GW_IRE);
-                    size_left = beerocks_header->getMessageBuffLength() -
-                                beerocks_header->getMessageLength();
-
+                    size_left = cmdu_tx.getMessageBuffLength() - reserved_size - size;
                     if (!send_nw_map_message_if_needed()) {
                         return;
                     }
@@ -161,7 +161,7 @@ void network_map::send_bml_network_map_message(db &database, int fd,
 
     // vector to store agents data which have been inactive for more than 125 seconds
     std::vector<sMacAddr> agents_to_remove;
-    
+
     // Fill the data for non-local agents
     for (const auto &agent_pair : database.m_agents) {
         const auto &agent = agent_pair.second;
