From bca5e8d6d0b87253ccbf7821a23ace2fb8f80e38 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Wed, 9 Sep 2026 16:41:54 +0530
Subject: [PATCH] Added additional encryption support to bsta

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 23 +++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index dedd357ad..ad4bd2f4c 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -2853,7 +2853,20 @@ static std::string get_encryption_string(WSC::eWscAuth authentication_type,
     // out here so the exact-match comparisons below match on the base AKM only.
     authentication_type =
         static_cast<WSC::eWscAuth>(authentication_type & ~WSC::eWscAuth::WSC_AUTH_DPP);
-    if (authentication_type == WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
+
+    if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                WSC::eWscAuth::WSC_AUTH_SAE |
+                                WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+        encryption = "sae-mixed";
+    } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE |
+                                       WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+        encryption = "sae-sae_ext_key";
+    } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                       WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+        encryption = "psk2+gcmp-256";
+    } else if (authentication_type == WSC::eWscAuth::WSC_AUTH_SAE_AKM24) {
+        encryption = "sae-ext-key";
+    } else if (authentication_type == WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
         encryption = "psk2";
         if (encryption_type == WSC::eWscEncr::WSC_ENCR_TKIP) {
             encryption += "+tkip";
@@ -2937,9 +2950,11 @@ bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
         options["sae"]     = "1";
 
     }
-    if (options["encryption"] == "sae-mixed") {
-        options["sae_pwe"] = "2";
-
+    if (options["encryption"] == "sae-mixed" || 
+        options["encryption"] == "sae-ext-key" || 
+        options["encryption"] == "sae-sae_ext_key" || 
+        options["encryption"] == "akm24-sae-mixed") {
+        options["sae_pwe"] = "2";  
     }
     options["key"]      = configuration.network_key;
     options["multi_ap"] = "1";
-- 
2.34.1

