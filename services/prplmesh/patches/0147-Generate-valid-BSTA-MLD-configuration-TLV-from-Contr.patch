From f937b32c1dd9fc09496dd21e2930f7c8aa6e2d87 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Sat, 2 May 2026 14:01:30 +0530
Subject: [PATCH] Generate valid BSTA MLD configuration TLV from Controller

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp        | 4 ++++
 controller/nbapi/on_action.cpp                             | 2 +-
 controller/src/beerocks/master/beerocks_master_main.cpp    | 2 +-
 controller/src/beerocks/master/controller_ucc_listener.cpp | 2 +-
 controller/src/beerocks/master/son_management.cpp          | 2 +-
 5 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index e724301f1..acb47d90e 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1010,6 +1010,10 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
                m_radio_info.ap_modes_support.nstr_support = radio_info.eht_cfg.ap_modes_support.emlsr_support;
                m_radio_info.ap_modes_support.str_support = radio_info.eht_cfg.ap_modes_support.emlsr_support;
 
+
+//Workaround: remove after proper platform fetch - Hardcoding as platform read tells not supported for all modes for STA
+               radio_info.eht_cfg.bsta_modes_support.emlsr_support = radio_info.eht_cfg.ap_modes_support.emlsr_support;
+
                m_radio_info.bsta_modes_support.emlmr_support = radio_info.eht_cfg.bsta_modes_support.emlmr_support;
                m_radio_info.bsta_modes_support.emlsr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
                m_radio_info.bsta_modes_support.nstr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
diff --git a/controller/nbapi/on_action.cpp b/controller/nbapi/on_action.cpp
index e27565520..870c95394 100644
--- a/controller/nbapi/on_action.cpp
+++ b/controller/nbapi/on_action.cpp
@@ -413,7 +413,7 @@ amxd_status_t access_point_commit(amxd_object_t *object, amxd_function_t *func,
 
                 // TODO: Read Modes from Configuration (PPM-3588)
                 mld_info.str   = true;
-                mld_info.nstr  = false;
+                mld_info.nstr  = true;
                 mld_info.emlsr = true;
                 mld_info.emlmr = false;
 
diff --git a/controller/src/beerocks/master/beerocks_master_main.cpp b/controller/src/beerocks/master/beerocks_master_main.cpp
index c262ed282..c89414c78 100644
--- a/controller/src/beerocks/master/beerocks_master_main.cpp
+++ b/controller/src/beerocks/master/beerocks_master_main.cpp
@@ -889,7 +889,7 @@ int main(int argc, char *argv[])
 
 						// TODO: Read Modes from Configuration (PPM-3588)
 						mld_info.str   = true;
-						mld_info.nstr  = false;
+						mld_info.nstr  = true;
 						mld_info.emlsr = true;
 						mld_info.emlmr = false;
 
diff --git a/controller/src/beerocks/master/controller_ucc_listener.cpp b/controller/src/beerocks/master/controller_ucc_listener.cpp
index 08a5f4850..fd708bc5a 100644
--- a/controller/src/beerocks/master/controller_ucc_listener.cpp
+++ b/controller/src/beerocks/master/controller_ucc_listener.cpp
@@ -479,7 +479,7 @@ bool controller_ucc_listener::handle_dev_set_config(
 
             // Certification expects minumum STR, but enable with our defaults of reference platforms
             mld_info.str   = true;
-            mld_info.nstr  = false;
+            mld_info.nstr  = true;
             mld_info.emlsr = true;
             mld_info.emlmr = false;
 
diff --git a/controller/src/beerocks/master/son_management.cpp b/controller/src/beerocks/master/son_management.cpp
index 876ee0afc..a739d61af 100644
--- a/controller/src/beerocks/master/son_management.cpp
+++ b/controller/src/beerocks/master/son_management.cpp
@@ -1391,7 +1391,7 @@ void son_management::handle_bml_message(int sd, std::shared_ptr<beerocks_header>
 
                              // TODO: Read Modes from Configuration (PPM-3588)
                              mld_info.str   = true;
-                             mld_info.nstr  = false;
+                             mld_info.nstr  = true;
                              mld_info.emlsr = true;
                              mld_info.emlmr = false;
 
-- 
2.34.1

