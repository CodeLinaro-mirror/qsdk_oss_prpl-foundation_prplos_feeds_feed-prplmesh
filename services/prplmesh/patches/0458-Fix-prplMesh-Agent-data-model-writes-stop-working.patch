         return;
diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index 2183cdccd..53a9bb96f 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -88,19 +88,32 @@ public:
     private:
         AgentDB &m_db;
     };
-    static SafeDB get()
-    {
-        // Guaranteed to be destroyed.
-        // Instantiated on first use.
-        static AgentDB instance;
-        return SafeDB(instance);
-    }
+    static SafeDB get() { return SafeDB(instance()); }
     AgentDB(const AgentDB &) = delete;
     void operator=(const AgentDB &) = delete;
 
+    /**
+     * @brief Exposes the same mutex AgentDB itself uses to guard access to its
+     * singleton instance, so that other classes (namely AmbiorixImpl) can serialize
+     * their own access to the shared datamodel against it directly, instead of using
+     * a separate, independent mutex object.
+     *
+     * @return Reference to AgentDB's internal recursive mutex.
+     */
+    static std::recursive_mutex &mutex() { return instance().m_db_mutex; }
+
 private:
     // Private constructor so that no objects can be created.
     AgentDB() = default;
+
+    static AgentDB &instance()
+    {
+        // Guaranteed to be destroyed.
+        // Instantiated on first use.
+        static AgentDB db;
+        return db;
+    }
+
     std::recursive_mutex m_db_mutex;
     void db_lock() { m_db_mutex.lock(); }
     void db_unlock() { m_db_mutex.unlock(); }
