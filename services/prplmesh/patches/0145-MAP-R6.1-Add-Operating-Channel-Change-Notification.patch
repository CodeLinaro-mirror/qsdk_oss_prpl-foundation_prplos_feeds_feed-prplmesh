+    // class 81 for 2.4GHz 20MHz and op class 115 for 5GHz 20MHz). Saving directly from the
+    // received TLVs preserves all operating classes faithfully.
+    struct sOcrEntry {
+        sMacAddr radio_uid;
+        uint8_t tx_power;
+        std::vector<std::pair<uint8_t, uint8_t>> op_classes; // (operating_class, channel_number)
+    };
+    std::vector<sOcrEntry> ocr_entries;
+
     for (auto operating_channel_report_tlv :
          cmdu_rx.getClassList<wfa_map::tlvOperatingChannelReport>()) {
         auto &ruid    = operating_channel_report_tlv->radio_uid();
         auto tx_power = operating_channel_report_tlv->current_transmit_power();
 
+        // Save OCR data for OCCN broadcast
+        sOcrEntry entry;
+        entry.radio_uid = ruid;
+        entry.tx_power  = tx_power;
+
         /*
             Here need to remove the CurrentOperatingClass data from the Controller Data Model which
             was set in previous OPERATING_CHANNEL_REPORT_MESSAGE.
@@ -2676,6 +2699,9 @@ bool Controller::handle_cmdu_1905_operating_channel_report(const sMacAddr &src_m
             auto operating_class         = operating_class_struct.operating_class;
             auto channel                 = operating_class_struct.channel_number;
 
+            // Save this operating class for the OCCN broadcast
