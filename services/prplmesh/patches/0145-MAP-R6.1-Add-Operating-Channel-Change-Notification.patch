     }
 
-    return son_actions::send_cmdu_to_agent(src_mac, cmdu_tx, database);
+    if (!son_actions::send_cmdu_to_agent(src_mac, cmdu_tx, database)) {
+        LOG(ERROR) << "Failed to send ACK to agent " << src_mac;
+        return false;
+    }
+
+    // Broadcast OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE to all agents
+    // so they are informed about the channel change of the reporting agent.
+    auto reporting_agent = database.m_agents.get(src_mac);
+    if (reporting_agent) {
+        if (!cmdu_tx.create(0, ieee1905_1::eMessageType::OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE)) {
+            LOG(ERROR) << "Failed to create OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE for broadcast";
+            return true; // ACK was already sent successfully
+        }
+
+        // Add AL ID TLV identifying the agent whose channel info changed
+        auto al_mac_tx_tlv = cmdu_tx.addClass<ieee1905_1::tlvAlMacAddress>();
+        if (!al_mac_tx_tlv) {
+            LOG(ERROR) << "Failed to add tlvAlMacAddress to OCCN broadcast";
+            return true;
+        }
+        al_mac_tx_tlv->mac() = src_mac;
+
+        // Add Operating Channel Report TLVs using the data saved directly from the received OCR
+        // message. This preserves ALL operating classes faithfully, including multiple operating
+        // classes with the same bandwidth (e.g. 2.4GHz 20MHz and 5GHz 20MHz), which would be
+        // lost if we read from current_operating_class_profile (indexed by bandwidth).
+        for (const auto &entry : ocr_entries) {
+            if (entry.op_classes.empty()) {
+                LOG(DEBUG) << "OCCN broadcast: ruid=" << entry.radio_uid
+                           << " has no operating classes, skipping";
+                continue;
+            }
+
+            auto op_chan_tlv = cmdu_tx.addClass<wfa_map::tlvOperatingChannelReport>();
+            if (!op_chan_tlv) {
+                LOG(ERROR) << "Failed to add tlvOperatingChannelReport to OCCN broadcast";
+                continue;
+            }
+
+            op_chan_tlv->radio_uid()             = entry.radio_uid;
+            op_chan_tlv->current_transmit_power() = entry.tx_power;
+
+            if (!op_chan_tlv->alloc_operating_classes_list(
+                    static_cast<uint8_t>(entry.op_classes.size()))) {
+                LOG(ERROR) << "Failed to allocate operating_classes_list for OCCN broadcast";
+                continue;
+            }
+
+            for (size_t i = 0; i < entry.op_classes.size(); i++) {
+                auto op_class_tuple = op_chan_tlv->operating_classes_list(static_cast<uint8_t>(i));
+                if (!std::get<0>(op_class_tuple)) {
+                    LOG(ERROR) << "Failed to get operating_classes_list entry for OCCN broadcast";
+                    break;
+                }
+                auto &op_class_struct           = std::get<1>(op_class_tuple);
+                op_class_struct.operating_class = entry.op_classes[i].first;
+                op_class_struct.channel_number  = entry.op_classes[i].second;
+                LOG(DEBUG) << "OCCN broadcast: ruid=" << entry.radio_uid
+                           << " op_class=" << int(op_class_struct.operating_class)
+                           << " channel=" << int(op_class_struct.channel_number);
+            }
+        }
+
+        // Send OCCN to all connected agents except the one that sent the report
+        for (const auto &agent : database.get_all_connected_agents()) {
+            if (agent->al_mac == src_mac) {
+                continue; // Skip the reporting agent
+            }
+            LOG(DEBUG) << "Broadcasting OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE to agent "
+                       << agent->al_mac;
+            son_actions::send_cmdu_to_agent(agent->al_mac, cmdu_tx, database);
+        }
+    }
+
+    return true;
