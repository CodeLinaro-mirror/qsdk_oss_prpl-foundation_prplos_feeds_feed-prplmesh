     auto mid = cmdu_rx.getMessageId();
     LOG(INFO) << "Received OPERATING_CHANNEL_REPORT_MESSAGE, mid=" << std::dec << int(mid);
 
+    // Save the OCR data from the received message so we can forward the exact TLVs in the OCCN.
+    // We cannot read from cmdu_rx after cmdu_tx is used (ACK), so we save the data now.
+    // Note: current_operating_class_profile is indexed by bandwidth (one slot per 20/40/80/160/320
