+        ocr_entries.push_back(std::move(entry));
+
         if (operating_classes_list_length != 0) {
             if (beacon_channel != 0) {
                 auto tmp_bw = wireless_utils::get_bandwidth_from_channel_and_op_class(
@@ -2726,7 +2754,81 @@ bool Controller::handle_cmdu_1905_operating_channel_report(const sMacAddr &src_m
