+bool BackhaulManager::handle_operating_channel_change_notification(
+    ieee1905_1::CmduMessageRx &cmdu_rx, const sMacAddr &src_mac)
+{
+    auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE from " << src_mac
+              << ", mid=" << std::dec << int(mid);
+
+    // Parse the AL ID TLV to identify which agent's channel info is being reported
+    auto al_mac_tlv = cmdu_rx.getClass<ieee1905_1::tlvAlMacAddress>();
+    if (al_mac_tlv) {
+        LOG(DEBUG) << "OCCN: source agent AL MAC = " << al_mac_tlv->mac();
+    }
+
+    // Parse Operating Channel Report TLVs, log the channel info, and store in agent database
+    auto db = AgentDB::get();
+    for (auto op_chan_tlv : cmdu_rx.getClassList<wfa_map::tlvOperatingChannelReport>()) {
+        auto &ruid          = op_chan_tlv->radio_uid();
+        auto tx_power       = op_chan_tlv->current_transmit_power();
+        auto num_op_classes = op_chan_tlv->operating_classes_list_length();
+
+        uint8_t final_op_class = 0, final_chan_num = 0, beacon_channel = 0;
+        for (uint8_t oc = 0; oc < num_op_classes; oc++) {
+            auto op_class_tuple = op_chan_tlv->operating_classes_list(oc);
+            if (!std::get<0>(op_class_tuple)) {
+                LOG(ERROR) << "Failed to get operating class tuple";
+                break;
+            }
+            auto &op_class_struct = std::get<1>(op_class_tuple);
+            auto operating_class  = op_class_struct.operating_class;
+            auto channel          = op_class_struct.channel_number;
+
+            LOG(INFO) << "OCCN: ruid=" << ruid
+                      << " operating_class=" << int(operating_class)
+                      << " channel=" << int(channel)
+                      << " tx_power=" << int(tx_power);
+
+            if (operating_class > final_op_class) {
+                final_op_class = operating_class;
+                final_chan_num = channel;
+            }
+
+            // Track the 20MHz beacon channel for primary channel identification
+            if (son::wireless_utils::get_bandwidth_from_op_class(operating_class) ==
+                beerocks::eWiFiBandwidth::BANDWIDTH_20) {
+                beacon_channel = channel;
+            }
+        }
+
+        // Store channel info in agent database
+        if (num_op_classes != 0 && beacon_channel != 0) {
+            auto radio = db->get_radio_by_mac(ruid, AgentDB::eMacType::RADIO);
+            if (radio) {
+                auto tmp_bw = son::wireless_utils::get_bandwidth_from_channel_and_op_class(
+                    final_chan_num, final_op_class);
+                auto new_wifi_channel = beerocks::WifiChannel(
+                    beacon_channel,
+                    son::wireless_utils::which_freq_op_cls(final_op_class),
+                    tmp_bw, false);
+                radio->wifi_channel = new_wifi_channel;
+                LOG(INFO) << "OCCN: Stored channel info for ruid=" << ruid
+                          << " channel=" << int(beacon_channel)
+                          << " op_class=" << int(final_op_class)
+                          << " bandwidth=" << int(tmp_bw);
+            } else {
+                LOG(DEBUG) << "OCCN: Radio with RUID=" << ruid
+                           << " not found in local database, skipping storage";
+            }
+        }
+    }
+
+    // Send ACK back to the controller
+    return send_ack_to_controller(cmdu_tx, mid);
+}
+
+bool BackhaulManager::handle_operating_channel_query(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                     const sMacAddr &src_mac)
+{
+    auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received OPERATING_CHANNEL_QUERY_MESSAGE from " << src_mac
+              << ", mid=" << std::dec << int(mid);
+
+    auto db = AgentDB::get();
+
+    // Helper lambda to send Error Response with reason code UNKNOWN_AGENT (0x0F)
+    auto send_error_response = [&]() -> bool {
+        if (!cmdu_tx.create(0, ieee1905_1::eMessageType::ERROR_RESPONSE_MESSAGE)) {
+            LOG(ERROR) << "Failed to create ERROR_RESPONSE_MESSAGE for OCQ";
+            return false;
+        }
+        auto error_tlv = cmdu_tx.addClass<wfa_map::tlvProfile2ErrorCode>();
+        if (!error_tlv) {
+            LOG(ERROR) << "Failed to add tlvProfile2ErrorCode to ERROR_RESPONSE_MESSAGE";
+            return false;
+        }
+        error_tlv->reason_code() = wfa_map::tlvProfile2ErrorCode::eReasonCode::UNKNOWN_AGENT;
+        if (!send_cmdu_to_broker(cmdu_tx, db->controller_info.bridge_mac, db->bridge.mac)) {
+            LOG(ERROR) << "Failed to send ERROR_RESPONSE_MESSAGE to controller";
+            return false;
+        }
+        return true;
+    };
+
+    // Parse the AL MAC TLV from the OCQ message
+    auto al_mac_tlv = cmdu_rx.getClass<ieee1905_1::tlvAlMacAddress>();
+    if (!al_mac_tlv) {
+        LOG(ERROR) << "Failed to get tlvAlMacAddress from OPERATING_CHANNEL_QUERY_MESSAGE";
+        return false;
+    }
+
+    const sMacAddr req_al_mac = al_mac_tlv->mac();
+    LOG(DEBUG) << "OCQ: requested AL MAC = " << req_al_mac;
+
+    // Check if the AL MAC matches this agent's own AL MAC (bridge MAC)
+    if (req_al_mac != db->bridge.mac) {
+        LOG(WARNING) << "OCQ: requested AL MAC " << req_al_mac
+                     << " does not match this agent's AL MAC " << db->bridge.mac
+                     << " - sending Error Response (0x0F)";
+        return send_error_response();
+    }
+
+    // Check if this agent has any radios in operation
+    const auto &radios = db->get_radios_list();
+    bool has_operational_radios = false;
+    for (const auto *radio : radios) {
+        if (radio && !radio->wifi_channel.is_empty()) {
+            has_operational_radios = true;
+            break;
+        }
+    }
+
+    if (!has_operational_radios) {
+        LOG(WARNING) << "OCQ: agent has no radios in operation"
+                     << " - sending Error Response (0x0F)";
+        return send_error_response();
+    }
+
+    // Build OPERATING_CHANNEL_REPORT_MESSAGE with current operating parameters for each radio
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::OPERATING_CHANNEL_REPORT_MESSAGE)) {
+        LOG(ERROR) << "Failed to create OPERATING_CHANNEL_REPORT_MESSAGE for OCQ response";
+        return false;
+    }
+
+    for (const auto *radio : radios) {
+        if (!radio || radio->wifi_channel.is_empty()) {
+            LOG(DEBUG) << "OCQ: skipping radio with no channel info";
+            continue;
+        }
+
+        if (!tlvf_utils::create_operating_channel_report(cmdu_tx, radio->front.iface_mac)) {
+            LOG(ERROR) << "OCQ: Failed to add Operating Channel Report TLV for radio "
+                       << radio->front.iface_mac;
+            return false;
+        }
+
+        LOG(DEBUG) << "OCQ: Added OCR TLV for radio " << radio->front.iface_mac
+                   << " channel=" << int(radio->wifi_channel.get_channel());
+    }
+
+    // Send OCR back to the controller
+    if (!send_cmdu_to_broker(cmdu_tx, db->controller_info.bridge_mac, db->bridge.mac)) {
+        LOG(ERROR) << "OCQ: Failed to send OPERATING_CHANNEL_REPORT_MESSAGE to controller";
+        return false;
+    }
+
+    LOG(INFO) << "OCQ: Sent OPERATING_CHANNEL_REPORT_MESSAGE to controller";
+    return true;
+}
