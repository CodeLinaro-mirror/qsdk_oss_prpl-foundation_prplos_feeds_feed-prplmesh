+bool Controller::handle_cmdu_1905_operating_channel_query(const sMacAddr &src_mac,
+                                                          ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received OPERATING_CHANNEL_QUERY_MESSAGE from " << src_mac
+              << ", mid=" << std::dec << int(mid);
+
+    // Parse the AL ID TLV to get the requested agent's AL MAC address
+    auto al_mac_tlv = cmdu_rx.getClass<ieee1905_1::tlvAlMacAddress>();
+    if (!al_mac_tlv) {
+        LOG(ERROR) << "Failed to get tlvAlMacAddress from OPERATING_CHANNEL_QUERY_MESSAGE";
+        return false;
+    }
+
+    const sMacAddr req_al_mac = al_mac_tlv->mac();
+    LOG(DEBUG) << "OCQ: requested agent AL MAC = " << req_al_mac;
+
+    // Look up the requested agent in the database
+    auto req_agent = database.m_agents.get(req_al_mac);
+    if (!req_agent) {
+        LOG(WARNING) << "OCQ: requested agent " << req_al_mac << " not found in database"
+                     << " - sending Error Response with reason code UNKNOWN_AGENT (0x0F)";
+
+        // Send Error Response with Reason Code 0x0F (UNKNOWN_AGENT)
+        if (!cmdu_tx.create(0, ieee1905_1::eMessageType::ERROR_RESPONSE_MESSAGE)) {
+            LOG(ERROR) << "Failed to create ERROR_RESPONSE_MESSAGE for OCQ";
+            return false;
+        }
+        auto error_tlv = cmdu_tx.addClass<wfa_map::tlvProfile2ErrorCode>();
+        if (!error_tlv) {
+            LOG(ERROR) << "Failed to add tlvProfile2ErrorCode to ERROR_RESPONSE_MESSAGE";
+            return false;
+        }
+        error_tlv->reason_code() = wfa_map::tlvProfile2ErrorCode::eReasonCode::UNKNOWN_AGENT;
+        if (!son_actions::send_cmdu_to_agent(src_mac, cmdu_tx, database)) {
+            LOG(ERROR) << "Failed to send ERROR_RESPONSE_MESSAGE to agent " << src_mac;
+            return false;
+        }
+        return true;
+    }
+
+    // Per spec: if the controller has not yet received an Operating Channel Report from the
+    // requested agent, respond with Error Response (Reason Code 0x0F).
+    bool has_ocr = false;
+    for (auto &radio_entry : req_agent->radios) {
+        auto &radio = radio_entry.second;
+        if (radio && !radio->wifi_channel.is_empty()) {
+            has_ocr = true;
+            break;
+        }
+    }
+    if (!has_ocr) {
+        LOG(WARNING) << "OCQ: no Operating Channel Report received yet from agent " << req_al_mac
+                     << " - sending Error Response with reason code UNKNOWN_AGENT (0x0F)";
+        if (!cmdu_tx.create(0, ieee1905_1::eMessageType::ERROR_RESPONSE_MESSAGE)) {
+            LOG(ERROR) << "Failed to create ERROR_RESPONSE_MESSAGE for OCQ (no OCR)";
+            return false;
+        }
+        auto error_tlv = cmdu_tx.addClass<wfa_map::tlvProfile2ErrorCode>();
+        if (!error_tlv) {
+            LOG(ERROR) << "Failed to add tlvProfile2ErrorCode to ERROR_RESPONSE_MESSAGE";
+            return false;
+        }
+        error_tlv->reason_code() = wfa_map::tlvProfile2ErrorCode::eReasonCode::UNKNOWN_AGENT;
+        if (!son_actions::send_cmdu_to_agent(src_mac, cmdu_tx, database)) {
+            LOG(ERROR) << "Failed to send ERROR_RESPONSE_MESSAGE to agent " << src_mac;
+            return false;
+        }
+        return true;
+    }
+
+    // Build OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE to send back to the requesting agent
+    if (!cmdu_tx.create(
+            0, ieee1905_1::eMessageType::OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE)) {
+        LOG(ERROR) << "Failed to create OPERATING_CHANNEL_CHANGE_NOTIFICATION_MESSAGE";
+        return false;
+    }
+
+    // Add AL ID TLV identifying the agent whose channel info is being reported
+    auto al_mac_tx_tlv = cmdu_tx.addClass<ieee1905_1::tlvAlMacAddress>();
+    if (!al_mac_tx_tlv) {
+        LOG(ERROR) << "Failed to add tlvAlMacAddress to OCCN";
+        return false;
+    }
+    al_mac_tx_tlv->mac() = req_al_mac;
+
+    // Add Operating Channel Report TLVs for each radio of the requested agent.
+    // Use the stored current_operating_class_profile entries to include all operating
+    // classes as received in the latest Operating Channel Report message.
+    for (auto &radio_entry : req_agent->radios) {
+        auto &radio = radio_entry.second;
+        if (!radio || radio->wifi_channel.is_empty()) {
+            LOG(DEBUG) << "OCQ: radio " << radio_entry.first
+                       << " has no channel info, skipping";
+            continue;
+        }
+
+        // Count non-empty operating class profiles for this radio
+        uint8_t num_op_classes = 0;
+        for (int i = 0; i < Agent::operatingClassProfileIndex::OPERATING_CLASS_MAX_BW; i++) {
+            if (radio->current_operating_class_profile[i].op_class != 0) {
+                num_op_classes++;
+            }
+        }
+        if (num_op_classes == 0) {
+            LOG(DEBUG) << "OCQ: radio " << radio_entry.first
+                       << " has no stored operating class profiles, skipping";
+            continue;
+        }
+
+        auto op_chan_tlv = cmdu_tx.addClass<wfa_map::tlvOperatingChannelReport>();
+        if (!op_chan_tlv) {
+            LOG(ERROR) << "Failed to add tlvOperatingChannelReport";
+            return false;
+        }
+
+        op_chan_tlv->radio_uid()             = radio->radio_uid;
+        op_chan_tlv->current_transmit_power() = static_cast<uint8_t>(radio->tx_power);
+
+        if (!op_chan_tlv->alloc_operating_classes_list(num_op_classes)) {
+            LOG(ERROR) << "Failed to allocate operating_classes_list";
+            return false;
+        }
+
+        uint8_t oc_idx = 0;
+        for (int i = 0; i < Agent::operatingClassProfileIndex::OPERATING_CLASS_MAX_BW; i++) {
+            if (radio->current_operating_class_profile[i].op_class == 0) {
+                continue;
+            }
+            auto op_class_tuple = op_chan_tlv->operating_classes_list(oc_idx++);
+            if (!std::get<0>(op_class_tuple)) {
+                LOG(ERROR) << "Failed to get operating_classes_list entry";
+                break;
+            }
+            auto &op_class_struct           = std::get<1>(op_class_tuple);
+            op_class_struct.operating_class = radio->current_operating_class_profile[i].op_class;
+            op_class_struct.channel_number  = radio->current_operating_class_profile[i].channel;
+            LOG(DEBUG) << "OCQ: radio " << radio->radio_uid
+                       << " op_class=" << int(op_class_struct.operating_class)
+                       << " channel=" << int(op_class_struct.channel_number);
+        }
+    }
+
+    // Send OCCN back to the requesting agent
+    if (!son_actions::send_cmdu_to_agent(src_mac, cmdu_tx, database)) {
+        LOG(ERROR) << "Failed to send OCCN to agent " << src_mac;
+        return false;
+    }
+
+    return true;
+}
+
 } // namespace son
