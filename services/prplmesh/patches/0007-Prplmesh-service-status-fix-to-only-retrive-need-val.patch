+# Note: Apparently on some Linux version space is added to the process name.
+# Therefore added "($|[[:blank:]])" to the end of the regex expression which means the end of the
+# line ($) or blank character ([[:blank:]])
+
+
+main_agent_flag=1     # assume failure
+radio_agent_flag=1
+
+main_agent_operational() {
+    log_dir="$1"
+
+    log_files=$(ls -1t "$log_dir"/beerocks_backhaul.*.log 2>/dev/null)
+    pgrep -fl beerocks_agent > /dev/null 2>&1 || { main_agent_flag=1; return 1; }
+
+    for file in $log_files; do
+        op_line=$(grep -n ' --> OPERATIONAL' "$file" | tail -n1 | cut -d: -f1)
+        if [ -n "$op_line" ]; then
+            if ( tail -n +"$((op_line + 1))" "$file" 2>/dev/null | grep -q "Caught signal 'Terminated'" ); then
+                main_agent_flag=1
+                return 1
+            fi
+
+            if ( tail -n +"$((op_line + 1))" "$file" 2>/dev/null | grep -q "OPERATIONAL -->" ); then
+                main_agent_flag=1
+                return 1
+            fi
+
+            start_checking=0
+            for next_file in $log_files; do
+                if [ "$start_checking" -eq 0 ]; then
+                    [ "$next_file" = "$file" ] && start_checking=1
+                    continue
+                fi
+                if grep -q "Caught signal 'Terminated'" "$next_file"; then
+                    main_agent_flag=1
+                    return 1
+                fi
+                if grep -q "OPERATIONAL -->" "$next_file"; then
+                    main_agent_flag=1
+                    return 1
+                fi
+            done
+
+            # Found OPERATIONAL with no termination or transition after — success
+            main_agent_flag=0
+            return 0
+        fi
+    done
 
