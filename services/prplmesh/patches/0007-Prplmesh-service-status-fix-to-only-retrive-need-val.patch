+prplmesh_platform_db_init() {
+    management_mode=${1-Multi-AP-Controller-and-Agent}
+    operating_mode=${2-Gateway}
+
+    mkdir -p @TMP_PATH@
+
+    # Put generated prplmesh_platform_db file to the temporary directory
