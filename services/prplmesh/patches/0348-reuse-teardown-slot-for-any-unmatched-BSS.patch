From fe77e9c303d12272360cd32a5167ce31853afa24 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Tue, 18 Aug 2026 09:59:07 +0530
Subject: [PATCH] ap_autoconfig: reuse teardown slot for any unmatched BSS on
 role change

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 28 +++++++++++++++----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 2425eedbb..996ac8db2 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -1057,6 +1057,7 @@ void ApAutoConfigurationTask::configuration_complete_wait_action(const std::stri
     // if after onboarding the agent is not operating correctly, debug by reading the datamodel
 
     // num_of_bss_available updates on ACTION_APMANAGER_WIFI_CREDENTIALS_UPDATE_RESPONSE handler
+
     if (!radio_conf_params.num_of_bss_available) {
         return;
     }
@@ -5621,9 +5622,18 @@ bool ApAutoConfigurationTask::handle_bss_reconfiguration(
     // ----------------------------------------------------------
     for (auto &remaining_bss : unmatched_requested_bss) {
 
-        // Reuse an existing TEARDOWN slot ONLY when requested vap_type is OTHER.
-        if (remaining_bss.m2_config.vap_type == eVapType::OTHER) {
-
+        // Reuse an existing TEARDOWN slot for any unmatched requested BSS.
+        //
+        // Previously this was gated on vap_type == OTHER, but that prevented the
+        // common case where a radio already has a FH VAP and the controller sends a
+        // BH BSS in M2: Pass 1 (strict) and Pass 2 (similarity) both reject the pair
+        // due to the FH/BH role-mismatch guards, so the FH VAP ends up in the teardown
+        // list and the BH BSS ends up here as an unmatched remainder. Without this fix
+        // the agent would tear down the existing VAP and create a brand-new one with a
+        // WILD_MAC BSSID, causing unnecessary hostapd interface churn. By reusing the
+        // teardown slot we pin the existing BSSID to the new BSS config so the HAL can
+        // reconfigure the VAP in-place regardless of the role change.
+        {
             // Find if there are any BSSs that are pending for teardown
             auto iter = std::find_if(
                 reconfig_bss_list.begin(), reconfig_bss_list.end(), [](const sBssConfig &info) {
@@ -5632,9 +5642,15 @@ bool ApAutoConfigurationTask::handle_bss_reconfiguration(
                 });
 
             if (iter != reconfig_bss_list.end()) {
-                // Override BSS parameters (reuse existing BSSID, keep existing vap_type from teardown)
+                // Override BSS parameters: reuse the existing BSSID from the teardown slot
+                // and apply all requested BSS settings (including vap_type and vap_label)
+                // from the unmatched requested BSS. This correctly reconfigures the VAP
+                // in-place with the new role/credentials without tearing it down.
                 LOG(DEBUG) << "BSS " << iter->payload_config.bssid
-                           << " will be reconfigured instead of being torn down (vap_type OTHER).";
+                           << " will be reconfigured instead of being torn down"
+                           << " (ssid=" << remaining_bss.payload_config.ssid
+                           << " vap_type=" << remaining_bss.m2_config.vap_type
+                           << " vap_label=" << remaining_bss.m2_config.vap_label << ").";
 
                 iter->payload_config.ssid        = remaining_bss.payload_config.ssid;
                 iter->payload_config.auth_type   = remaining_bss.payload_config.auth_type;
@@ -5642,6 +5658,8 @@ bool ApAutoConfigurationTask::handle_bss_reconfiguration(
                 iter->payload_config.network_key = remaining_bss.payload_config.network_key;
                 iter->payload_config.bss_type    = remaining_bss.payload_config.bss_type;
                 iter->m2_config.hidden_ssid      = remaining_bss.m2_config.hidden_ssid;
+                iter->m2_config.vap_type         = remaining_bss.m2_config.vap_type;
+                iter->m2_config.vap_label        = remaining_bss.m2_config.vap_label;
                 iter->additional_auth            = remaining_bss.additional_auth;
                 iter->mld_id                     = remaining_bss.mld_id;
 
-- 
