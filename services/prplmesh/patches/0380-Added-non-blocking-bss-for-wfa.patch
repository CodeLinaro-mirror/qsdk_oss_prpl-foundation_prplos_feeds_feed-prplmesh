From 795917fc2fdd6df62b6d7d880b27aadf41f6d6ed Mon Sep 17 00:00:00 2001
From: amalganesh <amalgane@qti.qualcomm.com>
Date: Fri, 4 Sep 2026 11:46:28 +0530
Subject: [PATCH] Added non blocking bss for wfa

Signed-off-by: amalganesh <amalgane@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp   | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index ae20e71..b2dd903 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2901,6 +2901,11 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
                 return !static_cast<bool>(info.payload_config.bss_type &
                                            WSC::eWscVendorExtSubelementBssType::TEARDOWN);
             });
+        if (!has_real_bss && db->device_conf.certification_mode) {
+             has_real_bss = std::any_of(
+                radio->front.bssids.begin(), radio->front.bssids.end(),
+                [](const beerocks::AgentDB::sRadio::sFront::sBssid &b) { return b.active; });
+        }
 
         send_radio_disable_request_if_no_real_bss();
 
@@ -5950,6 +5955,18 @@ bool ApAutoConfigurationTask::handle_bss_reconfiguration(
                          << "Suppressing this M2 reconfiguration to avoid orphaning the radio "
                          << "and triggering beerocks_agent self-kill in STATE_JOIN_INIT.";
 
+            // The suppressed M2 never reaches ap_manager, so the only round trip that would normally
+            // refresh num_of_bss_available/enabled_bssids never happens. Reconcile directly from the
+            // live AgentDB state instead, the same way handle_vs_vaps_list_update_notification() does.
+            auto &radio_conf_params = m_radios_conf_params[radio_iface];
+            radio_conf_params.num_of_bss_available = static_cast<uint8_t>(local_active_count);
+            radio_conf_params.enabled_bssids.clear();
+            for (const auto &b : radio->front.bssids) {
+                 if (b.active) {
+                    radio_conf_params.enabled_bssids.insert(b.mac);
+                 }
+            }
+
             // Clear requested list so the caller skips
             // send_ap_bss_configuration_message() (it gates on bss_infos.empty()).
             requested_bss_list.clear();
-- 
