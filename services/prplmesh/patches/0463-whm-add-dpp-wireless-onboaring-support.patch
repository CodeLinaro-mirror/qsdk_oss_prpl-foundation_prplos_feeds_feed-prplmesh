+// LIST_NETWORKS reports escaped SSIDs. An unrecognized representation is a
+// mismatch: recovery must never fall back to another saved network.
+static bool select_current_dpp_network(const std::string &networks, const std::string &ssid,
+                                       uint32_t &network_id)
+{
+    bool found = false;
+    std::istringstream stream(networks);
+    std::string line;
+    std::getline(stream, line); // header
+    while (std::getline(stream, line)) {
+        auto id_end   = line.find('\t');
+        auto ssid_end = line.find('\t', id_end == std::string::npos ? 0 : id_end + 1);
+        auto bssid_end = line.find('\t', ssid_end == std::string::npos ? 0 : ssid_end + 1);
+        if (id_end == std::string::npos || ssid_end == std::string::npos ||
+            bssid_end == std::string::npos ||
+            line.find("[CURRENT]", bssid_end + 1) == std::string::npos) {
+            continue;
+        }
+        if (found || id_end == 0 || line.substr(id_end + 1, ssid_end - id_end - 1) != ssid) {
+            return false;
+        }
+        uint32_t id = 0;
+        for (size_t i = 0; i < id_end; ++i) {
+            if (line[i] < '0' || line[i] > '9' ||
+                id > (uint32_t(std::numeric_limits<int>::max()) - (line[i] - '0')) / 10) {
+                return false;
+            }
+            id = id * 10 + (line[i] - '0');
+        }
+        network_id = id;
+        found      = true;
+    }
+    return found;
+}
+
+static bool normalize_dpp_network_value(std::string &value, bool hex)
+{
+    auto end = value.find_last_not_of("\r\n");
+    value.erase(end == std::string::npos ? 0 : end + 1);
+    if (value.size() >= 2 && value.front() == '"' && value.back() == '"') {
+        value = value.substr(1, value.size() - 2);
+    }
+    if (value.empty() || value.compare(0, 4, "FAIL") == 0) {
+        return false;
+    }
+    if (hex) {
+        return value.size() % 2 == 0 &&
+               value.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos;
+    }
+    const auto first_dot = value.find('.');
+    const auto last_dot  = value.rfind('.');
+    return first_dot != std::string::npos && first_dot > 0 && last_dot > first_dot + 1 &&
+           last_dot + 1 < value.size() && value.find('.', first_dot + 1) == last_dot &&
+           value.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.") ==
+               std::string::npos;
+}
