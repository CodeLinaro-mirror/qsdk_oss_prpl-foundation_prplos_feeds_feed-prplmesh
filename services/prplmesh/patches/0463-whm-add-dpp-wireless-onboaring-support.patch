+bool BackhaulManager::is_dpp_recovery_active() const
+{
+    auto db = AgentDB::get();
+    if (!FSM_IS_IN_STATE(WAIT_WPS) ||
+        db->dpp_extender_config.onboarding_type != AgentDB::OnboardingType::DPP ||
+        !db->dpp_bootstrap.valid) {
+        return false;
+    }
+    return std::any_of(m_radios_info.begin(), m_radios_info.end(), [](const auto &radio_info) {
+        return radio_info && radio_info->sta_hal_initialized && radio_info->sta_wlan_hal &&
+               radio_info->dpp_bootstrap_injected && !radio_info->dpp_provisioning_done &&
+               !radio_info->radio_disabled &&
+               !radio_info->sta_wlan_hal->is_connected();
+    });
+}
+
+void BackhaulManager::handle_dpp_onboarding_timeout()
+{
+    const auto now = std::chrono::steady_clock::now();
+    bool active = false;
+    for (const auto &radio_info : m_radios_info) {
+        if (!radio_info || !radio_info->sta_hal_initialized || !radio_info->sta_wlan_hal ||
+            !radio_info->dpp_bootstrap_injected || radio_info->dpp_provisioning_done ||
+            radio_info->radio_disabled ||
+            radio_info->sta_wlan_hal->is_connected()) {
+            continue;
+        }
+        active = true;
+        ++radio_info->dpp_recovery_attempts;
+        if (radio_info->dpp_recovery_attempts >= dpp_setup_max_attempts) {
+            LOG(WARNING) << "DPP: onboarding progress stalled on " << radio_info->sta_iface
+                         << " after " << radio_info->dpp_recovery_attempts
+                         << " recovery windows; restarting FSM";
+            for (const auto &r : m_radios_info) {
+                cancel_dpp_chirp_timer(r);
+            }
+            FSM_MOVE_STATE(RESTART);
+            return;
+        }
+        LOG(WARNING) << "DPP: onboarding progress window expired on " << radio_info->sta_iface
+                     << ", retry=" << radio_info->dpp_recovery_attempts << "/"
+                     << dpp_setup_max_attempts;
+        arm_dpp_chirp_timer(radio_info, dpp_chirp_fail_retry_delay);
+    }
+    if (active) {
+        m_dpp_progress_deadline = now + dpp_progress_timeout;
+    }
+}
