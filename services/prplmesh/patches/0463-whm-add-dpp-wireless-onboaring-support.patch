+static bool is_dpp_mac_string(const std::string &mac)
+{
+    if (mac.size() != 17) {
+        return false;
+    }
+    for (size_t i = 0; i < mac.size(); ++i) {
+        if (i % 3 == 2 ? mac[i] != ':' : !is_dpp_hex_digit(mac[i])) {
+            return false;
+        }
