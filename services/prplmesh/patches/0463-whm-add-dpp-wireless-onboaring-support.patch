+bool slave_wlan_hal_whm::deliver_dpp_event(hal_event_ptr_t event,
+                                          const hal_event_cb_t &callback)
+{
+    // The Ambiorix and HAL event queues can advance independently. Keep the
+    // generation delivered to the task separate from the latest provider state.
+    const auto type = static_cast<Event>(event->first);
+    if ((type == Event::Dpp_Client_Connected || type == Event::Dpp_Client_Disconnected) &&
+        std::static_pointer_cast<sRelayClientEvent>(event->second)->epoch != m_dpp_epoch) {
+        return true;
+    }
+    if (type == Event::Dpp_Client_Connected) {
+        const auto generation = std::static_pointer_cast<sRelayClientEvent>(event->second)->session_id;
+        if (m_dpp_delivery_session_id && m_dpp_delivery_session_id != generation) {
+            callback(std::make_shared<hal_event_t>(int(Event::Dpp_Client_Disconnected), nullptr));
+        }
+        m_dpp_delivery_session_id = generation;
+    } else if (type == Event::Dpp_Client_Disconnected) {
+        const auto generation = std::static_pointer_cast<sRelayClientEvent>(event->second)->session_id;
+        if (generation < m_dpp_delivery_session_id) {
+            return true;
+        }
+        m_dpp_delivery_session_id = 0;
+    } else if (type == Event::Dpp_Frame_Received) {
+        auto frame = std::static_pointer_cast<sRelayFrameEvent>(event->second);
+        // pWHM drains complete frames before reporting EOF in the same bus read.
+        // Those frames (notably Configuration Result) belong to the delivered
+        // session even if the latest provider state is already disconnected.
+        if (frame->epoch != m_dpp_epoch ||
+            frame->session_id != m_dpp_delivery_session_id) {
+            return true;
+        }
+        event = std::make_shared<hal_event_t>(event->first,
+                                             std::static_pointer_cast<sDppFrameEvent>(frame));
+    }
+    return callback(event);
 }
 
