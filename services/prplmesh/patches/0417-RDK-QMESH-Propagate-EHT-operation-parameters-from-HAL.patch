From a04396521856df64937e34ac640fd27db2cc8ed4 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Thu, 10 Sep 2026 13:39:13 +0530
Subject: [PATCH] [RDK][QMESH] Propagate EHT operation parameters from HAL to
 AgentDB

Add end-to-end handling of EHT Operations TLV parameters across
AP Manager and AgentDB for RDK builds.

Changes:
- Extend APMANAGER_JOINED_NOTIFICATION with EHT operation
  parameters and validity indication.
- Retrieve EHT operation information from HAL during AP join
  and include it in the joined notification.
- Save EHT operation parameters into AgentDB BSS entries to
  ensure EHT Operations TLV data is available before any
  Channel Selection Request is received.
- Apply complete EHT operation settings received from the
  controller (MCS/NSS set, control, CCFS0/CCFS1, puncturing
  bitmap, and operation flags) through the AP HAL interface.
- Add AP HAL APIs to get/set EHT operation parameters with
  default no-op implementations for non-supported platforms.

Impact:
- Enables accurate population and propagation of EHT
  Operations TLV data in early AP capability reporting.
- Ensures controller-provided EHT operation settings are
  reflected in the underlying WLAN HAL configuration.

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 44 ++++++++++++++++++
 agent/src/beerocks/slave/son_slave_thread.cpp | 45 +++++++++++++++++++
 agent/src/beerocks/slave/son_slave_thread.h   | 12 +++++
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h | 36 +++++++++++++++
 .../tlvf/beerocks_message_apmanager.yaml      |  2 +
 5 files changed, 139 insertions(+)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index d0ef78fcc..d5c5b7c18 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1634,6 +1634,27 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                     request->eo_params().disabled_subchannel_bitmap)) {
                 LOG(ERROR) << "set_disabled_subchannels Failed";
             }
+
+#ifdef BEEROCKS_RDKB
+            // Apply full EHT operation parameters (MCS-NSS, control, ccfs, flags)
+            {
+                const auto &src = request->eo_params();
+                son::wireless_utils::sEhtOperationParams wl_eo = {};
+                wl_eo.eht_operation_information_valid     = src.eht_operation_information_valid;
+                wl_eo.disabled_subchannel_valid           = src.disabled_subchannel_valid;
+                wl_eo.eht_default_pe_duration             = src.eht_default_pe_duration;
+                wl_eo.group_addressed_bu_indication_limit = src.group_addressed_bu_indication_limit;
+                wl_eo.group_addressed_bu_indication_exponent = src.group_addressed_bu_indication_exponent;
+                wl_eo.basic_eht_mcs_and_nss_set           = src.basic_eht_mcs_and_nss_set;
+                wl_eo.control                             = src.control;
+                wl_eo.ccfs0                               = src.ccfs0;
+                wl_eo.ccfs1                               = src.ccfs1;
+                wl_eo.disabled_subchannel_bitmap          = src.disabled_subchannel_bitmap;
+                if (!ap_wlan_hal->set_eht_operation_params(wl_eo)) {
+                    LOG(ERROR) << "set_eht_operation_params Failed";
+                }
+            }
+#endif // BEEROCKS_RDKB
         }
 
         // Set transmit power
@@ -4953,6 +4974,29 @@ void ApManager::handle_hostapd_attached()
 
     fill_cs_params(notification->cs_params());
 
+#ifdef BEEROCKS_RDKB
+    if (ap_wlan_hal->get_radio_info().eht_supported) {
+        uint8_t ops_valid = 0;
+        son::wireless_utils::sEhtOperationParams wl_eo_params = {};
+        ap_wlan_hal->get_eht_operation_params(wl_eo_params, ops_valid);
+        if (ops_valid) {
+            auto &dst                               = notification->eo_params();
+            dst.eht_operation_information_valid     = wl_eo_params.eht_operation_information_valid;
+            dst.disabled_subchannel_valid           = wl_eo_params.disabled_subchannel_valid;
+            dst.eht_default_pe_duration             = wl_eo_params.eht_default_pe_duration;
+            dst.group_addressed_bu_indication_limit = wl_eo_params.group_addressed_bu_indication_limit;
+            dst.group_addressed_bu_indication_exponent = wl_eo_params.group_addressed_bu_indication_exponent;
+            dst.basic_eht_mcs_and_nss_set           = wl_eo_params.basic_eht_mcs_and_nss_set;
+            dst.control                             = wl_eo_params.control;
+            dst.ccfs0                               = wl_eo_params.ccfs0;
+            dst.ccfs1                               = wl_eo_params.ccfs1;
+            dst.disabled_subchannel_bitmap          = wl_eo_params.disabled_subchannel_bitmap;
+        }
+        notification->eht_operation_valid() = ops_valid;
+        LOG(DEBUG) << "JOINED_NOTIFICATION: eht_operation_valid=" << int(ops_valid);
+    }
+#endif // BEEROCKS_RDKB
+
     auto channel_list_class = notification->create_channel_list();
     build_channels_list(cmdu_tx, ap_wlan_hal->get_radio_info().channels_list, channel_list_class);
     notification->add_channel_list(channel_list_class);
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index b1bc41ee4..2199c7e2c 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4255,6 +4255,10 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         radio->frequency_band = notification->params().frequency_band;
 
         save_channel_params_to_db(fronthaul_iface, notification->cs_params());
+#ifdef BEEROCKS_RDKB
+        save_eht_ops_to_db(fronthaul_iface, notification->eo_params(),
+                           notification->eht_operation_valid());
+#endif // BEEROCKS_RDKB
         if (notification->params().frequency_band != radio->wifi_channel.get_freq_type()) {
             LOG(ERROR) << "Radio wifi channel's frequncy types does not match the frequency type "
                           "of ACTION_APMANAGER_JOINED_NOTIFICATION message";
@@ -8346,6 +8350,47 @@ void slave_thread::save_channel_params_to_db(const std::string &fronthaul_iface,
     }
 }
 
+#ifdef BEEROCKS_RDKB
+void slave_thread::save_eht_ops_to_db(const std::string &fronthaul_iface,
+                                       const beerocks_message::sEhtOperationParams &eo_params,
+                                       uint8_t eht_operation_valid)
+{
+    auto db    = AgentDB::get();
+    auto radio = db->radio(fronthaul_iface);
+    if (!radio || !eht_operation_valid) {
+        return;
+    }
+
+    LOG(DEBUG) << "save_eht_ops_to_db: iface=" << fronthaul_iface
+               << " mcs_nss=0x" << std::hex << eo_params.basic_eht_mcs_and_nss_set
+               << " ctrl=0x" << (unsigned)eo_params.control
+               << " ccfs0=" << std::dec << (unsigned)eo_params.ccfs0
+               << " ccfs1=" << (unsigned)eo_params.ccfs1
+               << " punct=0x" << std::hex << eo_params.disabled_subchannel_bitmap
+               << std::dec;
+
+    for (auto &bss : radio->front.bssids) {
+        auto eht_ops = reinterpret_cast<beerocks::net::sEHTOperations *>(&bss.eht_operations);
+        eht_ops->operation_parameters.eht_operation_information_valid =
+            eo_params.eht_operation_information_valid;
+        eht_ops->operation_parameters.disabled_subchannel_valid =
+            eo_params.disabled_subchannel_valid;
+        eht_ops->operation_parameters.eht_default_pe_duration =
+            eo_params.eht_default_pe_duration;
+        eht_ops->operation_parameters.group_addressed_bu_indication_limit =
+            eo_params.group_addressed_bu_indication_limit;
+        eht_ops->operation_parameters.group_addressed_bu_indication_exponent =
+            eo_params.group_addressed_bu_indication_exponent;
+        eht_ops->basic_eht_mcs_and_nss_set = eo_params.basic_eht_mcs_and_nss_set;
+        eht_ops->operation_informations.control = eo_params.control;
+        eht_ops->operation_informations.ccfs0   = eo_params.ccfs0;
+        eht_ops->operation_informations.ccfs1   = eo_params.ccfs1;
+        eht_ops->operation_informations.disabled_subchannel_bitmap =
+            eo_params.disabled_subchannel_bitmap;
+    }
+}
+#endif // BEEROCKS_RDKB
+
 void slave_thread::save_cac_capabilities_params_to_db(const std::string &fronthaul_iface)
 {
     auto db    = AgentDB::get();
diff --git a/agent/src/beerocks/slave/son_slave_thread.h b/agent/src/beerocks/slave/son_slave_thread.h
index 1305c3ec0..607b94f3a 100644
--- a/agent/src/beerocks/slave/son_slave_thread.h
+++ b/agent/src/beerocks/slave/son_slave_thread.h
@@ -797,6 +797,18 @@ private:
     void save_channel_params_to_db(const std::string &fronthaul_iface,
                                    beerocks_message::sApChannelSwitch params);
 
+#ifdef BEEROCKS_RDKB
+    /**
+     * @brief Seed all EHT operation fields in AgentDB bss.eht_operations from
+     *        the joined notification, so the early AP capability report carries
+     *        valid EHT Operations TLV data before the controller sends a
+     *        Channel Selection Request.
+     */
+    void save_eht_ops_to_db(const std::string &fronthaul_iface,
+                            const beerocks_message::sEhtOperationParams &eo_params,
+                            uint8_t eht_operation_valid);
+#endif // BEEROCKS_RDKB
+
     /**
      * @brief save cac capabilities in the agent DB
      */
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index c20036489..860b24bae 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -153,6 +153,42 @@ public:
      */
     virtual bool set_disabled_subchannels(uint16_t disabled_subchannel_bitmap) = 0;
 
+#ifdef BEEROCKS_RDKB
+    /**
+     * @brief Apply a full set of EHT operation parameters to all BSS entries on this radio.
+     *
+     * Carries MCS-NSS set, control/ccfs0/ccfs1, puncturing bitmap, and operation flags from
+     * the controller's EHT Operations TLV down to the HAL. Platforms that do not need it can
+     * keep the default no-op.
+     *
+     * @param [in] eo_params The EHT operation parameters received from the controller.
+     *
+     * @return true on success or false on error.
+     */
+    virtual bool set_eht_operation_params(const son::wireless_utils::sEhtOperationParams &eo_params)
+    {
+        return true;
+    }
+
+    /**
+     * @brief Read the current EHT operation parameters from the data model.
+     *
+     * Used to seed AgentDB bss.eht_operations at join time so the early AP
+     * capability report carries valid EHT Operations TLV data.
+     *
+     * @param [out] eo_params    Populated EHT operation parameters.
+     * @param [out] ops_valid    Set to 1 if the data model had valid EHT ops.
+     *
+     * @return true on success or false on error.
+     */
+    virtual bool get_eht_operation_params(son::wireless_utils::sEhtOperationParams &eo_params,
+                                          uint8_t &ops_valid)
+    {
+        ops_valid = 0;
+        return true;
+    }
+#endif // BEEROCKS_RDKB
+
     /**
      * @brief Allow the station with the given MAC address to connect.
      *
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 6675da46b..6f34dc48c 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -65,6 +65,8 @@ cACTION_APMANAGER_JOINED_NOTIFICATION:
   radio_mscs_support: uint8_t #bool
   radio_scs_support: uint8_t #bool
   num_of_bands: int8_t
+  eo_params: sEhtOperationParams
+  eht_operation_valid: uint8_t #bool
 
 cACTION_APMANAGER_ENABLE_APS_REQUEST:
   _type: class
-- 
