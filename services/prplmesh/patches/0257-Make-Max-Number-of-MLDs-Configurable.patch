Subject: [PATCH] Make Max Number of MLDs Configurable

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 .../beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp |  9 +++++++--
 framework/platform/bpl/cfg/dm/bpl_cfg.cpp        |  5 +++++
 framework/platform/bpl/cfg/linux/bpl_cfg.cpp     |  6 ++++++
 framework/platform/bpl/cfg/rdk/bpl_cfg.cpp       |  6 ++++++
 framework/platform/bpl/cfg/uci/bpl_cfg.cpp       | 11 +++++++++++
 framework/platform/bpl/include/bpl/bpl_cfg.h     | 16 ++++++++++++++++
 6 files changed, 51 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 62aaa6e7b..261e67d27 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1524,8 +1524,13 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
                m_radio_info.bsta_modes_support.nstr_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
                m_radio_info.bsta_modes_support.str_support = radio_info.eht_cfg.bsta_modes_support.emlsr_support;
 
-/* Hard coding */
-               m_radio_info.max_num_mlds = 4;
+               uint8_t configured_max_num_mlds = beerocks::bpl::DEFAULT_MAXIMUM_NUMBER_OF_MLD;
+               if (!beerocks::bpl::bpl_cfg_get_maximum_number_of_mld(configured_max_num_mlds)) {
+                   LOG(WARNING) << "Failed reading 'MaximumNumberofMLD', using default="
+                                << beerocks::bpl::DEFAULT_MAXIMUM_NUMBER_OF_MLD;
+                   configured_max_num_mlds = beerocks::bpl::DEFAULT_MAXIMUM_NUMBER_OF_MLD;
+               }
+               m_radio_info.max_num_mlds = configured_max_num_mlds;
                m_radio_info.ap_maximum_links = 3;
                m_radio_info.bsta_maximum_links = 3;
     }
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
index 2240814c9..06fc7e91f 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
@@ -146,6 +146,11 @@ bool bpl_cfg_get_agent_multi_ap_profile(uint32_t &profile)
     return read_agent_config_param("MultiAPProfile", profile);
 }
 
+bool bpl_cfg_get_maximum_number_of_mld(uint8_t &max_num_mlds)
+{
+    return read_agent_config_param("MaximumNumberofMLD", max_num_mlds);
+}
+
 int cfg_get_backhaul_params(int *max_vaps, int *network_enabled, int *preferred_radio_band)
 {
     if (max_vaps) {
diff --git a/framework/platform/bpl/cfg/linux/bpl_cfg.cpp b/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
index 9582ca268..c75c09e51 100644
--- a/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
@@ -723,6 +723,12 @@ bool bpl_cfg_get_agent_multi_ap_profile(uint32_t &profile)
     return true;
 }
 
+bool bpl_cfg_get_maximum_number_of_mld(uint8_t &max_num_mlds)
+{
+    // Not implemented yet, to be done as and when required
+    return false;
+}
+
 bool cfg_get_roaming_hysteresis_percent_bonus(int &roaming_hysteresis_percent_bonus)
 {
     int val = -1;
diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
index b5456ce33..72d9ca1f8 100644
--- a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
@@ -176,6 +176,12 @@ bool bpl_cfg_get_agent_multi_ap_profile(uint32_t &profile)
     return true;
 }
 
+bool bpl_cfg_get_maximum_number_of_mld(uint8_t &max_num_mlds)
+{
+    // TO-DO: RDKB implementation of this config
+    return false;
+}
+
 bool cfg_get_band_steering(bool &band_steering)
 {
     band_steering = false;
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
index 41e6e7fde..e67635542 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
@@ -767,6 +767,17 @@ bool bpl_cfg_get_agent_multi_ap_profile(uint32_t &profile)
     return true;
 }
 
+bool bpl_cfg_get_maximum_number_of_mld(uint8_t &max_num_mlds)
+{
+    int retVal = -1;
+    if (cfg_get_prplmesh_param_int("MaximumNumberofMLD", &retVal) == RETURN_ERR) {
+        max_num_mlds = 0;
+        return false;
+    }
+    max_num_mlds = static_cast<uint8_t>(retVal);
+    return true;
+}
+
 bool cfg_get_roaming_hysteresis_percent_bonus(int &roaming_hysteresis_percent_bonus)
 {
     int retVal = -1;
diff --git a/framework/platform/bpl/include/bpl/bpl_cfg.h b/framework/platform/bpl/include/bpl/bpl_cfg.h
index de4cc37c1..4da0dc6b0 100644
--- a/framework/platform/bpl/include/bpl/bpl_cfg.h
+++ b/framework/platform/bpl/include/bpl/bpl_cfg.h
@@ -1622,6 +1622,22 @@ enum class eBstaSupplicantRestartStatus {
  */
 eBstaSupplicantRestartStatus bpl_cfg_update_bsta_mld_grp(const std::string &radio_band,
                                                                 int8_t mld_unit);
+
+// Default value for the maximum number of MLDs supported by a radio, when
+// nothing is configured: worst case is one MLD per BSS, across all BSSes on
+// all radios (maximum possible number of radios * maximum possible number of
+// BSS per radio).
+constexpr uint8_t DEFAULT_MAXIMUM_NUMBER_OF_MLD =
+    beerocks::MAX_RADIOS_PER_AGENT * beerocks::IFACE_TOTAL_VAPS;
+
+/**
+ * @brief Reads the maximum number of MLDs supported by the radio from the
+ * "MaximumNumberofMLD" prplmesh UCI option.
+ *
+ * @param [out] max_num_mlds Maximum number of MLDs.
+ * @return true if success, false otherwise.
+ */
+bool bpl_cfg_get_maximum_number_of_mld(uint8_t &max_num_mlds);
  
 /**
  * @brief Gets the MLD ID for a given interface from the wifi-mld UCI section.
-- 
