From 7afd275bfce38ce1a804bc8256980cb945db0bf5 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Fri, 11 Sep 2026 10:19:39 +0530
Subject: [PATCH] hostapd: fix Configuration::get_vap substring match returning
 wrong vap

get_vap() matched vap names with current_vap.first.rfind(vap) != npos,
a "contains" check rather than an exact match. When one interface name
is a prefix of another (e.g. "wlan1" vs "wlan1_1"/"wlan1_2"), a lookup
for "wlan1" could return "wlan1_1"'s config instead if it appears
earlier in m_hostapd_config_vaps (parse order from hostapd.conf).

This caused get_vap_value()/set_create_vap_value() to read/write the
wrong VAP's config when called with a name that is a prefix of another
VAP on the same radio, even though get_vap_by_bssid() had resolved the
correct vap_id.

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 common/beerocks/hostapd/source/configuration.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/hostapd/source/configuration.cpp b/common/beerocks/hostapd/source/configuration.cpp
index 4cac1362a..f1fbd7c67 100644
--- a/common/beerocks/hostapd/source/configuration.cpp
+++ b/common/beerocks/hostapd/source/configuration.cpp
@@ -442,12 +442,13 @@ const std::string &Configuration::get_last_message() const { return m_last_messa
 std::tuple<bool, std::vector<std::string> *>
 Configuration::get_vap(const std::string &calling_function, const std::string &vap)
 {
-    // search for the requested vap - ignore comments
-    // by searching from the back of the saved vap (rfind)
+    // search for the requested vap by exact name. A substring/rfind check here
+    // would wrongly match e.g. "wlan1_1" when searching for "wlan1" if the former
+    // is stored earlier in m_hostapd_config_vaps.
     auto existing_vap =
         std::find_if(m_hostapd_config_vaps.begin(), m_hostapd_config_vaps.end(),
                      [&vap](const std::pair<std::string, std::vector<std::string>> &current_vap) {
-                         return current_vap.first.rfind(vap) != std::string::npos;
+                         return current_vap.first == vap;
                      });
 
     if (existing_vap == m_hostapd_config_vaps.end()) {
-- 
