+bool mon_wlan_hal_nl80211::check_base_iface_exists()
+{
+    // Get the interface index for given interface name
+    std::string interface_name = get_iface_name();
+    std::string base_interface;
+    extractBase1Interface(interface_name, base_interface);
+    int iface_index = if_nametoindex(base_interface.c_str());
+    if (0 != iface_index) {
+        LOG(DEBUG) << "Interface " << base_interface << " is present with iface_index: " << iface_index ;
+        return true;
+    } else {
+        LOG(ERROR) << "Interface " << base_interface << " is not exist ";
+        return false;
+    }
+}
