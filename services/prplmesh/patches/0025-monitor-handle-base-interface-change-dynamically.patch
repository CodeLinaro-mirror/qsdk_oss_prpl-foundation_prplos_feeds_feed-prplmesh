         LOG(ERROR) << "Failed updating Radio statistics!";
-        return false;
+        // check base radio interface exists or not
+        if(mon_wlan_hal->check_base_iface_exists()) {
+            LOG(ERROR) << "Base interface exists - still radio_stats failed ";
+            return false;
+        } else {
+            LOG(ERROR) << "Base interface did not exist - check prplmesh config for any changes in base iface";
+           
+            int radio_id = 0;
+            std::string base_radio_iface = mon_wlan_hal->get_radio_info().iface_name;
+
+            switch (mon_wlan_hal->get_radio_info().frequency_band) {
+                case beerocks::FREQ_24G: radio_id = 0; break;
+                case beerocks::FREQ_5G: radio_id = 1;  break;
+                case beerocks::FREQ_6G: radio_id = 2;  break;
+                default: break;
+            }
+ 
+            char hostapd_iface[BPL_IFNAME_LEN] = "";
+            if (beerocks::bpl::cfg_get_hostap_iface(radio_id,hostapd_iface) < 0) {
+                LOG(ERROR) << " Failed to get latest hostapd iface" ;
+                return false;
+            }
+
+            std::string updated_iface(hostapd_iface);
+            LOG(DEBUG) << "base_radio: " << base_radio_iface << " updated_iface: " << updated_iface;
+
+            std::string base_radio_bssid = tlvf::mac_to_string(m_radio_mac);
+
+            if (!mon_wlan_hal->get_bss_link_name(updated_iface,base_radio_bssid)) {
+                LOG(ERROR) << " get_bss_link_id failed " ;
+                return false;
+            }
+            LOG(DEBUG) << " updated_iface with link: " << updated_iface;
+
+            std::string remove_iface;
+            for (auto &active_fd : m_mon_hal_ext_events) {
+                if (active_fd > 0) {
+                    remove_iface = mon_wlan_hal->get_iface_from_fd(active_fd);
+                    if(!remove_iface.empty()) {
+                        if (!mon_wlan_hal->remove_ctrl_skt(remove_iface)) {
+                                   LOG(ERROR) << "Failed to remove the BSS!";
+                        }
+                    }
+                    m_event_loop->remove_handlers(active_fd);
+                }
+            }
+
+            m_mon_hal_ext_events = {beerocks::net::FileDescriptor::invalid_descriptor};
+            mon_wlan_hal->set_base_radio_iface_name(updated_iface);
+            mon_wlan_hal->create_wpa_ctrl_skt(updated_iface);
+            mon_wlan_hal->set_iface_name(updated_iface);
+
+            mon_db.clear();
+            // Initialize VAPs in the DB
+            update_vaps_in_db();
+
+            // external event registration for all vaps
+            m_mon_hal_ext_events = mon_wlan_hal->get_ext_events_fds();
+            if (!m_mon_hal_ext_events.empty()) {
+                for (auto &ext_event_fd : m_mon_hal_ext_events) {
+                    if (ext_event_fd < 0) {
+                        ext_event_fd = beerocks::net::FileDescriptor::invalid_descriptor;
+                        continue;
+                    }
+                    if (!register_ext_events_handlers(ext_event_fd)) {
+                        LOG(DEBUG) << "External events queue with fd = " << ext_event_fd << " is already registered ";
+                    }
+                }
+            }
+            auto radio_node = mon_db.get_radio_node();
+            radio_node->set_iface(updated_iface);
+        }
     }
 
