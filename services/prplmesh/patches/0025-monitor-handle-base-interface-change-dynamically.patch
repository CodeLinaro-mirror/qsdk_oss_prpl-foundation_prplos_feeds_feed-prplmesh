+    if (!m_nl80211_client->get_bss_link_id(iface,bssid,link_id)) {
+        LOG(ERROR) << " get_bss_link_id failed " ;
+        return false;    
+    }
+
+    return true;
+}
+
+void mon_wlan_hal_nl80211::set_base_radio_iface_name(std::string &iface)
+{
+    m_radio_info.iface_name = iface;
+}
