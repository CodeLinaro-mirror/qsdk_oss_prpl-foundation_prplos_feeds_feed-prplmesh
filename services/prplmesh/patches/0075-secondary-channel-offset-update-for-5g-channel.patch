From 15386ee29176048085d5244914149cd27b61631d Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Thu, 19 Feb 2026 14:31:38 +0530
Subject: [PATCH] secondary channel offset update for 5g channel

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 25 +++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 8cdbf677a..65435d4b4 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -40,6 +40,8 @@ bool ap_wlan_hal_nl80211::nl_event_handle(struct nl_msg *msg, void *arg)
 
 #define BUFFER_SIZE 4096
 #define CSA_EVENT_FILTERING_TIMEOUT_MS 1000
+#define FREQ_5G_START 5150
+#define FREQ_5G_END   5895
 
 #define MLD_PAIR_ENTRANT_FILE "/tmp/beerocks/mld_pair_entrant.txt"
 
@@ -1976,8 +1978,27 @@ bool ap_wlan_hal_nl80211::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
     cmd += freq_str; // CenterFrequency
 
     // Extension Channel
-    if (bw != beerocks::BANDWIDTH_20) {
-        if (freq < vht_center_frequency) {
+    if (bw >= beerocks::BANDWIDTH_40) {
+        if (freq >= FREQ_5G_START && freq <= FREQ_5G_END) {
+
+            /*
+            Valid 40 MHz primary channels follow a pattern:
+            channel % 8 == 0 → secondary channel above → offset = -1
+            channel % 8 == 4 → secondary channel below → offset = 1
+            */
+            if (chan % 8 == 4) {
+                cmd += " sec_channel_offset=1";
+            } else if (chan % 8 == 0) {
+                cmd += " sec_channel_offset=-1";
+            } else {
+                LOG(WARNING) << "Channel " << chan << " is not a valid 40 MHz primary channel";
+                if (freq < vht_center_frequency) {
+                    cmd += " sec_channel_offset=1";
+                } else {
+                    cmd += " sec_channel_offset=-1";
+                }
+            }
+        } else if (freq < vht_center_frequency) {
             cmd += " sec_channel_offset=1";
         } else {
             cmd += " sec_channel_offset=-1";
-- 
2.34.1

