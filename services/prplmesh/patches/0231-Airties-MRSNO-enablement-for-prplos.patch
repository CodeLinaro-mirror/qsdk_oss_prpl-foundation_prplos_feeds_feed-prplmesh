From eb23ba12ab4a0bf8da7e20fed126ef3624e07e1d Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 22 Jun 2026 10:42:14 +0530
Subject: [PATCH] Airties MRSNO enablement for prplos

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp |  6 ++--
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp   |  7 ++--
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 32 ++++++++-----------
 .../platform/wbapi/include/wbapi_utils.h      |  5 +--
 framework/platform/wbapi/wbapi_utils.cpp      | 30 +++++++++++++++--
 5 files changed, 51 insertions(+), 29 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 46fc99dc7..a848ee7cd 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2482,10 +2482,10 @@ bool ApAutoConfigurationTask::handle_wsc_m2_tlv(
         const auto auth_type = info.payload_config.auth_type;
         
         LOG(DEBUG) << "Authentication Flow: Checking Airties BSS Profile for SSID=" << info.payload_config.ssid
-                   << " auth_type=0x" << std::hex << int(auth_type) << std::dec;
+                   << " auth_type=" << std::hex << int(auth_type) << std::dec;
         
         if (m2.airties_bss_profile(airties_bss_profile)) {
-            LOG(DEBUG) << "Authentication Flow: Airties BSS Profile FOUND, value=0x" << std::hex 
+            LOG(DEBUG) << "Authentication Flow: Airties BSS Profile FOUND, value=" << std::hex 
                        << int(airties_bss_profile) << std::dec;
             
             constexpr uint8_t AIRTIES_BSS_PROFILE_WPA3_COMPATIBILITY_MODE = 0x20; // bit 5
@@ -2536,7 +2536,7 @@ bool ApAutoConfigurationTask::handle_wsc_m2_tlv(
                         son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM24;
                     LOG(DEBUG) << "MRSNO Compatibility mode (6GHz): auth_type=0x0040 (bit5=1) -> AKM24";
                 } else {
-                    LOG(WARNING) << "MRSNO Compatibility Mode: No matching auth_type! auth_type=0x" 
+                    LOG(WARNING) << "MRSNO Compatibility Mode: No matching auth_type! auth_type=" 
                                  << std::hex << int(auth_type) << std::dec 
                                  << " - falling back to NONE";
                     info.additional_auth = son::wireless_utils::eAdditionalAuth::NONE;
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index f9731bdb6..cb5cdfad3 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -738,7 +738,9 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         if (params_retrieved &&
             current_ssid == bss_info_conf.ssid && current_password == bss_info_conf.network_key &&
             current_mode ==
-                wbapi_utils::security_mode_to_string(bss_info_conf.authentication_type) &&
+                wbapi_utils::security_mode_to_string(bss_info_conf.authentication_type,
+                                                     bss_info_conf.additional_auth,
+                                                     bss_info_conf.freq_band) &&
                 current_mldID == mld_unit &&
                 current_ssid_adv == expected_ssid_adv) {
             LOG(DEBUG) << "No changes detected for " << ifname
@@ -759,8 +761,7 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         }
 
         std::string security_mode = wbapi_utils::security_mode_to_string(
-            bss_info_conf.authentication_type, bss_info_conf.additional_auth);
-
+            bss_info_conf.authentication_type, bss_info_conf.additional_auth, bss_info_conf.freq_band);  
         LOG(DEBUG) << "Security Mode:" << security_mode << " Encryption Mode:" << encryption_mode;
 
         std::string wifi_ap_sec_path = wifi_vap_path + "Security.";
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index efa041d72..2def3bc76 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -620,18 +620,15 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 	    options["encryption"] = get_encryption(configuration.authentication_type, configuration.encryption_type,
 	                                            configuration.additional_auth, configuration.freq_band);
 
-        // Set sae_pwe if encryption is SAE
-        // 6GHz requires sae_pwe=1 (H2E only), 2.4/5GHz uses sae_pwe=2 (H2E + hunting-and-pecking)
         if (options["encryption"] == "sae") {
-            if (configuration.freq_band == beerocks::eFreqType::FREQ_6G) {
-                options["sae_pwe"] = "1";
-            } else {
                 options["sae_pwe"] = "2";
-            }
-            options["sae"] = "1";
-	    }
-        if (options["encryption"] == "sae-mixed") {
-            options["sae_pwe"] = "2";  // sae-mixed is only for 2.4/5GHz
+                options["sae"] = "1";
+        }
+        if (options["encryption"] == "sae-mixed" || 
+            options["encryption"] == "sae-ext-key" || 
+            options["encryption"] == "sae-sae_ext_key" || 
+            options["encryption"] == "akm24-sae-mixed") {
+            options["sae_pwe"] = "2";  
         }
 	    options["key"] = configuration.network_key;
     	    options["ifname"] = iface;
@@ -897,18 +894,15 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             options["ssid"] = config.ssid;
             options["encryption"] = get_encryption(config.authentication_type, config.encryption_type, config.additional_auth, config.freq_band);
             
-            // Set sae_pwe based on frequency band
-            // 6GHz requires sae_pwe=1 (H2E only), 2.4/5GHz uses sae_pwe=2 (H2E + hunting-and-pecking)
             if (options["encryption"] == "sae") {
-                if (config.freq_band == beerocks::eFreqType::FREQ_6G) {
-                    options["sae_pwe"] = "1";
-                } else {
-                    options["sae_pwe"] = "2";
-                }
+                options["sae_pwe"] = "2";
                 options["sae"] = "1";
             }
-            if (options["encryption"] == "sae-mixed") {
-                options["sae_pwe"] = "2";  // sae-mixed is only for 2.4/5GHz
+            if (options["encryption"] == "sae-mixed" || 
+                options["encryption"] == "sae-ext-key" || 
+                options["encryption"] == "sae-sae_ext_key" || 
+                options["encryption"] == "akm24-sae-mixed") {
+                options["sae_pwe"] = "2";  
             }
 
             options["key"] = config.network_key;
diff --git a/framework/platform/wbapi/include/wbapi_utils.h b/framework/platform/wbapi/include/wbapi_utils.h
index 1a972083f..46a3e7ce7 100644
--- a/framework/platform/wbapi/include/wbapi_utils.h
+++ b/framework/platform/wbapi/include/wbapi_utils.h
@@ -55,12 +55,13 @@ public:
     static std::string band_short_name(const beerocks::eFreqType &band);
 
     /**
-     * @brief Converts WSC::eWscAuth ecurity mode to string.
+     * @brief Converts WSC::eWscAuth security mode to string.
      */
     static std::string
     security_mode_to_string(const WSC::eWscAuth &security_mode,
                             son::wireless_utils::eAdditionalAuth additional_auth =
-                                son::wireless_utils::eAdditionalAuth::NONE);
+                                son::wireless_utils::eAdditionalAuth::NONE,
+                            beerocks::eFreqType freq_band = beerocks::eFreqType::FREQ_UNKNOWN);
 
     /**
      * @brief Converts a string-based security mode to WSC::eWscAuth.
diff --git a/framework/platform/wbapi/wbapi_utils.cpp b/framework/platform/wbapi/wbapi_utils.cpp
index ce3bd114d..8d2395f21 100644
--- a/framework/platform/wbapi/wbapi_utils.cpp
+++ b/framework/platform/wbapi/wbapi_utils.cpp
@@ -105,8 +105,34 @@ const std::map<std::string, std::vector<son::wireless_utils::eAdditionalAuth>>
 
 std::string
 wbapi_utils::security_mode_to_string(const WSC::eWscAuth &security_mode,
-                                     son::wireless_utils::eAdditionalAuth additional_auth)
-{
+                                     son::wireless_utils::eAdditionalAuth additional_auth,
+                                     beerocks::eFreqType freq_band)
+{
+    // Airties MRSNO (Multi-RSN Override) compatibility mode handling:
+    // For 6GHz: Only AKM8_AKM24 uses MRSNO flow (WPA3-Personal-Compatibility)
+    //           AKM8 and AKM24 alone should use normal flow
+    // For 2.4/5GHz: All three modes use MRSNO flow (WPA3-Personal-Compatibility)
+    bool is_6ghz = (freq_band == beerocks::eFreqType::FREQ_6G);
+    
+    if (additional_auth ==
+            son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8 ||
+        additional_auth ==
+            son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM24 ||
+        additional_auth ==
+            son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24) {
+        
+        // For 6GHz: Only AKM8_AKM24 should use MRSNO
+        if (is_6ghz) {
+            if (additional_auth == son::wireless_utils::eAdditionalAuth::AIRTIES_WPA3_COMPATIBILITY_AKM8_AKM24) {
+                return "WPA3-Personal-Compatibility";
+            }
+            // Fall through to normal flow below for AKM8/AKM24 alone
+        } else {
+            // For 2.4/5GHz: All three modes use MRSNO
+            return "WPA3-Personal-Compatibility";
+        }
+    }
+
     if (security_mode != WSC::eWscAuth::WSC_AUTH_RSN) {
         auto map_it =
             std::find_if(security_mode_table.begin(), security_mode_table.end(),
-- 
2.34.1

