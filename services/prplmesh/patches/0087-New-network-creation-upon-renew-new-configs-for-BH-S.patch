+bool nl80211_client_impl::check_link_id_operational(const std::string &iface, int link_id)
+{
+    std::string base_interface;
+    bwl::base_wlan_hal::extractLinkBaseInterface(iface, base_interface);
+
+    LOG(INFO) << "Checking if link_id " << link_id << " is operational for interface: " << base_interface;
+
+    if (!m_socket) {
+        LOG(ERROR) << "Socket is NULL!";
+        return false;
+    }
+
+    int iface_index = if_nametoindex(base_interface.c_str());
+    if (0 == iface_index) {
+        LOG(ERROR) << "Failed to read the index of interface " << iface << " base_interface:" << base_interface << ": "
+                   << strerror(errno);
+        return false;
+    }
+
+    bool link_operational = false;
+
+    m_socket.get()->send_receive_msg(
+        NL80211_CMD_GET_INTERFACE, 0,
+        [&](struct nl_msg *msg) -> bool {
+            nla_put_u32(msg, NL80211_ATTR_IFINDEX, iface_index);
+            return true;
+        },
+        [&](struct nl_msg *msg) {
+            struct nlattr *tb[NL80211_ATTR_MAX + 1];
+            struct genlmsghdr *gnlh = (struct genlmsghdr *)nlmsg_data(nlmsg_hdr(msg));
+
+            // Parse the netlink message
+            if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0),
+                          NULL)) {
+                LOG(ERROR) << "Failed to parse netlink message!";
+                return;
+            }
+
+            if (tb[NL80211_ATTR_MLO_LINKS]) {
+                LOG(INFO) << "MLO links attribute present";
+                int ret = 0;
+                struct nlattr *attrs, *link[NL80211_ATTR_MAX + 1];
+                nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
+                    nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
+                    
+                    if (link[NL80211_ATTR_MLO_LINK_ID]) {
+                        int current_link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
+                        
+                        if (current_link_id == link_id) {
+                            LOG(INFO) << "Found matching link_id: " << link_id;
+                            
+                            // Check if the link has a valid frequency
+                            if (link[NL80211_ATTR_WIPHY_FREQ]) {
+                                int freq = nla_get_u32(link[NL80211_ATTR_WIPHY_FREQ]);
+                                LOG(INFO) << "Link " << link_id << " has valid frequency: " << freq << " MHz";
+                                link_operational = true;
+                            } else {
+                                LOG(WARNING) << "Link " << link_id << " found but has no valid frequency";
+                            }
+                            return;
+                        }
+                    }
+                }
+                
+                if (!link_operational) {
+                    LOG(WARNING) << "Link " << link_id << " not found or not operational";
+                }
+            } else {
+                LOG(INFO) << "No MLO links attribute present for interface " << base_interface;
+            }
+        });
+
+    return link_operational;
+}
