From e9e06815c12bbbf861efbcd9f4d367180e7805e9 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Tue, 13 Oct 2026 09:46:21 +0530
Subject: [PATCH] CERT: Prevent sending M8 WSC as part of M2 message

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 controller/src/beerocks/master/controller.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 13884cc..0dae008 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -2705,10 +2705,12 @@ bool Controller::handle_cmdu_1905_autoconfiguration_WSC(const sMacAddr &src_mac,
                        << uint16_t(bss_info_conf.authentication_type) << std::dec
                        << " ssid=" << bss_info_conf.ssid;
 
-            if (!autoconfig_wsc_add_m8(*m1, bss_info_conf)) {
-                database.clear_configured_bss_info(ruid);
-                LOG(ERROR) << "Failed setting M8 attributes";
-                return false;
+            if (!database.setting_certification_mode()) {
+                if (!autoconfig_wsc_add_m8(*m1, bss_info_conf)) {
+                    database.clear_configured_bss_info(ruid);
+                    LOG(ERROR) << "Failed setting M8 attributes";
+                    return false;
+                }
             }
         }
 
-- 
2.34.1

