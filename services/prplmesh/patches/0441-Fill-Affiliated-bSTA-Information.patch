+                            static_cast<const uint8_t *>(nla_data(link[NL80211_ATTR_MAC]));
+                        tlvf::mac_from_array(mlo_link_addr, mlo_link.addr);
+                    }
+                    if (link[NL80211_ATTR_WIPHY_FREQ]) {
