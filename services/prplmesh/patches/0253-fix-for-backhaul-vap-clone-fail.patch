From 5ac206665c14c364520c09d51ddb9994d48a7c17 Mon Sep 17 00:00:00 2001
From: Muhassina Alliyengal <malliyen@qti.qualcomm.com>
Date: Sun, 5 Jul 2026 17:47:34 +0530
Subject: [PATCH] fix for backhaul vap clone fail
Signed-off-by: Muhassina Alliyengal <malliyen@qti.qualcomm.com>

---
 .../slave/tasks/ap_autoconfiguration_task.cpp     | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 46fc99d..64bcc49 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -3813,18 +3813,33 @@ bool ApAutoConfigurationTask::handle_bss_reconfiguration(
             //       BSSID is still "OpenWrt" (fh=1 bh=0), even if the MLD TLV designates
             //       it as a BH radio.
             //   (d) No MLD configuration received at all (non-MLD setup): always allow.
+            //   (e) This backhaul SSID is not part of any radio's MLD grouping (SLO
+            //       backhaul in a mixed SLO-backhaul + MLO-fronthaul setup): always
+            //       allow. (d) alone is not enough here, since m_ap_mld_requests_infos
+            //       is populated (non-empty) as soon as ANY SSID on ANY radio is MLD
+            //       grouped (e.g. an MLO fronthaul SSID) - it says nothing about
+            //       whether THIS backhaul_ssid specifically is MLD grouped.
             const std::string &backhaul_ssid = remaining_bss.payload_config.ssid;
 
             // Check (c): MLD config assigns this backhaul SSID to this radio
             bool mld_assigns_backhaul_to_radio = false;
+            // Check (e): is this backhaul SSID MLD-grouped on ANY radio at all?
+            bool backhaul_ssid_is_mld_grouped = false;
             auto mld_radio_it = m_ap_mld_requests_infos.find(radio_iface);
             if (mld_radio_it != m_ap_mld_requests_infos.end()) {
                 mld_assigns_backhaul_to_radio =
                     (mld_radio_it->second.find(backhaul_ssid) != mld_radio_it->second.end());
             }
+            for (const auto &radio_entry : m_ap_mld_requests_infos) {
+                if (radio_entry.second.find(backhaul_ssid) != radio_entry.second.end()) {
+                    backhaul_ssid_is_mld_grouped = true;
+                    break;
+                }
+            }
 
             const bool radio_has_backhaul_bss =
                 m_ap_mld_requests_infos.empty() || // (d) Non-MLD setup: always allow
+                !backhaul_ssid_is_mld_grouped ||   // (e) SLO backhaul: always allow
                 mld_assigns_backhaul_to_radio ||
                 std::any_of(radio->front.bssids.begin(), radio->front.bssids.end(),
                             [&backhaul_ssid](const sBssid &b) {
-- 
