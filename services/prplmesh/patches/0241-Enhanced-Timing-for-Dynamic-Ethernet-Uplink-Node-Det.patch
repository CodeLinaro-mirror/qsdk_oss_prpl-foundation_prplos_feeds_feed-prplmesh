 {
@@ -4623,30 +4381,8 @@ bool BackhaulManager::is_gateway_reachable_via_interface(const std::string &ifac
     // Store the resolved gateway IP in the member variable
     m_gateway_ip = gw_ip;
 
-#ifdef USE_PRPLMESH_NLHAL
-    // OpenWrt: Use arping for determining gateway reachability
+    // Use arping for determining gateway reachability on both platforms
     return arping_confirm_gateway(iface, bridge_iface, gw_ip);
-#else
-    // PrplOS: Use legacy route/FDB/ping verification
-    // Verify route goes via this interface
-    if (!verify_route_via_wan(gw_ip, iface, bridge_iface)) {
-        return false;
-    }
-
-    // If bridge is involved, check FDB
-    if (!bridge_iface.empty()) {
-        std::string gw_mac;
-        if (!resolve_gateway_mac(gw_ip, bridge_iface, gw_mac)) {
-            return false;
-        }
-        if (!verify_gateway_on_wan_port(gw_mac, iface, bridge_iface)) {
-            return false;
-        }
-    }
-
-    // Check reachability using gateway IP
-    return is_gateway_reachable();
-#endif
 }
 
