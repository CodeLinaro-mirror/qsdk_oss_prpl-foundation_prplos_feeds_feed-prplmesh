-// PrplOS implementation using ping + route/FDB verification
-bool BackhaulManager::verify_route_via_wan(const std::string &gw_ip, const std::string &wan_iface,
-                                           const std::string &bridge_iface)
-{
-    std::string route_check_cmd = "ip route get " + gw_ip + " 2>/dev/null";
-    FILE *fp = popen(route_check_cmd.c_str(), "r");
-    bool route_via_wan = false;
-
-    if (fp) {
-        char buffer[256];
-        if (fgets(buffer, sizeof(buffer), fp) != nullptr) {
-            std::string route_output(buffer);
-
-            // Extract the device after "dev "
-            std::string dev_name;
-            std::string dev_key = " dev ";
-            auto dev_pos = route_output.find(dev_key);
-            if (dev_pos != std::string::npos) {
-                dev_pos += dev_key.size();
-                while (dev_pos < route_output.size() && route_output[dev_pos] == ' ')
-                    dev_pos++;
-                size_t end_pos = dev_pos;
-                while (end_pos < route_output.size() &&
-                       route_output[end_pos] != ' ' && route_output[end_pos] != '\n' &&
-                       route_output[end_pos] != '\r' && route_output[end_pos] != '\t') {
-                    end_pos++;
-                }
-                dev_name = route_output.substr(dev_pos, end_pos - dev_pos);
-            }
-
-            if (!dev_name.empty()) {
-                if (dev_name == wan_iface) {
-                    route_via_wan = true;
-                    LOG(DEBUG) << "Route to gateway " << gw_ip << " goes through WAN iface " << wan_iface;
-                } else if (!bridge_iface.empty() && dev_name == bridge_iface) {
-                    // Check if wan_iface is enslaved to the bridge
-                    std::string list_brifs_cmd =
-                        "ls -1 /sys/class/net/" + bridge_iface + "/brif 2>/dev/null";
-                    FILE *fp2 = popen(list_brifs_cmd.c_str(), "r");
-                    if (fp2) {
-                        char ifbuf[256];
-                        while (fgets(ifbuf, sizeof(ifbuf), fp2) != nullptr) {
-                            std::string member = ifbuf;
-                            member.erase(member.find_last_not_of(" \n\r\t") + 1);
-                            if (member == wan_iface) {
-                                route_via_wan = true;
-                                LOG(DEBUG) << "Route dev is bridge " << bridge_iface
-                                           << "; WAN member " << wan_iface << " found in brif";
-                                break;
-                            }
-                        }
-                        pclose(fp2);
-                    }
-                    if (!route_via_wan) {
-                        LOG(WARNING) << "Route dev is bridge " << bridge_iface
-                                     << " but WAN iface " << wan_iface
-                                     << " not found among bridge members";
-                    }
-                } else {
-                    LOG(WARNING) << "Route to gateway " << gw_ip << " dev=" << dev_name
-                                 << " does not match WAN iface " << wan_iface
-                                 << " or bridge " << bridge_iface;
-                }
-            } else {
-                LOG(WARNING) << "Failed to parse route device from: " << route_output;
-            }
-        }
-        pclose(fp);
-    }
-
-    if (!route_via_wan) {
-        LOG(WARNING) << "Gateway " << gw_ip << " is not reachable via the configured wired path (wan_iface="
-                     << wan_iface << ")";
-    }
-
-    return route_via_wan;
-}
-
-bool BackhaulManager::resolve_gateway_mac(const std::string &gw_ip, const std::string &bridge_iface,
-                                          std::string &gw_mac)
-{
-    // Command to get full neighbor entry for debugging
-    std::string neigh_cmd = "ip neigh show dev " + bridge_iface + " " + gw_ip + " 2>/dev/null";
-
-    // Try to get MAC from neighbor table
-    FILE *fp = popen(neigh_cmd.c_str(), "r");
-    if (fp) {
-        char neigh_buf[256];
-        if (fgets(neigh_buf, sizeof(neigh_buf), fp) != nullptr) {
-            std::string neigh_output(neigh_buf);
-            neigh_output.erase(neigh_output.find_last_not_of(" \n\r\t") + 1);
-            LOG(DEBUG) << "Neighbor table entry: " << neigh_output;
-
-            // Parse MAC address from output format: "IP lladdr MAC STATE"
-            // Example: "192.168.1.1 lladdr 00:03:7f:1a:54:30 DELAY"
-            std::string lladdr_key = "lladdr ";
-            auto lladdr_pos = neigh_output.find(lladdr_key);
-            if (lladdr_pos != std::string::npos) {
-                lladdr_pos += lladdr_key.size();
-                // Skip any leading spaces
-                while (lladdr_pos < neigh_output.size() && neigh_output[lladdr_pos] == ' ')
-                    lladdr_pos++;
-                // Extract MAC address (17 chars: xx:xx:xx:xx:xx:xx)
-                size_t end_pos = lladdr_pos;
-                while (end_pos < neigh_output.size() &&
-                       (std::isxdigit(neigh_output[end_pos]) || neigh_output[end_pos] == ':')) {
-                    end_pos++;
-                }
-                if (end_pos > lladdr_pos) {
-                    gw_mac = neigh_output.substr(lladdr_pos, end_pos - lladdr_pos);
-                    LOG(DEBUG) << "Extracted MAC from neighbor table: " << gw_mac;
-                }
-            }
-        }
-        pclose(fp);
-    }
-
-    // If MAC not found or invalid, prime ARP with a ping and retry with longer wait
-    if (gw_mac.empty() || gw_mac.find(':') == std::string::npos) {
-        LOG(DEBUG) << "Gateway MAC not in neighbor table (gw_mac='" << gw_mac << "'), priming with ping";
-        std::string prime_cmd = "ping -c 1 -W 1 " + gw_ip + " > /dev/null 2>&1";
-        system(prime_cmd.c_str());
-
-        // Wait longer for ARP entry to be populated
-        UTILS_SLEEP_MSEC(500);
-
-        // Retry neighbor lookup
-        fp = popen(neigh_cmd.c_str(), "r");
-        if (fp) {
-            char neigh_buf[256];
-            if (fgets(neigh_buf, sizeof(neigh_buf), fp) != nullptr) {
-                std::string neigh_output(neigh_buf);
-                neigh_output.erase(neigh_output.find_last_not_of(" \n\r\t") + 1);
-                LOG(DEBUG) << "Neighbor table entry (after ping): " << neigh_output;
-
-                // Parse MAC address from output
-                std::string lladdr_key = "lladdr ";
-                auto lladdr_pos = neigh_output.find(lladdr_key);
-                if (lladdr_pos != std::string::npos) {
-                    lladdr_pos += lladdr_key.size();
-                    while (lladdr_pos < neigh_output.size() && neigh_output[lladdr_pos] == ' ')
-                        lladdr_pos++;
-                    size_t end_pos = lladdr_pos;
-                    while (end_pos < neigh_output.size() &&
-                           (std::isxdigit(neigh_output[end_pos]) || neigh_output[end_pos] == ':')) {
-                        end_pos++;
-                    }
-                    if (end_pos > lladdr_pos) {
-                        gw_mac = neigh_output.substr(lladdr_pos, end_pos - lladdr_pos);
-                        LOG(DEBUG) << "Extracted MAC from neighbor table (after ping): " << gw_mac;
-                    }
-                }
-            }
-            pclose(fp);
-        }
-    }
-
-    if (gw_mac.empty() || gw_mac.find(':') == std::string::npos) {
-        LOG(WARNING) << "Failed to resolve gateway MAC address for " << gw_ip << " (final gw_mac='" << gw_mac << "')";
-        return false;
-    }
-
-    LOG(DEBUG) << "Gateway MAC resolved: " << gw_mac;
-    return true;
-}
-
-bool BackhaulManager::verify_gateway_on_wan_port(const std::string &gw_mac, const std::string &wan_iface,
-                                                 const std::string &bridge_iface)
-{
-    std::string fdb_cmd = "bridge fdb show br " + bridge_iface + " 2>/dev/null | grep -i '" + gw_mac + "'";
-    FILE *fp = popen(fdb_cmd.c_str(), "r");
-    bool found_on_wan = false;
-
-    if (fp) {
-        char fdb_buf[256];
-        while (fgets(fdb_buf, sizeof(fdb_buf), fp) != nullptr) {
-            std::string fdb_line(fdb_buf);
-            // Parse "dev <port>" from FDB output
-            std::string dev_key = " dev ";
-            auto dev_pos = fdb_line.find(dev_key);
-            if (dev_pos != std::string::npos) {
-                dev_pos += dev_key.size();
-                while (dev_pos < fdb_line.size() && fdb_line[dev_pos] == ' ')
-                    dev_pos++;
-                size_t end_pos = dev_pos;
-                while (end_pos < fdb_line.size() &&
-                       fdb_line[end_pos] != ' ' && fdb_line[end_pos] != '\n' &&
-                       fdb_line[end_pos] != '\r' && fdb_line[end_pos] != '\t') {
-                    end_pos++;
-                }
-                std::string fdb_port = fdb_line.substr(dev_pos, end_pos - dev_pos);
-                LOG(DEBUG) << "FDB entry: gateway MAC " << gw_mac << " on port " << fdb_port;
-                if (fdb_port == wan_iface) {
-                    found_on_wan = true;
-                    LOG(DEBUG) << "Gateway traffic egresses via ethernet port " << wan_iface;
-                    break;
-                }
-            }
-        }
-        pclose(fp);
-    }
-
-    if (!found_on_wan) {
-        LOG(WARNING) << "Gateway MAC " << gw_mac << " not found on WAN port " << wan_iface
-                     << " in bridge FDB - traffic likely goes via wireless";
-    }
-
-    return found_on_wan;
-}
-
-bool BackhaulManager::ping_gateway(const std::string &gw_ip)
-{
-    std::string ping_cmd = "ping -c 1 -W 1 " + gw_ip + " > /dev/null 2>&1";
-    int ping_result = system(ping_cmd.c_str());
-    bool gateway_reachable = (ping_result == 0);
-
-    if (gateway_reachable) {
-        LOG(DEBUG) << "Gateway " << gw_ip << " is reachable via ping";
-    } else {
-        LOG(WARNING) << "Gateway " << gw_ip << " is NOT reachable via ping";
-    }
-
-    return gateway_reachable;
-}
-
-bool BackhaulManager::is_gateway_reachable()
-{
-    if (m_gateway_ip.empty()) {
-        LOG(WARNING) << "Gateway IP not set, cannot check reachability";
-        return false;
-    }
-
-    return ping_gateway(m_gateway_ip);
-}
-#endif // USE_PRPLMESH_NLHAL
 
