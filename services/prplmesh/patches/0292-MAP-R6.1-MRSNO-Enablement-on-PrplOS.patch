+namespace {
+// Map a 4-byte 00-0F-AC:xx AKM suite selector to a hostapd/pWHM key_mgmt token.
+std::string rsn_akm_selector_to_token(const uint8_t *sel)
+{
+    if (sel[0] != 0x00 || sel[1] != 0x0F || sel[2] != 0xAC) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 0x02: return "WPA-PSK";
+    case 0x08: return "SAE";
+    case 0x18: return "SAE-EXT-KEY";
+    default:   return {};
+    }
+}
+
+// Map a 4-byte 00-0F-AC:xx cipher suite selector to a hostapd/pWHM pairwise token.
+std::string rsn_pairwise_selector_to_token(const uint8_t *sel)
+{
+    if (sel[0] != 0x00 || sel[1] != 0x0F || sel[2] != 0xAC) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 0x04: return "CCMP";
+    case 0x09: return "GCMP-256";
+    case 0x08: return "GCMP";
+    case 0x0A: return "CCMP-256";
+    default:   return {};
+    }
+}
+
+// Extract the AKM and pairwise tokens from one RSN Override vendor element body
+// (the bytes AFTER the WFA OUI + OUI type). Layout mirrors append_rsn_override_element():
+//   Version(2) GroupData(4) PWCount(2) PW(4) AKMCount(2) AKM(4) RSNCaps(2) ...
+bool parse_rsn_override_body(const uint8_t *body, size_t len, std::string &akm_token,
+                             std::string &pairwise_token, std::string &mfp_token)
+{
+    // Need at least up to the RSN Capabilities low byte (offset 24).
+    if (len < 26) {
+        return false;
+    }
+    // Pairwise Cipher Suite selector at offset 6..9, AKM Suite selector at offset 14..17.
+    pairwise_token = rsn_pairwise_selector_to_token(body + 6);
+    akm_token      = rsn_akm_selector_to_token(body + 14);
+    // RSN Capabilities low byte at offset 20 carries MFPC (bit7=0x80) / MFPR (bit6=0x40).
+    const uint8_t caps_low = body[20];
+    if (caps_low & 0x40) {
+        mfp_token = "2"; // MFP required
+    } else if (caps_low & 0x80) {
+        mfp_token = "1"; // MFP capable/optional
+    } else {
+        mfp_token = "0"; // MFP disabled
+    }
+    return !akm_token.empty() && !pairwise_token.empty();
+}
+} // namespace
+
+bool ap_wlan_hal_whm::update_bss_rsn_override(const sMacAddr &bssid,
+                                              const std::vector<uint8_t> &security_ies)
+{
+    LOG(DEBUG) << "update_bss_rsn_override: bssid=" << bssid
+               << " security_ies_len=" << security_ies.size();
+
+    // Resolve VAP by BSSID.
+    int vap_id = get_vap_id_with_mac(tlvf::mac_to_string(bssid));
+    if (!check_vap_id(vap_id)) {
+        LOG(ERROR) << "update_bss_rsn_override: no VAP found for bssid=" << bssid;
+        return false;
+    }
+    const auto &vap_info = m_radio_info.available_vaps[vap_id];
+    auto vap_it          = m_vapsExtInfo.find(vap_info.bss);
+    if (vap_it == m_vapsExtInfo.end()) {
+        LOG(ERROR) << "update_bss_rsn_override: VAP ext info not found for " << vap_info.bss;
+        return false;
+    }
+
+    // Decode the RSNOE(0x29) -> override-1 and RSNO2E(0x2A) -> override-2 tokens from the blob.
+    std::string o1_km, o1_pw, o1_mfp, o2_km, o2_pw, o2_mfp;
+    bool have_o1 = false, have_o2 = false;
+    size_t i = 0;
+    while (i + 2 <= security_ies.size()) {
+        const uint8_t eid = security_ies[i];
+        const uint8_t len = security_ies[i + 1];
+        if (i + 2 + static_cast<size_t>(len) > security_ies.size()) {
+            break; // malformed / truncated
+        }
+        const uint8_t *body = &security_ies[i + 2];
+        if (eid == 0xDD && len >= 4 && body[0] == 0x50 && body[1] == 0x6F && body[2] == 0x9A) {
+            const uint8_t oui_type = body[3];
+            const uint8_t *ov      = body + 4;
+            const size_t ov_len    = static_cast<size_t>(len) - 4;
+            if (oui_type == 0x29) { // RSNOE -> override 1
+                have_o1 = parse_rsn_override_body(ov, ov_len, o1_km, o1_pw, o1_mfp);
+            } else if (oui_type == 0x2A) { // RSNO2E -> override 2
+                have_o2 = parse_rsn_override_body(ov, ov_len, o2_km, o2_pw, o2_mfp);
+            }
+        }
+        i += 2 + static_cast<size_t>(len);
+    }
+
+    // Write the six RSN-override parameters into the pWHM Security object. Empty strings
+    // clear the corresponding override (matches nl80211 clear_rsn_override_parameters()).
+    std::string wifi_ap_sec_path = vap_it->second.path + "Security.";
+    AmbiorixVariant new_obj(AMXC_VAR_ID_HTABLE);
+    new_obj.set_type(AMXC_VAR_ID_HTABLE);
+    new_obj.add_child("RSNOverrideKeyMgmt", have_o1 ? o1_km : std::string());
+    new_obj.add_child("RSNOverridePairwise", have_o1 ? o1_pw : std::string());
+    new_obj.add_child("RSNOverrideMFP", have_o1 ? o1_mfp : std::string());
+    new_obj.add_child("RSNOverrideKeyMgmt2", have_o2 ? o2_km : std::string());
+    new_obj.add_child("RSNOverridePairwise2", have_o2 ? o2_pw : std::string());
+    new_obj.add_child("RSNOverrideMFP2", have_o2 ? o2_mfp : std::string());
+
+    if (!m_ambiorix_cl.update_object(wifi_ap_sec_path, new_obj)) {
+        LOG(ERROR) << "update_bss_rsn_override: failed to set RSN Override params for "
+                   << vap_info.bss << " at " << wifi_ap_sec_path;
+        return false;
+    }
+
+    LOG(INFO) << "update_bss_rsn_override: bssid=" << bssid << " vap=" << vap_info.bss
+              << " override1{km=" << o1_km << " pw=" << o1_pw << " mfp=" << o1_mfp
+              << "} override2{km=" << o2_km << " pw=" << o2_pw << " mfp=" << o2_mfp << "}";
+    return true;
+}
