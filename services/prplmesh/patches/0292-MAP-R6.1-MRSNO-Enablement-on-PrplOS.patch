+    out.push_back(0xDD);        // Element ID: Vendor-Specific
+    out.push_back(0x1E);        // Length = 30
+    out.push_back(0x50);        // WFA OUI
+    out.push_back(0x6F);
+    out.push_back(0x9A);
+    out.push_back(oui_type);    // 0x29 (RSNOE) or 0x2A (RSNO2E)
+    out.push_back(0x01);        // Version
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Data Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x04);
+    out.push_back(0x01);        // Pairwise Cipher Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // Pairwise Cipher Suite = 00-0F-AC-<pairwise>
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(pairwise);
+    out.push_back(0x01);        // AKM Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // AKM Suite = 00-0F-AC-<akm>
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(akm);
+    out.push_back(kRsnCapsMfpRequired); // RSN Capabilities (low byte carries MFPC/MFPR)
+    out.push_back(0x00);        // RSN Capabilities (high byte)
+    out.push_back(0x00);        // PMKID Count = 0
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Management Cipher Suite = 00-0F-AC-06 (BIP-CMAC-128)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x06);
