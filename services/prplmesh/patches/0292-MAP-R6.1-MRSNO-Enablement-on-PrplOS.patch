+        if (configuration.additional_auth ==
+            son::wireless_utils::eAdditionalAuth::WPA3_PERSONAL_COMPATIBILITY) {
+            const bool include_akm8 =
+                (mode_enabled == "WPA3-Personal-Compatibility" ||
+                 mode_enabled == "WPA3-Personal-Compatibility-8");
+            const bool include_akm24 =
+                (mode_enabled == "WPA3-Personal-Compatibility" ||
+                 mode_enabled == "WPA3-Personal-Compatibility-24");
+
+            configuration.security_ies = build_wpa3_pcm_security_ies(include_akm8, include_akm24);
+            LOG(DEBUG) << "WPA3-PCM ModeEnabled='" << mode_enabled << "' on iface " << iface
+                       << " -> AKM8=" << include_akm8 << " AKM24=" << include_akm24
+                       << " security_ies=" << configuration.security_ies.size() << " bytes";
+        }
     }
 
     std::string encryption_mode;
