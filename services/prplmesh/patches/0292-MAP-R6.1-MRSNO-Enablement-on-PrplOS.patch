+// Build the spec-compliant WPA3-PCM SecurityIEs blob for a given AKM combination.
+std::vector<uint8_t> build_wpa3_pcm_security_ies(bool include_akm8, bool include_akm24)
+{
+    std::vector<uint8_t> out;
+    if (!include_akm8 && !include_akm24) {
