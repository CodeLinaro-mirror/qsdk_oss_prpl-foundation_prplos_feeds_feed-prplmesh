+/**
+ * @brief Warn (does not block) if the SecurityIEs blob about to be pushed to an Agent
+ * references AKM/cipher suites it did not advertise in its AKM Suite Capabilities /
+ * Supported Cipher Suites TLVs. Warning-only so cert flows testing unsupported selectors
+ * still work; pre-R6.1 agents (akm_valid/cipher_valid == false) are treated as unconstrained.
+ */
+static void validate_rsn_security_ies_against_agent_capabilities(
+    const prplmesh::controller::db::Agent &agent, const sMacAddr &ruid, uint8_t bss_index,
+    const uint8_t *ies, size_t ies_len)
+{
+    if (ies == nullptr || ies_len == 0) {
+        return;
+    }
+    const auto &caps = agent.security_capabilities;
+    if (!caps.akm_valid && !caps.cipher_valid) {
+        // Pre-R6.1 agent (or capability TLVs not yet received) — treat as "unconstrained".
+        return;
+    }
+
+    // Collect referenced AKM suite types and pairwise cipher suite types from the IE blob.
+    std::set<uint8_t> ref_akm_types;
+    std::set<uint8_t> ref_cipher_types;
+
+    auto scan_akm_and_cipher = [&](const uint8_t *body, size_t body_len, bool is_primary_rsne) {
+        // Shallow scan: both AKM and cipher selectors use the 00-0F-AC:xx pattern, so
+        // without a strict RSNE parse we can't disambiguate — feed into both sets.
+        (void)is_primary_rsne;
+        for (size_t k = 0; k + 4 <= body_len; ++k) {
+            if (body[k] == 0x00 && body[k + 1] == 0x0F && body[k + 2] == 0xAC) {
+                ref_akm_types.insert(body[k + 3]);
+                ref_cipher_types.insert(body[k + 3]);
+            }
+        }
+    };
+
+    size_t i = 0;
+    while (i + 2 <= ies_len) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + static_cast<size_t>(len) > ies_len) {
+            break; // malformed / truncated
+        }
+        const uint8_t *body = &ies[i + 2];
+        if (eid == 48 /* RSNE */) {
+            scan_akm_and_cipher(body, len, /*is_primary_rsne=*/true);
+        } else if (eid == 221 /* Vendor-Specific */ && len >= 4 && body[0] == 0x50 &&
+                   body[1] == 0x6F && body[2] == 0x9A) {
+            const uint8_t oui_type = body[3];
+            if (oui_type == 0x29 /* RSNOE */ || oui_type == 0x2A /* RSNO2E */) {
+                scan_akm_and_cipher(body + 4, static_cast<size_t>(len) - 4,
+                                    /*is_primary_rsne=*/false);
+            }
+        }
+        i += 2 + static_cast<size_t>(len);
+    }
+
+    if (ref_akm_types.empty() && ref_cipher_types.empty()) {
+        return;
+    }
+
+    // Compare against the Agent's advertised FH sets (RSN Parameters Configuration TLV
+    // targets fronthaul BSSes). Any selector that is present in the IE blob but absent
+    // from BOTH the fh AKM and fh cipher advertised sets is flagged.
+    auto is_advertised = [](uint8_t suite_type,
+                            const std::vector<wfa_map::tlvAkmSuiteCapabilities::sBssAkmSuiteSelector>
+                                &akm,
+                            const std::vector<wfa_map::tlvSupportedCipherSuites::sBssCipherSuiteSelector>
+                                &cipher) -> bool {
+        for (const auto &s : akm) {
+            if (s.akm_suite_type == suite_type) {
+                return true;
+            }
+        }
+        for (const auto &s : cipher) {
+            if (s.cipher_suite_type == suite_type) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    for (uint8_t t : ref_akm_types) {
+        // Skip the union check when the corresponding capability set was never advertised —
+        // an unconstrained side cannot generate a mismatch.
+        const bool akm_side_constrained    = caps.akm_valid && !caps.fh_akm_selectors.empty();
+        const bool cipher_side_constrained = caps.cipher_valid && !caps.fh_cipher_selectors.empty();
+        if (!akm_side_constrained && !cipher_side_constrained) {
+            continue;
+        }
+        if (!is_advertised(t, caps.fh_akm_selectors, caps.fh_cipher_selectors)) {
+            LOG(WARNING)
+                << "RSN Parameters Configuration TLV: agent " << agent.al_mac << " (ruid=" << ruid
+                << " bss_index=" << int(bss_index)
+                << ") is being pushed a SecurityIEs blob that references 00-0F-AC:"
+                << std::hex << int(t) << std::dec
+                << " which the Agent did NOT advertise in its AKM Suite Capabilities / Supported "
+                   "Cipher Suites TLVs — Agent may reject or silently downgrade the RSN Override "
+                   "configuration for this BSS";
+        }
+    }
+}
