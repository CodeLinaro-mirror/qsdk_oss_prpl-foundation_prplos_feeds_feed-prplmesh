+    out.push_back(0xDD);
+    out.push_back(0x05);        // Length = 5
+    out.push_back(0x50);
+    out.push_back(0x6F);
+    out.push_back(0x9A);
+    out.push_back(0x2B);        // OUI type: RSNXOE
+    out.push_back(0x20);        // Extended RSN Capabilities: SAE-H2E
+
+    return out;
+}
