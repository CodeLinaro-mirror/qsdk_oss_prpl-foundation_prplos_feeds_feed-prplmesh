+//   "...-8"  -> RSNE(SAE) + RSNOE(AKM8)                + RSNXOE
+//   "...-24" -> RSNE(SAE) + RSNO2E(AKM24)               + RSNXOE
+//   "..."    -> RSNE(SAE) + RSNOE(AKM8) + RSNO2E(AKM24) + RSNXOE
