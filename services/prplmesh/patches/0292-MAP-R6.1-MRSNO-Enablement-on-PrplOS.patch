+    out.push_back(0x30);        // Element ID: RSNE
+    out.push_back(0x1A);        // Length = 26
+    out.push_back(0x01);        // Version
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Data Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x04);
+    out.push_back(0x01);        // Pairwise Cipher Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // Pairwise Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x04);
+    out.push_back(0x01);        // AKM Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // AKM Suite = 00-0F-AC-08 (SAE)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x08);
+    out.push_back(kRsnCapsMfpRequired); // RSN Capabilities low byte = MFPC+MFPR
+    out.push_back(0x00);        // RSN Capabilities high byte
+    out.push_back(0x00);        // PMKID Count = 0
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Management Cipher Suite = 00-0F-AC-06
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x06);
+
+    if (include_akm8) {
+        // RSNOE (0x29): AKM = SAE (0x08), pairwise = CCMP (0x04).
+        append_rsn_override_element(out, 0x29, /*akm=*/0x08, /*pairwise=*/0x04);
+    }
