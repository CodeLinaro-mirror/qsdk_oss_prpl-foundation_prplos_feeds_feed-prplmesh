     return true;
 }
 
-bool ap_wlan_hal_whm::process_reconfig_complete_event(const bool &result)
-{
-    // Push the event
-    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(bool));
-    auto msg = reinterpret_cast<bool *>(msg_buff.get());
-    LOG_IF(!msg, FATAL) << "Memory allocation failed!";
-
-    // Initialize the message
-    memset(msg_buff.get(), 0, sizeof(bool));
-
-    *msg = result;
-
-    LOG(DEBUG) << "Push Event:MLD_Reconfig_Complete_Notification to ApManager with result: " << (result ? "success" : "fail");
-    event_queue_push(Event::MLD_Reconfig_Complete_Notification, msg_buff);
-    return true;
-}
-
 bool ap_wlan_hal_whm::process_wpa_ctrl_event(const beerocks::wbapi::AmbiorixVariant &event_data)
 {
     std::string event_str;
@@ -2010,6 +1992,18 @@ bool ap_wlan_hal_whm::remove_affiliated_ap(const sMacAddr &bss_id)
 	return false;
     }
 
+    // Disable AP to remove Affiliated AP
+    AmbiorixVariant new_ap_obj(AMXC_VAR_ID_HTABLE);
+    vap_it->second.teardown = true;
+    LOG(INFO) << "BSS " << bssid << " flagged for tear down(Link Removal)";
+    new_ap_obj.add_child<bool>("Enable", false);
+    if (m_ambiorix_cl.update_object(vap_it->second.path, new_ap_obj)) {
+        LOG(DEBUG) << "Set Enable to 0 for BSSID: " << bssid << " to remove Affiliated AP";
+    } else {
+        LOG(ERROR) << "Failed to set Enable to 0 for " << ifname << " BSSID: " << bssid;
+       return false;
+    }
+
     return true;
 }
 
