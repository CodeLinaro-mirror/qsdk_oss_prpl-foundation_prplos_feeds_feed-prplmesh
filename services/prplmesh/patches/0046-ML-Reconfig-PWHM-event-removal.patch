@@ -3242,22 +3242,6 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
         encap_1905_dpp_tlv->set_dest_sta_mac(dpp_configuration_request->enrollee_mac);
         send_cmdu(cmdu_tx);
     } break;
-    case Event::MLD_Reconfig_Complete_Notification: {
-        // Send Reconfig Complete Notification
-        auto notification = message_com::create_vs_message<
-            beerocks_message::cACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION>(cmdu_tx);
-        if (notification == nullptr) {
-            LOG(ERROR)
-                << "Failed building cACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION message!";
-            break;
-        }
-        auto result = static_cast<bool*>(data);
-        notification->result() = *result;
-
-        LOG(DEBUG) << "Sending ACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION Message";
-        send_cmdu(cmdu_tx);
-
-    } break;
     // Unhandled events
     default:
         LOG(ERROR) << "Unhandled event: " << int(event);
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
