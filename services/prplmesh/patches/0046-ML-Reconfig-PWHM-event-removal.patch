 }
 
 bool ApAutoConfigurationTask::handle_vendor_specific(
@@ -531,10 +533,6 @@ bool ApAutoConfigurationTask::handle_vendor_specific(
         handle_vs_get_mld_neighbor_bss_config_response(cmdu_rx, sd, beerocks_header);
         break;
     }
-    case beerocks_message::ACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION: {
-        handle_vs_reconfig_complete_notification(cmdu_rx, sd, beerocks_header);
-        break;
-    }
 
     default: {
         // Message was not handled, therefore return false.
@@ -2453,47 +2451,6 @@ void ApAutoConfigurationTask::handle_vs_get_mld_neighbor_bss_config_response(
     return;
 }
 
-void ApAutoConfigurationTask::handle_vs_reconfig_complete_notification(
-     ieee1905_1::CmduMessageRx &cmdu_rx, int fd, std::shared_ptr<beerocks_header> beerocks_header)
-{
-    LOG(DEBUG) << "Received ACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION message";
-    auto notification = beerocks_header
-            ->addClass<beerocks_message::cACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION>();
-    if (!notification) {
-        LOG(ERROR) << "addClass cACTION_APMANAGER_MLD_RECONFIG_COMPLETE_NOTIFICATION failed";
-        return;
-    }
-
-    auto result = static_cast<bool>(notification->result());
-
-    if (result) {
-        LOG(DEBUG) << "RECONFIG Completed sucessfully";
-    } else {
-        LOG(DEBUG) << "RECONFIG failed";
-    }
-
-    // Send AP MLD Configuration Message only if apmld_reconfig_pending is true
-    if (apmld_reconfig_pending) {
-        // Clear apmld_reconfig_pending to prevent sending reconfig response in future
-        apmld_reconfig_pending = 0;
-        // Send AP MLD Configuration Response Message as we got ACK for our request
-        auto cmdu_tx_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::AP_MLD_CONFIGURATION_RESPONSE_MESSAGE);
-
-        if (!cmdu_tx_header) {
-            LOG(ERROR) << "cmdu creation of type AP_MLD_CONFIGURATION_RESPONSE_MESSAGE, has failed";
-            return;
-        }
-
-        if (!add_agent_ap_mld_configuration_tlv()) {
-            LOG(ERROR) << "Failed to add Agent AP MLD Configuration TLV";
-            return;
-        }
-
-        LOG(DEBUG) << "Sending AP_MLD_CONFIGURATION_RESPONSE_MESSAGE message";
-        m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
-    }
-}
-
 bool ApAutoConfigurationTask::airties_vs_ap_autoconfiguration_wsc_parse_hidden_ssid(
     WSC::m2 &m2, WSC::configData::config &config)
 {
@@ -3289,3 +3246,24 @@ bool ApAutoConfigurationTask::send_affiliated_ap_remove_request(const sMacAddr &
     m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
     return true;
 }
+
+bool ApAutoConfigurationTask::send_ap_mld_configuration_response_message()
+{
+    // Send AP MLD Configuration Response Message
+    auto cmdu_tx_header = m_cmdu_tx.create(0, ieee1905_1::eMessageType::AP_MLD_CONFIGURATION_RESPONSE_MESSAGE);
+
+    if (!cmdu_tx_header) {
+        LOG(ERROR) << "cmdu creation of type AP_MLD_CONFIGURATION_RESPONSE_MESSAGE, has failed";
+        return false;
+    }
+
+    if (!add_agent_ap_mld_configuration_tlv()) {
+        LOG(ERROR) << "Failed to add Agent AP MLD Configuration TLV";
+        return false;
+    }
+
+    LOG(DEBUG) << "Sending AP_MLD_CONFIGURATION_RESPONSE_MESSAGE message";
+    m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+
+    return true;
+}
