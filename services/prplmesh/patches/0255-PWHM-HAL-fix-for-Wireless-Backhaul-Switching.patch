diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
index 6b99ea872..896f77c3d 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
@@ -61,7 +61,47 @@ static AmbiorixVariantSmartPtr bpl_cfg_get_wifi_radio_object(const AmbiorixVaria
 
 static AmbiorixVariantSmartPtr bpl_cfg_get_wifi_security_object(const std::string &iface)
 {
-    return m_ambiorix_cl.get_object(wbapi_utils::search_path_ap_by_iface(iface) + "Security.");
+    // First, try to get Security object for AccessPoint (AP interface)
+    auto ap_sec_obj = m_ambiorix_cl.get_object(wbapi_utils::search_path_ap_by_iface(iface) + "Security.");
+    if (ap_sec_obj) {
+        MAPF_DBG("Found AP Security object for interface: " << iface);
+        return ap_sec_obj;
+    }
+
+    // If not found as AP, try to get Security object for EndPoint (STA interface)
+    // For EndPoint, we need to find the Profile with Alias "prplMesh" and return its Security object
+    MAPF_DBG("Interface " << iface << " not found as AP, trying as EndPoint (STA)");
+
+    // Get the EndPoint object for this interface
+    auto ep_path = wbapi_utils::search_path_ep_by_iface(iface);
+    auto ep_obj = m_ambiorix_cl.get_object(ep_path);
+    if (!ep_obj) {
+        MAPF_ERR("Failed to find EndPoint object for interface: " << iface);
+        return nullptr;
+    }
+
+    // Get all profiles for this EndPoint
+    auto profiles_path = wbapi_utils::search_path_ep_profiles_by_iface(iface);
+    auto profiles = m_ambiorix_cl.get_object_multi<AmbiorixVariantMapSmartPtr>(profiles_path);
+    if (!profiles) {
+        MAPF_ERR("Failed to get profiles for EndPoint interface: " << iface);
+        return nullptr;
+    }
+
+    // Find the profile with Alias "prplMesh"
+    for (auto const &it : *profiles) {
+        auto &profile = it.second;
+        std::string alias;
+        if (profile.read_child(alias, "Alias") && alias == "prplMesh") {
+            // Found prplMesh profile, return its Security object
+            std::string profile_sec_path = it.first + "Security.";
+            MAPF_DBG("Found Profile with Alias 'prplMesh' Security object at: " << profile_sec_path);
+            return m_ambiorix_cl.get_object(profile_sec_path);
+        }
+    }
+
+    MAPF_ERR("No Profile with Alias 'prplMesh' found for EndPoint interface: " << iface);
+    return nullptr;
 }
 
 int cfg_get_all_prplmesh_wifi_interfaces(BPL_WLAN_IFACE *interfaces, int *num_of_interfaces)
@@ -264,8 +304,8 @@ bool bpl_cfg_get_wifi_credentials(const std::string &iface,
