From 5779d2f8cdc8d8d4f8bf070147473acc6559921d Mon Sep 17 00:00:00 2001
From: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
Date: Thu, 18 Jun 2026 23:30:15 +0530
Subject: [PATCH] NBAPI added to retrive the EHT capabilities of agents

Signed-off-by: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
---
 controller/nbapi/odl/bss.odl.in               | 18 +++++++
 controller/src/beerocks/master/controller.cpp |  4 ++
 controller/src/beerocks/master/db/db.cpp      | 51 +++++++++++++++----
 3 files changed, 64 insertions(+), 9 deletions(-)

diff --git a/controller/nbapi/odl/bss.odl.in b/controller/nbapi/odl/bss.odl.in
index 6bbf79849..3b698db8c 100644
--- a/controller/nbapi/odl/bss.odl.in
+++ b/controller/nbapi/odl/bss.odl.in
@@ -106,6 +106,24 @@
             %in %mandatory uint16 DisabledSubchannelBitmap
         );
 
+        /**
+        * EHT (802.11be) operation parameters reported by the BSS via the EHT Operations TLV
+        * in the Operating Channel Report message.
+        * @version ezmesh
+        */
+        %read-only object EHTOperation {
+            %read-only uint32 BasicEHTMCSAndNSSSet = 0;
+            %read-only bool EHTDefaultPEDuration = false;
+            %read-only bool GroupAddressedBUIndicationLimit = false;
+            %read-only uint32 GroupAddressedBUIndicationExponent = 0;
+            %read-only bool EHTOperationInformationValid = false;
+            %read-only uint32 Control = 0;
+            %read-only uint32 CCFS0 = 0;
+            %read-only uint32 CCFS1 = 0;
+            %read-only bool DisabledSubchannelBitmapValid = false;
+            %read-only uint32 DisabledSubchannelBitmap = 0;
+        }
+
         /**
         * Object describing a single Associated Device (STA).
         * At most one entry in this table can exist with a given value for MACAddress.
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index b2a0132b4..3f50265f1 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -2904,6 +2904,10 @@ bool Controller::handle_cmdu_1905_operating_channel_report(const sMacAddr &src_m
         }
     }
 
+    if (!handle_tlv_eht_operations(cmdu_rx, src_mac)) {
+        LOG(ERROR) << "Failed to process EHT Operations TLV in Operating Channel Report";
+    }
+
     // send ACK_MESSAGE back to the Agent
     if (!cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE)) {
         LOG(ERROR) << "cmdu creation of type ACK_MESSAGE, has failed";
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 6aecfbcfb..8c9cc3873 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -1936,17 +1936,50 @@ void db::set_internal_eht_operations(wfa_map::cBssEntry &eht_operations_bss,
 
 bool db::set_external_eht_operations(Agent::sRadio::sBss &bss)
 {
-    bool ret_val(true);
+    if (bss.dm_path.empty()) {
+        LOG(DEBUG) << "BSS dm_path empty, skipping EHT operations DM update for " << bss.bssid;
+        return true;
+    }
 
-    // Needs DM node to be used
+    const std::string eht_op_path = bss.dm_path + ".EHTOperation";
 
-    // Device.x.APMLD.x.AffiliatedAP.x.
-    // std::string path_to_obj_affiliated_ap = "TBD";
-    // if (bss.eht_operations.sub_channel_bitmap.valid) {
-    //     ret_val &= m_ambiorix_datamodel->set(
-    //         path_to_obj_affiliated_ap, "DisabledSubChannels",
-    //         bss.eht_operations.sub_channel_bitmap.disabled_subchannel_bitmap);
-    // }
+    bool ret_val = true;
+
+    ret_val &= m_ambiorix_datamodel->set(eht_op_path, "BasicEHTMCSAndNSSSet",
+                                         bss.eht_operations.basic_eht_mcs_and_nss_set);
+    ret_val &= m_ambiorix_datamodel->set(eht_op_path, "EHTDefaultPEDuration",
+                                         bss.eht_operations.eht_default_pe_duration);
+    ret_val &= m_ambiorix_datamodel->set(eht_op_path, "GroupAddressedBUIndicationLimit",
+                                         bss.eht_operations.group_address_bu.indication_limit);
+    ret_val &= m_ambiorix_datamodel->set(
+        eht_op_path, "GroupAddressedBUIndicationExponent",
+        static_cast<uint32_t>(bss.eht_operations.group_address_bu.indication_exponent));
+
+    ret_val &= m_ambiorix_datamodel->set(eht_op_path, "EHTOperationInformationValid",
+                                         bss.eht_operations.eht_operation_informations.valid);
+    if (bss.eht_operations.eht_operation_informations.valid) {
+        ret_val &= m_ambiorix_datamodel->set(
+            eht_op_path, "Control",
+            static_cast<uint32_t>(bss.eht_operations.eht_operation_informations.control));
+        ret_val &= m_ambiorix_datamodel->set(
+            eht_op_path, "CCFS0",
+            static_cast<uint32_t>(bss.eht_operations.eht_operation_informations.ccfs0));
+        ret_val &= m_ambiorix_datamodel->set(
+            eht_op_path, "CCFS1",
+            static_cast<uint32_t>(bss.eht_operations.eht_operation_informations.ccfs1));
+    }
+
+    ret_val &= m_ambiorix_datamodel->set(eht_op_path, "DisabledSubchannelBitmapValid",
+                                         bss.eht_operations.sub_channel_bitmap.valid);
+    if (bss.eht_operations.sub_channel_bitmap.valid) {
+        ret_val &= m_ambiorix_datamodel->set(
+            eht_op_path, "DisabledSubchannelBitmap",
+            static_cast<uint32_t>(bss.eht_operations.sub_channel_bitmap.disabled_subchannel_bitmap));
+    }
+
+    if (!ret_val) {
+        LOG(ERROR) << "Failed to set one or more EHTOperation DM fields for BSS " << bss.bssid;
+    }
 
     return ret_val;
 }
-- 
2.34.1

