+++ b/agent/src/beerocks/slave/tasks/topology_task.cpp
@@ -113,11 +113,13 @@ void TopologyTask::work()
         send_topology_notification();
     }
 
+#ifndef BEEROCKS_RDKB
     // Don't send topology discovery if the Controller hasn't been discovered and in Controller Only Mode
     if ((db->controller_info.bridge_mac == network_utils::ZERO_MAC) &&
         (db->device_conf.management_mode != BPL_MGMT_MODE_MULTIAP_CONTROLLER)) {
         return;
     }
+#endif // BEEROCKS_RDKB
 
     // Send topology discovery every 60 seconds according to IEEE_Std_1905.1-2013 specification
     if (now - m_periodic_discovery_timestamp >
@@ -160,6 +162,10 @@ bool TopologyTask::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t ifac
         handle_topology_query(cmdu_rx, src_mac);
         break;
     }
+    case ieee1905_1::eMessageType::TOPOLOGY_NOTIFICATION_MESSAGE: {
+        handle_topology_notification(cmdu_rx, src_mac);
+        break;
+    }
     case ieee1905_1::eMessageType::VENDOR_SPECIFIC_MESSAGE: {
         return handle_vendor_specific(cmdu_rx, src_mac, beerocks_header);
     }
@@ -251,6 +257,27 @@ void TopologyTask::handle_topology_discovery(ieee1905_1::CmduMessageRx &cmdu_rx,
     }
 }
 
+void TopologyTask::handle_topology_notification(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                const sMacAddr &src_mac)
+{
+    const auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received TOPOLOGY_NOTIFICATION_MESSAGE from " << src_mac 
+              << ", mid=" << std::hex << mid;
+    
+    // According to IEEE 1905.1 specification, when a device receives a Topology Notification,
+    // it should send a Topology Query to the sender to get updated topology information
+    auto cmdu_tx_header =
+        m_cmdu_tx.create(0, ieee1905_1::eMessageType::TOPOLOGY_QUERY_MESSAGE);
+    if (!cmdu_tx_header) {
+        LOG(ERROR) << "Failed creating topology query message";
+        return;
+    }
+    
+    auto db = AgentDB::get();
+    LOG(DEBUG) << "Sending TOPOLOGY_QUERY_MESSAGE to " << src_mac;
+    m_btl_ctx.send_cmdu_to_broker(m_cmdu_tx, src_mac, db->bridge.mac);
+}
