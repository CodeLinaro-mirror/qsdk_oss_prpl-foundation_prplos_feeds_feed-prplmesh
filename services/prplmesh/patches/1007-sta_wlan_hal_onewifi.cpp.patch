+static webconfig_error_t webconfig_dummy_apply(webconfig_subdoc_t *doc,
+                                               webconfig_subdoc_data_t *data)
+{
+    (void)doc;
+    (void)data;
+    return webconfig_error_none;
+}
+
+static bus_error_t sta_north_cb(char *event_name, bus_data_prop_t *prop, void *ctx)
+{
+    (void)event_name;
+    auto *self = static_cast<sta_wlan_hal_onewifi *>(ctx);
+    if (!self || !prop || !prop->value.raw_data.bytes) {
+        ONEWIFI_LOG_WARN("sta_north_cb: null or empty data");
+        return bus_error_invalid_input;
+    }
+    const char *json_str = static_cast<const char *>(prop->value.raw_data.bytes);
+    self->on_onewifi_north_data(json_str, strlen(json_str));
+    return bus_error_success;
+}
+
+static bus_error_t sta_assoc_status_cb(char *event_name, bus_data_prop_t *prop, void *ctx)
+{
+    (void)event_name;
+    auto *self = static_cast<sta_wlan_hal_onewifi *>(ctx);
+    if (!self || !prop || !prop->value.raw_data.bytes || prop->value.raw_data_len == 0) {
+        ONEWIFI_LOG_WARN("sta_assoc_status_cb: null or empty data");
+        return bus_error_invalid_input;
+    }
+    self->on_sta_assoc_status_data(static_cast<const char *>(prop->value.raw_data.bytes),
+                                   prop->value.raw_data_len);
+    return bus_error_success;
+}
