 common/beerocks/bwl/onewifi/sta_wlan_hal_onewifi.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/bwl/onewifi/sta_wlan_hal_onewifi.cpp b/common/beerocks/bwl/onewifi/sta_wlan_hal_onewifi.cpp
index 6508d74bb..28ac0f4a9 100644
