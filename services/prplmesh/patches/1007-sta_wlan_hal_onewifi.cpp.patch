-bool sta_wlan_hal_onewifi::start_wps_pbc()
+HALState sta_wlan_hal_onewifi::attach(bool block)
 {
+    HALState state = base_wlan_hal_onewifi::attach(block);
+    if (state != HALState::Operational) return state;
+
+    ONEWIFI_LOG_INFO("STA: Attaching OneWifi STA HAL for interface: %s", get_iface_name().c_str());
+
+    if (!check_and_open_bus()) {
+        ONEWIFI_LOG_ERROR("STA: Failed to open OneWifi bus connection");
+        return (m_hal_state = HALState::Failed);
+    }
+
+    wifi_bus_desc_t *bus_desc = get_bus_descriptor();
+    if (!bus_desc) {
+        ONEWIFI_LOG_ERROR("STA: Failed to get OneWifi bus descriptor");
+        return (m_hal_state = HALState::Failed);
+    }
+
+    using bus_event_cb_fn_t = bus_error_t (*)(char *, bus_data_prop_t *, void *);
+
+    struct EventSub {
+        const char       *event_name;
+        bus_event_cb_fn_t callback;
+        bool              is_critical;
+    };
+
+    EventSub subs[] = {
+        {ONEWIFI_WEBCONFIG_DOC_DATA_NORTH, sta_north_cb,        true},
+        {ONEWIFI_ASSOC_STATUS_EVENT,       sta_assoc_status_cb, true},
+    };
+
+    for (const auto &s : subs) {
+        if (bus_desc->bus_event_subs_fn(m_bus_hdl_ptr, s.event_name,
+                                        reinterpret_cast<void *>(s.callback),
+                                        this, 0) != bus_error_success) {
+            if (s.is_critical) {
+                ONEWIFI_LOG_ERROR("STA: Failed to subscribe to critical event: %s", s.event_name);
+                return (m_hal_state = HALState::Failed);
+            }
+            ONEWIFI_LOG_WARN("STA: Failed to subscribe to optional event: %s", s.event_name);
+        } else {
+            ONEWIFI_LOG_INFO("STA: Subscribed to %s", s.event_name);
+        }
+    }
+
+    raw_data_t init_data = {};
+    static constexpr int MAX_INIT_RETRIES = 10;
+    static constexpr int RETRY_SLEEP_MS  = 500;
+    int num_retry = 0;
+
+    if (bus_desc->bus_data_get_fn) {
+        while (bus_desc->bus_data_get_fn(m_bus_hdl_ptr, ONEWIFI_WEBCONFIG_INIT_DML_DATA,
+                                         &init_data) != bus_error_success) {
+            ONEWIFI_LOG_WARN("STA: Failed to get initial DML data, retry %d", num_retry + 1);
+            if (++num_retry >= MAX_INIT_RETRIES) {
+                ONEWIFI_LOG_ERROR("STA: Exceeded max retries for DML data");
+                break;
+            }
+            usleep(RETRY_SLEEP_MS * 1000);
+        }
+    }
+
+    if (init_data.raw_data.bytes && init_data.raw_data_len > 0) {
+        std::unique_ptr<void, decltype(&free)> bytes_guard(init_data.raw_data.bytes, free);
+        init_data.raw_data.bytes = nullptr;
+        ONEWIFI_LOG_INFO("STA: Received initial DML data from OneWifi");
+        on_onewifi_north_data(reinterpret_cast<const char *>(bytes_guard.get()),
+                              init_data.raw_data_len);
+    } else if (num_retry >= MAX_INIT_RETRIES) {
+        ONEWIFI_LOG_ERROR("STA: Failed to get DML data after %d retries, HAL Failed", MAX_INIT_RETRIES);
+        return (m_hal_state = HALState::Failed);
+    }
+
+    ONEWIFI_LOG_INFO("STA: HAL attached successfully for interface: %s", get_iface_name().c_str());
+    return HALState::Operational;
+}
+
+bool sta_wlan_hal_onewifi::detach()
+{
+    if (m_hal_state == HALState::Uninitialized) return true;
+
+    wifi_bus_desc_t *bus_desc = get_bus_descriptor();
+    if (bus_desc && bus_desc->bus_event_unsubs_fn) {
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_WEBCONFIG_DOC_DATA_NORTH);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_ASSOC_STATUS_EVENT);
+    }
+    if (bus_desc && bus_desc->bus_close_fn) {
+        bus_desc->bus_close_fn(m_bus_hdl_ptr);
+    }
+    if (m_bus_hdl_ptr) memset(m_bus_hdl_ptr, 0, sizeof(bus_handle_t));
+
+    return base_wlan_hal_onewifi::detach();
+}
