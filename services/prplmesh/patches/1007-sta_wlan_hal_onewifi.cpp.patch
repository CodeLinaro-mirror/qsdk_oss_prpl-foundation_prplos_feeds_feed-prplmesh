+void sta_wlan_hal_onewifi::on_onewifi_north_data(const char *json_str, unsigned int len)
+{
+    if (!json_str || len == 0) return;
+
+    ONEWIFI_LOG_INFO("STA: on_onewifi_north_data: len=%u", len);
+
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_private;
+    bool decode_needed           = false;
+    bool is_radio_subdoc         = false;
+
+    {
+        cJSON *json = cJSON_ParseWithLength(json_str, len);
+        if (!json) { ONEWIFI_LOG_ERROR("STA: failed to parse JSON"); return; }
+
+        cJSON *name_item = cJSON_GetObjectItemCaseSensitive(json, "SubDocName");
+        if (!cJSON_IsString(name_item) || !name_item->valuestring) {
+            cJSON_Delete(json); return;
+        }
+        const char *name = name_item->valuestring;
+        ONEWIFI_LOG_DEBUG("STA: SubDocName=%s", name);
+
+        if (strcmp(name, "dml") == 0) {
+            type = webconfig_subdoc_type_dml;
+            decode_needed = true;
+        } else if (strcmp(name, "radio") == 0) {
+            type = webconfig_subdoc_type_radio;
+            decode_needed = is_radio_subdoc = true;
+        } else if (strcmp(name, "radio_6G") == 0) {
+            type = webconfig_subdoc_type_radio_6G;
+            decode_needed = is_radio_subdoc =
+                (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G);
+        } else if (strcmp(name, "radio_5G") == 0) {
+            type = webconfig_subdoc_type_radio_5G;
+            decode_needed = is_radio_subdoc =
+                (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G);
+        } else if (strcmp(name, "radio_2.4G") == 0) {
+            type = webconfig_subdoc_type_radio_24G;
+            decode_needed = is_radio_subdoc =
+                (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G);
+        } else if (strcmp(name, "mesh sta") == 0 || strcmp(name, "mesh_sta") == 0) {
+            type = webconfig_subdoc_type_mesh_sta;
+            decode_needed = true;
+        } else if (strcmp(name, "mesh backhaul sta") == 0 || strcmp(name, "mesh_backhaul_sta") == 0) {
+            type = webconfig_subdoc_type_mesh_backhaul_sta;
+            decode_needed = true;
+        } else {
+            ONEWIFI_LOG_DEBUG("STA: unhandled SubDocName=%s, skipping", name);
+            cJSON_Delete(json);
+            return;
+        }
+
+        cJSON_Delete(json);
+    }
+
+    if (!decode_needed) return;
+
+    if (type == webconfig_subdoc_type_dml || is_radio_subdoc) {
+        m_data_model->set_num_op_class(0);
+    }
+
+    webconfig_external_easymesh_t ext_data = {};
+    webconfig_t config = {};
+
+    if (!init_webconfig_for_decode(ext_data, config)) {
+        ONEWIFI_LOG_ERROR("STA: webconfig init failed for type=%d", type);
+        return;
+    }
+
+    webconfig_error_t rc = safe_webconfig_decode(&config, json_str, &ext_data, &type);
+    if (rc != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("STA: decode failed type=%d error=%d", type, rc);
+        return;
+    }
+
+    ONEWIFI_LOG_DEBUG("STA: decoded subdoc type=%d radios=%u bss=%u",
+                      type, m_data_model->get_num_radios(), m_data_model->get_num_bss());
+
+    if ((type == webconfig_subdoc_type_dml || is_radio_subdoc) &&
+        m_data_model->get_num_radios() > 0) {
+        update_radio_info_from_data_model();
+        ONEWIFI_LOG_INFO("STA: radio info updated for subdoc type=%d", type);
+    }
+
+    bool push_scan_results = false;
+    std::shared_ptr<void> connected_msg;
+    std::shared_ptr<void> disconnected_msg;
+    std::string connected_bssid_log;
+    std::string connected_ssid_log;
+    std::string disconnected_iface_log;
+
+    {
+        std::lock_guard<std::mutex> lock(m_state_mutex);
+
+        if (m_scan_pending && m_data_model->get_num_scan_results() > 0) {
+            m_scan_pending    = false;
+            push_scan_results = true;
+        }
+
+        for (unsigned int i = 0; i < m_data_model->get_num_bss(); i++) {
+            em_bss_info_t *bss = m_data_model->get_bss_info(i);
+            if (!bss) continue;
+            if (bss->id.haul_type != em_haul_type_backhaul) continue;
+            if (bss->vap_mode != em_vap_mode_sta) continue;
+
+            bool now_connected = bss->connect_status;
+            ONEWIFI_LOG_INFO("STA: bSTA ssid='%s' connect_status=%d (was %d)",
+                             bss->ssid, now_connected ? 1 : 0, m_connected ? 1 : 0);
+
+            if (now_connected && !m_connected) {
+                char bssid_buf[20] = {};
+                snprintf(bssid_buf, sizeof(bssid_buf), "%02x:%02x:%02x:%02x:%02x:%02x",
+                         bss->bssid.mac[0], bss->bssid.mac[1], bss->bssid.mac[2],
+                         bss->bssid.mac[3], bss->bssid.mac[4], bss->bssid.mac[5]);
+                m_active_ssid  = bss->ssid;
+                m_active_bssid = bssid_buf;
+                m_connected    = true;
+                m_connecting   = false;
+
+                auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
+                auto msg = reinterpret_cast<sACTION_BACKHAUL_CONNECTED_NOTIFICATION *>(msg_buff.get());
+                LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+                memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
+                msg->multi_ap_profile         = static_cast<uint8_t>(get_hal_conf().multi_ap_profile);
+                msg->multi_ap_primary_vlan_id = get_multi_ap_primary_vlan_id();
+                msg->ap_mld_mac_addr          = get_ap_mld_mac();
+                msg->bsta_mld_mac_addr        = get_bsta_mld_mac();
+                connected_msg       = msg_buff;
+                connected_bssid_log = bssid_buf;
+                connected_ssid_log  = m_active_ssid;
+
+            } else if (!now_connected && m_connected) {
+                m_connected      = false;
+                m_connecting     = false;
+                m_active_bssid   = "";
+                m_active_channel = 0;
+
+                auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_BACKHAUL_DISCONNECT_REASON_NOTIFICATION));
+                auto msg = reinterpret_cast<sACTION_BACKHAUL_DISCONNECT_REASON_NOTIFICATION *>(msg_buff.get());
+                LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+                memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_DISCONNECT_REASON_NOTIFICATION));
+                disconnected_msg       = msg_buff;
+                disconnected_iface_log = get_iface_name();
+            }
+            break;
+        }
+    }
+
+    // Push events outside the lock — consumers may re-enter locked HAL methods
+    if (push_scan_results) {
+        event_queue_push(Event::ScanResults);
+        ONEWIFI_LOG_INFO("STA: scan results available, pushed ScanResults");
+    }
+    if (connected_msg) {
+        event_queue_push(Event::Connected, connected_msg);
+        ONEWIFI_LOG_INFO("STA: Pushed Connected event bssid=%s ssid='%s'",
+                         connected_bssid_log.c_str(), connected_ssid_log.c_str());
+    }
+    if (disconnected_msg) {
+        event_queue_push(Event::Disconnected, disconnected_msg);
+        ONEWIFI_LOG_INFO("STA: Pushed Disconnected event for iface=%s", disconnected_iface_log.c_str());
+    }
+}
+
+void sta_wlan_hal_onewifi::on_sta_assoc_status_data(const char *data, unsigned int len)
+{
+    if (!data || len < sizeof(rdk_sta_data_t)) {
+        ONEWIFI_LOG_WARN("STA: on_sta_assoc_status_data: invalid len=%u", len);
+        return;
+    }
+
+    const rdk_sta_data_t *sta_data = reinterpret_cast<const rdk_sta_data_t *>(data);
+
+    if (strncmp(sta_data->interface_name, get_iface_name().c_str(),
+                sizeof(sta_data->interface_name) - 1) != 0) {
+        return;
+    }
+
+    bool now_connected = (sta_data->stats.connect_status != 0);
+
+    ONEWIFI_LOG_INFO("STA: AssocStatus: iface=%s connected=%d",
+                     sta_data->interface_name, now_connected ? 1 : 0);
+
+    std::shared_ptr<void> connected_msg;
+    std::shared_ptr<void> disconnected_msg;
+    std::string connected_bssid_log;
+    std::string connected_ssid_log;
+    std::string disconnected_iface_log;
+
+    {
+        std::lock_guard<std::mutex> lock(m_state_mutex);
+        if (now_connected && !m_connected) {
+            char bssid_buf[20] = {};
+            snprintf(bssid_buf, sizeof(bssid_buf), "%02x:%02x:%02x:%02x:%02x:%02x",
+                     sta_data->bss_info.bssid[0], sta_data->bss_info.bssid[1],
+                     sta_data->bss_info.bssid[2], sta_data->bss_info.bssid[3],
+                     sta_data->bss_info.bssid[4], sta_data->bss_info.bssid[5]);
+            m_active_bssid = bssid_buf;
+            m_active_ssid  = sta_data->bss_info.ssid;
+            m_connected    = true;
+            m_connecting   = false;
+
+            auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_BACKHAUL_CONNECTED_NOTIFICATION *>(msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
+            msg->multi_ap_profile         = static_cast<uint8_t>(get_hal_conf().multi_ap_profile);
+            msg->multi_ap_primary_vlan_id = get_multi_ap_primary_vlan_id();
+            msg->ap_mld_mac_addr          = get_ap_mld_mac();
+            msg->bsta_mld_mac_addr        = get_bsta_mld_mac();
+            connected_msg       = msg_buff;
+            connected_bssid_log = bssid_buf;
+            connected_ssid_log  = m_active_ssid;
+
+        } else if (!now_connected && m_connected) {
+            m_connected      = false;
+            m_connecting     = false;
+            m_active_bssid   = "";
+            m_active_channel = 0;
+
+            auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_BACKHAUL_DISCONNECT_REASON_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_BACKHAUL_DISCONNECT_REASON_NOTIFICATION *>(msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_DISCONNECT_REASON_NOTIFICATION));
+            disconnected_msg       = msg_buff;
+            disconnected_iface_log = sta_data->interface_name;
+        }
+    }
+
+    // Push events outside the lock — consumers may re-enter locked HAL methods
+    if (connected_msg) {
+        event_queue_push(Event::Connected, connected_msg);
+        ONEWIFI_LOG_INFO("STA: AssocStatus Connected, bssid=%s ssid='%s'",
+                         connected_bssid_log.c_str(), connected_ssid_log.c_str());
+    }
+    if (disconnected_msg) {
+        event_queue_push(Event::Disconnected, disconnected_msg);
+        ONEWIFI_LOG_INFO("STA: AssocStatus Disconnected, iface=%s", disconnected_iface_log.c_str());
+    }
+}
