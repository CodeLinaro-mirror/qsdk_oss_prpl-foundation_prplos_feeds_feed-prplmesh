+++ b/common/beerocks/bwl/onewifi/sta_wlan_hal_onewifi.cpp
@@ -5,6 +5,7 @@
 #include "sta_wlan_hal_onewifi.h"
 
 #include <easylogging++.h>
+#include <bcl/network/network_utils.h>
 
 namespace bwl {
 namespace onewifi {
@@ -115,7 +116,11 @@ bool sta_wlan_hal_onewifi::clear_non_associated_devices()
 
 std::string sta_wlan_hal_onewifi::get_wireless_backhaul_mac()
 {
-    return "";
+    std::string mac;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(get_iface_name(), mac)) {
+        LOG(ERROR) << "Failed to get STA radio mac from ifname " << get_iface_name();
+    }
+    return mac;
 }
 
 bool sta_wlan_hal_onewifi::enable_disable_ep(bool enable)
