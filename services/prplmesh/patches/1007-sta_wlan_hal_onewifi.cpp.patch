+bool sta_wlan_hal_onewifi::send_mesh_sta_config(const std::string &ssid,
+                                                const std::string &passphrase,
+                                                const std::string &bssid_str,
+                                                WSC::eWscAuth auth_type)
+{
+    if (!m_data_model) {
+        ONEWIFI_LOG_ERROR("STA: send_mesh_sta_config: data model not ready");
+        return false;
+    }
+
+    // Map WSC auth type → wifi_security_modes_t for m2ctrl_radioconfig.authtype.
+    // translate_from_easymesh_bssinfo_to_vap_object() (mesh_backhaul_sta path) assigns
+    // authtype directly to vap->u.sta_info.security.mode with no conversion — so this
+    // must be wifi_security_modes_t, NOT EM_AUTH_* values.
+    unsigned int sec_mode = wifi_security_mode_wpa2_personal;
+    uint16_t wsc = static_cast<uint16_t>(auth_type);
+    if (wsc == 0 || auth_type == WSC::eWscAuth::WSC_AUTH_OPEN) {
+        sec_mode = wifi_security_mode_none;
+    } else if ((wsc & WSC::eWscAuth::WSC_AUTH_WPA2PSK) &&
+               (wsc & (WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24))) {
+        sec_mode = wifi_security_mode_wpa3_transition;
+    } else if (wsc & (WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
+        sec_mode = wifi_security_mode_wpa3_personal;
+    } else if (wsc & WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
+        sec_mode = wifi_security_mode_wpa2_personal;
+    } else if (wsc & WSC::eWscAuth::WSC_AUTH_WPAPSK) {
+        sec_mode = wifi_security_mode_wpa_personal;
+    }
+
+    ONEWIFI_LOG_INFO("STA: send_mesh_sta_config: ssid='%s' bssid=%s sec_mode=0x%x",
+                     ssid.c_str(), bssid_str.c_str(), sec_mode);
+
+    // Build the m2ctrl_radioconfig credential override so that OneWifi's
+    // translate_from_easymesh_bssinfo_to_vap_per_radio() injects ssid/password/security
+    // into the bSTA VAP entry. Without this, OneWifi detects no change and skips apply.
+    m2ctrl_radioconfig radio_cfg;
+    memset(&radio_cfg, 0, sizeof(radio_cfg));
+    radio_cfg.noofbssconfig  = 1;
+    radio_cfg.haultype[0]    = em_haul_type_backhaul;
+    radio_cfg.authtype[0]    = sec_mode;
+    radio_cfg.enable[0]      = !ssid.empty();
+    beerocks::string_utils::copy_string(radio_cfg.ssid[0],     ssid.c_str(),       sizeof(radio_cfg.ssid[0]));
+    beerocks::string_utils::copy_string(radio_cfg.password[0], passphrase.c_str(), sizeof(radio_cfg.password[0]));
+
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (!desc || !desc->bus_set_fn) {
+        ONEWIFI_LOG_ERROR("STA: send_mesh_sta_config: bus descriptor invalid");
+        return false;
+    }
+
+    // mesh_backhaul_sta subdoc: translate path uses strstr(vap_name, "mesh_sta") filter so
+    // only mesh_sta_* VAPs are processed — mesh_backhaul_* AP VAPs are skipped entirely.
+    // Per-band VAP subdocs (Vap_5G etc.) have no such filter and would overwrite the
+    // backhaul AP credentials too.
