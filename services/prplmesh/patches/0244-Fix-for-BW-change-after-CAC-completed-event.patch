From e44405cb2e75a104c1be9c1c8511d58f479f95ec Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Fri, 26 Jun 2026 12:36:01 +0530
Subject: [PATCH] Fix for BW change after CAC completed event

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 5f12716ef..2932d139e 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -3876,9 +3876,11 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
 	if (!timeout.empty()) {
 		msg->params.timeout = beerocks::string_utils::stoi(timeout);
 	 }
-	// Bandwidth
-	std::string bandwidth = parsed_obj["ch_width"];
-	msg->params.bandwidth = beerocks::utils::convert_bandwidth_to_enum(wpa_bw_to_beerocks_bw(bandwidth));
+	// Bandwidth is recieved in enum from host
+	std::string bandwidth = parsed_obj["chan_width"];
+	if (!bandwidth.empty()) {
+		msg->params.bandwidth = beerocks::string_utils::stoi(bandwidth);
+	}
 
 	// Add the message to the queue
 	event_queue_push(Event::DFS_CAC_Completed, msg_buff);
-- 
