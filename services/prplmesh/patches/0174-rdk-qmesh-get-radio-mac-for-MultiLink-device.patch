From f51efcf1fdf43de895358b38fc0df2d819dbde36 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Wed, 27 May 2026 15:53:24 +0530
Subject: [PATCH 10/10] [RDK][QMESH] - get radio mac for MultiLink device

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 .../fronthaul_manager/monitor/monitor.cpp       | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
index 5d60b17cf..09712fa35 100644
--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
@@ -346,6 +346,23 @@ bool Monitor::monitor_fsm()
 
             LOG(DEBUG) << "attach_state == bwl::HALState::Operational";
 
+#ifdef BEEROCKS_RDKB
+            // For MLD link, update m_radio_mac using HAL API after attach
+            // The constructor cannot get MAC for MLD link interfaces (e.g., phy00-mld0_link2)
+            // because they are logical interfaces. After HAL attach, the OneWifi data model
+            // is populated and get_radio_mac() returns the correct per-link MAC.
+            if (m_radio_mac == beerocks::net::network_utils::ZERO_MAC) {
+                std::string hal_radio_mac = mon_wlan_hal->get_radio_mac();
+                if (!hal_radio_mac.empty()) {
+                    m_radio_mac = tlvf::mac_from_string(hal_radio_mac);
+                    LOG(INFO) << "Updated m_radio_mac from HAL API: " << m_radio_mac
+                              << " for interface " << monitor_iface;
+                } else {
+                    LOG(WARNING) << "HAL get_radio_mac() returned empty for interface "
+                                 << monitor_iface << ", m_radio_mac remains ZERO_MAC";
+                }
+            }
+#endif
             mon_db.clear();
 
             // Initialize VAPs in the DB
