From 6373e6b8d191a5cb84a3ccbb1e2f5e8c26f25694 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 19 Oct 2026 10:35:35 +0530
Subject: [PATCH] Fix beerocks_agent crash when Ethernet stats TLV port_list
 allocation fails

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp  | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp b/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
index 5d6ec24fd..428836519 100644
--- a/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
+++ b/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
@@ -569,6 +569,10 @@ bool tlvf_airties_utils::add_airties_ethernet_stats_tlv(ieee1905_1::CmduMessageT
     auto lan_ifaces = beerocks::net::network_utils::linux_get_lan_interfaces();
     for (auto &lan_iface : lan_ifaces) {
         auto port_list = tlvAirtiesEthStats->create_port_list();
+        if (!port_list) {
+            LOG(ERROR) << "Failed to create port list for " << lan_iface;
+            continue;
+        }
 
         port_list->port_id() = airties::tlvf_airties_utils::assign_unique_port_id(lan_iface);
 
-- 
2.34.1

