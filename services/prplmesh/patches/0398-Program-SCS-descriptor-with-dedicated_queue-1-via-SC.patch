From fd6dd442cb8f7cc78e82d790f8557efd4754cdce Mon Sep 17 00:00:00 2001
From: mpaluri <mpaluri@qti.qualcomm.com>
Date: Wed, 26 Aug 2026 22:42:39 -0700
Subject: [PATCH] Program SCS descriptor with dedicated_queue=1 via
 SCS_CONFIGURE

Extend handle_qos_management_descriptor() with a dedicated_queue
parameter.  The SCS_CONFIGURE command sent to hostapd
now appends the dedicated_queue value as the final token:

  SCS_CONFIGURE <peer_mac> <scs_sta_mac> <qm_id> <scs_desc_hex> <dedicated_queue>

Signed-off-by: Manaswini Paluri <mpaluri@qti.qualcomm.com>

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 93a665d93..059f8e252 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2967,7 +2967,7 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
             if (!ap_wlan_hal->handle_qos_management_descriptor(
                     descriptor_tlv->bssid(), descriptor_tlv->qmid(), descriptor_tlv->client_mac(),
-                    peer_mac, descriptor_element)) {
+                    peer_mac, descriptor_element, 1)) {
                 LOG(ERROR) << "handle_qos_management_descriptor failed for BSSID "
                            << descriptor_tlv->bssid() << ", client "
                            << descriptor_tlv->client_mac();
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index cb8405c0f..27fc6a9d9 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -746,12 +746,15 @@ public:
      *             behind a downstream agent this is the bSTA MAC reported in
      *             AgentDB::remote_stations.
      * @param [in] descriptor_element SCS/MSCS descriptor element bytes.
+     * @param [in] dedicated_queue Whether to request a dedicated queue for
+     *             this SCS stream (1 = enabled, 0 = disabled).  Defaults to 1.
      * @return true on success or false on error.
      */
     virtual bool handle_qos_management_descriptor(const sMacAddr &bssid, uint16_t qmid,
                                                   const sMacAddr &client_mac,
                                                   const sMacAddr &peer_mac,
-                                                  const std::vector<uint8_t> &descriptor_element)
+                                                  const std::vector<uint8_t> &descriptor_element,
+                                                  uint8_t dedicated_queue = 1)
     {
         return false;
     }
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 059e80c28..0ac79140c 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -8620,8 +8620,14 @@ bool ap_wlan_hal_nl80211::configure_service_priority(const uint8_t *data)
 bool ap_wlan_hal_nl80211::handle_qos_management_descriptor(
     const sMacAddr &bssid, uint16_t qmid, const sMacAddr &client_mac,
     const sMacAddr &peer_mac,
-    const std::vector<uint8_t> &descriptor_element)
+    const std::vector<uint8_t> &descriptor_element,
+    uint8_t dedicated_queue)
 {
+    if (dedicated_queue > 1) {
+        LOG(ERROR) << "handle_qos_management_descriptor: invalid dedicated_queue value "
+                   << static_cast<int>(dedicated_queue) << ", must be 0 or 1";
+        return false;
+    }
     auto vap_id = get_vap_id_with_mac(tlvf::mac_to_string(bssid));
     if (!check_vap_id(vap_id)) {
         LOG(ERROR) << "handle_qos_management_descriptor: invalid vap_id for bssid " << bssid;
@@ -8644,14 +8650,15 @@ bool ap_wlan_hal_nl80211::handle_qos_management_descriptor(
     const auto descriptor_hex = beerocks::string_utils::bytes_to_hex_string(
         descriptor_element.data(), descriptor_element.size());
 
-    // SCS_CONFIGURE <peer_mac> <scs_sta_mac> <qm_id> <scs_desc_hex>
-    // peer_mac    -> bSTA MAC of the immediate downstream agent through which
-    //               the client is reachable (resolved by the caller from
-    //               AgentDB::remote_stations).
-    // scs_sta_mac -> the end client STA MAC
+    // SCS_CONFIGURE <peer_mac> <scs_sta_mac> <qm_id> <scs_desc_hex> [<dedicated_queue>]
+    // peer_mac        -> bSTA MAC of the immediate downstream agent through which
+    //                   the client is reachable (resolved by the caller from
+    //                   AgentDB::remote_stations).
+    // scs_sta_mac     -> the end client STA MAC
+    // dedicated_queue -> 1 to request a dedicated queue for this SCS stream
     const std::string cmd = "SCS_CONFIGURE " + tlvf::mac_to_string(peer_mac) + " " +
                             tlvf::mac_to_string(client_mac) + " " + std::to_string(qmid) + " " +
-                            descriptor_hex;
+                            descriptor_hex + " " + std::to_string(dedicated_queue);
 
     if (!wpa_ctrl_send_msg(cmd, ifname)) {
         LOG(ERROR) << "handle_qos_management_descriptor: SCS_CONFIGURE failed on " << ifname
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index f2aa5901d..61c83d3ae 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -156,7 +156,8 @@ public:
     handle_qos_management_descriptor(const sMacAddr &bssid, uint16_t qmid,
                                      const sMacAddr &client_mac,
                                      const sMacAddr &peer_mac,
-                                     const std::vector<uint8_t> &descriptor_element) override;
+                                     const std::vector<uint8_t> &descriptor_element,
+                                     uint8_t dedicated_queue = 1) override;
 
     bool generate_new_bssid(sMacAddr &new_bssid);
     void generate_bssid_pool(void);
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index b59ed2a84..8ac9018d6 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -3254,7 +3254,8 @@ bool ap_wlan_hal_whm::configure_service_priority(const uint8_t *dscp)
 bool ap_wlan_hal_whm::handle_qos_management_descriptor(
     const sMacAddr &bssid, uint16_t qmid, const sMacAddr &client_mac,
     const sMacAddr & /*peer_mac*/,
-    const std::vector<uint8_t> &descriptor_element)
+    const std::vector<uint8_t> &descriptor_element,
+    uint8_t /*dedicated_queue*/)
 {
     auto vap_id = get_vap_id_with_mac(tlvf::mac_to_string(bssid));
     if (!check_vap_id(vap_id)) {
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.h b/common/beerocks/bwl/whm/ap_wlan_hal_whm.h
index 94fd13d7a..c8b6ec0e7 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.h
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.h
@@ -205,7 +205,8 @@ public:
     handle_qos_management_descriptor(const sMacAddr &bssid, uint16_t qmid,
                                      const sMacAddr &client_mac,
                                      const sMacAddr &peer_mac,
-                                     const std::vector<uint8_t> &descriptor_element) override;
+                                     const std::vector<uint8_t> &descriptor_element,
+                                     uint8_t dedicated_queue = 1) override;
 
     /**
      * @see ap_wlan_hal::set_mscs_disallowed_sta_list
-- 
