+bool ap_wlan_hal_nl80211::send_cotdma_e2e_config(
+    const sMacAddr &cotdma_local_bssid, uint8_t config_mode, uint16_t qmid,
+    const sMacAddr &cotdma_peer_bssid, const sMacAddr &cotdma_peer_bsta)
+{
+    // Resolve per-BSS interface name from sharing BSSID.
+    // Uses the same get_vap_id_with_mac() + available_vaps[].bss lookup as sta_allow()
+    // and update_bss_hidden_ssid() to obtain the AP-manager-visible interface name
+    // (e.g. wlan0.1_link0 on MLO platforms).
+    const std::string bssid_str = tlvf::mac_to_string(cotdma_local_bssid);
+    auto vap_id = get_vap_id_with_mac(bssid_str);
+    if (vap_id < 0) {
+        LOG(ERROR) << "send_cotdma_e2e_config: no VAP found for cotdma_local_bssid=" << bssid_str;
+        return false;
+    }
+    const std::string ifname = m_radio_info.available_vaps[vap_id].bss;
+    if (ifname.empty()) {
+        LOG(ERROR) << "send_cotdma_e2e_config: empty bss iface for cotdma_local_bssid=" << bssid_str;
+        return false;
+    }
+
+    // The peer BSTA MAC is optional: it is only valid when the Multi-AP peer is a
+    // Repeater's backhaul STA connected to this AP. When it is the ZERO_MAC the
+    // PEER_BACKHAUL_MAC attribute is omitted so the driver leaves bsta_mac_valid=false.
+    const bool bsta_valid =
+        (cotdma_peer_bsta != beerocks::net::network_utils::ZERO_MAC);
+
+    LOG(DEBUG) << "send_cotdma_e2e_config: iface=" << ifname
+               << " config_mode=" << static_cast<int>(config_mode)
+               << " qmid=" << qmid
+               << " peer_bssid=" << cotdma_peer_bssid
+               << " peer_bsta=" << cotdma_peer_bsta
+               << " bsta_valid=" << bsta_valid;
+
+    // Send the QCA_NL80211_VENDOR_SUBCMD_MAPC_COTDMA_E2E_CONFIG command to the kernel.
+    auto ret = send_nl80211_msg(
+            NL80211_CMD_VENDOR, 0,
+            // Lambda to populate the netlink message with necessary attributes.
+            [&](struct nl_msg *msg) -> bool {
+                if (nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, QCA_VENDOR_OUI) ||
+                    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+                                QCA_NL80211_VENDOR_SUBCMD_MAPC_COTDMA_E2E_CONFIG)) {
+                    LOG(ERROR) << "send_cotdma_e2e_config: failed to put vendor id/subcmd";
+                    return false;
+                }
+
+                auto nl_ven_data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA);
+                if (!nl_ven_data) {
+                    return false;
+                }
+
+                // Wrap the entry attributes in the nested _CONFIG_ENTRY attribute
+                // expected by the driver's top-level policy.
+                auto nl_entry =
+                    nla_nest_start(msg, QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY);
+                if (!nl_entry) {
+                    nla_nest_end(msg, nl_ven_data);
+                    return false;
+                }
+
+                auto nl_entry_item =
+                    nla_nest_start(msg, 0);
+                if (!nl_entry_item) {
+                    nla_nest_end(msg, nl_entry);
+                    nla_nest_end(msg, nl_ven_data);
+                    return false;
+                }
+
+                if (nla_put_u8(msg, QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_CONFIG_MODE,
+                               config_mode) ||
+                    nla_put_u16(msg, QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_QMID, qmid) ||
+                    nla_put(msg, QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_PEER_MAC,
+                            sizeof(cotdma_peer_bssid.oct), cotdma_peer_bssid.oct)) {
+                    LOG(ERROR) << "send_cotdma_e2e_config: failed to put entry attributes";
+                    nla_nest_end(msg, nl_entry_item);
+                    nla_nest_end(msg, nl_entry);
+                    nla_nest_end(msg, nl_ven_data);
+                    return false;
+                }
+
+                // Only include the backhaul STA MAC when it is valid.
+                if (bsta_valid &&
+                    nla_put(msg, QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_PEER_BACKHAUL_MAC,
+                            sizeof(cotdma_peer_bsta.oct), cotdma_peer_bsta.oct)) {
+                    LOG(ERROR) << "send_cotdma_e2e_config: failed to put peer backhaul mac";
+                    nla_nest_end(msg, nl_entry_item);
+                    nla_nest_end(msg, nl_entry);
+                    nla_nest_end(msg, nl_ven_data);
+                    return false;
+                }
+
+                nla_nest_end(msg, nl_entry_item);
+                nla_nest_end(msg, nl_entry);
+                nla_nest_end(msg, nl_ven_data);
+                return true;
+            },
+            // No response is expected for a successful command, only an error on failure.
+            // This callback is a placeholder.
+            [&](struct nl_msg *msg) -> bool { return true; }, ifname);
+
+    if (!ret) {
+        LOG(ERROR) << "Failed to send QCA_NL80211_VENDOR_SUBCMD_MAPC_COTDMA_E2E_CONFIG command";
+        return false;
+    }
+
+    return true;
+}
