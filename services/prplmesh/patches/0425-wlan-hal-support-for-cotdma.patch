         m_cached_acs_block_chan_list = std::move(block);
         break;
     }
+    case beerocks_message::ACTION_APMANAGER_SET_MAPC_VALID_COAP_LIST_REQUEST: {
+        // MAPC: set permitted remote BSSID list on a local BSS.
+        // Forwarded from son_slave::handle_mapc_configuration_policy() for each local BSS
+        // entry in the MAPC Configuration Policy TLV. ap_manager calls
+        // ap_wlan_hal->set_mapc_valid_coap_list(local_bssid, permitted_bssids).
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_SET_MAPC_VALID_COAP_LIST_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_SET_MAPC_VALID_COAP_LIST_REQUEST failed";
+            return;
+        }
+        const uint8_t n_bssids = request->permitted_bssids_count();
+        std::vector<sMacAddr> permitted_bssids(n_bssids);
+        bool permitted_bssids_parse_failed = false;
+        for (uint8_t i = 0; i < n_bssids; i++) {
+            auto entry = request->permitted_bssids(i);
+            if (!std::get<0>(entry)) {
+                LOG(ERROR) << "Failed to get permitted_bssids[" << int(i) << "]";
+                permitted_bssids_parse_failed = true;
+                break; // break out of for-loop; fall through to break the case
+            }
+            permitted_bssids[i] = std::get<1>(entry);
+        }
+        if (permitted_bssids_parse_failed) {
+            break; // do not call set_mapc_valid_coap_list with a partial list
+        }
+        LOG(DEBUG) << "SET_MAPC_VALID_COAP_LIST: local_bssid=" << request->local_bssid()
+                   << " n_permitted=" << int(n_bssids);
+        if (!ap_wlan_hal->set_mapc_valid_coap_list(request->local_bssid(), permitted_bssids)) {
+            LOG(WARNING) << "set_mapc_valid_coap_list failed for local_bssid="
+                         << request->local_bssid();
+        }
+        break;
+    }
+    case beerocks_message::ACTION_APMANAGER_SET_MAPC_STA_REQUEST: {
+        // MAPC: configure Co-TDMA STA parameters on a sharing BSS.
+        // Forwarded from coordinated_tdma_task::apply_cotdma_config(). ap_manager calls
+        // ap_wlan_hal->set_mapc_sta(sharing_bssid, cotdma_enabled, shared_bssid).
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_SET_MAPC_STA_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_SET_MAPC_STA_REQUEST failed";
+            return;
+        }
+
+        LOG(DEBUG) << "SET_MAPC_STA: sharing_bssid=" << request->sharing_bssid()
+                   << " cotdma_enabled=" << request->cotdma_enabled()
+                   << " shared_bssid=" << request->shared_bssid();
+        if (!ap_wlan_hal->set_mapc_sta(request->sharing_bssid(), request->cotdma_enabled(),
+                                        request->shared_bssid())) {
+            LOG(WARNING) << "set_mapc_sta failed for sharing_bssid=" << request->sharing_bssid();
+        }
+        break;
+    }
+    case beerocks_message::ACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST: {
+        // CoTDMA: configure QMID and CoTDMA Peer Info for E2E Cotdma
+        // Forwarded from coordinated_tdma_task::apply_cotdma_config(). ap_manager calls
+        // aap_wlan_hal->send_cotdma_e2e_config.
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST failed";
+            return;
+        }
+        LOG(DEBUG) << "COTDMA_E2E_CONFIG: cotdma_local_bssid=" << request->cotdma_local_bssid()
+                   << " config_mode=" << request->config_mode()
+                   << " qmid=" << request->qmid()
+                   << " cotdma_peer_bssid=" << request->cotdma_peer_bssid()
+                   << " cotdma_backhaul_bsta=" << request->cotdma_backhaul_bsta();
+        if (!ap_wlan_hal->send_cotdma_e2e_config(request->cotdma_local_bssid(), request->config_mode(),
+                                        request->qmid(), request->cotdma_peer_bssid(), request->cotdma_backhaul_bsta())) {
+            LOG(WARNING) << "send_cotdma_e2e_config failed for cotdma_local_bssid=" << request->cotdma_local_bssid();
+        }
+        break;
+    }
     case beerocks_message::ACTION_APMANAGER_HOSTAP_TRIGGER_CBS: {
         // Dedicated periodic-CBS trigger. son_slave forwards ChannelSelectionTask::work()'s
         // cACTION_BACKHAUL_HOSTAP_TRIGGER_CBS here. Unlike the channels-list request (which only
@@ -3581,6 +3657,67 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
         send_cmdu(cmdu_tx);
     } break;
 
+    case Event::MAPC_Discovery_Report: {
+        // Parsed from hostapd's "MAPC-DISCOVERY-REPORT src=<MAC> dst=<MAC> peer_cap=<hex>
+        // local_cap=<hex>" wpa_ctrl event.
+        if (!data) {
+            LOG(ERROR) << "MAPC_Discovery_Report without data!";
+            return false;
+        }
+
+        auto msg = static_cast<bwl::sMapcDiscoveryReportNotification *>(data);
+        LOG(INFO) << "MAPC-DISCOVERY-REPORT src=" << msg->src << " dst=" << msg->dst
+                  << " peer_cap=0x" << std::hex << msg->peer_cap
+                  << " local_cap=0x" << msg->local_cap << std::dec;
+
+        // Forward to slave thread (son_slave_thread), which routes it into
+        // coordinated_tdma_task::handle_mapc_discovery_report_event().
+        auto notification = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_MAPC_DISCOVERY_REPORT_NOTIFICATION>(cmdu_tx);
+
+        if (!notification) {
+            LOG(ERROR) << "Failed to create MAPC_DISCOVERY_REPORT_NOTIFICATION message";
+            return false;
+        }
+
+        notification->src_bssid() = msg->src;
+        notification->dst_bssid() = msg->dst;
+        notification->peer_cap()  = msg->peer_cap;
+        notification->local_cap() = msg->local_cap;
+
+        send_cmdu(cmdu_tx);
+    } break;
+
+    case Event::MAPC_Negotiation_Status: {
+        // Parsed from hostapd's "MAPC-NEGOTIATION-STATUS negotiation_status=<N>
+        // src_bssid=<MAC> dst_bssid=<MAC>" wpa_ctrl event.
+        if (!data) {
+            LOG(ERROR) << "MAPC_Negotiation_Status without data!";
+            return false;
+        }
+
+        auto msg = static_cast<bwl::sMapcNegotiationStatusNotification *>(data);
+        LOG(INFO) << "MAPC-NEGOTIATION-STATUS src_bssid=" << msg->src_bssid
+                  << " dst_bssid=" << msg->dst_bssid
+                  << " negotiation_status=" << int(msg->negotiation_status);
+
+        // Forward to slave thread (son_slave_thread), which routes it into
+        // coordinated_tdma_task::handle_mapc_negotiation_status_event().
+        auto notification = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_MAPC_NEGOTIATION_STATUS_NOTIFICATION>(cmdu_tx);
+
+        if (!notification) {
+            LOG(ERROR) << "Failed to create MAPC_NEGOTIATION_STATUS_NOTIFICATION message";
+            return false;
+        }
+
+        notification->src_bssid()          = msg->src_bssid;
+        notification->dst_bssid()          = msg->dst_bssid;
+        notification->negotiation_status() = msg->negotiation_status;
+
+        send_cmdu(cmdu_tx);
+    } break;
+
     // STA Connected
     case Event::STA_Connected: {
 
