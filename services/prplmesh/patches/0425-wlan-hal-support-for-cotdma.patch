@@ -299,6 +304,67 @@ public:
         return true;
     }
 
+    /**
+     * @brief Set the valid CoAP BSSID list for MAPC on a local BSS.
+     *
+     * Sends: "set_mapc_valid_coap_list <MAC0> [MAC1 ... MACN]"
+     * to the per-BSS wpa_ctrl socket identified by local_bssid.
+     *
+     * Called for each local BSS entry in tlvMapcConfigurationPolicy received
+     * in a MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE. The MAC list is the
+     * flattened set of permitted_remote_bssids across all remote agents.
+     *
+     * @param local_bssid             BSSID of the local BSS (selects the per-BSS socket).
+     * @param permitted_remote_bssids Flattened list of permitted remote BSSIDs.
+     * @return true on success, false on error.
+     */
+    virtual bool set_mapc_valid_coap_list(
+        const sMacAddr &local_bssid,
+        const std::vector<sMacAddr> &permitted_remote_bssids) = 0;
+
+    /**
+     * @brief Configure MAPC STA (Co-TDMA) for a sharing BSS / shared BSS pair.
+     *
+     * Sends: "set_mapc_sta <peer_bssid> cotdma=<0|1> primary_ac=<N>
+     *         max_shared_txop_duration=<N> min_shared_txop_duration=<N>
+     *         service_start_time=<N> service_interval=<N>
+     *         service_end_time=<N> priority=<N>"
+     * to the per-BSS wpa_ctrl socket identified by sharing_bssid.
+     * Called once per entry in shared_bss_list.
+     *
+     * Called after receiving tlvCoTDMASharingApConfiguration in a
+     * COTDMA_CONFIGURATION_MESSAGE from the Controller.
+     *
+     * @param sharing_bssid   BSSID of the sharing AP (selects the per-BSS socket).
+     * @param cotdma_enabled  1=enable Co-TDMA (ADD), 0=disable (REMOVE).
+     * @param shared_bss BSSID of the sharing AP.
+     * @return true on success, false on error.
+     */
+    virtual bool set_mapc_sta(
+        const sMacAddr &sharing_bssid,
+        uint8_t cotdma_enabled,
+        const sMacAddr &shared_bssid) = 0;
+
+    /**
+     * @brief Configure Co-TDMA E2E Configuration
+     *
+     * Sends: NL Vendor Subcmd to host driver to configure QMID and
+     *        corresponding TXoP
+     *
+     * Called after receiving tlvCoTDMASharingApConfiguration in a
+     * COTDMA_CONFIGURATION_MESSAGE from the Controller.
+     *
+     * @param cotdma_local_bssid   BSSID of the sharing AP (selects the per-BSS socket).
+     * @param config_mode  1=add QMID, 0=delete QMID.
+     * @param qmid QMID
+     * @param cotdma_peer_bssid  Multi AP peer bssid
+     * @param cotdma_peer_bsta  Multi AP peer bsta connected to this AP
+     * @return true on success, false on error.
+     */
+    virtual bool send_cotdma_e2e_config(const sMacAddr &cotdma_local_bssid,
+        uint8_t config_mode, uint16_t qmid,
+        const sMacAddr &cotdma_peer_bssid, const sMacAddr &cotdma_peer_bsta) = 0;
+
     virtual bool
     update_vap_credentials(std::list<son::wireless_utils::sBssInfoConf> &bss_info_conf_list,
                            const std::string &backhaul_wps_ssid,
diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index 3c47ed555..ad7d9eb7e 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -684,6 +684,27 @@ enum class eMacACLType {
     ACCEPT_LIST = 1 /** Deny unless in accept list */,
 };
 
+/**
+ * @brief Notification for MAPC Negotiation Status event from hostapd.
+ * Parsed from: MAPC-NEGOTIATION-STATUS negotiation_status=<N> src_bssid=<MAC> dst_bssid=<MAC>
+ */
+struct sMapcNegotiationStatusNotification {
+    uint8_t  negotiation_status = 0; ///< 0=Failure, 1=Success
+    sMacAddr src_bssid           = {}; ///< Source BSSID
+    sMacAddr dst_bssid           = {}; ///< Destination BSSID
+};
+
+/**
+ * @brief Notification for MAPC Discovery Report event from hostapd.
+ * Parsed from: MAPC-DISCOVERY-REPORT src=<MAC> dst=<MAC> peer_cap=<hex> local_cap=<hex>
+ */
+struct sMapcDiscoveryReportNotification {
+    sMacAddr src       = {}; ///< Source BSSID
+    sMacAddr dst       = {}; ///< Destination BSSID
+    uint16_t peer_cap  = 0;  ///< Peer MAPC capabilities bitmap
+    uint16_t local_cap = 0;  ///< Local MAPC capabilities bitmap
+};
+
 } // namespace bwl
 
