+bool ap_wlan_hal_nl80211::set_mapc_sta(
+    const sMacAddr &sharing_bssid,
+    uint8_t cotdma_enabled,
+    const sMacAddr &shared_bssid)
+{
+    // Resolve per-BSS interface name from sharing BSSID.
+    // Uses the same get_vap_id_with_mac() + available_vaps[].bss lookup as sta_allow()
+    // and update_bss_hidden_ssid() to obtain the AP-manager-visible interface name
+    // (e.g. wlan0.1_link0 on MLO platforms).
+    const std::string bssid_str = tlvf::mac_to_string(sharing_bssid);
+    auto vap_id = get_vap_id_with_mac(bssid_str);
+    if (vap_id < 0) {
+        LOG(ERROR) << "set_mapc_sta: no VAP found for sharing_bssid=" << bssid_str;
+        return false;
+    }
+    const std::string ifname = m_radio_info.available_vaps[vap_id].bss;
+    if (ifname.empty()) {
+        LOG(ERROR) << "set_mapc_sta: empty bss iface for sharing_bssid=" << bssid_str;
+        return false;
+    }
+
+    // Build hostapd CLI command :
+    //   "SET_MAPC_STA <peer_bssid> cotdma=<0|1>"
+    // where peer_bssid is the MAC of the shared (peer) BSS.
+    std::ostringstream cmd;
+    cmd << "SET_MAPC_STA "
+        << tlvf::mac_to_string(shared_bssid)
+        << " cotdma=" << static_cast<int>(cotdma_enabled);
+
+    LOG(DEBUG) << "SET_MAPC_STA: sending '" << cmd.str()
+                << "' on iface=" << ifname;
+
+    if (!wpa_ctrl_send_msg(cmd.str(), ifname)) {
+        LOG(ERROR) << "SET_MAPC_STA failed for sharing_bssid="
+                    << tlvf::mac_to_string(sharing_bssid)
+                    << " peer_bssid="
+                    << tlvf::mac_to_string(shared_bssid);
+        return false;
+    }
+
+    return true;
+}
+
+
+// Temporary defintion to send new NL.
+// NOTE: QCA_NL80211_VENDOR_SUBCMD_MAPC_COTDMA_E2E_CONFIG must match the exact
+// subcmd enum value in the ath12k driver's qca_nl80211_vendor_subcmds. The value
+// below is a placeholder - confirm it against the driver header before merge.
+
+#define QCA_VENDOR_OUI 0x001374
+#define QCA_NL80211_VENDOR_SUBCMD_MAPC_COTDMA_E2E_CONFIG 544
+
+// Outer (top-level) attributes inside NL80211_ATTR_VENDOR_DATA. The driver's
+// ath12k_cotdma_e2e_config_policy expects attr id 1 to be a NESTED entry that
+// wraps the per-entry attributes below.
+enum qca_wlan_vendor_attr_mapc_cotdma_e2e_config {
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_INVALID = 0,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY   = 1,
+
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_AFTER_LAST,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_MAX =
+		QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_AFTER_LAST - 1,
+};
+
+// Per-entry attributes, nested inside QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY.
+enum qca_wlan_vendor_attr_mapc_cotdma_e2e_config_entry {
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY_INVALID  = 0,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_CONFIG_MODE     = 1,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_QMID            = 2,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_PEER_MAC        = 3,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_ENTRY_PEER_BACKHAUL_MAC = 4,
+
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY_AFTER_LAST,
+	QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY_MAX =
+		QCA_WLAN_VENDOR_ATTR_MAPC_COTDMA_E2E_CONFIG_ENTRY_AFTER_LAST - 1,
+};
+
