+bool ap_wlan_hal_nl80211::set_mapc_valid_coap_list(
+    const sMacAddr &local_bssid,
+    const std::vector<sMacAddr> &permitted_remote_bssids)
+{
+    // Resolve per-BSS interface name from local BSSID.
+    // Uses the same get_vap_id_with_mac() + available_vaps[].bss lookup as sta_allow()
+    // and update_bss_hidden_ssid() to obtain the AP-manager-visible interface name
+    // (e.g. wlan0.1_link0 on MLO platforms).
+    const std::string bssid_str = tlvf::mac_to_string(local_bssid);
+    auto vap_id = get_vap_id_with_mac(bssid_str);
+    if (vap_id < 0) {
+        LOG(ERROR) << "set_mapc_valid_coap_list: no VAP found for local_bssid=" << bssid_str;
+        return false;
+    }
+    const std::string ifname = m_radio_info.available_vaps[vap_id].bss;
+    if (ifname.empty()) {
+        LOG(ERROR) << "set_mapc_valid_coap_list: empty bss iface for local_bssid=" << bssid_str;
+        return false;
+    }
+
+    // Build hostapd CLI command:
+    //   "SET_MAPC_VALID_COAP_LIST <MAC0> [MAC1 ... MACN]"
+    // where MAC0..MACN are the permitted remote BSSIDs for MAPC discovery/negotiation.
+    // An empty list clears the filter (all peers permitted).
+    std::ostringstream cmd;
+    cmd << "SET_MAPC_VALID_COAP_LIST";
+    for (const auto &bssid : permitted_remote_bssids) {
+        cmd << " " << tlvf::mac_to_string(bssid);
+    }
+
+    LOG(DEBUG) << "SET_MAPC_VALID_COAP_LIST: sending '" << cmd.str()
+               << "' on iface=" << ifname;
+
+    if (!wpa_ctrl_send_msg(cmd.str(), ifname)) {
+        LOG(ERROR) << "SET_MAPC_VALID_COAP_LIST failed for local_bssid=" << bssid_str;
+        return false;
+    }
+    return true;
+}
