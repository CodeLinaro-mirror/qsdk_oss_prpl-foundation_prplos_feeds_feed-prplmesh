+        cJSON_Delete(root);
+        sta_iface[0] = '\0';
+        return -1;
+    }
+
+    strlcpy(sta_iface, sta_iface_str, BPL_IFNAME_LEN);
+
+    LOG(INFO) << "Found STA interface for radio" << radio_num << ": " << sta_iface;
+
+    cJSON_Delete(root);
     return 0;
 }
 
