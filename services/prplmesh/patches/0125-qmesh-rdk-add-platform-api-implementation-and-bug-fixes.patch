 int cfg_get_management_mode()
 {
-    // TODO: Implement
-    return BPL_MGMT_MODE_MULTIAP_AGENT;
+    if (!config_file_path) {
+        LOG(ERROR) << "config_file_path is null";
+        return BPL_MGMT_MODE_MULTIAP_AGENT;
+    }
+
+    std::ifstream config_file(config_file_path);
+    if (!config_file.is_open()) {
+        return BPL_MGMT_MODE_MULTIAP_AGENT;
+    }
+
+    std::string config_content((std::istreambuf_iterator<char>(config_file)),
+                               std::istreambuf_iterator<char>());
+    config_file.close();
+    if (config_file.fail()) {
+        LOG(ERROR) << "unable to close config file: " << config_file_path;
+        return BPL_MGMT_MODE_MULTIAP_AGENT;
+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        const char *error_ptr = cJSON_GetErrorPtr();
+        LOG(ERROR) << "Failed to parse JSON config file: " << config_file_path
+                   << " Error: " << (error_ptr ? error_ptr : "unknown");
+        return BPL_MGMT_MODE_MULTIAP_AGENT;
+    }
+
+    int mgmt_mode = BPL_MGMT_MODE_MULTIAP_AGENT;
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (!config_obj) {
+        cJSON_Delete(root);
+        return BPL_MGMT_MODE_MULTIAP_AGENT;
+    }
+
+    cJSON *mode_obj = cJSON_GetObjectItem(config_obj, "management_mode");
+    if (mode_obj && cJSON_IsString(mode_obj)) {
+        const char* mode_str = cJSON_GetStringValue(mode_obj);
+        if (strcmp(mode_str, "Multi-AP-Controller-and-Agent") == 0) {
+            mgmt_mode = BPL_MGMT_MODE_MULTIAP_CONTROLLER_AGENT;
+        } else if (strcmp(mode_str, "Multi-AP-Controller") == 0) {
+            mgmt_mode = BPL_MGMT_MODE_MULTIAP_CONTROLLER;
+        } else if (strcmp(mode_str, "Multi-AP-Agent") == 0) {
+            mgmt_mode = BPL_MGMT_MODE_MULTIAP_AGENT;
+        } else if (strcmp(mode_str, "Non-Prpl-Controller-and-Agent") == 0) {
+            mgmt_mode = BPL_MGMT_MODE_NONPRPL_CONTROLLER_AGENT;
+        } else if (strcmp(mode_str, "Not-Multi-AP") == 0) {
+            mgmt_mode = BPL_MGMT_MODE_NOT_MULTIAP;
+        }
+        LOG(INFO) << "management_mode from config string (" << mode_str << "): " << mgmt_mode;
+    }
+
+    cJSON_Delete(root);
+    return mgmt_mode;
 }
 
 int cfg_get_management_mode(std::string &mode)
 {
-    mode = "Multi-AP-Agent";
+    int mode_int = cfg_get_management_mode();
+
+    switch (mode_int) {
+        case BPL_MGMT_MODE_MULTIAP_CONTROLLER_AGENT:
+            mode = "Multi-AP-Controller-and-Agent";
+            break;
+        case BPL_MGMT_MODE_MULTIAP_CONTROLLER:
+            mode = "Multi-AP-Controller";
+            break;
+        case BPL_MGMT_MODE_MULTIAP_AGENT:
+            mode = "Multi-AP-Agent";
+            break;
+        case BPL_MGMT_MODE_NONPRPL_CONTROLLER_AGENT:
+            mode = "Non-Prpl-Controller-and-Agent";
+            break;
+        case BPL_MGMT_MODE_NOT_MULTIAP:
+            mode = "Not-Multi-AP";
+            break;
+        default:
+            mode = "Multi-AP-Agent";
+            break;
+    }
+
     return 0;
 }
 
