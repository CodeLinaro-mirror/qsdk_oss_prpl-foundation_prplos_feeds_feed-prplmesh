+
+    char radio_key[BPL_RADIO_KEY_BUF_LEN];
+    snprintf(radio_key, sizeof(radio_key), "radio%d", radio_num);
+
+    cJSON *radio_obj = cJSON_GetObjectItem(root, radio_key);
+    if (!radio_obj) {
+        LOG(ERROR) << "Radio " << radio_num << " not found in config";
