@@ -231,6 +319,92 @@ bool cfg_set_diagnostics_measurements_polling_rate_sec(
 
 int cfg_get_wifi_params(const char *iface, struct BPL_WLAN_PARAMS *wlan_params)
 {
+    if (!iface || !wlan_params) {
+        LOG(ERROR) << "cfg_get_wifi_params: invalid parameter";
+        return -1;
+    }
+
+    // Default init
+    wlan_params->enabled = 0;
+    wlan_params->channel = 0;
+    wlan_params->sub_band_dfs = false;
+    memset(wlan_params->country_code, 0, sizeof(wlan_params->country_code));
+    // Default country to US for now in case it's not set
+    wlan_params->country_code[0] = 'U';
+    wlan_params->country_code[1] = 'S';
+
+    if (!config_file_path) {
+        LOG(ERROR) << "config_file_path is null";
+        return 0;
+    }
+
+    std::ifstream config_file(config_file_path);
+    if (!config_file.is_open()) {
+        LOG(ERROR) << "Failed to open config file: " << config_file_path;
+        return 0;
+    }
+
+    std::string config_content((std::istreambuf_iterator<char>(config_file)),
+                               std::istreambuf_iterator<char>());
+    config_file.close();
+    if (config_file.fail()) {
+        LOG(ERROR) << "unable to close config file: " << config_file_path;
+        return 0;
+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        return 0;
+    }
+
+    // Try to find the radio block for the requested interface
+    // Since we're given the interface name (e.g. wlan0), we have to search the radios
+    cJSON *target_radio_obj = nullptr;
+    for (int radio_idx = 0; radio_idx < BPL_MAX_RADIOS_SUPPORTED; radio_idx++) {
+        char radio_key[BPL_RADIO_KEY_BUF_LEN];
+        snprintf(radio_key, sizeof(radio_key), "radio%d", radio_idx);
+
+        cJSON *radio_obj = cJSON_GetObjectItem(root, radio_key);
+        if (!radio_obj) continue;
+
+        cJSON *hostap_iface_obj = cJSON_GetObjectItem(radio_obj, "hostap_iface");
+        if (hostap_iface_obj && cJSON_IsString(hostap_iface_obj)) {
+            const char *hostap_iface = cJSON_GetStringValue(hostap_iface_obj);
+            if (hostap_iface && strcmp(hostap_iface, iface) == 0) {
+                target_radio_obj = radio_obj;
+                break;
+            }
+        }
+    }
+
+    // Read the country code from "config" object
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (config_obj) {
+        cJSON *country_obj = cJSON_GetObjectItem(config_obj, "country_code");
+        if (country_obj && cJSON_IsString(country_obj)) {
+            const char *country_str = cJSON_GetStringValue(country_obj);
+            if (country_str && strlen(country_str) >= 2) {
+                wlan_params->country_code[0] = country_str[0];
+                wlan_params->country_code[1] = country_str[1];
+                wlan_params->country_code[2] = '\0';
+            }
+        }
+    }
+
+    if (target_radio_obj) {
+        // Here you can parse enabled, channel, etc. if needed
+        cJSON *channel_obj = cJSON_GetObjectItem(target_radio_obj, "channel");
+        if (channel_obj && cJSON_IsNumber(channel_obj)) {
+            wlan_params->channel = channel_obj->valueint;
+        }
+
+        // Just setting enabled to 1 if radio exists in config
+        wlan_params->enabled = 1;
+    } else {
+        LOG(WARNING) << "cfg_get_wifi_params: iface " << iface << " not found in config";
+    }
+
+    cJSON_Delete(root);
     return 0;
 }
 
