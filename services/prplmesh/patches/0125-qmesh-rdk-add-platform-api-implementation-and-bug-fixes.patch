+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        const char *error_ptr = cJSON_GetErrorPtr();
+        LOG(ERROR) << "Failed to parse JSON config file: " << config_file_path
+                   << " Error: " << (error_ptr ? error_ptr : "unknown");
+        return -1;
+    }
+
+    int interfaces_count = 0;
+    const int max_interfaces = *num_of_interfaces;
+
+    // Iterate through radio0, radio1, ..., up to BPL_MAX_RADIOS_SUPPORTED-1
+    for (int radio_idx = 0; radio_idx < BPL_MAX_RADIOS_SUPPORTED; radio_idx++) {
+        // Check if we've reached the maximum number of interfaces
+        if (interfaces_count >= max_interfaces) {
+            LOG(WARNING) << "Reached maximum number of interfaces (" << max_interfaces << "), stopping scan";
+            break;
+        }
+
+        char radio_key[BPL_RADIO_KEY_BUF_LEN];
+        snprintf(radio_key, sizeof(radio_key), "radio%d", radio_idx);
+
+        cJSON *radio_obj = cJSON_GetObjectItem(root, radio_key);
+        if (!radio_obj) {
+            // No more radios in config
+            continue;
+        }
+
+        cJSON *hostap_iface_obj = cJSON_GetObjectItem(radio_obj, "hostap_iface");
+        if (!hostap_iface_obj || !cJSON_IsString(hostap_iface_obj)) {
+            LOG(WARNING) << "Missing or invalid hostap_iface for " << radio_key;
+            continue;
+        }
+
+        const char *hostap_iface = cJSON_GetStringValue(hostap_iface_obj);
+        if (!hostap_iface || strlen(hostap_iface) == 0) {
+            LOG(WARNING) << "Empty hostap_iface for " << radio_key;
+            continue;
+        }
+
+        // Initialize the structure to zero first
+        memset(&interfaces[interfaces_count], 0, sizeof(BPL_WLAN_IFACE));
+
+        // Fill interface structure
+        interfaces[interfaces_count].radio_num = radio_idx;
+        strlcpy(interfaces[interfaces_count].ifname, hostap_iface, IFNAMSIZ);
+
+        // Try to read frequency band from config
+        interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_UNKNOWN;
+
+        cJSON *freq_band_obj = cJSON_GetObjectItem(radio_obj, "freq_band");
+        if (freq_band_obj && cJSON_IsString(freq_band_obj)) {
+            const char *freq_band_str = cJSON_GetStringValue(freq_band_obj);
+            if (freq_band_str) {
+                if (strcmp(freq_band_str, "2.4GHz") == 0 || strcmp(freq_band_str, "2G") == 0) {
+                    interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_24G;
+                } else if (strcmp(freq_band_str, "5GHz") == 0 || strcmp(freq_band_str, "5G") == 0) {
+                    interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_5G;
+                } else if (strcmp(freq_band_str, "6GHz") == 0 || strcmp(freq_band_str, "6G") == 0) {
+                    interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_6G;
+                }
+            }
+        }
+
+        // Fallback: determine frequency type based on radio index if not in config
+        if (interfaces[interfaces_count].freq_type == beerocks::eFreqType::FREQ_UNKNOWN) {
+            if (radio_idx == 0) {
+                interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_24G;
+            } else if (radio_idx == 1) {
+                interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_5G;
+            } else if (radio_idx == 2) {
+                interfaces[interfaces_count].freq_type = beerocks::eFreqType::FREQ_6G;
+            }
+        }
+
+        LOG(INFO) << "###Found " << radio_key << ": " << hostap_iface
+                  << " (freq_type=" << static_cast<int>(interfaces[interfaces_count].freq_type) << ")";
+
+        interfaces_count++;
+    }
+
+    cJSON_Delete(root);
+
+    *num_of_interfaces = interfaces_count;
+
+    if (interfaces_count == 0) {
+        LOG(ERROR) << "No radio interfaces found in config file";
+        return -1;
+    }
+
+    LOG(INFO) << "###Successfully loaded " << interfaces_count << " radio interface(s) from config";
     return 0;
 }
 
