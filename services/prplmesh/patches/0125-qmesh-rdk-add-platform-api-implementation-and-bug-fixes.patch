index e8078c289..1b1be6c07 100644
--- a/common/beerocks/bcl/source/beerocks_os_utils.cpp
+++ b/common/beerocks/bcl/source/beerocks_os_utils.cpp
@@ -203,6 +203,7 @@ bool os_utils::touch_pid_file(const std::string &file_path)
 int os_utils::redirect_console_std(const std::string &log_file_name)
 {
     int fd_log_file_std = open(log_file_name.c_str(), O_CREAT | O_APPEND | O_RDWR, 0644);
+#ifndef BEEROCKS_RDKB
     if (fd_log_file_std > 0) {
         std::ostringstream msg;
         msg << std::endl << "Start Log" << std::endl << std::endl;
@@ -214,8 +215,38 @@ int os_utils::redirect_console_std(const std::string &log_file_name)
         dup2(fd_log_file_std, STDOUT_FILENO);
         dup2(fd_log_file_std, STDERR_FILENO);
     }
+
+    close_file(fd_log_file_std);
+    return fd_log_file_std;
+#else
+    if (fd_log_file_std <= 0) {
+        std::cerr << "ERROR: Failed to open log file: " << log_file_name << std::endl;
+        return -1;
+    }
+
+    std::ostringstream msg;
+    msg << std::endl << "Start Log" << std::endl << std::endl;
+    if (write(fd_log_file_std, msg.str().c_str(), msg.str().size()) < 0) {
+        std::cerr << "ERROR: Failed writing to file: " << log_file_name << std::endl;
+        close(fd_log_file_std);
+        return -1;  // Return error instead of continuing
+    }
+
+    // Only redirect if write was successful
+    if (dup2(fd_log_file_std, STDOUT_FILENO) < 0) {
+        std::cerr << "ERROR: Failed to redirect stdout" << std::endl;
+        close(fd_log_file_std);
+        return -1;
+    }
+    if (dup2(fd_log_file_std, STDERR_FILENO) < 0) {
+        std::cerr << "ERROR: Failed to redirect stderr" << std::endl;
+        close(fd_log_file_std);
+        return -1;
+    }
+
     close_file(fd_log_file_std);
     return fd_log_file_std;
+#endif
 }
 
 void os_utils::close_file(int fd)
@@ -246,12 +277,24 @@ std::string os_utils::get_os_name()
 
     std::string line;
     while (std::getline(file, line)) {
+#ifdef BEEROCKS_RDKB
+        constexpr char os_release_field[] = "PRETTY_NAME=";
+#else
         constexpr char os_release_field[] = "PRETTY_NAME=\"";
+#endif
         auto pos = line.find(os_release_field, 0, sizeof(os_release_field) - 1);
         if (pos == std::string::npos) {
             continue;
         }
 
+#ifdef BEEROCKS_RDKB
+        auto value_start = sizeof(os_release_field) - 1;
+        auto space_pos = line.find(' ', value_start);
+        if (space_pos != std::string::npos) {
+            return line.substr(value_start, space_pos - value_start);
+        }
+#endif
+
         return line.substr(sizeof(os_release_field) - 1, line.size() - sizeof(os_release_field));
     }
 
