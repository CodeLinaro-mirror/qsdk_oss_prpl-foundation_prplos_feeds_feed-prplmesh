From 59301adaa51b712427994868a4cdf4dbbab2bbed Mon Sep 17 00:00:00 2001
From: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
Date: Thu, 25 Jun 2026 09:28:56 +0530
Subject: [PATCH] Static Wi-Fi Interfaces - Controller Implementation

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 controller/nbapi/on_action.cpp                |  8 +++++--
 controller/src/beerocks/master/controller.cpp |  1 +
 .../platform/bpl/cfg/dm/bpl_cfg_wifi.cpp      |  4 +++-
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     |  4 +++-
 framework/tlvf/src/include/tlvf/WSC/m2.h      |  7 ++++--
 framework/tlvf/src/src/WSC/m2.cpp             | 23 +++++++++++++++++++
 6 files changed, 41 insertions(+), 6 deletions(-)

diff --git a/controller/nbapi/on_action.cpp b/controller/nbapi/on_action.cpp
index 408cd7c19..aae9542da 100644
--- a/controller/nbapi/on_action.cpp
+++ b/controller/nbapi/on_action.cpp
@@ -302,8 +302,12 @@ amxd_status_t access_point_commit(amxd_object_t *object, amxd_function_t *func,
             son::wireless_utils::sBssInfoConf bss_info;
             bss_info.ssid = get_param_string(access_point_inst, "SSID");
 
-            bss_info.vap_type = wireless_utils::string_to_vap_type(
-                get_param_string(access_point_inst, "X_PRPLWARE-COM_VapType"));
+            std::string vap_type_str = get_param_string(access_point_inst, "X_PRPLWARE_VapType");
+
+            bss_info.vap_type = wireless_utils::string_to_vap_type(vap_type_str);
+
+            // Read vap_label from datamodel
+            bss_info.vap_label = get_param_string(access_point_inst, "X_PRPLWARE_VapLabel");
 
             bool access_point_enable = amxd_object_get_bool(access_point_inst, "Enable", NULL);
             std::string group_name =
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 7d871e23a..5f1471ffe 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -1121,6 +1121,7 @@ bool Controller::autoconfig_wsc_add_m2(WSC::m1 &m1,
     if (bss_info_conf != nullptr) {
         m2_cfg.bss_index = bss_info_conf->bss_index;
         m2_cfg.vap_type  = bss_info_conf->vap_type;
+        m2_cfg.vap_label = bss_info_conf->vap_label;
     }
     m2_cfg.auth_type_flags =
         WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_OPEN | WSC::eWscAuth::WSC_AUTH_WPA2PSK |
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
index e28f88fe5..96d6419b8 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
@@ -201,8 +201,10 @@ bool bpl_cfg_get_wireless_settings(std::list<son::wireless_utils::sBssInfoConf>
         // Reading CustomAlias and deducing VAP type
         const std::string custom_alias = wbapi_utils::get_custom_alias(ap);
         configuration.vap_type         = wbapi_utils::vap_type_from_custom_alias(custom_alias);
+        configuration.vap_label        = custom_alias;
         LOG(DEBUG) << "bpl_cfg_get_wireless_settings: vap_type is "
-                   << eVapType_str(configuration.vap_type) << " for SSID=" << configuration.ssid;
+                   << eVapType_str(configuration.vap_type) << ", vap_label is '"
+                   << configuration.vap_label << "' for SSID=" << configuration.ssid;
 
         bool ap_enable = false;
         ap.read_child(ap_enable, "Enable");
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 53123d692..8802bea2b 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -107,9 +107,11 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
                       [](unsigned char c) { return std::tolower(c); });
 
         configuration.vap_type = son::wireless_utils::string_to_vap_type(custom_alias);
+        configuration.vap_label = custom_alias;  // Set vap_label from custom_alias
 
         MAPF_DBG("Section " << section_name << ": custom_alias='" << options["custom_alias"]
-                 << "' -> vap_type=" << eVapType_str(configuration.vap_type));
+                 << "' -> vap_type=" << eVapType_str(configuration.vap_type)
+                 << ", vap_label='" << configuration.vap_label << "'");
     } else {
         configuration.vap_type = eVapType::OTHER;
         MAPF_DBG("Section " << section_name << ": no custom_alias, defaulting to vap_type=OTHER");
diff --git a/framework/tlvf/src/include/tlvf/WSC/m2.h b/framework/tlvf/src/include/tlvf/WSC/m2.h
index 99b20f5d8..cb0b66f83 100644
--- a/framework/tlvf/src/include/tlvf/WSC/m2.h
+++ b/framework/tlvf/src/include/tlvf/WSC/m2.h
@@ -10,6 +10,7 @@
 #define _TLVF_WSC_M2_H_
 
 #include <tlvf/WSC/WscAttrList.h>
+#include <tlvf/WSC/eWscWfaVendorExtSubelement.h>
 
 namespace WSC {
 namespace vendor_extension {
@@ -193,9 +194,11 @@ public:
             const auto *data = vendor_ext_attr->vendor_data();
             const size_t len = vendor_ext_attr->vendor_data_length();
 
-            // Need at least 2 bytes: [subelem_id][value]
+            // Format is [tag][value...] where total length is determined by vendor_data_length()
             if (len >= 2 && data[0] == WSC::vendor_extension::airties::VENDOR_VAP_LABEL) {
-                return std::string(reinterpret_cast<const char *>(data + 1), len - 1);
+                // The label length is the total payload length minus 1 byte for the tag
+                size_t sub_len = len - 1;
+                return std::string(reinterpret_cast<const char *>(data + 1), sub_len);
             }
         }
 
diff --git a/framework/tlvf/src/src/WSC/m2.cpp b/framework/tlvf/src/src/WSC/m2.cpp
index c543cae8c..3a3f51a8c 100644
--- a/framework/tlvf/src/src/WSC/m2.cpp
+++ b/framework/tlvf/src/src/WSC/m2.cpp
@@ -9,6 +9,7 @@
 #include <tlvf/WSC/m2.h>
 #include <tlvf/tlvfdefines.h>
 #include <tlvf/tlvflogging.h>
+#include <tlvf/WSC/eWscWfaVendorExtSubelement.h>
 
 using namespace WSC;
 
@@ -248,6 +249,28 @@ bool m2::init(const config &cfg, bool bss_index_support)
         }
     }
 
+    // WFA Vendor Extension for vap_label
+    if (!cfg.vap_label.empty()) {
+        auto vendor_ext_attr = addAttr<cWscAttrVendorExtension>();
+        if (!vendor_ext_attr) {
+            TLVF_LOG(ERROR) << "addAttr<cWscAttrVendorExtension> (WFA vap_label) failed";
+            return false;
+        }
+        vendor_ext_attr->vendor_id_0() = WSC::eWscVendorId::WSC_VENDOR_ID_AIRTIES_1;
+        vendor_ext_attr->vendor_id_1() = WSC::eWscVendorId::WSC_VENDOR_ID_AIRTIES_2;
+        vendor_ext_attr->vendor_id_2() = WSC::eWscVendorId::WSC_VENDOR_ID_AIRTIES_3;
+
+        std::vector<uint8_t> payload;
+        payload.reserve(1 + cfg.vap_label.length());
+        payload.push_back(static_cast<uint8_t>(WSC::vendor_extension::airties::VENDOR_VAP_LABEL));
+        payload.insert(payload.end(), cfg.vap_label.begin(), cfg.vap_label.end());
+
+        if (!vendor_ext_attr->set_vendor_data(payload.data(), payload.size())) {
+            TLVF_LOG(ERROR) << "set_vendor_data (WFA vap_label) failed";
+            return false;
+        }
+    }
+
     // For retro compatibility, don't send bss_index for agent not supporting RSN overriding
     if (bss_index_support) {
         auto bss_index = addAttr<cWscAttrBssIndex>();
-- 
2.34.1

