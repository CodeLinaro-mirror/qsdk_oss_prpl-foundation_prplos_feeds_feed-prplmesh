From fc5fa4e5af84d09b989ab27140ed1c8cd5ca22a6 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Fri, 9 Oct 2026 15:18:49 +0530
Subject: [PATCH] prplmesh: fix stale SSID after bml_update_wifi_credentials
 (CR 4658749)

After an SSID-only credentials update via bml_update_wifi_credentials, the
controller's BSS SSID could remain stale because the in-place hostapd.conf
reload path does not emit an AP-ENABLED notification, so no VAPS_LIST_UPDATE
was ever sent to the controller and the DM/qmesh-lib topology cache was never
refreshed.

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp   | 17 +++++++++++++++++
 controller/src/beerocks/master/controller.cpp   |  2 ++
 controller/src/beerocks/master/db/db.cpp        | 16 ++++++++++++++--
 3 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 2cdb09829..c5bd5ee50 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -5844,6 +5844,23 @@ void ApAutoConfigurationTask::handle_vs_wifi_credentials_update_response(
             static_cast<uint8_t>(NeighborDbAgentTask::TRIGGER_SEND_LOCAL_NEIGHBOR_INFO),
             &ev);
     }
+
+    // Re-publish the current VAP list to the controller now that credentials have actually
+    // been applied to hostapd. This path (e.g. bml_update_wifi_credentials -> AP-Autoconfig
+    // Renew -> in-place hostapd.conf reload) does not necessarily emit an AP-ENABLED
+    // notification, which is otherwise the only path that forwards a fresh SSID to the
+    // controller's database (and from there to the DM / qmesh-lib). Firing
+    // VAPS_LIST_UPDATE again here — the same request already used earlier in this FSM for
+    // this exact purpose — is the guaranteed sync point that keeps the controller's BSS
+    // SSID (and therefore the DM/qmesh-lib topology cache) from going stale after an
+    // SSID-only credentials update.
+    LOG(DEBUG) << "re-requesting VAPS_LIST_UPDATE for " << radio_iface
+               << " after credentials update, num_of_bss_available="
+               << radio_conf_params.num_of_bss_available;
+    if (!send_ap_bss_info_update_request(radio_iface)) {
+        LOG(DEBUG) << "send_ap_bss_info_update_request has failed for "
+                   << radio_iface << " after credentials update";
+    }
 }
 
 void ApAutoConfigurationTask::handle_vs_ap_enabled_notification(
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 7ba3a39ef..90525bb0a 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -5605,6 +5605,8 @@ bool Controller::handle_cmdu_control_message(
                   << vaps_list;
 
         for (const auto &vap : vaps_info) {
+            LOG(DEBUG) << "update_bss: bss=" << vap.second.mac
+                       << " ssid=" << vap.second.ssid;
             if (!database.update_bss(src_mac, radio_mac, tlvf::mac_from_string(vap.second.mac),
                                      vap.second.ssid)) {
                 LOG(ERROR) << "Failed to update VAP for radio " << radio_mac << " BSS "
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index b3f3e28c6..000e02533 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -3358,8 +3358,20 @@ bool db::update_bss(const sMacAddr &al_mac, const sMacAddr &radio_mac, const sMa
         LOG(DEBUG) << "update_bss: creating new BSS for " << bssid;
         return (add_bss(*radio, bssid, ssid) != nullptr);
     }
-    bss->ssid = ssid;
-    return dm_set_radio_bss(al_mac, radio_mac, bssid);
+    bool ssid_changed = (bss->ssid != ssid);
+    bss->ssid          = ssid;
+    bool ret           = dm_set_radio_bss(al_mac, radio_mac, bssid);
+    if (ret && ssid_changed && !bss->dm_path.empty()) {
+        // dm_set_radio_bss() only fires the BssAdded vendor event on first-time DM
+        // instance creation; qmesh-lib/steering-app refresh their topology cache only
+        // on this discrete event, never on a passive DM SSID set(). Re-fire it here so
+        // an SSID change on an already-existing BSS (e.g. bml_update_wifi_credentials)
+        // is actually observed downstream.
+        LOG(DEBUG) << "SSID changed for existing BSS " << bssid
+                   << ", re-firing BssAdded event, new_ssid=" << ssid;
+        dm_trigger_bss_added_event(bssid, bss->dm_path, radio_mac, al_mac);
+    }
+    return ret;
 }
 
 std::set<std::string> db::get_radio_bss_bssids(const std::string &mac)
