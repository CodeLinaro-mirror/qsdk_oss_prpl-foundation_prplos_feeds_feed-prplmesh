         std::string ruid;            // hex radio UID, e.g. "00037f123535" (no colons)
         std::string vap_label;       // from "Extension-ID" or vendor field
         std::string custom_alias;    // from "customAlias" (HOME/GUEST/VIDEO/BACKHAUL/HOTSPOT role tag)
+        std::string signed_connector; // from "signedConnector" (DPP Connector JWS), empty if AKM has no DPP
+        std::string csign_jwk;       // from "csign" (Configurator C-sign-key, JWK JSON object), empty if AKM has no DPP
         uint8_t     map_bss_type  = 0;  // 0x40=backhaul BSS, 0x20=fronthaul BSS
         bool        hidden_ssid   = false;  // from "SSIDAdvertisement": false → hidden
         bool        ssid_advert_present = false; // true when field was found in JSON
@@ -2203,6 +2225,36 @@ void ApAutoConfigurationTask::handle_bss_configuration_response(
                     cfg.passphrase = json.substr(pass_pos, pass_end - pass_pos);
             }
 
+            // Extract signedConnector (DPP Connector, JWS compact serialization string)
+            auto connector_pos = json.find("\"signedConnector\":\"");
+            if (connector_pos != std::string::npos) {
+                connector_pos += 19;
+                auto connector_end = json.find('"', connector_pos);
+                if (connector_end != std::string::npos)
+                    cfg.signed_connector = json.substr(connector_pos, connector_end - connector_pos);
+            }
+
+            // Extract csign (Configurator C-sign-key). Unlike other fields this is an
+            // embedded JSON object, not a quoted string, so find the matching closing
+            // brace by depth instead of the next quote.
+            auto csign_pos = json.find("\"csign\":");
+            if (csign_pos != std::string::npos) {
+                csign_pos += 8;
+                int depth  = 0;
+                size_t end = csign_pos;
+                for (; end < json.size(); ++end) {
+                    if (json[end] == '{') {
+                        ++depth;
+                    } else if (json[end] == '}') {
+                        if (--depth == 0) {
+                            ++end;
+                            break;
+                        }
+                    }
+                }
+                cfg.csign_jwk = json.substr(csign_pos, end - csign_pos);
+            }
+
             // Extract map_bss_type (present on the 1905-layer and BH BSS objects)
             auto bss_type_pos = json.find("\"map_bss_type\":");
             if (bss_type_pos != std::string::npos) {
@@ -2250,7 +2302,9 @@ void ApAutoConfigurationTask::handle_bss_configuration_response(
                           << " map_bss_type=0x" << std::hex << (int)cfg.map_bss_type << std::dec
                           << " hidden_ssid=" << cfg.hidden_ssid
                           << " vap_label=" << cfg.vap_label
-                          << " custom_alias=" << cfg.custom_alias;
+                          << " custom_alias=" << cfg.custom_alias
+                          << " signedConnector=" << (cfg.signed_connector.empty() ? "(none)" : "(set)")
+                          << " csign=" << (cfg.csign_jwk.empty() ? "(none)" : "(set)");
                 dpp_configs.push_back(std::move(cfg));
             } else {
                 LOG(DEBUG) << "DPP: skipping sub-TLV with no SSID (1905-layer object)";
@@ -2344,30 +2398,57 @@ void ApAutoConfigurationTask::handle_bss_configuration_response(
                 LOG(DEBUG) << "DPP: AKM='" << dpp_cfg.akm << "' → dpp=" << has_dpp
                            << " psk=" << has_psk << " sae=" << has_sae;
 
+                WSC::eWscAuth base_auth_type;
                 if (has_dpp && !has_psk && !has_sae && dpp_cfg.passphrase.empty()) {
-                    // DPP-only: connector-based auth, no PSK/SAE passphrase needed.
-                    // Use open auth so only the SSID is written to the hostapd config.
-                    info.payload_config.auth_type = WSC::eWscAuth::WSC_AUTH_OPEN;
-                    info.payload_config.encr_type = WSC::eWscEncr::WSC_ENCR_NONE;
+                    // DPP-only: connector-based auth, no PSK/SAE passphrase. Per hostapd
+                    // (wpa_key_mgmt=DPP, src/ap/ap_config.h dpp_connector/dpp_csign/
+                    // dpp_netaccesskey), this is RSN-protected (wpa=2, real cipher), not
+                    // open auth — the DPP Connector authenticates the STA, it does not
+                    // remove the need for encryption.
+                    base_auth_type                = WSC::eWscAuth::WSC_AUTH_DPP;
+                    info.payload_config.encr_type = WSC::eWscEncr::WSC_ENCR_AES;
                 } else if (has_sae && has_psk) {
                     // WPA3/WPA2 mixed mode (SAE + PSK)
-                    info.payload_config.auth_type =
-                        static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
-                                                    WSC::eWscAuth::WSC_AUTH_SAE);
+                    base_auth_type = static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_WPA2PSK |
+                                                                 WSC::eWscAuth::WSC_AUTH_SAE);
                     info.payload_config.encr_type = WSC::eWscEncr::WSC_ENCR_AES;
                 } else if (has_sae) {
-                    info.payload_config.auth_type = WSC::eWscAuth::WSC_AUTH_SAE;
+                    base_auth_type                = WSC::eWscAuth::WSC_AUTH_SAE;
                     info.payload_config.encr_type = WSC::eWscEncr::WSC_ENCR_AES;
                 } else if (has_psk) {
-                    info.payload_config.auth_type = WSC::eWscAuth::WSC_AUTH_WPA2PSK;
+                    base_auth_type                = WSC::eWscAuth::WSC_AUTH_WPA2PSK;
                     info.payload_config.encr_type = WSC::eWscEncr::WSC_ENCR_AES;
                 } else {
                     // No recognised auth token (e.g. DPP-only but with passphrase, or empty)
                     LOG(WARNING) << "DPP: no auth type resolved from AKM '"
                                  << dpp_cfg.akm << "' — defaulting to WPA2-PSK";
-                    info.payload_config.auth_type = WSC::eWscAuth::WSC_AUTH_WPA2PSK;
+                    base_auth_type                = WSC::eWscAuth::WSC_AUTH_WPA2PSK;
                     info.payload_config.encr_type = WSC::eWscEncr::WSC_ENCR_AES;
                 }
+
+                // Fold the DPP AKM into the same authentication_type bitfield (per EasyMesh
+                // AKM bit allocation, WSC_AUTH_DPP = 0x0080) instead of a separate
+                // additional_auth flag, so the HAL can scope the per-VAP dpp_controller/
+                // dpp_configurator_connectivity hostapd write off this single field.
+                info.payload_config.auth_type =
+                    has_dpp ? static_cast<WSC::eWscAuth>(base_auth_type |
+                                                          WSC::eWscAuth::WSC_AUTH_DPP)
+                            : base_auth_type;
+
+                // Propagate the DPP Connector and Configurator C-sign-key (converted
+                // from JWK to DER SubjectPublicKeyInfo) parsed from this BSS's DPP
+                // Configuration Object, so the HAL can write hostapd's dpp_connector=/
+                // dpp_csign= directives. Only when AKM includes DPP.
+                if (has_dpp) {
+                    info.dpp_connector = dpp_cfg.signed_connector;
+                    if (!dpp_cfg.csign_jwk.empty()) {
+                        info.dpp_csign_der = DppAgentTask::jwk_pubkey_to_der(dpp_cfg.csign_jwk);
+                        if (info.dpp_csign_der.empty()) {
+                            LOG(WARNING) << "DPP: failed to convert csign JWK to DER for ssid="
+                                         << dpp_cfg.ssid;
+                        }
+                    }
+                }
             }
 
             // Map to WSC BSS type using map_bss_type field if present,
@@ -2400,10 +2481,8 @@ void ApAutoConfigurationTask::handle_bss_configuration_response(
             // bss_index: not present in DPP config objects — leave 0 (unset)
             info.m2_config.bss_index   = 0;
             // additional_auth: DPP connectors handle network access; no MRSNO/RSN override.
-            // Flag DPP-AKM BSS configs so the HAL can scope the per-VAP dpp_controller/
-            // dpp_configurator_connectivity hostapd write to only these BSSes.
-            info.additional_auth = has_dpp ? son::wireless_utils::eAdditionalAuth::DPP
-                                            : son::wireless_utils::eAdditionalAuth::NONE;
+            // (DPP itself is now signalled via WSC_AUTH_DPP in auth_type above, not here.)
+            info.additional_auth = son::wireless_utils::eAdditionalAuth::NONE;
 
             bss_infos.push_back(std::move(info));
         }
@@ -5870,6 +5949,62 @@ bool ApAutoConfigurationTask::send_ap_bss_configuration_message(
         request->add_wifi_credentials(c);
     }
 
+    // Forward the DPP Connector (raw JWS) and C-sign-key (DER SPKI) parsed from each BSS's
+    // DPP Configuration Object as a sibling cDppBssCredentials entry (correlated back to its
+    // BSS by bssid in ap_manager). These travel down to ap_wlan_hal_nl80211's
+    // dpp_connector=/dpp_csign= hostapd.conf writes via sBssInfoConf::dpp_connector/
+    // dpp_csign_der. Skipped for BSSes whose AKM has no DPP.
+    //
+    // This must run as its own pass over `infos`, after every wifi_credentials entry has
+    // been created *and* added: TLVF enforces a single, strictly increasing lock-order
+    // counter across all of this message's variable-length list fields in declaration order
+    // (wifi_credentials -> dpp_bss_credentials -> dpp_netaccesskey). Once
+    // create_dpp_bss_credentials() runs once, that counter advances past wifi_credentials'
+    // slot, so any later create_wifi_credentials() call (e.g. for the next VAP) would abort
+    // with "Out of order allocation for variable length list wifi_credentials". Interleaving
+    // the two lists per-BSS is therefore not possible; all wifi_credentials entries must be
+    // fully committed first.
+    for (const auto &info : infos) {
+        if ((info.payload_config.bss_type & WSC::eWscVendorExtSubelementBssType::TEARDOWN) != 0) {
+            continue;
+        }
+
+        if (info.dpp_connector.empty() && info.dpp_csign_der.empty()) {
+            continue;
+        }
+
+        auto dpp_cred = request->create_dpp_bss_credentials();
+        if (!dpp_cred) {
+            LOG(ERROR) << "Failed building message!";
+            return false;
+        }
+        dpp_cred->bssid() = info.payload_config.bssid;
+        if (!info.dpp_connector.empty()) {
+            if (!dpp_cred->alloc_connector(info.dpp_connector.size())) {
+                LOG(ERROR) << "Failed to allocate dpp_connector (" << info.dpp_connector.size()
+                           << " bytes) for BSS " << info.payload_config.bssid;
+                return false;
+            }
+            std::copy(info.dpp_connector.begin(), info.dpp_connector.end(),
+                      dpp_cred->connector());
+            ss << "- dpp_connector: " << info.dpp_connector.size() << " byte(s)" << std::endl;
+        }
+        if (!info.dpp_csign_der.empty()) {
+            if (!dpp_cred->alloc_csign(info.dpp_csign_der.size())) {
+                LOG(ERROR) << "Failed to allocate dpp_csign (" << info.dpp_csign_der.size()
+                           << " bytes) for BSS " << info.payload_config.bssid;
+                return false;
+            }
+            std::copy(info.dpp_csign_der.begin(), info.dpp_csign_der.end(), dpp_cred->csign());
+            ss << "- dpp_csign: " << info.dpp_csign_der.size() << " byte(s)" << std::endl;
+        }
+        if (!request->add_dpp_bss_credentials(dpp_cred)) {
