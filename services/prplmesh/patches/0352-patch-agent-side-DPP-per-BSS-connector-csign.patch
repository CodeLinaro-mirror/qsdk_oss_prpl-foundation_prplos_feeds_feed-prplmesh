+bool cACTION_APMANAGER_WIFI_CREDENTIALS_UPDATE_REQUEST::add_dpp_bss_credentials(std::shared_ptr<cDppBssCredentials> ptr) {
+    if (ptr == nullptr) {
+        TLVF_LOG(ERROR) << "Received entry is nullptr";
+        return false;
+    }
+    if (m_lock_allocation__ == false) {
+        TLVF_LOG(ERROR) << "No call to create_dpp_bss_credentials was called before add_dpp_bss_credentials";
+        return false;
+    }
+    uint8_t *src = (uint8_t *)m_dpp_bss_credentials;
+    if (m_dpp_bss_credentials_idx__ > 0) {
+        src = (uint8_t *)m_dpp_bss_credentials_vector[m_dpp_bss_credentials_idx__ - 1]->getBuffPtr();
+    }
+    if (ptr->getStartBuffPtr() != src) {
+        TLVF_LOG(ERROR) << "Received entry pointer is different than expected (expecting the same pointer returned from add method)";
+        return false;
+    }
+    if (ptr->getLen() > getBuffRemainingBytes(ptr->getStartBuffPtr())) {;
+        TLVF_LOG(ERROR) << "Not enough available space on buffer";
+        return false;
+    }
+    m_dpp_bss_credentials_idx__++;
+    if (!m_parse__) { (*m_dpp_bss_credentials_size)++; }
+    size_t len = ptr->getLen();
+    m_dpp_netaccesskey_length = (uint16_t *)((uint8_t *)(m_dpp_netaccesskey_length) + len - ptr->get_initial_size());
+    m_dpp_netaccesskey = (uint8_t *)((uint8_t *)(m_dpp_netaccesskey) + len - ptr->get_initial_size());
+    m_dpp_bss_credentials_vector.push_back(ptr);
+    if (!buffPtrIncrementSafe(len)) {
