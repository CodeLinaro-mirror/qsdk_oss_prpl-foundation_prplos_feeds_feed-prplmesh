+    bool ret_success = ( (m_dpp_bss_credentials_idx__ > 0) && (m_dpp_bss_credentials_idx__ > idx) );
+    size_t ret_idx = ret_success ? idx : 0;
+    if (!ret_success) {
+        TLVF_LOG(ERROR) << "Requested index is greater than the number of available entries";
+    }
+    return std::forward_as_tuple(ret_success, *(m_dpp_bss_credentials_vector[ret_idx]));
