+std::shared_ptr<cDppBssCredentials> cACTION_APMANAGER_WIFI_CREDENTIALS_UPDATE_REQUEST::create_dpp_bss_credentials() {
+    if (m_lock_order_counter__ > 2) {
+        TLVF_LOG(ERROR) << "Out of order allocation for variable length list dpp_bss_credentials, abort!";
+        return nullptr;
+    }
+    size_t len = cDppBssCredentials::get_initial_size();
+    if (m_lock_allocation__) {
+        TLVF_LOG(ERROR) << "Can't create new element before adding the previous one";
+        return nullptr;
+    }
+    if (getBuffRemainingBytes() < len) {
+        TLVF_LOG(ERROR) << "Not enough available space on buffer";
+        return nullptr;
+    }
+    m_lock_order_counter__ = 2;
+    m_lock_allocation__ = true;
+    uint8_t *src = (uint8_t *)m_dpp_bss_credentials;
+    if (m_dpp_bss_credentials_idx__ > 0) {
+        src = (uint8_t *)m_dpp_bss_credentials_vector[m_dpp_bss_credentials_idx__ - 1]->getBuffPtr();
+    }
+    if (!m_parse__) {
+        uint8_t *dst = src + len;
+        size_t move_length = getBuffRemainingBytes(src) - len;
+        std::copy_n(src, move_length, dst);
+    }
+    m_dpp_netaccesskey_length = (uint16_t *)((uint8_t *)(m_dpp_netaccesskey_length) + len);
+    m_dpp_netaccesskey = (uint8_t *)((uint8_t *)(m_dpp_netaccesskey) + len);
+    return std::make_shared<cDppBssCredentials>(src, getBuffRemainingBytes(src), m_parse__);
+}
