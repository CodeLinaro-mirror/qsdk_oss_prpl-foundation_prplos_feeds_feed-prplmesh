+bool cACTION_APMANAGER_WIFI_CREDENTIALS_UPDATE_REQUEST::set_dpp_netaccesskey(const void* buffer, size_t size) {
+    if (buffer == nullptr) {
+        TLVF_LOG(WARNING) << "set_dpp_netaccesskey received a null pointer.";
+        return false;
+    }
+    if (m_dpp_netaccesskey_idx__ != 0) {
+        TLVF_LOG(ERROR) << "set_dpp_netaccesskey was already allocated!";
+        return false;
+    }
+    if (!alloc_dpp_netaccesskey(size)) { return false; }
+    std::copy_n(reinterpret_cast<const uint8_t *>(buffer), size, m_dpp_netaccesskey);
+    return true;
+}
+bool cACTION_APMANAGER_WIFI_CREDENTIALS_UPDATE_REQUEST::alloc_dpp_netaccesskey(size_t count) {
+    if (m_lock_order_counter__ > 3) {;
+        TLVF_LOG(ERROR) << "Out of order allocation for variable length list dpp_netaccesskey, abort!";
+        return false;
+    }
+    size_t len = sizeof(uint8_t) * count;
+    if(getBuffRemainingBytes() < len )  {
+        TLVF_LOG(ERROR) << "Not enough available space on buffer - can't allocate";
+        return false;
+    }
+    m_lock_order_counter__ = 3;
+    uint8_t *src = (uint8_t *)&m_dpp_netaccesskey[*m_dpp_netaccesskey_length];
+    uint8_t *dst = src + len;
+    if (!m_parse__) {
+        size_t move_length = getBuffRemainingBytes(src) - len;
+        std::copy_n(src, move_length, dst);
+    }
+    m_dpp_netaccesskey_idx__ += count;
+    *m_dpp_netaccesskey_length += count;
+    if (!buffPtrIncrementSafe(len)) {
+        LOG(ERROR) << "buffPtrIncrementSafe(" << std::dec << len << ") Failed!";
+        return false;
+    }
+    return true;
+}
