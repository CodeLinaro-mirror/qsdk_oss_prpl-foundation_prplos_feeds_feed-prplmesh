+std::vector<uint8_t> DppAgentTask::jwk_pubkey_to_der(const std::string &jwk_json)
+{
+    if (jwk_json.empty()) return {};
+
+    auto extract_jwk_field = [&](const std::string &field) -> std::string {
+        std::string search = "\"" + field + "\":\"";
+        auto pos = jwk_json.find(search);
+        if (pos == std::string::npos) return {};
+        pos += search.size();
+        auto end = jwk_json.find('"', pos);
+        if (end == std::string::npos) return {};
+        return jwk_json.substr(pos, end - pos);
+    };
+
+    std::string x_b64 = extract_jwk_field("x");
+    std::string y_b64 = extract_jwk_field("y");
+    if (x_b64.empty() || y_b64.empty()) {
+        LOG(ERROR) << "jwk_pubkey_to_der: jwk missing x or y";
+        return {};
+    }
+
+    std::vector<uint8_t> x_bytes = base64url_decode(x_b64);
+    std::vector<uint8_t> y_bytes = base64url_decode(y_b64);
+    if (x_bytes.size() < 32 || y_bytes.size() < 32) {
+        LOG(ERROR) << "jwk_pubkey_to_der: x or y too short";
+        return {};
+    }
+
+    // Build uncompressed EC point: 0x04 || x(32) || y(32)
+    uint8_t pub[65];
+    pub[0] = 0x04;
+    memcpy(pub + 1,  x_bytes.data(), 32);
+    memcpy(pub + 33, y_bytes.data(), 32);
+
+    EVP_PKEY *pkey = nullptr;
+    OSSL_PARAM_BLD *bld = OSSL_PARAM_BLD_new();
+    OSSL_PARAM *par     = nullptr;
+    EVP_PKEY_CTX *fctx  = nullptr;
+    if (bld) {
+        OSSL_PARAM_BLD_push_utf8_string(bld, OSSL_PKEY_PARAM_GROUP_NAME, "P-256", 0);
+        OSSL_PARAM_BLD_push_octet_string(bld, OSSL_PKEY_PARAM_PUB_KEY, pub, 65);
+        par = OSSL_PARAM_BLD_to_param(bld);
+    }
+    fctx = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr);
+    if (fctx && par && EVP_PKEY_fromdata_init(fctx) == 1)
+        EVP_PKEY_fromdata(fctx, &pkey, EVP_PKEY_PUBLIC_KEY, par);
+    if (fctx) EVP_PKEY_CTX_free(fctx);
+    if (par)  OSSL_PARAM_free(par);
+    if (bld)  OSSL_PARAM_BLD_free(bld);
+
+    if (!pkey) {
+        LOG(ERROR) << "jwk_pubkey_to_der: failed to import EC public key from JWK";
+        return {};
+    }
+
+    unsigned char *der = nullptr;
+    int der_len = i2d_PUBKEY(pkey, &der);
+    EVP_PKEY_free(pkey);
+    if (der_len <= 0 || !der) {
+        LOG(ERROR) << "jwk_pubkey_to_der: i2d_PUBKEY failed";
+        return {};
+    }
+
+    std::vector<uint8_t> der_bytes(der, der + der_len);
+    OPENSSL_free(der);
+    return der_bytes;
+}
