                        << ", RUID: " << smd_policy.ruid << ", timeout: " << policy_data.smd_timeout;
         }
 
+        // Read the per-BSS DPP Connector/C-sign-key credentials, keyed by bssid so the
+        // main loop below can correlate each cDppBssCredentials entry back to the right
+        // sBssInfoConf.
+        auto dpp_bss_credentials_size = request->dpp_bss_credentials_size();
+        std::unordered_map<sMacAddr, std::pair<std::string, std::vector<uint8_t>>>
+            dpp_creds_by_bssid;
+        for (auto i = 0; i < dpp_bss_credentials_size; i++) {
+            auto dpp_cred_tuple = request->dpp_bss_credentials(i);
+            if (!std::get<0>(dpp_cred_tuple)) {
+                LOG(ERROR) << "Failed to get dpp_bss_credentials at index " << i;
+                continue;
+            }
+            auto &dpp_cred = std::get<1>(dpp_cred_tuple);
+
+            std::string connector;
+            if (dpp_cred.connector_length() > 0 && dpp_cred.connector() != nullptr) {
+                connector.assign(dpp_cred.connector(), dpp_cred.connector_length());
+            }
+            std::vector<uint8_t> csign;
+            if (dpp_cred.csign_length() > 0 && dpp_cred.csign() != nullptr) {
+                csign.assign(dpp_cred.csign(), dpp_cred.csign() + dpp_cred.csign_length());
+            }
+            dpp_creds_by_bssid[dpp_cred.bssid()] = {std::move(connector), std::move(csign)};
+
+            LOG(DEBUG) << "Received DPP credentials (connector=" << dpp_cred.connector_length()
+                       << " byte(s), csign=" << dpp_cred.csign_length()
+                       << " byte(s)) for BSS " << dpp_cred.bssid();
+        }
+
+        // Read this Agent's single DPP Network Access Key (protocol private key), shared
+        // across every BSS whose AKM includes DPP.
+        std::vector<uint8_t> dpp_netaccesskey_der;
+        const uint16_t dpp_netaccesskey_len = request->dpp_netaccesskey_length();
+        const uint8_t *dpp_netaccesskey_ptr = request->dpp_netaccesskey();
+        if (dpp_netaccesskey_len > 0 && dpp_netaccesskey_ptr != nullptr) {
+            dpp_netaccesskey_der.assign(dpp_netaccesskey_ptr,
+                                        dpp_netaccesskey_ptr + dpp_netaccesskey_len);
+            LOG(DEBUG) << "Received " << dpp_netaccesskey_len << " byte DPP netaccesskey (DER)";
+        }
+
         std::string backhaul_wps_ssid, backhaul_wps_passphrase;
         for (auto i = 0; i < wifi_credentials_size; i++) {
             son::wireless_utils::sBssInfoConf bss_info_conf;
@@ -2387,6 +2427,20 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                            << " RSN Security IE byte(s) for BSS " << bss_info_conf.bssid;
             }
 
+            // Forward the DPP Connector (raw JWS) and Configurator C-sign-key (DER SPKI)
+            // parsed by the AP-Autoconfiguration task from this BSS's DPP Configuration
+            // Object, so ap_wlan_hal_nl80211 can write hostapd's dpp_connector=/dpp_csign=
+            // directives. Empty when the BSS's AKM does not include DPP.
+            auto dpp_cred_it = dpp_creds_by_bssid.find(bss_info_conf.bssid);
+            if (dpp_cred_it != dpp_creds_by_bssid.end()) {
+                bss_info_conf.dpp_connector = dpp_cred_it->second.first;
+                bss_info_conf.dpp_csign_der = dpp_cred_it->second.second;
+            }
+            // Every per-BSS Connector is bound to this Agent's single DPP protocol key, so
+            // the same Network Access Key is forwarded to every BSS. Harmless no-op for
+            // non-DPP BSSes since ap_wlan_hal_nl80211 only reads it under the DPP AKM gate.
+            bss_info_conf.dpp_netaccesskey_der = dpp_netaccesskey_der;
+
             // Extract smd_mac from credentials
             auto smd_mac = config_data.smd_mac();
             // Match SMD policy by full smd_mac if valid
