From e5ddd82b55932019156bb1982928180200272b40 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 14 Jan 2026 11:28:44 +0530
Subject: [PATCH] Kill beerocks_agent when fronthaul-iface does not exist

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp | 25 +++++++++++++++----
 .../bwl/shared/nl80211_client_impl.cpp        | 13 +++++++++-
 2 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 74de82f4a..3e5197cf1 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4739,8 +4739,26 @@ bool slave_thread::agent_fsm()
                 }
                 if (!radio_manager.fronthaul_started) {
                     // Start the fronthaul process. Before starting, kill the existing one.
-                    fronthaul_stop(fronthaul_iface);
-                    fronthaul_start(fronthaul_iface);
+                    std::string base_interface="";
+                    size_t pos = fronthaul_iface.find("_link");
+                    if (pos != std::string::npos) {
+                        base_interface = fronthaul_iface.substr(0, pos);
+                    } else {
+                        base_interface = fronthaul_iface;
+                    }
+
+                    LOG(DEBUG) << "FRONTHAUL_IFACE - " << fronthaul_iface << " BASE: " << base_interface;
+
+                    if (!beerocks::net::network_utils::linux_iface_exists(base_interface)) {
+                        LOG(ERROR) << "iface " << base_interface << " does not exist - Killing prplmesh agent";
+                        LOG(INFO) << "KILLING BEEROCKS_AGENT";
+                        beerocks::os_utils::kill_pid("/tmp/beerocks/pid/",
+                                             std::string(BEEROCKS_AGENT));
+                    } else {
+                        LOG(DEBUG) << "iface " << base_interface << " exits - start fronthaul process";
+                        fronthaul_stop(fronthaul_iface);
+                        fronthaul_start(fronthaul_iface);
+                    }
                 }
                 return true;
             });
@@ -4802,9 +4820,6 @@ bool slave_thread::agent_fsm()
                     return true;
                 });
             LOG(DEBUG) << "goto STATE_JOIN_INIT";
-            LOG(INFO) << "KILLING BEEROCKS_AGENT";
-            beerocks::os_utils::kill_pid("/tmp/beerocks/pid/",
-                                 std::string(BEEROCKS_AGENT));
             m_agent_state = STATE_JOIN_INIT;
         }
         break;
diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index 181fda2bd..4daef7229 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -166,7 +166,18 @@ bool nl80211_client_impl::get_iface_with_link_idx(const std::string &iface_rad_i
                             continue;
                     }
                     link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
-                    LOG(INFO) << "link_id : " << link_id;
+                    LOG(INFO) << "Match found: Update link_id : " << link_id;
+                    break;
+                } else {
+                    // No freq: still try to read link_id
+                    if (link[NL80211_ATTR_MLO_LINK_ID]) {
+                        link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
+                        LOG(INFO) << "No freq reported; capturing link_id only: "
+                                  << static_cast<int>(link_id);
+                    } else {
+                        LOG(WARNING) << "MLO link missing both FREQ and LINK_ID";
+                    }
+                    // continue looping to see if a later entry has freq & matches
                 }
         }
         iface_link_idxd = base_interface + "_link" + std::to_string(link_id);
-- 
2.34.1

