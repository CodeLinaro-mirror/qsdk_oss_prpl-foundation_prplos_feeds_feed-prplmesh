From f4614cb531325eb9f08e7ae034ae63f1b2b6c941 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Tue, 4 Aug 2026 14:19:22 +0530
Subject: [PATCH] trigger ap_autoconfig task after receiving dfs-cac-complete
 event

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp | 17 +++++++++++++++++
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 19 ++++++++++++++++++-
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 1a68df930..53afe7ac8 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4120,6 +4120,23 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         action_header->radio_mac() = radio->front.iface_mac;
 
         m_backhaul_manager_client->send_cmdu(cmdu_tx);
+
+#ifdef USE_PRPLMESH_NLHAL
+        // When CAC completes successfully, the DFS channel is now available.
+        // Restart the autoconfiguration task so the controller can configure
+        // the BSS on the newly available channel.
+        if (notification_in->params().success) {
+            LOG(INFO) << "CAC completed successfully on " << fronthaul_iface
+                      << " - restarting autoconfiguration task";
+            if (db->device_conf.management_mode != BPL_MGMT_MODE_MULTIAP_CONTROLLER) {
+                m_task_pool.send_event(eTaskType::AP_AUTOCONFIGURATION,
+                                       ApAutoConfigurationTask::eEvent::START_AP_AUTOCONFIGURATION);
+            } else {
+                m_task_pool.send_event(eTaskType::AP_AUTOCONFIGURATION,
+                                       ApAutoConfigurationTask::eEvent::INIT_TASK);
+            }
+        }
+#endif // USE_PRPLMESH_NLHAL
         break;
     }
     case beerocks_message::ACTION_APMANAGER_HOSTAP_DFS_CHANNEL_AVAILABLE_NOTIFICATION: {
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index ea1a41b0e..bfdd3dc68 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -4125,7 +4125,24 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
     
     std::string base_interface="";
     extractLinkBaseInterface(m_radio_info.iface_name, base_interface);
- 
+
+    // Skip update if hostapd reports the interface is not in ENABLED state.
+    // During CAC the state is "DFS"; attempting to configure VAPs at that
+    // point is premature and can fail. The autoconfiguration task will be
+    // restarted once CAC completes successfully.
+    {
+        parsed_obj_map_t status_result;
+        if (wpa_ctrl_send_msg("STATUS", status_result)) {
+            auto state_it = status_result.find("state");
+            if (state_it != status_result.end() && state_it->second != "ENABLED") {
+                LOG(WARNING) << "update_vap_credentials: hostapd state='"
+                             << state_it->second << "' on " << m_radio_info.iface_name
+                             << " is not ENABLED, skipping update";
+                return true;
+            }
+        }
+    }
+
     // Load hostapd config for the radio
     prplmesh::hostapd::Configuration base_conf = load_hostapd_config(m_radio_info.iface_name,"");
     if (!base_conf) {
-- 
2.34.1

