 .../yaml/tlvf/WSC/eWscWifiCompatMode.yaml     |  13 +-
 6 files changed, 447 insertions(+), 157 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index bf398a466..545d134d8 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -284,6 +284,45 @@ std::string get_ifname_wrt_mld_grp(int mld_id, std::string cur_ifname, std::stri
 
        std::string result;
        if (mld_grp_primary_ifname.empty()) {
+               // Before adding a new entry for this mld_id, remove any stale entry
+               // for cur_ifname that may exist under a different mld_id.
+               // This handles the case where the MLD unit changes (e.g. the 6G link
+               // receives a new MLD unit after 2G/5G links are downgraded to 11AX):
+               // without this cleanup the file would accumulate duplicate entries for
+               // the same interface under both the old and the new MLD ID.
+               {
+                   const std::string filename = MLD_PAIR_ENTRANT_FILE;
+                   std::ifstream infile(filename);
+                   std::vector<std::string> lines;
+                   std::string line;
+                   bool removed = false;
+                   while (std::getline(infile, line)) {
+                       if (line.empty()) continue;
+                       std::istringstream iss(line);
+                       std::string id_str, ifname_str, ssid_str;
+                       if (std::getline(iss, id_str, ',') &&
+                           std::getline(iss, ifname_str, ',') &&
+                           std::getline(iss, ssid_str)) {
+                           if (ifname_str == cur_ifname) {
+                               LOG(INFO) << "get_ifname_wrt_mld_grp: removing stale entry"
+                                         << " ifname=" << cur_ifname
+                                         << " old_mld_id=" << id_str
+                                         << " new_mld_id=" << mld_id;
+                               removed = true;
+                               continue; // skip this line to remove it
+                           }
+                       }
+                       lines.push_back(line);
+                   }
+                   infile.close();
+                   if (removed) {
+                       std::ofstream outfile(filename, std::ios::trunc);
+                       for (const auto &l : lines) {
+                           outfile << l << "\n";
+                       }
+                       outfile.close();
+                   }
+               }
                update_mld_grp_primary_ifname(mld_id, cur_ifname, ssid);
                result = cur_ifname;
        } else {
@@ -3381,106 +3420,162 @@ bool ap_wlan_hal_nl80211::handle_wifi_compat_mode(
                      << bss_iface << " -> skipping early-exit check, proceeding with mode change";
     }
 
-    // Early exit: use ieee80211be from STATUS to check the actual runtime state.
-    //   WIFI_COMPAT_MODE_11AX → want ieee80211be=0 (EHT disabled)
-    //   WIFI_COMPAT_MODE_11BE → want ieee80211be=1 (EHT enabled)
+    // Early exit: fetch all relevant IEEE 802.11 generation status fields upfront from the
+    // already-queried hostapd STATUS result, then decide per compat mode whether the BSS is
+    // already in the desired state.
+    //
+    // Fields fetched (all from a single STATUS call made above):
+    //   ieee80211be  - "1" = EHT (Wi-Fi 7) enabled,  "0" = disabled, "" = not reported
+    //   ieee80211bn  - "1" = UHR (Wi-Fi 8) enabled,  "0" = disabled, "" = not reported
+    //   ieee80211ax  - "1" = HE  (Wi-Fi 6) enabled,  "0" = disabled, "" = not reported
+    //
+    // Decision table per compat mode (target state → early-exit condition):
+    //   11AX: want ieee80211be=0, ieee80211ax=1  (HE on, EHT off)
+    //         NOTE: ieee80211ax=0 means disable_11ax was set by a prior 11AC transition and
+    //         must be cleared even though ieee80211be is already 0 — do NOT return early.
+    //   11AC: want ieee80211be=0, ieee80211ax=0  (HE off, EHT off)
+    //   11BE: want ieee80211be=1, ieee80211bn=0  (EHT on, UHR off — only if uhr_supported)
+    //   11BN: want ieee80211be=1, ieee80211bn=1  (EHT on, UHR on)
+    std::string status_ieee80211be;
+    std::string status_ieee80211bn;
+    std::string status_ieee80211ax;
+    std::string status_ieee80211ac;
+
     if (bss_status_valid) {
-        auto it = bss_status.find("ieee80211be");
-        if (it != bss_status.end() && !it->second.empty()) {
-            const std::string &current_ieee80211be = it->second;
-            const std::string expected_ieee80211be =
-                (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX)
-                    ? "0"
-                    : "1";
-            if (current_ieee80211be == expected_ieee80211be) {
-                // For WIFI_COMPAT_MODE_11BE: also check if ieee80211bn needs to be disabled.
-                // Use m_radio_info.uhr_supported (set from hostapd config ieee80211bn head value
-                // in refresh_radio_info()) to determine if the device is Wi-Fi 8 capable.
-                // Only Wi-Fi 8 capable devices need disable_11bn=1; on Wi-Fi 7-only devices
-                // the ieee80211bn option is invalid and must not be set.
-                if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
-                    if (m_radio_info.uhr_supported) {
-                        // Check ieee80211bn from STATUS: if already=0, disable_11bn is already
-                        // applied and no further action is needed — return early.
-                        auto bn_it = bss_status.find("ieee80211bn");
-                        if (bn_it != bss_status.end() && bn_it->second == "0") {
-                            LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be already=1 and"
-                                       << " uhr_supported=true but ieee80211bn already=0"
-                                       << " (disable_11bn already applied) for bssid=" << bssid_str
-                                       << " (no change needed, returning early)";
-                            return true;
-                        }
-                        LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be already=1 and"
-                                   << " uhr_supported=true (ieee80211bn=1 in hostapd config)"
-                                   << " -> need to set disable_11bn=1"
-                                   << " for bssid=" << bssid_str;
-                        // Don't return early — fall through to handle disable_11bn=1
-                        conversion_performed = true;
-                    } else {
-                        LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be already="
-                                   << current_ieee80211be
-                                   << " uhr_supported=false (not Wi-Fi 8 capable)"
-                                   << " -> bssid=" << bssid_str
-                                   << " (no change needed, returning early)";
-                        return true;
-                    }
-                } else if (bss_conf.wifi_compat_mode ==
-                           WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN) {
-                    // For 11BN: first check if device is Wi-Fi 8 (11BN) capable.
-                    // Only devices with uhr_supported=true have ieee80211bn enabled in hostapd;
-                    // on Wi-Fi 7-only devices the ieee80211bn option is invalid and must not
-                    // be touched.
-                    if (!m_radio_info.uhr_supported) {
-                        LOG(DEBUG) << "handle_wifi_compat_mode: WIFI_COMPAT_MODE_11BN -"
-                                   << " device is not Wi-Fi 8 (11BN) capable"
-                                   << " (uhr_supported=false) for bssid=" << bssid_str
-                                   << " -> skipping (no change needed)";
-                        return true;
-                    }
-                    // Check if ieee80211bn is already absent or enabled (i.e., disable_11bn
-                    // already cleared).  In 11BN mode, ieee80211bn=1 (or absent from STATUS)
-                    // means Wi-Fi 8 is already fully enabled — no change needed.
-                    // Only proceed if ieee80211bn=0 (disable_11bn still set in hostapd config).
-                    // This mirrors the symmetric early-exit check in the 11BE path above which
-                    // returns early when ieee80211bn=0 (disable_11bn already applied).
-                    {
-                        auto bn_it = bss_status.find("ieee80211bn");
-                        if (bn_it == bss_status.end() || bn_it->second != "0") {
-                            LOG(DEBUG) << "handle_wifi_compat_mode: WIFI_COMPAT_MODE_11BN -"
-                                       << " ieee80211be=1 and ieee80211bn already enabled/absent"
-                                       << " for bssid=" << bssid_str
-                                       << " (no change needed, returning early)";
-                            return true;
-                        }
-                    }
-                    // ieee80211bn=0 still set: need to clear disable_11bn.
-                    // Don't return early — fall through to clear disable_11be and disable_11bn.
-                    LOG(DEBUG) << "handle_wifi_compat_mode: WIFI_COMPAT_MODE_11BN -"
-                               << " ieee80211be already=1 and uhr_supported=true"
-                               << " but ieee80211bn=0 -> need to clear disable_11bn"
-                               << " for bssid=" << bssid_str;
-                    conversion_performed = true;
-                } else {
-                    LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be already="
-                               << current_ieee80211be
-                               << " bssid=" << bssid_str
+        auto be_it = bss_status.find("ieee80211be");
+        if (be_it != bss_status.end() && !be_it->second.empty()) {
+            status_ieee80211be = be_it->second;
+        }
+        auto bn_it = bss_status.find("ieee80211bn");
+        if (bn_it != bss_status.end() && !bn_it->second.empty()) {
+            status_ieee80211bn = bn_it->second;
+        }
+        auto ax_it = bss_status.find("ieee80211ax");
+        if (ax_it != bss_status.end() && !ax_it->second.empty()) {
+            status_ieee80211ax = ax_it->second;
+        }
+        auto ac_it = bss_status.find("ieee80211ac");
+        if (ac_it != bss_status.end() && !ac_it->second.empty()) {
+            status_ieee80211ac = ac_it->second;
+        }
+        LOG(DEBUG) << "handle_wifi_compat_mode: STATUS ieee80211be='" << status_ieee80211be
+                   << "' ieee80211bn='" << status_ieee80211bn
+                   << "' ieee80211ax='" << status_ieee80211ax
+                   << "' ieee80211ac='" << status_ieee80211ac
+                   << "' for bss_iface=" << bss_iface;
+    }
+
+    if (bss_status_valid && !status_ieee80211be.empty()) {
+        switch (bss_conf.wifi_compat_mode) {
+        case WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX:
+            // Target: ieee80211ax=1 (HE enabled) AND ieee80211be=0 (EHT disabled).
+            // In 11BE mode ieee80211ax is also "1" (HE is active alongside EHT), so
+            // checking ieee80211ax alone is not sufficient — we must also verify that
+            // EHT is already disabled before returning early.
+            if (status_ieee80211ax == "1" && status_ieee80211be != "1") {
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11AX - already correct"
+                           << " (ieee80211ax=1, ieee80211be='" << status_ieee80211be << "')"
+                           << " for bssid=" << bssid_str
+                           << " (no change needed, returning early)";
+                return true;
+            }
+            // Conversion needed: either HE is not yet enabled, or EHT is still active (11BE mode).
+            LOG(DEBUG) << "handle_wifi_compat_mode: 11AX - ieee80211ax='" << status_ieee80211ax
+                       << "' ieee80211be='" << status_ieee80211be
+                       << "' -> conversion needed for bssid=" << bssid_str;
+            conversion_performed = true;
+            break;
+
+        case WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC:
+            // Target: ieee80211ac=1 (VHT active) AND ieee80211ax=0 (HE disabled).
+            // In 11AX mode ieee80211ac is also "1" (VHT is active alongside HE), so
+            // checking ieee80211ac alone is not sufficient — we must also verify that
+            // HE is already disabled before returning early.
+            if (status_ieee80211ac == "1" && status_ieee80211ax != "1") {
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11AC - already correct"
+                           << " (ieee80211ac=1, ieee80211ax='" << status_ieee80211ax << "')"
+                           << " for bssid=" << bssid_str
+                           << " (no change needed, returning early)";
+                return true;
+            }
+            // Conversion needed: either VHT is not active, or HE is still enabled (11AX/11BE mode).
+            LOG(DEBUG) << "handle_wifi_compat_mode: 11AC - ieee80211ac='" << status_ieee80211ac
+                       << "' ieee80211ax='" << status_ieee80211ax
+                       << "' -> conversion needed for bssid=" << bssid_str;
+            conversion_performed = true;
+            break;
+
+        case WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE:
+            // Target: ieee80211be=1 (EHT enabled), ieee80211bn=0 (UHR disabled, if uhr_supported).
+            if (status_ieee80211be == "1") {
+                if (!m_radio_info.uhr_supported) {
+                    // Wi-Fi 7-only device: ieee80211be=1 is sufficient.
+                    LOG(DEBUG) << "handle_wifi_compat_mode: 11BE - ieee80211be=1 and"
+                               << " uhr_supported=false -> already correct for bssid=" << bssid_str
                                << " (no change needed, returning early)";
                     return true;
                 }
+                // Wi-Fi 8 capable: also need ieee80211bn=0 (disable_11bn applied).
+                if (status_ieee80211bn == "0") {
+                    LOG(DEBUG) << "handle_wifi_compat_mode: 11BE - ieee80211be=1 and"
+                               << " ieee80211bn=0 (disable_11bn already applied)"
+                               << " -> already correct for bssid=" << bssid_str
+                               << " (no change needed, returning early)";
+                    return true;
+                }
+                // ieee80211bn=1 or not reported: need to set disable_11bn=1.
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11BE - ieee80211be=1 but"
+                           << " ieee80211bn='" << status_ieee80211bn << "'"
+                           << " (disable_11bn not yet applied)"
+                           << " -> need to set disable_11bn=1 for bssid=" << bssid_str;
+                conversion_performed = true;
+            } else {
+                // ieee80211be=0: EHT not yet enabled, need BSS transition.
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11BE - ieee80211be=0"
+                           << " -> need to enable EHT for bssid=" << bssid_str;
+                conversion_performed = true;
             }
-            LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be=" << current_ieee80211be
-                       << " but expected=" << expected_ieee80211be
-                       << " bssid=" << bssid_str
-                       << " -> proceeding with mode change";
-            // A mode change is needed regardless of whether it succeeds or fails.
-            conversion_performed = true;
-        } else {
-            LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be not found in STATUS"
-                       << " for bss_iface=" << bss_iface
-                       << " -> proceeding with mode change";
-            // ieee80211be status unknown — assume a mode change is needed.
-            conversion_performed = true;
+            break;
+
+        case WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BN:
+            // Target: ieee80211be=1 (EHT enabled), ieee80211bn=1 (UHR enabled).
+            if (!m_radio_info.uhr_supported) {
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11BN - device not Wi-Fi 8 capable"
+                           << " (uhr_supported=false) -> skipping for bssid=" << bssid_str
+                           << " (no change needed, returning early)";
+                return true;
+            }
+            if (status_ieee80211be == "1") {
+                if (status_ieee80211bn != "0") {
+                    // ieee80211bn=1 or not reported: UHR already enabled.
+                    LOG(DEBUG) << "handle_wifi_compat_mode: 11BN - ieee80211be=1 and"
+                               << " ieee80211bn='" << status_ieee80211bn << "'"
+                               << " (UHR already enabled/absent)"
+                               << " -> already correct for bssid=" << bssid_str
+                               << " (no change needed, returning early)";
+                    return true;
+                }
+                // ieee80211bn=0: need to clear disable_11bn.
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11BN - ieee80211be=1 but"
+                           << " ieee80211bn=0 (disable_11bn still set)"
+                           << " -> need to clear disable_11bn for bssid=" << bssid_str;
+                conversion_performed = true;
+            } else {
+                // ieee80211be=0: EHT not enabled, need BSS transition.
+                LOG(DEBUG) << "handle_wifi_compat_mode: 11BN - ieee80211be=0"
+                           << " -> need to enable EHT for bssid=" << bssid_str;
+                conversion_performed = true;
+            }
+            break;
+
+        default:
+            break;
         }
+    } else if (bss_status_valid) {
+        // STATUS was valid but ieee80211be not reported — assume a mode change is needed.
+        LOG(DEBUG) << "handle_wifi_compat_mode: ieee80211be not found in STATUS"
+                   << " for bss_iface=" << bss_iface << " -> proceeding with mode change";
+        conversion_performed = true;
     }
 
     // Translate wifi_compat_mode to the hostapd disable_11be value.
@@ -3488,6 +3583,7 @@ bool ap_wlan_hal_nl80211::handle_wifi_compat_mode(
     //   WIFI_COMPAT_MODE_11BE → disable_11be=0  (802.11be / Wi-Fi 7 enabled)
     std::string disable_11be_val;
     std::string disable_11bn_val;
+    std::string disable_11ax_val;
     std::string mld_ap_val;
     if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX) {
         disable_11be_val = "1";
@@ -3495,6 +3591,16 @@ bool ap_wlan_hal_nl80211::handle_wifi_compat_mode(
         mld_ap_val = "0";
         LOG(INFO) << "handle_wifi_compat_mode: wifi_compat_mode=11AX"
                   << " -> disable_11be=1 disable_11bn=1 (EHT+UHR disabled) for bssid=" << bssid_str;
+    } else if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AC) {
+        // Wi-Fi 5 (802.11ac): disable HE (11ax), EHT (11be), and EHT+ (11bn).
+        // This is the most restrictive compat mode — only VHT/Wi-Fi 5 clients are served.
+        disable_11be_val = "1";
+        disable_11bn_val = "1";
+        disable_11ax_val = "1";
+        mld_ap_val = "0";
+        LOG(INFO) << "handle_wifi_compat_mode: wifi_compat_mode=11AC"
+                  << " -> disable_11be=1 disable_11bn=1 disable_11ax=1"
+                  << " (EHT+HE+UHR disabled, Wi-Fi 5 only) for bssid=" << bssid_str;
     } else if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
         disable_11be_val = "0";
         disable_11bn_val = "1";
@@ -3534,13 +3640,18 @@ bool ap_wlan_hal_nl80211::handle_wifi_compat_mode(
         return true;
     }
 
-    // Write the disable_11be / disable_11bn per-VAP options.
+    // Write the disable_11be / disable_11bn / disable_11ax per-VAP options.
     conf.set_create_vap_value(vap_id, "disable_11be", disable_11be_val);
     // disable_11bn is only valid on Wi-Fi 8 (UHR) capable devices; skip on Wi-Fi 7-only hardware.
     if (m_radio_info.uhr_supported) {
         conf.set_create_vap_value(vap_id, "disable_11bn", disable_11bn_val);
     }
     conf.set_create_vap_value(vap_id, "mld_ap", mld_ap_val);
+    // disable_11ax is only set for WIFI_COMPAT_MODE_11AC (Wi-Fi 5 compat mode).
+    // It disables HE (802.11ax / Wi-Fi 6) in addition to EHT and UHR.
+    if (!disable_11ax_val.empty()) {
+        conf.set_create_vap_value(vap_id, "disable_11ax", disable_11ax_val);
+    }
 
     // Lambda: generate a free BSS interface name using the wlan<radio_num>_<index>
     // scheme.  Must be called AFTER LINK_REMOVE/REMOVE so that the old interface has
@@ -3651,6 +3762,49 @@ bool ap_wlan_hal_nl80211::handle_wifi_compat_mode(
         // to avoid issuing a second STATUS command to hostapd.
         int num_links = 0;
 
+        // AC→AX conversion: ieee80211ac=1 (VHT/Wi-Fi 5 is active, BSS is in 11AC mode)
+        // and ieee80211ax=0 (HE was disabled by a prior 11AC transition).
+        // In this case NO BSS teardown (LINK_REMOVE / REMOVE) is needed — the BSS is
+        // already in SLO mode.  Just clear disable_11ax in the conf and trigger
+        // RELOAD_CONFIG so hostapd re-enables HE (802.11ax).
+        // LINK_REMOVE / REMOVE are only required for BE→AX conversion (ieee80211be=1).
+        if (bss_status_valid && status_ieee80211ac == "1" && status_ieee80211ax == "0") {
+            LOG(INFO) << "handle_wifi_compat_mode: 11AX - AC->AX conversion"
+                      << " (ieee80211ac=1, ieee80211ax=0)"
+                      << " -> clearing disable_11ax and sending RELOAD_CONFIG for bssid="
+                      << bssid_str;
+
+            // Clear disable_11ax so HE (802.11ax) is re-enabled.
+            // The conf object already has disable_11be=1 and mld_ap=0 applied above.
+            conf.set_create_vap_value(vap_id, "disable_11ax", "");
+
+            if (!conf.store(vap_id)) {
+                LOG(ERROR) << "handle_wifi_compat_mode: failed to store hostapd config"
+                           << " for 11AX AC->AX bssid=" << bssid_str;
+                return false;
+            }
+
+            // Trigger RELOAD_CONFIG so hostapd picks up the cleared disable_11ax.
+            const std::string reload_cmd("RELOAD_CONFIG");
+            if (!wpa_ctrl_send_msg(reload_cmd, bss_iface)) {
+                LOG(ERROR) << "handle_wifi_compat_mode: RELOAD_CONFIG failed for "
+                           << bss_iface;
+            } else {
+                LOG(INFO) << "handle_wifi_compat_mode: RELOAD_CONFIG sent for"
+                          << " 11AX AC->AX (disable_11ax cleared) on " << bss_iface;
+                // Update UCI wireless to clear disable_11ax.
+                // set_wifi_compat_mode_from_vap() calls bpl_cfg_set_wifi_compat_mode_uci()
+                // which handles WIFI_COMPAT_MODE_11AX by clearing disable_11ax.
+                std::string base_iface;
+                extractLinkBaseInterface(bss_iface, base_iface);
+                set_wifi_compat_mode_from_vap(bss_conf, base_iface, base_iface,
+                                              m_radio_info.radio_id);
+            }
+
+            conversion_performed = true;
+            return true;
+        }
+
         if (bss_status_valid) {
             auto it = bss_status.find("num_links");
             if (it != bss_status.end() && !it->second.empty()) {
@@ -3932,6 +4086,17 @@ bool ap_wlan_hal_nl80211::handle_wifi_compat_mode(
              config_lines.push_back("mld_ap=0");
          }
 
+         // Clear disable_11ax from the new BSS config so HE (802.11ax) is re-enabled
+         // when transitioning from 11AC mode (where disable_11ax=1 was set) to 11AX mode.
+         // Without this, a prior 11AC→11AX transition would leave disable_11ax=1 in the
+         // new SLO BSS config, keeping HE disabled even though 11AX mode requires it.
+         config_lines.erase(
+             std::remove_if(config_lines.begin(), config_lines.end(),
+                 [](const std::string &line) {
+                     return line.rfind("disable_11ax=", 0) == 0;
+                 }),
+             config_lines.end());
+
          // Create a dedicated conf file for the new SLO BSS.
