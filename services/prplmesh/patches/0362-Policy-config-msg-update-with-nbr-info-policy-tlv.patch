From 185bc5ce6ffb11cf99901f39c01fb5ad007c31d3 Mon Sep 17 00:00:00 2001
From: Ameya Phadke <phadke@qti.qualcomm.com>
Date: Wed, 19 Aug 2026 17:10:41 -0700
Subject: [PATCH] Policy config msg update with nbr info policy tlv

Signed-off-by: Ameya Phadke <phadke@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 30 +++++++++++++++++++
 .../master/tasks/agent_monitoring_task.cpp    | 18 +++++++++++
 2 files changed, 48 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 2425eedbb..4e1f4e95f 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -8,6 +8,7 @@
 
 #include "ap_autoconfiguration_task.h"
 #include "link_metrics_collection_task.h"
+#include "neighbor_db_agent_task.h"
 #include "service_prioritization_task.h"
 #include "traffic_separation_task.h"
 
@@ -60,6 +61,7 @@
 #include <tlvf/wfa_map/tlvSearchedService.h>
 #include <tlvf/wfa_map/tlvSteeringPolicy.h>
 #include <tlvf/wfa_map/tlvSupportedService.h>
+#include <tlvf/wfa_map/tlvWifi8NeighborInformationReportingPolicy.h>
 #include <tlvf/wfa_map/tlvBssConfigurationResponse.h>
 #include <tlvf/wfa_map/tlvBssConfigurationReport.h>
 #include <tlvf/wfa_map/tlvEHTOperations.h>
@@ -3209,6 +3211,34 @@ void ApAutoConfigurationTask::handle_multi_ap_policy_config_request(
                    << db->link_metrics_policy.failed_associations_maximum_reporting_rate;
     }
 
+    /** Neighbor Information Reporting Policy **/
+    // Parse the Neighbor Information Reporting Policy TLV (Wi-Fi EasyMesh 6.1, §17.2.110).
+    // If fBSS or bBSS reporting is enabled by the controller, trigger the NeighborDbAgentTask
+    // to collect and send the local neighbor report to the controller.
+    auto neighbor_info_reporting_policy_tlv =
+        cmdu_rx.getClass<wfa_map::tlvWifi8NeighborInformationReportingPolicy>();
+    if (neighbor_info_reporting_policy_tlv) {
+        const uint8_t flags    = neighbor_info_reporting_policy_tlv->flags();
+        const bool bssid_valid = (flags >> 7) & 0x01;
+        const bool bbss_report = (flags >> 6) & 0x01;
+        const bool fbss_report = (flags >> 5) & 0x01;
+
+        LOG(DEBUG) << "Received Neighbor Information Reporting Policy TLV:"
+                   << " BSSID_valid=" << bssid_valid << " fBSS_report=" << fbss_report
+                   << " bBSS_report=" << bbss_report
+                   << " num_bssid=" << int(neighbor_info_reporting_policy_tlv->num_bssid());
+
+        // Trigger local neighbor info reporting when fBSS or bBSS reporting is enabled.
+        // (Both bits are only valid when BSSID_valid=0.)
+        if (!bssid_valid && (fbss_report || bbss_report)) {
+            LOG(DEBUG) << "Triggering NeighborDbAgentTask: TRIGGER_SEND_LOCAL_NEIGHBOR_INFO"
+                       << " (fBSS=" << fbss_report << " bBSS=" << bbss_report << ")";
+            m_btl_ctx.task_pool_send_event(
+                eTaskType::NEIGHBOR_DB,
+                static_cast<uint8_t>(NeighborDbAgentTask::TRIGGER_SEND_LOCAL_NEIGHBOR_INFO));
+        }
+    }
+
     // Trigger TrafficSeparationTask only if the TS policy changed or has not been applied yet.
     // The "all radios configured" trigger already applies TS after M2 processing (which also
     // carries the TS TLV). Re-triggering here when the policy is unchanged causes a redundant
diff --git a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
index 677fd1eec..90f390916 100644
--- a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
+++ b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
@@ -721,6 +721,24 @@ bool agent_monitoring_task::send_multi_ap_policy_config_request(const sMacAddr &
         return false;
     }
 
+    // Add Neighbor Information Reporting Policy TLV
+    // Per Wi-Fi EasyMesh 6.1, §17.2.110 (Table 133):
+    //   BSSID_valid = 0 (bit7=0) → policy applies to all BSSes on the agent
+    //   bBSS reporting disabled  (bit6=0)
+    //   fBSS reporting enabled   (bit5=1)
+    //   num_bssid = 0            (required when BSSID_valid=0; bssid_list is omitted)
+    auto neighbor_info_reporting_policy_tlv =
+        cmdu_tx.addClass<wfa_map::tlvWifi8NeighborInformationReportingPolicy>();
+    if (!neighbor_info_reporting_policy_tlv) {
+        LOG(ERROR) << "addClass wfa_map::tlvWifi8NeighborInformationReportingPolicy has failed";
+        return false;
+    }
+    neighbor_info_reporting_policy_tlv->flags()     = 0x20; // bit5=1 (fBSS enabled)
+    neighbor_info_reporting_policy_tlv->num_bssid() = 0;    // BSSID_valid=0 → no BSSID list
+
+    LOG(DEBUG) << "Added Neighbor Information Reporting Policy TLV to agent " << dst_mac
+               << ": flags=0x20 (fBSS reporting enabled), num_bssid=0";
+
     return son_actions::send_cmdu_to_agent(dst_mac, cmdu_tx, database);
 }
 
