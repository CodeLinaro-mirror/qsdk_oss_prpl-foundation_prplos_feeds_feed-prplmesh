From 985094d57b0e55bc3b855b6e76bd290234798889 Mon Sep 17 00:00:00 2001
From: Manoj Sekar <sekar@qti.qualcomm.com>
Date: Mon, 12 Oct 2026 09:46:01 +0530
Subject: [PATCH] agent: Resolve generic 320MHz bw value when building Device
 Info TLV

beerocks::eWiFiBandwidth represents 320MHz operation with three distinct
values: BANDWIDTH_320_1, BANDWIDTH_320_2 (the two concrete 160MHz-aligned
sub-variants), and a generic BANDWIDTH_320 that does not by itself
indicate which sub-variant is in use. Depending on the HAL/driver, a
radio's wifi_channel can be populated with any of the three.

convert_bandwidth() in topology_task.cpp, which derives the
dot11CurrentChannelBandwidth value for the IEEE 802.11-specific info in
the Device Information TLV, only handled the two concrete sub-variants.
When a radio's wifi_channel held the generic BANDWIDTH_320 value, the
switch fell through to the default case and reported 20MHz instead of
320MHz.

Resolve the generic value to its concrete sub-variant before mapping it
to the IEEE 802.11be bandwidth encoding, using the radio's actual
channel and center frequency against the known center channel of each
320MHz sub-variant in channels_table_6g - the same approach already used
for this disambiguation in
tlvf_utils.cpp::create_operating_channel_report(). convert_bandwidth()
now takes the radio's full WifiChannel instead of just the bandwidth
enum so this resolution can be performed. If the sub-variant cannot be
determined, the function reports 320MHz (cbw320-1) rather than falling
through to the 20MHz default, since the radio is still known to be
operating at 320MHz.

Signed-off-by: Manoj Sekar <sekar@qti.qualcomm.com>
---
 .../beerocks/slave/tasks/topology_task.cpp    | 48 +++++++++++++++++--
 1 file changed, 44 insertions(+), 4 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/topology_task.cpp b/agent/src/beerocks/slave/tasks/topology_task.cpp
index e346eb5..9b68a91 100644
--- a/agent/src/beerocks/slave/tasks/topology_task.cpp
+++ b/agent/src/beerocks/slave/tasks/topology_task.cpp
@@ -49,11 +49,22 @@ using namespace multi_vendor;
 constexpr uint8_t TOPOLOGY_DISCOVERY_TX_CYCLE_SEC     = 60;
 constexpr uint8_t TOPOLOGY_NOTIFICATION_MAX_DELAY_SEC = 1;
 
-// Convert beerocks bw to 802_11 bw
-uint8_t convert_bandwidth(eWiFiBandwidth bw)
+// Convert beerocks bandwidth to the dot11CurrentChannelBandwidth encoding used by the IEEE
+// 802.11-specific info in the Device Information TLV.
+//
+// beerocks::eWiFiBandwidth represents 320MHz operation with three distinct values:
+// BANDWIDTH_320_1, BANDWIDTH_320_2 (the two concrete 160MHz-aligned sub-variants), and a generic
+// BANDWIDTH_320 that does not by itself indicate which sub-variant is in use. A radio's
+// wifi_channel can be populated with any of these three depending on the HAL/driver. The generic
+// value therefore needs to be resolved to the concrete sub-variant before it can be mapped to the
+// IEEE 802.11be bandwidth encoding below; take the full WifiChannel (rather than just the
+// bandwidth enum) so that resolution can be done here using the radio's actual channel and center
+// frequency.
+uint8_t convert_bandwidth(const beerocks::WifiChannel &wifi_channel)
 {
     // IEEE P802.11be/D6.0, May 2024 -> page 989
-    // cbw20(0), cbw40(1), cbw80(2), cbw160(3), cbw320-1(4), cbw320-1(5)
+    // cbw20(0), cbw40(1), cbw80(2), cbw160(3), cbw320-1(4), cbw320-2(5)
+    auto bw = wifi_channel.get_bandwidth();
     switch (bw) {
     case eWiFiBandwidth::BANDWIDTH_20:
         return 0;
@@ -67,6 +78,35 @@ uint8_t convert_bandwidth(eWiFiBandwidth bw)
         return 4;
     case eWiFiBandwidth::BANDWIDTH_320_2:
         return 5;
+    case eWiFiBandwidth::BANDWIDTH_320: {
+        // Resolve which 160MHz half of the 320MHz channel carries the primary channel by
+        // comparing the radio's actual center frequency against the channels table's known
+        // center channel for each 320MHz sub-variant of this primary channel.
+        auto center_channel_of_current_freq =
+            son::wireless_utils::freq_to_channel(wifi_channel.get_center_frequency());
+        auto channel_it = son::wireless_utils::channels_table_6g.find(wifi_channel.get_channel());
+        if (channel_it != son::wireless_utils::channels_table_6g.end()) {
+            auto bw320_1_it = channel_it->second.find(eWiFiBandwidth::BANDWIDTH_320_1);
+            auto bw320_2_it = channel_it->second.find(eWiFiBandwidth::BANDWIDTH_320_2);
+            if (bw320_1_it != channel_it->second.end() &&
+                bw320_1_it->second.center_channel == center_channel_of_current_freq) {
+                return 4;
+            }
+            if (bw320_2_it != channel_it->second.end() &&
+                bw320_2_it->second.center_channel == center_channel_of_current_freq) {
+                return 5;
+            }
+        }
+        // Sub-variant could not be disambiguated (e.g. channels table lookup miss). Report
+        // 320MHz (cbw320-1) rather than falling through to the 20MHz default below, since the
+        // radio is still known to be operating at 320MHz.
+        LOG(WARNING) << "convert_bandwidth: could not disambiguate 320MHz-1 vs 320MHz-2 for "
+                        "channel "
+                     << int(wifi_channel.get_channel())
+                     << " center_freq=" << wifi_channel.get_center_frequency()
+                     << " - defaulting to cbw320-1(4)";
+        return 4;
+    }
     default:
         return 0; // Safe default
     }
@@ -782,7 +822,7 @@ bool TopologyTask::add_device_information_and_bridging_capability_tlv()
             .media_type     = media_type,
             .is_wlan        = true,
             .is_backhaul    = true,
-            .ap_chan_bw     = convert_bandwidth(radio->wifi_channel.get_bandwidth()),
+            .ap_chan_bw     = convert_bandwidth(radio->wifi_channel),
             .ap_chan_index1 = radio->wifi_channel.get_channel(),
             .ap_chan_index2 = static_cast<uint8_t>(radio->wifi_channel.get_center_frequency_2())};
 
-- 
2.34.1

