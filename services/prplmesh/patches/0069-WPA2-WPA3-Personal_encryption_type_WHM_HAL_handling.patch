From 84f7e3bb6c4b03fc3fafda37c30678baeccd54e2 Mon Sep 17 00:00:00 2001
From: nushanth <nushanth@qti.qualcomm.com>
Date: Fri, 3 Apr 2026 14:43:21 +0530
Subject: [PATCH] WPA2-WPA3-Personal_encryption_type_WHM_HAL_handling

[Revert] common: security: align spelling of WPA3 transition

Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 agent/src/beerocks/slave/nbapi/odl/agent.odl.in       | 3 ---
 agent/src/beerocks/slave/son_slave_thread.cpp         | 2 --
 common/beerocks/bcl/source/son/son_wireless_utils.cpp | 2 ++
 common/beerocks/bwl/include/bwl/base_wlan_hal_types.h | 2 +-
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp           | 2 +-
 common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp          | 2 +-
 common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp        | 2 +-
 framework/platform/wbapi/wbapi_utils.cpp              | 6 ++----
 framework/tlvf/yaml/tlvf/WSC/eWscEncr.yaml            | 3 ++-
 9 files changed, 10 insertions(+), 14 deletions(-)

diff --git a/agent/src/beerocks/slave/nbapi/odl/agent.odl.in b/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
index 559801f0d..b8008de2f 100644
--- a/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
+++ b/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
@@ -93,9 +93,6 @@
 
             /* Network credentials: Security */
             %persistent string Security {
-                on action validate call check_enum ["None", "OWE",
-                "WPA2-Personal","WPA3-Personal","WPA3-Personal-Transition",
-                "WPA3-Personal-Compatibility"];
                 default "WPA2-Personal";
             }
 
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 152177dc2..bcdb1fc9d 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -495,8 +495,6 @@ bool slave_thread::read_platform_configuration()
             return bwl::WiFiSec::WPA_WPA2_PSK;
         } else if (!sec.compare("WPA2-WPA3-Personal")) {
             return bwl::WiFiSec::WPA2_WPA3_PSK;
-        } else if (!sec.compare("WPA3-Personal-Transition")) {
-            return bwl::WiFiSec::WPA2_WPA3_PSK;
         } else if (!sec.compare("WPA3-Personal")) {
             return bwl::WiFiSec::WPA3_PSK;
         } else if (!sec.compare("OWE")) {
diff --git a/common/beerocks/bcl/source/son/son_wireless_utils.cpp b/common/beerocks/bcl/source/son/son_wireless_utils.cpp
index 529613503..203a2d185 100644
--- a/common/beerocks/bcl/source/son/son_wireless_utils.cpp
+++ b/common/beerocks/bcl/source/son/son_wireless_utils.cpp
@@ -1742,6 +1742,8 @@ std::string wireless_utils::wsc_to_bwl_encryption(WSC::eWscEncr enctype)
         return "TKIP";
     case WSC::eWscEncr::WSC_ENCR_AES:
         return "AES";
+    case WSC::eWscEncr::WSC_ENCR_TKIP_AES:
+        return "TKIP-AES";
     default:
         return "INVALID";
     }
diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index 2708fe92a..6bb7f432f 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -125,7 +125,7 @@ inline std::ostream &operator<<(std::ostream &out, const bwl::WiFiSec &sec)
         out << "WPA-WPA2-Personal";
         break;
     case bwl::WiFiSec::WPA2_WPA3_PSK:
-        out << "WPA3-Personal-Transition";
+        out << "WPA2-WPA3-Personal";
         break;
     case bwl::WiFiSec::WPA3_PSK:
         out << "WPA3-Personal";
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index c103adbb6..684a0b46e 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -689,7 +689,7 @@ bool ap_wlan_hal_whm::update_vap_credentials(
             std::string current_encryption_mode;
             m_ambiorix_cl.get_param(current_encryption_mode, wifi_vap_path + "Security.",
                                     "EncryptionMode");
-            if (current_encryption_mode != "Default") {
+            if (encryption_mode != "Default") {
                 // In Default pWHM handles automatically, leave it as is
                 new_obj.add_child("EncryptionMode", encryption_mode);
             }
diff --git a/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
index 8e7fb8d5e..ed1993895 100644
--- a/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
@@ -783,7 +783,7 @@ bool sta_wlan_hal_whm::set_profile_params(const Profile &profile)
 
     // Configure Profile.Security object
     params.set_type(AMXC_VAR_ID_HTABLE);
-    params.add_child("ModeEnabled", "WPA3-Personal-Transition");
+    params.add_child("ModeEnabled", "WPA2-WPA3-Personal");
     params.add_child("KeyPassPhrase", profile.pass);
     params.add_child("SAEPassphrase", profile.pass);
     params.add_child("MFPConfig", "Optional");
diff --git a/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp
index 1ed154d8f..1b668f564 100644
--- a/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/utils_wlan_hal_whm.cpp
@@ -42,7 +42,7 @@ const std::map<std::string, WiFiSec> security_type_map = {
     {"WPA-Personal", WiFiSec::WPA_PSK},
     {"WPA2-Personal", WiFiSec::WPA2_PSK},
     {"WPA-WPA2-Personal", WiFiSec::WPA_WPA2_PSK},
-    {"WPA3-Personal-Transition", WiFiSec::WPA2_WPA3_PSK},
+    {"WPA2-WPA3-Personal", WiFiSec::WPA2_WPA3_PSK},
     {"WPA3-Personal", WiFiSec::WPA3_PSK},
     {"WPA3-Personal-Compatibility", WiFiSec::WPA3_PCM},
 };
diff --git a/framework/platform/wbapi/wbapi_utils.cpp b/framework/platform/wbapi/wbapi_utils.cpp
index a89fdc61d..bea53d34a 100644
--- a/framework/platform/wbapi/wbapi_utils.cpp
+++ b/framework/platform/wbapi/wbapi_utils.cpp
@@ -86,7 +86,7 @@ const std::map<std::string, std::vector<WSC::eWscAuth>> wbapi_utils::security_mo
     {"WPA2-Personal", {WSC::eWscAuth::WSC_AUTH_WPA2PSK, WSC::eWscAuth::WSC_AUTH_WPA2}},
     {"WPA-WPA2-Personal",
      {WSC::eWscAuth(WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_WPAPSK)}},
-    {"WPA3-Personal-Transition",
+    {"WPA2-WPA3-Personal",
      {WSC::eWscAuth(WSC::WSC_AUTH_WPA2PSK | WSC::WSC_AUTH_SAE),
       WSC::eWscAuth(WSC::WSC_AUTH_WPA2PSK | WSC::WSC_AUTH_SAE_AKM24),
       WSC::eWscAuth(WSC::WSC_AUTH_WPA2PSK | WSC::WSC_AUTH_SAE | WSC::WSC_AUTH_SAE_AKM24)}},
@@ -157,9 +157,7 @@ wbapi_utils::security_rsn_mode_from_string(const std::string &security_mode)
 const std::map<std::string, std::vector<WSC::eWscEncr>> wbapi_utils::encryption_type_table = {
     {"AES", {WSC::eWscEncr::WSC_ENCR_AES}},
     {"TKIP", {WSC::eWscEncr::WSC_ENCR_TKIP}},
-    {"TKIP-AES",
-     {WSC::eWscEncr(uint16_t(WSC::eWscEncr::WSC_ENCR_AES) |
-                    uint16_t(WSC::eWscEncr::WSC_ENCR_TKIP))}},
+    {"TKIP-AES", {WSC::eWscEncr::WSC_ENCR_TKIP_AES}},
 };
 
 std::string wbapi_utils::encryption_type_to_string(const WSC::eWscEncr &encryption_type)
diff --git a/framework/tlvf/yaml/tlvf/WSC/eWscEncr.yaml b/framework/tlvf/yaml/tlvf/WSC/eWscEncr.yaml
index 906cedbcd..cd03c00d8 100644
--- a/framework/tlvf/yaml/tlvf/WSC/eWscEncr.yaml
+++ b/framework/tlvf/yaml/tlvf/WSC/eWscEncr.yaml
@@ -9,5 +9,6 @@ eWscEncr:
   WSC_ENCR_WEP: 0x0002
   WSC_ENCR_TKIP: 0x0004
   WSC_ENCR_AES: 0x0008
+  WSC_ENCR_TKIP_AES: 0x000C   # Bitwise OR: TKIP (0x0004) | AES (0x0008)
   WSC_ENCR_INVALID: 0xFFFF
-  
\ No newline at end of file
+ 
-- 
