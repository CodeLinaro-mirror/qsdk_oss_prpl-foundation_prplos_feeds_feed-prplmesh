From dc90b7841756b75a025a08003cc803ab5f2a8917 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Thu, 20 Aug 2026 10:13:36 +0530
Subject: [PATCH] Fixes for Certification

MAUT failed to send AP Autoconfiguration WSC M1 message after
receiving the auto-configuration renew message from the controller

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp      |   29 +++++++++++++++++---
 1 file changed, 24 insertions(+), 5 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 3ff63ee..31ee321 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2783,6 +2783,11 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
         return;
     }
 
+    // Tracks whether a fresh BSS configuration request was actually sent to the AP manager
+    // this cycle. Only that message's response can repopulate num_of_bss_available /
+    // enabled_bssids below, so the reset further down must be gated on it.
+    bool bss_configuration_sent = false;
+
     // Apply the M2's real BSS list regardless of radio->radio_disable: non-AT controllers never
     // send an explicit enable/disable signal, so a radio that started up disabled may still
     // receive a valid M2 with real VAP credentials. handle_bss_reconfiguration() diffs bss_infos
@@ -2922,6 +2927,7 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
             m_last_bss_infos[radio->front.iface_name] = bss_infos;
 
             send_ap_bss_configuration_message(radio->front.iface_name, bss_infos);
+            bss_configuration_sent = true;
         } else {
             LOG(INFO) << "Reconfiguration is not needed";
         }
@@ -2976,13 +2982,26 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
                          ap_mld_request.second.mld_mode);
     }
 
-    // Initialize for next state
+    // Initialize for next state.
+    // Only clear the tracking fields when a fresh BSS configuration request was actually
+    // sent to the AP manager this cycle. If nothing was sent (no reconfiguration needed,
+    // or suppressed by the certification-mode last-VAP guard in handle_bss_reconfiguration()),
+    // the existing values still accurately reflect reality, so
+    // configuration_complete_wait_action() can re-validate immediately instead of waiting
+    // forever for an AP-manager response that will never arrive.
     auto &radio_conf_params = m_radios_conf_params[radio->front.iface_name];
 
-    radio_conf_params.num_of_bss_available = 0;
-    radio_conf_params.enabled_bssids.clear();
-    radio_conf_params.sent_vaps_list_update     = false;
-    radio_conf_params.received_vaps_list_update = false;
+    if (bss_configuration_sent) {
+        LOG(DEBUG) << "resetting radio_conf_params for "
+                   << radio->front.iface_name << " (BSS configuration sent)";
+        radio_conf_params.num_of_bss_available = 0;
+        radio_conf_params.enabled_bssids.clear();
+        radio_conf_params.sent_vaps_list_update     = false;
+        radio_conf_params.received_vaps_list_update = false;
+    } else {
+        LOG(DEBUG) << "preserving radio_conf_params for "
+                   << radio->front.iface_name << " (no BSS configuration sent this cycle)";
+    }
 
     // has_real_bss was computed earlier (right after handle_bss_reconfiguration(), before
     // send_ap_bss_configuration_message()) so RADIO_DISABLE_REQUEST could be sent to ap_manager
-- 
2.34.1

