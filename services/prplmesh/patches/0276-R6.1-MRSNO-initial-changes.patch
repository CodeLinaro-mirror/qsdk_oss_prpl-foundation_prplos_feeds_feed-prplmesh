+                                   << " agent=" << agent->al_mac << " ruid=" << ruid
+                                   << " bssid=" << bssid << " ssid=" << bss_entry.second->ssid
+                                   << " band="
+                                   << beerocks::utils::convert_frequency_type_to_string(
+                                          freq_type)
