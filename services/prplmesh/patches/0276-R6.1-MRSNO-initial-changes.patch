diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index d058865..044b7e6 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -65,6 +65,21 @@ clients_unicast_measurements=0
 # send_btm_to_non_11v_sta = 1 -> Allow sending BTM requests to STAs even if they do not support 802.11v
 send_btm_to_non_11v_sta=1
 
+# rsn_overriding_supported: Advertise RSN_Overriding = 1 in the AP Capability TLV
+# (Wi-Fi EasyMesh v6.1 sections 17.2.6, 9.1 and 7.1).
+# When set to 1, the Agent tells the Controller that it understands the special
+# value 0x0200 in the Authentication Type attribute of the M2 WSC frame and that
+# it can apply the contents of the RSN Parameters Configuration TLV
+# (section 14 of WPA3) - i.e. the Agent supports the RSN Overriding mechanism.
+# When set to 0 (default) the Agent advertises RSN_Overriding = 0, the Controller
+# stays in the legacy PSK/SAE fallback path, and the RSN Parameters Configuration
+# TLV is not sent.
+# This option is device-wide (the bit lives in the AP Capability TLV which is one
+# per Agent per Capability Report), so the option lives in the [global] section.
+# 0 = do not advertise (default, legacy behaviour)
+# 1 = advertise (Agent implements RSN Overriding handling)
+rsn_overriding_supported=0
+
 # beacon_11k_default_measurement_mode = BEACON_MEASUREMENT_MODE_PASSIVE (0) -> Passive measurement mode
 # beacon_11k_default_measurement_mode = BEACON_MEASUREMENT_MODE_ACTIVE (1) -> Active measurement mode
 # beacon_11k_default_measurement_mode = BEACON_MEASUREMENT_MODE_TABLE (2) -> Beacon Table measurement mode (default for regular STAs)
diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index c8d7ec9..42f6e94 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -35,6 +35,7 @@
 #include <tlvf/wfa_map/tlvDppChirpValue.h>
 #include <tlvf/wfa_map/tlvProfile2ReasonCode.h>
 #include <tlvf/wfa_map/tlvProfile2StatusCode.h>
+#include <tlvf/wfa_map/tlvRsnDiagnosticReport.h>
 #include <tlvf/wfa_map/tlvQoSManagementDescriptor.h>
 #include <tlvf/wfa_map/tlvQoSManagementPolicy.h>
 #include <tlvf/wfa_map/tlvStaMacAddressType.h>
@@ -1257,6 +1258,30 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         }
         return;
     }
+    case beerocks_message::ACTION_APMANAGER_UPDATE_RSN_OVERRIDE_REQUEST: {
+        // Parallel to ACTION_APMANAGER_UPDATE_HIDDEN_SSID_REQUEST for RSN Overriding.
+        // Translates the raw RSN Security IEs blob into rsn_override_* hostapd keys and
+        // sends RELOAD_CONFIG (safe on MLO platforms — no vdev churn).
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_UPDATE_RSN_OVERRIDE_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_UPDATE_RSN_OVERRIDE_REQUEST failed";
+            return;
+        }
+        if (!ap_wlan_hal) {
+            LOG(WARNING) << "ap_wlan_hal not ready, skipping update_bss_rsn_override";
+            return;
+        }
+        const auto security_ies_len = request->security_ies_length();
+        std::vector<uint8_t> security_ies(request->security_ies(),
+                                          request->security_ies() + security_ies_len);
+        LOG(INFO) << "ACTION_APMANAGER_UPDATE_RSN_OVERRIDE_REQUEST: bssid=" << request->bssid()
+                  << " security_ies_len=" << security_ies_len;
+        if (!ap_wlan_hal->update_bss_rsn_override(request->bssid(), security_ies)) {
+            LOG(ERROR) << "update_bss_rsn_override failed for bssid=" << request->bssid();
+        }
+        return;
+    }
 #ifdef BEEROCKS_RDKB
     case beerocks_message::ACTION_APMANAGER_SET_AP_METRICS_POLICY_REQUEST: {
         auto request = beerocks_header->addClass<
@@ -2182,6 +2207,19 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             bss_info_conf.vap_type  = config_data.vap_type();
             bss_info_conf.vap_label = config_data.vap_label_str();
 
+            // Forward the raw RSN Security IEs (RSNE + RSNOE + RSNO2E + RSNXOE) from the
+            // RSN Parameters Configuration TLV (spec §17.2.107) into sBssInfoConf::security_ies
+            // so apply_rsn_from_security_ies() can program arbitrary Controller-supplied RSN
+            // parameters into hostapd. Zero-length when the TLV was absent for this BSS.
+            const uint16_t security_ies_len = config_data.security_ies_length();
+            const uint8_t *security_ies_ptr = config_data.security_ies();
+            if (security_ies_len > 0 && security_ies_ptr != nullptr) {
+                bss_info_conf.security_ies.assign(security_ies_ptr,
+                                                  security_ies_ptr + security_ies_len);
+                LOG(DEBUG) << "Received " << security_ies_len
+                           << " RSN Security IE byte(s) for BSS " << bss_info_conf.bssid;
+            }
+
             // Extract smd_mac from credentials
             auto smd_mac = config_data.smd_mac();
             // Match SMD policy by full smd_mac if valid
@@ -4098,6 +4136,7 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
             ap_wlan_hal->sta_bss_steer(btm_params);
         }
     } break;
+    case Event::STA_Connection_Fail:
     case Event::WPA_Event_EAP_Failure:
     case Event::WPA_Event_EAP_Failure2:
     case Event::WPA_Event_EAP_Timeout_Failure:
@@ -4110,6 +4149,35 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
     case Event::ACL_DENY: {
         LOG(DEBUG) << "STA Connection failure";
         auto sta_conn_fail = static_cast<bwl::sStaConnectionFail *>(data);
+
+        // Map event type to RSN error phase for the RSN Diagnostic Report TLV
+        // (EasyMesh R6.1 §17.2.106).
+        bwl::eRsnError rsn_error = bwl::eRsnError::NONE;
+        switch (event) {
+        case Event::WPA_Event_EAP_Timeout_Failure:
+        case Event::WPA_Event_EAP_Timeout_Failure2:
+        case Event::WPS_Event_Timeout:
+            rsn_error = bwl::eRsnError::TIMEOUT;
+            break;
+        case Event::WPA_Event_SAE_Unknown_Password_Identifier:
+        case Event::AP_Sta_Possible_Psk_Mismatch:
+            rsn_error = bwl::eRsnError::PSK_MISMATCH;
+            break;
+        case Event::WPA_Event_EAP_Failure:
+        case Event::WPA_Event_EAP_Failure2:
+        case Event::WPS_Event_Fail:
+        case Event::WPS_Event_Cancel:
+            rsn_error = bwl::eRsnError::AUTH_FAILURE;
+            break;
+        case Event::ACL_DENY:
+            rsn_error = bwl::eRsnError::ASSOC_FAILURE;
+            break;
+        default:
+            rsn_error = bwl::eRsnError::ASSOC_FAILURE;
+            break;
+        }
+        sta_conn_fail->rsn_error = rsn_error;
+
         // Create a Failed Connection Message
         auto cmdu_tx_header =
             cmdu_tx.create(0, ieee1905_1::eMessageType::FAILED_CONNECTION_MESSAGE);
@@ -4147,7 +4215,41 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
         }
         profile2_reason_code_tlv->reason_code() =
             static_cast<wfa_map::tlvProfile2ReasonCode::eReasonCode>(sta_conn_fail->reason);
-        // Send the mismatched message
+
+        // Per EasyMesh R6.1 §17.2.106: include an RSN Diagnostic Report TLV when the radio
+        // supports RSN Overriding.
+        if (ap_wlan_hal->get_radio_info().rsn_override_support &&
+            sta_conn_fail->rsn_error != bwl::eRsnError::NONE) {
+            auto rsn_diag_tlv = cmdu_tx.addClass<wfa_map::tlvRsnDiagnosticReport>();
+            if (!rsn_diag_tlv) {
+                LOG(ERROR) << "addClass wfa_map::tlvRsnDiagnosticReport failed!";
+                // Non-fatal: continue sending the message without the RSN Diagnostic TLV.
+            } else {
+                // Per EasyMesh R6.1 §17.2.106 Table 129: on-wire RSN Error = 0x01
+                // ("failure during (Re)Association/authentication"); all other values reserved.
+                constexpr uint8_t RSN_ERROR_ASSOC_OR_AUTH_FAILURE = 0x01;
+                rsn_diag_tlv->rsn_error() =
+                    (sta_conn_fail->rsn_error != bwl::eRsnError::NONE)
+                        ? RSN_ERROR_ASSOC_OR_AUTH_FAILURE
+                        : static_cast<uint8_t>(bwl::eRsnError::NONE);
+
+                // Copy the failing frame body if available.
+                if (!sta_conn_fail->frame_body.empty()) {
+                    if (!rsn_diag_tlv->set_frame_body(sta_conn_fail->frame_body.data(),
+                                                      sta_conn_fail->frame_body.size())) {
+                        LOG(WARNING) << "Failed to set frame_body in RSN Diagnostic Report TLV";
+                    }
+                }
+
+                LOG(DEBUG) << "Added RSN Diagnostic Report TLV: rsn_error=0x" << std::hex
+                           << int(sta_conn_fail->rsn_error) << std::dec
+                           << " frame_body_length=" << sta_conn_fail->frame_body.size()
+                           << " sta=" << sta_conn_fail->sta_mac
+                           << " bssid=" << sta_conn_fail->bssid;
+            }
+        }
+
+        // Send the Failed Connection message
         send_cmdu(cmdu_tx);
     } break;
     case Event::DPP_PRESENCE_ANNOUNCEMENT: {
