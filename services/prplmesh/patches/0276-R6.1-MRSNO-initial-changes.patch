+bool ap_wlan_hal_nl80211::update_bss_rsn_override(const sMacAddr &bssid,
+                                                  const std::vector<uint8_t> &security_ies)
+{
+    // Runtime, on-demand equivalent of update_bss_hidden_ssid() for RSN Overriding.
+    // Translates the raw RSN Security IEs blob into the six hostapd `rsn_override_*`
+    // keys (RSNOE + RSNO2E) and reloads the configuration for that BSS only.
+    //
+    // Mirrors update_bss_hidden_ssid():
+    //   1) find bss_iface via available_vaps (using AP-manager-visible name, not conf name),
+    //   2) load hostapd.conf for the radio,
+    //   3) locate the VAP by BSSID inside the conf,
+    //   4) call apply_rsn_override_only() to write / clear rsn_override_* keys,
+    //   5) store() if update_required(),
+    //   6) send RELOAD_CONFIG on the BSS iface so hostapd picks up the change.
+    //
+    // UCI persistence: the six rsn_override_* options are persisted per-BSS in the
+    // wireless UCI config via bpl_cfg_set_rsn_override() below, exactly mirroring how
+    // bpl_cfg_set_ssid_advertisement() persists the "hidden" option in
+    // update_bss_hidden_ssid().  This keeps the runtime RSN-override change (and the
+    // WPA3-PCM behaviour it encodes) alive across a hostapd.conf regeneration and a
+    // reboot, in addition to the AgentDB copy of sBssInfoConf::security_ies.
+
+    const std::string bssid_str = tlvf::mac_to_string(bssid);
+    LOG(INFO) << "update_bss_rsn_override: bssid=" << bssid_str
+              << " security_ies_len=" << security_ies.size();
+
+    // Look up the BSS in available_vaps by BSSID to get the actual connected iface name
+    // (e.g. wlan0.1_link0 on MLO platforms, which may differ from hostapd.conf's iface).
+    const auto vap_iter =
+        std::find_if(m_radio_info.available_vaps.begin(), m_radio_info.available_vaps.end(),
+                     [&bssid_str](const std::pair<int, bwl::VAPElement> &elem) {
+                         return elem.second.mac == bssid_str;
+                     });
+
+    if (vap_iter == m_radio_info.available_vaps.end()) {
+        LOG(ERROR) << "update_bss_rsn_override: BSSID=" << bssid_str
+                   << " not found in available_vaps";
+        return false;
+    }
+
+    const std::string &bss_iface = vap_iter->second.bss;
+    if (bss_iface.empty()) {
+        LOG(ERROR) << "update_bss_rsn_override: empty bss iface for BSSID=" << bssid_str;
+        return false;
+    }
+
+    LOG(DEBUG) << "update_bss_rsn_override: using bss_iface=" << bss_iface
+               << " for BSSID=" << bssid_str;
+
+    // Load hostapd config for this radio.
+    prplmesh::hostapd::Configuration conf = load_hostapd_config(m_radio_info.iface_name, "");
+    if (!conf) {
+        LOG(ERROR) << "update_bss_rsn_override: failed to load hostapd config for "
+                   << m_radio_info.iface_name;
+        return false;
+    }
+
+    // Find the VAP inside the conf by BSSID.
+    std::string vap_id = conf.get_vap_by_bssid(bssid_str);
+    if (vap_id.empty()) {
+        LOG(WARNING) << "update_bss_rsn_override: BSSID=" << bssid_str
+                     << " not found in hostapd.conf, skipping conf update";
+        // Still return true — if the BSS is not (yet) in this hostapd conf, the
+        // Controller-side change has been applied to AgentDB and will be pushed on
+        // the next M2/VAP credential update anyway. Returning false here would make
+        // the caller believe the change had failed.
+        return true;
+    }
+
+    // Translate the RSN Security IEs → rsn_override_* keys (or clear them).
+    // Capture the parsed values so they can be persisted to UCI below.
+    sRsnOverrideParsed parsed;
+    if (!apply_rsn_override_only(conf, vap_id, security_ies, &parsed)) {
+        LOG(ERROR) << "update_bss_rsn_override: apply_rsn_override_only failed for VAP=" << vap_id;
+        return false;
+    }
+
+    // Persist the six rsn_override_* options to the wireless UCI config so they
+    // survive a hostapd.conf regeneration and a reboot.  Empty strings clear the
+    // corresponding option (matching the hostapd.conf clear behaviour).  This is
+    // the RSN-override analogue of the bpl_cfg_set_ssid_advertisement() call in
+    // update_bss_hidden_ssid().
+    if (!beerocks::bpl::bpl_cfg_set_rsn_override(bss_iface, parsed.o1_key_mgmt,
+                                                 parsed.o1_pairwise, parsed.o1_mfp,
+                                                 parsed.o2_key_mgmt, parsed.o2_pairwise,
+                                                 parsed.o2_mfp)) {
+        LOG(WARNING) << "update_bss_rsn_override: bpl_cfg_set_rsn_override failed for "
+                     << bss_iface << " (hostapd.conf updated, UCI not persisted)";
+    } else {
+        LOG(DEBUG) << "update_bss_rsn_override: persisted rsn_override_* to UCI for " << bss_iface
+                   << " (o1_km='" << parsed.o1_key_mgmt << "' o2_km='" << parsed.o2_key_mgmt << "')";
+    }
+
+    // Persist to hostapd.conf on disk only when a value actually changed.
+    if (conf.update_required()) {
+        if (!conf.store(vap_id)) {
+            LOG(ERROR) << "update_bss_rsn_override: failed to save hostapd.conf for " << bss_iface;
+            return false;
+        }
+        LOG(DEBUG) << "update_bss_rsn_override: saved rsn_override_* keys to hostapd.conf for "
+                   << bss_iface;
+    } else {
+        LOG(DEBUG) << "update_bss_rsn_override: rsn_override_* keys already up-to-date for "
+                   << bss_iface << " (no write needed)";
+    }
+
+    // Reload only this BSS — RELOAD_CONFIG is safe on MLO platforms (no vdev churn).
+    const std::string cmd("RELOAD_CONFIG");
+    if (!wpa_ctrl_send_msg(cmd, bss_iface)) {
+        LOG(ERROR) << "update_bss_rsn_override: RELOAD_CONFIG failed for " << bss_iface;
+        return false;
+    }
+
+    LOG(INFO) << "update_bss_rsn_override: applied rsn_override_* keys and sent RELOAD_CONFIG to "
+              << bss_iface << " (security_ies_len=" << security_ies.size() << ")";
+    return true;
+}
