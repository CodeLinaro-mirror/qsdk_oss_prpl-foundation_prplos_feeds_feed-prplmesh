+/**
+ * @brief Derive the WPA3 Transition Mode fallback `auth_type` bitmask for an MRSNO BSS
+ *        being sent to an agent that does NOT support RSN Overriding (per EasyMesh R6.1).
+ *
+ * The AKM set is decoded from the BSS's SecurityIEs blob via
+ * decode_mrsno_akms_from_security_ies():
+ *
+ *   AKM set      2.4/5 GHz fallback            6 GHz fallback
+ *   -----------  ----------------------------- ----------------------------
+ *   AKM8 only    WPA2PSK|SAE       (0x0060)    SAE               (0x0100)
+ *   AKM24 only   WPA2PSK|SAE_AKM24 (0x0120)    SAE_AKM24         (0x0040)
+ *   AKM8+AKM24   WPA2PSK|SAE|SAE_AKM24(0x0160) SAE|SAE_AKM24     (0x0140)
+ *
+ * Returns WSC_AUTH_INVALID when the BSS is not MRSNO.
+ */
+static WSC::eWscAuth wpa3_pcm_downgrade_auth_type(const son::wireless_utils::sBssInfoConf &bss_info,
+                                                  beerocks::eFreqType band)
+{
+    // Only MRSNO / WPA3-Personal-Compatibility BSSes are downgraded.
+    const bool is_mrsno =
+        (bss_info.additional_auth ==
+         son::wireless_utils::eAdditionalAuth::WPA3_PERSONAL_COMPATIBILITY) ||
+        (bss_info.authentication_type == WSC::eWscAuth::WSC_AUTH_RSN) ||
+        !bss_info.security_ies.empty();
+    if (!is_mrsno) {
+        return WSC::eWscAuth::WSC_AUTH_INVALID;
+    }
+
+    bool has_akm8 = false, has_akm24 = false;
+    decode_mrsno_akms_from_security_ies(bss_info.security_ies, band, has_akm8, has_akm24);
+
+    if (!has_akm8 && !has_akm24) {
+        // No SecurityIEs blob (e.g. legacy WSC_AUTH_RSN marker without a staged blob) — the
+        // caller falls back to the historical single-AKM default.
+        return WSC::eWscAuth::WSC_AUTH_INVALID;
+    }
+
+    const bool is_6g = (band == beerocks::FREQ_6G);
+    uint16_t auth    = is_6g ? 0 : static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_WPA2PSK);
+    if (has_akm8) {
+        auth |= static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE);
+    }
+    if (has_akm24) {
+        auth |= static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
+    }
+    return static_cast<WSC::eWscAuth>(auth);
+}
