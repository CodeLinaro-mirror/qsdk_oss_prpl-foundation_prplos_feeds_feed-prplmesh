+                    // Resolve the target BSSID: prefer the explicit BSSID, fall back to the
+                    // Controller BSS_Index slot (1-based) into the radio's VAP list.
+                    sMacAddr target_bssid = rsn_bss.bssid();
+                    if (target_bssid == net::network_utils::ZERO_MAC &&
+                        rsn_bss.bss_index() != 0 &&
+                        static_cast<size_t>(rsn_bss.bss_index() - 1) <
+                            radio->front.bssids.size()) {
+                        target_bssid = radio->front.bssids[rsn_bss.bss_index() - 1].mac;
+                    }
+
+                    if (target_bssid == net::network_utils::ZERO_MAC ||
+                        target_bssid == net::network_utils::WILD_MAC) {
+                        LOG(DEBUG) << "APPLY (extended request): no concrete BSSID for RUID "
+                                   << ruid << " bss_index=" << int(rsn_bss.bss_index())
+                                   << "; skipping RSN apply";
+                        continue;
+                    }
+
+                    sRsnOverrideConfig apply_cfg;
+                    apply_cfg.radio_uid = ruid;
+                    apply_cfg.bssid     = target_bssid;
+                    const uint16_t ies_len = rsn_bss.security_ies_length();
+                    const uint8_t *ies_ptr = rsn_bss.security_ies();
+                    if (ies_ptr != nullptr && ies_len > 0) {
+                        apply_cfg.security_ies.assign(ies_ptr, ies_ptr + ies_len);
+                    }
+                    // else: empty security_ies == CLEAR request (handled downstream).
+
+                    LOG(DEBUG) << "APPLY (extended request): dispatching APPLY_RSN_OVERRIDE_CONFIG"
+                               << " ruid=" << ruid << " bssid=" << target_bssid
+                               << " security_ies_len=" << apply_cfg.security_ies.size()
+                               << (apply_cfg.security_ies.empty() ? " (CLEAR)" : "");
+                    handle_event(static_cast<uint8_t>(eEvent::APPLY_RSN_OVERRIDE_CONFIG),
+                                 &apply_cfg);
+                }
+            }
+        }
+    }
+
+    // 3) Reply with the BSS Configuration Extended Report (spec §7.1.3), reporting the
+    //    settings actually applied on the BSS(s).
+    if (!send_bss_configuration_extended_report_message()) {
+        LOG(ERROR) << "send_bss_configuration_extended_report_message has failed";
+    }
+}
