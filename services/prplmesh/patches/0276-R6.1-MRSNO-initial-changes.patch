+// ---------------------------------------------------------------------------
+// Dynamic RSN SecurityIEs blob builder (from UCI rsn_override_* values)
+//
+// Builds the exact RSNE + RSNOE(0x29) + RSNO2E(0x2A) + RSNXOE(0x2B) byte
+// sequence the Controller pushes down in the RSN Parameters Configuration TLV,
+// derived from the per-BSS UCI rsn_override_* options.  This makes the blob
+// honour the actual UCI values (e.g. rsn_override_mfp '1' vs '2') instead of a
+// canned array with a fixed MFP policy.
+//
+// select_rsn_security_ies() in the Controller prefers sBssInfoConf::security_ies
+// over the canned wpa3_pcm_* arrays, so populating configuration.security_ies
+// here is sufficient to have the dynamic blob used end-to-end.
+// ---------------------------------------------------------------------------
+namespace {
+
+// Map a hostapd key_mgmt token to its 00-0F-AC AKM suite selector byte.
+static bool rsn_km_to_akm(const std::string &km, uint8_t &akm)
+{
+    if (km == "SAE") {
+        akm = 0x08;
+    } else if (km == "SAE-EXT-KEY") {
+        akm = 0x18;
+    } else if (km == "WPA-PSK") {
+        akm = 0x02;
+    } else {
+        return false;
+    }
+    return true;
+}
+
+// Map a hostapd pairwise token to its 00-0F-AC cipher suite selector byte.
+static bool rsn_pairwise_to_cipher(const std::string &pw, uint8_t &cipher)
+{
+    if (pw == "CCMP") {
+        cipher = 0x04;
+    } else if (pw == "GCMP") {
+        cipher = 0x08;
+    } else if (pw == "GCMP-256") {
+        cipher = 0x09;
+    } else if (pw == "CCMP-256") {
+        cipher = 0x0A;
+    } else {
+        return false;
+    }
+    return true;
+}
+
+// Map a UCI rsn_override_mfp value ("0"/"1"/"2") to the RSN Capabilities low byte.
+// Bit 6 (0x40) = MFPR (required), Bit 7 (0x80) = MFPC (capable).
+static uint8_t rsn_mfp_to_caps_low_byte(const std::string &mfp)
+{
+    if (mfp == "2") {
+        return 0xC0; // MFPC + MFPR (required)
+    } else if (mfp == "1") {
+        return 0x80; // MFPC only (capable/optional)
+    }
+    return 0x00; // disabled
+}
+
+// Append one RSN Override vendor-specific element (RSNOE 0x29 / RSNO2E 0x2A)
+// carrying a single-AKM, single-pairwise RSN body with the given MFP caps.
+static void append_rsn_override_element(std::vector<uint8_t> &out, uint8_t oui_type,
+                                        uint8_t akm, uint8_t pairwise, uint8_t caps_low)
+{
+    // RSN body: Version(2) GroupData(4) PWCount(2) PW(4) AKMCount(2) AKM(4)
+    //           RSNCaps(2) PMKIDCount(2) GroupMgmt(4) = 26 bytes.
+    // Vendor element payload = WFA OUI(3) + OUI type(1) + RSN body(26) = 30 (0x1E).
+    out.push_back(0xDD);        // Element ID: Vendor-Specific
+    out.push_back(0x1E);        // Length = 30
+    out.push_back(0x50);        // WFA OUI
+    out.push_back(0x6F);
+    out.push_back(0x9A);
+    out.push_back(oui_type);    // 0x29 (RSNOE) or 0x2A (RSNO2E)
+    out.push_back(0x01);        // Version
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Data Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x04);
+    out.push_back(0x01);        // Pairwise Cipher Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // Pairwise Cipher Suite = 00-0F-AC-<pairwise>
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(pairwise);
+    out.push_back(0x01);        // AKM Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // AKM Suite = 00-0F-AC-<akm>
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(akm);
+    out.push_back(caps_low);    // RSN Capabilities (low byte carries MFPC/MFPR)
+    out.push_back(0x00);        // RSN Capabilities (high byte)
+    out.push_back(0x00);        // PMKID Count = 0
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Management Cipher Suite = 00-0F-AC-06 (BIP-CMAC-128)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x06);
+}
+
+/**
+ * @brief Build the RSN SecurityIEs blob for a BSS from its six UCI rsn_override_* values.
+ *
+ * Emits (in order): a primary RSNE (SAE / CCMP / MFP-required, the WPA3-PCM baseline),
+ * an RSNOE(0x29) when override-1 is configured, an RSNO2E(0x2A) when override-2 is
+ * configured, and a trailing RSNXOE(0x2B) with SAE-H2E capability.  The RSN Capabilities
+ * MFP bits of the override elements are taken verbatim from rsn_override_mfp /
+ * rsn_override_mfp_2 so the Agent applies exactly what UCI specifies.
+ *
+ * @return true if at least one override element was emitted (blob is meaningful).
+ */
+static bool build_rsn_security_ies_from_uci(const std::string &o1_km, const std::string &o1_pw,
+                                            const std::string &o1_mfp, const std::string &o2_km,
+                                            const std::string &o2_pw, const std::string &o2_mfp,
+                                            std::vector<uint8_t> &out)
+{
+    out.clear();
+
+    uint8_t o1_akm = 0, o1_cipher = 0, o2_akm = 0, o2_cipher = 0;
+    const bool have_ovr1 =
+        (!o1_km.empty()) && rsn_km_to_akm(o1_km, o1_akm) && rsn_pairwise_to_cipher(o1_pw, o1_cipher);
+    const bool have_ovr2 =
+        (!o2_km.empty()) && rsn_km_to_akm(o2_km, o2_akm) && rsn_pairwise_to_cipher(o2_pw, o2_cipher);
+
+    if (!have_ovr1 && !have_ovr2) {
+        return false;
+    }
+
+    // Primary RSNE: WPA3-PCM baseline (SAE / CCMP / MFP required), matching the canned blobs.
+    // AKM = SAE (0x08), pairwise = CCMP (0x04), RSN caps = MFPC+MFPR (0xC0).
+    out.push_back(0x30);        // Element ID: RSNE
+    out.push_back(0x1A);        // Length = 26
+    out.push_back(0x01);        // Version
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Data Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x04);
+    out.push_back(0x01);        // Pairwise Cipher Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // Pairwise Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x04);
+    out.push_back(0x01);        // AKM Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(0x00);        // AKM Suite = 00-0F-AC-08 (SAE)
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x08);
+    out.push_back(0xC0);        // RSN Capabilities low byte = MFPC+MFPR
+    out.push_back(0x00);        // RSN Capabilities high byte
+    out.push_back(0x00);        // PMKID Count = 0
+    out.push_back(0x00);
+    out.push_back(0x00);        // Group Management Cipher Suite = 00-0F-AC-06
+    out.push_back(0x0F);
+    out.push_back(0xAC);
+    out.push_back(0x06);
+
+    if (have_ovr1) {
+        append_rsn_override_element(out, 0x29 /* RSNOE */, o1_akm, o1_cipher,
+                                    rsn_mfp_to_caps_low_byte(o1_mfp));
+    }
+    if (have_ovr2) {
+        append_rsn_override_element(out, 0x2A /* RSNO2E */, o2_akm, o2_cipher,
+                                    rsn_mfp_to_caps_low_byte(o2_mfp));
+    }
+
+    // RSNXOE (0x2B): SAE-H2E capability (Extended RSN Capabilities byte 0x20).
+    out.push_back(0xDD);
+    out.push_back(0x05);        // Length = 5
+    out.push_back(0x50);
+    out.push_back(0x6F);
+    out.push_back(0x9A);
+    out.push_back(0x2B);        // OUI type: RSNXOE
+    out.push_back(0x20);        // Extended RSN Capabilities
+
+    return true;
+}
