             beerocks::string_utils::stoi(beerocks_slave_conf.send_btm_to_non_11v_sta);
         db->device_conf.send_btm_to_non_11v_sta = send_btm_to_non_11v_sta;
 
+        // rsn_overriding_supported: advertise RSN_Overriding=1 in the AP Capability TLV
+        // (Wi-Fi EasyMesh v6.1 §17.2.6/§9.1/§7.1). Optional; default 0 (do not advertise).
+        // Absent / empty / "0" -> false; "1" -> true. Any other value is treated as false
+        // and produces a warning.
+        if (beerocks_slave_conf.rsn_overriding_supported.empty()) {
+            db->device_conf.rsn_overriding_supported = false;
+        } else if (beerocks_slave_conf.rsn_overriding_supported == "1") {
+            db->device_conf.rsn_overriding_supported = true;
+        } else if (beerocks_slave_conf.rsn_overriding_supported == "0") {
+            db->device_conf.rsn_overriding_supported = false;
+        } else {
+            LOG(WARNING) << "Invalid rsn_overriding_supported value '"
+                         << beerocks_slave_conf.rsn_overriding_supported
+                         << "'. Expected 0 or 1. Treating as 0 (do not advertise).";
+            db->device_conf.rsn_overriding_supported = false;
+        }
+        LOG(DEBUG) << "Set rsn_overriding_supported to: "
+                   << db->device_conf.rsn_overriding_supported;
+
         // Read and validate beacon_11k_default_measurement_mode configuration
         auto beacon_11k_mode = beerocks::string_utils::stoi(beerocks_slave_conf.beacon_11k_default_measurement_mode);
         
