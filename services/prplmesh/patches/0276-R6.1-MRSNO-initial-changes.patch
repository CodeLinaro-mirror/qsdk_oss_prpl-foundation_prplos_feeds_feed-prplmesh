+bool bpl_cfg_get_wifi_credentials_by_ssid_and_band(
+    const std::string &ssid, beerocks::eFreqType freq_band,
+    son::wireless_utils::sBssInfoConf &configuration)
+{
+    // Same as bpl_cfg_get_wifi_credentials_by_ssid() but ALSO filters by the
+    // associated wifi-device's `band` option. This is required on Multi-AP
+    // deployments where the same SSID exists on 2.4/5/6 GHz radios and each band
+    // may carry different `rsn_override_*` / `additional_auth` settings. A plain
+    // SSID lookup would return the FIRST match (typically the 2.4 GHz section)
+    // and incorrectly propagate its additional_auth to a different-band VAP —
+    // e.g. writing rsn_override_key_mgmt_2=SAE-EXT-KEY into a 6 GHz hostapd.conf
+    // whose UCI section only has `encryption 'sae-ext-key'` and no overrides.
+    const std::string package_name = "wireless";
+    const std::string section_type = "wifi-iface";
+
+    std::vector<std::string> sections;
+    if (!uci_get_all_sections(package_name, section_type, sections)) {
+        LOG(WARNING) << "bpl_cfg_get_wifi_credentials_by_ssid_and_band: "
+                     << "failed to get wifi-iface section names";
+        return false;
+    }
+
+    // Map the requested freq_band to the set of UCI wifi-device `band` values
+    // that match. FREQ_5GL and FREQ_5GH are both stored as `band '5g'` in UCI.
+    auto band_matches = [freq_band](const std::string &uci_band) {
+        if (uci_band == "2g") {
+            return freq_band == beerocks::eFreqType::FREQ_24G;
+        } else if (uci_band == "5g") {
+            return freq_band == beerocks::eFreqType::FREQ_5G ||
+                   freq_band == beerocks::eFreqType::FREQ_5GL ||
+                   freq_band == beerocks::eFreqType::FREQ_5GH;
+        } else if (uci_band == "6g") {
+            return freq_band == beerocks::eFreqType::FREQ_6G;
+        }
+        return false;
+    };
+
+    for (const auto &section_name : sections) {
+        // Filter by SSID first.
+        std::string section_ssid;
+        if (!uci_get_option(package_name, section_type, section_name, "ssid", section_ssid) ||
+            section_ssid != ssid) {
+            continue;
+        }
+
+        // Resolve the wifi-device this section belongs to, then read its `band`.
+        std::string device_section;
+        if (!uci_get_option(package_name, section_type, section_name, "device", device_section) ||
+            device_section.empty()) {
+            continue;
+        }
+        std::string uci_band;
+        if (!uci_get_option(package_name, "wifi-device", device_section, "band", uci_band) ||
+            uci_band.empty()) {
+            continue;
+        }
+        if (!band_matches(uci_band)) {
+            continue;
+        }
+
+        // Section matches both SSID and band — read its full BSS configuration.
+        if (!bpl_cfg_get_bss_configuration(section_name, configuration)) {
+            LOG(ERROR) << "bpl_cfg_get_wifi_credentials_by_ssid_and_band: "
+                       << "failed to parse section " << section_name
+                       << " (ssid=" << ssid << " band=" << uci_band << ")";
+            return false;
+        }
+        MAPF_DBG("bpl_cfg_get_wifi_credentials_by_ssid_and_band: found ssid='"
+                 << ssid << "' band='" << uci_band << "' in section "
+                 << section_name << " -> additional_auth="
+                 << int(configuration.additional_auth));
+        return true;
+    }
+
+    // No exact (SSID, band) section found. Do NOT fall back to a same-SSID section on a
+    // different band: per-band additional_auth is band-specific and cross-band borrowing
+    // would apply the wrong AKM set. The authoritative per-band RSN configuration for a
+    // dynamically created child VAP is the one carried in the M2.
+    LOG(DEBUG) << "bpl_cfg_get_wifi_credentials_by_ssid_and_band: no wifi-iface section for ssid='"
+               << ssid << "' freq_band=" << int(freq_band)
+               << " (not falling back across bands; per-band M2 value is authoritative)";
+    return false;
+}
