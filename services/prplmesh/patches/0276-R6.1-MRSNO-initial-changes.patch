+                auto rsn_radio = std::get<1>(rsn_params_cfg->radios(radio_idx));
+                const sMacAddr ruid = rsn_radio.ruid();
+
+                auto radio = db_apply->get_radio_by_mac(ruid, AgentDB::eMacType::RADIO);
+                if (!radio) {
+                    LOG(WARNING) << "APPLY (extended request): unknown RUID " << ruid
+                                 << ", skipping RSN apply";
+                    continue;
+                }
+
+                for (auto bss_idx = 0; bss_idx < rsn_radio.num_bss(); ++bss_idx) {
+                    auto rsn_bss = std::get<1>(rsn_radio.bsss(bss_idx));
