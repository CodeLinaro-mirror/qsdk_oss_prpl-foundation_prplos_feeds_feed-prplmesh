+bool bpl_cfg_set_rsn_override(const std::string &iface_name, const std::string &o1_key_mgmt,
+                              const std::string &o1_pairwise, const std::string &o1_mfp,
+                              const std::string &o2_key_mgmt, const std::string &o2_pairwise,
+                              const std::string &o2_mfp)
+{
+    const std::string pkg = "wireless";
+    bool any_updated      = false;
+
+    // Strip the "_link<N>" suffix appended by the NL80211 HAL (e.g. "wlan3_link0" → "wlan3").
+    // In MLO, all wifi-iface sections for an MLD share the same "ifname=<base>" and differ
+    // only by their "device" option. link_num N selects the N-th wifi-iface section (in UCI
+    // declaration order) that references the MLD, so only the correct section is updated.
+    std::string iface_base = iface_name;
+    int link_num           = -1; // -1 = no "_link<N>" suffix (non-MLO path)
+    {
+        auto pos = iface_name.rfind("_link");
+        if (pos != std::string::npos && pos + 5 < iface_name.size()) {
+            bool all_digits = true;
+            for (size_t i = pos + 5; i < iface_name.size(); ++i) {
+                if (!isdigit(static_cast<unsigned char>(iface_name[i]))) {
+                    all_digits = false;
+                    break;
+                }
+            }
+            if (all_digits) {
+                iface_base = iface_name.substr(0, pos);
+                link_num   = beerocks::string_utils::stoi(iface_name.substr(pos + 5));
+                LOG(DEBUG) << "bpl_cfg_set_rsn_override: using base iface=" << iface_base
+                           << " link_num=" << link_num
+                           << " (stripped _link suffix from " << iface_name << ")";
+            }
+        }
+    }
+
+    // Empty strings remove the option (uci_set_section semantics), which is exactly
+    // what the normal / non-MRSNO flow wants (all six overrides cleared).
+    OptionsUnorderedMap options;
+    options["rsn_override_key_mgmt"]   = o1_key_mgmt;
+    options["rsn_override_pairwise"]   = o1_pairwise;
+    options["rsn_override_mfp"]        = o1_mfp;
+    options["rsn_override_key_mgmt_2"] = o2_key_mgmt;
+    options["rsn_override_pairwise_2"] = o2_pairwise;
+    options["rsn_override_mfp_2"]      = o2_mfp;
+
+    // Update the correct wifi-iface section(s).  Two modes:
+    //
+    //   MLO (link_num >= 0)    -> ifname match + pick the link_num-th wifi-iface
+    //                             section whose "mld" option references the same
+    //                             wifi-mld section as iface_base.  Exactly ONE
+    //                             section is updated; sibling-band sections that
+    //                             share the same ifname are left untouched.
+    //
+    //   non-MLO (link_num < 0) -> legacy behaviour: update every wifi-iface section
+    //                             whose ifname matches iface_name.
+    //
+    // NOTE: Only wifi-iface sections are updated here.  The wifi-mld section is
+    // intentionally NOT touched: the six rsn_override_* options are per-link
+    // (per-wifi-iface) hostapd settings, and the user configures them only in the
+    // wifi-iface sections.
+    {
+        const std::string type = "wifi-iface";
+        std::vector<std::string> all_sections;
+        if (!uci_get_all_sections(pkg, type, all_sections)) {
+            LOG(ERROR) << "bpl_cfg_set_rsn_override: failed to enumerate wifi-iface sections";
+            return false;
+        }
+
+        // Resolve the wifi-mld section for this iface (ifname == iface_base).
+        // Only touch wifi-iface sections whose "mld" option names THAT section,
+        // so sibling MLDs sharing the same ifname are left untouched.
+        std::string mld_section_for_iface; // e.g. "mld3"
+        if (link_num >= 0) {
+            const std::string mld_type = "wifi-mld";
+            std::vector<std::string> all_mld_sections;
+            if (uci_get_all_sections(pkg, mld_type, all_mld_sections)) {
+                for (const auto &mld_sec : all_mld_sections) {
+                    std::string mld_ifname;
+                    if (!uci_get_option(pkg, mld_type, mld_sec, "ifname", mld_ifname)) {
+                        continue;
+                    }
+                    if (mld_ifname == iface_base) {
+                        mld_section_for_iface = mld_sec;
+                        break;
+                    }
+                }
+            }
+            if (mld_section_for_iface.empty()) {
+                LOG(WARNING) << "bpl_cfg_set_rsn_override: no wifi-mld section for ifname='"
+                             << iface_base << "'; falling back to legacy ifname-only mode";
+                link_num = -1;
+            } else {
+                LOG(DEBUG) << "bpl_cfg_set_rsn_override: iface_base=" << iface_base
+                           << " -> wifi-mld section=" << mld_section_for_iface
+                           << " link_num=" << link_num;
+            }
+        }
+
+        int mld_iface_index = 0;
+        for (const auto &sec : all_sections) {
+            std::string ifname_val;
+            if (!uci_get_option(pkg, type, sec, "ifname", ifname_val)) {
+                continue;
+            }
+            if (ifname_val != iface_name && ifname_val != iface_base) {
+                continue;
+            }
+
+        // MLO: pick the link_num-th wifi-iface section whose "mld" references mld_section_for_iface.
+        if (link_num >= 0 && !mld_section_for_iface.empty()) {
+                std::string mld_val;
+                if (!uci_get_option(pkg, type, sec, "mld", mld_val) ||
+                    mld_val != mld_section_for_iface) {
+                    LOG(DEBUG) << "bpl_cfg_set_rsn_override: skipping section=" << sec
+                               << " ifname=" << ifname_val
+                               << " (mld option does not reference '"
+                               << mld_section_for_iface << "')";
+                    continue;
+                }
+                if (mld_iface_index != link_num) {
+                    mld_iface_index++;
+                    continue;
+                }
+                mld_iface_index++;
+            }
+            // Non-MLO: update all matching-ifname sections.
+
+            if (!uci_set_section(pkg, type, sec, options, false)) {
+                LOG(ERROR) << "bpl_cfg_set_rsn_override: failed for section=" << sec;
+            } else {
+                std::string cur_device;
+                uci_get_option(pkg, type, sec, "device", cur_device);
+                LOG(DEBUG) << "bpl_cfg_set_rsn_override: set rsn_override_* section=" << sec
+                           << " iface=" << iface_name
+                           << " device=" << cur_device
+                           << " link_num=" << link_num
+                           << " (o1_km='" << o1_key_mgmt << "' o2_km='" << o2_key_mgmt << "')";
+                any_updated = true;
+
+                // MLO: stop after the first match to avoid leaking into sibling-band sections.
+                if (link_num >= 0) {
+                    break;
+                }
+            }
+        }
+    }
+
+    if (any_updated) {
+        uci_commit_changes(pkg);
+    } else {
+        LOG(DEBUG) << "bpl_cfg_set_rsn_override: no section found for iface=" << iface_name
+                   << " link_num=" << link_num;
+    }
+
+    return any_updated;
+}
