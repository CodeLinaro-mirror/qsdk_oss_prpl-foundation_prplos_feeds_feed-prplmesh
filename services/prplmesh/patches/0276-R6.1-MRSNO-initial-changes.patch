+    LOG(INFO) << "apply_rsn_override_only: VAP=" << vap_id
+              << " ovr1=" << have_ovr1
+              << " [key_mgmt='" << o1_key_mgmt
+              << "' pairwise='" << o1_pairwise
+              << "' mfp=" << o1_mfp << "]"
+              << " ovr2=" << have_ovr2
+              << " [key_mgmt='" << o2_key_mgmt
+              << "' pairwise='" << o2_pairwise
+              << "' mfp=" << o2_mfp << "]";
+    return true;
