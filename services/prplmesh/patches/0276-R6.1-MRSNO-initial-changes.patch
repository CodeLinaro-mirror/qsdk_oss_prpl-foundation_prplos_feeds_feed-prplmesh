+int bml_internal::update_rsn()
+{
+    beerocks::promise<bool> prmUpdateRsn;
+    int iOpTimeout = 60000; // Default timeout
+
+    if (!m_sockPlatform && !connect_to_platform()) {
+        return (-BML_RET_CONNECT_FAIL);
+    }
+
+    // Command supported only on local master
+    if (!is_local_master()) {
+        LOG(ERROR) << "Command supported only on local master!";
+        return (-BML_RET_OP_NOT_SUPPORTED);
+    }
+
+    // Initialize the promise for receiving the response
+    m_prmUpdateRsn = &prmUpdateRsn;
+
+    // If the socket is not valid, attempt to re-establish the connection
+    if (!m_sockMaster) {
+        int iRet = connect_to_master();
+        if (iRet != BML_RET_OK) {
+            m_prmUpdateRsn = nullptr;
+            return iRet;
+        }
+    }
+
+    auto update_request =
+        message_com::create_vs_message<beerocks_message::cACTION_BML_UPDATE_RSN_REQUEST>(
+            cmdu_tx);
+
+    if (!update_request) {
+        LOG(ERROR) << "Failed building cACTION_BML_UPDATE_RSN_REQUEST message!";
+        m_prmUpdateRsn = nullptr;
+        return (-BML_RET_OP_FAILED);
+    }
+
+    LOG(TRACE) << "Sending bml_update_rsn request to master.";
+
+    if (!message_com::send_cmdu(m_sockMaster, cmdu_tx)) {
+        LOG(ERROR) << "Failed sending bml_update_rsn message!";
+        m_prmUpdateRsn = nullptr;
+        return (-BML_RET_OP_FAILED);
+    }
+
+    if (!prmUpdateRsn.wait_for(iOpTimeout)) {
+        LOG(WARNING) << "Timeout while waiting for bml_update_rsn response...";
+        m_prmUpdateRsn = nullptr;
+        return (-BML_RET_TIMEOUT);
+    }
+
+    m_prmUpdateRsn = nullptr;
+
+    return BML_RET_OK;
+}
