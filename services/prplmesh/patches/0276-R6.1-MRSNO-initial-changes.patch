+static void decode_mrsno_akms_from_security_ies(const std::vector<uint8_t> &ies,
+                                                beerocks::eFreqType band, bool &has_akm8,
+                                                bool &has_akm24)
+{
+    has_akm8         = false;
+    has_akm24        = false;
+    const bool is_6g = (band == beerocks::FREQ_6G);
+    const size_t n   = ies.size();
+
+    // Scan a slice of the RSN body for a 00-0F-AC:<akm_type> AKM suite selector.
+    auto body_has_akm = [](const uint8_t *b, size_t body_len, uint8_t akm_type) -> bool {
+        for (size_t k = 0; k + 4 <= body_len; ++k) {
+            if (b[k] == 0x00 && b[k + 1] == 0x0F && b[k + 2] == 0xAC && b[k + 3] == akm_type) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    // Walk the IE list (eid, len, body...).
+    size_t i = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + static_cast<size_t>(len) > n) {
+            break; // malformed / truncated
+        }
+        const uint8_t *body = &ies[i + 2];
+
+        if (eid == 48 /* RSNE (primary) */) {
+            // Only 6 GHz carries the real AKM(s) in the primary RSNE; on 2.4/5 GHz the primary
+            // RSNE is a PSK baseline and the SAE-family AKMs live in the override elements.
+            if (is_6g) {
+                if (body_has_akm(body, len, 0x08)) {
+                    has_akm8 = true; // SAE
+                }
+                if (body_has_akm(body, len, 0x18)) {
+                    has_akm24 = true; // SAE-EXT-KEY
+                }
+            }
+        } else if (eid == 221 /* Vendor-Specific */ && len >= 4 && body[0] == 0x50 &&
+                   body[1] == 0x6F && body[2] == 0x9A) {
+            const uint8_t oui_type = body[3];
+            const uint8_t *ovr     = body + 4;
+            const size_t ovr_len   = static_cast<size_t>(len) - 4;
+            if (oui_type == 0x29 /* RSNOE */ && body_has_akm(ovr, ovr_len, 0x08)) {
+                has_akm8 = true; // SAE override
+            } else if (oui_type == 0x2A /* RSNO2E */ && body_has_akm(ovr, ovr_len, 0x18)) {
+                has_akm24 = true; // SAE-EXT-KEY override
+            }
+        }
+        i += 2 + static_cast<size_t>(len);
+    }
+}
