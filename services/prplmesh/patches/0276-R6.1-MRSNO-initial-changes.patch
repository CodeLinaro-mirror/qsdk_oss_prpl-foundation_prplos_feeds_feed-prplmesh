                 eVapType vap_type                        = eVapType::OTHER;
                 std::string vap_label;
+                /// RSN Security IEs (RSNE/RSNOE/RSNO2E/RSNXOE) received via RSN Parameters
+                /// Configuration TLV in BSS_CONFIGURATION_EXTENDED_REQUEST or AP-Autoconfiguration
