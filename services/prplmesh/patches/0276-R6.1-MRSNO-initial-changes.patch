+// ---------------------------------------------------------------------------
+// SecurityIEs -> six rsn_override_* UCI strings decoder (Agent-side persist).
+//
+// On the Agent, an MRSNO BSS arrives from the Controller's M2 with a raw
+// SecurityIEs blob (RSNE + RSNOE(0x29) + RSNO2E(0x2A) [+ RSNXOE]).  The nl80211
+// HAL writes hostapd.conf directly from that blob (apply_rsn_from_security_ies),
+// but the persistent UCI copy must ALSO carry the six rsn_override_* options so
+// they survive a hostapd.conf regeneration and a reboot.
+//
+// The legacy write path in bpl_cfg_set_wifi_credentials() keyed the six
+// rsn_override_* options off the AIRTIES_WPA3_COMPATIBILITY_* additional_auth
+// enums.  The new design collapses all MRSNO modes into a single
+// WPA3_PERSONAL_COMPATIBILITY value and carries the actual AKM/cipher/MFP set in
+// security_ies, so those legacy branches no longer fire and UCI ends up with no
+// rsn_override_* options (the observed "hostapd.conf OK, UCI empty" symptom).
+//
+// This helper decodes the RSN Override vendor elements out of the blob into the
+// six UCI strings so the write path can persist them verbatim.  It is the UCI
+// analogue of apply_rsn_override_only() in the nl80211 HAL.
+// ---------------------------------------------------------------------------
+
+// Map a 4-byte 00-0F-AC AKM suite selector to a hostapd/UCI key_mgmt token.
+static std::string rsn_override_akm_to_token(const uint8_t *sel)
+{
+    if (sel[0] != 0x00 || sel[1] != 0x0F || sel[2] != 0xAC) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 2:  return "WPA-PSK";
+    case 8:  return "SAE";
+    case 24: return "SAE-EXT-KEY";
+    default: return {};
+    }
+}
+
+// Map a 4-byte 00-0F-AC pairwise cipher selector to a hostapd/UCI token.
+static std::string rsn_override_cipher_to_token(const uint8_t *sel)
+{
+    if (sel[0] != 0x00 || sel[1] != 0x0F || sel[2] != 0xAC) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 4:  return "CCMP";
+    case 8:  return "GCMP";
+    case 9:  return "GCMP-256";
+    case 10: return "CCMP-256";
+    default: return {};
+    }
+}
+
+// Parse an RSN body (Version .. RSN Capabilities) and extract the first AKM
+// token, first pairwise token, and MFP ("0"/"1"/"2").  SAE-family overrides
+// mandate MFP; when the body omits the RSN Capabilities field (mfp decodes to
+// "0") we default to "2" so the persisted UCI matches the rendered hostapd.conf.
+static bool rsn_override_parse_body(const uint8_t *b, size_t len, std::string &key_mgmt,
+                                    std::string &pairwise, std::string &mfp)
+{
+    key_mgmt.clear();
+    pairwise.clear();
+    mfp = "0";
+    if (len < 8) {
+        return false; // Version(2)+GroupData(4)+PWCount(2)
+    }
+    size_t p = 2; // skip Version
+    p += 4;       // skip Group Data Cipher
+
+    const uint16_t pw_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+    p += 2;
+    if (p + size_t(pw_count) * 4 > len) {
+        return false;
+    }
+    if (pw_count > 0) {
+        pairwise = rsn_override_cipher_to_token(&b[p]);
+    }
+    p += size_t(pw_count) * 4;
+
+    if (p + 2 > len) {
+        return true; // no AKM list
+    }
+    const uint16_t akm_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+    p += 2;
+    if (p + size_t(akm_count) * 4 > len) {
+        return false;
+    }
+    bool is_sae_family = false;
+    if (akm_count > 0) {
+        key_mgmt = rsn_override_akm_to_token(&b[p]);
+        if (key_mgmt == "SAE" || key_mgmt == "SAE-EXT-KEY") {
+            is_sae_family = true;
+        }
+    }
+    p += size_t(akm_count) * 4;
+
+    // RSN Capabilities (optional) -> MFP
+    if (p + 2 <= len) {
+        const uint16_t caps = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+        const bool mfpc = (caps & (1u << 7)) != 0;
+        const bool mfpr = (caps & (1u << 6)) != 0;
+        mfp = mfpr ? "2" : (mfpc ? "1" : "0");
+    }
+    if (mfp == "0" && is_sae_family) {
+        mfp = "2"; // WPA3 mandates MFP; match the rendered hostapd.conf
+    }
+    return true;
+}
+
+// Decode the six rsn_override_* UCI strings from a raw SecurityIEs blob.
+// Slots not advertised in the blob are returned as empty strings (which the UCI
+// writer treats as "remove this option").  Returns true if at least one RSN
+// Override element (RSNOE/RSNO2E) was decoded.
+static bool decode_rsn_override_uci_from_security_ies(
+    const std::vector<uint8_t> &ies, std::string &o1_km, std::string &o1_pw, std::string &o1_mfp,
+    std::string &o2_km, std::string &o2_pw, std::string &o2_mfp)
+{
+    o1_km.clear();
+    o1_pw.clear();
+    o1_mfp.clear();
+    o2_km.clear();
+    o2_pw.clear();
+    o2_mfp.clear();
+
+    const size_t n = ies.size();
+    bool have_ovr1 = false, have_ovr2 = false;
+    size_t i       = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + size_t(len) > n) {
+            break;
+        }
+        const uint8_t *body = &ies[i + 2];
+        if (eid == 221 /* Vendor-Specific */ && len >= 4 && body[0] == 0x50 && body[1] == 0x6F &&
+            body[2] == 0x9A) {
+            const uint8_t oui_type = body[3];
+            const uint8_t *ovr     = body + 4;
+            const size_t ovr_len   = size_t(len) - 4;
+            if (oui_type == 0x29 /* RSNOE */) {
+                if (rsn_override_parse_body(ovr, ovr_len, o1_km, o1_pw, o1_mfp)) {
+                    have_ovr1 = true;
+                }
+            } else if (oui_type == 0x2A /* RSNO2E */) {
+                if (rsn_override_parse_body(ovr, ovr_len, o2_km, o2_pw, o2_mfp)) {
+                    have_ovr2 = true;
+                }
+            }
+            // RSNXOE (0x2B) has no UCI rsn_override_* mapping; ignored.
+        }
+        i += 2 + size_t(len);
+    }
+
+    if (!have_ovr1) {
+        o1_km.clear();
+        o1_pw.clear();
+        o1_mfp.clear();
+    }
+    if (!have_ovr2) {
+        o2_km.clear();
+        o2_pw.clear();
+        o2_mfp.clear();
+    }
+    return have_ovr1 || have_ovr2;
+}
