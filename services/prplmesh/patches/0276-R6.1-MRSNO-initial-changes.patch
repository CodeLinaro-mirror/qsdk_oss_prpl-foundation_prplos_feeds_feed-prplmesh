+bool ApAutoConfigurationTask::store_rsn_parameters_configuration_tlv(
+    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto rsn_parameters_configuration = cmdu_rx.getClass<wfa_map::tlvRsnParametersConfiguration>();
+    if (!rsn_parameters_configuration) {
+        LOG(DEBUG) << "No tlvRsnParametersConfiguration TLV to store";
+        return true;
+    }
+
+    auto db = AgentDB::get();
+
+    for (auto radio_idx = 0; radio_idx < rsn_parameters_configuration->num_radio(); ++radio_idx) {
+        auto rsn_radio = std::get<1>(rsn_parameters_configuration->radios(radio_idx));
+
+        auto radio = db->get_radio_by_mac(rsn_radio.ruid(), AgentDB::eMacType::RADIO);
+        if (!radio) {
+            LOG(WARNING) << "RSN Parameters Configuration TLV for unknown RUID " << rsn_radio.ruid()
+                         << ", skipping";
+            continue;
+        }
+
+        for (auto bss_idx = 0; bss_idx < rsn_radio.num_bss(); ++bss_idx) {
+            auto rsn_bss = std::get<1>(rsn_radio.bsss(bss_idx));
+
+            const uint16_t ies_len = rsn_bss.security_ies_length();
+            const uint8_t *ies_ptr = rsn_bss.security_ies();
+
+            // Always stash the IEs by (radio_iface, BSS_Index) so they can be resolved to a real
+            // BSSID once the VAP is created. This is the RSN analogue of m_bss_index_hidden_ssid
+            // and is what guarantees the BSS Configuration Extended Report can echo the applied
+            // RSN parameters back to the Controller (spec 7.1.3 / 17.1.46) even when the RSN
+            // Parameters Configuration TLV arrived (in the WSC M2) before the BSSID was assigned.
+            // BSS_Index 0 means "no index" per the WSC vendor extension, so it is not usable as a
+            // stable key.
+            if (rsn_bss.bss_index() != 0) {
+                m_bss_index_security_ies[radio->front.iface_name][rsn_bss.bss_index()].assign(
+                    ies_ptr, ies_ptr + ies_len);
+                LOG(DEBUG) << "Stashed " << ies_len << " RSN Security IE byte(s) by bss_index="
+                           << int(rsn_bss.bss_index()) << " on radio " << radio->front.iface_name
+                           << " (applied to sBssid::security_ies once the VAP BSSID is known)";
+            }
+
+            // Locate the target local BSS: prefer matching by BSSID, fall back to BSS_Index slot.
+            // Per the WSC vendor extension the Controller-assigned BSS_Index is 1-based (0 means
+            // "no index"), while radio->front.bssids is 0-based. Convert (bss_index - 1) to index
+            // the slot so the direct-store fallback does not land on the wrong VAP.
+            beerocks::AgentDB::sRadio::sFront::sBssid *target_bss = nullptr;
+            if (rsn_bss.bssid() != net::network_utils::ZERO_MAC) {
+                for (auto &bss : radio->front.bssids) {
+                    if (bss.mac == rsn_bss.bssid()) {
+                        target_bss = &bss;
+                        break;
+                    }
+                }
+            } else if (rsn_bss.bss_index() != 0 &&
+                       static_cast<size_t>(rsn_bss.bss_index() - 1) < radio->front.bssids.size()) {
+                target_bss = &radio->front.bssids[rsn_bss.bss_index() - 1];
+            }
+
+            if (!target_bss) {
+                LOG(WARNING) << "RSN Parameters Configuration TLV: no matching BSS (bssid="
+                             << rsn_bss.bssid() << " bss_index=" << int(rsn_bss.bss_index())
+                             << ") on radio " << radio->front.iface_name;
+                continue;
+            }
+
+            // If the VAP's BSSID is not yet assigned (ZERO_MAC), do NOT store against this slot —
+            // the report builder only reports BSSes with a real BSSID, and storing here would
+            // otherwise leave the IEs on a ZERO_MAC slot. The IEs are preserved in
+            // m_bss_index_security_ies above and are copied into sBssid::security_ies by
+            // handle_vs_ap_enabled_notification() once the VAP is created. (They are also applied
+            // to hostapd via the credentials-update path in handle_rsn_parameters_configuration_tlv
+            // -> send_ap_bss_configuration_message.)
+            if (target_bss->mac == net::network_utils::ZERO_MAC) {
+                LOG(DEBUG) << "RSN Parameters Configuration TLV: target BSS (bss_index="
+                           << int(rsn_bss.bss_index()) << ") on radio " << radio->front.iface_name
+                           << " has no BSSID assigned yet; will apply the " << ies_len
+                           << " RSN Security IE byte(s) to sBssid::security_ies at AP_ENABLED time.";
+                continue;
+            }
+
+            // Store the raw RSN Security IEs so the Extended Report echoes them back.
+            target_bss->security_ies.assign(ies_ptr, ies_ptr + ies_len);
+            LOG(DEBUG) << "Stored " << ies_len << " RSN security IE byte(s) for BSS "
+                       << target_bss->mac << " (radio " << radio->front.iface_name << ")";
+        }
+    }
+
+    return true;
+}
