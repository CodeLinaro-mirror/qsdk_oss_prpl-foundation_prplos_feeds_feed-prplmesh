+                    sHiddenSsidConfig apply_cfg;
+                    apply_cfg.radio_uid          = ruid;
+                    apply_cfg.bssid              = target_bssid;
+                    apply_cfg.bss_index          = bss_adv_bss.bss_index();
+                    apply_cfg.ssid_advertisement =
+                        static_cast<bool>(bss_adv_bss.bss_infos().ssid_advertisement);
+
+                    LOG(DEBUG) << "APPLY (extended request): dispatching "
+                                  "APPLY_HIDDEN_SSID_CONFIG"
+                               << " ruid=" << ruid << " bssid=" << target_bssid
+                               << " bss_index=" << int(apply_cfg.bss_index)
+                               << " ssid_advertisement=" << apply_cfg.ssid_advertisement;
