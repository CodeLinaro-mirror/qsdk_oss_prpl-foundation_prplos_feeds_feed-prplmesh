+// ---------------------------------------------------------------------------
+
+// WFA OUI used by the RSN Override vendor-specific elements.
+static constexpr uint8_t WFA_OUI_0 = 0x50;
+static constexpr uint8_t WFA_OUI_1 = 0x6F;
+static constexpr uint8_t WFA_OUI_2 = 0x9A;
+// OUI types for the RSN Override family (Wi-Fi Alliance "RSN Overriding").
+static constexpr uint8_t RSN_OVERRIDE_OUI_TYPE     = 0x29; // RSNOE  -> rsn_override_*
+static constexpr uint8_t RSN_OVERRIDE_2_OUI_TYPE   = 0x2A; // RSNO2E -> rsn_override_*_2
+static constexpr uint8_t RSN_OVERRIDE_EXT_OUI_TYPE = 0x2B; // RSNXOE -> RSNXE override
+
+// Standard cipher/AKM selector OUI (00-0F-AC).
+static inline bool is_std_rsn_oui(const uint8_t *sel)
+{
+    return sel[0] == 0x00 && sel[1] == 0x0F && sel[2] == 0xAC;
+}
+
+// Translate a 4-byte pairwise/group cipher suite selector to a hostapd token.
+static std::string rsn_cipher_suite_to_token(const uint8_t *sel)
+{
+    if (!is_std_rsn_oui(sel)) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 2:  return "TKIP";
+    case 4:  return "CCMP";      // CCMP-128
+    case 8:  return "GCMP";      // GCMP-128
+    case 9:  return "GCMP-256";
+    case 10: return "CCMP-256";
+    default: return {};
+    }
+}
+
+// Translate a 4-byte group-management cipher suite selector to a hostapd token.
+static std::string rsn_group_mgmt_suite_to_token(const uint8_t *sel)
+{
+    if (!is_std_rsn_oui(sel)) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 6:  return "AES-128-CMAC"; // BIP-CMAC-128
+    case 11: return "BIP-GMAC-128";
+    case 12: return "BIP-GMAC-256";
+    case 13: return "BIP-CMAC-256";
+    default: return {};
+    }
+}
+
+// Translate a 4-byte AKM suite selector to a hostapd wpa_key_mgmt token.
+static std::string rsn_akm_suite_to_token(const uint8_t *sel)
+{
+    if (!is_std_rsn_oui(sel)) {
+        return {};
+    }
+    switch (sel[3]) {
+    case 1:  return "WPA-EAP";
+    case 2:  return "WPA-PSK";
+    case 5:  return "WPA-EAP-SHA256";
+    case 6:  return "WPA-PSK-SHA256";
+    case 8:  return "SAE";
+    case 9:  return "FT-SAE";
+    case 18: return "OWE";
+    case 24: return "SAE-EXT-KEY";
+    case 25: return "FT-SAE-EXT-KEY";
+    default: return {};
+    }
+}
+
+static std::string join_tokens(const std::vector<std::string> &tokens)
+{
+    std::string out;
+    for (const auto &t : tokens) {
+        if (t.empty()) {
+            continue;
+        }
+        if (!out.empty()) {
+            out += " ";
+        }
+        out += t;
+    }
+    return out;
+}
+
+// Parse an RSNE *body* (starting at the Version field, i.e. the content that
+// follows the Element ID + Length of an RSNE, or the WFA OUI+type of an RSN
+// Override element) and extract the hostapd-relevant tokens.
+//
+// RSNE body layout (802.11):
+//   Version(2) GroupDataCipher(4) PairwiseCount(2) PairwiseList(4*n)
+//   AKMCount(2) AKMList(4*m) [RSNCapabilities(2)] [PMKIDCount(2) PMKIDList(16*p)]
+//   [GroupMgmtCipher(4)]
+static bool parse_rsn_body(const uint8_t *b, size_t len, std::string &key_mgmt,
+                           std::string &pairwise, std::string &group_cipher,
+                           std::string &group_mgmt_cipher, std::string &mfp, bool &has_sae)
+{
+    has_sae = false;
+    // Need at least Version(2) + GroupDataCipher(4) + PairwiseCount(2).
+    if (len < 8) {
+        return false;
+    }
+
+    size_t p = 0;
+    p += 2; // Version
+
+    group_cipher = rsn_cipher_suite_to_token(&b[p]);
+    p += 4;
+
+    const uint16_t pw_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+    p += 2;
+    if (p + static_cast<size_t>(pw_count) * 4 > len) {
+        return false;
+    }
+    std::vector<std::string> pw_tokens;
+    for (uint16_t i = 0; i < pw_count; ++i) {
+        pw_tokens.push_back(rsn_cipher_suite_to_token(&b[p]));
+        p += 4;
+    }
+    pairwise = join_tokens(pw_tokens);
+
+    if (p + 2 <= len) {
+        const uint16_t akm_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+        p += 2;
+        if (p + static_cast<size_t>(akm_count) * 4 > len) {
+            return false;
+        }
+        std::vector<std::string> akm_tokens;
+        for (uint16_t i = 0; i < akm_count; ++i) {
+            auto tok = rsn_akm_suite_to_token(&b[p]);
+            if (tok == "SAE" || tok == "FT-SAE" || tok == "SAE-EXT-KEY" ||
+                tok == "FT-SAE-EXT-KEY") {
+                has_sae = true;
+            }
+            akm_tokens.push_back(tok);
+            p += 4;
+        }
+        key_mgmt = join_tokens(akm_tokens);
+    }
+
+    // RSN Capabilities (optional) -> MFP (ieee80211w / rsn_override_mfp).
+    mfp = "0";
+    if (p + 2 <= len) {
+        const uint16_t caps = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+        p += 2;
+        const bool mfpc = (caps & (1u << 7)) != 0; // Management Frame Protection Capable
+        const bool mfpr = (caps & (1u << 6)) != 0; // Management Frame Protection Required
+        mfp             = mfpr ? "2" : (mfpc ? "1" : "0");
+    }
+
+    // PMKID Count + PMKID List (optional) - skip.
+    if (p + 2 <= len) {
+        const uint16_t pmkid_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+        p += 2;
+        p += static_cast<size_t>(pmkid_count) * 16;
+    }
+
+    // Group Management Cipher Suite (optional).
+    if (p + 4 <= len) {
+        group_mgmt_cipher = rsn_group_mgmt_suite_to_token(&b[p]);
+        p += 4;
+    }
+
+    return true;
+}
+
+// Apply the raw RSN Security IEs (RSNE + RSN Override elements) received from the
+// Controller (sBssInfoConf::security_ies) to the hostapd configuration. Returns
+// false if no usable RSNE was found, so the caller can fall back to the
+// authentication_type-based logic.
+static bool apply_rsn_from_security_ies(prplmesh::hostapd::Configuration &conf,
+                                        const std::string &vap_id,
+                                        const son::wireless_utils::sBssInfoConf &bss)
+{
+    const auto &ies = bss.security_ies;
+    const size_t n  = ies.size();
+
+    bool found_rsne = false;
+    bool any_sae    = false;
+
+    // Primary RSNE outputs.
+    std::string wpa_key_mgmt, wpa_pairwise, group_cipher, group_mgmt_cipher, mfp = "0";
+
+    // RSN Override 1 / 2 outputs.
+    bool have_ovr1 = false, have_ovr2 = false, have_ovrx = false;
+    std::string o1_key_mgmt, o1_pairwise, o1_mfp;
+    std::string o2_key_mgmt, o2_pairwise, o2_mfp;
+
+    size_t i = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + len > n) {
+            LOG(WARNING) << "apply_rsn_from_security_ies: truncated IE at offset " << i;
+            break;
+        }
+        const uint8_t *body = &ies[i + 2];
+
+        if (eid == 48 /* RSNE */) {
+            bool sae = false;
+            if (parse_rsn_body(body, len, wpa_key_mgmt, wpa_pairwise, group_cipher,
+                               group_mgmt_cipher, mfp, sae)) {
+                found_rsne = true;
+                any_sae    = any_sae || sae;
+            } else {
+                LOG(WARNING) << "apply_rsn_from_security_ies: failed parsing RSNE";
+            }
+        } else if (eid == 221 /* Vendor-Specific */ && len >= 4 && body[0] == WFA_OUI_0 &&
+                   body[1] == WFA_OUI_1 && body[2] == WFA_OUI_2) {
+            const uint8_t oui_type = body[3];
+            const uint8_t *ovr     = body + 4;
+            const size_t ovr_len   = static_cast<size_t>(len) - 4;
+            std::string km, pw, grp, grp_mgmt, m;
+            bool sae = false;
+
+            if (oui_type == RSN_OVERRIDE_OUI_TYPE) {
+                if (parse_rsn_body(ovr, ovr_len, km, pw, grp, grp_mgmt, m, sae)) {
+                    have_ovr1   = true;
+                    o1_key_mgmt = km;
+                    o1_pairwise = pw;
+                    // The RSN Override element bodies (RSNOE/RSNO2E) that the Controller
+                    // sends often omit the optional RSN Capabilities field, so parse_rsn_body()
+                    // returns mfp="0". A WPA3 (SAE / SAE-EXT-KEY) override, however, mandates
+                    // Management Frame Protection, and the peer Controller's own hostapd.conf
+                    // renders rsn_override_mfp=2 in this case. Default MFP to "2" (required)
+                    // for an SAE-family override when the body carried no explicit caps, so the
+                    // Agent's hostapd.conf matches the Controller and set_create_vap_value() does
+                    // not drop a value-"0" key. Honor an explicit non-zero value if present.
+                    o1_mfp      = (m == "0" && sae) ? "2" : m;
+                    any_sae     = any_sae || sae;
+                }
+            } else if (oui_type == RSN_OVERRIDE_2_OUI_TYPE) {
+                if (parse_rsn_body(ovr, ovr_len, km, pw, grp, grp_mgmt, m, sae)) {
+                    have_ovr2   = true;
+                    o2_key_mgmt = km;
+                    o2_pairwise = pw;
+                    // Same MFP defaulting rationale as RSNOE above: SAE-EXT-KEY override
+                    // requires MFP; default rsn_override_mfp_2 to "2" when the body omitted
+                    // the RSN Capabilities field, matching the Controller's rendered value.
+                    o2_mfp      = (m == "0" && sae) ? "2" : m;
+                    any_sae     = any_sae || sae;
+                }
+            } else if (oui_type == RSN_OVERRIDE_EXT_OUI_TYPE) {
+                // RSNXOE (RSN eXtension Override, WFA OUI-type 0x2B).
+                //
+                // Per EasyMesh R6.1 §17.2.105 and 802.11-2020 §9.4.2.241, the RSNXE
+                // body is the "Extended RSN Capabilities" field. The operationally
+                // significant bits for us are:
+                //   Bit 5 (byte 0): SAE Password Identifier In Use  -> ignored here
+                //   Bit 6 (byte 0): SAE H2E (Hash-to-Element) required
+                //   Bit 9 (byte 1): SAE PK (Public Key)  -> logged, not applied
+                //
+                // hostapd doesn't expose a direct "rsnxoe_*" key on every version; the
+                // observable effect (advertising SAE-H2E and using PT-based SAE PWE) is
+                // driven by the `sae_pwe` config:
+                //     sae_pwe = 0 → hunt-and-peck only (legacy)
+                //     sae_pwe = 1 → hash-to-element only
+                //     sae_pwe = 2 → both (H2E preferred when both peers support it)
+                //
+                // When RSNXOE signals H2E:
+                //   - If the primary RSNE already carries an SAE-family AKM we upgrade
+                //     the sae_pwe target from the default "2" (both) to keep it "2".
+                //     (Setting "1" here would break hunt-and-peck-only STAs; keep the
+                //     transition-mode value.)
+                //   - We still record the H2E requirement so the sae_pwe write below
+                //     is done regardless of which SAE AKM branch selected it.
+                have_ovrx = true;
+                if (ovr_len >= 1) {
+                    const uint8_t caps0 = ovr[0];
+                    const bool h2e     = (caps0 & (1u << 6)) != 0; // Bit 6: SAE-H2E
+                    LOG(INFO) << "apply_rsn_from_security_ies: RSNXOE parsed"
+                              << " (len=" << ovr_len
+                              << ", cap0=0x" << std::hex << int(caps0) << std::dec
+                              << ") SAE-H2E=" << (h2e ? 1 : 0);
+                } else {
+                    LOG(WARNING) << "apply_rsn_from_security_ies: RSNXOE present but empty"
+                                 << " (len=" << ovr_len << "), ignoring";
+                }
+            }
+        }
+
+        i += 2 + len;
+    }
+
+    if (!found_rsne) {
+        LOG(WARNING) << "apply_rsn_from_security_ies: VAP=" << vap_id
+                     << " no RSNE found in security_ies (" << n
+                     << " bytes); falling back to auth_type logic";
+        return false;
+    }
+
+    // Validate / assign the credential (passphrase or 256-bit PSK).
+    std::string wpa_passphrase, wpa_psk;
+    if (!bss.network_key.empty()) {
+        if (bss.network_key.length() < 8 || bss.network_key.length() > 64) {
+            LOG(ERROR) << "apply_rsn_from_security_ies: VAP=" << vap_id
+                       << " invalid network key length " << bss.network_key.length();
+            return false;
+        }
+        if (bss.network_key.length() < 64) {
+            wpa_passphrase.assign(bss.network_key);
+        } else {
+            wpa_psk.assign(bss.network_key);
+        }
+    }
+
+    LOG(INFO) << "apply_rsn_from_security_ies: VAP=" << vap_id << " parsed RSN IEs ("
+              << n << " bytes): wpa_key_mgmt='" << wpa_key_mgmt << "' wpa_pairwise='"
+              << wpa_pairwise << "' group_cipher='" << group_cipher << "' group_mgmt='"
+              << group_mgmt_cipher << "' ieee80211w=" << mfp
+              << " ovr1=" << have_ovr1 << " ovr2=" << have_ovr2 << " ovrx=" << have_ovrx;
+
+    // Primary RSNE -> hostapd keys.
+    conf.set_create_value(vap_id, "wpa", 2);
+    conf.set_create_value(vap_id, "wpa_key_mgmt", wpa_key_mgmt);
+    conf.set_create_value(vap_id, "wpa_pairwise", wpa_pairwise);
+    if (!group_cipher.empty()) {
+        conf.set_create_value(vap_id, "group_cipher", group_cipher);
+    }
+    if (!group_mgmt_cipher.empty()) {
+        conf.set_create_value(vap_id, "group_mgmt_cipher", group_mgmt_cipher);
+    }
+    conf.set_create_value(vap_id, "ieee80211w", mfp);
+    conf.set_create_value(vap_id, "wpa_passphrase", wpa_passphrase);
+    conf.set_create_value(vap_id, "wpa_psk", wpa_psk);
+
+    if (any_sae) {
+        conf.set_create_value(vap_id, "sae_pwe", "2");
+        conf.set_create_value(vap_id, "sae_require_mfp", "1");
+    } else {
+        conf.set_create_value(vap_id, "sae_pwe", "");
+        conf.set_create_value(vap_id, "sae_require_mfp", "");
+    }
+
+    // Sensible defaults matching the WPA3/transition cases in the auth_type path.
+    conf.set_create_value(vap_id, "okc", "1");
+    conf.set_create_value(vap_id, "disable_pmksa_caching", "0");
+    conf.set_create_value(vap_id, "wpa_disable_eapol_key_retries", "0");
+
+    // RSN Override 1 (RSNOE) -> rsn_override_*.
+    if (have_ovr1) {
+        conf.set_create_value(vap_id, "rsn_override_key_mgmt", o1_key_mgmt);
+        conf.set_create_value(vap_id, "rsn_override_pairwise", o1_pairwise);
+        conf.set_create_value(vap_id, "rsn_override_mfp", o1_mfp);
+    }
+    // RSN Override 2 (RSNO2E) -> rsn_override_*_2.
+    if (have_ovr2) {
+        conf.set_create_value(vap_id, "rsn_override_key_mgmt_2", o2_key_mgmt);
+        conf.set_create_value(vap_id, "rsn_override_pairwise_2", o2_pairwise);
+        conf.set_create_value(vap_id, "rsn_override_mfp_2", o2_mfp);
+    }
+    // Clear override slots that were not advertised so stale values don't persist.
+    clear_rsn_override_parameters(conf, vap_id, !have_ovr1, !have_ovr2);
+
+    return true;
+}
+
+/**
+ * @brief Parse ONLY the RSN Override IEs (RSNOE + RSNO2E) from a raw Security IEs
+ *        blob and update the six `rsn_override_*` hostapd keys accordingly. The
+ *        primary RSNE (and thus wpa_key_mgmt / wpa_pairwise / wpa_passphrase /
+ *        ieee80211w / group_cipher) is left untouched.
+ *
+ * This is a stripped-down variant of `apply_rsn_from_security_ies()` intended for
+ * runtime, on-demand RSN Override updates driven by the Controller (via
+ * BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE / RSN Parameters Configuration TLV),
+ * where the current WPA credentials and primary key management should remain as
+ * whatever the auth_type-based configuration already wrote to hostapd.conf.
+ *
+ * Behaviour:
+ *   - RSNOE  (WFA OUI 50:6F:9A / OUI-type 0x29) present → sets
+ *       rsn_override_key_mgmt / rsn_override_pairwise / rsn_override_mfp.
+ *   - RSNO2E (WFA OUI 50:6F:9A / OUI-type 0x2A) present → sets
+ *       rsn_override_key_mgmt_2 / rsn_override_pairwise_2 / rsn_override_mfp_2.
+ *   - Any slot NOT advertised in security_ies is cleared so that stale values
+ *     from a previous configuration don't persist.
+ *   - If security_ies is empty, ALL six rsn_override_* keys are cleared.
+ *
+ * @param conf         Loaded hostapd Configuration for the target BSS.
+ * @param vap_id       VAP identifier in the hostapd conf (from get_vap_by_bssid()).
+ * @param security_ies Raw RSN Security IEs blob (RSNE + RSNOE + RSNO2E + …).
+ *                     Only the RSN Override IEs are consumed; RSNE is skipped.
+ * @return true if the config was updated (write only, no store()); false on
+ *         truncated/malformed IE stream.
+ */
+// Parsed RSN Override values, optionally returned by apply_rsn_override_only() so the
+// caller (e.g. update_bss_rsn_override) can persist them to UCI via
+// bpl_cfg_set_rsn_override().  Empty strings mean "clear this key".
+struct sRsnOverrideParsed {
+    std::string o1_key_mgmt;
+    std::string o1_pairwise;
+    std::string o1_mfp;
+    std::string o2_key_mgmt;
+    std::string o2_pairwise;
+    std::string o2_mfp;
+};
+
+static bool apply_rsn_override_only(prplmesh::hostapd::Configuration &conf,
+                                    const std::string &vap_id,
+                                    const std::vector<uint8_t> &security_ies,
+                                    sRsnOverrideParsed *out_parsed = nullptr)
+{
+    const size_t n = security_ies.size();
+
+    // Empty vector → clear all six override keys and return.
+    if (n == 0) {
+        LOG(INFO) << "apply_rsn_override_only: VAP=" << vap_id
+                  << " empty security_ies → clearing rsn_override_* keys";
+        clear_rsn_override_parameters(conf, vap_id, true, true);
+        if (out_parsed) {
+            *out_parsed = sRsnOverrideParsed{}; // all six empty → clear in UCI too
+        }
+        return true;
+    }
+
+    bool have_ovr1 = false, have_ovr2 = false;
+    std::string o1_key_mgmt, o1_pairwise, o1_mfp;
+    std::string o2_key_mgmt, o2_pairwise, o2_mfp;
+
+    size_t i = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = security_ies[i];
+        const uint8_t len = security_ies[i + 1];
+        if (i + 2 + len > n) {
+            LOG(WARNING) << "apply_rsn_override_only: VAP=" << vap_id
+                         << " truncated IE at offset " << i;
+            break;
+        }
+        const uint8_t *body = &security_ies[i + 2];
+
+        // Only interested in vendor-specific IEs carrying the WFA "RSN Overriding" OUI.
+        if (eid == 221 /* Vendor-Specific */ && len >= 4 &&
+            body[0] == WFA_OUI_0 && body[1] == WFA_OUI_1 && body[2] == WFA_OUI_2) {
+            const uint8_t oui_type = body[3];
+            const uint8_t *ovr     = body + 4;
+            const size_t ovr_len   = static_cast<size_t>(len) - 4;
+
+            std::string km, pw, grp, grp_mgmt, m;
+            bool sae = false;
+
+            if (oui_type == RSN_OVERRIDE_OUI_TYPE) {
+                if (parse_rsn_body(ovr, ovr_len, km, pw, grp, grp_mgmt, m, sae)) {
+                    have_ovr1   = true;
+                    o1_key_mgmt = km;
+                    o1_pairwise = pw;
+                    o1_mfp      = m;
+                }
+            } else if (oui_type == RSN_OVERRIDE_2_OUI_TYPE) {
+                if (parse_rsn_body(ovr, ovr_len, km, pw, grp, grp_mgmt, m, sae)) {
+                    have_ovr2   = true;
+                    o2_key_mgmt = km;
+                    o2_pairwise = pw;
+                    o2_mfp      = m;
+                }
+            }
+            // RSNXOE (oui_type == 0x2B) has no exposed hostapd override key today;
+            // logged elsewhere and left to hostapd defaults.
+        }
+        // RSNE (eid=48), RSNXE (eid=244) and other IEs are intentionally ignored:
+        // this helper is only concerned with the RSN Override delta.
+        i += 2 + len;
+    }
+
+    // Write / clear the six rsn_override_* keys based on what was advertised.
+    if (have_ovr1) {
+        conf.set_create_value(vap_id, "rsn_override_key_mgmt", o1_key_mgmt);
+        conf.set_create_value(vap_id, "rsn_override_pairwise", o1_pairwise);
+        conf.set_create_value(vap_id, "rsn_override_mfp",      o1_mfp);
+    }
+    if (have_ovr2) {
+        conf.set_create_value(vap_id, "rsn_override_key_mgmt_2", o2_key_mgmt);
+        conf.set_create_value(vap_id, "rsn_override_pairwise_2", o2_pairwise);
+        conf.set_create_value(vap_id, "rsn_override_mfp_2",      o2_mfp);
+    }
+    // Clear any slot not advertised so stale values don't linger in hostapd.conf.
+    clear_rsn_override_parameters(conf, vap_id, !have_ovr1, !have_ovr2);
+
+    // Export the parsed values so the caller can persist them to UCI.  Slots that
+    // were not advertised remain empty strings, which bpl_cfg_set_rsn_override()
+    // treats as "remove this option" — matching the clear_rsn_override_parameters()
+    // behaviour applied to hostapd.conf just above.
+    if (out_parsed) {
+        out_parsed->o1_key_mgmt = have_ovr1 ? o1_key_mgmt : "";
+        out_parsed->o1_pairwise = have_ovr1 ? o1_pairwise : "";
+        out_parsed->o1_mfp      = have_ovr1 ? o1_mfp : "";
+        out_parsed->o2_key_mgmt = have_ovr2 ? o2_key_mgmt : "";
+        out_parsed->o2_pairwise = have_ovr2 ? o2_pairwise : "";
+        out_parsed->o2_mfp      = have_ovr2 ? o2_mfp : "";
+    }
