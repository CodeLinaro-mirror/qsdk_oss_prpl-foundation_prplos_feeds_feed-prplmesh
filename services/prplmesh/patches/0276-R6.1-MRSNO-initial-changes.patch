+void ApAutoConfigurationTask::handle_bss_configuration_extended_request(
+    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    const auto mid = cmdu_rx.getMessageId();
+    LOG(DEBUG) << "Received BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE, mid=" << std::hex
+               << int(mid);
+
+    auto db = AgentDB::get();
+
+    // Only accept the request from the onboarded Controller.
+    const auto &src_mac = db->controller_info.bridge_mac;
+    if (src_mac == net::network_utils::ZERO_MAC) {
+        LOG(WARNING) << "BSS Configuration Extended Request received before controller onboarding; "
+                        "ignoring";
+        return;
+    }
+
+    const bool has_bss_advanced_cfg =
+        static_cast<bool>(cmdu_rx.getClass<wfa_map::tlvBssAdvancedConfiguration>());
+    const bool has_rsn_params_cfg =
+        static_cast<bool>(cmdu_rx.getClass<wfa_map::tlvRsnParametersConfiguration>());
+
+    if (!has_bss_advanced_cfg && !has_rsn_params_cfg) {
+        LOG(WARNING) << "BSS Configuration Extended Request carries neither a BSS Advanced "
+                        "Configuration TLV nor an RSN Parameters Configuration TLV; nothing to do";
+    }
+
+    // 1) Apply the BSS Advanced Configuration TLV (SSID Advertisement), if present.
+    //    - Step 1a: the 2-arg handle_bss_advanced_configuration_tlv() updates AgentDB and
+    //      stashes hidden_ssid for BSS_Index-only VAPs, but does NOT push to hostapd/UCI on
+    //      this path (no M2 credentials refresh follows).
+    //    - Step 1b: iterate the TLV entries and dispatch one APPLY_HIDDEN_SSID_CONFIG event
+    //      per BSS. Our handler builds ACTION_APMANAGER_UPDATE_HIDDEN_SSID_REQUEST, and the AP
+    //      manager's HAL writes ignore_broadcast_ssid to hostapd.conf, sets UCI 'hidden', and
+    //      issues RELOAD_CONFIG (MLO-safe; mirrors the RSN apply loop below).
+    if (has_bss_advanced_cfg) {
+        std::vector<sBssConfig> empty_bss_infos;
+        if (!handle_bss_advanced_configuration_tlv(cmdu_rx, empty_bss_infos)) {
+            LOG(ERROR) << "handle_bss_advanced_configuration_tlv (2-arg) has failed for BSS "
+                          "Configuration Extended Request";
+        }
+
+        // Dispatch APPLY_HIDDEN_SSID_CONFIG per (RUID, BSS) so hostapd + UCI are updated.
+        auto bss_adv_cfg = cmdu_rx.getClass<wfa_map::tlvBssAdvancedConfiguration>();
+        if (bss_adv_cfg) {
+            LOG(DEBUG) << "APPLY (extended request): BSS Advanced Configuration TLV has "
+                       << int(bss_adv_cfg->num_radio()) << " radio(s); dispatching "
+                                                            "APPLY_HIDDEN_SSID_CONFIG events";
+            auto db_apply = AgentDB::get();
+            for (auto radio_idx = 0; radio_idx < bss_adv_cfg->num_radio(); ++radio_idx) {
+                auto bss_adv_radio_tuple = bss_adv_cfg->radios(radio_idx);
+                if (!std::get<0>(bss_adv_radio_tuple)) {
+                    LOG(ERROR) << "APPLY (extended request): failed to get radio entry "
+                               << radio_idx << " from tlvBssAdvancedConfiguration";
+                    continue;
+                }
+                wfa_map::cBssAdvancedConfigurationRadio &bss_adv_radio =
+                    std::get<1>(bss_adv_radio_tuple);
+                const sMacAddr ruid = bss_adv_radio.ruid();
+
+                auto radio = db_apply->get_radio_by_mac(ruid, AgentDB::eMacType::RADIO);
+                if (!radio) {
+                    LOG(WARNING) << "APPLY (extended request): unknown RUID " << ruid
+                                 << ", skipping hidden-SSID apply";
+                    continue;
+                }
+
+                for (auto bss_idx = 0; bss_idx < bss_adv_radio.num_bss(); ++bss_idx) {
+                    auto bss_adv_bss_tuple = bss_adv_radio.bsss(bss_idx);
+                    if (!std::get<0>(bss_adv_bss_tuple)) {
+                        LOG(ERROR) << "APPLY (extended request): failed to get BSS entry "
+                                   << bss_idx << " from tlvBssAdvancedConfiguration";
+                        continue;
+                    }
+                    wfa_map::cBssAdvancedConfigurationBss &bss_adv_bss =
+                        std::get<1>(bss_adv_bss_tuple);
+
+                    // Resolve the target BSSID: prefer the explicit BSSID, fall back to the
+                    // Controller BSS_Index slot (1-based) into the radio's VAP list. This is the
+                    // same correlation strategy used by the RSN apply loop above, and by
+                    // handle_bss_advanced_configuration_tlv() itself.
+                    sMacAddr target_bssid = bss_adv_bss.bssid();
+                    if (target_bssid == net::network_utils::ZERO_MAC &&
+                        bss_adv_bss.bss_index() != 0 &&
+                        static_cast<size_t>(bss_adv_bss.bss_index() - 1) <
+                            radio->front.bssids.size()) {
+                        target_bssid =
+                            radio->front.bssids[bss_adv_bss.bss_index() - 1].mac;
+                    }
