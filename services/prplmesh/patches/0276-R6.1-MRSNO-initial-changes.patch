diff --git a/framework/tlvf/yaml/tlvf/wfa_map/tlvRsnDiagnosticReport.yaml b/framework/tlvf/yaml/tlvf/wfa_map/tlvRsnDiagnosticReport.yaml
new file mode 100644
index 0000000..b3cb4a7
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvRsnDiagnosticReport.yaml
@@ -0,0 +1,29 @@
+#
+---
+_namespace: wfa_map
+
+# Wi-Fi EasyMesh R6.1 - section 17.2.106, Table 129 - RSN Diagnostic Report TLV
+# Sent by the Agent inside a Failed Connection message (§17.1.44) to report the RSN context
+# of a client authentication/association failure. Carries an RSN Error code identifying the
+# phase of the failure and the raw 802.11 frame body that triggered it.
+
+tlvRsnDiagnosticReport:
+  _type: class
+  _is_tlv_class : True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_RSN_DIAGNOSTIC_REPORT
+  length: uint16_t
+  rsn_error:
+    _type: uint8_t
+    _comment: |
+      RSN Error code describing the phase/cause of the failure. Per R6.1 §17.2.106:
+        0x01 = failure occurred during (Re)Association / authentication.
+      Other values are reserved for future use.
+  frame_body:
+    _type: uint8_t
+    _length: []
+    _comment: |
+      Raw bytes of the 802.11 frame body that triggered the failure. Length is derived
+      from the enclosing TLV length (consumes the remainder of the TLV). May be zero
+      bytes when the Agent cannot capture the frame body.
diff --git a/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml b/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml
new file mode 100644
index 0000000..ab9d3f1
--- /dev/null
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml
@@ -0,0 +1,71 @@
+#
+---
+_namespace: wfa_map
+_include:
+  {
+    tlvf/ieee_1905_1/sVendorOUI.h,
+    tlvf/wfa_map/eTlvTypeMap.h,
+    tlvf/common/sMacAddr.h
+  }
+
+# Wi-Fi EasyMesh R6.1 - section 17.2.94 - Supported Cipher Suites TLV
+# Sent by the Agent in the AP Capability Report and Early AP Capability Report to advertise which
+# IEEE 802.11 pairwise/group cipher suites the Agent can enforce on fronthaul and backhaul BSSes.
+# The Controller uses this to constrain the SecurityIEs it may push via the RSN Parameters
+# Configuration TLV (§17.2.105) so it never proposes a cipher the Agent cannot honour.
+#
+# Layout mirrors tlvAkmSuiteCapabilities (agent-level; two cipher-suite-selector lists, one for
+# backhaul BSSes and one for fronthaul BSSes). Each selector is a 3B OUI + 1B suite-type value
+# per IEEE Std 802.11-2020 Table 9-149 (Cipher suite selectors).
+
+tlvSupportedCipherSuites:
+  _type: class
+  _is_tlv_class : True
+  type:
+    _type: eTlvTypeMap
+    _value_const: TLV_SUPPORTED_CIPHER_SUITES
+  length: uint16_t
+  number_of_bh_bss_cipher_suite_selectors:
+    _type: uint8_t
+    _length_var: True
+  backhaul_bss_cipher_suite_selectors:
+    _type: sBssCipherSuiteSelector
+    _length: [ number_of_bh_bss_cipher_suite_selectors ]
+  number_of_fh_bss_cipher_suite_selectors:
+    _type: uint8_t
+    _length_var: True
+  fronthaul_bss_cipher_suite_selectors:
+    _type: sBssCipherSuiteSelector
+    _length: [ number_of_fh_bss_cipher_suite_selectors ]
+
+sBssCipherSuiteSelector:
+  _type: struct
+  oui:
+    _type: sVendorOUI
+    _comment: |
+      OUI of the cipher suite selector, per IEEE Std 802.11-2020 Table 9-149. IEEE 802.11
+      cipher suites use OUI 00-0F-AC.
+  cipher_suite_type:
+    _type: uint8_t
+    _comment: |
+      IEEE 802.11 cipher suite type value (see eCipherSuiteType for common values and
+      IEEE Std 802.11-2020 Table 9-149 for the authoritative list).
+
+# Cipher suite type values that MRSNO / RSN Overriding is most likely to negotiate. Names and
+# values follow IEEE Std 802.11-2020 Table 9-149.
+eCipherSuiteType:
+  _type: enum
+  _enum_storage: uint8_t
+  USE_GROUP_CIPHER:   0x00
+  WEP_40:             0x01
+  TKIP:               0x02
+  CCMP_128:           0x04
+  WEP_104:            0x05
+  BIP_CMAC_128:       0x06
+  GROUP_NOT_ALLOWED:  0x07
+  GCMP_128:           0x08
+  GCMP_256:           0x09
+  CCMP_256:           0x0A
+  BIP_GMAC_128:       0x0B
+  BIP_GMAC_256:       0x0C
+  BIP_CMAC_256:       0x0D
-- 
