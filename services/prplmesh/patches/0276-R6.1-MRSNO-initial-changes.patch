+bool ApAutoConfigurationTask::add_rsn_parameters_configuration_report_tlv(
+    ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto db = AgentDB::get();
+
+    // Add exactly one RSN Parameters Configuration TLV (spec 17.2.107) echoing back the RSN
+    // Security IEs stored in AgentDB.
+    //
+    // Per Wi-Fi EasyMesh v6.1 §7.1.3 / §17.1.46:
+    //   "A Multi-AP Agent that implements RSN Overriding shall include one RSN Parameters
+    //    Configuration TLV in the BSS Configuration Extended Report message."
+    // So the TLV is ALWAYS added when this function runs (the caller only invokes it for Agents
+    // that implement RSN Overriding / MRSNO). It is populated per radio with the BSSes that have
+    // an assigned BSSID and stored RSN Security IEs; radios/BSSes without stored IEs contribute
+    // no entry (Number of Radios / Number of BSS reflect only the reported ones). A BSS whose
+    // BSSID is still ZERO_MAC (VAP not yet created) is skipped — its IEs are re-applied by
+    // handle_vs_ap_enabled_notification() once the VAP is up, and echoed in a later report.
+    auto rsn_params_config_report = cmdu_tx.addClass<wfa_map::tlvRsnParametersConfiguration>();
+    if (!rsn_params_config_report) {
+        LOG(ERROR) << "addClass wfa_map::tlvRsnParametersConfiguration failed";
+        return false;
+    }
+
+    size_t reported_bss_count = 0;
+    for (const auto &radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        // Collect, per radio, the set of RSN entries to report. Each entry is either:
+        //   - keyed by real BSSID  (bss.security_ies populated once the VAP is up), or
+        //   - keyed by Controller BSS_Index (from the pending stash
+        //     m_bss_index_security_ies) when the VAP's BSSID is not yet assigned.
+        //
+        // Reporting by BSS_Index (with BSSID = 0) is spec-legal per §17.2.107 Table 131 and is
+        // REQUIRED here because the Extended Report is sent right after M2 processing — before
+        // the VAP's real BSSID exists — so relying only on sBssid::security_ies would emit an
+        // empty RSN TLV (the length-1 / value-0x00 seen on the wire). The stash guarantees the
+        // Controller-supplied RSN Security IEs are echoed back regardless of VAP-creation timing.
+        struct RsnReportEntry {
+            sMacAddr bssid;             // real BSSID, or ZERO_MAC when only bss_index is known
+            uint8_t bss_index;          // Controller BSS_Index (0 when reporting by BSSID)
+            const std::vector<uint8_t> *ies;
+        };
+        std::vector<RsnReportEntry> entries;
+
+        // 1) BSSes with a real BSSID and stored IEs (post-AP_ENABLED / applied state).
+        for (const auto &bss : radio->front.bssids) {
+            if (bss.mac != beerocks::net::network_utils::ZERO_MAC && !bss.security_ies.empty()) {
+                entries.push_back({bss.mac, 0, &bss.security_ies});
+            }
+        }
+
+        // 2) Pending stash keyed by Controller BSS_Index. Report these by bss_index (BSSID=0)
+        //    only if the same IEs are not already covered by a real-BSSID entry above (avoid
+        //    duplicate echo for a BSS that is both stashed and already up).
+        auto pending_radio_it = m_bss_index_security_ies.find(radio->front.iface_name);
+        if (pending_radio_it != m_bss_index_security_ies.end()) {
+            for (const auto &idx_ies : pending_radio_it->second) {
+                const uint8_t bss_index          = idx_ies.first;
+                const std::vector<uint8_t> &pies = idx_ies.second;
+                if (pies.empty()) {
+                    continue;
+                }
+                const bool already_reported =
+                    std::any_of(entries.begin(), entries.end(), [&](const RsnReportEntry &e) {
+                        return e.ies != nullptr && *e.ies == pies;
+                    });
+                if (!already_reported) {
+                    entries.push_back({beerocks::net::network_utils::ZERO_MAC, bss_index, &pies});
+                }
+            }
+        }
+
+        if (entries.empty()) {
+            continue;
+        }
+
+        auto rsn_radio_entry = rsn_params_config_report->create_radios();
+        if (!rsn_radio_entry) {
+            LOG(ERROR) << "Failed creating radio entry in RSN Parameters Configuration TLV";
+            continue;
+        }
+        rsn_radio_entry->ruid() = radio->front.iface_mac;
+
+        for (const auto &entry : entries) {
+            auto rsn_bss_entry = rsn_radio_entry->create_bsss();
+            if (!rsn_bss_entry) {
+                LOG(ERROR) << "Failed creating BSS entry in RSN Parameters Configuration TLV";
+                continue;
+            }
+
+            rsn_bss_entry->bssid()     = entry.bssid;      // ZERO_MAC when reporting by bss_index
+            rsn_bss_entry->bss_index() = entry.bss_index;  // Controller BSS_Index (0 when by BSSID)
+
+            if (!rsn_bss_entry->alloc_security_ies(entry.ies->size())) {
+                LOG(ERROR) << "Failed allocating security IEs for BSS " << entry.bssid
+                           << " (bss_index=" << int(entry.bss_index) << ")";
+                continue;
+            }
+            std::copy(entry.ies->begin(), entry.ies->end(), rsn_bss_entry->security_ies());
+
+            if (!rsn_radio_entry->add_bsss(rsn_bss_entry)) {
+                LOG(ERROR) << "Failed adding BSS entry to radio in RSN Parameters Configuration TLV";
+                continue;
+            }
+            LOG(DEBUG) << "RSN report: radio " << radio->front.iface_name << " echoing "
+                       << entry.ies->size() << " IE byte(s) for "
+                       << (entry.bssid != beerocks::net::network_utils::ZERO_MAC
+                               ? ("bssid=" + tlvf::mac_to_string(entry.bssid))
+                               : ("bss_index=" + std::to_string(int(entry.bss_index))));
+            ++reported_bss_count;
+        }
+
+        if (!rsn_params_config_report->add_radios(rsn_radio_entry)) {
+            LOG(ERROR) << "Failed adding radio entry to RSN Parameters Configuration TLV";
+        }
+    }
+
+    LOG(DEBUG) << "Added RSN Parameters Configuration TLV to BSS Configuration Extended Report ("
+               << reported_bss_count << " BSS entr" << (reported_bss_count == 1 ? "y" : "ies")
+               << ")";
+    return true;
+}
+
+
 bool ApAutoConfigurationTask::send_bss_configuration_extended_report_message()
 {
-    // Per spec section 7.1.3: send BSS Configuration Extended Report message with
-    // BSS Advanced Configuration TLV reporting the settings actually applied on the BSS(s).
+    // Per Wi-Fi EasyMesh v6.1 §7.1.3 / §17.1.46, the BSS Configuration Extended Report message
+    // carried by an RSN-Overriding-capable Multi-AP Agent shall include, in this field order:
+    //   1) one BSS Advanced Configuration TLV (§17.2.105) reporting the applied SSID
+    //      Advertisement (and other advanced BSS) settings for each radio/BSS, and
+    //   2) one RSN Parameters Configuration TLV (§17.2.107) echoing back the applied RSN
+    //      Security IEs (RSNE/RSNOE/RSNO2E/RSNXOE) for each radio/BSS.
+    // BOTH TLVs are mandatory in this message for such an Agent, so both builders are invoked
+    // unconditionally and their failure is fatal to sending the report. The RSN builder emits an
+    // RSN Parameters Configuration TLV even when no BSS currently has stored Security IEs (an
+    // RSN-Overriding Agent still advertises the TLV, with Number of Radios reflecting only the
+    // BSSes that carry RSN parameters).
     if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE)) {
         LOG(ERROR) << "cmdu creation of type BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE has failed";
         return false;
     }
 
+    // 1) BSS Advanced Configuration TLV (mandatory, first).
     if (!add_bss_advanced_configuration_report_tlv(m_cmdu_tx)) {
-        LOG(ERROR) << "Failed to add BSS Advanced Configuration TLV to BSS Configuration Extended Report";
+        LOG(ERROR) << "Failed to add BSS Advanced Configuration TLV to BSS Configuration Extended "
+                      "Report";
+        return false;
+    }
+
+    // 2) RSN Parameters Configuration TLV (mandatory for an RSN-Overriding Agent, second).
+    if (!add_rsn_parameters_configuration_report_tlv(m_cmdu_tx)) {
+        LOG(ERROR) << "Failed to add RSN Parameters Configuration TLV to BSS Configuration "
+                      "Extended Report";
         return false;
     }
 
-    LOG(DEBUG) << "Sending BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE to controller";
+    LOG(DEBUG) << "Sending BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE to controller "
+                  "(BSS Advanced Configuration TLV + RSN Parameters Configuration TLV)";
     return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
 }
 
