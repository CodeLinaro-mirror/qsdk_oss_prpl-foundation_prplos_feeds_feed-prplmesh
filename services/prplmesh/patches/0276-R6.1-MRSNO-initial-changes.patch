+namespace {
+// Local helpers to decode the AKM composition of an RSN Parameters Configuration
+// TLV entry (RSNE + optional RSNOE / RSNO2E vendor-specific override IEs).
+//
+// The Agent maps arbitrary Controller-supplied RSN Security IEs to one of the
+// WPA3-Personal-Compatibility-Mode (MRSNO) enum values whenever the AKM
+// composition matches, regardless of exact byte layout (cipher choices, MFP
+// values, Group Data / Group Mgmt cipher, PMKID list presence, or IE ordering).
+
+// WFA OUI used by the RSN Override vendor-specific elements.
+constexpr uint8_t kWfaOui0            = 0x50;
+constexpr uint8_t kWfaOui1            = 0x6F;
+constexpr uint8_t kWfaOui2            = 0x9A;
+constexpr uint8_t kRsnOverrideOuiType = 0x29; // RSNOE
+constexpr uint8_t kRsnOverride2OuiType = 0x2A; // RSNO2E
+
+// AKM suite selector (last byte of the 00-0F-AC selector).
+constexpr uint8_t kAkmSuiteWpaPsk     = 2;
+constexpr uint8_t kAkmSuiteSae        = 8;
+constexpr uint8_t kAkmSuiteSaeExtKey  = 24;
+
+// Bitmask of AKM suites found in the parsed IEs.
+constexpr uint8_t kAkmBitWpaPsk    = 0x01;
+constexpr uint8_t kAkmBitSae       = 0x02;
+constexpr uint8_t kAkmBitSaeExtKey = 0x04;
+
+// Return true if the 4-byte selector is a standard 00-0F-AC selector.
+static inline bool is_std_rsn_oui(const uint8_t *sel)
+{
+    return sel[0] == 0x00 && sel[1] == 0x0F && sel[2] == 0xAC;
+}
+
+// Scan the AKM suite list inside an RSN body starting at *b* (of length *len*).
+// Returns an AKM bitmask (kAkmBit*). Body layout (802.11):
+//   Version(2) GroupDataCipher(4) PairwiseCount(2) PairwiseList(4*n)
+//   AKMCount(2) AKMList(4*m) [RSNCapabilities(2)] [PMKIDCount(2) PMKIDList] ...
+static uint8_t rsn_body_akm_bits(const uint8_t *b, size_t len)
+{
+    if (len < 8) {
+        return 0;
+    }
+    size_t p = 2;              // skip Version
+    p += 4;                    // skip Group Data Cipher
+    if (p + 2 > len) return 0;
+    const uint16_t pw_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+    p += 2;
+    if (p + static_cast<size_t>(pw_count) * 4 > len) return 0;
+    p += static_cast<size_t>(pw_count) * 4; // skip Pairwise list
+    if (p + 2 > len) return 0;
+    const uint16_t akm_count = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+    p += 2;
+    if (p + static_cast<size_t>(akm_count) * 4 > len) return 0;
+
+    uint8_t bits = 0;
+    for (uint16_t i = 0; i < akm_count; ++i) {
+        const uint8_t *sel = &b[p + static_cast<size_t>(i) * 4];
+        if (!is_std_rsn_oui(sel)) {
+            continue;
+        }
+        switch (sel[3]) {
+        case kAkmSuiteWpaPsk:    bits |= kAkmBitWpaPsk;    break;
+        case kAkmSuiteSae:       bits |= kAkmBitSae;       break;
+        case kAkmSuiteSaeExtKey: bits |= kAkmBitSaeExtKey; break;
+        default: break;
+        }
+    }
+    return bits;
+}
+
+// Parse a full RSN Parameters TLV `security_ies` blob and classify the WPA3-PCM
+// (MRSNO) AKM composition by looking ONLY at the RSN-Override vendor elements:
+//   - RSNOE  (WFA 50:6F:9A OUI-type 0x29) → AKM8  (SAE) override requested
+//   - RSNO2E (WFA 50:6F:9A OUI-type 0x2A) → AKM24 (SAE-EXT-KEY) override requested
+//
+// IMPORTANT: the primary RSNE (Element ID 48) is intentionally excluded from the
+// AKM classification. The WPA3-PCM mode is determined solely by which override
+// element(s) the Controller included. The RSNXE / RSNXOE elements are ignored —
+// they affect SAE PWE but not the AKM set.
+static uint8_t decode_rsn_ies_akm_bits(const uint8_t *ies, size_t n)
+{
+    bool has_rsnoe  = false; // RSNOE  (0x29) present → AKM8 override
+    bool has_rsno2e = false; // RSNO2E (0x2A) present → AKM24 override
+    uint8_t rsnoe_bits  = 0;
+    uint8_t rsno2e_bits = 0;
+
+    size_t i = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + len > n) {
+            break; // truncated
+        }
+        const uint8_t *body = &ies[i + 2];
+
+        if (eid == 221 /* Vendor-Specific */ && len >= 4 &&
+            body[0] == kWfaOui0 && body[1] == kWfaOui1 && body[2] == kWfaOui2) {
+            const uint8_t oui_type = body[3];
+            if (oui_type == kRsnOverrideOuiType) {
+                has_rsnoe  = true;
+                rsnoe_bits = rsn_body_akm_bits(body + 4, static_cast<size_t>(len) - 4);
+            } else if (oui_type == kRsnOverride2OuiType) {
+                has_rsno2e  = true;
+                rsno2e_bits = rsn_body_akm_bits(body + 4, static_cast<size_t>(len) - 4);
+            }
+            // Other WFA vendor OUI types (e.g. RSNXOE 0x2B) are ignored: they do not
+            // introduce new AKM suites — only extended RSN capabilities.
+        }
+        // The primary RSNE (eid == 48) is deliberately NOT consulted for the MRSNO
+        // AKM classification (see function comment).
+        i += 2 + len;
+    }
+
+    // Derive the MRSNO AKM bitmask from the OVERRIDE elements only. Prefer the AKM
+    // suite actually listed inside each override element; fall back to the element's
+    // canonical meaning (RSNOE→SAE, RSNO2E→SAE-EXT-KEY) if the body parse yielded no
+    // recognizable suite (e.g. an override element that only tweaks ciphers/MFP).
+    uint8_t bits = 0;
+    if (has_rsnoe) {
+        bits |= (rsnoe_bits & (kAkmBitSae | kAkmBitSaeExtKey | kAkmBitWpaPsk));
+        if ((bits & (kAkmBitSae | kAkmBitSaeExtKey)) == 0) {
+            bits |= kAkmBitSae; // RSNOE canonically carries SAE (AKM8)
+        }
+    }
+    if (has_rsno2e) {
+        bits |= (rsno2e_bits & (kAkmBitSae | kAkmBitSaeExtKey | kAkmBitWpaPsk));
+        if ((rsno2e_bits & kAkmBitSaeExtKey) == 0) {
+            bits |= kAkmBitSaeExtKey; // RSNO2E canonically carries SAE-EXT-KEY (AKM24)
+        }
+    }
+    return bits;
+}
