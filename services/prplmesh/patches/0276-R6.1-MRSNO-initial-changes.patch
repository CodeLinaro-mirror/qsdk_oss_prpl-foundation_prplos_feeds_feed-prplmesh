+/**
+ * @brief Pre-populate MRSNO fields on sBssInfoConf from the local UCI wireless
+ *        config, mirroring how `ssid_advertisement` / `hidden_ssid` are sourced
+ *        from UCI by `bpl_cfg_get_wireless_settings()`.
+ *
+ * On the same-device / self-agent path, `additional_auth` may not be propagated
+ * through the WSC M2 vendor extension. This helper sources it directly from UCI
+ * and widens `authentication_type` so `assign_auth_encr_parameters()` reaches
+ * the correct MRSNO branch.
+ *
+ * Preconditions: caller invokes this before `assign_auth_encr_parameters()`.
+ * If M2 already delivered a non-NONE `additional_auth` or a non-empty
+ * `security_ies` blob, this helper is a no-op.
+ */
+// Derive the per-band eAdditionalAuth value from a raw RSN Security IEs blob.
+// Inspects both the primary RSNE (for 6 GHz native AKM) and the RSN Override
+// vendor elements (RSNOE 0x29 → AKM8, RSNO2E 0x2A → AKM24).
+static son::wireless_utils::eAdditionalAuth
+additional_auth_from_security_ies(const std::vector<uint8_t> &ies)
+{
+    using EA       = son::wireless_utils::eAdditionalAuth;
+    const size_t n = ies.size();
+    bool have_ovr1 = false;    // RSNOE  (0x29) - carries a SAE-family AKM in the override slot 1
+    bool have_ovr2 = false;    // RSNO2E (0x2A) - carries a SAE-family AKM in the override slot 2
+
+    size_t i = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + len > n) {
+            break;
+        }
+        const uint8_t *body = &ies[i + 2];
+
+        // The primary RSNE (eid 48) is intentionally not inspected here: MRSNO activity
+        // is decided solely by the presence of an RSN Override vendor element (RSNOE/RSNO2E).
+        // The specific AKM set is carried in security_ies and consumed downstream.
+        if (eid == 221 /* Vendor-Specific */ && len >= 4 && body[0] == WFA_OUI_0 &&
+            body[1] == WFA_OUI_1 && body[2] == WFA_OUI_2) {
+            const uint8_t oui_type = body[3];
+            if (oui_type == RSN_OVERRIDE_OUI_TYPE) {
+                have_ovr1 = true;
+            } else if (oui_type == RSN_OVERRIDE_2_OUI_TYPE) {
+                have_ovr2 = true;
+            }
+        }
+        i += 2 + len;
+    }
+
+    // Any override slot populated → MRSNO is active.
+    // The specific AKM set (AKM8, AKM24, or AKM8+AKM24) is encoded in security_ies;
+    // WPA3_PERSONAL_COMPATIBILITY only signals that MRSNO is active.
+    if (have_ovr1 || have_ovr2) {
+        return EA::WPA3_PERSONAL_COMPATIBILITY;
+    }
+    return EA::NONE;
+}
+
+static void preload_mrsno_from_uci(son::wireless_utils::sBssInfoConf &bss,
+                                   const std::string &iface_hint)
+{
+    if (bss.additional_auth != son::wireless_utils::eAdditionalAuth::NONE) {
+        return; // already set by M2 / vendor-ext parser
+    }
+    if (!bss.security_ies.empty()) {
+        // The Controller delivered raw RSN IEs for this band in the M2 RSN Parameters
+        // Configuration TLV. Derive additional_auth directly from the blob so the value
+        // persisted to UCI matches the blob for this band.
+        auto ies_auth = additional_auth_from_security_ies(bss.security_ies);
+        if (ies_auth != son::wireless_utils::eAdditionalAuth::NONE) {
+            bss.additional_auth = ies_auth;
+            using EA                = son::wireless_utils::eAdditionalAuth;
+            const uint16_t old_auth = static_cast<uint16_t>(bss.authentication_type);
+            uint16_t new_auth       = old_auth;
+            if (ies_auth == EA::WPA3_PERSONAL_COMPATIBILITY) {
+                new_auth |= static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE);
+                new_auth |= static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
+            }
+            if (new_auth != old_auth) {
+                bss.authentication_type = static_cast<WSC::eWscAuth>(new_auth);
+            }
+            LOG(INFO) << "preload_mrsno_from_uci: iface='" << iface_hint << "' ssid='"
+                      << bss.ssid << "' additional_auth derived from M2 security_ies ("
+                      << bss.security_ies.size() << " bytes) -> " << int(bss.additional_auth);
+        }
+        return; // raw RSN IEs drive hostapd directly; additional_auth now set for UCI persist
+    }
+
+    // Band-aware UCI lookup. On 6 GHz, use only the band-aware SSID lookup to
+    // avoid cross-band leaks (same ifname shared across bands). On 2.4/5 GHz,
+    // fall back to the by-iface lookup for legacy scenarios.
+    son::wireless_utils::sBssInfoConf uci_bss;
+    bool found = false;
+
+    if (!bss.ssid.empty() && bss.freq_band != beerocks::eFreqType::FREQ_UNKNOWN) {
+        found = beerocks::bpl::bpl_cfg_get_wifi_credentials_by_ssid_and_band(
+            bss.ssid, bss.freq_band, uci_bss);
+    }
+    if (!found && !iface_hint.empty() &&
+        bss.freq_band != beerocks::eFreqType::FREQ_6G) {
+        // Legacy fallback: by-iface lookup (2.4/5 GHz only; 6 GHz skips to
+        // avoid cross-band leaks when the same ifname is shared across bands).
+        found = beerocks::bpl::bpl_cfg_get_wifi_credentials(iface_hint, uci_bss);
+    }
+    if (!found ||
+        uci_bss.additional_auth == son::wireless_utils::eAdditionalAuth::NONE) {
+        return;
+    }
+
+    bss.additional_auth = uci_bss.additional_auth;
+
+    // Copy the SecurityIEs blob built from UCI rsn_override_* options so
+    // assign_auth_encr_parameters() takes the apply_rsn_from_security_ies() path
+    // and writes the six rsn_override_* keys into hostapd.conf.
+    if (bss.security_ies.empty() && !uci_bss.security_ies.empty()) {
+        bss.security_ies = uci_bss.security_ies;
+        LOG(INFO) << "preload_mrsno_from_uci: iface='" << iface_hint << "' ssid='" << bss.ssid
+                  << "' copied SecurityIEs blob (" << bss.security_ies.size()
+                  << " bytes) from UCI so hostapd.conf retains rsn_override_* keys";
+    }
+
+    using EA = son::wireless_utils::eAdditionalAuth;
+    const uint16_t old_auth = static_cast<uint16_t>(bss.authentication_type);
+    uint16_t new_auth       = old_auth;
+    if (bss.additional_auth == EA::WPA3_PERSONAL_COMPATIBILITY) {
+        new_auth |= static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE);
+        new_auth |= static_cast<uint16_t>(WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
+    }
+    if (new_auth != old_auth) {
+        bss.authentication_type = static_cast<WSC::eWscAuth>(new_auth);
+    }
+
+    LOG(INFO) << "preload_mrsno_from_uci: iface='" << iface_hint
+              << "' ssid='" << bss.ssid
+              << "' -> additional_auth=" << int(bss.additional_auth)
+              << " authentication_type: 0x" << std::hex << old_auth
+              << " -> 0x" << new_auth << std::dec
+              << " security_ies_len=" << bss.security_ies.size();
+}
