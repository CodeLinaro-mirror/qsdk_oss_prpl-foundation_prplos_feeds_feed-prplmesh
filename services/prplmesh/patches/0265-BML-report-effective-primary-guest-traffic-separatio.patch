+uint16_t db::get_traffic_separation_primary_vid(const sMacAddr &al_mac)
+{
+    auto default_8021q_config = get_default_8021q_setting(al_mac);
+    if (default_8021q_config.primary_vlan_id != 0) {
+        return default_8021q_config.primary_vlan_id;
+    }
+
+    // No explicit Default 802.1Q setting - check the per-SSID traffic separation policy
+    // (if any) for a non-guest SSID's VLAN ID.
+    for (const auto &ts_ssid : get_traffic_separation_configuration(al_mac)) {
+        for (const auto &bss_info : get_bss_info_configuration(al_mac)) {
+            if (bss_info.ssid == ts_ssid.ssid && bss_info.vap_type != eVapType::GUEST) {
+                return ts_ssid.vlan_id;
+            }
+        }
+    }
+
+    // Still nothing known - fall back to the controller's configured PrivateVID, matching
+    // the custom traffic separation fallback used when generating the outgoing TLV (see
+    // agent_monitoring_task::add_traffic_separation_policy_tlv).
+    bool is_custom_ts_enabled = false;
+    if (!bpl::cfg_get_is_traffic_separation_enabled(is_custom_ts_enabled) ||
+        !is_custom_ts_enabled) {
+        return 0;
+    }
+
+    // Valid VLAN ID range for traffic separation.
+    constexpr int MIN_TS_VID = 1;
+    constexpr int MAX_TS_VID = 4094;
+
+    int private_vid = bpl::DEFAULT_PRIVATE_VLAN_ID;
+    if (!bpl::cfg_get_traffic_separation_private_vid(private_vid) || private_vid < MIN_TS_VID ||
+        private_vid > MAX_TS_VID) {
+        private_vid = bpl::DEFAULT_PRIVATE_VLAN_ID;
+    }
+
+    return static_cast<uint16_t>(private_vid);
+}
+
+uint16_t db::get_traffic_separation_guest_vid(const sMacAddr &al_mac)
+{
+    // Check the per-SSID traffic separation policy (if any) for a GUEST SSID's VLAN ID.
+    for (const auto &ts_ssid : get_traffic_separation_configuration(al_mac)) {
+        for (const auto &bss_info : get_bss_info_configuration(al_mac)) {
+            if (bss_info.ssid == ts_ssid.ssid && bss_info.vap_type == eVapType::GUEST) {
+                return ts_ssid.vlan_id;
+            }
+        }
+    }
+
+    // No real per-SSID policy - fall back to the controller's configured GuestVID, only if
+    // custom traffic separation is actually enabled.
+    bool is_custom_ts_enabled = false;
+    if (!bpl::cfg_get_is_traffic_separation_enabled(is_custom_ts_enabled) ||
+        !is_custom_ts_enabled) {
+        return 0;
+    }
+
+    int guest_vid = 0;
+    if (!bpl::cfg_get_traffic_separation_guest_vid(guest_vid)) {
+        return 0;
+    }
+
+    // Valid VLAN ID range for traffic separation.
+    constexpr int MIN_TS_VID = 1;
+    constexpr int MAX_TS_VID = 4094;
+
+    if (guest_vid < MIN_TS_VID || guest_vid > MAX_TS_VID) {
+        return 0;
+    }
+
+    return static_cast<uint16_t>(guest_vid);
+}
