+                // BANDWIDTH_320_2 variant. Some channels (e.g. 33) fall in the overlap of both
+                // blocks, so radio->wifi_channel stores the generic BANDWIDTH_320 and the actual
+                // block in use must be disambiguated by the radio's real center frequency
+                if (bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320) {
+                    auto center_channel_of_current_freq =
+                        son::wireless_utils::freq_to_channel(radio->wifi_channel.get_center_frequency());
+
+                    LOG(DEBUG) << "[BW320_DBG] create_operating_channel_report: opclass=" << int(*it)
+                               << " channel=" << radio->wifi_channel.get_channel()
+                               << " center_frequency=" << radio->wifi_channel.get_center_frequency()
+                               << " center_channel_of_current_freq=" << center_channel_of_current_freq;
+
+                    auto bw320_1_it = channel_it->second.find(beerocks::eWiFiBandwidth::BANDWIDTH_320_1);
+                    auto bw320_2_it = channel_it->second.find(beerocks::eWiFiBandwidth::BANDWIDTH_320_2);
+                    if (bw320_1_it != channel_it->second.end() &&
+                        bw320_1_it->second.center_channel == center_channel_of_current_freq) {
+                        bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_1;
+                    } else if (bw320_2_it != channel_it->second.end() &&
+                              bw320_2_it->second.center_channel == center_channel_of_current_freq) {
+                        bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_2;
+                    } else if (bw320_1_it != channel_it->second.end()) {
+                        // Fallback: current center frequency didn't match either candidate
+                        // (e.g. not yet refreshed) - keep prior best-effort behavior.
+                        LOG(WARNING) << "[BW320_DBG] create_operating_channel_report: channel="
+                                     << radio->wifi_channel.get_channel()
+                                     << " center_channel_of_current_freq="
+                                     << center_channel_of_current_freq
+                                     << " matched neither BANDWIDTH_320_1 nor BANDWIDTH_320_2"
+                                        " center channel - defaulting to BANDWIDTH_320_1";
+                        bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_1;
+                    } else if (bw320_2_it != channel_it->second.end()) {
+                        bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_2;
+                    }
+                }
+
                 auto center_channel_it = channel_it->second.find(bandwidth);
                 if (center_channel_it == channel_it->second.end()) {
                     LOG(ERROR) << "Failed find bandwidth of channel "
