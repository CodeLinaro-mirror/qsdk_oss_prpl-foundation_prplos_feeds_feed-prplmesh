From 4a7dd49a091f362718c89870ef653dca145326bc Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Fri, 22 May 2026 14:37:03 +0530
Subject: [PATCH] MAP R6.1: Set the EnableUnicast flag in
 beerocks_controller.conf

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../beerocks/bcl/include/bcl/beerocks_config_file.h |  2 ++
 common/beerocks/bcl/source/beerocks_config_file.cpp |  1 +
 controller/config/beerocks_controller.conf.in       |  3 +++
 .../src/beerocks/master/beerocks_master_main.cpp    |  9 +++------
 framework/platform/bpl/cfg/dm/bpl_cfg.cpp           |  6 ------
 framework/platform/bpl/cfg/linux/bpl_cfg.cpp        |  6 ------
 framework/platform/bpl/cfg/rdk/bpl_cfg.cpp          |  6 ------
 framework/platform/bpl/cfg/uci/bpl_cfg.cpp          | 13 -------------
 framework/platform/bpl/include/bpl/bpl_cfg.h        | 11 -----------
 9 files changed, 9 insertions(+), 48 deletions(-)

diff --git a/common/beerocks/bcl/include/bcl/beerocks_config_file.h b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
index 6c5029a..60cf946 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_config_file.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_config_file.h
@@ -54,6 +54,8 @@ public:
         std::string smd_ptk_mode[MAX_SMD_PROFILES];
         std::string smd_type[MAX_SMD_PROFILES];
         std::string smd_default_dl_drain_time[MAX_SMD_PROFILES];
+        //Enable Unicast Renew
+        std::string enable_unicast_renew;
         std::string load_service_fairness;
         std::string load_backhaul_measurements;
         std::string load_front_measurements;
diff --git a/common/beerocks/bcl/source/beerocks_config_file.cpp b/common/beerocks/bcl/source/beerocks_config_file.cpp
index 98b2c51..d0a6fc2 100644
--- a/common/beerocks/bcl/source/beerocks_config_file.cpp
+++ b/common/beerocks/bcl/source/beerocks_config_file.cpp
@@ -55,6 +55,7 @@ bool config_file::read_master_config_file(const std::string &config_file_path, s
                         mandatory_master),
         std::make_tuple("enable_smd=", &conf.enable_smd, 0),
         std::make_tuple("smd_profile_count=", &conf.smd_profile_count, 0),
+        std::make_tuple("enable_unicast_renew=", &conf.enable_unicast_renew, 0),
         std::make_tuple("load_service_fairness=", &conf.load_service_fairness, mandatory_master),
         std::make_tuple("load_backhaul_measurements=", &conf.load_backhaul_measurements, 0),
         std::make_tuple("load_front_measurements=", &conf.load_front_measurements, 0),
diff --git a/controller/config/beerocks_controller.conf.in b/controller/config/beerocks_controller.conf.in
index 97f78f2..3dc04ce 100644
--- a/controller/config/beerocks_controller.conf.in
+++ b/controller/config/beerocks_controller.conf.in
@@ -42,6 +42,9 @@ load_monitor_on_vaps=1
 #   service fairness feature:
 load_service_fairness=0
 
+#    Enable Unicast Renew
+enable_unicast_renew=0 # 0 - disabled, 1 - enabled
+
 # Config Parameters
 ire_rssi_report_rate_sec=30
 global_restricted_channels=
diff --git a/controller/src/beerocks/master/beerocks_master_main.cpp b/controller/src/beerocks/master/beerocks_master_main.cpp
index 74357db..9981f45 100644
--- a/controller/src/beerocks/master/beerocks_master_main.cpp
+++ b/controller/src/beerocks/master/beerocks_master_main.cpp
@@ -222,6 +222,9 @@ static void fill_master_config(son::db::sDbMasterConfig &master_conf,
             master_conf.smd_profiles.push_back(profile);
         }
     }
+
+    master_conf.enable_unicast_renew = (main_master_conf.enable_unicast_renew == "1");
+
     master_conf.load_backhaul_measurements = (main_master_conf.load_backhaul_measurements == "1");
     master_conf.load_front_measurements    = (main_master_conf.load_front_measurements == "1");
     master_conf.load_monitor_on_vaps       = (main_master_conf.load_monitor_on_vaps == "1");
@@ -625,12 +628,6 @@ static void fill_master_config(son::db::sDbMasterConfig &master_conf,
                    << beerocks::bpl::DEFAULT_DAISY_CHAINING_DISABLED;
         master_conf.daisy_chaining_disabled = beerocks::bpl::DEFAULT_DAISY_CHAINING_DISABLED;
     }
-
-    if (!beerocks::bpl::cfg_get_enable_unicast_renew(master_conf.enable_unicast_renew)) {
-        LOG(DEBUG) << "Failed to read EnableUnicastRenew, setting to default value: "
-                   << beerocks::bpl::DEFAULT_ENABLE_UNICAST_RENEW;
-        master_conf.enable_unicast_renew = beerocks::bpl::DEFAULT_ENABLE_UNICAST_RENEW;
-    }
 }
 
 #ifdef ENABLE_NBAPI
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
index ba73347..a10c107 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
@@ -629,12 +629,6 @@ bool cfg_get_traffic_separation_persistence_enabled(bool &enabled)
     return true;
 }
 
-bool cfg_get_enable_unicast_renew(bool &enabled)
-{
-    enabled = DEFAULT_ENABLE_UNICAST_RENEW;
-    return true;
-}
-
 bool cfg_persist_iface_bridge_assignment(const std::string & /*bridge*/,
                                          const std::string & /*iface*/)
 {
diff --git a/framework/platform/bpl/cfg/linux/bpl_cfg.cpp b/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
index ddcf049..ff804ab 100644
--- a/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
@@ -1009,12 +1009,6 @@ bool cfg_get_traffic_separation_persistence_enabled(bool &enabled)
     return true;
 }
 
-bool cfg_get_enable_unicast_renew(bool &enabled)
-{
-    enabled = DEFAULT_ENABLE_UNICAST_RENEW;
-    return true;
-}
-
 bool cfg_persist_iface_bridge_assignment(const std::string & /*bridge*/,
                                          const std::string & /*iface*/)
 {
diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
index c850ab4..33d7ac7 100644
--- a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
@@ -1304,12 +1304,6 @@ bool cfg_get_traffic_separation_persistence_enabled(bool &enabled)
     return true;
 }
 
-bool cfg_get_enable_unicast_renew(bool &enabled)
-{
-    enabled = DEFAULT_ENABLE_UNICAST_RENEW;
-    return true;
-}
-
 bool cfg_get_bridge_for_iface(const std::string &iface, std::string &bridge_name)
 {
     (void)iface;
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
index 8f08245..264f82d 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg.cpp
@@ -1201,19 +1201,6 @@ bool cfg_get_traffic_separation_persistence_enabled(bool &enabled)
     return true;
 }
 
-bool cfg_get_enable_unicast_renew(bool &enabled)
-{
-    int retVal = -1;
-
-    if (cfg_get_prplmesh_param_int_default("EnableUnicastRenew", &retVal, 0) == RETURN_ERR) {
-        MAPF_DBG("Failed to read EnableUnicastRenew, using default=0");
-        enabled = DEFAULT_ENABLE_UNICAST_RENEW;
-        return true;
-    }
-    enabled = (retVal != 0);
-    return true;
-}
-
 bool cfg_persist_iface_bridge_assignment(const std::string &bridge, const std::string &iface)
 {
     // Find the UCI network device section whose 'name' option matches the bridge.
diff --git a/framework/platform/bpl/include/bpl/bpl_cfg.h b/framework/platform/bpl/include/bpl/bpl_cfg.h
index 86b7d83..0dc46a1 100644
--- a/framework/platform/bpl/include/bpl/bpl_cfg.h
+++ b/framework/platform/bpl/include/bpl/bpl_cfg.h
@@ -1427,17 +1427,6 @@ bool cfg_get_traffic_separation_bridge_mapping_enabled(bool &enabled);
  */
 bool cfg_get_traffic_separation_persistence_enabled(bool &enabled);
 
-/**
- * @brief Get EnableUnicastRenew flag from UCI.
- *
- * Reads `EnableUnicastRenew` from prplmesh UCI config.
- * When enabled, unicast AP-Autoconfiguration Renew messages are sent to all
- * known agent ALIDs in addition to the multicast renew.
- *
- * @param[out] enabled true if unicast renew is enabled.
- * @return true on success, false on failure.
- */
-bool cfg_get_enable_unicast_renew(bool &enabled);
 
 /**
  * @brief Persist an interface's bridge assignment in the network UCI config.
-- 
2.34.1

