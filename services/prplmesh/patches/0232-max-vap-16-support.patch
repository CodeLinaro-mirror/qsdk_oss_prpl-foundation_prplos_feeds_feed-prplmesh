From 58f67c9d409fd365b5115df66eee86789f2c20d3 Mon Sep 17 00:00:00 2001
From: Muhassina Alliyengal <malliyen@qti.qualcomm.com>
Date: Tue, 23 Jun 2026 11:03:42 +0530
Subject: [PATCH] max-vap-16-support

Signed-off-by: Muhassina Alliyengal <malliyen@qti.qualcomm.com>
---
 common/beerocks/bcl/include/bcl/beerocks_defines.h              | 2 +-
 .../include/mapf/transport/ieee1905_transport_messages.h        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bcl/include/bcl/beerocks_defines.h b/common/beerocks/bcl/include/bcl/beerocks_defines.h
index 054d082..9375d6e 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_defines.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_defines.h
@@ -157,7 +157,7 @@ enum eMLOModes : uint8_t {
 enum eMessageConsts {
     MESSAGE_VERSION       = 6,
     MESSAGE_MAGIC         = 0x55CDABEF,
-    MESSAGE_BUFFER_LENGTH = 8192,
+    MESSAGE_BUFFER_LENGTH = 16384,  // 16KB: doubled from 8KB to support up to 16 VAPs
 };
 } //namespace message
 
diff --git a/framework/transport/ieee1905_transport/include/mapf/transport/ieee1905_transport_messages.h b/framework/transport/ieee1905_transport/include/mapf/transport/ieee1905_transport_messages.h
index 3b753c1..1742ef7 100644
--- a/framework/transport/ieee1905_transport/include/mapf/transport/ieee1905_transport_messages.h
+++ b/framework/transport/ieee1905_transport/include/mapf/transport/ieee1905_transport_messages.h
@@ -69,7 +69,7 @@ inline std::ostream &operator<<(std::ostream &out, Type value) { return out << T
 class Message {
 public:
     static constexpr uint32_t kMessageMagic   = 0xB8C16F47;
-    static constexpr uint32_t kMaxFrameLength = 8192;
+    static constexpr uint32_t kMaxFrameLength = 16384;  //16KB: must match MESSAGE_BUFFER_LENGTH in beerocks_defines.h
 
     class Frame {
     public:
