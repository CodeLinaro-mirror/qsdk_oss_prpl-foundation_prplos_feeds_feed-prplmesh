+void ApAutoConfigurationTask::start_next_sequential_radio()
+{
+    auto db = AgentDB::get();
+    if (!db->device_conf.sequential_ap_autoconfig) {
+        return;
+    }
+
+    for (const auto &radio_iface : m_sequential_radio_order) {
+        auto conf_it = m_radios_conf_params.find(radio_iface);
+        if (conf_it == m_radios_conf_params.end() ||
+            conf_it->second.state != eState::UNCONFIGURED) {
+            continue;
+        }
+
+        m_sequential_active_radio = radio_iface;
+        LOG(INFO) << "Sequential AP autoconfiguration: starting radio " << radio_iface;
+        FSM_MOVE_STATE(radio_iface, eState::CONTROLLER_DISCOVERY);
+        m_task_is_active = true;
+        return;
+    }
+
+    LOG(DEBUG) << "Sequential AP autoconfiguration: all radios completed";
+    m_sequential_active_radio.clear();
+}
