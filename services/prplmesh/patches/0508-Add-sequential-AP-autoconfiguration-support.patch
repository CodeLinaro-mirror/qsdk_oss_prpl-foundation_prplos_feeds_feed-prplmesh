@@ -194,6 +194,10 @@ public:
         bool is_multiap_profile_1_as_of_r4 = false;
         int dwell_time;
         bool send_btm_to_non_11v_sta = false;
+        // Serialize AP-Autoconfiguration per radio for legacy-controller interoperability.
+        bool sequential_ap_autoconfig = false;
+        // Enable QCOM-controller interoperability for AP-Autoconfiguration Search.
+        bool interop_with_qcomcontroller = false;
         /**
          * RSN Overriding capability advertise.
          *
