         db->device_conf.send_btm_to_non_11v_sta = send_btm_to_non_11v_sta;
 
+        // sequential_ap_autoconfig: serialize Search/M1/M2 onboarding per radio.
+        // The default remains parallel for current controllers.
+        if (beerocks_slave_conf.sequential_ap_autoconfig.empty() ||
+            beerocks_slave_conf.sequential_ap_autoconfig == "0") {
+            db->device_conf.sequential_ap_autoconfig = false;
+        } else if (beerocks_slave_conf.sequential_ap_autoconfig == "1") {
+            db->device_conf.sequential_ap_autoconfig = true;
+        } else {
+            LOG(WARNING) << "Invalid sequential_ap_autoconfig value '"
+                         << beerocks_slave_conf.sequential_ap_autoconfig
+                         << "'. Expected 0 or 1. Treating as 0.";
+            db->device_conf.sequential_ap_autoconfig = false;
+        }
+        LOG(INFO) << "Set sequential_ap_autoconfig to: "
+                  << db->device_conf.sequential_ap_autoconfig;
+
+        // interop_with_qcomcontroller: enable QCOM-controller interoperability.
+        // Empty / "0" -> disabled; "1" -> enabled. Invalid values are disabled.
+        if (beerocks_slave_conf.interop_with_qcomcontroller.empty() ||
+            beerocks_slave_conf.interop_with_qcomcontroller == "0") {
+            db->device_conf.interop_with_qcomcontroller = false;
+        } else if (beerocks_slave_conf.interop_with_qcomcontroller == "1") {
+            db->device_conf.interop_with_qcomcontroller = true;
+        } else {
+            LOG(WARNING) << "Invalid interop_with_qcomcontroller value '"
+                         << beerocks_slave_conf.interop_with_qcomcontroller
+                         << "'. Expected 0 or 1. Treating as 0.";
+            db->device_conf.interop_with_qcomcontroller = false;
