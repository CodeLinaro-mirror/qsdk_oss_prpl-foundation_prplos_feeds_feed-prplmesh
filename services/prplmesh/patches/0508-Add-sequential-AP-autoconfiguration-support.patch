From fd6e8abdda10ab962e3df5f50169019db5900205 Mon Sep 17 00:00:00 2001
From: Muthuchamy Kumar <muthucha@qti.qualcomm.com>
Date: Thu, 8 Oct 2026 00:09:33 +0530
Subject: [PATCH] Add sequential AP autoconfiguration and QCOM controller
 interop

- Add sequential_ap_autoconfig to serialize AP Search, WSC M1/M2, and
  configuration completion per radio.
- Coordinate radio ordering, retries, renewals, MLD updates, and timeout
  recovery in sequential mode.
- Add interop_with_qcomcontroller to omit EM_AP_AGENT and advertise the
  legacy MAP profile when enabled.
- Preserve existing parallel onboarding and normal service advertisement
  by default.

Signed-off-by: Muthuchamy Kumar <muthucha@qti.qualcomm.com>
---
 agent/config/beerocks_agent.conf.in           |  12 +
 agent/src/beerocks/slave/agent_db.h           |   4 +
 .../beerocks/slave/beerocks_agent_main.cpp    |  32 +++
 .../slave/tasks/ap_autoconfiguration_task.cpp | 213 +++++++++++++++---
 .../slave/tasks/ap_autoconfiguration_task.h   |   7 +
 .../slave/tasks/capability_reporting_task.cpp |  11 +-
 .../bcl/include/bcl/beerocks_config_file.h    |   2 +
 .../bcl/source/beerocks_config_file.cpp       |   2 +
 8 files changed, 253 insertions(+), 30 deletions(-)

diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index 161104996..6fdb28b67 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -128,6 +128,18 @@ clients_unicast_measurements=0
 # send_btm_to_non_11v_sta = 1 -> Allow sending BTM requests to STAs even if they do not support 802.11v
 send_btm_to_non_11v_sta=1
 
+# sequential_ap_autoconfig: serialize AP-Autoconfiguration per radio/band.
+# 0 = parallel onboarding (default)
+# 1 = Search -> Response -> Early AP Capability -> M1 -> M2/configuration-complete
+#     for one radio before starting the next radio. Enable for legacy controllers
+#     that cannot safely handle parallel cloning sessions (for example 13.1).
+sequential_ap_autoconfig=0
+
+# interop_with_qcomcontroller: enable interoperability with QCOM controllers.
+# 0 = normal service/profile advertisement (default)
+# 1 = omit EM_AP_AGENT and advertise the legacy MAP profile override.
+interop_with_qcomcontroller=0
+
 # rsn_overriding_supported: Advertise RSN_Overriding = 1 in the AP Capability TLV
 # (Wi-Fi EasyMesh v6.1 sections 17.2.6, 9.1 and 7.1).
 # When set to 1, the Agent tells the Controller that it understands the special
