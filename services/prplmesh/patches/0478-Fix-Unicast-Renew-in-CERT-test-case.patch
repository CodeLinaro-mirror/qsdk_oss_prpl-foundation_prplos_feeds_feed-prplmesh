From a92b2b0a08e6cb68dd5af2192364254969bc75c8 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Wed, 30 Sep 2026 20:55:35 +0530
Subject: [PATCH] Fix Unicast Renew in CERT test case

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../bcl/source/beerocks_ucc_listener.cpp      | 42 ++++++++++++-------
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 16 +++----
 2 files changed, 35 insertions(+), 23 deletions(-)

diff --git a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
index 1d443fe..3c013eb 100644
--- a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
+++ b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
@@ -612,16 +612,36 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
         auto message_type =
             static_cast<uint16_t>(std::strtoul(message_type_str.c_str(), nullptr, 16));
 
-        // Per IEEE 1905.1 specification, AP-Autoconfiguration Renew messages (type 0x000A)
-        // must be sent to the IEEE 1905.1 multicast address (01:80:c2:00:00:13), not to the
-        // unicast AL-MAC address provided in DestALid.
+        // The optional TransmissionType param selects how the CMDU is transmitted. It is parsed
+        // once here because it governs both the destination address and the relay_indicator flag.
+        bool is_unicast_tx = false;
+        auto tx_type_it    = params.find("transmissiontype");
+        if (tx_type_it != params.end()) {
+            std::string tx_type = tx_type_it->second;
+            std::transform(tx_type.begin(), tx_type.end(), tx_type.begin(), ::tolower);
+            is_unicast_tx = (tx_type == "unicast");
+        }
+
+        LOG(DEBUG) << "DEV_SEND_1905 message_type=0x" << message_type_str
+                   << " transmissiontype='"
+                   << (tx_type_it != params.end() ? tx_type_it->second : std::string("<absent>"))
+                   << "' is_unicast_tx=" << is_unicast_tx << " destalid=" << dest_alid;
+
+        // Per IEEE 1905.1 specification, AP-Autoconfiguration Renew messages (type 0x000A) are
+        // relayed multicast messages and are therefore sent to the IEEE 1905.1 multicast address
+        // (01:80:c2:00:00:13) rather than the unicast AL-MAC address provided in DestALid. When
+        // the command explicitly requests a unicast transmission, honour DestALid instead.
         if (ieee1905_1::eMessageType(message_type) ==
-            ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE) {
+                ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE &&
+            !is_unicast_tx) {
             LOG(DEBUG) << "AP-Autoconfiguration Renew: overriding destination from " << dest_alid
                        << " to IEEE 1905.1 multicast address (01:80:c2:00:00:13)";
             dest_alid = "01:80:c2:00:00:13";
         }
 
+        LOG(DEBUG) << "final destalid=" << dest_alid
+                   << " (unicast_requested=" << is_unicast_tx << ")";
+
         if (!ieee1905_1::eMessageTypeValidate::check(message_type)) {
             err_string = "invalid param value '" + message_type_str +
                          "' for param name 'MessageTypeValue', message type not found";
@@ -640,19 +660,11 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
 
         // Helper lambda: clear relay_indicator for unicast transmission
         auto apply_unicast_relay_flag = [&](std::shared_ptr<ieee1905_1::cCmduHeader> hdr) {
-            if (!hdr) {
+            if (!hdr || !is_unicast_tx) {
                 return;
             }
-            auto it = params.find("transmissiontype");
-            if (it == params.end()) {
-                return;
-            }
-            std::string tx_type = it->second;
-            std::transform(tx_type.begin(), tx_type.end(), tx_type.begin(), ::tolower);
-            if (tx_type == "unicast") {
-                LOG(DEBUG) << "Unicast TransmissionType: clearing relay_indicator";
-                hdr->flags().relay_indicator = 0;
-            }
+            LOG(DEBUG) << "Unicast TransmissionType: clearing relay_indicator";
+            hdr->flags().relay_indicator = 0;
         };
 
         // Check if CMDU message type has prepared CMDU which can be loaded
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index c3a7955..42778f5 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -431,7 +431,7 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
             return static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_SAE|WSC::eWscAuth::WSC_AUTH_WPA2PSK);
         } else if ("akm24-sae-mixed" == encryption) {
             return static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_SAE|WSC::eWscAuth::WSC_AUTH_WPA2PSK|WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
-        } else if ("sae-sae_ext_key" == encryption) {
+        } else if ("sae-sae-ext-key" == encryption) {
             return static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_SAE|WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
         } else if ("sae-ext-key" == encryption) {
             return static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
@@ -448,7 +448,7 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
         } else if (("psk2" == encryption) || ("sae" == encryption) ||
                    contains("+aes", encryption) || contains("+ccmp", encryption) || ("sae-mixed" == encryption)) {
             return WSC::eWscEncr::WSC_ENCR_AES;
-        } else if (("akm24-sae-mixed" == encryption) || ("sae-sae_ext_key" == encryption) || ("sae-ext-key" == encryption)) {
+        } else if (("akm24-sae-mixed" == encryption) || ("sae-sae-ext-key" == encryption) || ("sae-ext-key" == encryption)) {
             return WSC::eWscEncr::WSC_ENCR_AES;
         }
         return WSC::eWscEncr::WSC_ENCR_INVALID;
@@ -1248,7 +1248,7 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
                 if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
                     encryption = "akm24-sae-mixed";  // 2.4/5GHz: WPA2-PSK + SAE + SAE-EXT-KEY
                 } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
-                    encryption = "sae-sae_ext_key";  // Both 2.4/5GHz and 6GHz
+                    encryption = "sae-sae-ext-key";  // Both 2.4/5GHz and 6GHz
                 } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
                     // Auth Type 15 (AKM_24): WPA2-PSK + SAE-EXT-KEY
                     if (freq_band == beerocks::eFreqType::FREQ_6G) {
@@ -1299,7 +1299,7 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
         }
         if (options["encryption"] == "sae-mixed" || 
             options["encryption"] == "sae-ext-key" || 
-            options["encryption"] == "sae-sae_ext_key" || 
+            options["encryption"] == "sae-sae-ext-key" ||
             options["encryption"] == "akm24-sae-mixed") {
             options["sae_pwe"] = "2";  
         }
@@ -1617,7 +1617,7 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
                 if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
                     encryption = "akm24-sae-mixed";  // 2.4/5GHz: WPA2-PSK + SAE + SAE-EXT-KEY
                 } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
-                    encryption = "sae-sae_ext_key";  // Both 2.4/5GHz and 6GHz
+                    encryption = "sae-sae-ext-key";  // Both 2.4/5GHz and 6GHz
                 } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
                     // Auth Type 15 (AKM_24): WPA2-PSK + SAE-EXT-KEY
                     if (freq_band == beerocks::eFreqType::FREQ_6G) {
@@ -1695,7 +1695,7 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             }
             if (options["encryption"] == "sae-mixed" || 
                 options["encryption"] == "sae-ext-key" || 
-                options["encryption"] == "sae-sae_ext_key" || 
+                options["encryption"] == "sae-sae-ext-key" ||
                 options["encryption"] == "akm24-sae-mixed") {
                 options["sae_pwe"] = "2";  
             }
@@ -3057,7 +3057,7 @@ static std::string get_encryption_string(WSC::eWscAuth authentication_type,
         encryption = "akm24-sae-mixed";
     } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE |
                                        WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
-        encryption = "sae-sae_ext_key";
+        encryption = "sae-sae-ext-key";
     } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_WPA2PSK |
                                        WSC::eWscAuth::WSC_AUTH_SAE_AKM24)) {
         encryption = "psk2+gcmp-256";
@@ -3149,7 +3149,7 @@ bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
     }
     if (options["encryption"] == "sae-mixed" || 
         options["encryption"] == "sae-ext-key" || 
-        options["encryption"] == "sae-sae_ext_key" || 
+        options["encryption"] == "sae-sae-ext-key" ||
         options["encryption"] == "akm24-sae-mixed") {
         options["sae_pwe"] = "2";  
     }
-- 
2.34.1

