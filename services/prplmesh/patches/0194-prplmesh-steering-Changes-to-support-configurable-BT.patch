Date: Thu, 4 Jun 2026 21:12:20 +0530
Subject: [PATCH] steering: Changes to support configurable BTM parameters

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 agent/config/beerocks_agent.conf.in           | 12 +++++++++
 .../beerocks/fronthaul_manager/CMakeLists.txt | 11 ++++++++
 .../ap_manager/ap_manager.cpp                 | 25 ++++++++++++++++++-
 agent/src/beerocks/slave/agent_db.cpp         | 15 +++++++----
 agent/src/beerocks/slave/agent_db.h           | 15 +++++++++--
 .../beerocks/slave/beerocks_agent_main.cpp    | 14 +++++++++++
 agent/src/beerocks/slave/son_slave_thread.cpp | 25 ++++++++++++++++++-
 .../bcl/include/bcl/beerocks_config_file.h    |  2 ++
 .../bcl/source/beerocks_config_file.cpp       |  2 ++
 .../beerocks/bwl/dwpal/mon_wlan_hal_dwpal.cpp |  6 +++++
 .../bwl/dwpald/mon_wlan_hal_dwpald.cpp        |  6 +++++
 .../bwl/nl80211/mon_wlan_hal_nl80211.cpp      |  6 +++++
 12 files changed, 130 insertions(+), 9 deletions(-)

diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index 1f3a03dcc..3d3ecbbd1 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -70,6 +70,18 @@ send_btm_to_non_11v_sta=1
 # beacon_11k_default_measurement_mode = BEACON_MEASUREMENT_MODE_TABLE (2) -> Beacon Table measurement mode (default)
 beacon_11k_default_measurement_mode=2
 
+# btm_abridged: BTM Request Abridged bit for agent-initiated steering (CLIENT_BSS_STEER path).
+# btm_abridged = 0 -> Clear Abridged bit (STA may consider all BSSes, not just the neighbor list)
+# btm_abridged = 1 -> Set Abridged bit (STA only considers BSSes in the neighbor list) (default)
+# Note: This setting does NOT affect MAP controller-driven steering (values come from the controller TLV).
+btm_abridged=1
+
+# btm_disassoc_imminent: BTM Request Disassociation Imminent bit for agent-initiated steering.
+# btm_disassoc_imminent = 0 -> Disassociation Imminent bit NOT set (STA may choose to stay)
+# btm_disassoc_imminent = 1 -> Set Disassociation Imminent bit (AP will disassociate STA if it does not roam) (default)
+# Note: This setting does NOT affect MAP controller-driven steering (values come from the controller TLV).
+btm_disassoc_imminent=1
+
 [backhaul]
 backhaul_preferred_bssid=
 
diff --git a/agent/src/beerocks/fronthaul_manager/CMakeLists.txt b/agent/src/beerocks/fronthaul_manager/CMakeLists.txt
index 0ed113c31..0332da61b 100644
--- a/agent/src/beerocks/fronthaul_manager/CMakeLists.txt
+++ b/agent/src/beerocks/fronthaul_manager/CMakeLists.txt
@@ -40,5 +40,16 @@ add_executable(${PROJECT_NAME} ${fronthaul_manager_sources})
 set_target_properties(${PROJECT_NAME} PROPERTIES LINK_FLAGS "-Wl,-z,defs")
 target_link_libraries(${PROJECT_NAME} bcl btlvf rt dl tlvf elpp bwl mapfcommon bpl ${LIBS})
 
+# agent_db.h (included via slave/) needs framework/platform/nbapi/include for
+# ambiorix_impl.h (ENABLE_NBAPI=ON) or ambiorix_dummy.h (ENABLE_NBAPI=OFF).
+# beerocks_fronthaul does not link nbapi so add the path explicitly in both cases.
+target_include_directories(${PROJECT_NAME}
+    PRIVATE
+        ${CMAKE_SOURCE_DIR}/framework/platform/nbapi/include
+)
+if (ENABLE_NBAPI)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DENABLE_NBAPI")
+endif()
+
 # Install
 install(TARGETS ${PROJECT_NAME} DESTINATION ${CMAKE_INSTALL_BINDIR})
