+                           << " (iface=" << actual_radio->front.iface_name << ")";
+                radio = actual_radio;
+                request_out->params().cur_bssid = sta_info.associated_link_mac;
+            } else {
+                LOG(ERROR) << "BTM Steering MLO: cannot resolve radio for actual link "
