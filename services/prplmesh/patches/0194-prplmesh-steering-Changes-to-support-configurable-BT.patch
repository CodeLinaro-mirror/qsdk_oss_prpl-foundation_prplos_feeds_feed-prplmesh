@@ -6356,6 +6357,28 @@ bool slave_thread::handle_client_steering_request(ieee1905_1::CmduMessageRx &cmd
         request_out->params().mac       = sta_mac;
         request_out->params().cur_bssid = source_bssid;
 
+        // For MLO clients where the controller's source_bssid is a partner link
+        // (is_partner=true), the BTM request must be sent via the ap_manager that
+        // owns the actual associated link, not the partner link.  Re-resolve radio
+        // and cur_bssid to the actual link so the correct ap_manager receives the
+        // message and sends BSS_TM_REQ on the right interface.
+        if (sta_info.is_mld_client_association && sta_info.is_requested_bssid_mld_partner &&
+            sta_info.associated_link_mac != source_bssid) {
+            auto actual_radio =
+                db->get_radio_by_mac(sta_info.associated_link_mac, AgentDB::eMacType::BSSID);
+            if (actual_radio) {
+                LOG(DEBUG) << "BTM Steering MLO: redirecting from partner link "
