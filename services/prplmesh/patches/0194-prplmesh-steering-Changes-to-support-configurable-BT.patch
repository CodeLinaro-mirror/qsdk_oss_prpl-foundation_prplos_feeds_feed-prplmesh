--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -9,6 +9,7 @@
 #include "ap_manager.h"
 
 #include <bwl/base_wlan_hal_types.h>
+#include "../../slave/agent_db.h"
 
 #include <bcl/beerocks_string_utils.h>
 #include <bcl/beerocks_utils.h>
@@ -1927,7 +1928,29 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         btm_params.pref_list_included = true; // since a valid target BSSID is always assumed
         btm_params.abridged           = request->params().abridged;
         btm_params.disassoc_imminent  = request->params().disassoc_imminent;
-
+        // DEBUG: override controller TLV abridged/disassoc_imminent with agent config values.
+        // The controller sent abridged=false/disassoc_imminent=false in its TLV; override here
+        // so the same btm_abridged/btm_disassoc_imminent knobs in beerocks_agent.conf apply to
+        // both the controller-driven path and the agent-initiated path.
+        // Remove this block once the controller is updated to send the correct flags.
+        {
+            auto db = beerocks::AgentDB::get();
+            LOG(DEBUG) << "DEBUG BTM flag override: controller sent abridged="
+                       << btm_params.abridged << " disassoc_imminent=" << btm_params.disassoc_imminent
+                       << " -> overriding with agent config: btm_abridged=" << db->device_conf.btm_abridged
+                       << " btm_disassoc_imminent=" << db->device_conf.btm_disassoc_imminent;
+            btm_params.abridged          = db->device_conf.btm_abridged;
+            btm_params.disassoc_imminent = db->device_conf.btm_disassoc_imminent;
+            // Recompute disassoc_timer_btt now that disassoc_imminent may have changed.
+            // The original calculation used the controller's disassoc_imminent (false),
+            // which set disassoc_timer_btt=0. With disassoc_imminent=true we must provide
+            // a non-zero timer so the STA has time to roam before being disassociated.
+            if (btm_params.disassoc_imminent) {
+                float timer_btt = static_cast<float>(request->params().disassoc_timer_ms)
+                                  / static_cast<float>(BEACON_TRANSMIT_TIME_MS);
+                btm_params.disassoc_timer_btt = (timer_btt > 0.0f) ? timer_btt : 10.0f;
+            }
+        }
 
         LOG(DEBUG) << "BTM Params: "
         << "vap_id=" << btm_params.vap_id
