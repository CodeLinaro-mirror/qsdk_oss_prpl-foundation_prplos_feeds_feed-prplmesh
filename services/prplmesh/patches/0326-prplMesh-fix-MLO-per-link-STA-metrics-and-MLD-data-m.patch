+
+    auto bss_agent = database.get_agent_by_bssid(bss->bssid);
+    if (!bss_agent) {
+        // Serving BSS cannot be attributed to an agent - inconclusive.
+        return false;
+    }
+
+    return bss_agent->al_mac != agent_al_mac;
