+ *        @a sta_mld_mac is no longer served by the agent @a agent_al_mac.
+ *
+ * Used to decide whether a STAMLD instance may be pruned on the strength of an
+ * *absent* Associated STA MLD Configuration Report.  Returns false whenever the
+ * database cannot tell, so an inconclusive database never causes a removal.
+ */
+static bool sta_mld_left_agent(son::db &database, const sMacAddr &sta_mld_mac,
+                               const sMacAddr &agent_al_mac)
+{
+    // The STA object is removed on disassociation, so its absence is proof the
+    // client is no longer associated here.
+    auto station = database.get_station(sta_mld_mac);
+    if (!station) {
+        return true;
