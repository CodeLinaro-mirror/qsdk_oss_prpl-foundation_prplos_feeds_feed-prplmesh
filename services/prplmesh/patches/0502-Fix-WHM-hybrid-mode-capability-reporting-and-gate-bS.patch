From 44e7baa7e5d20002b6bc8f948d954d1074a055b1 Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Wed, 7 Oct 2026 17:04:47 +0530
Subject: [PATCH] Fix WHM hybrid mode capability reporting and gate bSTA MLD
 and Backhaul STA topology TLVs based on BH mode

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 |  3 +-
 .../beerocks/slave/tasks/topology_task.cpp    | 37 +++++++++++++++++--
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 438a1f6a1..5b009b006 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -5639,8 +5639,7 @@ void ApManager::handle_hostapd_attached()
                               ap_wlan_hal->get_radio_info().chipset_vendor.c_str(),
                               beerocks::message::CHIPSET_VENDOR_LENGTH);
 
-    notification->params().hybrid_mode_supported =
-        ap_wlan_hal->get_radio_info().traffic_separation_combined_front_back_supported;
+    notification->params().hybrid_mode_supported = ap_wlan_hal->hybrid_mode_supported();
     notification->params().combined_profile1_and_profile2_supported =
         ap_wlan_hal->get_radio_info().traffic_separation_combined_profile1_profile2_supported;
 
diff --git a/agent/src/beerocks/slave/tasks/topology_task.cpp b/agent/src/beerocks/slave/tasks/topology_task.cpp
index 498cd0a51..b389780e1 100644
--- a/agent/src/beerocks/slave/tasks/topology_task.cpp
+++ b/agent/src/beerocks/slave/tasks/topology_task.cpp
@@ -371,6 +371,16 @@ void TopologyTask::handle_topology_query(ieee1905_1::CmduMessageRx &cmdu_rx,
 
     auto db = AgentDB::get();
 
+    bool wireless_backhaul  = false;
+    bool operating_bsta_mld = false;
+    {
+        wireless_backhaul = db->backhaul.connection_type ==
+                            AgentDB::sBackhaul::eConnectionType::Wireless;
+        operating_bsta_mld =
+            wireless_backhaul && db->bsta_mld_configuration &&
+            db->bsta_mld_configuration->mld_config.mld_unit != DISABLED_MLDUNIT;
+    }
+
     if (!add_device_information_and_bridging_capability_tlv()) {
         LOG(ERROR) << "Failed to add device information and bridging capability TLV";
         return;
@@ -413,9 +423,14 @@ void TopologyTask::handle_topology_query(ieee1905_1::CmduMessageRx &cmdu_rx,
         return;
     }
 
-    if (!slave_thread::add_backhaul_sta_mld_configuration_tlv(m_cmdu_tx)) {
-        LOG(ERROR) << "Failed to add Backhaul STA MLD Configuration TLV";
-        return;
+    if (operating_bsta_mld) {
+        if (!slave_thread::add_backhaul_sta_mld_configuration_tlv(m_cmdu_tx)) {
+            LOG(ERROR) << "Failed to add Backhaul STA MLD Configuration TLV";
+            return;
+        }
+    } else {
+        LOG(DEBUG) << "Skipping Backhaul STA MLD Configuration TLV: active backhaul is not "
+                      "a wireless bSTA MLD";
     }
 
     if (!add_assoc_sta_mld_config_reports()) {
@@ -1518,6 +1533,18 @@ bool TopologyTask::add_backhaul_sta_radio_capabilities()
     auto db     = AgentDB::get();
     auto radios = db->get_radios_list();
 
+    if (db->backhaul.connection_type != AgentDB::sBackhaul::eConnectionType::Wireless) {
+        LOG(DEBUG) << "Skipping Backhaul STA Radio Capabilities TLV: active backhaul is not "
+                      "wireless";
+        return true;
+    }
+
+    if (db->bsta_mld_configuration &&
+        db->bsta_mld_configuration->mld_config.mld_unit != DISABLED_MLDUNIT) {
+        LOG(DEBUG) << "Skipping Backhaul STA Radio Capabilities TLV: bSTA MLD is operating";
+        return true;
+    }
+
     if (radios.size() == 0) {
         LOG(ERROR) << "add_backhaul_sta_radio_capabilities(): no radios found in db";
         return true;
@@ -1613,7 +1640,9 @@ bool TopologyTask::add_mld_structure_tlvs()
     }
 
     // Emit one tlvMldStructure for the bSTA MLD (if present)
-    if (db->bsta_mld_configuration &&
+    if (db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
+        db->bsta_mld_configuration &&
+        db->bsta_mld_configuration->mld_config.mld_unit != DISABLED_MLDUNIT &&
         db->bsta_mld_configuration->mld_config.mld_mac != net::network_utils::ZERO_MAC) {
 
         const sMacAddr &bsta_mld_mac = db->bsta_mld_configuration->mld_config.mld_mac;
-- 
2.34.1

