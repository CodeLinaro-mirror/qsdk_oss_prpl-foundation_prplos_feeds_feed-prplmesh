+bool db::dm_trigger_ap_capability_report_event(const sMacAddr &agent_al_mac,
+                                               const std::string &agent_dm_path)
+{
+    /* Single consolidated event fired once after ALL AP Capability Report TLVs
+     * have been written to the ODL DM by handle_ap_capability_report().
+     * Replaces the previous per-TLV events (HT/VHT/WiFi6/WiFi7/Advanced/AKM/
+     * ChannelScan/Profile2/MetricCollection/CAC). */
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.ApCapabilityReport";
+    const std::string al_mac_str = tlvf::mac_to_string(agent_al_mac);
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", al_mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", agent_dm_path.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "ALMAC", al_mac_str.c_str());
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+    if (!ok) {
+        LOG(ERROR) << "Failed to trigger ApCapabilityReport at " << vendor_event_obj
+                   << " al_mac=" << al_mac_str;
+    } else {
+        LOG(DEBUG) << "Triggered ApCapabilityReport al_mac=" << al_mac_str
+                   << " dm_path=" << agent_dm_path;
+    }
+    return ok;
+}
