 sMacAddr sta_wlan_hal_nl80211::get_bsta_mld_mac()
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return beerocks::net::network_utils::ZERO_MAC;
+    // Read the bSTA MLD MAC from wpa_supplicant STATUS.
+    // For an MLO backhaul STA, wpa_supplicant returns "mld_addr=xx:xx:xx:xx:xx:xx"
+    // which is the STA's own MLD MAC address.
+    const char *cmd = "STATUS";
+    parsed_obj_map_t reply;
+    if (!wpa_ctrl_send_msg(cmd, reply)) {
+        LOG(ERROR) << "WPA STATUS command failed for " << get_iface_name();
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    auto it = reply.find("mld_addr");
+    if (it == reply.end() || it->second.empty()) {
+        LOG(DEBUG) << "mld_addr not found in STATUS for " << get_iface_name()
+                   << " (non-MLO backhaul)";
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    LOG(DEBUG) << "bSTA MLD MAC for " << get_iface_name() << ": " << it->second;
+    return tlvf::mac_from_string(it->second);
 }
 
 sMacAddr sta_wlan_hal_nl80211::get_ap_mld_mac()
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return beerocks::net::network_utils::ZERO_MAC;
+    // Read the AP MLD MAC from wpa_supplicant STATUS.
+    // For an MLO backhaul STA, wpa_supplicant returns "ap_mld_addr=xx:xx:xx:xx:xx:xx"
+    // which is the upstream AP's MLD MAC address.
+    const char *cmd = "STATUS";
+    parsed_obj_map_t reply;
+    if (!wpa_ctrl_send_msg(cmd, reply)) {
+        LOG(ERROR) << "WPA STATUS command failed for " << get_iface_name();
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    auto it = reply.find("ap_mld_addr");
+    if (it == reply.end() || it->second.empty()) {
+        LOG(DEBUG) << "ap_mld_addr not found in STATUS for " << get_iface_name()
+                   << " (non-MLO backhaul)";
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    LOG(DEBUG) << "AP MLD MAC for " << get_iface_name() << ": " << it->second;
+    return tlvf::mac_from_string(it->second);
 }
 
