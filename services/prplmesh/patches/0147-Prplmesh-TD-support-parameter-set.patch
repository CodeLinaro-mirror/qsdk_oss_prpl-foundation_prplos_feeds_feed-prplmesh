+bool db::dm_set_ap_eht_caps(const Agent::sRadio &radio)
+{
+    // Write Radio.Capabilities.EHTCapabilities.* based on WiFi7/EHT support
+    // IEEE1905 source: WiFi7 Agent Capabilities TLV in AP_CAP_REPORT
+    // TR-181: Device.WiFi.DataElements.Network.Device.{i}.Radio.{j}.Capabilities.EHTCapabilities.*
+    if (radio.dm_path.empty()) {
+        return true;
+    }
+
+    if (!radio.eht_supported) {
+        // EHT not supported - remove any existing instance
+        m_ambiorix_datamodel->remove_optional_subobject(
+            radio.dm_path + ".Capabilities.", "EHTCapabilities");
+        return true;
+    }
+
+    // Add EHTCapabilities instance under Radio.Capabilities
+    const std::string caps_path = radio.dm_path + ".Capabilities.";
+    if (!m_ambiorix_datamodel->add_optional_subobject(caps_path, "EHTCapabilities")) {
+        LOG(WARNING) << "Failed to add EHTCapabilities sub-object for radio " << radio.radio_uid;
+        return false;
+    }
+
+    const std::string eht_path = caps_path + "EHTCapabilities.";
+    bool ret_val = true;
+
+    // Determine bandwidth support from radio's supported channels
+    bool eht80 = false, eht160 = false, eht320 = false;
+    for (const auto &ch : radio.supported_channels) {
+        switch (ch.get_bandwidth()) {
+        case beerocks::eWiFiBandwidth::BANDWIDTH_80:
+            eht80 = true;
+            break;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_160:
+            eht160 = true;
+            break;
+        case beerocks::eWiFiBandwidth::BANDWIDTH_320:
+            eht320 = true;
+            break;
+        default:
+            break;
+        }
+    }
+    // All EHT radios support at least 80MHz
+    if (radio.eht_supported) {
+        eht80 = true;
+    }
+
+    // Set bandwidth support flags
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "EHT80", eht80);
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "EHT160", eht160);
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "EHT320", eht320);
+
+    // Set MLD mode support from WiFi7 capabilities (AP role)
+    const auto &ap_role = radio.wifi7_capabilities.ap_role;
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "SUBeamformer",
+                                          static_cast<bool>(ap_role.str_support ||
+                                                            ap_role.nstr_support));
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "MUBeamformer",
+                                          static_cast<bool>(ap_role.str_support));
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "ULMUMIMOSupport",
+                                          static_cast<bool>(ap_role.str_support));
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "ULOFDMASupport",
+                                          static_cast<bool>(ap_role.str_support ||
+                                                            ap_role.nstr_support));
+
+    // Spatial streams and MCS sets are not available from WiFi7 TLV - set to 0
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "MaxNumberOfTxSpatialStreams",
+                                          static_cast<uint32_t>(0));
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "MaxNumberOfRxSpatialStreams",
+                                          static_cast<uint32_t>(0));
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "MCSNSSTxSet", static_cast<uint32_t>(0));
+    ret_val &= m_ambiorix_datamodel->set(eht_path, "MCSNSSRxSet", static_cast<uint32_t>(0));
+
+    if (!ret_val) {
+        LOG(WARNING) << "Failed to set EHTCapabilities for radio " << radio.radio_uid;
+    } else {
+        LOG(DEBUG) << "Set EHTCapabilities for radio " << radio.radio_uid
+                   << " EHT80=" << eht80 << " EHT160=" << eht160 << " EHT320=" << eht320;
+    }
     return ret_val;
 }
 
