@@ -861,16 +861,27 @@ bool base_wlan_hal_nl80211::refresh_vaps_info(int id)
         vap_element.ssid = reply["ssid[" + std::to_string(vap_id) + "]"];
 
         std::string mld_mac_key = "mld_addr[" + std::to_string(vap_id) + "]";
-        
+
         auto it = reply.find(mld_mac_key);
         if (it != reply.end()) {
             vap_element.ap_mld_mac = it->second;
 
-            // update mld_id
-            for (const auto& entry : m_radio_info.mld_entries) {
-                if (entry.second == vap_element.bss) {
-                    vap_element.mld_id = entry.first;
-                    break;
+            // Read mld_id[N] directly from hostapd STATUS.
+            // This avoids the timing dependency on mld_entries being populated
+            // from the AP_MLD_CONFIGURATION_REQUEST (which arrives after startup).
+            // hostapd STATUS returns mld_id[N] for each BSS that is part of an MLD.
+            std::string mld_id_key = "mld_id[" + std::to_string(vap_id) + "]";
+            auto mld_id_it = reply.find(mld_id_key);
+            if (mld_id_it != reply.end() && !mld_id_it->second.empty()) {
+                // stoi is safe here: mld_id[N] is always a small integer from hostapd
+                vap_element.mld_id = beerocks::string_utils::stoi(mld_id_it->second);
+            } else {
+                // Fallback: look up mld_id from mld_entries (populated by AP_MLD_CONFIGURATION_REQUEST)
