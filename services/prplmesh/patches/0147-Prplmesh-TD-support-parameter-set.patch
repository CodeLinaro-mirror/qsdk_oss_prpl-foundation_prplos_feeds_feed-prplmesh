+    if (!m_ambiorix_datamodel->set(r2_cap_path, "MaxTotalNumberofVIDs",
+                                   static_cast<uint32_t>(agent.max_total_number_of_vids))) {
+        LOG(WARNING) << "Failed to set R2APCapabilities.MaxTotalNumberofVIDs for agent "
+                     << agent.al_mac;
+    }
+    if (!m_ambiorix_datamodel->set(r2_cap_path, "ByteCounterUnits",
+                                   static_cast<uint32_t>(agent.byte_counter_units))) {
+        LOG(WARNING) << "Failed to set R2APCapabilities.ByteCounterUnits for agent "
+                     << agent.al_mac;
+    }
+
+    /* Trigger vendor events for Profile2 AP Capability after DM writes */
+    if (ret_val) {
+        dm_trigger_profile2_ap_capability_event(agent.al_mac, agent.dm_path);
+    }
+
+    return ret_val;
+}
