+bool db::dm_set_agent_map_version(const Agent &agent)
+{
+    // Write MultiAPDevice.MultiAPVersion from agent.profile
+    // IEEE1905 source: MAP_VERSION TLV (0x0096) in TOPOLOGY_RESPONSE
+    // TR-181: Device.WiFi.DataElements.Network.Device.{i}.MultiAPDevice.MultiAPVersion
+    if (agent.dm_path.empty()) {
+        return true;
+    }
+
+    uint8_t map_version = static_cast<uint8_t>(agent.profile);
+    bool ret_val = m_ambiorix_datamodel->set(agent.dm_path + ".MultiAPDevice", "MultiAPVersion",
+                                              static_cast<uint32_t>(map_version));
+    if (!ret_val) {
+        LOG(WARNING) << "Failed to set MultiAPDevice.MultiAPVersion=" << int(map_version)
+                     << " for agent " << agent.al_mac;
+    } else {
+        LOG(DEBUG) << "Set MultiAPDevice.MultiAPVersion=" << int(map_version)
+                   << " (R" << int(map_version) << ") for agent " << agent.al_mac;
+    }
+    return ret_val;
+}
+
+bool db::dm_set_agent_map_role(const Agent &agent, bool is_controller)
+{
+    // Write MultiAPDevice.MultiAPRole
+    // IEEE1905 source: SUPPORTED_SERVICE TLV (0x0080) in TOPOLOGY_RESPONSE
+    // TR-181: Device.WiFi.DataElements.Network.Device.{i}.MultiAPDevice.MultiAPRole
+    if (agent.dm_path.empty()) {
+        return true;
+    }
+
+    std::string role = is_controller ? "Controller+Agent" : "Agent";
+    bool ret_val = m_ambiorix_datamodel->set(agent.dm_path + ".MultiAPDevice", "MultiAPRole", role);
+    if (!ret_val) {
+        LOG(WARNING) << "Failed to set MultiAPDevice.MultiAPRole=" << role
+                     << " for agent " << agent.al_mac;
+    } else {
+        LOG(DEBUG) << "Set MultiAPDevice.MultiAPRole=" << role << " for agent " << agent.al_mac;
+    }
+    return ret_val;
+}
+
+bool db::dm_set_agent_ap_capabilities(const Agent &agent)
+{
+    // Write MultiAPDevice.APCapabilities.* from radio ap_capabilities
+    // IEEE1905 source: AP_CAPABILITY TLV (0x0070) in AP_CAP_REPORT
+    // TR-181: Device.WiFi.DataElements.Network.Device.{i}.MultiAPDevice.APCapabilities.*
+    if (agent.dm_path.empty()) {
+        return true;
+    }
+
+    if (agent.radios.empty()) {
+        LOG(DEBUG) << "dm_set_agent_ap_capabilities: no radios for agent " << agent.al_mac;
+        return true;
+    }
+
+    // AP_CAPABILITY TLV is per-agent (same values for all radios) — use first radio
+    const auto &first_radio = agent.radios.begin()->second;
+    const std::string ap_cap_path = agent.dm_path + ".MultiAPDevice.APCapabilities";
+
+    bool ret_val = true;
+    ret_val &= m_ambiorix_datamodel->set(
+        ap_cap_path, "UnassocSTALinkMetricsCurrentChannel",
+        static_cast<bool>(
+            first_radio->ap_capabilities.support_unassociated_sta_link_metrics_on_operating_bssid));
+    ret_val &= m_ambiorix_datamodel->set(
+        ap_cap_path, "UnassocSTALinkMetricsNonCurrentChannel",
+        static_cast<bool>(first_radio->ap_capabilities
+                              .support_unassociated_sta_link_metrics_on_non_operating_bssid));
+    ret_val &= m_ambiorix_datamodel->set(
+        ap_cap_path, "AgentInitiatedRSSISteering",
+        static_cast<bool>(
+            first_radio->ap_capabilities.support_agent_initiated_rcpi_based_steering));
+
+    if (!ret_val) {
+        LOG(WARNING) << "Failed to set MultiAPDevice.APCapabilities for agent " << agent.al_mac;
+    } else {
+        LOG(DEBUG) << "Set MultiAPDevice.APCapabilities for agent " << agent.al_mac
+                   << " UnassocCurrCh="
+                   << first_radio->ap_capabilities
+                          .support_unassociated_sta_link_metrics_on_operating_bssid
+                   << " UnassocNonCurrCh="
+                   << first_radio->ap_capabilities
+                          .support_unassociated_sta_link_metrics_on_non_operating_bssid
+                   << " AgentInitRSSI="
+                   << first_radio->ap_capabilities.support_agent_initiated_rcpi_based_steering;
+    }
+    return ret_val;
+}
