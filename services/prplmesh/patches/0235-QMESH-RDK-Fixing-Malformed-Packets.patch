From 66ed351e2bd02cc263cce1e8a36eb69780af364b Mon Sep 17 00:00:00 2001
From: Ritanya Thangavel <rthangav@qti.qualcomm.com>
Date: Mon, 22 Jun 2026 16:23:26 +0530
Subject: [PATCH] Fixing Malformed Packets

Fixed malformed packets in Channel Preference Report and Topology Response:

1. Channel Preference Report - CAC Status Report TLV overflow
   - Limited to 5GHz radios only on RDKB platforms

2. Topology Response - Ethernet Neighbor TLV count mismatch
   - Use TLVF auto-counting instead of manual tracking

Change-Id: Ief6ca689f90c7fb15942e6e905ea5a82a016fd21
Signed-off-by: Ritanya Thangavel <rthangav@qti.qualcomm.com>
---
 .../beerocks/slave/cac_status_database.cpp    | 34 +++++++++
 .../src/tlvf_airties_utils_onewifi.cpp        | 75 ++++++++++++-------
 2 files changed, 82 insertions(+), 27 deletions(-)

diff --git a/agent/src/beerocks/slave/cac_status_database.cpp b/agent/src/beerocks/slave/cac_status_database.cpp
index 1f636185b..3892ebce4 100644
--- a/agent/src/beerocks/slave/cac_status_database.cpp
+++ b/agent/src/beerocks/slave/cac_status_database.cpp
@@ -55,6 +55,19 @@ bool CacStatusDatabase::update_cac_status_db(const AgentDB::sRadio *radio)
                      << beerocks::utils::convert_frequency_type_to_string(freq_type);
     }
 
+#ifdef BEEROCKS_RDKB
+    // Only report CAC status for 5GHz radios to reduce TLV size on RDKB platforms
+    // 2.4GHz: No DFS channels, CAC not applicable
+    // 6GHz: Too many channels (58), excluded to keep TLV size manageable
+    if (freq_type != beerocks::eFreqType::FREQ_5G) {
+        LOG(DEBUG) << "Skipping CAC status report for " 
+                   << beerocks::utils::convert_frequency_type_to_string(freq_type)
+                   << " radio " << radio->front.iface_mac 
+                   << " (only 5GHz radios are reported on RDKB platforms)";
+        return true;  // Return true to allow processing of other radios
+    }
+#endif
+
     CacAvailableChannels available_channels;
     CacNonOccupancyChannels non_occupancy_channels;
     CacActiveChannels active_channels;
@@ -148,17 +161,29 @@ bool CacStatusDatabase::update_cac_status_db(const AgentDB::sRadio *radio)
 
     if (!available_channels.empty()) {
         std::sort(available_channels.begin(), available_channels.end());
+#ifdef BEEROCKS_RDKB
         m_available_channels.emplace(radio->front.iface_mac, available_channels);
+#else
+        m_available_channels[radio->front.iface_mac] = available_channels;
+#endif
     }
 
     if (!non_occupancy_channels.empty()) {
         std::sort(non_occupancy_channels.begin(), non_occupancy_channels.end());
+#ifdef BEEROCKS_RDKB
         m_non_occupancy_channels.emplace(radio->front.iface_mac, non_occupancy_channels);
+#else
+        m_non_occupancy_channels[radio->front.iface_mac] = non_occupancy_channels;
+#endif
     }
 
     if (!active_channels.empty()) {
         std::sort(active_channels.begin(), active_channels.end());
+#ifdef BEEROCKS_RDKB
         m_active_channels.emplace(radio->front.iface_mac, active_channels);
+#else
+        m_active_channels[radio->front.iface_mac] = active_channels;
+#endif
     }
 
     return true;
@@ -181,6 +206,9 @@ bool CacStatusDatabase::add_cac_status_report_tlv(
         !cac_status_report_tlv->alloc_available_channels(available_channels.size())) {
         LOG(ERROR) << "Failed to allocate " << available_channels.size()
                    << " structures for available channels";
+#ifdef BEEROCKS_RDKB
+        return false;
+#endif
     }
 
     for (unsigned int i = 0; i < available_channels.size(); ++i) {
@@ -203,6 +231,9 @@ bool CacStatusDatabase::add_cac_status_report_tlv(
         !cac_status_report_tlv->alloc_detected_pairs(non_occupancy_channels.size())) {
         LOG(ERROR) << "Failed to allocate " << non_occupancy_channels.size()
                    << " structures for non-occupancy channels";
+#ifdef BEEROCKS_RDKB
+        return false;
+#endif
     }
 
     for (unsigned int i = 0; i < non_occupancy_channels.size(); ++i) {
@@ -217,6 +248,9 @@ bool CacStatusDatabase::add_cac_status_report_tlv(
         !cac_status_report_tlv->alloc_active_cac_pairs(active_channels.size())) {
         LOG(ERROR) << "Failed to allocate " << active_channels.size()
                    << " structures for active channels";
+#ifdef BEEROCKS_RDKB
+        return false;
+#endif
     }
 
     for (unsigned int i = 0; i < active_channels.size(); ++i) {
diff --git a/common/beerocks/multi_vendor/onewifi/src/tlvf_airties_utils_onewifi.cpp b/common/beerocks/multi_vendor/onewifi/src/tlvf_airties_utils_onewifi.cpp
index 0b6e04adf..c2a8227b6 100644
--- a/common/beerocks/multi_vendor/onewifi/src/tlvf_airties_utils_onewifi.cpp
+++ b/common/beerocks/multi_vendor/onewifi/src/tlvf_airties_utils_onewifi.cpp
@@ -1007,7 +1007,9 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
     tlvNeighborList->vendor_oui() = sVendorOUI(airties::tlvAirtiesMsgType::airtiesVendorOUI::OUI_AIRTIES);
     tlvNeighborList->tlv_id()     = static_cast<int>(airties::eAirtiesTlVId::AIRTIES_1905_NEIGHBOR_DEVICE_LIST);
 
-    uint8_t added_ports = 0;
+    LOG(DEBUG) << "[TLV:1905-NEIGH] Creating TLV with " << ports_with_neighbors.size() << " candidate ports";
+
+    // Add port entries
     for (const auto &port_info : ports_with_neighbors) {
         auto port_entry = tlvNeighborList->create_port_entries();
         if (!port_entry) {
@@ -1019,30 +1021,38 @@ bool tlvf_airties_utils::add_airties_ethernet_1905_neighbor_device_list_tlv(ieee
 
         const uint8_t num_neighbor =
             static_cast<uint8_t>(std::min<size_t>(port_info.al_neighbors.size(), 0xFF));
-        port_entry->num_of_neighbor_al_macs() = num_neighbor;
+        
+        LOG(DEBUG) << "[TLV:1905-NEIGH] Port " << port_info.ifname << " (id=" << int(port_info.port_id) 
+                   << ") has " << int(num_neighbor) << " 1905 neighbors";
 
         if (num_neighbor > 0) {
+            // alloc_neighbor_al_mac_list() automatically sets num_of_neighbor_al_macs
             if (!port_entry->alloc_neighbor_al_mac_list(num_neighbor)) {
                 LOG(ERROR) << "[TLV:1905-NEIGH] alloc_neighbor_al_mac_list(" << int(num_neighbor)
                            << ") failed for ifname=" << port_info.ifname;
-                port_entry->num_of_neighbor_al_macs() = 0;
-            } else {
-                for (size_t i = 0; i < num_neighbor; ++i) {
-                    auto tup = port_entry->neighbor_al_mac_list(i);
-                    if (std::get<0>(tup)) {
-                        std::get<1>(tup) = port_info.al_neighbors[i];
-                    }
+                // Don't add this port entry if allocation failed
+                continue;
+            }
+
+            // Fill the neighbor list
+            for (size_t i = 0; i < num_neighbor; ++i) {
+                auto tup = port_entry->neighbor_al_mac_list(i);
+                if (std::get<0>(tup)) {
+                    std::get<1>(tup) = port_info.al_neighbors[i];
+                    LOG(DEBUG) << "[TLV:1905-NEIGH]   Neighbor " << i << ": " << port_info.al_neighbors[i];
                 }
             }
         }
 
-        tlvNeighborList->add_port_entries(port_entry);
-        ++added_ports;
+        // add_port_entries() automatically increments num_of_eth_ports
+        if (!tlvNeighborList->add_port_entries(port_entry)) {
+            LOG(ERROR) << "[TLV:1905-NEIGH] add_port_entries() FAILED for ifname=" << port_info.ifname;
+            continue;
+        }
     }
 
-    tlvNeighborList->num_of_eth_ports() = added_ports;
-    LOG(INFO) << "Added Ethernet 1905 Neighbor Device List TLV with " << int(added_ports)
-              << " ports";
+    // Note: num_of_eth_ports is automatically set by TLVF framework via add_port_entries()
+    LOG(INFO) << "Added Ethernet 1905 Neighbor Device List TLV";
     return true;
 }
 
@@ -1187,7 +1197,9 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
     tlvNon1905->tlv_id() =
         static_cast<int>(airties::eAirtiesTlVId::AIRTIES_NON_1905_NEIGHBOR_DEVICE_LIST);
 
-    uint8_t added_ports = 0;
+    LOG(DEBUG) << "[TLV:NON1905-NEIGH] Creating TLV with " << ports_with_non1905_neighbors.size() << " candidate ports";
+
+    // Add port entries
     for (const auto &port_info : ports_with_non1905_neighbors) {
         auto port_entry = tlvNon1905->create_port_entries();
         if (!port_entry) {
@@ -1200,28 +1212,37 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
 
         const uint8_t num_neighbor =
             static_cast<uint8_t>(std::min<size_t>(port_info.non1905_neighbors.size(), 0xFF));
-        port_entry->num_of_non1905_neighbor_macs() = num_neighbor;
+        
+        LOG(DEBUG) << "[TLV:NON1905-NEIGH] Port " << port_info.ifname << " (id=" << int(port_info.port_id) 
+                   << ") has " << int(num_neighbor) << " non-1905 neighbors";
 
-        if (num_neighbor > 0 && !port_entry->alloc_non1905_neighbor_mac_list(num_neighbor)) {
-            LOG(ERROR) << "[TLV:NON1905-NEIGH] alloc_non1905_neighbor_mac_list(" << int(num_neighbor)
-                       << ") failed for " << port_info.ifname;
-            port_entry->num_of_non1905_neighbor_macs() = 0;
-        } else if (num_neighbor > 0) {
+        if (num_neighbor > 0) {
+            // alloc_non1905_neighbor_mac_list() automatically sets num_of_non1905_neighbor_macs
+            if (!port_entry->alloc_non1905_neighbor_mac_list(num_neighbor)) {
+                LOG(ERROR) << "[TLV:NON1905-NEIGH] alloc_non1905_neighbor_mac_list(" << int(num_neighbor)
+                           << ") failed for " << port_info.ifname;
+                // Don't add this port entry if allocation failed
+                continue;
+            }
+
+            // Fill the neighbor list
             for (size_t i = 0; i < num_neighbor; ++i) {
                 auto tup = port_entry->non1905_neighbor_mac_list(i);
                 if (std::get<0>(tup)) {
                     std::get<1>(tup) = port_info.non1905_neighbors[i];
+                    LOG(DEBUG) << "[TLV:NON1905-NEIGH]   Neighbor " << i << ": " << port_info.non1905_neighbors[i];
                 }
             }
         }
 
-        tlvNon1905->add_port_entries(port_entry);
-        ++added_ports;
+        // add_port_entries() automatically increments num_of_eth_ports
+        if (!tlvNon1905->add_port_entries(port_entry)) {
+            LOG(ERROR) << "[TLV:NON1905-NEIGH] add_port_entries() FAILED for " << port_info.ifname;
+            continue;
+        }
     }
 
-    // Finalize TLV with total port count
-    tlvNon1905->num_of_eth_ports() = added_ports;
-    LOG(INFO) << "Added Ethernet non 1905 Neighbor Device List TLV with " << int(added_ports)
-              << " ports";
+    // Note: num_of_eth_ports is automatically set by TLVF framework via add_port_entries()
+    LOG(INFO) << "Added Ethernet non 1905 Neighbor Device List TLV";
     return true;
 }
