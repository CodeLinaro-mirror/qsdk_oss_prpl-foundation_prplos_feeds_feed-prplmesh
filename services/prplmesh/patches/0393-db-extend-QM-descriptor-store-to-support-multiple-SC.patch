+        uint8_t  scsid = 0;
         std::string descriptor_element;
         beerocks::qos_management::eDescriptorRequestType request_type =
             beerocks::qos_management::eDescriptorRequestType::Invalid;
+        bool need_send = true;
+        eDescriptorSource     source_type            = eDescriptorSource::CLIENT;
+        eDescriptorConfigType descriptor_config_type = eDescriptorConfigType::BSS_LEVEL;
     };
 
-    std::unordered_map<sMacAddr, std::unordered_map<sMacAddr, sStoredQmDescriptor>>
+    /*
+     * BSS-level descriptors keyed bssid -> client_mac -> descriptor_key -> sStoredQmDescriptor.
+     *
+     * descriptor_key is a packed uint16_t: (scsid << 8) | source_type.
+     * This allows at most one entry per (scsid, source_type) pair per client:
+     *   - CLIENT and APPLICATION can both hold a descriptor for the same scsid.
+     *   - Two entries of the same source_type for the same scsid are rejected.
+     */
+    static constexpr uint16_t make_descriptor_key(uint8_t scsid, eDescriptorSource src)
+    {
+        return static_cast<uint16_t>(
+            (static_cast<uint16_t>(scsid) << 8) | static_cast<uint8_t>(src));
+    }
+
+    std::unordered_map<sMacAddr,
+        std::unordered_map<sMacAddr,
+            std::unordered_map<uint16_t, sStoredQmDescriptor>>>
         m_controller_qm_descriptors;
 
     std::vector<sMacAddr> m_mscs_disallowed_sta_list;
