From 8e44983d9adea9f98195b1fed88e7f0ee1d0584f Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Mon, 17 Aug 2026 15:19:14 +0530
Subject: [PATCH] nl80211: propagate num_of_bands to AgentDB via
 JOINED_NOTIFICATION

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../fronthaul_manager/ap_manager/ap_manager.cpp       |  3 +++
 agent/src/beerocks/slave/son_slave_thread.cpp         | 11 +++++++++++
 common/beerocks/bwl/include/bwl/base_wlan_hal_types.h |  1 +
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp   |  8 ++++++++
 .../beerocks/tlvf/beerocks_message_apmanager.yaml     |  1 +
 5 files changed, 24 insertions(+)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 3b3920712..8e229eebc 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -4732,6 +4732,9 @@ void ApManager::handle_hostapd_attached()
     notification->radio_rsn_override_support() = ap_wlan_hal->get_radio_info().rsn_override_support;
     notification->radio_mscs_support()         = ap_wlan_hal->get_radio_info().mscs_supported;
     notification->radio_scs_support()          = ap_wlan_hal->get_radio_info().scs_supported;
+#ifdef USE_PRPLMESH_NLHAL
+    notification->num_of_bands()               = ap_wlan_hal->get_radio_info().num_of_bands;
+#endif // USE_PRPLMESH_NLHAL
 
     fill_cs_params(notification->cs_params());
 
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index c3ce7bd4a..9a7d5fcf7 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4129,6 +4129,17 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         radio->mscs_supported = static_cast<bool>(notification->radio_mscs_support());
         radio->scs_supported  = static_cast<bool>(notification->radio_scs_support());
 
+#ifdef USE_PRPLMESH_NLHAL
+        // Update device-level num_of_bands from the NL80211 radio info.
+        // This is used by ap_autoconfiguration_task to handle quad-band devices
+        // where 5GL and 5GH radios both send autoconfig search on the 5G band.
+        if (notification->num_of_bands() > 0 && db->device_conf.num_of_bands == 0) {
+            db->device_conf.num_of_bands = notification->num_of_bands();
+            LOG(DEBUG) << "Updated device_conf.num_of_bands=" << db->device_conf.num_of_bands
+                       << " from JOINED_NOTIFICATION for " << fronthaul_iface;
+        }
+#endif // USE_PRPLMESH_NLHAL
+
         LOG(DEBUG) << "Radio : "
                    << beerocks::utils::convert_frequency_type_to_string(
                           notification->params().frequency_band)
diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index 23a4cdf2b..b82eb57c1 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -272,6 +272,7 @@ struct RadioInfo {
 
     bool smd_support            = false; 
     bool smd_dl_data_fwd_support = false;
+    int8_t num_of_bands         = 0; /**< Number of radio bands (e.g. 4 for quad-band) */
 };
 
 struct hal_conf_t {
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 545d134d8..fd8b1be1e 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -2271,6 +2271,14 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
 
         LOG(DEBUG) << "NUMBER_OF_BANDS IN RADIO: " << radio_info.num_of_bands << " freq band: " << freq_type ;
 
+        // Store num_of_bands in m_radio_info so it can be propagated to AgentDB
+        // via the cACTION_APMANAGER_JOINED_NOTIFICATION message.
+        if (radio_info.num_of_bands > 0) {
+            m_radio_info.num_of_bands = radio_info.num_of_bands;
+            LOG(DEBUG) << "Stored num_of_bands=" << m_radio_info.num_of_bands
+                       << " in radio_info for " << m_radio_info.iface_name;
+        }
+
         m_radio_info.frequency_band = freq_type;
     }
 
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 2c42e2599..849988ab0 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -63,6 +63,7 @@ cACTION_APMANAGER_JOINED_NOTIFICATION:
   radio_rsn_override_support : uint8_t #bool
   radio_mscs_support: uint8_t #bool
   radio_scs_support: uint8_t #bool
+  num_of_bands: int8_t
 
 cACTION_APMANAGER_ENABLE_APS_REQUEST:
   _type: class
-- 
2.34.1

