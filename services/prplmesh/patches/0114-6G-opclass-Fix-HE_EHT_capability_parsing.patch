+            // Check if the operating class bandwidth matches the channel's supported bandwidth
+            // The operating class uses generic bandwidth enums (e.g., BANDWIDTH_320 = 8)
+            // but channels may report specific variants (e.g., BANDWIDTH_320_1 = 6, BANDWIDTH_320_2 = 7)
+            bool bandwidth_matches = (oper_class.band == bw_info.bandwidth);
+
+            // Special handling for 320MHz: operating class uses BANDWIDTH_320 (8),
+            // but channels report BANDWIDTH_320_1 (6) or BANDWIDTH_320_2 (7)
