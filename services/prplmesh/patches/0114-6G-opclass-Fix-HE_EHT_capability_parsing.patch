+                                     bw_info.bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320_2);
+            }
+
+            // Reverse check: if channel reports BANDWIDTH_320_1 or BANDWIDTH_320_2,
+            // it should also match operating classes that use generic BANDWIDTH_320
+            if (!bandwidth_matches &&
+                (bw_info.bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320_1 ||
+                 bw_info.bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320_2)) {
+                bandwidth_matches = (oper_class.band == beerocks::eWiFiBandwidth::BANDWIDTH_320);
+            }
+
+            if (!bandwidth_matches) {
+                continue;
+            }
+
+            // For operating classes that use center channels, we need to convert
+            // the actual channel to center channel before checking
+            uint8_t channel_to_check = channel;
+            if (son::wireless_utils::is_operating_class_using_central_channel(operating_class)) {
+                // Use the actual bandwidth from the channel info, not the operating class
+                auto freq_type = son::wireless_utils::which_freq_op_cls(operating_class);
+                channel_to_check = son::wireless_utils::get_center_channel(
+                    channel, freq_type, bw_info.bandwidth);
+
+                if (channel_to_check == 0) {
+                    LOG(DEBUG) << "    Failed to get center channel for channel=" << int(channel)
+                               << " bandwidth=" << int(bw_info.bandwidth);
+                    continue;
+                }
+            }
+
+            bool channel_in_op_class = son::wireless_utils::is_channel_in_operating_class(operating_class, channel_to_check);
+
+            if (bandwidth_matches && channel_in_op_class) {
                 max_tx_power = std::max(max_tx_power, channel_info.tx_power_dbm);
             }
         }
     }
+
     return max_tx_power;
 }
 
