diff --git a/common/beerocks/bcl/source/son/son_wireless_utils.cpp b/common/beerocks/bcl/source/son/son_wireless_utils.cpp
index 203a2d185..289da5306 100644
--- a/common/beerocks/bcl/source/son/son_wireless_utils.cpp
+++ b/common/beerocks/bcl/source/son/son_wireless_utils.cpp
@@ -1826,6 +1826,56 @@ bool wireless_utils::is_channel_in_operating_class(uint8_t operating_class, uint
 {
     auto channel_set = operating_class_to_channel_set(operating_class);
 
+    // First, try direct channel lookup
+    if (channel_set.find(channel) != channel_set.end()) {
+        return true;
+    }
+
+    // For 6 GHz operating classes 132-137, the channel set contains center channel indices
+    // instead of actual channel numbers. Convert the actual channel to center channel.
+    // For more info, refer to Table E-4 in the 802.11 specification.
+    if (operating_class >= OPERATING_CLASS_6GHZ_FIRST && operating_class <= OPERATING_CLASS_6GHZ_LAST) {
+        // Get the bandwidth for this operating class
+        auto bandwidth = operating_class_to_bandwidth(operating_class);
+
+        // OpClass 131 and 136 use actual channel numbers, not center channels
+        if (operating_class == 131 || operating_class == 136) {
+            return false; // Already checked above
+        }
+
+        // Special handling for 320MHz (OpClass 137)
+        // The operating class uses generic BANDWIDTH_320, but get_center_channel() requires
+        // specific variants (BANDWIDTH_320_1 or BANDWIDTH_320_2). Try both variants.
+        if (bandwidth == beerocks::eWiFiBandwidth::BANDWIDTH_320) {
+            // Try 320MHz-1 variant
+            auto center_channel_1 = get_center_channel(channel, beerocks::eFreqType::FREQ_6G,
+                                                       beerocks::eWiFiBandwidth::BANDWIDTH_320_1);
+            if (center_channel_1 != 0 &&
+                channel_set.find(center_channel_1) != channel_set.end()) {
+                return true;
+            }
+
+            // Try 320MHz-2 variant
+            auto center_channel_2 = get_center_channel(channel, beerocks::eFreqType::FREQ_6G,
+                                                       beerocks::eWiFiBandwidth::BANDWIDTH_320_2);
+            if (center_channel_2 != 0 &&
+                channel_set.find(center_channel_2) != channel_set.end()) {
+                return true;
+            }
+
+            return false;
+        }
+
+        // For other 6 GHz operating classes, convert to center channel
+        auto center_channel = get_center_channel(channel, beerocks::eFreqType::FREQ_6G, bandwidth);
+        if (center_channel == 0) {
+            return false;
+        }
+
+        // Check if the center channel is in the operating class
+        return (channel_set.find(center_channel) != channel_set.end());
+    }
+
     return (channel_set.find(channel) != channel_set.end());
 }
 
