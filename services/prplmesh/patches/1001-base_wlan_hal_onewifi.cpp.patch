+bool base_wlan_hal_onewifi::check_and_open_bus()
+{
+    // Always initialize bus handle before any bus operations
+    // NOTE: bus_init() must be called before each bus operation to ensure handle validity
+    ONEWIFI_LOG_DEBUG("check_and_open_bus: Calling bus_init() to ensure handle validity");
+    bus_error_t init_rc = bus_init(m_bus_hdl_ptr);
+    if (init_rc != bus_error_success) {
+        ONEWIFI_LOG_ERROR("check_and_open_bus: bus_init() failed with error code: %d", init_rc);
+        return false;
+    }
+
+    // Get bus descriptor
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (!desc) {
+        ONEWIFI_LOG_ERROR("check_and_open_bus: Bus descriptor is NULL - get_bus_descriptor() returned NULL");
+        ONEWIFI_LOG_ERROR("This usually means OneWifi platform layer is not initialized or bus descriptor not registered");
+        return false;
+    }
+
+    ONEWIFI_LOG_DEBUG("check_and_open_bus: Got bus descriptor, checking bus_open_fn");
+    
+    // Check if bus_open_fn is available
+    if (!desc->bus_open_fn) {
+        ONEWIFI_LOG_ERROR("check_and_open_bus: bus_open_fn is NULL in bus descriptor");
+        ONEWIFI_LOG_ERROR("Bus descriptor exists but bus_open_fn function pointer is not set");
+        return false;
+    }
+    
+    // Use shared bus name per radio (not per HAL type)
+    // Since AP and Monitor share the same bus handle, they must use the same bus name
+    // Format: prplmesh-hal-<interface_name>
+    // Example: prplmesh-hal-wlan0 (shared by both AP and Monitor)
+    std::string bus_name = "prplmesh-hal-" + get_iface_name();
+    ONEWIFI_LOG_INFO("check_and_open_bus: Calling bus_open_fn with SHARED name='%s'", bus_name.c_str());
+    
+    bus_error_t rc = desc->bus_open_fn(m_bus_hdl_ptr, (char *)bus_name.c_str());
+    
+    ONEWIFI_LOG_DEBUG("check_and_open_bus: bus_open_fn returned: %d", rc);
+    
+    if (rc != bus_error_success) {
+        // Handle specific error cases
+        switch (rc) {
+            case bus_error_session_already_exist:
+            case bus_error_component_name_duplicate:
+                // Bus session/component already exists - this is OK, reuse it
+                ONEWIFI_LOG_DEBUG("check_and_open_bus: Bus connection already exists (error=%d), reusing existing connection", rc);
+                return true;
+                
+            case bus_error_destination_not_reachable:
+            case bus_error_destination_not_found:
+                ONEWIFI_LOG_ERROR("check_and_open_bus: Bus daemon not reachable (error=%d)", rc);
+                ONEWIFI_LOG_ERROR("Check if RBus/CCSP bus daemon is running");
+                return false;
+                
+            case bus_error_timeout:
+                ONEWIFI_LOG_ERROR("check_and_open_bus: Bus open timeout (error=%d)", rc);
+                ONEWIFI_LOG_ERROR("Bus daemon may be overloaded or not responding");
+                return false;
+                
+            case bus_error_access_not_allowed:
+                ONEWIFI_LOG_ERROR("check_and_open_bus: Access denied (error=%d)", rc);
+                ONEWIFI_LOG_ERROR("Check permissions for bus access");
+                return false;
+                
+            default:
+                ONEWIFI_LOG_ERROR("check_and_open_bus: bus_open_fn FAILED with error code: %d", rc);
+                ONEWIFI_LOG_ERROR("Possible causes:");
+                ONEWIFI_LOG_ERROR("  1. OneWifi service not running");
+                ONEWIFI_LOG_ERROR("  2. Bus/RBus daemon not running");
+                ONEWIFI_LOG_ERROR("  3. Permission issues");
+                return false;
+        }
+    }
+    
+    ONEWIFI_LOG_INFO("check_and_open_bus: SUCCESS - OneWifi bus connection opened");
+    return true;
+}
+
+webconfig_subdoc_type_t base_wlan_hal_onewifi::get_subdoc_radio_type_for_freq(em_freq_band_t freq_band)
+{
+    switch (freq_band) {
+        case em_freq_band_24:
+            return webconfig_subdoc_type_radio_24G;
+        case em_freq_band_5:
+            return webconfig_subdoc_type_radio_5G;
+        case em_freq_band_60:
+        case em_freq_band_6:
+            return webconfig_subdoc_type_radio_6G;
+        default:
+            ONEWIFI_LOG_ERROR("Unknown frequency band: %d, defaulting to 5G", freq_band);
+            return webconfig_subdoc_type_radio_5G;
+    }
+}
