+bool base_wlan_hal_onewifi::is_bss_zero_mac(const em_bss_info_t *bss)
+{
+    if (!bss) {
+        return true;
+    }
+    return (memcmp(bss->bssid.mac, "\x00\x00\x00\x00\x00\x00", 6) == 0);
+}
+
+bool base_wlan_hal_onewifi::bss_belongs_to_radio(const em_bss_info_t *bss, const mac_address_t &radio_mac)
+{
+    if (!bss) {
+        return false;
+    }
+    return (memcmp(bss->ruid.mac, radio_mac, sizeof(mac_address_t)) == 0);
+}
+
+bool base_wlan_hal_onewifi::is_bss_valid(const em_bss_info_t *bss, const mac_address_t &radio_mac)
+{
+    if (!bss) {
+        return false;
+    }
+    
+    // Check if BSS is enabled
+    if (!bss->enabled) {
+        return false;
+    }
+    
+    // Check if BSS has zero MAC
+    if (is_bss_zero_mac(bss)) {
+        return false;
+    }
+    
+    // Check if BSS belongs to the specified radio
+    if (!bss_belongs_to_radio(bss, radio_mac)) {
+        return false;
+    }
+    
+    return true;
+}
+
+em_bss_info_t* base_wlan_hal_onewifi::find_bss_by_iface_name(const std::string &iface_name)
+{
+    if (!m_data_model) return nullptr;
+
+    // Get current HAL radio MAC for filtering BSS that belong to this radio
+    std::string radio_mac_str = get_radio_mac();
+    if (radio_mac_str.empty()) {
+        ONEWIFI_LOG_ERROR("find_bss_by_iface_name: Failed to get MAC for interface %s", m_radio_info.iface_name.c_str());
+        return nullptr;
+    }
+    mac_address_t radio_mac;
+    tlvf::mac_from_string(radio_mac, radio_mac_str);
+
+    for (unsigned int i = 0; i < m_data_model->get_num_bss(); i++) {
+        em_bss_info_t *bss = m_data_model->get_bss_info(i);
+        if (!bss) continue;
+
+        // Ensure the BSS belongs to the current radio
+        if (!bss_belongs_to_radio(bss, radio_mac)) {
+            continue;
+        }
+
+        // Compare with bssid.name (which stores the VapName/iface_name in OneWiFi)
+        if (iface_name == bss->bssid.name) {
+            return bss;
+        }
+
+        // Also try mapping VapName to physical interface if it doesn't match directly
+        std::string physical_iface;
+        if (m_data_model->get_vap_name_mapping(bss->bssid.name, physical_iface)) {
+            if (iface_name == physical_iface) {
+                return bss;
+            }
+        }
+    }
+    return nullptr;
+}
