+// Define static members
+std::mutex base_wlan_hal_onewifi::s_webconfig_decode_mutex;
+std::map<std::string, std::shared_ptr<base_wlan_hal_onewifi::SharedResources>> base_wlan_hal_onewifi::s_shared_resources;
+std::mutex base_wlan_hal_onewifi::s_shared_resources_mutex;
+
 base_wlan_hal_onewifi::base_wlan_hal_onewifi(HALType type, std::string iface_name,
                                                hal_event_cb_t callback,
                                                const beerocks::bpl::BPL_WLAN_IFACE &iface_config,
                                                hal_conf_t hal_conf)
     : base_wlan_hal(type, iface_name, IfaceType::Intel, callback, hal_conf),
+      m_bus_hdl_ptr(nullptr),
       m_iface_config(iface_config)
 {
     // Initialize members
-    // m_bus_desc = nullptr;
     m_event_pipe[0] = -1;
     m_event_pipe[1] = -1;
+    
+    // Get or create shared resources for this radio interface
+    {
+        std::lock_guard<std::mutex> lock(s_shared_resources_mutex);
+        auto it = s_shared_resources.find(iface_name);
+        if (it == s_shared_resources.end()) {
+            // First HAL for this radio - create new shared resources
+            m_shared_resources = std::make_shared<SharedResources>();
+            m_shared_resources->data_model = std::make_shared<onewifi_data_model_t>();
+            s_shared_resources[iface_name] = m_shared_resources;
+            ONEWIFI_LOG_INFO("Created new shared resources (data model + bus) for radio %s", iface_name.c_str());
+        } else {
+            // Reuse existing shared resources for this radio
+            m_shared_resources = it->second;
+            ONEWIFI_LOG_INFO("Reusing existing shared resources (data model + bus) for radio %s", iface_name.c_str());
+        }
+        
+        // Increment reference count
+        m_shared_resources->ref_count++;
+        ONEWIFI_LOG_INFO("Shared resources ref_count=%d for radio %s", m_shared_resources->ref_count, iface_name.c_str());
+    }
+    
+    // Set convenience pointer to data model
+    m_data_model = m_shared_resources->data_model;
+    
+    // Point m_bus_hdl_ptr to the shared bus handle
+    m_bus_hdl_ptr = &m_shared_resources->bus_handle;
 }
 
 base_wlan_hal_onewifi::~base_wlan_hal_onewifi()
 {
     detach();
+    
+    // Decrement reference count and cleanup if last reference
+    std::lock_guard<std::mutex> lock(s_shared_resources_mutex);
+    if (m_shared_resources) {
+        m_shared_resources->ref_count--;
+        ONEWIFI_LOG_INFO("Shared resources ref_count=%d for radio %s", 
+                         m_shared_resources->ref_count, get_iface_name().c_str());
+        
+        if (m_shared_resources->ref_count == 0) {
+            // Last HAL using these resources - remove from map
+            s_shared_resources.erase(get_iface_name());
+            ONEWIFI_LOG_INFO("Removed shared resources for radio %s (ref_count reached 0)", 
+                             get_iface_name().c_str());
+        }
+    }
 }
 
 HALState base_wlan_hal_onewifi::attach(bool block)
 {
-    // TODO: Implement attachment to OneWifi bus
-    // - Get bus descriptor
-    // - Create event pipe
-    // - Subscribe to events
-    return HALState::Operational;
+    if (m_fds_ext_events.empty()) {
+        m_fds_ext_events.push_back(-1);
+    }
+
+    if (m_fds_ext_events[0] == -1) {
+        m_fds_ext_events[0] = eventfd(0, EFD_NONBLOCK);
+        if (m_fds_ext_events[0] == -1) {
+            ONEWIFI_LOG_ERROR("Failed to create eventfd for onewifi HAL");
+        }
+    }
+
+    // Mark HAL as operational - subclasses handle bus init and subscriptions
+    m_hal_state = HALState::Operational;
+    ONEWIFI_LOG_INFO("Base attach: HAL operational for interface (bus/subscriptions handled by subclass)");
+    return m_hal_state;
 }
 
 bool base_wlan_hal_onewifi::detach()
 {
-    // TODO: Implement detachment from OneWifi bus
+    if (!m_fds_ext_events.empty() && m_fds_ext_events[0] != -1) {
+        close(m_fds_ext_events[0]);
+        m_fds_ext_events[0] = -1;
+    }
+    m_hal_state = HALState::Uninitialized;
     return true;
 }
 
 bool base_wlan_hal_onewifi::process_ext_events(int fd)
 {
+    if (!m_fds_ext_events.empty() && fd == m_fds_ext_events[0] && fd != -1) {
+        uint64_t dummy_val;
+        ssize_t ret = read(fd, &dummy_val, sizeof(dummy_val));
+        if (ret < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+            ONEWIFI_LOG_ERROR("Failed to read from dummy eventfd: %s", strerror(errno));
+        }
+        return true;
+    }
+
     // TODO: Implement event processing
     // - Read from event pipe
     // - Dequeue from thread-safe queue
@@ -53,32 +168,705 @@ bool base_wlan_hal_onewifi::process_ext_events(int fd)
 
 bool base_wlan_hal_onewifi::refresh_radio_info()
 {
-    // TODO: Implement radio info refresh from OneWifi
+    // Note: DML data is already fetched and decoded during attach()
+    // We use the existing data model populated by on_onewifi_init_data()
+    // Fresh DML updates come via WIFI_WEBCONFIG_DOC_DATA_NORTH events
+    
+    // Get radio MAC address to look up radio info
+    std::string radio_mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(m_radio_info.iface_name, radio_mac_str)) {
+        ONEWIFI_LOG_ERROR("refresh_radio_info: Failed to get MAC for interface %s", 
+                          m_radio_info.iface_name.c_str());
+        return false;
+    }
+    
+    // Convert MAC string to mac_address_t for lookup
+    mac_address_t radio_mac;
+    tlvf::mac_from_string(radio_mac, radio_mac_str);
+    
+    // Find radio info by MAC address
+    em_radio_info_t *radio_info = nullptr;
+    unsigned int radio_idx = 0;
+    ONEWIFI_LOG_DEBUG("refresh_radio_info: Looking for radio with MAC %s in data model (%u radios)",
+                      radio_mac_str.c_str(), m_data_model->get_num_radios());
+    for (unsigned int i = 0; i < m_data_model->get_num_radios(); i++) {
+        em_radio_info_t *r = m_data_model->get_radio_info(i);
+        if (r) {
+            ONEWIFI_LOG_DEBUG("refresh_radio_info: Radio[%u] MAC=%02x:%02x:%02x:%02x:%02x:%02x",
+                             i, r->intf.mac[0], r->intf.mac[1], r->intf.mac[2],
+                             r->intf.mac[3], r->intf.mac[4], r->intf.mac[5]);
+            if (memcmp(r->intf.mac, radio_mac, sizeof(mac_address_t)) == 0) {
+                radio_info = r;
+                radio_idx = i;
+                ONEWIFI_LOG_INFO("refresh_radio_info: Found matching radio at index %u", i);
+                break;
+            }
+        }
+    }
+    
+    if (!radio_info) {
+        ONEWIFI_LOG_WARN("refresh_radio_info: No radio info found for MAC %s",
+                          radio_mac_str.c_str());
+        return false;
+    }
+    
+    // Get radio capabilities using the same index
+    em_radio_cap_info_t *radio_cap = m_data_model->get_radio_cap_info(radio_idx);
+    if (!radio_cap) {
+        ONEWIFI_LOG_WARN("refresh_radio_info: No radio capabilities found at index %u for MAC %s",
+                          radio_idx, radio_mac_str.c_str());
+        return false;
+    }
+    
+    ONEWIFI_LOG_INFO("refresh_radio_info: Populating ALL capabilities from OneWifi radio_cap for MAC %s",
+                     radio_mac_str.c_str());
+    
+    // Fill HT (802.11n) capabilities from radio_cap->ht_cap using struct style
+    beerocks::net::sHTCapabilities ht_caps = {0};
+    ht_caps.ht_support_40mhz = radio_cap->ht_cap.ht_sprt_40mhz;
+    ht_caps.short_gi_support_40mhz = radio_cap->ht_cap.gi_sprt_40mhz;
+    ht_caps.short_gi_support_20mhz = radio_cap->ht_cap.gi_sprt_20mhz;
+    ht_caps.max_num_of_supported_rx_spatial_streams = radio_cap->ht_cap.max_sprt_rx_streams & 0x03;
+    ht_caps.max_num_of_supported_tx_spatial_streams = radio_cap->ht_cap.max_sprt_tx_streams & 0x03;
+    std::memcpy(&m_radio_info.ht_capability, &ht_caps, sizeof(ht_caps));
+    m_radio_info.ht_supported = (radio_cap->ht_cap.ht_sprt_40mhz || radio_cap->ht_cap.gi_sprt_40mhz || 
+                                 radio_cap->ht_cap.gi_sprt_20mhz || radio_cap->ht_cap.max_sprt_rx_streams > 0 ||
+                                 radio_cap->ht_cap.max_sprt_tx_streams > 0);
+    m_radio_info.ht_mcs_set.fill(0);
+    
+    // Fill VHT (802.11ac) capabilities from radio_cap->vht_cap using struct style
+    m_radio_info.vht_supported = (radio_cap->vht_cap.max_sprt_tx_streams > 0 || radio_cap->vht_cap.max_sprt_rx_streams > 0);
+    beerocks::net::sVHTCapabilities vht_caps = {0};
+    vht_caps.short_gi_support_160mhz_and_80_80mhz = radio_cap->vht_cap.gi_sprt_160mhz;
+    vht_caps.short_gi_support_80mhz = radio_cap->vht_cap.gi_sprt_80mhz;
+    vht_caps.max_num_of_supported_rx_spatial_streams = radio_cap->vht_cap.max_sprt_rx_streams & 0x07;
+    vht_caps.max_num_of_supported_tx_spatial_streams = radio_cap->vht_cap.max_sprt_tx_streams & 0x07;
+    vht_caps.mu_beamformer_capable = radio_cap->vht_cap.mu_beamformer_cap;
+    vht_caps.su_beamformer_capable = radio_cap->vht_cap.su_beamformer_cap;
+    vht_caps.vht_support_160mhz = radio_cap->vht_cap.sprt_160mhz;
+    vht_caps.vht_support_80_80mhz = radio_cap->vht_cap.sprt_80_80_mhz;
+    std::memcpy(&m_radio_info.vht_capability, &vht_caps, sizeof(vht_caps));
+    m_radio_info.vht_mcs_set.fill(0);
+    if (m_radio_info.vht_mcs_set.size() >= 4) {
+        m_radio_info.vht_mcs_set[0] = radio_cap->vht_cap.sprt_rx_mcs & 0xFF;
+        m_radio_info.vht_mcs_set[1] = (radio_cap->vht_cap.sprt_rx_mcs >> 8) & 0xFF;
+        m_radio_info.vht_mcs_set[2] = radio_cap->vht_cap.sprt_tx_mcs & 0xFF;
+        m_radio_info.vht_mcs_set[3] = (radio_cap->vht_cap.sprt_tx_mcs >> 8) & 0xFF;
+    }
+    
+    // Fill HE (802.11ax/WiFi6) capabilities from radio_cap->he_cap using struct style
+    m_radio_info.he_supported = (radio_cap->he_cap.sprt_mcs_len > 0);
+    beerocks::net::sHECapabilities he_caps = {0};
+    he_caps.he_support_160mhz = radio_cap->he_cap.sprt_160mhz;
+    he_caps.he_support_80_80mhz = radio_cap->he_cap.sprt_80_80_mhz;
+    he_caps.max_num_of_supported_rx_spatial_streams = radio_cap->he_cap.max_sprt_rx_streams & 0x07;
+    he_caps.max_num_of_supported_tx_spatial_streams = radio_cap->he_cap.max_sprt_tx_streams & 0x07;
+    he_caps.dl_ofdm_capable = radio_cap->he_cap.dl_ofdma_cap;
+    he_caps.ul_ofdm_capable = radio_cap->he_cap.ul_ofdma_cap;
+    he_caps.dl_mu_mimo_and_ofdm_capable = radio_cap->he_cap.dl_mimo_ofdma_cap;
+    he_caps.ul_mu_mimo_and_ofdm_capable = radio_cap->he_cap.ul_mimo_ofdma_cap;
+    he_caps.ul_mu_mimo_capable = radio_cap->he_cap.ul_mimo_cap;
+    he_caps.mu_beamformer_capable = radio_cap->he_cap.mu_beamformer_cap;
+    he_caps.su_beamformer_capable = radio_cap->he_cap.su_beamformer_cap;
+    std::memcpy(&m_radio_info.he_capability, &he_caps, sizeof(he_caps));
+    m_radio_info.he_mcs_set.fill(0);
+    for (unsigned int i = 0; i < MAX_MCS && i < m_radio_info.he_mcs_set.size() / 4; i++) {
+        if (i * 4 + 3 < m_radio_info.he_mcs_set.size()) {
+            m_radio_info.he_mcs_set[i * 4 + 0] = radio_cap->he_cap.sprt_tx_rx_mcs[i].tx_he_mcs & 0xFF;
+            m_radio_info.he_mcs_set[i * 4 + 1] = (radio_cap->he_cap.sprt_tx_rx_mcs[i].tx_he_mcs >> 8) & 0xFF;
+            m_radio_info.he_mcs_set[i * 4 + 2] = radio_cap->he_cap.sprt_tx_rx_mcs[i].rx_he_mcs & 0xFF;
+            m_radio_info.he_mcs_set[i * 4 + 3] = (radio_cap->he_cap.sprt_tx_rx_mcs[i].rx_he_mcs >> 8) & 0xFF;
+        }
+    }
+    
+    // Fill WiFi6 capabilities structure from radio_cap->wifi6_cap using struct style
+    beerocks::net::sWIFI6Capabilities wifi6_caps = {0};
+    
+    // Use first role (agent role) from wifi6_cap
+    if (radio_cap->wifi6_cap.num_role > 0) {
+        const em_wifi6_role_wire_t *role = &radio_cap->wifi6_cap.roles[0];
+        
+        // Fill from role_head
