+    ONEWIFI_LOG_DEBUG("  dl_ofdma=%u, ul_ofdma=%u, ul_mu_mimo=%u",
+                      wifi6_caps.dl_ofdma, wifi6_caps.ul_ofdma, wifi6_caps.ul_mu_mimo);
+    ONEWIFI_LOG_DEBUG("  su_beamformer=%u, su_beamformee=%u, mu_Beamformer=%u",
+                      wifi6_caps.su_beamformer, wifi6_caps.su_beamformee, wifi6_caps.mu_Beamformer_status);
+    ONEWIFI_LOG_DEBUG("  max_dl_mu_mimo_tx=%u, max_ul_mu_mimo_rx=%u",
+                      wifi6_caps.max_dl_mu_mimo_tx, wifi6_caps.max_ul_mu_mimo_rx);
+    ONEWIFI_LOG_DEBUG("  max_dl_ofdma_tx=%u, max_ul_ofdma_rx=%u",
+                      wifi6_caps.max_dl_ofdma_tx, wifi6_caps.max_ul_ofdma_rx);
+    
+    ONEWIFI_LOG_DEBUG("refresh_radio_info: === MLO Capabilities ===");
+    ONEWIFI_LOG_DEBUG("  max_num_mlds=%u, ap_maximum_links=%u, bsta_maximum_links=%u",
+                      m_radio_info.max_num_mlds, m_radio_info.ap_maximum_links, m_radio_info.bsta_maximum_links);
+    ONEWIFI_LOG_DEBUG("  AP MLO modes - STR=%d NSTR=%d EMLSR=%d EMLMR=%d",
+                      m_radio_info.ap_modes_support.str_support, m_radio_info.ap_modes_support.nstr_support,
+                      m_radio_info.ap_modes_support.emlsr_support, m_radio_info.ap_modes_support.emlmr_support);
+    ONEWIFI_LOG_DEBUG("  BSTA MLO modes - STR=%d NSTR=%d EMLSR=%d EMLMR=%d",
+                      m_radio_info.bsta_modes_support.str_support, m_radio_info.bsta_modes_support.nstr_support,
+                      m_radio_info.bsta_modes_support.emlsr_support, m_radio_info.bsta_modes_support.emlmr_support);
+
+    // Set supported flags to 1 if not already set
+    if (!m_radio_info.ht_supported) {
+        m_radio_info.ht_supported = true;
+        ONEWIFI_LOG_DEBUG("refresh_radio_info: Set ht_supported=1 (was not set)");
+    }
+    if (!m_radio_info.vht_supported) {
+        m_radio_info.vht_supported = true;
+        ONEWIFI_LOG_DEBUG("refresh_radio_info: Set vht_supported=1 (was not set)");
+    }
+    if (!m_radio_info.he_supported) {
+        m_radio_info.he_supported = true;
+        ONEWIFI_LOG_DEBUG("refresh_radio_info: Set he_supported=1 (was not set)");
+    }
+
+    return true;
+}
