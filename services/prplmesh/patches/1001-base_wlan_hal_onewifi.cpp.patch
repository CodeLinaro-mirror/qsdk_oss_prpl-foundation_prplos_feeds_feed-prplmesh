+std::string base_wlan_hal_onewifi::get_radio_mac()
+{
+    if (m_data_model && m_data_model->get_num_radios() > 0) {
+        for (unsigned int i = 0; i < m_data_model->get_num_radios(); i++) {
+            em_radio_info_t *radio = m_data_model->get_radio_info(i);
+            if (!radio) continue;
+
+            bool band_match = false;
+            switch (radio->band) {
+                case em_freq_band_24:
+                    band_match = (m_iface_config.freq_type == beerocks::eFreqType::FREQ_24G);
+                    break;
+                case em_freq_band_5:
+                    band_match = (m_iface_config.freq_type == beerocks::eFreqType::FREQ_5G);
+                    break;
+                case em_freq_band_60:
+                case em_freq_band_6:
+                    band_match = (m_iface_config.freq_type == beerocks::eFreqType::FREQ_6G);
+                    break;
+                default:
+                    break;
+            }
+
+            if (band_match) {
+                std::string mac_str = tlvf::mac_to_string(radio->intf.mac);
+                ONEWIFI_LOG_DEBUG("get_radio_mac: Found MAC %s matching freq_type %d", 
+                                  mac_str.c_str(), static_cast<int>(m_iface_config.freq_type));
+                return mac_str;
+            }
+        }
+        ONEWIFI_LOG_WARN("get_radio_mac: Data model ready but no radio matched freq_type %d", 
+                         static_cast<int>(m_iface_config.freq_type));
+    }
+
+    return "";
+}
