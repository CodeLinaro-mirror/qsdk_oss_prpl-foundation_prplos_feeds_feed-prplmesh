+
+void base_wlan_hal_onewifi::update_radio_info_from_data_model()
+{
+    // Find the correct radio by matching MAC address of interface name
+    em_radio_info_t *radio_info = nullptr;
+    if (m_data_model->get_num_radios() == 0) {
+        ONEWIFI_LOG_WARN("update_radio_info_from_data_model: No radios in data model");
+        return;
+    }
+
+    // Get MAC address from interface name using get_radio_mac() which handles both regular and MLD link interfaces
+    std::string mac_str = get_radio_mac();
+    if (!mac_str.empty()) {
+        mac_address_t iface_mac;
+        tlvf::mac_from_string(iface_mac, mac_str);
+        
+        unsigned int radio_idx = 0;
+        radio_info = find_radio_by_mac(m_data_model.get(), iface_mac, &radio_idx);
+        if (radio_info) {
+            ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: Found radio at index %u by MAC address match", radio_idx);
+        }
+    }
+    
+    if (!radio_info) {
+        ONEWIFI_LOG_WARN("update_radio_info_from_data_model: Radio not found for interface %s", m_radio_info.iface_name.c_str());
+        return;
+    }
+
+    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Reading from radio_info - enabled=%d, band=%d, tx_power_limit=%d, num_bss=%d",
+                     radio_info->enabled, radio_info->band, 
+                     radio_info->transmit_power_limit, radio_info->number_of_bss);
+    
+    // Update basic radio state from radio_info
+    m_radio_info.tx_enabled = radio_info->enabled;
+    m_radio_info.radio_state = radio_info->enabled ? bwl::eRadioState::ENABLED : bwl::eRadioState::DISABLED;
+    
+    // Read tx_power from radio_info (transmit_power_limit field)
+    if (radio_info->transmit_power_limit > 0) {
+        m_radio_info.tx_power = radio_info->transmit_power_limit;
+        ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set tx_power=%d from radio_info->transmit_power_limit", 
+                         m_radio_info.tx_power);
+    }
+    
+    // Read max BSS supported from radio_info (number_of_bss field)
+    if (radio_info->number_of_bss > 0) {
+        m_radio_info.radio_max_bss_supported = radio_info->number_of_bss;
+        ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set radio_max_bss_supported=%d from radio_info->number_of_bss", 
+                         m_radio_info.radio_max_bss_supported);
+    } else {
+        // Set default value when number_of_bss is not available
+        m_radio_info.radio_max_bss_supported = 8; // Default to 8 BSS per radio
+        ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set default radio_max_bss_supported=%d (radio_info->number_of_bss=%d)", 
+                         m_radio_info.radio_max_bss_supported, radio_info->number_of_bss);
+    }
+    
+    // Update frequency band and band-specific settings from radio_info
+    switch (radio_info->band) {
+        case em_freq_band_24:
+            m_radio_info.frequency_band = beerocks::eFreqType::FREQ_24G;
+            m_radio_info.is_5ghz = false;
+            ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set frequency_band to 2.4GHz (em_freq_band_24=%d)", 
+                             radio_info->band);
+            break;
+        case em_freq_band_5:
+            m_radio_info.frequency_band = beerocks::eFreqType::FREQ_5G;
+            m_radio_info.is_5ghz = true;
+            ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set frequency_band to 5GHz (em_freq_band_5=%d)", 
+                             radio_info->band);
+            break;
+        case em_freq_band_60:
+        case em_freq_band_6:
+            m_radio_info.frequency_band = beerocks::eFreqType::FREQ_6G;
+            m_radio_info.is_5ghz = false;
+            ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set frequency_band to 6GHz (em_freq_band_60=%d)", 
+                             radio_info->band);
+            break;
+        default:
+            ONEWIFI_LOG_ERROR("update_radio_info_from_data_model: Unknown em_freq_band value: %d - frequency_band NOT set!", 
+                              radio_info->band);
+            break;
+    }
+    
+    // Update channel information from current operating class
+    for (unsigned int i = 0; i < m_data_model->get_num_op_class(); i++) {
+        em_op_class_info_t *op_class = m_data_model->get_op_class_info(i);
+        if (op_class && op_class->id.type == em_op_class_type_current &&
+            memcmp(op_class->id.ruid, radio_info->intf.mac, sizeof(mac_address_t)) == 0) {
+            
+            // Update channel
+            m_radio_info.channel = op_class->channel;
+            
+            // Update bandwidth based on operating class
+            auto bw = son::wireless_utils::operating_class_to_bandwidth(op_class->op_class);
+            if (bw != beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+                m_radio_info.bandwidth = bw;
+                ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set bandwidth=%s from op_class=%d",
+                                 beerocks::utils::convert_bandwidth_to_string(bw).c_str(),
+                                 op_class->op_class);
+
+                // For 6GHz 320MHz, determine the specific variant (320_1 or 320_2) and use it
+                if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G &&
+                    bw == beerocks::eWiFiBandwidth::BANDWIDTH_320) {
+
+                    // Try to determine which variant by calculating vht_center_freq with each
+                    int vht_freq_320_1 = son::wireless_utils::get_vht_central_frequency(
+                        op_class->channel, beerocks::eWiFiBandwidth::BANDWIDTH_320_1, m_radio_info.frequency_band);
+                    int vht_freq_320_2 = son::wireless_utils::get_vht_central_frequency(
+                        op_class->channel, beerocks::eWiFiBandwidth::BANDWIDTH_320_2, m_radio_info.frequency_band);
+
+                    // Use the first non-zero variant
+                    if (vht_freq_320_1 != 0) {
+                        m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_1;
+                        ONEWIFI_LOG_INFO("update_radio_info_from_data_model: 6GHz 320MHz from op_class - using BANDWIDTH_320_1");
+                    } else if (vht_freq_320_2 != 0) {
+                        m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_2;
+                        ONEWIFI_LOG_INFO("update_radio_info_from_data_model: 6GHz 320MHz from op_class - using BANDWIDTH_320_2");
+                    } else {
+                        ONEWIFI_LOG_WARN("update_radio_info_from_data_model: 6GHz 320MHz from op_class - failed to determine variant");
+                    }
+                }
+            } else {
+                // Set default bandwidth based on frequency band if op_class bandwidth is unknown
+                ONEWIFI_LOG_WARN("update_radio_info_from_data_model: op_class=%d returned BANDWIDTH_UNKNOWN, using default based on frequency_band",
+                                 op_class->op_class);
+                if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G) {
+                    m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_20;
+                    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set default bandwidth=BANDWIDTH_20 for 2.4GHz");
+                } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G) {
+                    m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_80;
+                    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set default bandwidth=BANDWIDTH_80 for 5GHz");
+                } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
+                    m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_80;
+                    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Set default bandwidth=BANDWIDTH_80 for 6GHz");
+                }
+            }
+
+            // Calculate VHT center frequency using the bandwidth (which is now 320_1 or 320_2 if applicable)
+            m_radio_info.vht_center_freq = son::wireless_utils::get_vht_central_frequency(
+                op_class->channel, m_radio_info.bandwidth, m_radio_info.frequency_band);
+            
+            ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Updated channel=%d, bandwidth=%s, vht_center_freq=%d from op_class=%d",
+                             m_radio_info.channel,
+                             beerocks::utils::convert_bandwidth_to_string(m_radio_info.bandwidth).c_str(),
+                             m_radio_info.vht_center_freq,
+                             op_class->op_class);
+            break;
+        }
+    }
+
+    // Populate channels_list from capability operating classes
+    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Populating channels_list from capability op_classes");
+
+    // First pass: determine max_bandwidth and build ordered bandwidth list from capability operating classes.
+    // This is needed so we can mark all higher supported bandwidths when populating channels_list.
+    m_radio_info.max_bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_20;
+    std::set<beerocks::eWiFiBandwidth> band_bw_set;
+    // Track non-operable channels for marking
+    std::unordered_set<uint16_t> non_operable_channels;
+
+    for (unsigned int i = 0; i < m_data_model->get_num_op_class(); i++) {
+        em_op_class_info_t *op_class = m_data_model->get_op_class_info(i);
+        if (!op_class || op_class->id.type != em_op_class_type_capability) {
+            continue;
+        }
+        if (memcmp(op_class->id.ruid, radio_info->intf.mac, sizeof(mac_address_t)) != 0) {
+            continue;
+        }
+
+        // Collect non-operable channels from this operating class
+        for (unsigned int ch_idx = 0; ch_idx < op_class->num_channels; ch_idx++) {
+            uint16_t ch = op_class->channels[ch_idx];
+            non_operable_channels.insert(ch);
+            ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: Channel %u from op_class %u - marked as non-operable",
+                             ch, op_class->op_class);
+        }
+
+        auto op_class_bw = son::wireless_utils::operating_class_to_bandwidth(op_class->op_class);
+        if (op_class_bw != beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+            band_bw_set.insert(op_class_bw);
+
+            // If BANDWIDTH_320 is found, also add BANDWIDTH_320_1 and BANDWIDTH_320_2
+            if (op_class_bw == beerocks::eWiFiBandwidth::BANDWIDTH_320) {
+                band_bw_set.insert(beerocks::eWiFiBandwidth::BANDWIDTH_320_1);
+                band_bw_set.insert(beerocks::eWiFiBandwidth::BANDWIDTH_320_2);
+                ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: Found BANDWIDTH_320, added BANDWIDTH_320_1 and BANDWIDTH_320_2");
+            }
+
+            if (op_class_bw > m_radio_info.max_bandwidth) {
+                m_radio_info.max_bandwidth = op_class_bw;
+            }
+        }
+    }
+
+    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: max_bandwidth from capability op_classes = %s, found %zu bandwidth levels",
+                     beerocks::utils::convert_bandwidth_to_string(m_radio_info.max_bandwidth).c_str(),
+                     band_bw_set.size());
+
+    // Second pass: populate channels_list
+    // Get 20MHz operating class to get the base channel list
+    unsigned int op_class_20mhz = bandwidth_to_operating_class(beerocks::eWiFiBandwidth::BANDWIDTH_20, m_radio_info.frequency_band);
+    if (op_class_20mhz == 0) {
+        ONEWIFI_LOG_ERROR("update_radio_info_from_data_model: Failed to get 20MHz operating class");
+        return;
+    }
+
+    // Get all 20MHz channels - this is the base channel list
+    const std::set<uint8_t> &channels_20mhz = son::wireless_utils::operating_class_to_channel_set(op_class_20mhz);
+    ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: Got %zu channels from 20MHz operating class %u",
+                     channels_20mhz.size(), op_class_20mhz);
+
+    // Populate channel info for each 20MHz channel
+    for (uint8_t ch : channels_20mhz) {
+        // Skip non-operable channels - they should not be added to channels_list
+        if (non_operable_channels.find(ch) != non_operable_channels.end()) {
+            ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: Skipping non-operable channel %u", ch);
+            continue;
+        }
+
+        auto &channel_info = m_radio_info.channels_list[ch];
+
+        // Set DFS state based on channel and frequency band
+        // DFS channels: 5GHz 52-144 (except 165+)
+        if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G) {
+            if (ch >= 52 && ch <= 144) {
+                channel_info.dfs_state = beerocks::eDfsState::USABLE;
+            } else {
+                channel_info.dfs_state = beerocks::eDfsState::DFS_STATE_MAX;
+            }
+        } else {
+            // 2.4GHz and 6GHz don't have DFS
+            channel_info.dfs_state = beerocks::eDfsState::DFS_STATE_MAX;
+        }
+
+        // Set default tx_power (will be updated from radio_info if available)
+        if (channel_info.tx_power_dbm == 0) {
+            channel_info.tx_power_dbm = 20; // Default 20 dBm
+        }
+
+        // Mark bandwidth support - check if this channel supports each bandwidth
+        for (auto bw : band_bw_set) {
+            // For 20MHz, all channels in the base list support it
+            if (bw == beerocks::eWiFiBandwidth::BANDWIDTH_20) {
+                channel_info.bw_info_list[bw] = 1;
+                continue;
+            }
+
+            // For wider bandwidths, check if a valid center channel exists for this primary channel
+            // get_vht_central_frequency returns 0 if the primary channel cannot support this bandwidth
+            int center_freq = son::wireless_utils::get_vht_central_frequency(ch, bw, m_radio_info.frequency_band);
+            if (center_freq != 0) {
+                channel_info.bw_info_list[bw] = 1;
+            }
+        }
+
+        ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: Channel %u configured with bandwidth support",
+                         ch);
+    }
+
+    // Log summary of populated channels
+    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Populated %zu channels, %zu non-operable channels",
+                     m_radio_info.channels_list.size(),
+                     non_operable_channels.size());
+    
+    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Populated %zu channels, max_bandwidth=%s",
+                     m_radio_info.channels_list.size(),
+                     beerocks::utils::convert_bandwidth_to_string(m_radio_info.max_bandwidth).c_str());
+
+    // Get current HAL radio MAC for filtering BSS that belong to this radio
+    // Use get_radio_mac() which handles both regular and MLD link interfaces
+    std::string hal_radio_mac_str = get_radio_mac();
+    if (hal_radio_mac_str.empty()) {
+        ONEWIFI_LOG_ERROR("update_radio_info_from_data_model: Failed to get MAC for interface %s", m_radio_info.iface_name.c_str());
+        return;
+    }
+    mac_address_t hal_radio_mac;
+    tlvf::mac_from_string(hal_radio_mac, hal_radio_mac_str);
+
+    // Update available VAPs from decoded BSS info
+    // Only add enabled AP BSS entries that belong to this radio
+    if (m_data_model->get_num_bss() > 0) {
+        m_radio_info.available_vaps.clear();
+        int vap_id = 0;  // Separate incremental index for enabled VAPs
+        for (unsigned int i = 0; i < m_data_model->get_num_bss(); i++) {
+            em_bss_info_t *bss = m_data_model->get_bss_info(i);
+            if (!bss) continue;
+
+            // Only add AP BSS (skip STA BSS)
+            if (bss->vap_mode != em_vap_mode_ap) {
+                ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: skipping non-AP BSS at index %u (vap_mode=%d, BSSID=%02x:%02x:%02x:%02x:%02x:%02x)",
+                                 i, bss->vap_mode, bss->bssid.mac[0], bss->bssid.mac[1], bss->bssid.mac[2],
+                                 bss->bssid.mac[3], bss->bssid.mac[4], bss->bssid.mac[5]);
+                continue;
+            }
+
+            // Use helper function for BSS validation (enabled, non-zero MAC, belongs to radio)
+            if (!is_bss_valid(bss, hal_radio_mac)) {
+                ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: skipping invalid BSS at index %u", i);
+                continue;
+            }
+
+            // Use helper function to create VAPElement
+            VAPElement vap_elem = create_vap_element(bss, m_data_model.get(), m_radio_info.iface_name);
+
+            m_radio_info.available_vaps[vap_id] = vap_elem;
+            
+            ONEWIFI_LOG_DEBUG("update_radio_info_from_data_model: VAP[%d] (BSS index %u) iface=%s mac=%s ssid=%s",
+                             vap_id, i, vap_elem.bss.c_str(), vap_elem.mac.c_str(), vap_elem.ssid.c_str());
+            vap_id++;
+        }
+        ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Updated %zu enabled VAPs from data model (%u total BSS entries)", 
+                         m_radio_info.available_vaps.size(), m_data_model->get_num_bss());
+    }
+
+    ONEWIFI_LOG_INFO("update_radio_info_from_data_model: Completed m_radio_info update from data model");
+}
+
+bool base_wlan_hal_onewifi::refresh_vap_info(int vap_id)
+{
+    ONEWIFI_LOG_TRACE("%s - vap_id: %d", __func__, vap_id);
+
+    if (vap_id < 0 || vap_id >= beerocks::IFACE_TOTAL_VAPS) {
+        ONEWIFI_LOG_ERROR("Invalid vap_id: %d", vap_id);
+        return false;
+    }
+
+    // Get radio MAC for validation
+    std::string radio_mac_str = get_radio_mac();
+    if (radio_mac_str.empty()) {
+        ONEWIFI_LOG_ERROR("refresh_vap_info: Failed to get MAC for interface %s", m_radio_info.iface_name.c_str());
+        return false;
+    }
+    mac_address_t radio_mac;
+    tlvf::mac_from_string(radio_mac, radio_mac_str);
+
+    // Get VAP information from the shared data model
+    // The data model is populated by the AP HAL when it decodes OneWifi events
+    ONEWIFI_LOG_DEBUG("refresh_vap_info: vap_id=%d, num_bss in data_model=%u", 
+                      vap_id, m_data_model->get_num_bss());
+
+    em_bss_info_t *bss = nullptr;
+    int current_vap_id = 0;
+    
+    for (unsigned int i = 0; i < m_data_model->get_num_bss(); i++) {
+        em_bss_info_t *current_bss = m_data_model->get_bss_info(i);
+        if (!current_bss) continue;
+
+        // Only add AP BSS (skip STA BSS)
+        if (current_bss->vap_mode != em_vap_mode_ap) {
+            continue;
+        }
+
+        // Use helper function for BSS validation (enabled, non-zero MAC, belongs to radio)
+        if (!is_bss_valid(current_bss, radio_mac)) {
+            continue;
+        }
+        
+        if (current_vap_id == vap_id) {
+            bss = current_bss;
+            break;
+        }
+        
+        current_vap_id++;
+    }
+
+    if (!bss) {
+        ONEWIFI_LOG_ERROR("Failed to get BSS info for vap_id: %d", vap_id);
+        return false;
+    }
+
+    ONEWIFI_LOG_DEBUG("refresh_vap_info: Retrieved BSS info - bssid.name='%s', bssid.mac=%02x:%02x:%02x:%02x:%02x:%02x, ssid='%s'",
+                      bss->bssid.name,
+                      bss->bssid.mac[0], bss->bssid.mac[1], bss->bssid.mac[2],
+                      bss->bssid.mac[3], bss->bssid.mac[4], bss->bssid.mac[5],
+                      bss->ssid);
+
+    // Use helper function to create VAPElement
+    VAPElement vap_elem = create_vap_element(bss, m_data_model.get(), m_radio_info.iface_name);
+    
+    ONEWIFI_LOG_DEBUG("refresh_vap_info: Created VAPElement - bss='%s', mac='%s', ssid='%s', fh=%d, bh=%d",
+                      vap_elem.bss.c_str(), vap_elem.mac.c_str(), vap_elem.ssid.c_str(),
+                      vap_elem.fronthaul, vap_elem.backhaul);
+
+    m_radio_info.available_vaps[vap_id] = vap_elem;
+
+    ONEWIFI_LOG_INFO("Refreshed VAP info for vap_id %d: iface=%s mac=%s ssid=%s fh=%d bh=%d",
+                      vap_id, vap_elem.bss.c_str(), vap_elem.mac.c_str(),
+                      vap_elem.ssid.c_str(), vap_elem.fronthaul, vap_elem.backhaul);
+
     return true;
 }
 
