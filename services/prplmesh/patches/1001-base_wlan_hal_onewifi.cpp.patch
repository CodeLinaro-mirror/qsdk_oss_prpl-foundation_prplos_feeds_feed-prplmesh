+void base_wlan_hal_onewifi::m_radio_parse_iface_info(const std::string &iface_name)
+{
+    // Detect MLD link interface (e.g., "wlan0_link0", "wlan0_link1", "wlan0_link2")
+    // Only wlan0 exists physically; _linkN is a logical naming convention.
+    size_t link_pos = iface_name.find("_link");
+    if (link_pos != std::string::npos) {
+        m_radio_iface = iface_name.substr(0, link_pos);
+        m_radio_id    = static_cast<uint8_t>(std::stoi(iface_name.substr(link_pos + 5)));
+        ONEWIFI_LOG_INFO("MLD link interface detected: logical='%s' base='%s' link_id=%d",
+                         iface_name.c_str(), m_radio_iface.c_str(), (int)m_radio_id);
+    } else {
+        m_radio_iface = iface_name;
+        m_radio_id    = 0;
+        ONEWIFI_LOG_DEBUG("Non-MLD interface: '%s'", iface_name.c_str());
+    }
+}
+
+void base_wlan_hal_onewifi::m_lookup_iface_config(const std::string &iface_name)
+{
+    // Look up the BPL_WLAN_IFACE for this interface to get the correct freq_type.
+    // Single pass: match by iface_name and set m_radio_id from radio_num.
+    beerocks::bpl::BPL_WLAN_IFACE interfaces[BPL_NUM_OF_INTERFACES] = {};
+    int num_interfaces = BPL_NUM_OF_INTERFACES;
+    if (beerocks::bpl::cfg_get_all_prplmesh_wifi_interfaces(interfaces, &num_interfaces) != 0) {
+        ONEWIFI_LOG_WARN("m_lookup_iface_config: cfg_get_all_prplmesh_wifi_interfaces failed for '%s'",
+                         iface_name.c_str());
+        return;
+    }
+
+    for (int i = 0; i < num_interfaces; i++) {
+        if (iface_name == interfaces[i].ifname) {
+            m_iface_config = interfaces[i];
+            m_radio_id     = static_cast<uint8_t>(interfaces[i].radio_num);
+            ONEWIFI_LOG_INFO("m_lookup_iface_config: Found iface_config for '%s': freq_type=%d radio_id=%d",
+                             iface_name.c_str(), static_cast<int>(m_iface_config.freq_type),
+                             static_cast<int>(m_radio_id));
+            return;
+        }
+    }
+
+    ONEWIFI_LOG_WARN("m_lookup_iface_config: No iface_config found for '%s', freq_type will be unknown",
+                     iface_name.c_str());
+}
+
 base_wlan_hal_onewifi::base_wlan_hal_onewifi(HALType type, std::string iface_name,
                                                hal_event_cb_t callback,
                                                const beerocks::bpl::BPL_WLAN_IFACE &iface_config,
                                                hal_conf_t hal_conf)
     : base_wlan_hal(type, iface_name, IfaceType::Intel, callback, hal_conf),
+      m_bus_hdl_ptr(nullptr),
       m_iface_config(iface_config)
 {
     // Initialize members
-    // m_bus_desc = nullptr;
     m_event_pipe[0] = -1;
     m_event_pipe[1] = -1;
+
+    // Parse MLD link information from interface name
+    m_radio_parse_iface_info(iface_name);
+
+    // If iface_config was not provided (freq_type is FREQ_DISABLED from zero-init, or FREQ_UNKNOWN),
+    // look it up from the platform config
