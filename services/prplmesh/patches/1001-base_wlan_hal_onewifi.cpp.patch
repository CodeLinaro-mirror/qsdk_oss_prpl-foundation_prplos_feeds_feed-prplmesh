+VAPElement base_wlan_hal_onewifi::create_vap_element(const em_bss_info_t *bss,
+                                                      onewifi_data_model_t *data_model,
+                                                      const std::string &fallback_iface)
+{
+    VAPElement vap_elem = {};
+    
+    if (!bss) {
+        ONEWIFI_LOG_ERROR("create_vap_element: bss is NULL");
+        return vap_elem;
+    }
+    
+    // Get physical interface name using VapName from OneWifi configuration
+    std::string vap_name = bss->bssid.name;
+    std::string physical_iface;
+    
+    // Try to get interface name from OneWifi VapName mapping (thread-safe)
+    if (data_model && data_model->get_vap_name_mapping(vap_name, physical_iface)) {
+        ONEWIFI_LOG_DEBUG("create_vap_element: Mapped VapName '%s' to interface '%s'",
+                         vap_name.c_str(), physical_iface.c_str());
+    } else {
+        // Fallback: use provided fallback interface name
+        physical_iface = fallback_iface;
+        ONEWIFI_LOG_DEBUG("create_vap_element: VapName '%s' not in mapping, using fallback '%s'",
+                         vap_name.c_str(), fallback_iface.c_str());
+    }
+    
+    // Populate VAPElement fields
+    vap_elem.bss      = physical_iface;
+    vap_elem.mac      = tlvf::mac_to_string(bss->bssid.mac);
+    vap_elem.ssid     = std::string(bss->ssid);
+    vap_elem.fronthaul = bss->fronthaul_use;
+    vap_elem.backhaul  = bss->backhaul_use;
+
+    // Look up AP MLD info from the data model using the BSS BSSID.
+    // OneWifi populates this via fill_ap_mld_info_from_vap() which sets:
+    //   ap_mld->mac_addr      = vap->u.bss_info.mld_info.common_info.mld_addr  (MLD MAC)
+    //   affiliated_ap[].mac_addr = vap->u.bss_info.bssid
+    //   affiliated_ap[].link_id  = vap->u.bss_info.mld_info.common_info.mld_link_id
+    // Get the MLD MAC directly from ap_mld->mac_addr (authoritative source).
+    if (data_model) {
+        em_ap_mld_info_t *ap_mld = data_model->get_ap_mld_frm_bssid(
+            const_cast<mac_address_t &>(bss->bssid.mac));
+        if (ap_mld) {
+            // mld_id >= 0 signals to the agent that this BSS is part of an MLD
+            vap_elem.mld_id = 0;
+
+            // Get AP MLD MAC from the AP MLD info (authoritative source)
+            if (ap_mld->mac_addr_valid) {
+                vap_elem.ap_mld_mac = tlvf::mac_to_string(ap_mld->mac_addr);
+            }
+
+            // Find the link_id for this BSS from the affiliated AP list
+            for (unsigned char i = 0; i < ap_mld->num_affiliated_ap; i++) {
+                if (memcmp(ap_mld->affiliated_ap[i].mac_addr,
+                           bss->bssid.mac, sizeof(mac_address_t)) == 0) {
+                    if (ap_mld->affiliated_ap[i].link_id_valid) {
+                        vap_elem.link_id = static_cast<int8_t>(
+                            ap_mld->affiliated_ap[i].link_id);
+                    }
+                    break;
+                }
+            }
+            ONEWIFI_LOG_DEBUG("create_vap_element: BSS %s ap_mld_mac=%s link_id=%d mld_id=0",
+                              vap_elem.mac.c_str(), vap_elem.ap_mld_mac.c_str(),
+                              vap_elem.link_id);
+        }
+    }
+
+    ONEWIFI_LOG_DEBUG("create_vap_element: bss=%s mac=%s ssid=%s ap_mld_mac=%s link_id=%d mld_id=%d",
+                      vap_elem.bss.c_str(), vap_elem.mac.c_str(), vap_elem.ssid.c_str(),
+                      vap_elem.ap_mld_mac.c_str(), vap_elem.link_id, vap_elem.mld_id);
+
+    return vap_elem;
+}
