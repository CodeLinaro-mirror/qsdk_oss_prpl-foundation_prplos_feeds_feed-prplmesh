+sMacAddr base_wlan_hal_onewifi::get_ap_mld_mac()
+{
+    // The AP MLD MAC is the MAC of the base (physical) MLD interface.
+    // For MLD link interfaces (e.g., "phy00-mld0_link0"), m_radio_iface = "phy00-mld0".
+    // For non-MLD interfaces, m_radio_iface == m_radio_info.iface_name — return ZERO_MAC.
+    if (m_radio_iface == m_radio_info.iface_name) {
+        // Non-MLD interface
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    std::string mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(m_radio_iface, mac_str) ||
+        mac_str.empty()) {
+        ONEWIFI_LOG_WARN("get_ap_mld_mac: Failed to get MAC from base interface %s",
+                         m_radio_iface.c_str());
+        return beerocks::net::network_utils::ZERO_MAC;
+    }
+
+    ONEWIFI_LOG_DEBUG("get_ap_mld_mac: AP MLD MAC=%s from base interface %s",
+                      mac_str.c_str(), m_radio_iface.c_str());
+    return tlvf::mac_from_string(mac_str);
+}
