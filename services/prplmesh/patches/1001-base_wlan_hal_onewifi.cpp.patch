+unsigned int base_wlan_hal_onewifi::bandwidth_to_operating_class(beerocks::eWiFiBandwidth bandwidth,
+                                                                  beerocks::eFreqType freq_band)
+{
+    if (freq_band == beerocks::eFreqType::FREQ_24G) {
+        switch (bandwidth) {
+            case beerocks::eWiFiBandwidth::BANDWIDTH_20:
+                return 81;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_40:
+                return 83;
+            default:
+                return 81;
+        }
+    } else if (freq_band == beerocks::eFreqType::FREQ_5G) {
+        switch (bandwidth) {
+            case beerocks::eWiFiBandwidth::BANDWIDTH_20:
+                return 115;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_40:
+                return 116;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_80:
+                return 128;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_160:
+                return 129;
+            default:
+                return 0;
+        }
+    } else if (freq_band == beerocks::eFreqType::FREQ_6G) {
+        switch (bandwidth) {
+            case beerocks::eWiFiBandwidth::BANDWIDTH_20:
+                return 131;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_40:
+                return 132;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_80:
+                return 133;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_160:
+                return 134;
+            case beerocks::eWiFiBandwidth::BANDWIDTH_320:
+            case beerocks::eWiFiBandwidth::BANDWIDTH_320_1:
+            case beerocks::eWiFiBandwidth::BANDWIDTH_320_2:
+                return 137;
+            default:
+                return 0;
+        }
+    }
+    return 0;
+}
+
+int base_wlan_hal_onewifi::update_current_operating_classes(onewifi_data_model_t *data_model,
+                                                            const mac_address_t &radio_mac,
+                                                            int channel,
+                                                            beerocks::eWiFiBandwidth bandwidth,
+                                                            beerocks::eFreqType freq_band)
+{
+    if (!data_model) {
+        ONEWIFI_LOG_ERROR("update_current_operating_classes: data_model is NULL");
+        return 0;
+    }
+
+    unsigned int new_op_class = bandwidth_to_operating_class(bandwidth, freq_band);
+    if (new_op_class == 0) {
+        ONEWIFI_LOG_ERROR("update_current_operating_classes: Failed to map bandwidth to operating class");
+        return 0;
+    }
+
+    int updated_count = 0;
+    for (unsigned int i = 0; i < data_model->get_num_op_class(); i++) {
+        em_op_class_info_t *op_class = data_model->get_op_class_info(i);
+        
+        if (!op_class || op_class->id.type != em_op_class_type_current) {
+            continue;
+        }
+
+        if (memcmp(op_class->id.ruid, radio_mac, sizeof(mac_address_t)) != 0) {
+            continue;
+        }
+
+        // Update channel
+        op_class->channel = channel;
+
+        // Update operating class if needed
+        if (op_class->op_class != new_op_class) {
+            op_class->op_class = new_op_class;
+            op_class->id.op_class = new_op_class;
+        }
+
+        updated_count++;
+    }
+
+    if (updated_count == 0) {
+        ONEWIFI_LOG_WARN("update_current_operating_classes: No current operating classes found for radio");
+    } else {
+        ONEWIFI_LOG_INFO("update_current_operating_classes: Updated %d operating class entries", updated_count);
+    }
+
+    return updated_count;
+}
