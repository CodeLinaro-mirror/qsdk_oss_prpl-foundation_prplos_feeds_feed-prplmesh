+bool base_wlan_hal_onewifi::set_channel_common(int chan, beerocks::eWiFiBandwidth bw, int center_channel,
+                                              const char *subdoc_name)
+{
+    // Update local radio info
+    m_radio_info.channel = chan;
+    m_radio_info.bandwidth = bw;
+
+    // For 6GHz 320MHz, determine the specific variant (320_1 or 320_2)
+    // Use primary channel (chan) to determine which variant
+    if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G &&
+        bw == beerocks::eWiFiBandwidth::BANDWIDTH_320) {
+
+        // Try to determine which variant by calculating vht_center_freq with each
+        // Use primary channel (chan) for variant determination
+        int vht_freq_320_1 = son::wireless_utils::get_vht_central_frequency(
+            chan, beerocks::eWiFiBandwidth::BANDWIDTH_320_1, m_radio_info.frequency_band);
+        int vht_freq_320_2 = son::wireless_utils::get_vht_central_frequency(
+            chan, beerocks::eWiFiBandwidth::BANDWIDTH_320_2, m_radio_info.frequency_band);
+
+        // Use the first non-zero variant
+        if (vht_freq_320_1 != 0) {
+            m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_1;
+            ONEWIFI_LOG_INFO("set_channel_common: 6GHz 320MHz - using BANDWIDTH_320_1 (primary_channel=%d)", chan);
+        } else if (vht_freq_320_2 != 0) {
+            m_radio_info.bandwidth = beerocks::eWiFiBandwidth::BANDWIDTH_320_2;
+            ONEWIFI_LOG_INFO("set_channel_common: 6GHz 320MHz - using BANDWIDTH_320_2 (primary_channel=%d)", chan);
+        }
+    }
+
+    // For CSA, update reason code
+    if (strcmp(subdoc_name, "CSA") == 0) {
+        m_radio_info.last_csa_sw_reason = ChanSwReason::Unknown;
+        m_radio_info.vht_center_freq = center_channel;
+    } else {
+        if (center_channel != 0) {
+            m_radio_info.vht_center_freq = son::wireless_utils::channel_to_freq(center_channel, m_radio_info.frequency_band);
+            ONEWIFI_LOG_INFO("set_channel_common: Using center_channel=%d -> vht_center_freq=%d",
+                         center_channel, m_radio_info.vht_center_freq);
+        }
+
+        if (m_radio_info.vht_center_freq == 0) {
+            // Calculate VHT center frequency using the wireless_utils function
+            // Always use primary channel (chan) for calculation
+            m_radio_info.vht_center_freq = son::wireless_utils::get_vht_central_frequency(
+                chan, m_radio_info.bandwidth, m_radio_info.frequency_band);
+        }
+    }
+
+    // Update the data model with new channel configuration
+    // Channel is stored in the current operating class entry
+    if (!m_data_model || m_data_model->get_num_radios() == 0) {
+        ONEWIFI_LOG_ERROR("set_channel_common: No radio info available in data model");
+        return false;
+    }
+
+    em_radio_info_t *radio_info = m_data_model->get_radio_info(0);
+    if (!radio_info) {
+        ONEWIFI_LOG_ERROR("set_channel_common: Failed to get radio info from data model");
+        return false;
+    }
+
+    // Get radio MAC
+    std::string radio_mac_str = get_radio_mac();
+    if (radio_mac_str.empty()) {
+        ONEWIFI_LOG_ERROR("set_channel_common: Failed to get radio MAC for interface %s", get_iface_name().c_str());
+        return false;
+    }
+    mac_address_t iface_mac;
+    tlvf::mac_from_string(iface_mac, radio_mac_str);
+    
+    // Update ALL current operating classes with new channel and bandwidth
+    int updated_count = update_current_operating_classes(
+        m_data_model.get(), iface_mac, chan, bw, m_radio_info.frequency_band);
+    
+    if (updated_count == 0) {
+        ONEWIFI_LOG_WARN("set_channel_common: No current operating class found, channel update may not take effect");
+    }
+
+    // Map frequency band to em_freq_band_t for subdoc type determination
+    em_freq_band_t freq_band;
+    if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G) {
+        freq_band = em_freq_band_24;
+    } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G) {
+        freq_band = em_freq_band_5;
+    } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
+        freq_band = em_freq_band_60;
+    } else {
+        ONEWIFI_LOG_ERROR("set_channel_common: Unknown frequency band: %d", m_radio_info.frequency_band);
+        return false;
+    }
+
+    // Get subdoc type using helper function
+    webconfig_subdoc_type_t subdoc_type = get_subdoc_radio_type_for_freq(freq_band);
+
+    ONEWIFI_LOG_INFO("Sending %s subdoc (type=%d) with channel=%d bw=%d center_freq=%d to OneWifi", 
+                     subdoc_name, subdoc_type, chan, static_cast<int>(bw), center_channel);
+
+    // Call child class's refresh_onewifi_subdoc method if it exists
+    // Since base doesn't have refresh_onewifi_subdoc, we rely on the child to actually send the subdoc.
+    // Wait, let's move refresh_onewifi_subdoc to base class if we want to do this completely.
+    // However, refresh_onewifi_subdoc is currently in ap_wlan_hal_onewifi.cpp.
+    // Let's implement it here just to update the state, and let the child class send the subdoc, 
+    // OR we return true from here and the child class calls refresh_onewifi_subdoc.
+    // That's a much better approach since refresh_onewifi_subdoc is AP specific right now.
+    
+    return true; // We successfully updated the data model and internal state
+}
