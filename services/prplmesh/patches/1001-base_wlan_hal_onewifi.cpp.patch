+bool base_wlan_hal_onewifi::get_interface_mac(const std::string &iface_name, mac_address_t &mac_out)
+{
+    std::string mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(iface_name, mac_str)) {
+        ONEWIFI_LOG_ERROR("get_interface_mac: Failed to get MAC for interface %s", iface_name.c_str());
+        return false;
+    }
+    tlvf::mac_from_string(mac_out, mac_str);
+    return true;
+}
+
+em_radio_info_t* base_wlan_hal_onewifi::find_radio_by_mac(onewifi_data_model_t *data_model,
+                                                           const mac_address_t &radio_mac,
+                                                           unsigned int *radio_idx_out)
+{
+    if (!data_model) {
+        ONEWIFI_LOG_ERROR("find_radio_by_mac: data_model is NULL");
+        return nullptr;
+    }
+
+    for (unsigned int i = 0; i < data_model->get_num_radios(); i++) {
+        em_radio_info_t *radio = data_model->get_radio_info(i);
+        if (radio && memcmp(radio->intf.mac, radio_mac, sizeof(mac_address_t)) == 0) {
+            if (radio_idx_out) {
+                *radio_idx_out = i;
+            }
+            return radio;
+        }
+    }
+    return nullptr;
+}
