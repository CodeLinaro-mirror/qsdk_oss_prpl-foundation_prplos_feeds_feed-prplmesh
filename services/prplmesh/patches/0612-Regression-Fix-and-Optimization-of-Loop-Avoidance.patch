+bool get_indirect_controller_probe_miss_threshold(uint32_t &threshold)
+{
+    int configured_threshold = DEFAULT_INDIRECT_CONTROLLER_PROBE_MISS_THRESHOLD;
+    if (cfg_get_prplmesh_param_int_default("indirect_controller_probe_miss_threshold",
+                                           &configured_threshold,
