@@ -290,9 +293,43 @@ bool ControllerConnectivityTask::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx,
     const auto ingress_iface = net::network_utils::linux_get_iface_name(iface_index);
     const bool received_on_active_bsta =
         !ingress_iface.empty() && ingress_iface == db->backhaul.selected_iface_name;
-    if (src_mac != net::network_utils::ZERO_MAC && src_mac == db->bridge.mac &&
-        db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
-        received_on_active_bsta) {
+    const bool locally_originated =
+        src_mac != net::network_utils::ZERO_MAC && src_mac == db->bridge.mac;
+    const bool wireless_backhaul =
+        db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless;
+    bool received_on_downstream_bsta = false;
+
+    if (locally_originated && wireless_backhaul && !received_on_active_bsta &&
+        !ingress_iface.empty()) {
+        for (const auto *radio : db->get_radios_list()) {
+            if (!radio) {
+                continue;
+            }
+
+            for (const auto &client_entry : radio->associated_clients) {
+                const auto &client = client_entry.second;
+                if (client.wds_iface_name != ingress_iface) {
+                    continue;
+                }
+
+                for (const auto &bss : radio->front.bssids) {
+                    if (bss.backhaul_bss && bss.mac == client.bssid) {
+                        received_on_downstream_bsta = true;
+                        break;
+                    }
+                }
+                if (received_on_downstream_bsta) {
+                    break;
+                }
+            }
+            if (received_on_downstream_bsta) {
+                break;
+            }
+        }
+    }
+
+    if (locally_originated && wireless_backhaul &&
+        (received_on_active_bsta || received_on_downstream_bsta)) {
         LOG(ERROR) << "Received locally originated IEEE 1905 frame; loop detected, src_mac="
                    << src_mac << ", dst_mac=" << dst_mac << ", ingress_iface="
                    << ingress_iface;
