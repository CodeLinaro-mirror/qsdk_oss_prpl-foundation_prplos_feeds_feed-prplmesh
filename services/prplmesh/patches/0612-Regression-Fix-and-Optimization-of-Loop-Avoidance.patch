                 m_direct_link_to_controller = true;
+                m_indirect_probe_waiting      = false;
+                if (m_indirect_probe_failed) {
+                    LOG(INFO) << "Direct controller link recovered; restoring controller reachability";
+                    m_indirect_probe_failed = false;
+                    m_btl_ctx.notify_controller_reachability(true);
+                }
             }
         }
 
@@ -358,14 +401,16 @@ bool ControllerConnectivityTask::check_indirect_controller_health()
     auto now = std::chrono::steady_clock::now();
     auto last_contact = db->controller_info.last_controller_contact_time;
 
-    // Any controller traffic received after the probe was sent is treated as
-    // a successful response for the current probe epoch.
-    if (m_indirect_probe_waiting && last_contact > m_last_indirect_probe_contact_time) {
+    // Any fresh controller traffic proves reachability, including traffic received
+    // between probes. Track it independently of the current probe state.
+    if (last_contact > m_last_observed_controller_contact_time) {
+        m_last_observed_controller_contact_time = last_contact;
         m_indirect_probe_waiting = false;
-        // Restore hop count only when leaving a failed sequence. Successful
-        // probes while already healthy do not update the AP managers.
+        m_indirect_probe_miss_count = 0;
+        // Restore hop count only when leaving a failed HLE sequence. Controller
+        // traffic while already healthy does not update the AP managers.
         if (m_indirect_probe_failed) {
-            LOG(INFO) << "Controller HLE probe recovered; restoring controller reachability";
+            LOG(INFO) << "Controller traffic recovered; restoring controller reachability";
             m_btl_ctx.notify_controller_reachability(true);
             m_indirect_probe_failed = false;
         }
@@ -375,9 +420,15 @@ bool ControllerConnectivityTask::check_indirect_controller_health()
         std::chrono::duration_cast<std::chrono::seconds>(now - m_last_indirect_probe_send_time) >=
             HEARTBEAT_RESPONSE_TIMEOUT_SEC) {
         m_indirect_probe_waiting = false;
-        // Advertise hop_count=255 only when entering a failed sequence.
-        if (!m_indirect_probe_failed) {
-            LOG(WARNING) << "First indirect controller HLE probe missed; advertising hop_count=255";
+        const auto miss_threshold = db->device_conf.indirect_controller_probe_miss_threshold;
+        if (m_indirect_probe_miss_count < miss_threshold) {
+            ++m_indirect_probe_miss_count;
+        }
+        // Advertise hop_count=255 only after the configured consecutive misses.
+        if (!m_indirect_probe_failed && m_indirect_probe_miss_count >= miss_threshold) {
+            LOG(WARNING) << "Indirect controller HLE probe miss threshold reached ("
+                         << m_indirect_probe_miss_count
+                         << "); advertising hop_count=255";
             m_btl_ctx.notify_controller_reachability(false);
             m_indirect_probe_failed = true;
         }
@@ -387,7 +438,6 @@ bool ControllerConnectivityTask::check_indirect_controller_health()
         std::chrono::duration_cast<std::chrono::seconds>(now - m_last_indirect_probe_send_time) >=
             HEARTBEAT_SENDING_PERIOD_SEC) {
         m_last_indirect_probe_send_time    = now;
-        m_last_indirect_probe_contact_time = last_contact;
         m_indirect_probe_waiting           = true;
         if (send_hle_to_controller()) {
             LOG(DEBUG) << "Sending proactive controller HLE probe for indirect agent";
