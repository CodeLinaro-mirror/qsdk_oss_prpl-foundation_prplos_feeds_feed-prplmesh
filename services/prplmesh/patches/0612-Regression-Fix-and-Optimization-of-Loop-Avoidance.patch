+bool get_indirect_controller_probe_miss_threshold(uint32_t &threshold)
+{
+    threshold = DEFAULT_INDIRECT_CONTROLLER_PROBE_MISS_THRESHOLD;
+    if (!read_agent_config_param("IndirectControllerProbeMissThreshold", threshold)) {
+        MAPF_ERR("Failed to read IndirectControllerProbeMissThreshold; using default");
+        return false;
+    }
+
+    if (threshold < 1 || threshold > 255) {
+        MAPF_ERR("IndirectControllerProbeMissThreshold must be in [1, 255]; using default");
+        threshold = DEFAULT_INDIRECT_CONTROLLER_PROBE_MISS_THRESHOLD;
+        return false;
+    }
+    return true;
+}
