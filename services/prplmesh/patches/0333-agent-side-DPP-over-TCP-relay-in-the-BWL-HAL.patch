diff --git a/common/beerocks/bwl/nl80211/dpp_relay_socket.cpp b/common/beerocks/bwl/nl80211/dpp_relay_socket.cpp
new file mode 100644
index 000000000..b934bc097
--- /dev/null
+++ b/common/beerocks/bwl/nl80211/dpp_relay_socket.cpp
@@ -0,0 +1,278 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include <bwl/dpp_relay_socket.h>
+#include <bwl/slave_wlan_hal.h>
+
+#include <easylogging++.h>
+
+#include <arpa/inet.h>
+#include <cerrno>
+#include <cstring>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace bwl {
+
+namespace {
+/** Maximum DPP TCP frame payload size (sanity check). */
+constexpr uint32_t DPP_MAX_FRAME_LEN = 8192;
+} // namespace
+
+dpp_relay_socket::dpp_relay_socket(event_cb_t cb) : m_cb(std::move(cb)) {}
+
+dpp_relay_socket::~dpp_relay_socket() { stop(); }
+
+bool dpp_relay_socket::init()
+{
+    if (m_server_fd >= 0) {
+        return true;
+    }
+
+    m_server_fd = ::socket(AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (m_server_fd < 0) {
+        LOG(ERROR) << "DPP: failed to create TCP server socket: " << strerror(errno);
+        return false;
+    }
+
+    int opt = 1;
+    ::setsockopt(m_server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
+
+    struct sockaddr_in addr = {};
+    addr.sin_family         = AF_INET;
+    addr.sin_addr.s_addr    = htonl(INADDR_LOOPBACK); // 127.0.0.1
+    addr.sin_port           = htons(DPP_TCP_PORT);
+
+    if (::bind(m_server_fd, reinterpret_cast<struct sockaddr *>(&addr), sizeof(addr)) < 0) {
+        LOG(ERROR) << "DPP: bind to 127.0.0.1:" << DPP_TCP_PORT << " failed: " << strerror(errno);
+        ::close(m_server_fd);
+        m_server_fd = -1;
+        return false;
+    }
+
+    if (::listen(m_server_fd, 5) < 0) {
+        LOG(ERROR) << "DPP: listen failed: " << strerror(errno);
+        ::close(m_server_fd);
+        m_server_fd = -1;
+        return false;
+    }
+
+    LOG(INFO) << "DPP: TCP server listening on 127.0.0.1:" << DPP_TCP_PORT
+              << " (fd=" << m_server_fd << ")";
+    return true;
+}
+
+void dpp_relay_socket::stop()
+{
+    close_client();
+
+    if (m_server_fd >= 0) {
+        ::close(m_server_fd);
+        m_server_fd = -1;
+        LOG(INFO) << "DPP: TCP server socket closed";
+    }
+}
+
+int dpp_relay_socket::get_listen_fd() const { return m_server_fd; }
+
+int dpp_relay_socket::get_client_fd() const { return m_client_fd; }
+
+bool dpp_relay_socket::process_events(int fd)
+{
+    LOG(DEBUG) << "DPP: process_events fd=" << fd << " (server_fd=" << m_server_fd
+               << ", client_fd=" << m_client_fd << ")";
+    if (fd == m_server_fd) {
+        return handle_accept();
+    }
+    if (fd == m_client_fd) {
+        return handle_client_read();
+    }
+    LOG(DEBUG) << "DPP: process_events fd=" << fd << " matches neither server nor client fd";
+    return false;
+}
+
+bool dpp_relay_socket::send_frame(uint8_t tcp_type, const uint8_t *frame, size_t frame_len)
+{
+    if (m_client_fd < 0) {
+        LOG(ERROR) << "DPP: send_frame() called but no active TCP connection";
+        return false;
+    }
+
+    // Build TCP frame: [4-byte length BE][1-byte type][raw frame]
+    uint32_t payload_len = static_cast<uint32_t>(1 + frame_len);
+
+    std::vector<uint8_t> buf;
+    buf.reserve(4 + 1 + frame_len);
+
+    buf.push_back(static_cast<uint8_t>((payload_len >> 24) & 0xFF));
+    buf.push_back(static_cast<uint8_t>((payload_len >> 16) & 0xFF));
+    buf.push_back(static_cast<uint8_t>((payload_len >> 8) & 0xFF));
+    buf.push_back(static_cast<uint8_t>(payload_len & 0xFF));
+    buf.push_back(tcp_type);
+    buf.insert(buf.end(), frame, frame + frame_len);
+
+    size_t written = 0;
+    while (written < buf.size()) {
+        ssize_t ret = ::write(m_client_fd, buf.data() + written, buf.size() - written);
+        if (ret < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            LOG(ERROR) << "DPP: write() to hostapd TCP socket failed: " << strerror(errno);
+            close_client();
+            return false;
+        }
+        written += static_cast<size_t>(ret);
+    }
+
+    LOG(DEBUG) << "DPP: sent " << buf.size() << " bytes to hostapd"
+               << " (type=0x" << std::hex << static_cast<int>(tcp_type) << std::dec
+               << ", frame_len=" << frame_len << ")";
+    return true;
+}
+
+bool dpp_relay_socket::is_client_connected() const { return m_client_fd >= 0; }
+
+bool dpp_relay_socket::handle_accept()
+{
+    struct sockaddr_in peer_addr = {};
+    socklen_t peer_len           = sizeof(peer_addr);
+
+    int client_fd = ::accept4(m_server_fd, reinterpret_cast<struct sockaddr *>(&peer_addr),
+                               &peer_len, SOCK_NONBLOCK | SOCK_CLOEXEC);
+
+    if (client_fd < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            LOG(DEBUG) << "DPP: handle_accept: spurious wakeup on server_fd=" << m_server_fd;
+            return true; // spurious wakeup
+        }
+        LOG(ERROR) << "DPP: accept() failed: " << strerror(errno) << ", restarting relay";
+        stop();
+        return init();
+    }
+
+    // Single-Enrollee policy: reject new connections if one is already active.
+    if (m_client_fd >= 0) {
+        LOG(WARNING) << "DPP: Rejecting new connection (fd=" << client_fd
+                     << ") — session already active on fd=" << m_client_fd;
+        ::close(client_fd);
+        return true;
+    }
+
+    m_client_fd = client_fd;
+    m_rx_buf.clear();
+
+    LOG(INFO) << "DPP: hostapd connected to relay (fd=" << m_client_fd << ")";
+    if (m_cb) {
+        m_cb(Event::ClientConnected, 0, {});
+    }
+    return true;
+}
+
+/** Loops on read() until EAGAIN or an actual disconnect/error is observed. A single read()
+ * is not enough: hostapd sends its final frame and closes the socket immediately afterward
+ * (dpp_tcp.c's on_tcp_tx_complete_remove path), so the data and the EOF routinely arrive in
+ * the same readiness notification. Stopping after one successful read (as before) drained the
+ * frame but left the peer's FIN unobserved, so m_client_fd was never closed and every
+ * subsequent connection attempt was rejected forever by the single-Enrollee check below. */
+bool dpp_relay_socket::handle_client_read()
+{
+    uint8_t tmp[4096];
+    bool disconnected = false;
+
+    while (true) {
+        ssize_t n = ::read(m_client_fd, tmp, sizeof(tmp));
+
+        if (n > 0) {
+            LOG(DEBUG) << "DPP: handle_client_read fd=" << m_client_fd << " read() returned " << n;
+            m_rx_buf.insert(m_rx_buf.end(), tmp, tmp + n);
+            continue;
+        }
+
+        if (n == 0) {
+            LOG(INFO) << "DPP: hostapd closed TCP connection (fd=" << m_client_fd << ")";
+            disconnected = true;
+            break;
+        }
+
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            break; // no more data for now
+        }
+        LOG(ERROR) << "DPP: read() error: " << strerror(errno);
+        disconnected = true;
+        break;
+    }
+
+    std::vector<std::pair<uint8_t, std::vector<uint8_t>>> frames;
+    reassemble_frames(frames);
+    LOG(DEBUG) << "DPP: handle_client_read reassembled " << frames.size() << " complete frame(s), "
+               << m_rx_buf.size() << " byte(s) remaining in rx buffer";
+    dispatch_frames(frames);
+
+    if (disconnected) {
+        close_client();
+        LOG(INFO) << "DPP: hostapd disconnected from relay";
+        if (m_cb) {
+            m_cb(Event::ClientDisconnected, 0, {});
+        }
+    }
+    return true;
+}
+
+void dpp_relay_socket::close_client()
+{
+    LOG(DEBUG) << "DPP: close_client fd=" << m_client_fd;
+    if (m_client_fd >= 0) {
+        ::close(m_client_fd);
+        m_client_fd = -1;
+        m_rx_buf.clear();
+        LOG(INFO) << "DPP: TCP client connection closed";
+    }
+}
+
+/** Reassemble complete [4B BE len][1B type][frame] frames out of m_rx_buf. */
+void dpp_relay_socket::reassemble_frames(
+    std::vector<std::pair<uint8_t, std::vector<uint8_t>>> &out_frames)
+{
+    while (m_rx_buf.size() >= 5) { // minimum: 4-byte length + 1-byte type
+
+        uint32_t payload_len = (static_cast<uint32_t>(m_rx_buf[0]) << 24) |
+                               (static_cast<uint32_t>(m_rx_buf[1]) << 16) |
+                               (static_cast<uint32_t>(m_rx_buf[2]) << 8) |
+                               (static_cast<uint32_t>(m_rx_buf[3]));
+
+        if (payload_len == 0 || payload_len > DPP_MAX_FRAME_LEN) {
+            LOG(ERROR) << "DPP: invalid frame length=" << payload_len << ", discarding buffer";
+            m_rx_buf.clear();
+            break;
+        }
+
+        if (m_rx_buf.size() < 4 + payload_len) {
+            break; // partial frame, wait for more data
+        }
+
+        uint8_t type_byte        = m_rx_buf[4];
+        const uint8_t *raw_frame = m_rx_buf.data() + 5;
+        size_t raw_frame_len     = payload_len - 1;
+
+        out_frames.emplace_back(type_byte,
+                                 std::vector<uint8_t>(raw_frame, raw_frame + raw_frame_len));
+
+        m_rx_buf.erase(m_rx_buf.begin(), m_rx_buf.begin() + 4 + payload_len);
+    }
+}
+
+void dpp_relay_socket::dispatch_frames(
+    const std::vector<std::pair<uint8_t, std::vector<uint8_t>>> &frames)
+{
+    if (!m_cb) {
+        return;
+    }
+    for (const auto &frame : frames) {
+        m_cb(Event::FrameReceived, frame.first, frame.second);
+    }
+}
