+        // Write connector
+        {
+            FILE *f = fopen("/tmp/prplmesh_dpp_connector", "w");
+            if (f) { fputs(creds->connector_1905, f); fclose(f); }
+            else { LOG(ERROR) << "DPP: failed to write /tmp/prplmesh_dpp_connector"; }
+        }
+        // Write NAK private key (binary DER)
+        {
+            FILE *f = fopen("/tmp/prplmesh_dpp_nak", "wb");
+            if (f) { fwrite(creds->nak_private_der, 1, creds->nak_private_der_len, f); fclose(f); }
+            else { LOG(ERROR) << "DPP: failed to write /tmp/prplmesh_dpp_nak"; }
+        }
+        // Write c-sign-key JWK
+        {
+            FILE *f = fopen("/tmp/prplmesh_dpp_csign", "w");
+            if (f) { fputs(creds->c_sign_key_jwk, f); fclose(f); }
+            else { LOG(ERROR) << "DPP: failed to write /tmp/prplmesh_dpp_csign"; }
+        }
+        // Write marker file last — son_slave_thread polls for this
+        {
+            FILE *f = fopen("/tmp/prplmesh_dpp_creds_ready", "w");
+            if (f) { fputs("1", f); fclose(f); }
+            else { LOG(ERROR) << "DPP: failed to write /tmp/prplmesh_dpp_creds_ready"; }
+        }
+        LOG(INFO) << "DPP: wireless credentials written to /tmp/prplmesh_dpp_creds_ready";
+    } break;
     // Unhandled events
     default:
         LOG(ERROR) << "Unhandled event: " << int(event);
