+     */
+    virtual bool dpp_send_frame(uint8_t tcp_type, const uint8_t *frame, size_t frame_len)
+    {
+        return false;
+    }
+
+    /**
+     * @brief Returns true if hostapd is currently connected to the DPP relay.
+     */
