diff --git a/common/beerocks/bwl/include/bwl/dpp_relay_socket.h b/common/beerocks/bwl/include/bwl/dpp_relay_socket.h
new file mode 100644
index 000000000..689692526
--- /dev/null
+++ b/common/beerocks/bwl/include/bwl/dpp_relay_socket.h
@@ -0,0 +1,86 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _BWL_DPP_RELAY_SOCKET_H_
+#define _BWL_DPP_RELAY_SOCKET_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace bwl {
+
+/**
+ * @brief Shared raw-socket engine for the DPP-over-TCP relay (127.0.0.1:DPP_TCP_PORT) that
+ * hostapd connects to. Platform-agnostic: has no knowledge of base_wlan_hal/HALType/BWL_TYPE.
+ * A backend (e.g. slave_wlan_hal_nl80211) owns an instance of this class and drives it by
+ * registering its fd (get_fd()) with the event loop and calling process_events() on readiness.
+ */
+class dpp_relay_socket {
+public:
+    enum class Event { Invalid = 0, ClientConnected, ClientDisconnected, FrameReceived };
+
+    using event_cb_t =
+        std::function<void(Event event, uint8_t tcp_type, const std::vector<uint8_t> &frame)>;
+
+    explicit dpp_relay_socket(event_cb_t cb);
+    ~dpp_relay_socket();
+
+    /**
+     * @brief Bind and listen on 127.0.0.1:DPP_TCP_PORT.
+     */
+    bool init();
+
+    /**
+     * @brief Close the listening socket and any active client connection.
+     */
+    void stop();
+
+    /**
+     * @brief Returns the listening fd (bound/listening socket), or -1 if not initialized.
+     * Should be monitored for readiness at all times while initialized, independently of
+     * whether a client is currently connected — this is what lets a new connection attempt
+     * be accept()ed (and rejected, per the single-Enrollee policy) instead of completing the
+     * TCP handshake at the kernel level while nobody calls accept() on it.
+     */
+    int get_listen_fd() const;
+
+    /**
+     * @brief Returns the active client fd, or -1 if no client is currently connected.
+     */
+    int get_client_fd() const;
+
+    /**
+     * @brief Process readiness on the given fd — dispatches to accept() handling if @p fd is
+     * the listening fd, or to client read handling if @p fd is the active client fd.
+     */
+    bool process_events(int fd);
+
+    /**
+     * @brief Send a raw DPP frame to the active client connection.
+     */
+    bool send_frame(uint8_t tcp_type, const uint8_t *frame, size_t frame_len);
+
+    /**
+     * @brief Returns true if a client is currently connected.
+     */
+    bool is_client_connected() const;
+
+private:
+    bool handle_accept();
+    bool handle_client_read();
+    void close_client();
+    void reassemble_frames(std::vector<std::pair<uint8_t, std::vector<uint8_t>>> &out_frames);
+    void dispatch_frames(const std::vector<std::pair<uint8_t, std::vector<uint8_t>>> &frames);
+
+    event_cb_t m_cb;
+    int m_server_fd = -1;
+    int m_client_fd = -1;
+    std::vector<uint8_t> m_rx_buf;
+};
+
+} // namespace bwl
+
+#endif // _BWL_DPP_RELAY_SOCKET_H_
