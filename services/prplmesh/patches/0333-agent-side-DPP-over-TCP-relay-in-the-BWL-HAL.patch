+
+void slave_wlan_hal_nl80211::on_dpp_socket_event(dpp_relay_socket::Event event, uint8_t tcp_type,
+                                                  const std::vector<uint8_t> &frame)
+{
+    switch (event) {
+    case dpp_relay_socket::Event::FrameReceived:
+        event_queue_push(Event::Dpp_Frame_Received,
+                          std::make_shared<sDppFrameEvent>(sDppFrameEvent{tcp_type, frame}));
+        break;
+    case dpp_relay_socket::Event::ClientConnected:
+        event_queue_push(Event::Dpp_Client_Connected);
+        break;
+    case dpp_relay_socket::Event::ClientDisconnected:
+        event_queue_push(Event::Dpp_Client_Disconnected);
+        break;
+    default:
+        break;
+    }
+}
+
+void slave_wlan_hal_nl80211::sync_dpp_fd_registration()
+{
+    // The listening fd and the active client fd (if any) are independent and must both stay
+    // registered with the event loop at all times — this is what lets handle_accept() run (and
+    // reject extra connections per the single-Enrollee policy) even while a client is already
+    // connected, instead of new connection attempts completing the TCP handshake at the kernel
+    // level and piling up in the listen backlog unseen.
+    int new_listen_fd = m_dpp_socket ? m_dpp_socket->get_listen_fd() : -1;
+    int new_client_fd = m_dpp_socket ? m_dpp_socket->get_client_fd() : -1;
+    LOG(DEBUG) << "DPP: sync_dpp_fd_registration listen_fd " << m_dpp_listen_fd_registered
+               << " -> " << new_listen_fd << ", client_fd " << m_dpp_client_fd_registered << " -> "
+               << new_client_fd;
+
+    if (new_listen_fd != m_dpp_listen_fd_registered) {
+        if (m_dpp_listen_fd_registered >= 0) {
+            LOG(DEBUG) << "DPP: unregistering listen ext event fd=" << m_dpp_listen_fd_registered;
+            event_queue_push(Event::Unregister_Ext_Event_Fd,
+                              std::make_shared<int>(m_dpp_listen_fd_registered));
+        }
+        if (new_listen_fd >= 0) {
+            LOG(DEBUG) << "DPP: registering listen ext event fd=" << new_listen_fd;
+            event_queue_push(Event::Register_Ext_Event_Fd, std::make_shared<int>(new_listen_fd));
+        }
+        m_dpp_listen_fd_registered = new_listen_fd;
+    }
+
+    if (new_client_fd != m_dpp_client_fd_registered) {
+        if (m_dpp_client_fd_registered >= 0) {
+            LOG(DEBUG) << "DPP: unregistering client ext event fd=" << m_dpp_client_fd_registered;
+            event_queue_push(Event::Unregister_Ext_Event_Fd,
+                              std::make_shared<int>(m_dpp_client_fd_registered));
+        }
+        if (new_client_fd >= 0) {
+            LOG(DEBUG) << "DPP: registering client ext event fd=" << new_client_fd;
+            event_queue_push(Event::Register_Ext_Event_Fd, std::make_shared<int>(new_client_fd));
+        }
+        m_dpp_client_fd_registered = new_client_fd;
+    }
+}
