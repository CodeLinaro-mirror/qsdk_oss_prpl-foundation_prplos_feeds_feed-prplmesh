From 12cdbd5740570bf942deb910464113848bcfae31 Mon Sep 17 00:00:00 2001
From: Gnanaprakash Elumalai <gelumala@qti.qualcomm.com>
Date: Thu, 18 Jun 2026 19:42:53 +0530
Subject: [PATCH] [PATCH] prplmesh: Disable duplicate unassoc query forwarding
 in son_slave_thread

handle_unassoc_sta_link_metric_query() in son_slave_thread forwards the raw
1905 UNASSOCIATED_STA_LINK_METRICS_QUERY_MESSAGE CMDU to all monitors. This
runs in parallel with LinkMetricsCollectionTask which sends the proper beerocks
VS message (ACTION_MONITOR_CLIENT_UNASSOCIATED_STA_LINK_METRIC_REQUEST).

The raw 1905 forwarding causes two problems:
1. Monitors log "Unknown CMDU message type: 0x800f"
2. It interferes with the scan state machine of the monitor already processing
   the beerocks VS request from LinkMetricsCollectionTask

Since LinkMetricsCollectionTask (patch 0205) handles this completely, the
legacy raw forwarding in son_slave_thread must be disabled.

Signed-off-by: Gnanaprakash Elumalai <gelumala@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp | 14 +++++---------
 1 file changed, 5 insertions(+), 9 deletions(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index f4dac425c..17b16b7a0 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -6640,15 +6640,11 @@ bool slave_thread::handle_beacon_metrics_query(int fd, ieee1905_1::CmduMessageRx
 
 bool slave_thread::handle_unassoc_sta_link_metric_query(int fd, ieee1905_1::CmduMessageRx &cmdu_rx)
 {
-    auto db = AgentDB::get();
-    for (auto radio : db->get_radios_list()) {
-        if (!forward_cmdu_to_uds(m_radio_managers[radio->front.iface_name].monitor_fd,
-                                 cmdu_rx)) {
-            LOG(ERROR) << "Failed sending UNASSOCIATED_STA_LINK_METRICS_QUERY_MESSAGE message to "
-                          "monitor_socket ";
-        }
-    }
-
+    /* Handling moved to LinkMetricsCollectionTask which filters by radio, checks op_class,
+     * and sends beerocks VS messages (not raw 1905) to monitors.
+     * Forwarding raw 1905 here causes "Unknown CMDU message type" in monitors and
+     * interferes with the ongoing scan state machine. */
+    LOG(DEBUG) << "handle_unassoc_sta_link_metric_query: delegated to LinkMetricsCollectionTask";
     return true;
 }
 
