From 2722043fde34d51dd5aaa04481371d58d19189e3 Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Wed, 16 Sep 2026 17:01:30 +0530
Subject: [PATCH] Fix for Wired Onboarding failure

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 framework/platform/bpl/cfg/dm/bpl_cfg.cpp | 28 ++++++++++++++++-------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
index 04bcb4e81..b92e8d2ec 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
@@ -757,19 +757,31 @@ bool cfg_get_dhcp_gateway_ip(const std::string &iface, std::string &gw_ip)
     for (const auto &client_path : client_paths) {
         MAPF_DBG("cfg_get_dhcp_gateway_ip: Checking client path: " << client_path);
 
-        std::string client_iface;
-        if (!m_ambiorix_cl_ubus.get_param(client_iface, client_path, "Interface")) {
+        std::string client_iface_path;
+        if (!m_ambiorix_cl_ubus.get_param(client_iface_path, client_path, "Interface")) {
             MAPF_DBG("cfg_get_dhcp_gateway_ip: Failed to read Interface for " << client_path);
             continue;
         }
 
-        // Exact match required: a substring check here (e.g. client_iface.find(iface))
-        // would false-positive when iface is a suffix of an unrelated interface name,
-        // such as requested iface "lan" matching client_iface "wlan0".
-        if (client_iface != iface) {
+        if (client_iface_path.empty()) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Empty Interface for " << client_path);
+            continue;
+        }
+        if (client_iface_path.back() != '.') {
+            client_iface_path.push_back('.');
+        }
+
+        std::string client_iface_name;
+        if (!m_ambiorix_cl_ubus.get_param(client_iface_name, client_iface_path, "Name")) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Failed to read Name for Interface "
+                     << client_iface_path << " from " << client_path);
+            continue;
+        }
+
+        if (client_iface_name != iface) {
             MAPF_DBG("cfg_get_dhcp_gateway_ip: Client "
-                      << client_path << " Interface " << client_iface
-                      << " does not match requested iface " << iface);
+                     << client_path << " Interface " << client_iface_path << " Name "
+                     << client_iface_name << " does not match requested iface " << iface);
             continue;
         }
 
-- 
