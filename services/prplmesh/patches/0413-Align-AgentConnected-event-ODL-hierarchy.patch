From 11dc8ef0ac7a3a9c69dd29f4b190c86e564fc8af Mon Sep 17 00:00:00 2001
From: Jain Roy <jambi@qti.qualcomm.com>
Date: Wed, 9 Sep 2026 13:37:59 +0530
Subject: [PATCH] Align AgentConnected event ODL hierarchy

Signed-off-by: Jain Roy <jambi@qti.qualcomm.com>
---
 .../nbapi/odl/agent_connected_event.odl.in    | 44 +++++-----
 .../nbapi/odl/agent_disconnected_event.odl.in | 82 ++++++++++---------
 controller/nbapi/odl/controller.odl.in        |  3 -
 3 files changed, 65 insertions(+), 64 deletions(-)

diff --git a/controller/nbapi/odl/agent_connected_event.odl.in b/controller/nbapi/odl/agent_connected_event.odl.in
index f48afe947..0a8f67f32 100644
--- a/controller/nbapi/odl/agent_connected_event.odl.in
+++ b/controller/nbapi/odl/agent_connected_event.odl.in
@@ -8,32 +8,34 @@
  */
 
 %define {
-    select @CONTROLLER_ROOT_DM@.AgentConnectedEvent {
-        %read-only object AgentConnected [] {
-            counted with AgentConnectedNumberOfEntries;
-            %read-only string ID = "00:00:00:00:00:00";
-            %read-only datetime TimeStamp = "2020-08-31T11:22:39Z";
-
-            %read-only object Radio [] {
-                counted with RadioNumberOfEntries;
+    select @CONTROLLER_ROOT_DM@ {
+        %read-only object AgentConnectedEvent {
+            %read-only object AgentConnected [] {
+                counted with AgentConnectedNumberOfEntries;
                 %read-only string ID = "00:00:00:00:00:00";
+                %read-only datetime TimeStamp = "2020-08-31T11:22:39Z";
+
+                %read-only object Radio [] {
+                    counted with RadioNumberOfEntries;
+                    %read-only string ID = "00:00:00:00:00:00";
 
-                %read-only object BSS [] {
-                    counted with BSSNumberOfEntries;
-                    %read-only string BSSID = "00:00:00:00:00:00";
-                    %read-only string SSID = "0";
+                    %read-only object BSS [] {
+                        counted with BSSNumberOfEntries;
+                        %read-only string BSSID = "00:00:00:00:00:00";
+                        %read-only string SSID = "0";
 
-                    %read-only object STA [] {
-                        counted with STANumberOfEntries;
-                        %read-only string MACAddress = "00:00:00:00:00:00";
-                        %read-only datetime TimeStamp = "2020-08-31T11:22:39Z";
-                        %read-only uint32 LastConnectTime = 0;
+                        %read-only object STA [] {
+                            counted with STANumberOfEntries;
+                            %read-only string MACAddress = "00:00:00:00:00:00";
+                            %read-only datetime TimeStamp = "2020-08-31T11:22:39Z";
+                            %read-only uint32 LastConnectTime = 0;
+                        }
                     }
                 }
-            }
-            %read-only object Neighbor [] {
-                counted with NeighborNumberOfEntries;
-                %read-only string ID = "00:00:00:00:00:00";
+                %read-only object Neighbor [] {
+                    counted with NeighborNumberOfEntries;
+                    %read-only string ID = "00:00:00:00:00:00";
+                }
             }
         }
     }
diff --git a/controller/nbapi/odl/agent_disconnected_event.odl.in b/controller/nbapi/odl/agent_disconnected_event.odl.in
index eee52f405..eb8f8d10b 100644
--- a/controller/nbapi/odl/agent_disconnected_event.odl.in
+++ b/controller/nbapi/odl/agent_disconnected_event.odl.in
@@ -8,51 +8,53 @@
  */
 
 %define {
-    select @CONTROLLER_ROOT_DM@.AgentDisconnectedEvent {
-        %read-only object AgentDisconnected [] {
-            counted with AgentDisconnectedNumberOfEntries;
-            %read-only string ID = "00:00:00:00:00:00";
-
-            %read-only object Radio [] {
-                counted with RadioNumberOfEntries;
+    select @CONTROLLER_ROOT_DM@ {
+        %read-only object AgentDisconnectedEvent {
+            %read-only object AgentDisconnected [] {
+                counted with AgentDisconnectedNumberOfEntries;
                 %read-only string ID = "00:00:00:00:00:00";
-                %read-only uint32 Utilization = 0 {
-                    on action validate call check_range [0, 255];
-                }
-                %read-only uint32 Transmit = 0 {
-                    on action validate call check_range [0, 255];
-                }
-                %read-only uint32 ReceiveSelf = 0 {
-                    on action validate call check_range [0, 255];
-                }
-                %read-only uint32 ReceiveOther = 0 {
-                    on action validate call check_range [0, 255];
-                }
-                %read-only uint32 Noise = 0 {
-                    on action validate call check_range [0, 255];
-                }
 
-                %read-only object BSS [] {
-                    counted with BSSNumberOfEntries;
-                    %read-only string BSSID = "00:00:00:00:00:00";
-                    %read-only string SSID = "0";
-                    %read-only uint64 UnicastBytesSent = 0;
-                    %read-only uint64 UnicastBytesReceived = 0;
-                    %read-only uint64 MulticastBytesSent = 0;
-                    %read-only uint64 MulticastBytesReceived = 0;
-                    %read-only uint64 BroadcastBytesSent = 0;
-                    %read-only uint64 BroadcastBytesReceived = 0;
+                %read-only object Radio [] {
+                    counted with RadioNumberOfEntries;
+                    %read-only string ID = "00:00:00:00:00:00";
+                    %read-only uint32 Utilization = 0 {
+                        on action validate call check_range [0, 255];
+                    }
+                    %read-only uint32 Transmit = 0 {
+                        on action validate call check_range [0, 255];
+                    }
+                    %read-only uint32 ReceiveSelf = 0 {
+                        on action validate call check_range [0, 255];
+                    }
+                    %read-only uint32 ReceiveOther = 0 {
+                        on action validate call check_range [0, 255];
+                    }
+                    %read-only uint32 Noise = 0 {
+                        on action validate call check_range [0, 255];
+                    }
+
+                    %read-only object BSS [] {
+                        counted with BSSNumberOfEntries;
+                        %read-only string BSSID = "00:00:00:00:00:00";
+                        %read-only string SSID = "0";
+                        %read-only uint64 UnicastBytesSent = 0;
+                        %read-only uint64 UnicastBytesReceived = 0;
+                        %read-only uint64 MulticastBytesSent = 0;
+                        %read-only uint64 MulticastBytesReceived = 0;
+                        %read-only uint64 BroadcastBytesSent = 0;
+                        %read-only uint64 BroadcastBytesReceived = 0;
 
-                    %read-only object STA [] {
-                        counted with STANumberOfEntries;
-                        %read-only string MACAddress = "00:00:00:00:00:00";
-                        %read-only datetime TimeStamp = "2020-08-31T11:22:39Z";
+                        %read-only object STA [] {
+                            counted with STANumberOfEntries;
+                            %read-only string MACAddress = "00:00:00:00:00:00";
+                            %read-only datetime TimeStamp = "2020-08-31T11:22:39Z";
+                        }
                     }
                 }
-            }
-            %read-only object Neighbor [] {
-                counted with NeighborNumberOfEntries;
-                %read-only string ID = "00:00:00:00:00:00";
+                %read-only object Neighbor [] {
+                    counted with NeighborNumberOfEntries;
+                    %read-only string ID = "00:00:00:00:00:00";
+                }
             }
         }
     }
diff --git a/controller/nbapi/odl/controller.odl.in b/controller/nbapi/odl/controller.odl.in
index 9b169c38b..d28cd8725 100644
--- a/controller/nbapi/odl/controller.odl.in
+++ b/controller/nbapi/odl/controller.odl.in
@@ -472,9 +472,6 @@
                     }
                 }
 
-                %read-only object AgentConnectedEvent[];
-                %read-only object AgentDisconnectedEvent[];
-
     @CONTROLLER_ROOT_DM_Footer@
 
 
-- 
2.34.1

