+/**
+ * @brief Add BSS Advanced Configuration TLV to the AP-Autoconfiguration WSC (M2) message.
+ *
+ *        Per spec section 7.1.3 / Table 19: the controller may include this TLV alongside
+ *        the M2 WSC TLV to convey BSS-level settings (e.g., SSID advertisement).
+ *        BSS_Index is used for correlation since the BSSID is not yet assigned at this point.
+ *
+ * @param[out] cmdu_tx the message to add the TLV to
+ * @param[in]  ruid    radio UID of the radio being configured
+ * @param[in]  bss_info_confs list of BSS configurations that were sent in M2
+ * @return true on success
+ * @return false on failure
+ */
+static bool add_bss_advanced_configuration_tlv(
+    ieee1905_1::CmduMessageTx &cmdu_tx, const sMacAddr &ruid,
+    const std::list<wireless_utils::sBssInfoConf> &bss_info_confs)
+{
+    auto bss_adv_config = cmdu_tx.addClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config) {
+        LOG(ERROR) << "addClass wfa_map::tlvBssAdvancedConfiguration failed";
+        return false;
+    }
+
+    auto radio_entry = bss_adv_config->create_radios();
+    if (!radio_entry) {
+        LOG(ERROR) << "Failed creating radio entry in BSS Advanced Configuration TLV";
+        return false;
+    }
+    radio_entry->ruid() = ruid;
+
+    for (const auto &bss_info_conf : bss_info_confs) {
+        // Skip teardown entries — no BSS Advanced Configuration applies to them.
+        if (bss_info_conf.teardown) {
+            continue;
+        }
+
+        auto bss_entry = radio_entry->create_bsss();
+        if (!bss_entry) {
+            LOG(ERROR) << "Failed creating BSS entry in BSS Advanced Configuration TLV";
+            continue;
+        }
+
+        // Per spec Table 19: BSSID is ZERO_MAC when the BSSID is not yet assigned;
+        // the agent correlates by BSS_Index (unique within a radio).
+        bss_entry->bssid()     = beerocks::net::network_utils::ZERO_MAC;
+        bss_entry->bss_index() = bss_info_conf.bss_index;
+        bss_entry->bss_infos().ssid_advertisement =
+            static_cast<uint8_t>(bss_info_conf.ssid_advertisement ? 1 : 0);
+
+        LOG(DEBUG) << "BSS Advanced Config: bss_index=" << int(bss_info_conf.bss_index)
+                   << " ssid=" << bss_info_conf.ssid
+                   << " ssid_advertisement=" << int(bss_entry->bss_infos().ssid_advertisement);
+
+        if (!radio_entry->add_bsss(bss_entry)) {
+            LOG(ERROR) << "Failed adding BSS entry to radio in BSS Advanced Configuration TLV";
+        }
+    }
+
+    if (!bss_adv_config->add_radios(radio_entry)) {
+        LOG(ERROR) << "Failed adding radio entry to BSS Advanced Configuration TLV";
+        return false;
+    }
+
+    LOG(DEBUG) << "Added BSS Advanced Configuration TLV to AP_AUTOCONFIGURATION_WSC_MESSAGE"
+               << " for ruid=" << ruid;
+    return true;
+}
