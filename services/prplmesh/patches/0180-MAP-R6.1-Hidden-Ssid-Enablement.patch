                             const BssConfig &requested_bss)
 {
-    // TODO: bss_index matching (PPM-3625)
+    // If a BSS Index was assigned in the M2 and we already have a local BSSID, prefer matching by
+    // BSSID when the controller explicitly provided one. Otherwise correlate by BSS Index as
+    // mandated by the spec during onboarding.
+    if (requested_bss.payload_config.bssid != beerocks::net::network_utils::ZERO_MAC &&
+        requested_bss.payload_config.bssid != beerocks::net::network_utils::WILD_MAC) {
+        if (local_bss.mac == requested_bss.payload_config.bssid) {
+            return true;
