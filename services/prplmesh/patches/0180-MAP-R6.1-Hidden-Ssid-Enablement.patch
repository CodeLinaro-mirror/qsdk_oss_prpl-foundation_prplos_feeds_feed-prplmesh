+bool ApAutoConfigurationTask::handle_bss_advanced_configuration_tlv(
+    ieee1905_1::CmduMessageRx &cmdu_rx, std::vector<sBssConfig> &bss_infos)
+{
+    auto bss_adv_config = cmdu_rx.getClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config) {
+        LOG(DEBUG) << "No tlvBssAdvancedConfiguration TLV in AP MLD Configuration Request";
+        return true;
+    }
+
+    auto db = AgentDB::get();
+    LOG(DEBUG) << "Applying BSS Advanced Configuration TLV with "
+               << int(bss_adv_config->num_radio()) << " radio(s)";
+
+    for (auto radio_idx = 0; radio_idx < bss_adv_config->num_radio(); ++radio_idx) {
+
+        auto bss_adv_radio_tuple = bss_adv_config->radios(radio_idx);
+        bool valid = std::get<0>(bss_adv_radio_tuple);
+        wfa_map::cBssAdvancedConfigurationRadio &bss_adv_radio = std::get<1>(bss_adv_radio_tuple);
+
+        if (!valid) {
+            LOG(ERROR) << "Failed to get radio entry " << radio_idx
+                       << " from tlvBssAdvancedConfiguration";
+            continue;
+        }
+
+        auto radio = db->get_radio_by_mac(bss_adv_radio.ruid(), AgentDB::eMacType::RADIO);
+        if (!radio) {
+            LOG(WARNING) << "RUID " << bss_adv_radio.ruid() << " not found, skipping";
+            continue;
+        }
+
+        for (auto bss_idx = 0; bss_idx < bss_adv_radio.num_bss(); ++bss_idx) {
+
+            auto bss_adv_bss_tuple = bss_adv_radio.bsss(bss_idx);
+            bool bss_valid = std::get<0>(bss_adv_bss_tuple);
+            wfa_map::cBssAdvancedConfigurationBss &bss_adv_bss = std::get<1>(bss_adv_bss_tuple);
+
+            if (!bss_valid) {
+                LOG(ERROR) << "Failed to get BSS entry " << bss_idx
+                           << " from tlvBssAdvancedConfiguration";
+                continue;
+            }
+
+            // Store the hidden setting by radio/BSS_Index even when the BSSID does not exist yet.
+            // This is needed for new VAP creation: such entries still use wildcard BSSID after
+            // handle_bss_reconfiguration(), so immediate BSSID matching would only update already
+            // existing/fronthaul VAPs.
+            if (bss_adv_bss.bss_index() != 0) {
+                auto hidden_ssid = static_cast<bool>(bss_adv_bss.bss_infos().ssid_advertisement)
+                    ? WSC::eWscVendorExtHiddenSsid::DISABLED
+                    : WSC::eWscVendorExtHiddenSsid::ENABLED;
+                m_bss_index_hidden_ssid[radio->front.iface_name][bss_adv_bss.bss_index()] =
+                    hidden_ssid;
+
+                for (auto &info : bss_infos) {
+                    if (info.m2_config.bss_index == bss_adv_bss.bss_index()) {
+                        info.m2_config.hidden_ssid = hidden_ssid;
+                        LOG(DEBUG) << "BSS Advanced Config: stored/applied hidden_ssid="
+                                   << int(hidden_ssid)
+                                   << " for radio=" << radio->front.iface_name
+                                   << " bss_index=" << int(bss_adv_bss.bss_index())
+                                   << " bssid=" << info.payload_config.bssid;
+                    }
+                }
+            }
+
+            // Per spec Table 19: if BSSID is non-zero, use it for matching and ignore BSS_Index.
+            // Otherwise, correlate by BSS_Index: find the BSS described by the M2 frame that
+            // carries the same BSS_Index value, and apply the configuration to that BSS.
+            sMacAddr target_bssid = beerocks::net::network_utils::ZERO_MAC;
+
+            if (bss_adv_bss.bssid() != beerocks::net::network_utils::ZERO_MAC) {
+                // BSSID explicitly provided — use it directly.
+                target_bssid = bss_adv_bss.bssid();
+            } else if (bss_adv_bss.bss_index() != 0 && !bss_infos.empty()) {
+                // BSS_Index correlation: find the sBssConfig whose m2_config.bss_index matches.
+                // After handle_bss_reconfiguration(), payload_config.bssid is pinned to the
+                // local BSS MAC, so we can use it as the target.
+                for (const auto &info : bss_infos) {
+
+                    if (info.m2_config.bss_index == bss_adv_bss.bss_index() &&
+                        info.payload_config.bssid != beerocks::net::network_utils::ZERO_MAC &&
+                        info.payload_config.bssid != beerocks::net::network_utils::WILD_MAC) {
+                        target_bssid = info.payload_config.bssid;
+                        LOG(DEBUG) << "BSS Advanced Config: BSS_Index="
+                                   << int(bss_adv_bss.bss_index())
+                                   << " resolved to BSSID=" << target_bssid;
+                        break;
+                    }
+                }
+            }
+
+            if (target_bssid == beerocks::net::network_utils::ZERO_MAC) {
+                LOG(DEBUG) << "BSS Advanced Config: no matching BSS found for entry "
+                           << bss_idx << " (bssid=" << bss_adv_bss.bssid()
+                           << " bss_index=" << int(bss_adv_bss.bss_index()) << ")";
+                continue;
+            }
+
+            for (auto &bss : radio->front.bssids) {
+                if (bss.mac == target_bssid) {
+                    bss.ssid_advertisement =
+                        static_cast<bool>(bss_adv_bss.bss_infos().ssid_advertisement);
+                    LOG(DEBUG) << "Applied ssid_advertisement="
+                               << bss.ssid_advertisement << " to BSS " << bss.mac;
+
+                    // Also update hidden_ssid in bss_infos so send_ap_bss_configuration_message()
+                    // propagates the correct value to the HAL via the credentials update.
+                    // ssid_advertisement=true → SSID visible → hidden_ssid=DISABLED
+                    // ssid_advertisement=false → SSID hidden → hidden_ssid=ENABLED
+                    for (auto &info : bss_infos) {
+                        if (info.payload_config.bssid == target_bssid) {
+                            info.m2_config.hidden_ssid = bss.ssid_advertisement
+                                ? WSC::eWscVendorExtHiddenSsid::DISABLED
+                                : WSC::eWscVendorExtHiddenSsid::ENABLED;
+                            LOG(DEBUG) << "Updated hidden_ssid="
+                                       << int(info.m2_config.hidden_ssid)
+                                       << " in bss_infos for BSSID=" << target_bssid;
+                            break;
+                        }
+                    }
+
+                    break;
+                }
+            }
+        }
+    }
+
+    return true;
+}
+
+bool ApAutoConfigurationTask::handle_bss_advanced_configuration_tlv(
+    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // Overload without bss_infos: used when called from AP MLD Configuration Request handler
+    // where there are no M2 bss_infos to update.
+    std::vector<sBssConfig> empty_bss_infos;
+    return handle_bss_advanced_configuration_tlv(cmdu_rx, empty_bss_infos);
+}
+
+bool ApAutoConfigurationTask::add_bss_advanced_configuration_report_tlv(
+    ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto db = AgentDB::get();
+
+    auto bss_adv_config_report = cmdu_tx.addClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config_report) {
+        LOG(ERROR) << "addClass wfa_map::tlvBssAdvancedConfiguration failed";
+        return false;
+    }
+
+    for (const auto &radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        auto radio_entry = bss_adv_config_report->create_radios();
+        if (!radio_entry) {
+            LOG(ERROR) << "Failed creating radio entry in BSS Advanced Configuration TLV";
+            continue;
+        }
+        radio_entry->ruid() = radio->front.iface_mac;
+
+        for (const auto &bss : radio->front.bssids) {
+            if (bss.mac == beerocks::net::network_utils::ZERO_MAC) {
+                continue;
+            }
+
+            auto bss_entry = radio_entry->create_bsss();
+            if (!bss_entry) {
+                LOG(ERROR) << "Failed creating BSS entry in BSS Advanced Configuration TLV";
+                continue;
+            }
+
+            bss_entry->bssid()     = bss.mac;
+            bss_entry->bss_index() = 0;
+            bss_entry->bss_infos().ssid_advertisement =
+                static_cast<uint8_t>(bss.ssid_advertisement);
+
+            if (!radio_entry->add_bsss(bss_entry)) {
+                LOG(ERROR) << "Failed adding BSS entry to radio in BSS Advanced Configuration TLV";
+            }
+        }
+
+        if (!bss_adv_config_report->add_radios(radio_entry)) {
+            LOG(ERROR) << "Failed adding radio entry to BSS Advanced Configuration TLV";
+        }
+    }
+
+    LOG(DEBUG) << "Added BSS Advanced Configuration TLV to AP MLD Configuration Response";
+    return true;
+}
+
+bool ApAutoConfigurationTask::send_bss_configuration_extended_report_message()
+{
+    // Per spec section 7.1.3: send BSS Configuration Extended Report message with
+    // BSS Advanced Configuration TLV reporting the settings actually applied on the BSS(s).
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE)) {
+        LOG(ERROR) << "cmdu creation of type BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE has failed";
+        return false;
+    }
+
+    if (!add_bss_advanced_configuration_report_tlv(m_cmdu_tx)) {
+        LOG(ERROR) << "Failed to add BSS Advanced Configuration TLV to BSS Configuration Extended Report";
+        return false;
+    }
+
+    LOG(DEBUG) << "Sending BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE to controller";
+    return m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+}
