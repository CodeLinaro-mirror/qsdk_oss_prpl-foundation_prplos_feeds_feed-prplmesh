+bool Controller::handle_cmdu_1905_bss_configuration_extended_report_message(
+    const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    const auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE from " << src_mac
+              << ", mid=" << std::dec << int(mid);
+
+    // Parse the BSS Advanced Configuration TLV from the report
+    auto bss_adv_config = cmdu_rx.getClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config) {
+        LOG(DEBUG) << "No tlvBssAdvancedConfiguration TLV in BSS_CONFIGURATION_EXTENDED_REPORT";
+        return true;
+    }
+
+    LOG(DEBUG) << "BSS Advanced Configuration Report with "
+               << int(bss_adv_config->num_radio()) << " radio(s)";
+
+    // Update the controller's database with the reported ssid_advertisement values
+    for (auto radio_idx = 0; radio_idx < bss_adv_config->num_radio(); ++radio_idx) {
+        auto bss_adv_radio_tuple = bss_adv_config->radios(radio_idx);
+        bool valid = std::get<0>(bss_adv_radio_tuple);
+        wfa_map::cBssAdvancedConfigurationRadio &bss_adv_radio = std::get<1>(bss_adv_radio_tuple);
+
+        if (!valid) {
+            LOG(ERROR) << "Failed to get radio entry " << radio_idx;
+            continue;
+        }
+
+        for (auto bss_idx = 0; bss_idx < bss_adv_radio.num_bss(); ++bss_idx) {
+            auto bss_adv_bss_tuple = bss_adv_radio.bsss(bss_idx);
+            bool bss_valid = std::get<0>(bss_adv_bss_tuple);
+            wfa_map::cBssAdvancedConfigurationBss &bss_adv_bss = std::get<1>(bss_adv_bss_tuple);
+
+            if (!bss_valid) {
+                LOG(ERROR) << "Failed to get BSS entry " << bss_idx;
+                continue;
+            }
+
+            const bool ssid_advertisement =
+                static_cast<bool>(bss_adv_bss.bss_infos().ssid_advertisement);
+            LOG(DEBUG) << "BSS Advanced Config Report: ruid=" << bss_adv_radio.ruid()
+                       << " bssid=" << bss_adv_bss.bssid()
+                       << " ssid_advertisement=" << ssid_advertisement;
+
+            // Update the BSS configuration in the database if the BSSID is known.
+            // Per spec §7.1.3 Note: compare reported value against requested value and
+            // warn if the agent did not apply the requested SSIDAdvertisement setting.
+            if (bss_adv_bss.bssid() != beerocks::net::network_utils::ZERO_MAC) {
+                auto bss = database.get_bss(bss_adv_bss.bssid());
+                if (bss) {
+                    // The DB currently holds the value that was requested.
+                    // Compare before overwriting so we can detect non-compliance.
+                    if (bss->ssid_advertisement != ssid_advertisement) {
+                        LOG(WARNING) << "SSIDAdvertisement mismatch for BSS "
+                                     << bss_adv_bss.bssid()
+                                     << ": requested=" << bss->ssid_advertisement
+                                     << " reported=" << ssid_advertisement
+                                     << " (agent may not support SSIDAdvertisement)";
+                    } else {
+                        LOG(DEBUG) << "SSIDAdvertisement confirmed=" << ssid_advertisement
