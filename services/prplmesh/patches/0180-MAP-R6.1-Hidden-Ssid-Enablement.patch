+bool slave_thread::handle_bss_configuration_extended_request(int fd,
+                                                              ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    const auto mid = cmdu_rx.getMessageId();
+    LOG(INFO) << "Received BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE, mid=" << std::dec
+              << int(mid);
+
+    auto db = AgentDB::get();
+
+    // Send ACK message back to the controller within 1 second per spec section 17.1.32
+    if (!cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE)) {
+        LOG(ERROR) << "cmdu creation of type ACK_MESSAGE has failed";
+        return false;
+    }
+    if (!send_cmdu_to_controller({}, cmdu_tx)) {
+        LOG(ERROR) << "Failed to send ACK for BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE";
+        return false;
+    }
+
+    // Parse the BSS Advanced Configuration TLV from the request
+    auto bss_adv_config_req = cmdu_rx.getClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config_req) {
+        LOG(DEBUG) << "No tlvBssAdvancedConfiguration TLV in BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE";
+    } else {
+        LOG(DEBUG) << "Received BSS Advanced Configuration TLV with "
+                   << int(bss_adv_config_req->num_radio()) << " radio(s)";
+
+        // Apply the configuration to the specified BSS(s)
+        for (auto radio_idx = 0; radio_idx < bss_adv_config_req->num_radio(); ++radio_idx) {
+            auto bss_adv_radio_tuple = bss_adv_config_req->radios(radio_idx);
+            bool valid = std::get<0>(bss_adv_radio_tuple);
+            wfa_map::cBssAdvancedConfigurationRadio &bss_adv_radio = std::get<1>(bss_adv_radio_tuple);
+
+            if (!valid) {
+                LOG(ERROR) << "Failed to get radio entry " << radio_idx
+                           << " from tlvBssAdvancedConfiguration";
+                continue;
+            }
+
+            LOG(DEBUG) << "BSS Advanced Configuration for radio ruid=" << bss_adv_radio.ruid()
+                       << " num_bss=" << int(bss_adv_radio.num_bss());
+
+            for (auto bss_idx = 0; bss_idx < bss_adv_radio.num_bss(); ++bss_idx) {
+                auto bss_adv_bss_tuple = bss_adv_radio.bsss(bss_idx);
+                bool bss_valid = std::get<0>(bss_adv_bss_tuple);
+                wfa_map::cBssAdvancedConfigurationBss &bss_adv_bss = std::get<1>(bss_adv_bss_tuple);
+                if (!bss_valid) {
+                    LOG(ERROR) << "Failed to get BSS entry " << bss_idx
+                               << " from tlvBssAdvancedConfiguration";
+                    continue;
+                }
+
+                LOG(DEBUG) << "Applying BSS Advanced Configuration: bssid=" << bss_adv_bss.bssid()
+                           << " bss_index=" << int(bss_adv_bss.bss_index())
+                           << " ssid_advertisement="
+                           << int(bss_adv_bss.bss_infos().ssid_advertisement);
+
+                // Apply ssid_advertisement setting to the radio's BSS and trigger HAL update.
+                // If the BSS is not created yet, still forward radio_uid + BSS_Index to
+                // ApAutoConfigurationTask so it can store the value and apply it during new VAP
+                // creation.
+                auto radio = db->get_radio_by_mac(bss_adv_radio.ruid(), AgentDB::eMacType::RADIO);
+                if (radio) {
+                    bool hidden_event_sent = false;
+
+                    for (auto &bss : radio->front.bssids) {
+                        // Per spec Table 131: match by BSSID if non-zero; otherwise fall back
+                        // to BSS_Index correlation (used during initial configuration when the
+                        // BSSID is not yet assigned).
+                        bool bssid_match = false;
+                        if (bss_adv_bss.bssid() != beerocks::net::network_utils::ZERO_MAC) {
+                            // Primary: match by BSSID
+                            bssid_match = (bss.mac == bss_adv_bss.bssid());
+                        } else if (bss_adv_bss.bss_index() != 0) {
+                            // Fallback: match by BSS_Index (correlate with M2 WSC TLV)
+                            // Find the slot index of this BSS in the radio's bssids array
+                            for (size_t slot = 0; slot < radio->front.bssids.size(); ++slot) {
+                                if (&radio->front.bssids[slot] == &bss) {
+                                    // BSS_Index is 1-based (assigned as bss_index_counter starting at 1)
+                                    bssid_match =
+                                        (bss_adv_bss.bss_index() == static_cast<uint8_t>(slot + 1));
+                                    break;
+                                }
+                            }
+                        }
+                        if (bssid_match) {
+                            bss.ssid_advertisement =
+                                static_cast<bool>(bss_adv_bss.bss_infos().ssid_advertisement);
+                            LOG(DEBUG) << "Applied ssid_advertisement="
+                                       << bss.ssid_advertisement << " to BSS " << bss.mac;
+                            // Invoke update_vap_credentials() via ApAutoConfigurationTask
+                            // which updates hostapd.conf (ignore_broadcast_ssid),
+                            // UCI hidden option, and sends RELOAD_CONFIG to hostapd for existing
+                            // BSSes. For not-yet-created BSSes, it stores the value by BSS_Index.
+                            ApAutoConfigurationTask::sHiddenSsidConfig hidden_config;
+                            hidden_config.bssid              = bss.mac;
+                            hidden_config.ssid_advertisement = bss.ssid_advertisement;
+                            hidden_config.radio_uid          = bss_adv_radio.ruid();
+                            hidden_config.bss_index          = bss_adv_bss.bss_index();
+                            m_task_pool.send_event(
+                                eTaskType::AP_AUTOCONFIGURATION,
+                                ApAutoConfigurationTask::eEvent::APPLY_HIDDEN_SSID_CONFIG,
+                                &hidden_config);
+                            hidden_event_sent = true;
+                            break;
+                        }
+                    }
+
+                    if (!hidden_event_sent && bss_adv_bss.bss_index() != 0) {
+                        ApAutoConfigurationTask::sHiddenSsidConfig hidden_config;
+                        hidden_config.ssid_advertisement =
+                            static_cast<bool>(bss_adv_bss.bss_infos().ssid_advertisement);
+                        hidden_config.radio_uid = bss_adv_radio.ruid();
+                        hidden_config.bss_index = bss_adv_bss.bss_index();
+                        m_task_pool.send_event(
+                            eTaskType::AP_AUTOCONFIGURATION,
+                            ApAutoConfigurationTask::eEvent::APPLY_HIDDEN_SSID_CONFIG,
+                            &hidden_config);
+                        LOG(DEBUG) << "Stored pending ssid_advertisement="
+                                   << hidden_config.ssid_advertisement
+                                   << " for not-yet-created BSS_Index="
+                                   << int(hidden_config.bss_index)
+                                   << " on radio=" << hidden_config.radio_uid;
+                    }
+                }
+            }
+        }
+    }
+
+    // Build and send BSS Configuration Extended Report message with BSS Advanced Configuration TLV
+    // reporting the settings actually applied on the BSS(s)
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE)) {
+        LOG(ERROR) << "cmdu creation of type BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE has failed";
+        return false;
+    }
+
+    auto bss_adv_config_report = cmdu_tx.addClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config_report) {
+        LOG(ERROR) << "addClass wfa_map::tlvBssAdvancedConfiguration failed";
+        return false;
+    }
+
+    // Populate the report TLV with the current state of all radios and BSSes
+    for (const auto &radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        auto radio_entry = bss_adv_config_report->create_radios();
+        if (!radio_entry) {
+            LOG(ERROR) << "Failed creating radio entry in BSS Advanced Configuration TLV";
+            continue;
+        }
+        radio_entry->ruid() = radio->front.iface_mac;
+
+        for (const auto &bss : radio->front.bssids) {
+            if (bss.mac == beerocks::net::network_utils::ZERO_MAC) {
+                continue;
+            }
+
+            auto bss_entry = radio_entry->create_bsss();
+            if (!bss_entry) {
+                LOG(ERROR) << "Failed creating BSS entry in BSS Advanced Configuration TLV";
+                continue;
+            }
+
+            bss_entry->bssid()     = bss.mac;
+            bss_entry->bss_index() = 0; // BSS index not tracked per-BSS in AgentDB currently
+            bss_entry->bss_infos().ssid_advertisement =
+                static_cast<uint8_t>(bss.ssid_advertisement);
+
+            if (!radio_entry->add_bsss(bss_entry)) {
+                LOG(ERROR) << "Failed adding BSS entry to radio in BSS Advanced Configuration TLV";
+            }
+        }
+
+        if (!bss_adv_config_report->add_radios(radio_entry)) {
+            LOG(ERROR) << "Failed adding radio entry to BSS Advanced Configuration TLV";
+        }
+    }
+
+    LOG(DEBUG) << "Sending BSS_CONFIGURATION_EXTENDED_REPORT_MESSAGE to controller";
+    return send_cmdu_to_controller({}, cmdu_tx);
+}
