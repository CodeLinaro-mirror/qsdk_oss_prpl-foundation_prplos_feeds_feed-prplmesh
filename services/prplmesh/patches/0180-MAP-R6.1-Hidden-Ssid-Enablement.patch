+    } else if (requested_bss.m2_config.bss_index != 0) {
+        // BSS_Index is unique only within a radio. Since this function is already called per-radio,
+        // compare against the local VAP slot index encoded in iface_name/vap ordering indirectly via
+        // the requested M2 correlation information.
+        // Here we can only use BSS_Index as an additional strict correlation key once the request
+        // does not identify the BSS by BSSID yet.
+        const auto radio = AgentDB::get()->get_radio_by_mac(local_bss.mac, AgentDB::eMacType::BSSID);
+        if (radio) {
