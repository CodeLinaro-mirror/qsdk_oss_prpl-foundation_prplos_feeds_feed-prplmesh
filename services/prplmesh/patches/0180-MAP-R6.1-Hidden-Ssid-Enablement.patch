+            break;
+        }
+        auto config = reinterpret_cast<const sHiddenSsidConfig *>(event_obj);
+        auto db     = AgentDB::get();
+
+        auto radio = (config->bssid != beerocks::net::network_utils::ZERO_MAC)
+                         ? db->get_radio_by_mac(config->bssid, AgentDB::eMacType::BSSID)
+                         : nullptr;
+        if (!radio && config->radio_uid != beerocks::net::network_utils::ZERO_MAC) {
