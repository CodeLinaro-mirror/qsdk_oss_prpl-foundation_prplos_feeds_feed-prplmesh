+bool ap_wlan_hal_nl80211::update_bss_hidden_ssid(const sMacAddr &bssid, bool ssid_advertisement)
+{
+    const std::string bssid_str = tlvf::mac_to_string(bssid);
+    LOG(INFO) << "update_bss_hidden_ssid: bssid=" << bssid_str
+              << " ssid_advertisement=" << ssid_advertisement;
+
+    // Look up the BSS in available_vaps by BSSID to get the correct connected interface name.
+    // This is the same approach used by update_vap_credentials() and ensures we use the
+    // interface name that the AP manager is actually connected to (e.g. wlan0.1_link0),
+    // not the name from hostapd.conf (e.g. wlan0.1) which may differ on MLO platforms.
+    const auto vap_iter =
+        std::find_if(m_radio_info.available_vaps.begin(), m_radio_info.available_vaps.end(),
+                     [&bssid_str](const std::pair<int, bwl::VAPElement> &elem) {
+                         return elem.second.mac == bssid_str;
+                     });
+
+    if (vap_iter == m_radio_info.available_vaps.end()) {
+        LOG(ERROR) << "update_bss_hidden_ssid: BSSID=" << bssid_str
+                   << " not found in available_vaps";
+        return false;
+    }
+
+    const std::string &bss_iface = vap_iter->second.bss;
+    if (bss_iface.empty()) {
+        LOG(ERROR) << "update_bss_hidden_ssid: empty bss iface for BSSID=" << bssid_str;
+        return false;
+    }
+
+    LOG(DEBUG) << "update_bss_hidden_ssid: using bss_iface=" << bss_iface
+               << " for BSSID=" << bssid_str;
+
+    // Load hostapd config for this radio to update ignore_broadcast_ssid
+    prplmesh::hostapd::Configuration conf = load_hostapd_config(m_radio_info.iface_name, "");
+    if (!conf) {
+        LOG(ERROR) << "update_bss_hidden_ssid: failed to load hostapd config for "
+                   << m_radio_info.iface_name;
+        return false;
+    }
+
+    // Find the VAP by BSSID in the config
+    std::string vap_id = conf.get_vap_by_bssid(bssid_str);
+    if (vap_id.empty()) {
+        LOG(WARNING) << "update_bss_hidden_ssid: BSSID=" << bssid_str
+                     << " not found in hostapd.conf, skipping conf update";
+    } else {
+        // Update ignore_broadcast_ssid in hostapd.conf
+        // ssid_advertisement=true  → ignore_broadcast_ssid=0 (SSID visible)
+        // ssid_advertisement=false → ignore_broadcast_ssid=1 (SSID hidden)
+        conf.set_create_vap_value(vap_id, "ignore_broadcast_ssid",
+                                  ssid_advertisement ? "0" : "1");
+
+        // Save the updated config to disk so RELOAD_CONFIG picks it up.
+        // conf.update_required() is true only when the value actually changed.
+        if (conf.update_required()) {
+            if (!conf.store(vap_id)) {
+                LOG(ERROR) << "update_bss_hidden_ssid: failed to save hostapd.conf for "
+                           << bss_iface;
+                return false;
+            }
+            LOG(DEBUG) << "update_bss_hidden_ssid: saved ignore_broadcast_ssid="
+                       << (ssid_advertisement ? "0" : "1")
+                       << " to hostapd.conf for " << bss_iface;
+        } else {
+            LOG(DEBUG) << "update_bss_hidden_ssid: ignore_broadcast_ssid already="
+                       << (ssid_advertisement ? "0" : "1")
+                       << " in hostapd.conf for " << bss_iface << " (no write needed)";
+        }
+    }
+
+    // Update UCI 'hidden' option to persist across reboots
+    if (!beerocks::bpl::bpl_cfg_set_ssid_advertisement(bss_iface, ssid_advertisement)) {
+        LOG(WARNING) << "update_bss_hidden_ssid: bpl_cfg_set_ssid_advertisement failed for "
+                     << bss_iface;
+    }
+
+    // Send RELOAD_CONFIG to hostapd using the connected interface name.
+    // RELOAD_CONFIG does NOT create/delete vdevs — it only reloads configuration
+    // parameters (like ignore_broadcast_ssid) and is safe on MLO platforms.
+    const std::string cmd("RELOAD_CONFIG");
+    if (!wpa_ctrl_send_msg(cmd, bss_iface)) {
+        LOG(ERROR) << "update_bss_hidden_ssid: RELOAD_CONFIG failed for " << bss_iface;
+        return false;
+    }
+
+    LOG(INFO) << "update_bss_hidden_ssid: applied ignore_broadcast_ssid="
+              << (ssid_advertisement ? "0" : "1")
+              << " and sent RELOAD_CONFIG to " << bss_iface;
+    return true;
+}
