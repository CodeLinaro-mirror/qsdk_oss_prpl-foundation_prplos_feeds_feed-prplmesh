+/**
+ * @brief Send BSS Configuration Extended Request message with BSS Advanced Configuration TLV.
+ *
+ *        Per spec section 5.3.10.1 / Table 19: "If triggered to change any parameter listed
+ *        in the BSS Advanced Configuration TLV of one or more operating BSS(s) on a
+ *        Multi-AP Agent, the Multi-AP Controller shall send a BSS Configuration Extended
+ *        Request message containing one BSS Advanced Configuration TLV to the Multi-AP Agent."
+ *
+ * @param agent_mac AL MAC address of the target agent.
+ * @param ruid      Radio UID of the radio whose BSSes are being reconfigured.
+ * @param bssid     BSSID of the specific BSS to reconfigure (use ZERO_MAC to target all BSSes
+ *                  on the radio by BSS_Index).
+ * @param ssid_advertisement  New SSID advertisement (broadcast) setting: true = advertise,
+ *                            false = hide.
+ * @return true on success, false otherwise.
+ */
+bool Controller::send_bss_configuration_extended_request(const sMacAddr &agent_mac,
+                                                         const sMacAddr &ruid,
+                                                         const sMacAddr &bssid,
+                                                         bool ssid_advertisement)
+{
+    LOG(DEBUG) << "send_bss_configuration_extended_request: agent=" << agent_mac
+               << " ruid=" << ruid << " bssid=" << bssid
+               << " ssid_advertisement=" << ssid_advertisement;
+
+    auto agent = database.m_agents.get(agent_mac);
+    if (!agent) {
+        LOG(ERROR) << "Agent with mac is not found in database mac=" << agent_mac;
+        return false;
+    }
+
+    // Per spec section 5.3.10.1: create BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE)) {
+        LOG(ERROR) << "CMDU creation of type BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE has failed";
+        return false;
+    }
+
+    // Add BSS Advanced Configuration TLV
+    auto bss_adv_config = cmdu_tx.addClass<wfa_map::tlvBssAdvancedConfiguration>();
+    if (!bss_adv_config) {
+        LOG(ERROR) << "addClass wfa_map::tlvBssAdvancedConfiguration failed";
+        return false;
+    }
+
+    auto radio_entry = bss_adv_config->create_radios();
+    if (!radio_entry) {
+        LOG(ERROR) << "Failed creating radio entry in BSS Advanced Configuration TLV";
+        return false;
+    }
+    radio_entry->ruid() = ruid;
+
+    // If a specific BSSID is provided, configure only that BSS.
+    // Otherwise, configure all BSSes on the radio.
+    if (bssid != beerocks::net::network_utils::ZERO_MAC) {
+        // Single BSS configuration by BSSID
+        auto bss_entry = radio_entry->create_bsss();
+        if (!bss_entry) {
+            LOG(ERROR) << "Failed creating BSS entry in BSS Advanced Configuration TLV";
+            return false;
+        }
+        bss_entry->bssid()     = bssid;
+        bss_entry->bss_index() = 0; // BSS_Index not used when BSSID is known
+        bss_entry->bss_infos().ssid_advertisement = static_cast<uint8_t>(ssid_advertisement ? 1 : 0);
+
+        LOG(DEBUG) << "BSS Advanced Config Extended Request: ruid=" << ruid
+                   << " bssid=" << bssid
+                   << " ssid_advertisement=" << int(bss_entry->bss_infos().ssid_advertisement);
+
+        if (!radio_entry->add_bsss(bss_entry)) {
+            LOG(ERROR) << "Failed adding BSS entry to radio in BSS Advanced Configuration TLV";
+            return false;
+        }
+    } else {
+        // Configure all BSSes on the radio using BSS_Index for correlation
+        auto radio = agent->radios.get(ruid);
+        if (!radio) {
+            LOG(ERROR) << "Radio " << ruid << " not found on agent " << agent_mac;
+            return false;
+        }
+
+        const auto &configured_bss_list = database.get_configured_bss_info(ruid);
+        if (configured_bss_list.empty()) {
+            LOG(WARNING) << "No configured BSSes found for ruid=" << ruid
+                         << " on agent=" << agent_mac
+                         << "; sending BSS Advanced Configuration TLV with no BSS entries";
+        }
+
+        for (const auto &bss_conf : configured_bss_list) {
+            if (bss_conf.teardown) {
+                continue;
+            }
+            auto bss_entry = radio_entry->create_bsss();
+            if (!bss_entry) {
+                LOG(ERROR) << "Failed creating BSS entry in BSS Advanced Configuration TLV";
+                continue;
+            }
+            // Use ZERO_MAC as BSSID when BSSID is not yet assigned; agent correlates by BSS_Index
+            bss_entry->bssid()     = beerocks::net::network_utils::ZERO_MAC;
+            bss_entry->bss_index() = bss_conf.bss_index;
+            bss_entry->bss_infos().ssid_advertisement =
+                static_cast<uint8_t>(ssid_advertisement ? 1 : 0);
+
+            LOG(DEBUG) << "BSS Advanced Config Extended Request: ruid=" << ruid
+                       << " bss_index=" << int(bss_conf.bss_index)
+                       << " ssid=" << bss_conf.ssid
+                       << " ssid_advertisement=" << int(bss_entry->bss_infos().ssid_advertisement);
+
+            if (!radio_entry->add_bsss(bss_entry)) {
+                LOG(ERROR) << "Failed adding BSS entry to radio in BSS Advanced Configuration TLV";
+            }
+        }
+    }
+
+    if (!bss_adv_config->add_radios(radio_entry)) {
+        LOG(ERROR) << "Failed adding radio entry to BSS Advanced Configuration TLV";
+        return false;
+    }
+
+    LOG(INFO) << "Sending BSS_CONFIGURATION_EXTENDED_REQUEST_MESSAGE with BSS Advanced "
+              << "Configuration TLV to agent=" << agent_mac
+              << " ruid=" << ruid
+              << " ssid_advertisement=" << ssid_advertisement;
+
+    return son_actions::send_cmdu_to_agent(agent_mac, cmdu_tx, database);
+}
