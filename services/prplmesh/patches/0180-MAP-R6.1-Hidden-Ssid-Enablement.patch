+bool bpl_cfg_set_ssid_advertisement(const std::string &iface, bool ssid_advertisement)
+{
+    const std::string package_name    = "wireless";
+    const std::string section_type    = "wifi-iface";
+    const std::string mld_section_type = "wifi-mld";
+
+    // ssid_advertisement=true  → option hidden 0 (SSID visible in beacons)
+    // ssid_advertisement=false → option hidden 1 (SSID hidden in beacons)
+    const std::string hidden_value = ssid_advertisement ? "0" : "1";
+
+    // --- Step 1: Try wifi-iface section(s) ---
+    // For 3-link MLO, all wifi-iface sections share the same ifname (e.g. "wlan3").
+    // uci_find_section_by_option returns only the FIRST match, so we must iterate
+    // ALL sections and update every one whose ifname matches.
+    //
+    // Also strip the "_link<N>" suffix that the NL80211 HAL appends to the kernel
+    // interface name (e.g. "wlan3_link0" → "wlan3").  The UCI section is written
+    // with the hostapd config name which does NOT carry the "_link<N>" suffix.
+
+    // Compute base interface name (strip "_link<N>" if present)
+    std::string iface_base = iface;
+    {
+        auto pos = iface.rfind("_link");
+        if (pos != std::string::npos) {
+            bool all_digits = true;
+            for (size_t i = pos + 5; i < iface.size(); ++i) {
+                if (!isdigit(static_cast<unsigned char>(iface[i]))) {
+                    all_digits = false;
+                    break;
+                }
+            }
+            if (all_digits && pos + 5 <= iface.size()) {
+                iface_base = iface.substr(0, pos);
+                LOG(DEBUG) << "bpl_cfg_set_ssid_advertisement: using base iface="
+                           << iface_base << " (stripped _link suffix from " << iface << ")";
+            }
+        }
+    }
+
+    // Iterate ALL wifi-iface sections and update every one whose ifname matches
+    // iface or iface_base.  This handles the 3-link MLO case where multiple
+    // sections share the same ifname.
+    {
+        std::vector<std::string> all_sections;
+        if (uci_get_all_sections(package_name, section_type, all_sections)) {
+            int sections_updated = 0;
+            for (const auto &sec : all_sections) {
+                std::string sec_ifname;
+                if (!uci_get_option(package_name, section_type, sec, "ifname", sec_ifname)) {
+                    continue;
+                }
+                if (sec_ifname != iface && sec_ifname != iface_base) {
+                    continue;
+                }
+
+                // Check if already set to avoid unnecessary UCI commits
+                std::string current_hidden;
+                if (uci_get_option(package_name, section_type, sec, "hidden", current_hidden) &&
+                    current_hidden == hidden_value) {
+                    LOG(DEBUG) << "bpl_cfg_set_ssid_advertisement: section=" << sec
+                               << " iface=" << iface << " hidden=" << hidden_value
+                               << " unchanged, skipping";
+                    sections_updated++;  // count as handled
+                    continue;
+                }
+
+                OptionsUnorderedMap options;
+                options["hidden"] = hidden_value;
+                if (!uci_set_section(package_name, section_type, sec, options, true)) {
+                    LOG(ERROR) << "bpl_cfg_set_ssid_advertisement: failed to set hidden="
+                               << hidden_value << " in section=" << sec
+                               << " for interface " << iface;
+                } else {
+                    LOG(INFO) << "bpl_cfg_set_ssid_advertisement: section=" << sec
+                              << " iface=" << iface
+                              << " ssid_advertisement=" << ssid_advertisement
+                              << " -> wifi-iface option hidden=" << hidden_value;
+                    sections_updated++;
+                }
+            }
+            if (sections_updated > 0) {
+                return true;
+            }
+        }
+    }
+
+    LOG(ERROR) << "bpl_cfg_set_ssid_advertisement: section not found for interface " << iface
+               << " in wifi-iface";
+    return false;
+}
