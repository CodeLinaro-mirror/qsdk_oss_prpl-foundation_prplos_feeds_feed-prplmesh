From b606acfb5848143153afcfd8741aa9f6efd984e4 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Sun, 4 Oct 2026 11:40:39 +0530
Subject: [PATCH] [prplmesh] pwhm forward client steering request even if
 recieved for invalid target

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 24 +++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index a0eccadfa..65046e4f8 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -662,16 +662,36 @@ bool ap_wlan_hal_whm::sta_bss_steer(const sBtmRequestParams &params)
     uint8_t req_mode =
         build_req_mode(params.pref_list_included, params.abridged, params.disassoc_imminent);
 
+    // Detect wildcard/broadcast target BSSID (ff:ff:ff:ff:ff:ff) — used when the
+    // controller sends a BTM request with no target BSS list (e.g. test_11v_command_3).
+    // pWHM's sendBssTransferRequest rejects a wildcard target and silently drops the
+    // request without sending the BTM Request to the STA. Omit "target" and "channel"
+    // in this case so pWHM forwards the BTM Request as received — without a Neighbor
+    // Report IE — which is valid per 802.11v and causes the STA to respond with a BTM Response.
+    // Confirmed from Wireshark (DEV_TH.pcap frame 4041): target BSSID=ff:ff:ff:ff:ff:ff,
+    // channel=0 → pWHM drops the request → no BTM Response → test_11v_command_3 fails.
+    static const sMacAddr BROADCAST_BSSID = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+    const bool is_wildcard_target = (params.bssid == BROADCAST_BSSID);
+
     AmbiorixVariant result;
     AmbiorixVariant args(AMXC_VAR_ID_HTABLE);
     args.add_child("mac", tlvf::mac_to_string(params.mac));
-    args.add_child("target", tlvf::mac_to_string(params.bssid));
+    if (!is_wildcard_target) {
+        // Specific target BSSID: include target and channel so pWHM sends a BTM Request
+        // with a Neighbor Report IE pointing the STA to the target BSS.
+        args.add_child("target", tlvf::mac_to_string(params.bssid));
+        args.add_child("channel", params.chan);
+    }
     args.add_child("class", params.oper_class);
-    args.add_child("channel", params.chan);
     args.add_child("validity", params.valid_int_btt);
     args.add_child("disassoc", params.disassoc_timer_btt);
     args.add_child("transitionReason", params.reason);
     args.add_child("mode", req_mode);
+    LOG(DEBUG) << "sta_bss_steer: sta=" << tlvf::mac_to_string(params.mac)
+               << " target=" << tlvf::mac_to_string(params.bssid)
+               << (is_wildcard_target ? " (wildcard - omitting target/channel from pWHM call)" : "")
+               << " disassoc_imminent=" << params.disassoc_imminent
+               << " mode=0x" << std::hex << int(req_mode) << std::dec;
     auto wifi_ap_path = wbapi_utils::search_path_ap_by_iface(ifname);
     bool ret          = m_ambiorix_cl.call(wifi_ap_path, "sendBssTransferRequest", args, result);
 
