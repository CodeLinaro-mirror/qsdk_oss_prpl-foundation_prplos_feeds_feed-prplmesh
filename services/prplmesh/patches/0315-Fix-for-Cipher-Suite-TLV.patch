From 4c74231b789c3336add34e945b8de1cb1cea3cae Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Wed, 5 Aug 2026 16:30:43 +0530
Subject: [PATCH] Fix for Cipher Suite TLV

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../slave/tasks/capability_reporting_task.cpp | 41 +++++++------------
 controller/src/beerocks/master/controller.cpp | 39 ++++++------------
 controller/src/beerocks/master/db/agent.h     |  5 ++-
 .../wfa_map/tlvSupportedCipherSuites.yaml     | 27 +++++-------
 4 files changed, 41 insertions(+), 71 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
index d22a000..7a10854 100644
--- a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
+++ b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
@@ -381,37 +381,24 @@ bool CapabilityReportingTask::add_supported_cipher_suites_tlv(ieee1905_1::CmduMe
     // clang-format on
     constexpr size_t k_num_ciphers = sizeof(k_default_ciphers) / sizeof(k_default_ciphers[0]);
 
-    auto fill_selectors = [&](auto alloc_fn, auto access_fn) -> bool {
-        if (!(supported_cipher_suites_tlv.get()->*alloc_fn)(k_num_ciphers)) {
-            LOG(ERROR) << "Failed to allocate " << k_num_ciphers
-                       << " cipher suite selectors in tlvSupportedCipherSuites";
-            return false;
-        }
-        for (size_t idx = 0; idx < k_num_ciphers; ++idx) {
-            auto entry = (supported_cipher_suites_tlv.get()->*access_fn)(idx);
-            if (!std::get<0>(entry)) {
-                LOG(ERROR) << "Failed to access cipher suite selector at index " << idx;
-                return false;
-            }
-            auto &selector           = std::get<1>(entry);
-            selector.oui             = sVendorOUI(k_default_ciphers[idx].oui);
-            selector.oui.struct_swap();
-            selector.cipher_suite_type = k_default_ciphers[idx].suite_type;
-        }
-        return true;
-    };
-
-    if (!fill_selectors(&wfa_map::tlvSupportedCipherSuites::alloc_backhaul_bss_cipher_suite_selectors,
-                        &wfa_map::tlvSupportedCipherSuites::backhaul_bss_cipher_suite_selectors)) {
+    if (!supported_cipher_suites_tlv->alloc_cipher_suite_selectors(k_num_ciphers)) {
+        LOG(ERROR) << "Failed to allocate " << k_num_ciphers
+                   << " cipher suite selectors in tlvSupportedCipherSuites";
         return false;
     }
-    if (!fill_selectors(&wfa_map::tlvSupportedCipherSuites::alloc_fronthaul_bss_cipher_suite_selectors,
-                        &wfa_map::tlvSupportedCipherSuites::fronthaul_bss_cipher_suite_selectors)) {
-        return false;
+    for (size_t idx = 0; idx < k_num_ciphers; ++idx) {
+        auto entry = supported_cipher_suites_tlv->cipher_suite_selectors(idx);
+        if (!std::get<0>(entry)) {
+            LOG(ERROR) << "Failed to access cipher suite selector at index " << idx;
+            return false;
+        }
+        auto &selector             = std::get<1>(entry);
+        selector.oui               = sVendorOUI(k_default_ciphers[idx].oui);
+        selector.oui.struct_swap();
+        selector.cipher_suite_type = k_default_ciphers[idx].suite_type;
     }
 
-    LOG(INFO) << "Add Supported Cipher Suites TLV (" << k_num_ciphers
-              << " selectors on both fronthaul and backhaul BSSes)";
+    LOG(INFO) << "Add Supported Cipher Suites TLV (" << k_num_ciphers << " selectors)";
     return true;
 }
 
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index e2ad34a..78690f8 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -1468,11 +1468,11 @@ static void validate_rsn_security_ies_against_agent_capabilities(
         // Skip the union check when the corresponding capability set was never advertised —
         // an unconstrained side cannot generate a mismatch.
         const bool akm_side_constrained    = caps.akm_valid && !caps.fh_akm_selectors.empty();
-        const bool cipher_side_constrained = caps.cipher_valid && !caps.fh_cipher_selectors.empty();
+        const bool cipher_side_constrained = caps.cipher_valid && !caps.cipher_selectors.empty();
         if (!akm_side_constrained && !cipher_side_constrained) {
             continue;
         }
-        if (!is_advertised(t, caps.fh_akm_selectors, caps.fh_cipher_selectors)) {
+        if (!is_advertised(t, caps.fh_akm_selectors, caps.cipher_selectors)) {
             LOG(WARNING)
                 << "RSN Parameters Configuration TLV: agent " << agent.al_mac << " (ruid=" << ruid
                 << " bss_index=" << int(bss_index)
@@ -7503,38 +7503,25 @@ bool Controller::handle_ap_capability_report(const sMacAddr &src_mac,
                    << src_mac << " with profile enum " << agent->profile;
     }
 
-    // Parse the Supported Cipher Suites TLV (R6.1 §17.2.94) and persist the advertised BH/FH
-    // selectors on the Agent for validate_rsn_security_ies_against_agent_capabilities().
+    // Parse the Supported Cipher Suites TLV (R6.1 §17.2.109, Table 132) and persist the
+    // advertised selectors on the Agent for validate_rsn_security_ies_against_agent_capabilities().
+    // Unlike the AKM Suite Capabilities TLV, this TLV carries a single flat list with no
+    // fronthaul/backhaul split.
     if (auto supported_cipher_suites_tlv = cmdu_rx.getClass<wfa_map::tlvSupportedCipherSuites>()) {
-        agent->security_capabilities.bh_cipher_selectors.clear();
-        agent->security_capabilities.fh_cipher_selectors.clear();
+        agent->security_capabilities.cipher_selectors.clear();
 
         std::stringstream ss;
         ss << "Supported Cipher Suites TLV from Agent " << src_mac << ":" << std::endl
-           << "  backhaul-BSS selectors ("
-           << int(supported_cipher_suites_tlv->number_of_bh_bss_cipher_suite_selectors()) << "):";
-        for (size_t i = 0;
-             i < supported_cipher_suites_tlv->number_of_bh_bss_cipher_suite_selectors(); ++i) {
-            auto entry = supported_cipher_suites_tlv->backhaul_bss_cipher_suite_selectors(i);
+           << "  selectors ("
+           << int(supported_cipher_suites_tlv->number_of_cipher_suite_selectors()) << "):";
+        for (size_t i = 0; i < supported_cipher_suites_tlv->number_of_cipher_suite_selectors();
+             ++i) {
+            auto entry = supported_cipher_suites_tlv->cipher_suite_selectors(i);
             if (!std::get<0>(entry)) {
                 continue;
             }
             auto &selector = std::get<1>(entry);
-            agent->security_capabilities.bh_cipher_selectors.push_back(selector);
-            ss << " {oui=0x" << std::hex << uint32_t(selector.oui) << std::dec
-               << ", type=" << int(selector.cipher_suite_type) << "}";
-        }
-        ss << std::endl
-           << "  fronthaul-BSS selectors ("
-           << int(supported_cipher_suites_tlv->number_of_fh_bss_cipher_suite_selectors()) << "):";
-        for (size_t i = 0;
-             i < supported_cipher_suites_tlv->number_of_fh_bss_cipher_suite_selectors(); ++i) {
-            auto entry = supported_cipher_suites_tlv->fronthaul_bss_cipher_suite_selectors(i);
-            if (!std::get<0>(entry)) {
-                continue;
-            }
-            auto &selector = std::get<1>(entry);
-            agent->security_capabilities.fh_cipher_selectors.push_back(selector);
+            agent->security_capabilities.cipher_selectors.push_back(selector);
             ss << " {oui=0x" << std::hex << uint32_t(selector.oui) << std::dec
                << ", type=" << int(selector.cipher_suite_type) << "}";
         }
diff --git a/controller/src/beerocks/master/db/agent.h b/controller/src/beerocks/master/db/agent.h
index 9646301..d71ef26 100644
--- a/controller/src/beerocks/master/db/agent.h
+++ b/controller/src/beerocks/master/db/agent.h
@@ -109,8 +109,9 @@ public:
         std::vector<wfa_map::tlvAkmSuiteCapabilities::sBssAkmSuiteSelector> bh_akm_selectors;
         bool akm_valid = false;
 
-        std::vector<wfa_map::tlvSupportedCipherSuites::sBssCipherSuiteSelector> fh_cipher_selectors;
-        std::vector<wfa_map::tlvSupportedCipherSuites::sBssCipherSuiteSelector> bh_cipher_selectors;
+        // Supported Cipher Suites TLV (Table 132) carries a single flat list — no
+        // fronthaul/backhaul split, unlike the AKM Suite Capabilities TLV above.
+        std::vector<wfa_map::tlvSupportedCipherSuites::sBssCipherSuiteSelector> cipher_selectors;
         bool cipher_valid = false;
     } security_capabilities;
 
diff --git a/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml b/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml
index ab9d3f1..8c304cd 100644
--- a/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml
+++ b/framework/tlvf/yaml/tlvf/wfa_map/tlvSupportedCipherSuites.yaml
@@ -8,15 +8,16 @@ _include:
     tlvf/common/sMacAddr.h
   }
 
-# Wi-Fi EasyMesh R6.1 - section 17.2.94 - Supported Cipher Suites TLV
+# Wi-Fi EasyMesh R6.1 - section 17.2.109 - Supported Cipher Suites TLV (Table 132)
 # Sent by the Agent in the AP Capability Report and Early AP Capability Report to advertise which
-# IEEE 802.11 pairwise/group cipher suites the Agent can enforce on fronthaul and backhaul BSSes.
-# The Controller uses this to constrain the SecurityIEs it may push via the RSN Parameters
-# Configuration TLV (§17.2.105) so it never proposes a cipher the Agent cannot honour.
+# IEEE 802.11 cipher suites it supports for BSS(s). The Controller uses this to constrain the
+# SecurityIEs it may push via the RSN Parameters Configuration TLV (§17.2.105) so it never
+# proposes a cipher the Agent cannot honour.
 #
-# Layout mirrors tlvAkmSuiteCapabilities (agent-level; two cipher-suite-selector lists, one for
-# backhaul BSSes and one for fronthaul BSSes). Each selector is a 3B OUI + 1B suite-type value
-# per IEEE Std 802.11-2020 Table 9-149 (Cipher suite selectors).
+# Per Table 132 this is a single Num_CipherSuites count followed by that many (OUI, Suite Type)
+# selectors -- there is no fronthaul/backhaul split in this TLV (unlike tlvAkmSuiteCapabilities).
+# Each selector is a 3B OUI + 1B suite-type value per IEEE Std 802.11-2020 Table 9-149 (Cipher
+# suite selectors).
 
 tlvSupportedCipherSuites:
   _type: class
@@ -25,18 +26,12 @@ tlvSupportedCipherSuites:
     _type: eTlvTypeMap
     _value_const: TLV_SUPPORTED_CIPHER_SUITES
   length: uint16_t
-  number_of_bh_bss_cipher_suite_selectors:
+  number_of_cipher_suite_selectors:
     _type: uint8_t
     _length_var: True
-  backhaul_bss_cipher_suite_selectors:
+  cipher_suite_selectors:
     _type: sBssCipherSuiteSelector
-    _length: [ number_of_bh_bss_cipher_suite_selectors ]
-  number_of_fh_bss_cipher_suite_selectors:
-    _type: uint8_t
-    _length_var: True
-  fronthaul_bss_cipher_suite_selectors:
-    _type: sBssCipherSuiteSelector
-    _length: [ number_of_fh_bss_cipher_suite_selectors ]
+    _length: [ number_of_cipher_suite_selectors ]
 
 sBssCipherSuiteSelector:
   _type: struct
-- 
2.34.1

