From cff5c06ed0ba14832bba8bf71861815a44385881 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Mon, 5 Oct 2026 21:29:18 +0530
Subject: [PATCH] FH_MANAGER: backhaul fsm state optimization during bh switch

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     | 48 ++++++++++++-------
 agent/src/beerocks/slave/son_slave_thread.cpp |  4 --
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       |  1 +
 3 files changed, 33 insertions(+), 20 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 5f5aeda2d..7baf120c6 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1213,6 +1213,19 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
             m_pending_steering_failure_bssid = beerocks::net::network_utils::ZERO_MAC;
         }
 
+        if (m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+            auto fh_vaps_notif_wireless_to_wired = message_com::create_vs_message<
+                beerocks_message::cACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION>(cmdu_tx);
+            if (fh_vaps_notif_wireless_to_wired) {
+                fh_vaps_notif_wireless_to_wired->connected() = 1;
+                LOG(DEBUG) << "Sending ACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION"
+                              " (connected=1) during wireless->wired switch";
+                send_cmdu(m_agent_fd, cmdu_tx);
+            } else {
+                LOG(ERROR) << "Failed building cACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION";
+            }
+        }
+
         handle_backhaul_connect();
         stop_on_failure_attempts = configuration_stop_on_failure_attempts;
 
@@ -1391,6 +1404,19 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
                         }
                     }
                 } else {
+                    // Wired to wireless switching - disable all FH VAPs after triggering STA reconnection
+                    if (m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+                        auto fh_vaps_notif_wired_to_wireless = message_com::create_vs_message<
+                            beerocks_message::cACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION>(cmdu_tx);
+                        if (fh_vaps_notif_wired_to_wireless) {
+                            fh_vaps_notif_wired_to_wireless->connected() = 0;
+                            LOG(DEBUG) << "Sending ACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION"
+                                          " (connected=0) during wired->wireless switch";
+                            send_cmdu(m_agent_fd, cmdu_tx);
+                        } else {
+                            LOG(ERROR) << "Failed building cACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION";
+                        }
+                    }
                     // Ethernet backhaul disconnected - check if we should reconnect STA or restart FSM
                     bool should_reconnect_sta = false;
                     for (auto &radio_info : m_radios_info) {
@@ -1456,20 +1482,6 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
 
                         reset_1905_security_for_connection_switch();
 
-                        // Wired to wireless switching - disable all FH VAPs after triggering STA reconnection
-                        if (m_agent_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
-                            auto fh_vaps_notif_wired_to_wireless = message_com::create_vs_message<
-                                beerocks_message::cACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION>(cmdu_tx);
-                            if (fh_vaps_notif_wired_to_wireless) {
-                                fh_vaps_notif_wired_to_wireless->connected() = 0;
-                                LOG(DEBUG) << "Sending ACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION"
-                                              " (connected=0) during wired->wireless switch";
-                                send_cmdu(m_agent_fd, cmdu_tx);
-                            } else {
-                                LOG(ERROR) << "Failed building cACTION_BACKHAUL_FH_VAPS_STATE_NOTIFICATION";
-                            }
-                        }
-
                         // Don't restart FSM, stay in current state to allow reconnection
                         break;
                     }
@@ -1497,7 +1509,11 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
                     LOG(INFO) << timestamp2 << "Backhaul Switching: Wired -> Wireless";
                 }
 
-                FSM_MOVE_STATE(RESTART);
+                if (m_eth_link_up) {
+                    FSM_MOVE_STATE(CONNECTED);
+                } else {
+                    FSM_MOVE_STATE(INIT_HAL);
+                }
             }
 
             if (m_eth_link_up) {
@@ -1899,7 +1915,7 @@ bool BackhaulManager::backhaul_fsm_wireless(bool &skip_select)
 
                         LOG(INFO) << "Ethernet link became available during WAIT_WPS on interface "
                                   << db->ethernet.wan.iface_name << " - switch to wired backhaul";
-                        FSM_MOVE_STATE(RESTART);
+                        FSM_MOVE_STATE(CONNECTED);
                         break;
                     }
                 }
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 01832c866..bda6b8c03 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -7662,10 +7662,6 @@ void slave_thread::notify_controller_reachability(bool reachable)
     if (!reachable && m_backhaul_l2_connected) {
         LOG(DEBUG) << "notify_controller_reachability: skipping FH VAP disable"
                    << " - backhaul L2 is still connected";
-    } else {
-        LOG(DEBUG) << "Controller reachability changed - sending FH VAP "
-                   << (reachable ? "enable" : "disable") << " to all AP managers";
-        send_fh_vap_state_to_ap_managers(reachable);
     }
 
     if (m_controller_reachable == reachable) {
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index acbab2203..3c2552ec9 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -10773,6 +10773,7 @@ bool ap_wlan_hal_nl80211::disable_all_fh_vaps()
             }
         }
     }
+
     return success;
 }
 
-- 
2.34.1

