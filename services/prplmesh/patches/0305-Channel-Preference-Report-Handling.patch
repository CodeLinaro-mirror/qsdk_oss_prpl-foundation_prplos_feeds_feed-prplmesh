+uint8_t ChannelSelectionTask::normalize_rank_to_preference(int32_t rank, int32_t max_rank_on_radio)
+{
+    // Non-operable / unknown: reserve preference 0.
+    if (rank < 0) {
+        return 0;
+    }
+    // Operable but unranked by the driver: keep the lowest operable preference so it is not
+    // penalized as non-operable; the controller decides whether to use it.
+    if (rank == 0) {
+        return 1;
+    }
+    constexpr int BEST_PREF  = 15;
+    constexpr int WORST_PREF = 1;
+    // Best ranked channel always maps to the maximum preference.
+    if (rank <= 1 || max_rank_on_radio <= 1) {
+        return static_cast<uint8_t>(BEST_PREF);
+    }
+    // Linearly spread the remaining ranks over [WORST_PREF..BEST_PREF] using the radio's largest
+    // observed positive rank, so the mapping is normalized per radio regardless of the band /
+    // regulatory rank range or how many channels the driver ranked.
+    const int span   = BEST_PREF - WORST_PREF; // 14
+    const int denom  = max_rank_on_radio - 1;
+    const int numer  = max_rank_on_radio - rank;
+    int pref         = WORST_PREF + ((span * numer) + (denom / 2)) / denom; // rounded
+    if (pref < WORST_PREF) {
+        pref = WORST_PREF;
+    }
+    if (pref > BEST_PREF) {
+        pref = BEST_PREF;
+    }
+    return static_cast<uint8_t>(pref);
+}
+
+bool ChannelSelectionTask::preference_changed_since_last_reported(
+    const sMacAddr &radio_mac, const AgentDB::sRadio::channel_preferences_map &new_pref)
+{
+    auto it = m_last_reported_preferences.find(radio_mac);
+    if (it == m_last_reported_preferences.end()) {
+        // No snapshot yet -> treat as changed so the first report is emitted.
+        return true;
+    }
+    return it->second != new_pref;
+}
