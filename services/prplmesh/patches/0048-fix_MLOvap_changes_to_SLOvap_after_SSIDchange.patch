+void Controller::refresh_agent_configured_ap_mld_ssid(const std::shared_ptr<Agent> &agent)
+{
+    auto &bss_conf = database.get_bss_info_configuration(agent->al_mac);
+    LOG(DEBUG) << "BSS info configurations for agent " << agent->al_mac
+               << ", count=" << bss_conf.size();
+    for (const auto &bss_info_conf : bss_conf) {
+        if (bss_info_conf.mld_id >= 0) {
+            auto it = agent->configured_ap_mlds.find(bss_info_conf.mld_id);
+            if (it != agent->configured_ap_mlds.end()) {
+                LOG(DEBUG) << "  BSS ssid=" << bss_info_conf.ssid
+                            << " agent db ssid=" << it->second.mld_info.mld_ssid;;
+                if (bss_info_conf.ssid != it->second.mld_info.mld_ssid) {
+                    LOG(DEBUG) << "  Updating agent db mld_ssid from " << it->second.mld_info.mld_ssid
+                               << " to " << bss_info_conf.ssid;
+                    it->second.mld_info.mld_ssid = bss_info_conf.ssid;
+                }
+            }
+        }
+    }
+}
