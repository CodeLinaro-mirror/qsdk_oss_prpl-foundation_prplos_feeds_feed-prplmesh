+void mon_wlan_hal_onewifi::on_sta_assoc_status_data(const char *data, unsigned int len)
+{
+    if (!data || len < sizeof(rdk_sta_data_t)) {
+        ONEWIFI_LOG_WARN("Monitor: on_sta_assoc_status_data invalid data len=%u expected=%zu", 
+                         len, sizeof(rdk_sta_data_t));
+        return;
+    }
+
+    // Data is binary rdk_sta_data_t structure
+    const rdk_sta_data_t *sta_data = reinterpret_cast<const rdk_sta_data_t *>(data);
+    
+    // Determine if this is connect or disconnect (from ap_wlan_hal_onewifi.cpp)
+    bool is_connected = (sta_data->stats.connect_status != 0);
+    
+    // Get VAP ID from interface name
+    int8_t vap_id = get_vap_id_with_bss(sta_data->interface_name);
+    if (vap_id < 0) {
+        ONEWIFI_LOG_DEBUG("Monitor: on_sta_assoc_status_data vap_id not found for interface=%s, using 0", 
+                          sta_data->interface_name);
+        vap_id = 0;
+    }
+
+    // Get STA MAC from bss_info.bssid (from ap_wlan_hal_onewifi.cpp)
+    sMacAddr sta_mac = {};
+    memcpy(sta_mac.oct, sta_data->bss_info.bssid, sizeof(sta_mac.oct));
+    
+    ONEWIFI_LOG_INFO("Monitor: on_sta_assoc_status_data:%s sta_mac=%s on interface=%s vap_id=%d",
+                     (is_connected ? " CONNECTED" : " DISCONNECTED"),
+                     tlvf::mac_to_string(sta_mac).c_str(), sta_data->interface_name, int(vap_id));
+
+    if (is_connected) {
+        // Push STA_Connected event to Monitor
+        auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION));
+        auto msg = reinterpret_cast<sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION *>(msg_buff.get());
+        LOG_IF(!msg, FATAL) << "Failed allocating sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION";
+        
+        memset(msg_buff.get(), 0, sizeof(sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION));
+        msg->vap_id = vap_id;
+        msg->mac = sta_mac;
+        
+        event_queue_push(static_cast<int>(Event::STA_Connected), msg_buff);
+        ONEWIFI_LOG_DEBUG("Monitor: Pushed STA_Connected event vap_id=%d", int(vap_id));
+    } else {
+        // Push STA_Disconnected event to Monitor
+        auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_MONITOR_CLIENT_DISCONNECTED_NOTIFICATION));
+        auto msg = reinterpret_cast<sACTION_MONITOR_CLIENT_DISCONNECTED_NOTIFICATION *>(msg_buff.get());
+        LOG_IF(!msg, FATAL) << "Failed allocating sACTION_MONITOR_CLIENT_DISCONNECTED_NOTIFICATION";
+        
+        memset(msg_buff.get(), 0, sizeof(sACTION_MONITOR_CLIENT_DISCONNECTED_NOTIFICATION));
+        msg->mac = sta_mac;
+        
+        event_queue_push(static_cast<int>(Event::STA_Disconnected), msg_buff);
+        ONEWIFI_LOG_DEBUG("Monitor: Pushed STA_Disconnected event vap_id=%d", int(vap_id));
+    }
+}
