+bool mon_wlan_hal_onewifi::channel_scan_dump_cached_results()
+{
+    // Cached results use the same shared data model - same logic as dump_results
+    ONEWIFI_LOG_INFO("Monitor: channel_scan_dump_cached_results: reading %zu cached scan results from shared data model",
+                     m_data_model->get_num_scan_results());
+    return channel_scan_dump_results();
+}
