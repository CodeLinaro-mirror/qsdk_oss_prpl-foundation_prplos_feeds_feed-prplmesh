+bool mon_wlan_hal_onewifi::update_stations_stats(const std::string &vap_iface_name, 
+                                                  const std::string &sta_mac, 
+                                                  SStaStats &sta_stats, 
+                                                  bool is_read_unicast)
+{
+    // Convert STA MAC string to mac_address_t
+    mac_address_t sta_mac_addr;
+    tlvf::mac_from_string(sta_mac_addr, sta_mac);
+
+    // Convert VAP interface to BSSID
+    std::string vap_mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(vap_iface_name, vap_mac_str)) {
+        ONEWIFI_LOG_ERROR("Monitor: Failed to get MAC for VAP %s", vap_iface_name.c_str());
+        return false;
+    }
+
+    bssid_t bssid;
+    tlvf::mac_from_string(bssid, vap_mac_str);
+
+    // Get radio MAC
+    std::string radio_mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(m_radio_info.iface_name, radio_mac_str)) {
+        ONEWIFI_LOG_ERROR("Monitor: Failed to get radio MAC for %s", m_radio_info.iface_name.c_str());
+        return false;
+    }
+    
+    mac_address_t ruid;
+    tlvf::mac_from_string(ruid, radio_mac_str);
+
+    // Find STA info in data model (correct signature from onewifi_data_model.h)
+    em_sta_info_t *sta_info = m_data_model->get_sta_info(sta_mac_addr, bssid, ruid, em_target_sta_map_assoc);
+    if (!sta_info) {
+        ONEWIFI_LOG_WARN("Monitor: No STA info found for MAC %s", sta_mac.c_str());
+        return false;
+    }
+
+    // Populate STA stats from sta_info (from em_base.h structure)
+    sta_stats.tx_bytes_cnt = sta_info->bytes_tx;
+    sta_stats.rx_bytes_cnt = sta_info->bytes_rx;
+    sta_stats.tx_packets_cnt = sta_info->pkts_tx;
+    sta_stats.rx_packets_cnt = sta_info->pkts_rx;
+    sta_stats.tx_errors_cnt = sta_info->errors_tx;
+    sta_stats.rx_errors_cnt = sta_info->errors_rx;
+    sta_stats.retrans_count = sta_info->retrans_count;
+
+    // Convert RSSI from RCPI if available
+    if (sta_info->rcpi != 0) {
+        // RCPI to RSSI conversion: RSSI = (RCPI / 2) - 110
+        int8_t rssi_dbm = (sta_info->rcpi / 2) - 110;
+        sta_stats.rx_rssi_watt = pow(10.0, rssi_dbm / 10.0);
+        sta_stats.rx_rssi_watt_samples_cnt = 1;
+    }
+
+    // PHY rates (from em_base.h: last_ul_rate, last_dl_rate in Kbps)
+    sta_stats.tx_phy_rate_100kb = sta_info->last_ul_rate / 100; // Kbps to 100kb
+    sta_stats.rx_phy_rate_100kb = sta_info->last_dl_rate / 100; // Kbps to 100kb
+
+    ONEWIFI_LOG_DEBUG("Monitor: Updated STA stats for %s - tx_bytes=%lu rx_bytes=%lu tx_rate=%u rx_rate=%u",
+                      sta_mac.c_str(), sta_stats.tx_bytes_cnt, sta_stats.rx_bytes_cnt,
+                      sta_stats.tx_phy_rate_100kb, sta_stats.rx_phy_rate_100kb);
+
+    return true;
+}
