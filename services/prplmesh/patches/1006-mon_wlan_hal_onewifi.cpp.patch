+bool mon_wlan_hal_onewifi::update_radio_stats(SRadioStats &radio_stats)
+{
+    // Get radio MAC to find the correct radio in data model
+    std::string radio_mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(m_radio_info.iface_name, radio_mac_str)) {
+        ONEWIFI_LOG_ERROR("Monitor: Failed to get MAC for interface %s", m_radio_info.iface_name.c_str());
+        return false;
+    }
+
+    mac_address_t radio_mac;
+    tlvf::mac_from_string(radio_mac, radio_mac_str);
+
+    // Find radio info by MAC
+    em_radio_info_t *radio_info = nullptr;
+    for (unsigned int i = 0; i < m_data_model->get_num_radios(); i++) {
+        em_radio_info_t *r = m_data_model->get_radio_info(i);
+        if (r && memcmp(r->intf.mac, radio_mac, sizeof(mac_address_t)) == 0) {
+            radio_info = r;
+            break;
+        }
+    }
+
+    if (!radio_info) {
+        ONEWIFI_LOG_WARN("Monitor: No radio info found for MAC %s", radio_mac_str.c_str());
+        return false;
+    }
+
+    // Populate radio stats from radio_info (from em_base.h structure)
+    // Note: em_radio_info_t doesn't have traffic_stats, using available fields
+    radio_stats.noise = radio_info->noise;
+    radio_stats.utilization = radio_info->utilization;
+    radio_stats.transmit = radio_info->transmit;
+    radio_stats.receive_self = radio_info->receive_self;
+    radio_stats.receive_other = radio_info->receive_other;
+
+    // Traffic stats not available in em_radio_info_t, set to 0
+    radio_stats.tx_bytes_cnt = 0;
+    radio_stats.tx_packets_cnt = 0;
+    radio_stats.rx_bytes_cnt = 0;
+    radio_stats.rx_packets_cnt = 0;
+    radio_stats.errors_sent = 0;
+    radio_stats.errors_received = 0;
+
+    ONEWIFI_LOG_DEBUG("Monitor: Updated radio stats - util=%u tx=%u rx_self=%u rx_other=%u",
+                      radio_stats.utilization, radio_stats.transmit, 
+                      radio_stats.receive_self, radio_stats.receive_other);
+
+    return true;
+}
+
+bool mon_wlan_hal_onewifi::update_vap_stats(const std::string &vap_iface_name, SVapStats &vap_stats)
+{
+    // Convert VAP interface name to BSSID
+    std::string vap_mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(vap_iface_name, vap_mac_str)) {
+        ONEWIFI_LOG_ERROR("Monitor: Failed to get MAC for VAP interface %s", vap_iface_name.c_str());
+        return false;
+    }
+
+    mac_address_t vap_mac;
+    tlvf::mac_from_string(vap_mac, vap_mac_str);
+
+    // Find BSS info by BSSID
+    em_bss_info_t *bss_info = m_data_model->get_bss_info_with_mac(vap_mac);
+    if (!bss_info) {
+        ONEWIFI_LOG_WARN("Monitor: No BSS info found for VAP %s (MAC %s)", 
+                         vap_iface_name.c_str(), vap_mac_str.c_str());
+        return false;
+    }
+
+    // Populate VAP stats from bss_info (from em_base.h structure)
+    // Note: em_bss_info_t has extended report fields
+    vap_stats.tx_bytes_cnt = bss_info->unicast_bytes_sent;
+    vap_stats.rx_bytes_cnt = bss_info->unicast_bytes_rcvd;
+    
+    // Other traffic stats not directly available, set to 0
+    vap_stats.tx_packets_cnt = 0;
+    vap_stats.rx_packets_cnt = 0;
+    vap_stats.errors_sent = 0;
+    vap_stats.errors_received = 0;
+    vap_stats.retrans_count = 0;
+
+    ONEWIFI_LOG_DEBUG("Monitor: Updated VAP stats for %s - tx_bytes=%lu rx_bytes=%lu",
+                      vap_iface_name.c_str(), vap_stats.tx_bytes_cnt, vap_stats.rx_bytes_cnt);
+
+    return true;
+}
