+bool mon_wlan_hal_onewifi::channel_scan_dump_results()
+{
+    ONEWIFI_LOG_INFO("Monitor: channel_scan_dump_results: reading %zu scan results from shared data model",
+                     m_data_model->get_num_scan_results());
+
+    // Read scan results from shared data model (populated by AP HAL's on_channel_scan_data)
+    // and push Channel_Scan_New_Results_Ready per neighbor, then Channel_Scan_Finished
+    for (size_t r = 0; r < m_data_model->get_num_scan_results(); r++) {
+        em_scan_result_t *scan = m_data_model->get_scan_result(r);
+        if (!scan) continue;
+
+        for (int n = 0; n < scan->num_neighbors && n < EM_MAX_NEIGHBORS; n++) {
+            auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sCHANNEL_SCAN_RESULTS_NOTIFICATION));
+            auto msg = reinterpret_cast<sCHANNEL_SCAN_RESULTS_NOTIFICATION *>(msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            new (msg) sCHANNEL_SCAN_RESULTS_NOTIFICATION();
+
+            auto &res = msg->channel_scan_results;
+
+            strlcpy(res.ssid, scan->neighbor[n].ssid, sizeof(res.ssid));
+            memcpy(res.bssid.oct, scan->neighbor[n].bssid, sizeof(mac_address_t));
+            res.channel             = scan->id.channel;
+            res.signal_strength_dBm = static_cast<int32_t>(scan->neighbor[n].signal_strength);
+            res.noise_dBm           = static_cast<int32_t>(scan->noise);
+            res.utilization         = scan->util;
+            res.channel_utilization = scan->neighbor[n].channel_util;
+            res.station_count       = scan->neighbor[n].sta_count;
+
+            switch (scan->neighbor[n].bandwidth) {
+            case WIFI_CHANNELBANDWIDTH_20MHZ:
+                res.operating_channel_bandwidth =
+                    eChannelScanResultChannelBandwidth::eChannel_Bandwidth_20MHz;
+                break;
+            case WIFI_CHANNELBANDWIDTH_40MHZ:
+                res.operating_channel_bandwidth =
+                    eChannelScanResultChannelBandwidth::eChannel_Bandwidth_40MHz;
+                break;
+            case WIFI_CHANNELBANDWIDTH_80MHZ:
+                res.operating_channel_bandwidth =
+                    eChannelScanResultChannelBandwidth::eChannel_Bandwidth_80MHz;
+                break;
+            case WIFI_CHANNELBANDWIDTH_160MHZ:
+                res.operating_channel_bandwidth =
+                    eChannelScanResultChannelBandwidth::eChannel_Bandwidth_160MHz;
+                break;
+            default:
+                res.operating_channel_bandwidth =
+                    eChannelScanResultChannelBandwidth::eChannel_Bandwidth_NA;
+                break;
+            }
+
+            event_queue_push(static_cast<int>(Event::Channel_Scan_New_Results_Ready), msg_buff);
+            ONEWIFI_LOG_DEBUG("Monitor: Pushed Channel_Scan_New_Results_Ready ch=%u ssid=%s",
+                              res.channel, res.ssid);
+        }
+    }
+
+    event_queue_push(static_cast<int>(Event::Channel_Scan_Finished));
+    ONEWIFI_LOG_INFO("Monitor: Pushed Channel_Scan_Finished");
+    return true;
+}
