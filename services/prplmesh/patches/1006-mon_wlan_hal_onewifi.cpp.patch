+bool mon_wlan_hal_onewifi::generate_connected_clients_events(
+    bool &is_finished_all_clients,
+    const std::chrono::steady_clock::time_point max_iteration_timeout)
+{
+    // Re-enumerate currently connected STAs from the data model populated during attach().
+    ONEWIFI_LOG_DEBUG("Monitor: generate_connected_clients_events: enumerating connected STAs from data model");
+
+    em_sta_info_t *sta = m_data_model->get_first_sta_info(em_target_sta_map_assoc);
+    while (sta) {
+        if (sta->associated) {
+            // Look up BSS to get interface name for vap_id
+            em_bss_info_t *bss = m_data_model->get_bss_info_with_mac(sta->bssid);
+            int8_t vap_id = (bss) ? get_vap_id_with_bss(std::string(bss->bssid.name)) : -1;
+            if (vap_id >= 0) {
+                auto msg_buff =
+                    ALLOC_SMART_BUFFER(sizeof(sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION));
+                auto msg = reinterpret_cast<sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION *>(
+                    msg_buff.get());
+                LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+                memset(msg_buff.get(), 0, sizeof(sACTION_MONITOR_CLIENT_ASSOCIATED_NOTIFICATION));
+                msg->vap_id = vap_id;
+                memcpy(msg->mac.oct, sta->id, sizeof(mac_address_t));
+                event_queue_push(static_cast<int>(Event::STA_Connected), msg_buff);
+                ONEWIFI_LOG_DEBUG("Monitor: generate_connected_clients_events: pushed STA_Connected vap_id=%d",
+                                  int(vap_id));
+            }
+        }
+        sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_assoc);
+    }
+
+    is_finished_all_clients = true;
+    return true;
+}
