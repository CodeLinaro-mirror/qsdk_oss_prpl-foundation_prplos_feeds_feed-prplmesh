+bool ap_wlan_hal_nl80211::acs_get_block_chan_list(std::vector<uint8_t> &out_channels)
+{
+    out_channels.clear();
+
+    const std::string link_iface = m_radio_info.iface_name;
+    std::string radio_iface;
+    extractLinkBaseInterface(link_iface, radio_iface);
+    if (radio_iface.empty()) {
+        radio_iface = link_iface;
+    }
+    if (!is_wpa_ctrl_interface_registered(radio_iface)) {
+        if (add_interface(radio_iface) < 0) {
+            LOG(WARNING) << "acs_get_block_chan_list: add_interface(" << radio_iface
+                         << ") failed; will still attempt to send on it";
+        }
+    }
+
+    char *reply           = nullptr;
+    const std::string cmd = "ACS get_block_chan_list";
+    if (!wpa_ctrl_send_msg(cmd, &reply, radio_iface) || !reply) {
+        LOG(DEBUG) << "acs_get_block_chan_list: '" << cmd << "' failed/empty on iface="
+                   << radio_iface;
+        return false;
+    }
+
+    // Parse the reply into channel numbers. The reply is a whitespace/comma separated list of
+    // integers (the exact separator varies across driver versions); accept any non-digit as a
+    // delimiter and collect the integer tokens.
+    const std::string reply_str(reply);
+    std::string token;
+    auto flush_token = [&]() {
+        if (!token.empty()) {
+            const long v = std::strtol(token.c_str(), nullptr, 10);
+            if (v > 0 && v <= 255) {
+                out_channels.push_back(static_cast<uint8_t>(v));
+            }
+            token.clear();
+        }
+    };
+    for (const char c : reply_str) {
+        if (c >= '0' && c <= '9') {
+            token.push_back(c);
+        } else {
+            flush_token();
+        }
+    }
+    flush_token();
+
+    LOG(DEBUG) << "acs_get_block_chan_list: parsed " << out_channels.size()
+               << " blocked channel(s) on iface=" << radio_iface;
+    return true;
+}
