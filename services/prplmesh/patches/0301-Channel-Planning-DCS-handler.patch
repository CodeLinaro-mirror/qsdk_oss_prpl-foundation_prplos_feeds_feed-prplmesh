+bool ap_wlan_hal_nl80211::acs_set_block_chan_list(const std::vector<uint8_t> &channels)
+{
+    const std::string link_iface = m_radio_info.iface_name;
+    std::string radio_iface;
+    extractLinkBaseInterface(link_iface, radio_iface);
+    if (radio_iface.empty()) {
+        radio_iface = link_iface;
+    }
+    if (!is_wpa_ctrl_interface_registered(radio_iface)) {
+        if (add_interface(radio_iface) < 0) {
+            LOG(WARNING) << "acs_set_block_chan_list: add_interface(" << radio_iface
+                         << ") failed; will still attempt to send on it";
+        }
+    }
+
+    if (channels.empty()) {
+        LOG(DEBUG) << "acs_set_block_chan_list: empty channel list, nothing to set on iface="
+                   << radio_iface;
+        return true;
+    }
+
+    std::stringstream cmd_ss;
+    cmd_ss << "ACS set_block_chan_list";
+    for (const auto ch : channels) {
+        cmd_ss << " " << int(ch);
+    }
+    const std::string cmd = cmd_ss.str();
+
+    char *reply = nullptr;
+    LOG(INFO) << "acs_set_block_chan_list: sending '" << cmd << "' (" << channels.size()
+              << " channels) on iface=" << radio_iface;
+    if (!wpa_ctrl_send_msg(cmd, &reply, radio_iface)) {
+        LOG(ERROR) << "acs_set_block_chan_list: '" << cmd << "' failed on iface=" << radio_iface
+                   << " reply='" << (reply ? reply : "") << "'";
+        return false;
+    }
+    LOG(DEBUG) << "acs_set_block_chan_list: OK reply='" << (reply ? reply : "") << "'";
+    return true;
