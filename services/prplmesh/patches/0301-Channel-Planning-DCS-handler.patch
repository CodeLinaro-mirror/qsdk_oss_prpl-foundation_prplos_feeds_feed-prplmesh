+bool ap_wlan_hal_whm::acs_set_block_chan_list(const std::vector<uint8_t> &channels)
+{
+    if (m_radio_path.empty()) {
+        m_ambiorix_cl.resolve_path(wbapi_utils::search_path_radio_by_iface(m_radio_info.iface_name),
+                                   m_radio_path);
+    }
+    if (m_radio_path.empty()) {
+        LOG(ERROR) << "acs_set_block_chan_list: could not resolve radio path for iface "
+                   << m_radio_info.iface_name;
+        return false;
+    }
+
+    // Build a comma-separated channel list value for WiFi.Radio.{i}.ACS.BlockChanList.
+    std::stringstream ss;
+    for (size_t i = 0; i < channels.size(); i++) {
+        if (i != 0) {
+            ss << ",";
+        }
+        ss << int(channels[i]);
+    }
+    const std::string block_list = ss.str();
+
+    AmbiorixVariant new_obj(AMXC_VAR_ID_HTABLE);
+    new_obj.add_child("BlockChanList", block_list);
+    if (!m_ambiorix_cl.update_object(m_radio_path + "ACS.", new_obj)) {
+        LOG(ERROR) << "acs_set_block_chan_list: failed to set BlockChanList='" << block_list
+                   << "' for " << m_radio_path << "ACS.";
+        return false;
+    }
+
+    LOG(DEBUG) << "acs_set_block_chan_list: set BlockChanList='" << block_list << "' ("
+               << channels.size() << " channels) for " << m_radio_path << "ACS.";
+    return true;
