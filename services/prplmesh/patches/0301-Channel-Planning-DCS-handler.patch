+    hal_conf.cbs_based_chansel_enable = cbs_based_chansel_enable;
     LOG(DEBUG) << "[ACTIVE_ACS] create_ap_wlan_hal: iface=" << m_iface
                << " active_acs_chansel_enable=" << hal_conf.active_acs_chansel_enable
                << " cbs_based_chansel_enable=" << hal_conf.cbs_based_chansel_enable
@@ -1375,6 +1376,14 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
         certification_mode = config->certification_mode();
         multi_ap_profile   = config->multi_ap_profile();
+        /**
+         * Channel-selection approach knobs forwarded from the agent process (beerocks_agent.conf).
+         * They must be cached BEFORE create_ap_wlan_hal() is called (below, in this same handler),
+         * because the bwl HAL gates (refresh_radio_info() rank baseline, read_acs_report(),
+         * CBS trigger) are keyed on hal_conf.*_chansel_enable.
+         */
+        cbs_based_chansel_enable  = static_cast<bool>(config->cbs_based_chansel_enable());
+        active_acs_chansel_enable = static_cast<bool>(config->active_acs_chansel_enable());
         m_local_gw         = static_cast<bool>(config->local_gw());
         m_radio_disable    = static_cast<bool>(config->radio_disable());
         LOG(DEBUG) << "ACTION_APMANAGER_CONFIGURE: local_gw=" << m_local_gw
@@ -1958,6 +1967,46 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         }
         break;
     }
+    case beerocks_message::ACTION_APMANAGER_HOSTAP_SET_ACS_BLOCK_LIST: {
+        // Block-list-only programming (NO "ACS invoke 0"). son_slave forwards
+        // ChannelSelectionTask::apply_preferred_channel_block_list(invoke_acs=false) here.
+        // Extract the flat channel list, clear the driver ACS block list, then (if non-empty)
+        // program it. The programmed set is cached in m_cached_acs_block_chan_list so the CBS
+        // periodic-trigger work-around can save/flush/restore it around "CBS enable 1".
+        auto request =
+            beerocks_header
+                ->addClass<beerocks_message::cACTION_APMANAGER_HOSTAP_SET_ACS_BLOCK_LIST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_HOSTAP_SET_ACS_BLOCK_LIST failed";
+            return;
+        }
+
+        std::vector<uint8_t> block;
+        const uint8_t n_channels = request->block_channels_size();
+        block.reserve(n_channels);
+        for (uint8_t i = 0; i < n_channels; i++) {
+            block.push_back(*request->block_channels(i));
+        }
+
+        LOG(DEBUG) << "[CBS] SET_ACS_BLOCK_LIST: programming " << int(n_channels)
+                   << " blocked channel(s) on iface=" << m_iface;
+
+        if (!ap_wlan_hal->acs_clear_block_chan_list()) {
+            LOG(WARNING) << "[CBS] SET_ACS_BLOCK_LIST: acs_clear_block_chan_list() failed on iface="
+                         << m_iface;
+        }
+        if (!block.empty()) {
+            if (!ap_wlan_hal->acs_set_block_chan_list(block)) {
+                LOG(WARNING) << "[CBS] SET_ACS_BLOCK_LIST: acs_set_block_chan_list(" << block.size()
+                             << " channels) failed on iface=" << m_iface;
+            }
+        }
+
+        // Cache the last-programmed block list (store even if empty so a later clear is
+        // reflected). Used by the TRIGGER_CBS save/flush/restore work-around.
+        m_cached_acs_block_chan_list = std::move(block);
+        break;
+    }
     case beerocks_message::ACTION_APMANAGER_HOSTAP_TRIGGER_CBS: {
         // Dedicated periodic-CBS trigger. son_slave forwards ChannelSelectionTask::work()'s
         // cACTION_BACKHAUL_HOSTAP_TRIGGER_CBS here. Unlike the channels-list request (which only
@@ -1969,11 +2018,38 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         // This message is only ever sent by the backhaul side when cbs_based_chansel_enable=1
         // (where the AgentDB flag IS valid), so the decision has already been gated there; the
         // ap_manager simply performs the trigger unconditionally when it receives this message.
+        //
+        // CBS periodic-trigger work-around: some drivers will not run a fresh CBS scan while an
+        // ACS block list is programmed. Flush the block list before the trigger and restore the
+        // Agent-side cached copy afterwards so the driver's autonomous channel switch remains
+        // confined to the controller-preferred set once CBS completes.
+        const bool had_block_list = !m_cached_acs_block_chan_list.empty();
+        if (had_block_list) {
+            LOG(DEBUG) << "[CBS] TRIGGER_CBS: flushing cached block list ("
+                       << m_cached_acs_block_chan_list.size()
+                       << " channels) before CBS trigger on iface=" << m_iface;
+            if (!ap_wlan_hal->acs_clear_block_chan_list()) {
+                LOG(WARNING) << "[CBS] TRIGGER_CBS: acs_clear_block_chan_list() failed on iface="
+                             << m_iface;
+            }
+        }
+
         LOG(DEBUG) << "[CBS] TRIGGER_CBS: initiating one-shot driver CBS (cbs enable 1) on iface="
                    << m_iface;
         if (!ap_wlan_hal->trigger_cbs()) {
             LOG(WARNING) << "[CBS] TRIGGER_CBS: trigger_cbs() failed on iface=" << m_iface;
         }
+
+        if (had_block_list) {
+            LOG(DEBUG) << "[CBS] TRIGGER_CBS: restoring cached block list ("
+                       << m_cached_acs_block_chan_list.size()
+                       << " channels) after CBS trigger on iface=" << m_iface;
+            if (!ap_wlan_hal->acs_set_block_chan_list(m_cached_acs_block_chan_list)) {
+                LOG(WARNING) << "[CBS] TRIGGER_CBS: acs_set_block_chan_list("
+                             << m_cached_acs_block_chan_list.size()
+                             << " channels) failed on iface=" << m_iface;
+            }
+        }
         break;
     }
     case beerocks_message::ACTION_APMANAGER_CHANNELS_LIST_REQUEST: {
@@ -2944,6 +3020,31 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             LOG(ERROR) << "start_platform_acs failed!";
             return;
         }
+
+        // Active-ACS also programs the driver block list (inside start_platform_acs()). Populate
+        // the Agent-side cache from the acs_params exclude-channels (flattened + de-duplicated
+        // across op-classes) so the CBS periodic-trigger work-around restores the correct set
+        // even in Active-ACS mode.
+        {
+            std::set<uint8_t> block_set;
+            auto params = request->acs_params();
+            if (params) {
+                for (size_t i = 0; i < params->acs_list_length(); ++i) {
+                    auto entry_tuple = params->acs_list(i);
+                    if (!std::get<0>(entry_tuple)) {
+                        continue;
+                    }
+                    auto &entry = std::get<1>(entry_tuple);
+                    for (size_t j = 0; j < entry.exclude_channels_length(); ++j) {
+                        block_set.insert(*entry.exclude_channels(j));
+                    }
+                }
+            }
+            m_cached_acs_block_chan_list.assign(block_set.begin(), block_set.end());
+            LOG(DEBUG) << "[ACTIVE_ACS] PLATFORM_ACS: cached "
+                       << m_cached_acs_block_chan_list.size()
+                       << " blocked channel(s) for CBS work-around on iface=" << m_iface;
+        }
         break;
     }
 #ifdef USE_PRPLMESH_NLHAL
