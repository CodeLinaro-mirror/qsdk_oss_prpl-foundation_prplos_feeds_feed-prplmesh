+beerocks::eWiFiBandwidth
+ChannelSelectionTask::resolve_usable_bandwidth(const AgentDB::sRadio *radio, uint8_t channel,
+                                              beerocks::eWiFiBandwidth desired_bw,
+                                              const std::string &context)
+{
+    if (!radio) {
+        LOG(WARNING) << "[BW_RESOLVE] " << context << ": null radio -> keeping desired bw "
+                     << beerocks::utils::convert_bandwidth_to_string(desired_bw);
+        return desired_bw;
+    }
+
+    auto freq_type = radio->wifi_channel.get_freq_type();
+    if (freq_type == beerocks::eFreqType::FREQ_UNKNOWN) {
+        freq_type = radio->frequency_band;
+    }
+
+    // Numeric width of a bandwidth enum (generic and specific variants collapse to the same width).
+    const auto bw_mhz = [](beerocks::eWiFiBandwidth bw) -> uint32_t {
+        return get_bandwidth_mhz(bw);
+    };
+
+    /**
+     * A (channel, bw) pair is usable only if BOTH:
+     *   - it maps to a valid operating class for this band, AND
+     *   - the band's channels table can give a center frequency for it (20MHz needs only the
+     *     channel->freq mapping). This is exactly what send_channel_switch_request() will do, so
+     *     validating with the same helpers guarantees vht_center_frequency != 0 downstream.
+     * Band/op-class agnostic: works for 2.4GHz, 5GHz (incl. 5GL/5GH) and 6GHz alike.
+     */
+    const auto is_usable = [&](beerocks::eWiFiBandwidth bw) -> bool {
+        if (bw == beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+            return false;
+        }
+        if (son::wireless_utils::get_operating_class_by_channel(
+                beerocks::WifiChannel(channel, freq_type, bw)) == 0) {
+            return false;
+        }
+        if (bw >= beerocks::eWiFiBandwidth::BANDWIDTH_40) {
+            return son::wireless_utils::get_vht_central_frequency(channel, bw, freq_type) != 0;
+        }
+        return son::wireless_utils::channel_to_freq(channel, freq_type) != 0;
+    };
+
+    // Candidate list: what the radio reports as supported for this channel. If the channel is not
+    // in channels_list (should not happen), fall back to the generic ladder so we still validate.
+    std::vector<beerocks::eWiFiBandwidth> candidates;
+    const auto it_ch = radio->channels_list.find(channel);
+    if (it_ch != radio->channels_list.end() && !it_ch->second.supported_bw_list.empty()) {
+        for (const auto &sbw : it_ch->second.supported_bw_list) {
+            candidates.push_back(sbw.bandwidth);
+        }
+    } else {
+        LOG(WARNING) << "[BW_RESOLVE] " << context << ": channel " << int(channel)
+                     << " not in radio channels_list -> validating against the generic bw ladder";
+        candidates = {beerocks::eWiFiBandwidth::BANDWIDTH_320_2,
+                      beerocks::eWiFiBandwidth::BANDWIDTH_320_1,
+                      beerocks::eWiFiBandwidth::BANDWIDTH_320,
+                      beerocks::eWiFiBandwidth::BANDWIDTH_160,
+                      beerocks::eWiFiBandwidth::BANDWIDTH_80,
+                      beerocks::eWiFiBandwidth::BANDWIDTH_40,
+                      beerocks::eWiFiBandwidth::BANDWIDTH_20};
+    }
+
+    const uint32_t desired_mhz = bw_mhz(desired_bw);
+
+    // (1) Exact enum match and usable -> nothing to do.
+    for (const auto bw : candidates) {
+        if (bw == desired_bw && is_usable(bw)) {
+            return desired_bw;
+        }
+    }
+
+    // (2) Same WIDTH, different enum variant (generic <-> specific, e.g. 320 <-> 320-1/320-2,
+    //     80 <-> 80+80). This is the common "generic enum vs per-channel variant" mismatch.
+    for (const auto bw : candidates) {
+        if (bw_mhz(bw) == desired_mhz && desired_mhz != 0 && is_usable(bw)) {
+            LOG(DEBUG) << "[BW_RESOLVE] " << context << ": channel " << int(channel) << " band="
+                       << beerocks::utils::convert_frequency_type_to_string(freq_type)
+                       << " -> mapped requested "
+                       << beerocks::utils::convert_bandwidth_to_string(desired_bw) << " to "
+                       << beerocks::utils::convert_bandwidth_to_string(bw)
+                       << " (same width, channel-specific variant)";
+            return bw;
+        }
+    }
+
+    // (3) Degrade: widest usable bandwidth that is NARROWER than the desired one.
+    beerocks::eWiFiBandwidth best = beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN;
+    uint32_t best_mhz             = 0;
+    for (const auto bw : candidates) {
+        const auto w = bw_mhz(bw);
+        if (desired_mhz != 0 && w > desired_mhz) {
+            continue; // never widen beyond what was asked for
+        }
+        if (w > best_mhz && is_usable(bw)) {
+            best     = bw;
+            best_mhz = w;
+        }
+    }
+    // (4) Last resort: any usable bandwidth (even wider), so we never emit an invalid switch.
+    if (best == beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+        for (const auto bw : candidates) {
+            const auto w = bw_mhz(bw);
+            if (w > best_mhz && is_usable(bw)) {
+                best     = bw;
+                best_mhz = w;
+            }
+        }
+    }
+
+    if (best == beerocks::eWiFiBandwidth::BANDWIDTH_UNKNOWN) {
+        LOG(ERROR) << "[BW_RESOLVE] " << context << ": no usable bandwidth found for channel "
+                   << int(channel) << " band="
+                   << beerocks::utils::convert_frequency_type_to_string(freq_type)
+                   << " -> keeping requested "
+                   << beerocks::utils::convert_bandwidth_to_string(desired_bw)
+                   << " (the driver switch will most likely fail)";
+        return desired_bw;
+    }
+
+    LOG(DEBUG) << "[BW_RESOLVE] " << context << ": channel " << int(channel) << " band="
+               << beerocks::utils::convert_frequency_type_to_string(freq_type)
+               << " does not support requested "
+               << beerocks::utils::convert_bandwidth_to_string(desired_bw)
+               << " -> degrading to widest usable "
+               << beerocks::utils::convert_bandwidth_to_string(best);
+    return best;
+}
