+bool ChannelSelectionTask::apply_preferred_channel_block_list(const sMacAddr &radio_mac,
+                                                              bool invoke_acs)
+{
+    if (invoke_acs) {
+        // Active-ACS path: unchanged. Program block list AND run "ACS invoke 0" on the driver.
+        return send_acs_list_to_platform(radio_mac);
+    }
+
+    /**
+     * CBS path: block-list-only (NO "ACS invoke 0"). Agreed block-list rules, derived here from the
+     * controller preference of the CURRENT request (independent of m_acs_list / build_acs_list,
+     * whose non-active-ACS exclude list only covers explicitly preference==0 op-classes):
+     *
+     *   Rule 1 (|preferred| == 1): FLUSH the block list only (empty list -> ap_manager performs
+     *           acs_clear_block_chan_list() and skips the set). The single preferred channel is
+     *           reached by the explicit channel switch, so no blocking is required.
+     *   Rule 2 (|preferred| >  1): FLUSH + SET block list = all radio channels - preferred set,
+     *           regardless of whether the current operating channel is in the preferred set.
+     *   |preferred| == 0 -> nothing to derive: flush only.
+     *
+     * "preferred" is the EFFECTIVE preferred set: the channels the controller reported operable
+     * (preference != 0); if the controller sent no operable op-class at all, it is
+     * (all radio channels - explicitly excluded channels), matching select_best_channel_from_cbs().
+     */
+    auto radio_for_block = AgentDB::get()->get_radio_by_mac(radio_mac, AgentDB::eMacType::RADIO);
+    if (!radio_for_block) {
+        LOG(ERROR) << "[CBS] apply_preferred_channel_block_list: radio " << radio_mac
+                   << " not found in DB";
+        return false;
+    }
+
+    const auto &ctrl_prefs = m_pending_selection.requests[radio_mac].controller_preferences;
+    std::set<uint8_t> preferred_channels = build_preferred_channel_set(ctrl_prefs);
+    if (preferred_channels.empty()) {
+        std::set<uint8_t> excluded_channels;
+        for (const auto &pref : ctrl_prefs) {
+            if (pref.first.flags.preference != 0) {
+                continue;
+            }
+            if (pref.second.empty()) {
+                const auto oc_it =
+                    son::wireless_utils::operating_classes_list.find(pref.first.operating_class);
+                if (oc_it != son::wireless_utils::operating_classes_list.end()) {
+                    for (const auto ch : oc_it->second.channels) {
+                        excluded_channels.insert(ch);
+                    }
+                }
+            } else {
+                for (const auto ch : pref.second) {
+                    excluded_channels.insert(ch);
+                }
+            }
+        }
+        for (const auto &ch_pair : radio_for_block->channels_list) {
+            if (excluded_channels.find(ch_pair.first) == excluded_channels.end()) {
+                preferred_channels.insert(ch_pair.first);
+            }
+        }
+        LOG(DEBUG) << "[CBS] apply_preferred_channel_block_list: no explicit preferred op-class; "
+                      "derived effective preferred set = all_radio_channels - excluded ("
+                   << excluded_channels.size() << " excluded, " << preferred_channels.size()
+                   << " preferred) for radio " << radio_mac;
+    }
+
+    std::set<uint8_t> block_set;
+    if (preferred_channels.size() > 1) {
+        for (const auto &ch_pair : radio_for_block->channels_list) {
+            if (preferred_channels.find(ch_pair.first) == preferred_channels.end()) {
+                block_set.insert(ch_pair.first);
+            }
+        }
+        LOG(DEBUG) << "[CBS] apply_preferred_channel_block_list: Rule 2 (|preferred|="
+                   << preferred_channels.size() << " > 1) -> flush + block "
+                   << block_set.size() << " non-preferred channel(s) out of "
+                   << radio_for_block->channels_list.size() << " radio channel(s) for radio "
+                   << radio_mac;
+    } else {
+        LOG(DEBUG) << "[CBS] apply_preferred_channel_block_list: |preferred|="
+                   << preferred_channels.size()
+                   << " -> FLUSH block list only (no channels blocked) for radio " << radio_mac;
+    }
+
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_BACKHAUL_HOSTAP_SET_ACS_BLOCK_LIST>(m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "[CBS] apply_preferred_channel_block_list: failed to build "
+                      "cACTION_BACKHAUL_HOSTAP_SET_ACS_BLOCK_LIST message";
+        return false;
+    }
+
+    const uint8_t n_channels = static_cast<uint8_t>(block_set.size());
+    if (!request->alloc_block_channels(n_channels)) {
+        LOG(ERROR) << "[CBS] apply_preferred_channel_block_list: failed to allocate "
+                   << int(n_channels) << " block_channels";
+        return false;
+    }
+    request->block_channels_size() = n_channels;
+    {
+        uint8_t idx = 0;
+        for (const auto ch : block_set) {
+            *request->block_channels(idx) = ch;
+            ++idx;
+        }
+    }
+
+    auto agent_fd = m_btl_ctx.get_agent_fd();
+    if (agent_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "[CBS] apply_preferred_channel_block_list: socket to Agent not found";
+        return false;
+    }
+
+    auto action_header         = message_com::get_beerocks_header(m_cmdu_tx)->actionhdr();
+    action_header->radio_mac() = radio_mac;
+
+    LOG(DEBUG) << "[CBS] apply_preferred_channel_block_list: sending SET_ACS_BLOCK_LIST ("
+               << int(n_channels) << " channels) for radio " << radio_mac;
+    m_btl_ctx.send_cmdu(agent_fd, m_cmdu_tx);
+    return true;
+}
