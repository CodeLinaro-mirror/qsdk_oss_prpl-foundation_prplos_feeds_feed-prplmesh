+    // arrives from the agent process in cACTION_APMANAGER_CONFIGURE (beerocks_agent.conf).
+    hal_conf.active_acs_chansel_enable = active_acs_chansel_enable;
     // CBS-based channel selection: propagate the AgentDB flag into the bwl HAL so the ap_manager
     // can decide to trigger a one-shot driver CBS ("CBS enable 1" via trigger_cbs()) on periodic
     // channels-list requests. (The ap_manager runs in a separate process whose AgentDB copy is
