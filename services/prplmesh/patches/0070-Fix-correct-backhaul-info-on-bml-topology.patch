From e5f3fdb071394889d6528185a032365b1313e692 Mon Sep 17 00:00:00 2001
From: Dhivya <dsankar@qti.qualcomm.com>
Date: Tue, 10 Feb 2026 19:24:43 +0530
Subject: [PATCH] Fix-correct-backhaul-info-on-bml-topology

Signed-off-by: Dhivya <dsankar@qti.qualcomm.com>
---
 controller/src/beerocks/master/db/network_map.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/controller/src/beerocks/master/db/network_map.cpp b/controller/src/beerocks/master/db/network_map.cpp
index 0a3533f..be29adf 100644
--- a/controller/src/beerocks/master/db/network_map.cpp
+++ b/controller/src/beerocks/master/db/network_map.cpp
@@ -444,6 +444,14 @@ std::ptrdiff_t network_map::fill_bml_agent_data(db &database, std::shared_ptr<Ag
             ++i;
         }
     }
+    auto station = database.get_station(agent->parent_mac);
+    if (station) {
+    process_backhaul(database, station, node, agent->is_gateway);
+    } else {
+    LOG(WARNING) << "Parent station not found for MAC "
+                 << tlvf::mac_to_string(agent->parent_mac)
+                 << ", skipping backhaul processing";
+    }
     return node_len;
 }
 
