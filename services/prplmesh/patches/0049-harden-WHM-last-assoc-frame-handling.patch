From 8f78c072598b1fd868c239595abb346a579ac640 Mon Sep 17 00:00:00 2001
From: Dmytro Puz <d.puz@inango-systems.com>
Date: Tue, 14 Apr 2026 08:45:11 +0200
Subject: [PATCH] bwl: harden WHM last assoc frame handling

During WiFi stress testing, beerocks_fronth can crash while
generating connected-client events. The crash happens when reading the
"frame" field from the Ambiorix result returned by getLastAssocReq.

Harden ap_wlan_hal_whm::get_last_assoc_frame() so callers only receive a
result when path resolution succeeds, getLastAssocReq succeeds, and the
expected response child exists. Return an empty smart pointer on each
failure path, which is already handled by the callers.

Detach the returned child only after validating the call result and the
child pointer, preventing callers from reading from an invalid or partial
Ambiorix response.

Fixes: PPM-3995
Signed-off-by: Dmytro Puz <d.puz@inango-systems.com>
Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index fa7b1e397a..553408c99f 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -1372,19 +1372,23 @@ AmbiorixVariantSmartPtr ap_wlan_hal_whm::get_last_assoc_frame(const std::string
     bool ret = m_ambiorix_cl.resolve_path(wbapi_utils::search_path_ap_by_iface(vap_iface), ap_path);
     if (!ret) {
         LOG(ERROR) << "can't resolve " << wbapi_utils::search_path_ap_by_iface(vap_iface);
-    } else {
-        LOG(DEBUG) << "get assoc frame path " << ap_path << " for " << sta_mac;
+        return {};
     }
+    LOG(DEBUG) << "get assoc frame path " << ap_path << " for " << sta_mac;

     ret = m_ambiorix_cl.call(ap_path, "getLastAssocReq", args, data);
+    if (!ret) {
+        LOG(ERROR) << "getLastAssocReq() failed!";
+        return {};
+    }

     AmbiorixVariantSmartPtr result = data.find_child(0);
-    if (!ret || !result) {
-        LOG(ERROR) << "getLastAssocReq() failed!";
-    } else {
-        result->detach();
+    if (!result) {
+        LOG(ERROR) << "getLastAssocReq() returned empty result!";
+        return {};
     }

+    result->detach();
     return result;
 }

--
