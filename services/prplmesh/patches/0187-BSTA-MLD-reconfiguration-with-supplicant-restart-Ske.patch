diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index f0258c4b9..886936f19 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -2495,6 +2495,43 @@ bool BackhaulManager::handle_slave_backhaul_message(int fd, ieee1905_1::CmduMess
         }
         break;
     }
+
+    case beerocks_message::ACTION_BACKHAUL_SUPPLICANT_RESTART: {
+        LOG(INFO) << "Received ACTION_BACKHAUL_SUPPLICANT_RESTART";
+#ifdef USE_PRPLMESH_NLHAL
+        {
+            auto db = AgentDB::get();
+            if (db->supplicant_restart_required) {
+                LOG(INFO) << "Supplicant restart required after all radios updated with MLD info"
+                          << " — triggering FSM restart to reload wpa_supplicant configuration";
+                db->supplicant_restart_required = false;
+                // Trigger FSM restart so wpa_supplicant picks up the new MLD group configuration.
+                // This ensures the updated UCI/wireless config (written by bpl_cfg_update_bsta_mld_grp)
+                // is applied by restarting the supplicant through the normal backhaul restart sequence.
+                // Read bsta_reconfigure_with_supplicant_restart from prplmesh UCI config runtime.
+                // Only perform the FSM RESTART when the flag is enabled.
+                bool bsta_reconfigure_with_supplicant_restart = false;
+                beerocks::bpl::cfg_get_bsta_reconfigure_with_supplicant_restart(
+                    bsta_reconfigure_with_supplicant_restart);
+                LOG(INFO) << "bsta_reconfigure_with_supplicant_restart="
+                          << bsta_reconfigure_with_supplicant_restart;
+                if (bsta_reconfigure_with_supplicant_restart) {
+//                    call API for wpa_supplicant restart sequence   - TBD
+//                    stop_on_failure_attempts = configuration_stop_on_failure_attempts;
+//                    FSM_MOVE_STATE(RESTART);
+                } else {
+                    LOG(DEBUG) << "bsta_reconfigure_with_supplicant_restart is not set"
+                               << " — skipping FSM RESTART";
+                }
+            } else {
+                LOG(DEBUG) << "ACTION_BACKHAUL_SUPPLICANT_RESTART received but"
+                           << " supplicant_restart_required is not set — skipping restart";
+            }
+        }
+#endif // USE_PRPLMESH_NLHAL
+        break;
+    }
+
     case beerocks_message::ACTION_BACKHAUL_MLD_UPDATE_REQUEST: {
         auto request =
             beerocks_header->addClass<beerocks_message::cACTION_BACKHAUL_MLD_UPDATE_REQUEST>();
@@ -2537,20 +2574,9 @@ bool BackhaulManager::handle_slave_backhaul_message(int fd, ieee1905_1::CmduMess
             return false;
         }
 
-/* if sta_wlan_hal is in attached state or if connect is tried somewhere later, check if supp_rst flag is present
- * in sta_wlan_hal, if so, restart the supplicant, wait for a timeout and
- * then try attach or connect anywhere from backhaul manager
- * This makes sure config is saved during ethernet backhaul too and when eth to wifi switching happens,
- * new mld config will be effective and can be used */
-#ifdef USE_PRPLMESH_NLHAL
-        auto db                        = AgentDB::get();
-        if (db->supplicant_restart_required) {
-            LOG(DEBUG) << " Supplicant restart will be triggered by STA WLAN HAL this time\n";
-            db->supplicant_restart_required = false;
-        } else {
-            LOG(DEBUG) << " Supplicant restart will not be triggered by STA WLAN HAL this time\n";
-        }
-#endif
+        // Note: db->supplicant_restart_required is intentionally NOT reset here.
+        // It will be checked and reset by the ACTION_BACKHAUL_SUPPLICANT_RESTART handler
+        // which is sent by ap_autoconfiguration_task after all radios are updated with MLD info.
 
         if (!sta_wlan_hal->update_mld_unit(request->mld_unit())) {
             LOG(ERROR) << "Failed to update MLD Unit";
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
