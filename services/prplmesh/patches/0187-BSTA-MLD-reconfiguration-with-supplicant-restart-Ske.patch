         return;
     }
 
-    // Send bSTA MLD requests before sending BSS configuration
-    for (auto &bsta_mld_request : bsta_mld_requests_infos) {
-        send_bsta_mld_configuration(bsta_mld_request.first, bsta_mld_request.second.first,
-                                    bsta_mld_request.second.second);
+    // Send bSTA MLD requests after sending BSS configuration.
+    // Once all radios are updated with mld_info, send SUPPLICANT_RESTART to backhaul manager.
+    if (!bsta_mld_requests_infos.empty()) {
+        LOG(DEBUG) << "Sending bSTA MLD configuration for "
+                   << bsta_mld_requests_infos.size() << " radio(s)";
+        for (auto &bsta_mld_request : bsta_mld_requests_infos) {
+            send_bsta_mld_configuration(bsta_mld_request.first, bsta_mld_request.second.first,
+                                        bsta_mld_request.second.second);
+        }
+        // All radios have been updated with MLD info — trigger supplicant restart if needed.
+        // The backhaul manager checks db->supplicant_restart_required and only restarts
+        // wpa_supplicant if it was set during ACTION_BACKHAUL_MLD_UPDATE_REQUEST processing.
+        if (!send_backhaul_supplicant_restart()) {
+            LOG(ERROR) << "send_backhaul_supplicant_restart failed";
+        }
     }
     bsta_mld_requests_infos.clear();
 
@@ -2081,6 +2092,23 @@ void ApAutoConfigurationTask::handle_bsta_mld_configuration_request(
         return;
     }
 
+    // Send bSTA MLD configuration for all affiliated radios that were stored in
+    // bsta_mld_requests_infos by handle_bsta_mld_configuration_tlv.
+    // Once all radios are updated with MLD Info, trigger supplicant restart if needed.
+    if (!bsta_mld_requests_infos.empty()) {
+        LOG(DEBUG) << "Sending bSTA MLD configuration for "
+                   << bsta_mld_requests_infos.size() << " radio(s) from BSTA_MLD_CONFIGURATION_REQUEST";
+        for (auto &bsta_mld_request : bsta_mld_requests_infos) {
+            send_bsta_mld_configuration(bsta_mld_request.first, bsta_mld_request.second.first,
+                                        bsta_mld_request.second.second);
+        }
+        // All radios have been updated with MLD info — trigger supplicant restart if needed.
+        if (!send_backhaul_supplicant_restart()) {
+            LOG(ERROR) << "send_backhaul_supplicant_restart failed";
+        }
+    }
+    bsta_mld_requests_infos.clear();
+
     // Send BSTA_MLD_CONFIGURATION_RESPONSE_MESSAGE
     send_bsta_mld_configuration_response_message();
     return;
@@ -2935,6 +2963,25 @@ bool ApAutoConfigurationTask::send_bsta_configuration(const sMacAddr &radio_mac,
     return backhaul_manager_cmdu_client->send_cmdu(m_cmdu_tx);
 }
 
+bool ApAutoConfigurationTask::send_backhaul_supplicant_restart()
+{
+    auto request =
+        message_com::create_vs_message<beerocks_message::cACTION_BACKHAUL_SUPPLICANT_RESTART>(
+            m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "Failed building message cACTION_BACKHAUL_SUPPLICANT_RESTART!";
+        return false;
+    }
+    auto backhaul_manager_cmdu_client = m_btl_ctx.get_backhaul_manager_cmdu_client();
+    if (!backhaul_manager_cmdu_client) {
+        LOG(ERROR) << "Failed to get backhaul manager cmdu client";
+        return false;
+    }
+    LOG(INFO) << "Sending ACTION_BACKHAUL_SUPPLICANT_RESTART to BH manager"
+              << " (all radios updated with MLD info)";
+    return backhaul_manager_cmdu_client->send_cmdu(m_cmdu_tx);
+}
