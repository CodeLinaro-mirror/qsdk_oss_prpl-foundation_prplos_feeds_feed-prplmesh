+}
+cACTION_BACKHAUL_BSTA_STATE_NOTIFICATION::cACTION_BACKHAUL_BSTA_STATE_NOTIFICATION(std::shared_ptr<BaseClass> base, bool parse) :
+BaseClass(base->getBuffPtr(), base->getBuffRemainingBytes(), parse){
+    m_init_succeeded = init();
+}
