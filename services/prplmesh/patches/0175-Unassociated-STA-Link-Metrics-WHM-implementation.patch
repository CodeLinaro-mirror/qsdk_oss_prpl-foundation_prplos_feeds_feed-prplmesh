diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 588b6b643..7a6f25e69 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4601,8 +4601,31 @@ bool slave_thread::handle_cmdu_monitor_message(const std::string &fronthaul_ifac
 
             stations_stats one_station_stats;
             one_station_stats.channel_number = station_in.channel;
-            // signal_strength is already in RCPI format
-            one_station_stats.uplink_rcpi_dbm_enc = station_in.signal_strength;
+            if (station_in.signal_strength == 0) {
+                // WHM NaStaMonitor reports SignalStrength=0 when measurement is still not ready
+                // or when the STA is not visible on the requested channel. Do not convert this
+                // value with convert_rcpi_from_rssi(), since that would produce a fake valid RCPI.
+                one_station_stats.uplink_rcpi_dbm_enc = 0;
+            } else {
+                // WHM returns SignalStrength in dBm (e.g. -24).
+                // Convert RSSI (dBm) → RCPI using the standard formula: RCPI = 2*(RSSI+110).
+                // Then verify the round-trip by decoding RCPI back to RSSI.
+                // The RCPI value is stored as uint8_t in the TLV field.
+                // Note: RCPI values > 127 (e.g. 172 for -24 dBm) will appear negative in
+                // Wireshark because its dissector reads the field as signed int8.
+                // This is a Wireshark display issue; the wire value is correct per spec.
+                int8_t rssi_dbm = static_cast<int8_t>(station_in.signal_strength);
+                uint8_t rcpi    = son::wireless_utils::convert_rcpi_from_rssi(rssi_dbm);
+                int8_t decoded_rssi = son::wireless_utils::convert_rssi_from_rcpi(rcpi);
+                one_station_stats.uplink_rcpi_dbm_enc = rcpi;
+
+                LOG(DEBUG) << "Unassoc STA metrics WHM encoding:"
+                           << " sta=" << station_in.sta_mac
+                           << " rssi_dBm=" << int(rssi_dbm)
+                           << " rcpi_uint8=" << int(rcpi)
+                           << " decoded_rssi_dBm=" << int(decoded_rssi)
+                           << " wireshark_signed_display=" << int(static_cast<int8_t>(rcpi));
+            }
             one_station_stats.sta_mac = station_in.sta_mac;
             one_station_stats.measurement_to_report_delta_msec =
                 (uint32_t)std::chrono::duration_cast<std::chrono::milliseconds>(
@@ -4610,6 +4633,12 @@ bool slave_thread::handle_cmdu_monitor_message(const std::string &fronthaul_ifac
                     std::chrono::milliseconds(station_in.time_stamp))
                     .count();
 
+            LOG(DEBUG) << "Unassoc STA metrics summary: sta=" << station_in.sta_mac
+                       << " channel=" << int(station_in.channel)
+                       << " opclass=" << int(station_in.operating_class)
+                       << " raw_signal_strength_dBm=" << station_in.signal_strength
+                       << " uplink_rcpi_dbm_enc=" << int(one_station_stats.uplink_rcpi_dbm_enc);
+
             map_stations_per_operating_class[station_in.operating_class].push_back(
                 one_station_stats);
         }
diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
