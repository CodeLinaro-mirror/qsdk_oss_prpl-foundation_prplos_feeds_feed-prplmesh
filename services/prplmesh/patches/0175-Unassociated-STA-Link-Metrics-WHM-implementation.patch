+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
@@ -857,8 +857,14 @@ void LinkMetricsCollectionTask::handle_unassociated_sta_link_metrics_query(
                             << " Station with mac_addr: " << tlvf::mac_to_string(un_station_mac)
                             << " is already connected to the radio with mac_addr: "
                             << tlvf::mac_to_string(radio->front.iface_mac)
-                            << " --> it will not get monitored as non_associated station!";
+                            << " --> adding it to the WHM monitor request anyway";
                     }
+
+                    // For the WHM NaStaMonitor flow, still forward the STA to the monitor request
+                    // even if the STA is associated on one of the BSSes of the same radio. In this
+                    // deployment the measurement is expected to be taken via the repeater-side AP
+                    // data model path, and filtering it here causes the request to be dropped
+                    // entirely, resulting in total_stations=0 and no response at all.
                     map_stations_per_channel[channel].emplace_back(un_station_mac);
                 }
             }
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 6b7ea0973..45b743593 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -2267,13 +2267,211 @@ bool ap_wlan_hal_whm::send_delba(const std::string &ifname, const sMacAddr &dst,
 void ap_wlan_hal_whm::send_unassoc_sta_link_metric_query(
     std::shared_ptr<wfa_map::tlvUnassociatedStaLinkMetricsQuery> &query)
 {
+    if (!query) {
+        LOG(ERROR) << "send_unassoc_sta_link_metric_query: null query TLV";
+        return;
+    }
+
+    std::string nasta_monitor_path = m_radio_path + "NaStaMonitor";
+    uint8_t operating_class        = query->operating_class_of_channel_list();
+
+    LOG(DEBUG) << "send_unassoc_sta_link_metric_query: radio=" << m_radio_path
+               << " opclass=" << int(operating_class)
+               << " channels=" << int(query->channel_list_length());
+    LOG(DEBUG) << "UNASSOC_QUERY: nasta_monitor_path=" << nasta_monitor_path
+              << " radio_iface=" << m_radio_info.iface_name
+              << " opclass=" << int(operating_class)
+              << " num_channels=" << int(query->channel_list_length());
+
+    for (size_t i = 0; i < query->channel_list_length(); i++) {
+        auto ch_tuple = query->channel_list(i);
+        if (!std::get<0>(ch_tuple)) {
+            LOG(ERROR) << "channel_list(" << i << ") access failed";
+            continue;
+        }
+        auto &ch     = std::get<1>(ch_tuple);
+        uint8_t chan = ch.channel_number();
+
+        for (size_t j = 0; j < ch.sta_list_length(); j++) {
+            auto sta_tuple = ch.sta_list(j);
+            if (!std::get<0>(sta_tuple)) {
+                LOG(ERROR) << "sta_list(" << j << ") access failed";
+                continue;
+            }
+            std::string mac = tlvf::mac_to_string(std::get<1>(sta_tuple));
+
+            LOG(INFO) << "UNASSOC_QUERY: Adding STA=" << mac << " channel=" << int(chan)
+                      << " to NaStaMonitor path=" << nasta_monitor_path
+                      << " on radio_iface=" << m_radio_info.iface_name
+                      << " radio_path=" << m_radio_path;
+
+            AmbiorixVariant args(AMXC_VAR_ID_HTABLE), result;
+            args.add_child("macaddress", mac);
+            args.add_child("channel", chan);
+
+            if (!m_ambiorix_cl.call(nasta_monitor_path, "createNonAssociatedDevice", args,
+                                    result)) {
+                LOG(ERROR) << "createNonAssociatedDevice FAILED for STA=" << mac
+                           << " channel=" << int(chan)
+                           << " on radio=" << m_radio_info.iface_name;
+                continue;
+            }
+            LOG(INFO) << "createNonAssociatedDevice OK: STA=" << mac
+                      << " channel=" << int(chan)
+                      << " on radio=" << m_radio_info.iface_name
+                      << " radio_path=" << m_radio_path;
+
+            m_pending_unassoc_measurements[mac] = {chan, operating_class,
+                                                    std::chrono::steady_clock::now()};
+        }
+    }
+
+    if (!m_pending_unassoc_measurements.empty()) {
+        // Trigger the driver to update RSSI stats for all monitored STAs
+        AmbiorixVariant stats_args, stats_result;
+        LOG(INFO) << "UNASSOC_QUERY: calling getNaStationStats on " << nasta_monitor_path
+                  << " for " << m_pending_unassoc_measurements.size() << " pending STA(s)";
+        if (!m_ambiorix_cl.call(nasta_monitor_path, "getNaStationStats", stats_args,
+                                stats_result)) {
+            LOG(WARNING) << "getNaStationStats call FAILED (stats may be stale)";
+        } else {
+            LOG(INFO) << "getNaStationStats OK - driver will measure RSSI for "
+                      << m_pending_unassoc_measurements.size() << " STA(s)";
+        }
+    }
 }
 
 bool ap_wlan_hal_whm::prepare_unassoc_sta_link_metrics_response(
     std::shared_ptr<wfa_map::tlvUnassociatedStaLinkMetricsResponse> &response)
 {
-    //LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return false;
+    if (m_pending_unassoc_measurements.empty()) {
+        LOG(DEBUG) << "prepare_unassoc_sta_link_metrics_response: no pending measurements";
+        return false;
+    }
+
+    std::string nasta_monitor_path  = m_radio_path + "NaStaMonitor";
+    std::string non_assoc_dev_path  = m_radio_path + "NaStaMonitor.NonAssociatedDevice.";
+    auto now                        = std::chrono::steady_clock::now();
+
+    LOG(DEBUG) << "UNASSOC_RESPONSE: preparing response for "
+              << m_pending_unassoc_measurements.size() << " pending STA(s)"
+              << " nasta_path=" << nasta_monitor_path
+              << " non_assoc_dev_path=" << non_assoc_dev_path;
+
+    // Re-trigger stats refresh to get the latest RSSI measurements from the driver
+    // before reading the data model. This is critical because the driver may not have
+    // updated SignalStrength yet since the query was sent.
+    {
+        AmbiorixVariant refresh_args, refresh_result;
+        LOG(INFO) << "UNASSOC_RESPONSE: calling getNaStationStats to refresh RSSI data";
+        if (!m_ambiorix_cl.call(nasta_monitor_path, "getNaStationStats", refresh_args,
+                                refresh_result)) {
+            LOG(WARNING) << "UNASSOC_RESPONSE: getNaStationStats refresh FAILED"
+                         << " - SignalStrength values may be stale or zero";
+        } else {
+            LOG(INFO) << "UNASSOC_RESPONSE: getNaStationStats refresh OK";
+        }
+    }
+
+    // Set operating class from the first pending entry
+    response->operating_class_of_channel_list() =
+        m_pending_unassoc_measurements.begin()->second.operating_class;
+
+    // Read all NonAssociatedDevice instances from the data model
+    auto non_ass_devices =
+        m_ambiorix_cl.get_object_multi<AmbiorixVariantMapSmartPtr>(non_assoc_dev_path);
+
+    if (non_ass_devices) {
+        LOG(INFO) << "UNASSOC_RESPONSE: found " << non_ass_devices->size()
+                  << " NonAssociatedDevice entries in data model";
+        for (auto &dev : *non_ass_devices) {
+            std::string mac;
+            dev.second.read_child(mac, "MACAddress");
+            if (mac.empty()) {
+                LOG(WARNING) << "UNASSOC_RESPONSE: skipping device with empty MACAddress";
+                continue;
+            }
+
+            auto it = m_pending_unassoc_measurements.find(mac);
+            if (it == m_pending_unassoc_measurements.end()) {
+                LOG(DEBUG) << "UNASSOC_RESPONSE: STA=" << mac << " not in pending list, skipping";
+                continue;
+            }
+
+            int32_t signal_strength = 0;
+            bool ss_read_ok = dev.second.read_child(signal_strength, "SignalStrength");
+
+            LOG(INFO) << "UNASSOC_RSSI_RAW: STA=" << mac
+                      << " channel=" << int(it->second.channel)
+                      << " opclass=" << int(it->second.operating_class)
+                      << " SignalStrength_read_ok=" << ss_read_ok
+                      << " raw_signal_strength=" << signal_strength;
+
+            if (!ss_read_ok) {
+                LOG(WARNING) << "UNASSOC_RSSI_RAW: read_child(SignalStrength) FAILED for STA="
+                             << mac << " - value defaults to 0";
+            }
+            if (signal_strength == 0) {
+                LOG(WARNING) << "UNASSOC_RSSI_RAW: STA=" << mac
+                             << " SignalStrength=0 - driver may not have measured RSSI yet"
+                             << " (STA not visible on channel " << int(it->second.channel)
+                             << " or measurement pending)";
+            }
+
+            // SignalStrength is RSSI in dBm (negative value); convert to RCPI
+            // RCPI = 2 * (RSSI + 110), clamped to [0, 220]
+            // Note: signal_strength=0 means no measurement → rssi=0 → rcpi=220 (max)
+            //       which is incorrect; the driver should return a negative dBm value.
+            int8_t rssi  = static_cast<int8_t>(signal_strength);
+            uint8_t rcpi = (rssi >= 0) ? 220 : (rssi < -110) ? 0
+                                                               : static_cast<uint8_t>(2 * (rssi + 110));
+
+            uint32_t delta_ms = static_cast<uint32_t>(
+                std::chrono::duration_cast<std::chrono::milliseconds>(now - it->second.start_time)
+                    .count());
+
+            LOG(INFO) << "UNASSOC_RCPI_CALC: STA=" << mac
+                      << " channel=" << int(it->second.channel)
+                      << " opclass=" << int(it->second.operating_class)
+                      << " raw_signal_strength=" << signal_strength
+                      << " rssi_dBm=" << int(rssi)
+                      << " rcpi=" << int(rcpi)
+                      << " uplink_rcpi_dbm_enc=" << int(rcpi)
+                      << " delta_ms=" << delta_ms;
+
+            if (!response->alloc_sta_list(1)) {
+                LOG(ERROR) << "alloc_sta_list failed for STA " << mac;
+                continue;
+            }
+
+            uint8_t idx      = response->sta_list_length() - 1;
+            auto sta_tuple   = response->sta_list(idx);
+            if (!std::get<0>(sta_tuple)) {
+                LOG(ERROR) << "sta_list(" << int(idx) << ") access failed";
+                continue;
+            }
+            auto &sta                            = std::get<1>(sta_tuple);
+            sta.sta_mac                          = tlvf::mac_from_string(mac);
+            sta.channel_number                   = it->second.channel;
+            sta.uplink_rcpi_dbm_enc              = rcpi;
+            sta.measurement_to_report_delta_msec = delta_ms;
+        }
+    } else {
+        LOG(WARNING) << "Failed to read NonAssociatedDevice objects from " << non_assoc_dev_path;
+    }
+
+    // Cleanup: remove all pending STAs from NaStaMonitor
+    for (auto &entry : m_pending_unassoc_measurements) {
+        AmbiorixVariant del_args(AMXC_VAR_ID_HTABLE), del_result;
+        del_args.add_child("macaddress", entry.first);
+        if (!m_ambiorix_cl.call(nasta_monitor_path, "deleteNonAssociatedDevice", del_args,
+                                del_result)) {
+            LOG(WARNING) << "deleteNonAssociatedDevice failed for STA " << entry.first;
+        }
+    }
+    m_pending_unassoc_measurements.clear();
+
+    return true;
 }
 
