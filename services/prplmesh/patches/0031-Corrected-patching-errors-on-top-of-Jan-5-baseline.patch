---
 .../ap_manager/ap_manager.cpp                  | 18 +++++++++---------
 1 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index c82e62cb8..b1ade9af5 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1965,15 +1965,6 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                 if (!all_vaps_enabled && ap_wlan_hal->get_vap_status(bss_info_conf_list)) {
                     LOG(INFO) << "All vaps are enabled";
                     all_vaps_enabled = true;
-                }
-
-                if (!all_mld_updated && ap_wlan_hal->update_mld_status(bss_info_conf_list)) {
-                    LOG(INFO) << "MLD fields are updated";
-                    all_mld_updated = true;
-                }
-
-                if (all_vaps_enabled && all_mld_updated)
-                    break;
                 } else {
 #ifdef USE_PRPLMESH_NLHAL
                     m_ap_hal_ext_events  = ap_wlan_hal->get_ext_events_fds();
@@ -1983,6 +1974,15 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                           }
                     }
 #endif
+                }
+
+                if (!all_mld_updated && ap_wlan_hal->update_mld_status(bss_info_conf_list)) {
+                    LOG(INFO) << "MLD fields are updated";
+                    all_mld_updated = true;
+                }
+
+                if (all_vaps_enabled && all_mld_updated)
+                    break;
                 UTILS_SLEEP_MSEC(500);
             }
             if (all_vaps_enabled == false || all_mld_updated == false) {
