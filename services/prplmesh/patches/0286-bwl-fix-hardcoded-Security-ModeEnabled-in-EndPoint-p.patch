From bed70cb1a3210a5657c8aef3b86b80723e42041e Mon Sep 17 00:00:00 2001
From: nushanth <nushanth@qti.qualcomm.com>
Date: Tue, 21 Jul 2026 22:14:12 +0530
Subject: [PATCH] bwl: fix hardcoded Security ModeEnabled in EndPoint profile

Derive Profile.Security.ModeEnabled from profile.sec instead of
hardcoding "WPA3-Personal-Transition", falling back to "None" when
the security type is invalid.

Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
index e52915f..69f4b52 100644
--- a/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
@@ -994,7 +994,10 @@ bool sta_wlan_hal_whm::set_profile_params(const Profile &profile)
 
     // Configure Profile.Security object
     params.set_type(AMXC_VAR_ID_HTABLE);
-    params.add_child("ModeEnabled", "WPA3-Personal-Transition");
+    std::string mode_enabled = (profile.sec == WiFiSec::Invalid)
+                                   ? "None"
+                                   : utils_wlan_hal_whm::security_type_to_string(profile.sec);
+    params.add_child("ModeEnabled", mode_enabled);
     params.add_child("KeyPassPhrase", profile.pass);
     params.add_child("SAEPassphrase", profile.pass);
     params.add_child("MFPConfig", "Optional");
-- 
