 .../slave/tasks/ap_autoconfiguration_task.h   | 22 +++++
 .../src/tlvf_airties_utils_nl80211.cpp        | 76 ++++++++++++++++--
 3 files changed, 172 insertions(+), 6 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 7803e431f..24ede6033 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -2059,6 +2059,23 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
             // Decode WiFi Compatibility Mode VS TLV (tlvQcaWifiCompatMode) BEFORE sending BSS configuration.
             handle_wifi_compat_mode_tlv(cmdu_rx, bss_infos, radio->front.iface_name);
 
+#ifdef USE_PRPLMESH_NLHAL
+            // For nl80211: parse radio operational mode config from M2 vendor extensions
+            // and update wifi_compat_mode for ALL BSSes in the radio.
+            // This replaces the per-M2 cACTION_APMANAGER_RADIO_MODE_CONFIG_REQUEST path:
+            //   - s_80211be present  → WIFI_COMPAT_MODE_11BE for all BSSes
+            //   - s_80211be absent   → WIFI_COMPAT_MODE_11AX for all BSSes
+            // Called after handle_wifi_compat_mode_tlv so that the Airties vendor extension
+            // takes precedence over the QCA TLV when both are present.
+            if (db->em_ap_controller_found) {
+                if (!airties_vs_ap_autoconfiguration_wsc_parse_radio_operational_mode_config(
+                        radio->front.iface_name, m2_list, bss_infos)) {
+                    LOG(INFO) << "Radio Operational Mode Config not found in Vendor Extension"
+                              << " for radio " << radio->front.iface_name;
+                }
+            }
+#endif
+
             // Store bss_infos for later use by APPLY_HIDDEN_SSID_CONFIG event
             m_last_bss_infos[radio->front.iface_name] = bss_infos;
 
@@ -4432,6 +4449,69 @@ bool ApAutoConfigurationTask::
     return false;
 }
 
+#ifdef USE_PRPLMESH_NLHAL
+bool ApAutoConfigurationTask::
+    airties_vs_ap_autoconfiguration_wsc_parse_radio_operational_mode_config(
+        const std::string &radio_iface, const std::vector<WSC::m2> &m2_list,
+        std::vector<sBssConfig> &bss_infos)
+{
+    // Iterate over all M2 messages to find the VENDOR_RADIO_CFG vendor extension.
+    // The operating standards are radio-level (same for all M2s on this radio), so
+    // we apply the compat mode to ALL BSSes in bss_infos once found.
+    for (const auto &m2 : m2_list) {
+        for (auto &vendor_ext_attr : m2.getAttrList<WSC::cWscAttrVendorExtension>()) {
+            if ((WSC::eWscVendorId::WSC_VENDOR_ID_AIRTIES_1 != vendor_ext_attr->vendor_id_0()) ||
+                (WSC::eWscVendorId::WSC_VENDOR_ID_AIRTIES_2 != vendor_ext_attr->vendor_id_1()) ||
+                (WSC::eWscVendorId::WSC_VENDOR_ID_AIRTIES_3 != vendor_ext_attr->vendor_id_2())) {
+                continue;
+            }
+
+            auto vendor_data = vendor_ext_attr->vendor_data();
+            if (vendor_data[0] != VENDOR_RADIO_CFG) {
+                continue;
+            }
+
+            airties::tlvAirtiesRadioCapability::sStandards operating_standards;
+            std::copy_n(&vendor_data[1], sizeof(uint8_t),
+                        reinterpret_cast<uint8_t *>(&operating_standards));
+
+            if (!is_valid_op_std(radio_iface, operating_standards)) {
+                return false;
+            }
+
+            // Determine wifi_compat_mode based on BE (802.11be) support:
+            //   s_80211be present  → WIFI_COMPAT_MODE_11BE (Wi-Fi 7 / EHT enabled)
+            //   s_80211be absent   → WIFI_COMPAT_MODE_11AX (Wi-Fi 6 / HE only)
+            const WSC::eWscWifiCompatMode compat_mode =
+                operating_standards.s_80211be
+                    ? WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE
+                    : WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX;
+
+            LOG(INFO) << "airties_vs_ap_autoconfiguration_wsc_parse_radio_operational_mode_config"
+                      << " (NLHAL): radio=" << radio_iface
+                      << " s_80211be=" << int(operating_standards.s_80211be)
+                      << " -> wifi_compat_mode="
+                      << (compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE
+                              ? "11BE (Wi-Fi 7)" : "11AX (Wi-Fi 6)")
+                      << " applied to " << bss_infos.size() << " BSS(es)";
+
+            // Update wifi_compat_mode for ALL BSSes in the radio (mirrors
+            // handle_wifi_compat_mode_tlv which updates all matching SSIDs).
+            for (auto &bss_info : bss_infos) {
+                bss_info.wifi_compat_mode = compat_mode;
+                LOG(DEBUG) << "  Updated wifi_compat_mode for SSID '"
+                           << bss_info.payload_config.ssid << "' to "
+                           << (compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE
+                                   ? "11BE" : "11AX");
+            }
+            return true;
+        }
+    }
+
+    return false;
+}
+#endif
+
 bool ApAutoConfigurationTask::ap_autoconfiguration_wsc_calculate_keys(
     const std::string &fronthaul_iface, const uint8_t *remote_pubkey, const uint8_t *nonce,
     uint8_t authkey[32], uint8_t keywrapkey[16])
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
index 150fe3263..3c0be001d 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
@@ -627,6 +627,28 @@ private:
     bool airties_vs_ap_autoconfiguration_wsc_parse_radio_operational_mode_config(
         const std::string &radio_iface, const WSC::m2 &m2);
 
+#ifdef USE_PRPLMESH_NLHAL
+    /**
+     * @brief Parse radio operational mode config from M2 vendor extensions and update bss_infos.
+     *
+     * For USE_PRPLMESH_NLHAL: iterates over the M2 list, finds the VENDOR_RADIO_CFG vendor
+     * extension, and updates wifi_compat_mode for ALL BSSes in bss_infos:
+     *   - s_80211be present  → WIFI_COMPAT_MODE_11BE for all BSSes
+     *   - s_80211be absent   → WIFI_COMPAT_MODE_11AX for all BSSes
+     *
+     * Called after the M2 loop (similar to handle_wifi_compat_mode_tlv) so that all BSSes
+     * in bss_infos are updated before send_ap_bss_configuration_message() is invoked.
+     *
+     * @param [in] radio_iface Radio interface name.
+     * @param [in] m2_list List of WSC M2 TLVs from the Controller.
+     * @param [in,out] bss_infos BSS configs to update (wifi_compat_mode field).
+     * @return true if the vendor extension was found and applied, false otherwise.
+     */
+    bool airties_vs_ap_autoconfiguration_wsc_parse_radio_operational_mode_config(
+        const std::string &radio_iface, const std::vector<WSC::m2> &m2_list,
+        std::vector<sBssConfig> &bss_infos);
+#endif
+
     bool add_wsc_m1_tlv(const std::string &radio_iface);
 
     /**
diff --git a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
index e6e4f5897..eebdafd11 100644
--- a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
+++ b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
@@ -935,15 +935,81 @@ bool tlvf_airties_utils::add_airties_msgtype_tlv(ieee1905_1::CmduMessageTx &cmdu
 /**
  * @brief Add Airties Radio Capability TLV to the CMDU message.
  *
- * This function constructs a Radio Capability TLV, populates it with
- * supported standards, and adds it to the outgoing CMDU message.
+ * This function constructs one tlvAirtiesRadioCapability TLV per radio and
+ * populates the supported 802.11 standards bits from the AgentDB radio entry.
+ *
+ * In nl80211 there is no AMX data model "SupportedStandards" string.  The
+ * equivalent information is derived from the capability flags that
+ * ap_wlan_hal_nl80211::refresh_radio_info() populates via NL80211_CMD_GET_WIPHY:
+ *
+ *   ht_supported  → 802.11n  (NL80211_BAND_ATTR_HT_CAPA present)
+ *   vht_supported → 802.11ac (NL80211_BAND_ATTR_VHT_CAPA present)
+ *   he_supported  → 802.11ax (NL80211_BAND_ATTR_IFTYPE_DATA with HE caps)
+ *   eht_supported → 802.11be (NL80211_BAND_IFTYPE_ATTR_EHT_CAP_PHY + ieee80211be=1)
+ *
+ * Legacy standards (802.11a/b/g) are inferred from the radio's frequency band:
+ *   2.4 GHz → 802.11b + 802.11g
+ *   5 GHz   → 802.11a
  *
  * @param cmdu_tx The CMDU message to which the TLV will be added.
- * @return Returns true if the TLV was successfully added, false otherwise.
+ * @return Returns true if all TLVs were successfully added, false otherwise.
  */
 bool tlvf_airties_utils::add_radio_capability(ieee1905_1::CmduMessageTx &cmdu_tx)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
+    auto db = beerocks::AgentDB::get();
+
+    for (const auto &radio : db->get_radios_list()) {
+        if (!radio) {
+            continue;
+        }
+
+        auto tlvAirtiesRadioCapability = cmdu_tx.addClass<airties::tlvAirtiesRadioCapability>();
+        if (!tlvAirtiesRadioCapability) {
+            LOG(ERROR) << "addClass airties::tlvAirtiesRadioCapability failed";
+            return false;
+        }
+
+        tlvAirtiesRadioCapability->vendor_oui() =
+            sVendorOUI(airties::tlvAirtiesMsgType::airtiesVendorOUI::OUI_AIRTIES);
+        tlvAirtiesRadioCapability->tlv_id() =
+            static_cast<int>(airties::eAirtiesTlVId::AIRTIES_RADIO_CAPABILITY);
+
+        tlvAirtiesRadioCapability->radio_id() = radio->front.iface_mac;
+
+        // Derive legacy standard support from the radio's frequency band.
+        // nl80211 does not expose separate 802.11a/b/g capability bits; they are
+        // implied by the band the radio operates on.
+        const bool is_2g = (radio->frequency_band == beerocks::eFreqType::FREQ_24G);
+        const bool is_5g = (radio->frequency_band == beerocks::eFreqType::FREQ_5G  ||
+                            radio->frequency_band == beerocks::eFreqType::FREQ_5GL ||
+                            radio->frequency_band == beerocks::eFreqType::FREQ_5GH);
+
+        // 802.11a: 5 GHz OFDM legacy mode
+        tlvAirtiesRadioCapability->standards().s_80211a = is_5g ? 1 : 0;
+        // 802.11b: 2.4 GHz DSSS/CCK legacy mode
+        tlvAirtiesRadioCapability->standards().s_80211b = is_2g ? 1 : 0;
+        // 802.11g: 2.4 GHz OFDM legacy mode
+        tlvAirtiesRadioCapability->standards().s_80211g = is_2g ? 1 : 0;
+
+        // HT/VHT/HE/EHT capability flags are populated by refresh_radio_info()
+        // via NL80211_CMD_GET_WIPHY band attribute parsing.
+        tlvAirtiesRadioCapability->standards().s_80211n  = radio->ht_supported  ? 1 : 0;
+        tlvAirtiesRadioCapability->standards().s_80211ac = radio->vht_supported ? 1 : 0;
+        tlvAirtiesRadioCapability->standards().s_80211ax = radio->he_supported  ? 1 : 0;
+        tlvAirtiesRadioCapability->standards().s_80211be = radio->eht_supported ? 1 : 0;
+
+        LOG(DEBUG) << "add_radio_capability: radio=" << radio->front.iface_mac
+                   << " band=" << radio->frequency_band
+                   << " a=" << int(tlvAirtiesRadioCapability->standards().s_80211a)
+                   << " b=" << int(tlvAirtiesRadioCapability->standards().s_80211b)
+                   << " g=" << int(tlvAirtiesRadioCapability->standards().s_80211g)
+                   << " n=" << int(tlvAirtiesRadioCapability->standards().s_80211n)
+                   << " ac=" << int(tlvAirtiesRadioCapability->standards().s_80211ac)
+                   << " ax=" << int(tlvAirtiesRadioCapability->standards().s_80211ax)
+                   << " be=" << int(tlvAirtiesRadioCapability->standards().s_80211be);
+    }
+
+    LOG(INFO) << "Added Airties Radio Capability TLV(s)";
     return true;
 }
 
@@ -1216,5 +1282,3 @@ bool tlvf_airties_utils::add_airties_ethernet_non_1905_neighbor_device_list_tlv(
     LOG(INFO) << "Added Ethernet non 1905 Neighbor Device List TLV";
     return true;
 }
