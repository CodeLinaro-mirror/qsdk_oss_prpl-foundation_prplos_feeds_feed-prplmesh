+static std::string mrsno_encryption_for_band(const std::vector<uint8_t> &security_ies,
+                                             beerocks::eFreqType freq_band)
+{
+    std::string o1_km, o1_pw, o1_mfp, o2_km, o2_pw, o2_mfp;
+    decode_rsn_override_uci_from_security_ies(security_ies, o1_km, o1_pw, o1_mfp, o2_km, o2_pw,
+                                              o2_mfp);
+
+    // AKM8 (SAE) may be advertised either in RSNOE (2.4/5 GHz) or in the primary
+    // RSNE (6 GHz).  AKM24 (SAE-EXT-KEY) may be advertised in RSNO2E (2.4/5 GHz)
+    // or in the primary RSNE (6 GHz AKM24-only).  Scan both sources so all three
+    // MRSNO variants resolve correctly on every band.
+    bool primary_sae = false, primary_sae_ext = false;
+    scan_primary_rsne_akms(security_ies, primary_sae, primary_sae_ext);
+
+    const bool akm8  = (o1_km == "SAE") || primary_sae;              // AKM8
+    const bool akm24 = (o2_km == "SAE-EXT-KEY") || primary_sae_ext;  // AKM24
+
+    if (!akm8 && !akm24) {
+        return {};
+    }
+
+    const bool is_6g = (freq_band == beerocks::eFreqType::FREQ_6G);
+
+    // 2.4/5 GHz: the primary RSNE is always WPA2-PSK, with the SAE/SAE-EXT-KEY
+    // AKMs advertised through the RSN Override elements. So the coarse selector
+    // is always "psk2" regardless of the exact AKM combination.
+    if (!is_6g) {
+        return "psk2";
+    }
+
+    // 6 GHz: WPA2-PSK is not allowed, so the primary RSNE carries the AKM
+    // directly. Anything including AKM8 -> sae (AKM8-only, AKM8+AKM24);
+    // AKM24-only -> sae-ext-key.
+    if (akm8) {
+        return "sae"; // AKM8 or AKM8+AKM24
+    }
+    return "sae-ext-key"; // AKM24 only
+}
