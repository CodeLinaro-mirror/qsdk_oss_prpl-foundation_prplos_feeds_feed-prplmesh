+// Resolve the coarse UCI `encryption` selector for a WPA3 Personal Compatibility
+// (MRSNO) BSS.
+//
+// The runtime code path collapses all three MRSNO variants into the single
+// additional_auth enum value WPA3_PERSONAL_COMPATIBILITY; the specific AKM set
+// (AKM8 / AKM24 / AKM8+AKM24) is carried ONLY in the SecurityIEs blob
+// (RSNOE=AKM8=SAE, RSNO2E=AKM24=SAE-EXT-KEY).  Without this resolver the
+// get_encryption() lambdas fall through to the default "none", producing the
+// observed `option encryption 'none'` for MRSNO VAPs even though hostapd is
+// correctly programmed via the rsn_override_* options.
+//
+// Expected mapping (matches the WPA3 Personal Compatibility recipe):
+//   AKM8 only       2.4/5G -> psk2       6G -> sae
+//   AKM24 only      2.4/5G -> psk2       6G -> sae-ext-key
+//   AKM8 + AKM24    2.4/5G -> psk2       6G -> sae
+//
+// Returns an empty string when the blob carries neither AKM8 nor AKM24, letting
+// the caller keep its existing fallback behaviour.
+// Scan the primary RSNE (EID 48) of a SecurityIEs blob for the SAE (AKM8) and
+// SAE-EXT-KEY (AKM24) AKM suite selectors.  On 6 GHz, WPA2-PSK is not allowed so
+// AKM8 (SAE) is advertised directly in the primary RSNE rather than in an RSN
+// Override element; the RSN Override decoder therefore cannot see it.  This
+// helper closes that gap so the band resolver can distinguish 6 GHz AKM8-only /
+// AKM8+AKM24 (primary=SAE) from AKM24-only (primary=SAE-EXT-KEY).
+static void scan_primary_rsne_akms(const std::vector<uint8_t> &ies, bool &primary_has_sae,
+                                   bool &primary_has_sae_ext)
+{
+    primary_has_sae     = false;
+    primary_has_sae_ext = false;
+
+    const size_t n = ies.size();
+    size_t i       = 0;
+    while (i + 2 <= n) {
+        const uint8_t eid = ies[i];
+        const uint8_t len = ies[i + 1];
+        if (i + 2 + size_t(len) > n) {
+            break;
+        }
+        if (eid == 48 /* RSNE */) {
+            const uint8_t *b = &ies[i + 2];
+            const size_t bl  = len;
+            // Version(2) + GroupData(4) + PWCount(2) + PWList + AKMCount(2) + AKMList
+            if (bl >= 8) {
+                size_t p               = 2 + 4; // skip Version + Group Data Cipher
+                const uint16_t pw_cnt  = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+                p += 2;
+                p += size_t(pw_cnt) * 4;
+                if (p + 2 <= bl) {
+                    const uint16_t akm_cnt = static_cast<uint16_t>(b[p] | (b[p + 1] << 8));
+                    p += 2;
+                    for (uint16_t a = 0; a < akm_cnt && p + 4 <= bl; ++a, p += 4) {
+                        if (b[p] == 0x00 && b[p + 1] == 0x0F && b[p + 2] == 0xAC) {
+                            if (b[p + 3] == 8) {
+                                primary_has_sae = true;
+                            } else if (b[p + 3] == 24) {
+                                primary_has_sae_ext = true;
+                            }
+                        }
+                    }
+                }
+            }
+            return; // primary RSNE processed
+        }
+        i += 2 + size_t(len);
+    }
+}
