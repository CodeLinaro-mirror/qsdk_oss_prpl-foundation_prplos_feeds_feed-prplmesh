--- a/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
+++ b/common/beerocks/bcl/include/bcl/son/son_wireless_utils.h
@@ -960,6 +960,344 @@ private:
 
     // clang-format on
 };
+
+// ---------------------------------------------------------------------------
+// WPA3-Personal-Compatibility (MRSNO, Wi-Fi EasyMesh R6.1 §17.2.105 / RSN Overriding)
+// "SecurityIEs" wire-format builder + parser — single source of truth.
+//
+// This is the ONE place that knows the exact RSN Override vendor-element byte layout
+// (RSNOE 0x29 / RSNO2E 0x2A / RSNXOE 0x2B) and the WPA3-PCM SecurityIEs blob
+// (RSNE + RSNOE/RSNO2E + RSNXOE). It lives here, next to sBssInfoConf (which owns
+// security_ies), so every producer/consumer that already depends on son_wireless_utils.h
+// shares the identical bytes:
+//   - controller/nbapi/on_action.cpp                    (Controller / NBAPI)
+//   - framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp    (PrplOS / Ambiorix DM backend)
+//   - framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp   (OpenWrt / UCI backend)
+//   - common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp       (WHM parser)
+//
+// A future spec correction (e.g. a different RSNXOE capability byte, a new AKM/cipher,
+// or a configurable MFP policy) is therefore applied in exactly one place.
+namespace rsn_ie_utils {
+
+// --- Wire constants -------------------------------------------------------
+// WFA OUI (50:6F:9A) used by the RSN Override vendor-specific elements.
+constexpr uint8_t kWfaOui0 = 0x50;
+constexpr uint8_t kWfaOui1 = 0x6F;
+constexpr uint8_t kWfaOui2 = 0x9A;
+
+// RSN Override vendor element OUI types.
+constexpr uint8_t kOuiTypeRsnoe  = 0x29; // RSN Override Element        (override 1, AKM8)
+constexpr uint8_t kOuiTypeRsno2e = 0x2A; // RSN Override 2 Element      (override 2, AKM24)
+constexpr uint8_t kOuiTypeRsnxoe = 0x2B; // RSNX Override Element
+
+// 00-0F-AC suite selector OUI (IEEE 802.11).
+constexpr uint8_t kRsnSuiteOui0 = 0x00;
+constexpr uint8_t kRsnSuiteOui1 = 0x0F;
+constexpr uint8_t kRsnSuiteOui2 = 0xAC;
+
+// AKM suite selector last byte (00-0F-AC:<akm>).
+constexpr uint8_t kAkmPsk       = 0x02; // WPA-PSK
+constexpr uint8_t kAkmSae       = 0x08; // SAE                 (AKM8)
+constexpr uint8_t kAkmSaeExtKey = 0x18; // SAE-EXT-KEY         (AKM24)
+
+// Pairwise/Group cipher suite selector last byte (00-0F-AC:<cipher>).
+constexpr uint8_t kCipherCcmp       = 0x04; // CCMP-128
+constexpr uint8_t kCipherGcmp       = 0x08; // GCMP-128
+constexpr uint8_t kCipherGcmp256    = 0x09; // GCMP-256
+constexpr uint8_t kCipherCcmp256    = 0x0A; // CCMP-256
+constexpr uint8_t kCipherBipCmac128 = 0x06; // BIP-CMAC-128 (group management)
+
+// RSN Capabilities low byte bits.
+constexpr uint8_t kRsnCapMfpc = 0x80; // Management Frame Protection Capable
+constexpr uint8_t kRsnCapMfpr = 0x40; // Management Frame Protection Required
+
+// RSN Capabilities low byte for MFPC + MFPR (WPA3-PCM baseline: MFP required).
+constexpr uint8_t kRsnCapsMfpRequired = kRsnCapMfpc | kRsnCapMfpr; // 0xC0
+
+// Extended RSN Capabilities byte advertising SAE-H2E, carried by the trailing RSNXOE.
+constexpr uint8_t kRsnxeSaeH2eCap = 0x20;
+
+// --- MFP <-> RSN-capabilities helpers -------------------------------------
+// hostapd/pWHM "rsn_override_mfp" token: "2"=required, "1"=capable/optional, "0"=disabled.
+inline uint8_t rsn_mfp_token_to_caps_low_byte(const std::string &mfp)
+{
+    if (mfp == "2") {
+        return kRsnCapMfpc | kRsnCapMfpr; // 0xC0 (required)
+    } else if (mfp == "1") {
+        return kRsnCapMfpc; // 0x80 (capable/optional)
+    }
+    return 0x00; // disabled
+}
+
+inline std::string rsn_caps_low_byte_to_mfp_token(uint8_t caps_low)
+{
+    if (caps_low & kRsnCapMfpr) {
+        return "2"; // MFP required
+    } else if (caps_low & kRsnCapMfpc) {
+        return "1"; // MFP capable/optional
+    }
+    return "0"; // MFP disabled
+}
+
+// --- Builder --------------------------------------------------------------
+/**
+ * @brief Append one RSN Override vendor-specific element (RSNOE 0x29 / RSNO2E 0x2A) carrying a
+ *        single-AKM, single-pairwise RSN body with the given RSN-capabilities low byte.
+ *
+ * Element layout (30-byte vendor payload):
+ *   DD 1E  50 6F 9A <oui_type>
+ *   Version(2) GroupData(4=CCMP) PWCount(2=1) PW(4) AKMCount(2=1) AKM(4)
+ *   RSNCaps(2: low=caps_low, high=0) PMKIDCount(2=0) GroupMgmt(4=BIP-CMAC-128)
+ */
+inline void append_rsn_override_element(std::vector<uint8_t> &out, uint8_t oui_type, uint8_t akm,
+                                        uint8_t pairwise, uint8_t caps_low = kRsnCapsMfpRequired)
+{
+    out.push_back(0xDD);           // Element ID: Vendor-Specific
+    out.push_back(0x1E);           // Length = 30
+    out.push_back(kWfaOui0);       // WFA OUI
+    out.push_back(kWfaOui1);
+    out.push_back(kWfaOui2);
+    out.push_back(oui_type);       // 0x29 (RSNOE) or 0x2A (RSNO2E)
+    out.push_back(0x01);           // Version
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // Group Data Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(kCipherCcmp);
+    out.push_back(0x01);           // Pairwise Cipher Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // Pairwise Cipher Suite = 00-0F-AC-<pairwise>
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(pairwise);
+    out.push_back(0x01);           // AKM Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // AKM Suite = 00-0F-AC-<akm>
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(akm);
+    out.push_back(caps_low);       // RSN Capabilities (low byte carries MFPC/MFPR)
+    out.push_back(0x00);           // RSN Capabilities (high byte)
+    out.push_back(0x00);           // PMKID Count = 0
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // Group Management Cipher Suite = 00-0F-AC-06 (BIP-CMAC-128)
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(kCipherBipCmac128);
+}
+
+/**
+ * @brief Append the WPA3-PCM baseline primary RSNE (SAE / CCMP / MFP required).
+ * Layout: 30 1A Version(2) GroupData(4=CCMP) PWCount(2=1) PW(4=CCMP) AKMCount(2=1) AKM(4=SAE)
+ *         RSNCaps(2=MFPC+MFPR) PMKIDCount(2=0) GroupMgmt(4=BIP-CMAC-128)
+ */
+inline void append_wpa3_pcm_primary_rsne(std::vector<uint8_t> &out)
+{
+    out.push_back(0x30);           // Element ID: RSNE
+    out.push_back(0x1A);           // Length = 26
+    out.push_back(0x01);           // Version
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // Group Data Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(kCipherCcmp);
+    out.push_back(0x01);           // Pairwise Cipher Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // Pairwise Cipher Suite = 00-0F-AC-04 (CCMP)
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(kCipherCcmp);
+    out.push_back(0x01);           // AKM Suite Count = 1
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // AKM Suite = 00-0F-AC-08 (SAE)
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(kAkmSae);
+    out.push_back(kRsnCapsMfpRequired); // RSN Capabilities low byte = MFPC+MFPR
+    out.push_back(0x00);           // RSN Capabilities high byte
+    out.push_back(0x00);           // PMKID Count = 0
+    out.push_back(0x00);
+    out.push_back(kRsnSuiteOui0);  // Group Management Cipher Suite = 00-0F-AC-06
+    out.push_back(kRsnSuiteOui1);
+    out.push_back(kRsnSuiteOui2);
+    out.push_back(kCipherBipCmac128);
+}
+
+/**
+ * @brief Append the trailing RSNXOE (0x2B) advertising SAE-H2E capability.
+ * Layout: DD 05 50 6F 9A 2B 20
+ */
+inline void append_rsnxoe_sae_h2e(std::vector<uint8_t> &out)
+{
+    out.push_back(0xDD);
+    out.push_back(0x05);           // Length = 5
+    out.push_back(kWfaOui0);
+    out.push_back(kWfaOui1);
+    out.push_back(kWfaOui2);
+    out.push_back(kOuiTypeRsnxoe); // OUI type: RSNXOE
+    out.push_back(kRsnxeSaeH2eCap);// Extended RSN Capabilities: SAE-H2E
+}
+
+/**
+ * @brief Build the spec-compliant WPA3-PCM SecurityIEs blob for a given AKM combination.
+ *
+ *   include_akm8=1, include_akm24=0 -> RSNE + RSNOE(AKM8)                + RSNXOE
+ *   include_akm8=0, include_akm24=1 -> RSNE + RSNO2E(AKM24)              + RSNXOE
+ *   include_akm8=1, include_akm24=1 -> RSNE + RSNOE(AKM8) + RSNO2E(AKM24) + RSNXOE
+ * Returns an empty vector when neither AKM is requested.
+ */
+inline std::vector<uint8_t> build_wpa3_pcm_security_ies(bool include_akm8, bool include_akm24)
+{
+    std::vector<uint8_t> out;
+    if (!include_akm8 && !include_akm24) {
+        return out;
+    }
+
+    append_wpa3_pcm_primary_rsne(out);
+
+    if (include_akm8) {
+        // RSNOE (0x29): AKM = SAE (0x08), pairwise = CCMP (0x04).
+        append_rsn_override_element(out, kOuiTypeRsnoe, kAkmSae, kCipherCcmp);
+    }
+    if (include_akm24) {
+        // RSNO2E (0x2A): AKM = SAE-EXT-KEY (0x18), pairwise = GCMP-256 (0x09).
+        append_rsn_override_element(out, kOuiTypeRsno2e, kAkmSaeExtKey, kCipherGcmp256);
+    }
+
+    append_rsnxoe_sae_h2e(out);
+    return out;
+}
+
+// --- Parser ---------------------------------------------------------------
+/**
+ * @brief Map a 4-byte 00-0F-AC:xx AKM suite selector to a hostapd/pWHM key_mgmt token.
+ */
+inline std::string rsn_akm_selector_to_token(const uint8_t *sel)
+{
+    if (sel[0] != kRsnSuiteOui0 || sel[1] != kRsnSuiteOui1 || sel[2] != kRsnSuiteOui2) {
+        return {};
+    }
+    switch (sel[3]) {
+    case kAkmPsk:       return "WPA-PSK";
+    case kAkmSae:       return "SAE";
+    case kAkmSaeExtKey: return "SAE-EXT-KEY";
+    default:            return {};
+    }
+}
+
+/**
+ * @brief Map a 4-byte 00-0F-AC:xx cipher suite selector to a hostapd/pWHM pairwise token.
+ */
+inline std::string rsn_pairwise_selector_to_token(const uint8_t *sel)
+{
+    if (sel[0] != kRsnSuiteOui0 || sel[1] != kRsnSuiteOui1 || sel[2] != kRsnSuiteOui2) {
+        return {};
+    }
+    switch (sel[3]) {
+    case kCipherCcmp:    return "CCMP";
+    case kCipherGcmp256: return "GCMP-256";
+    case kCipherGcmp:    return "GCMP";
+    case kCipherCcmp256: return "CCMP-256";
+    default:             return {};
+    }
+}
+
+/**
+ * @brief Extract the AKM/pairwise/MFP tokens from one RSN Override vendor element body.
+ * @param body Points at the bytes AFTER the WFA OUI(3) + OUI type(1) (i.e. "Version" onward).
+ *             Layout mirrors append_rsn_override_element().
+ * @return true if both AKM and pairwise tokens were recognized.
+ */
+inline bool parse_rsn_override_body(const uint8_t *body, size_t len, std::string &akm_token,
+                                    std::string &pairwise_token, std::string &mfp_token)
+{
+    // Need at least up to the RSN Capabilities low byte (offset 20) — body of 26 bytes.
+    if (len < 26) {
+        return false;
+    }
+    // Pairwise Cipher Suite selector at offset 6..9, AKM Suite selector at offset 14..17.
+    pairwise_token         = rsn_pairwise_selector_to_token(body + 6);
+    akm_token              = rsn_akm_selector_to_token(body + 14);
+    const uint8_t caps_low = body[20]; // RSN Capabilities low byte (MFPC bit7 / MFPR bit6)
+    mfp_token              = rsn_caps_low_byte_to_mfp_token(caps_low);
+    return !akm_token.empty() && !pairwise_token.empty();
+}
+
+/**
+ * @brief Decoded RSN Override parameters for one override slot (RSNOE or RSNO2E).
+ */
+struct sRsnOverride {
+    bool present = false;
+    std::string key_mgmt;  ///< e.g. "SAE" / "SAE-EXT-KEY"
+    std::string pairwise;  ///< e.g. "CCMP" / "GCMP-256"
+    std::string mfp;       ///< "2" / "1" / "0"
+};
+
+/**
+ * @brief Scan a full SecurityIEs blob and decode override-1 (RSNOE 0x29) and override-2
+ *        (RSNO2E 0x2A) into hostapd/pWHM rsn_override_* tokens.
+ */
+inline void parse_security_ies_overrides(const std::vector<uint8_t> &security_ies,
+                                         sRsnOverride &override1, sRsnOverride &override2)
+{
+    override1 = sRsnOverride{};
+    override2 = sRsnOverride{};
+
+    size_t i = 0;
+    while (i + 2 <= security_ies.size()) {
+        const uint8_t eid = security_ies[i];
+        const uint8_t len = security_ies[i + 1];
+        if (i + 2 + static_cast<size_t>(len) > security_ies.size()) {
+            break; // malformed / truncated
+        }
+        const uint8_t *elem_body = &security_ies[i + 2];
+        if (eid == 0xDD && len >= 4 && elem_body[0] == kWfaOui0 && elem_body[1] == kWfaOui1 &&
+            elem_body[2] == kWfaOui2) {
+            const uint8_t oui_type = elem_body[3];
+            const uint8_t *ov      = elem_body + 4;                 // RSN body (after OUI + type)
+            const size_t ov_len    = static_cast<size_t>(len) - 4;
+            if (oui_type == kOuiTypeRsnoe) {
+                override1.present = parse_rsn_override_body(ov, ov_len, override1.key_mgmt,
+                                                            override1.pairwise, override1.mfp);
+            } else if (oui_type == kOuiTypeRsno2e) {
+                override2.present = parse_rsn_override_body(ov, ov_len, override2.key_mgmt,
+                                                            override2.pairwise, override2.mfp);
+            }
+        }
+        i += 2 + static_cast<size_t>(len);
+    }
+}
+
+/**
+ * @brief Convenience: report which AKM override elements a SecurityIEs blob carries.
+ */
+inline void security_ies_akm_presence(const std::vector<uint8_t> &security_ies, bool &has_akm8,
+                                       bool &has_akm24)
+{
+    has_akm8  = false;
+    has_akm24 = false;
+    size_t i  = 0;
+    while (i + 2 <= security_ies.size()) {
+        const uint8_t eid = security_ies[i];
+        const uint8_t len = security_ies[i + 1];
+        if (i + 2 + static_cast<size_t>(len) > security_ies.size()) {
+            break;
+        }
+        if (eid == 0xDD && len >= 4 && security_ies[i + 2] == kWfaOui0 &&
+            security_ies[i + 3] == kWfaOui1 && security_ies[i + 4] == kWfaOui2) {
+            const uint8_t oui_type = security_ies[i + 5];
+            if (oui_type == kOuiTypeRsnoe) {
+                has_akm8 = true;
+            } else if (oui_type == kOuiTypeRsno2e) {
+                has_akm24 = true;
+            }
+        }
+        i += 2 + static_cast<size_t>(len);
+    }
+}
+
+} // namespace rsn_ie_utils
+
 } // namespace son
 
 #endif
