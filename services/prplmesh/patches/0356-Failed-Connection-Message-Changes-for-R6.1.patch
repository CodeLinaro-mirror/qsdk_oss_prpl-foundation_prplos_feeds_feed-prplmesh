+// Resolve the RSNA bit for a BSS from its hostapd "wpa" bitfield: bit1 (0x2) is
+// dot11RSNAEnabled (WPA2/WPA3/SAE); bit0-only (WPA1) or unset is not RSNA. This is the
+// single expensive path (one hostapd config read) and is invoked at BSS bring-up.
+void ap_wlan_hal_nl80211::cache_bss_rsna_status(int vap_id)
+{
+    if (!check_vap_id(vap_id)) {
+        return;
+    }
+    std::string bssid_str = m_radio_info.available_vaps[vap_id].mac;
+    if (bssid_str.empty()) {
+        return;
+    }
+    std::transform(bssid_str.begin(), bssid_str.end(), bssid_str.begin(), ::tolower);
+
+    bool uses_rsna = false;
+    prplmesh::hostapd::Configuration hapd_conf = load_hostapd_config(m_radio_info.iface_name, "");
+    if (hapd_conf) {
+        const std::string vap_key = hapd_conf.get_vap_by_bssid(bssid_str);
+        if (!vap_key.empty()) {
+            const std::string wpa_str = hapd_conf.get_vap_value(vap_key, "wpa");
+            const int wpa_bits        = wpa_str.empty() ? 0 : beerocks::string_utils::stoi(wpa_str);
+            uses_rsna                 = (wpa_bits & 0x2) != 0;
+            LOG(DEBUG) << "cache_bss_rsna_status: VAP=" << vap_key << " bssid=" << bssid_str
+                       << " wpa=" << wpa_str << " -> bss_uses_rsna=" << uses_rsna;
+        } else {
+            LOG(DEBUG) << "cache_bss_rsna_status: BSSID=" << bssid_str
+                       << " not found in hostapd config; caching non-RSNA";
+        }
+    } else {
+        LOG(DEBUG) << "cache_bss_rsna_status: failed to load hostapd config for "
+                   << m_radio_info.iface_name << "; caching non-RSNA for " << bssid_str;
+    }
+    m_bss_rsna_cache[bssid_str] = uses_rsna;
+}
+
+// Cached lookup used on the CTRL-EVENT-CONNECTION-FAIL hot path. Returns the memoised RSNA
+// flag; on a cache miss (BSS not yet warmed), performs a one-time lazy load and stores it,
+// so the synchronous hostapd config read happens at most once per BSS rather than once per
+// failure event (important under an auth-failure storm).
+bool ap_wlan_hal_nl80211::get_bss_uses_rsna_cached(const std::string &bssid_str)
+{
+    std::string key = bssid_str;
+    std::transform(key.begin(), key.end(), key.begin(), ::tolower);
+
+    auto it = m_bss_rsna_cache.find(key);
+    if (it != m_bss_rsna_cache.end()) {
+        return it->second;
+    }
+
+    // Lazy fallback: BSS was not warmed at AP_ENABLED (e.g. race or missed event).
+    bool uses_rsna = false;
+    prplmesh::hostapd::Configuration hapd_conf = load_hostapd_config(m_radio_info.iface_name, "");
+    if (hapd_conf) {
+        const std::string vap_key = hapd_conf.get_vap_by_bssid(key);
+        if (!vap_key.empty()) {
+            const std::string wpa_str = hapd_conf.get_vap_value(vap_key, "wpa");
+            const int wpa_bits        = wpa_str.empty() ? 0 : beerocks::string_utils::stoi(wpa_str);
+            uses_rsna                 = (wpa_bits & 0x2) != 0;
+            LOG(DEBUG) << "get_bss_uses_rsna_cached: lazy load VAP=" << vap_key
+                       << " bssid=" << key << " wpa=" << wpa_str
+                       << " -> bss_uses_rsna=" << uses_rsna;
+        } else {
+            LOG(DEBUG) << "get_bss_uses_rsna_cached: BSSID=" << key
+                       << " not found in hostapd config; assuming non-RSNA";
+        }
+    } else {
+        LOG(DEBUG) << "get_bss_uses_rsna_cached: failed to load hostapd config for "
