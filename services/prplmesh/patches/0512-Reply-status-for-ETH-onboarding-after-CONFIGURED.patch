@@ -803,6 +803,7 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
         }
 
         bool first = true;
+        bool reply_deferred = false;
         for (const auto &bss_info_vector : bss_infos) {
             std::unordered_map<std::string, std::string> params;
 
@@ -819,7 +820,7 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
                 first               = false;
             }
 
-            if (!handle_dev_set_config(params, err_string)) {
+            if (!handle_dev_set_config(fd, params, err_string, reply_deferred)) {
                 break;
             }
         }
@@ -830,7 +831,9 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
         }
 
         // Send back second reply
-        reply_ucc(fd, eWfaCaStatus::COMPLETE);
+        if (!reply_deferred) {
+            reply_ucc(fd, eWfaCaStatus::COMPLETE);
+        }
         break;
     }
     case eWfaCaCommand::DEV_SET_RFEATURE: {
diff --git a/controller/src/beerocks/master/controller_ucc_listener.cpp b/controller/src/beerocks/master/controller_ucc_listener.cpp
index 689da76..aeb2f16 100644
