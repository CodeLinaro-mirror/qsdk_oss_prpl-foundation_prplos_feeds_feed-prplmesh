From fc0d308557eebb02034160eab7b38df4f76024d9 Mon Sep 17 00:00:00 2001
From: Ritanya Thangavel <rthangav@qti.qualcomm.com>
Date: Wed, 22 Apr 2026 11:10:51 +0530
Subject: [PATCH] Compilation_changes

Change-Id: Icc8a0be24f489afe0591039148459ad9e2ca916a
Signed-off-by: Ritanya Thangavel <rthangav@qti.qualcomm.com>
---
 common/beerocks/bwl/onewifi/mon_wlan_hal_onewifi.cpp | 2 +-
 framework/platform/bpl/CMakeLists.txt                | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/onewifi/mon_wlan_hal_onewifi.cpp b/common/beerocks/bwl/onewifi/mon_wlan_hal_onewifi.cpp
index cd4af88a4..bec482bdc 100644
--- a/common/beerocks/bwl/onewifi/mon_wlan_hal_onewifi.cpp
+++ b/common/beerocks/bwl/onewifi/mon_wlan_hal_onewifi.cpp
@@ -37,7 +37,7 @@ public:
     virtual bool pre_generate_connected_clients_events() override { return true; }
     virtual bool set_available_estimated_service_parameters(wfa_map::tlvApMetrics::sEstimatedService &estimated_service_parameters) override { return true; }
     virtual bool set_estimated_service_parameters(uint8_t *esp_info_field) override { return true; }
-    virtual bool sta_unassoc_rssi_measurement(std::unordered_map<std::string, uint8_t> &new_list) override { return true; }
+    virtual bool sta_unassoc_rssi_measurement(std::unordered_map<std::string, sUnassocStaParams> &new_list) override { return true; }
     virtual int create_wpa_ctrl_skt(std::string &sock_name) override { return -1; }
     virtual bool remove_ctrl_skt(std::string &ifname) override { return true; }
     virtual bool get_mld_interface_mac(std::string &iface_name, std::string &mac_out) override { return false; }
diff --git a/framework/platform/bpl/CMakeLists.txt b/framework/platform/bpl/CMakeLists.txt
index 0d5ee45bf..6bbec6a9c 100644
--- a/framework/platform/bpl/CMakeLists.txt
+++ b/framework/platform/bpl/CMakeLists.txt
@@ -256,8 +256,8 @@ endif()
 # BPL device info functions (get_serial_number, get_model_number, etc.)
 # These functions are needed by bpl_board.cpp and require ambiorix client definitions from bpl.cpp
 # Skip adding dm/bpl.cpp and dm/bpl_cfg_device_info.cpp when USE_PRPLMESH_NLHAL is defined
-# as they require ambiorix/wbapi which is not available in NLHAL mode
-if(NOT USE_PRPLMESH_NLHAL)
+# as they require ambiorix/wbapi which is not available in NLHAL mode or RDK-B platform
+if(NOT USE_PRPLMESH_NLHAL AND NOT TARGET_PLATFORM STREQUAL "rdkb")
     list(FIND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl.cpp _index)
     if (_index EQUAL -1)
         message("APPEND bpl_platform_sources with ${MODULE_PATH}/cfg/dm/bpl.cpp")
-- 
2.34.1

