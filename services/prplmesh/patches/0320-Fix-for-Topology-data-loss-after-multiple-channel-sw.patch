From 9ea40307b0c90553a701a98e27dcb2e2877908fe Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Thu, 6 Aug 2026 16:42:02 +0530
Subject: [PATCH] Fix for Topology data loss after multiple channel switch and
 puncturing

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 19 ++++++++++++-----
 .../beerocks/bwl/dummy/ap_wlan_hal_dummy.cpp  |  3 ++-
 common/beerocks/bwl/dummy/ap_wlan_hal_dummy.h |  3 ++-
 .../beerocks/bwl/dwpal/ap_wlan_hal_dwpal.cpp  |  3 ++-
 common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.h |  3 ++-
 .../bwl/dwpald/ap_wlan_hal_dwpald.cpp         |  3 ++-
 .../beerocks/bwl/dwpald/ap_wlan_hal_dwpald.h  |  3 ++-
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h | 10 ++++++++-
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 21 +++++++++----------
 .../bwl/nl80211/ap_wlan_hal_nl80211.h         |  6 ++----
 .../bwl/onewifi/ap_wlan_hal_onewifi.h         |  4 +++-
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp   |  3 ++-
 common/beerocks/bwl/whm/ap_wlan_hal_whm.h     |  3 ++-
 13 files changed, 54 insertions(+), 30 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index ca9c74af0..fe4142322 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1642,8 +1642,9 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
         // Per IEEE 802.11be / EasyMesh R6, puncturing changes require a CSA even when staying
         // on the same channel so that clients can adapt to the new punct_bitmap.
-        bool punct_bitmap_requested = request->eht_operation_valid() &&
-                                      request->eo_params().disabled_subchannel_valid &&
+        bool punct_bitmap_valid = request->eht_operation_valid() &&
+                                 request->eo_params().disabled_subchannel_valid;
+        bool punct_bitmap_requested = punct_bitmap_valid &&
                                       ap_wlan_hal->get_radio_info().channel > 0 &&
                                       ap_wlan_hal->get_radio_info().vht_center_freq > 0;
 
@@ -1659,10 +1660,15 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         }
 
         // Set AP channel
+        // punct_bitmap_valid/disabled_subchannel_bitmap are passed explicitly on every call so
+        // that this switch only ever applies a puncturing pattern that was requested alongside
+        // it - never one left over from a previous, unrelated switch_channel() call for a
+        // different channel/bandwidth, where the same bit pattern may no longer be valid.
         if (!ap_wlan_hal->switch_channel(request->cs_params().channel,
                                          (beerocks::eWiFiBandwidth)request->cs_params().bandwidth,
                                          request->cs_params().vht_center_frequency,
-                                         request->cs_params().csa_count)) { //error
+                                         request->cs_params().csa_count, punct_bitmap_valid,
+                                         request->eo_params().disabled_subchannel_bitmap)) { //error
             std::string error("Failed to set AP channel!");
             LOG(ERROR) << error;
 
@@ -2713,14 +2719,17 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
                 LOG(ERROR) << "set_zwdfs_antenna on failed!";
                 response->success() = false;
             }
-            // switch channel on zwdfs interface to start off channel CAC
+            // switch channel on zwdfs interface to start off channel CAC; this path never
+            // carries an EHT Operations TLV, so no puncturing bitmap should be applied here.
             LOG(DEBUG) << "Switching channel channel=" << notification->channel() << ", bw="
                        << beerocks::utils::convert_bandwidth_to_string(notification->bandwidth())
                        << ", center_freq=" << notification->center_frequency();
 
             if (!ap_wlan_hal->switch_channel(notification->channel(), notification->bandwidth(),
                                              notification->center_frequency(),
-                                             notification->csa_count())) {
+                                             notification->csa_count(),
+                                             /* punct_bitmap_valid */ false,
+                                             /* punct_bitmap */ 0)) {
                 LOG(ERROR) << "switch_channel failed!";
                 response->success() = false;
             }
diff --git a/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.cpp b/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.cpp
index e78a6aed8..61fbc5148 100644
--- a/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.cpp
+++ b/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.cpp
@@ -363,7 +363,8 @@ bool ap_wlan_hal_dummy::sta_softblock_remove(const std::string &vap_name,
 }
 
 bool ap_wlan_hal_dummy::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
-                                       int vht_center_frequency, int csa_beacon_count)
+                                       int vht_center_frequency, int csa_beacon_count,
+                                       bool punct_bitmap_valid, uint16_t punct_bitmap)
 {
     LOG(TRACE) << __func__ << " channel: " << chan
                << ", bw: " << beerocks::utils::convert_bandwidth_to_string(bw)
diff --git a/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.h b/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.h
index 7ebd41c3c..9ddc695c3 100644
--- a/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.h
+++ b/common/beerocks/bwl/dummy/ap_wlan_hal_dummy.h
@@ -68,7 +68,8 @@ public:
     virtual bool sta_softblock_remove(const std::string &vap_name,
                                       const std::string &client_mac) override;
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
-                                int csa_beacon_count) override;
+                                int csa_beacon_count, bool punct_bitmap_valid,
+                                uint16_t punct_bitmap) override;
     virtual bool cancel_cac(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
                             int secondary_chan) override;
     virtual bool failsafe_channel_set(int chan, int bw, int vht_center_frequency) override;
diff --git a/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.cpp b/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.cpp
index d179b620c..eadb786f3 100644
--- a/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.cpp
+++ b/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.cpp
@@ -1629,7 +1629,8 @@ bool ap_wlan_hal_dwpal::sta_softblock_remove(const std::string &vap_name,
 }
 
 bool ap_wlan_hal_dwpal::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
-                                       int vht_center_frequency, int csa_beacon_count)
+                                       int vht_center_frequency, int csa_beacon_count,
+                                       bool punct_bitmap_valid, uint16_t punct_bitmap)
 {
     std::string cmd = "CHAN_SWITCH ";
 
diff --git a/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.h b/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.h
index df4d3f585..fba2a7284 100644
--- a/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.h
+++ b/common/beerocks/bwl/dwpal/ap_wlan_hal_dwpal.h
@@ -70,7 +70,8 @@ public:
     virtual bool sta_softblock_remove(const std::string &vap_name,
                                       const std::string &client_mac) override;
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
-                                int csa_beacon_count) override;
+                                int csa_beacon_count, bool punct_bitmap_valid,
+                                uint16_t punct_bitmap) override;
     virtual bool cancel_cac(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
                             int secondary_chan_offset) override;
     virtual bool failsafe_channel_set(int chan, int bw, int vht_center_frequency) override;
diff --git a/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.cpp b/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.cpp
index a6692c29d..3468cddbb 100644
--- a/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.cpp
+++ b/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.cpp
@@ -1711,7 +1711,8 @@ bool ap_wlan_hal_dwpal::sta_softblock_remove(const std::string &vap_name,
 }
 
 bool ap_wlan_hal_dwpal::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
-                                       int vht_center_frequency, int csa_beacon_count)
+                                       int vht_center_frequency, int csa_beacon_count,
+                                       bool punct_bitmap_valid, uint16_t punct_bitmap)
 {
     std::string cmd = "CHAN_SWITCH ";
 
diff --git a/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.h b/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.h
index 8a9fc97b0..9d1a717c1 100644
--- a/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.h
+++ b/common/beerocks/bwl/dwpald/ap_wlan_hal_dwpald.h
@@ -71,7 +71,8 @@ public:
     virtual bool sta_softblock_remove(const std::string &vap_name,
                                       const std::string &client_mac) override;
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
-                                int csa_beacon_count) override;
+                                int csa_beacon_count, bool punct_bitmap_valid,
+                                uint16_t punct_bitmap) override;
     virtual bool cancel_cac(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
                             int secondary_chan_offset) override;
     virtual bool failsafe_channel_set(int chan, int bw, int vht_center_frequency) override;
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index 4a6dacf5a..dd6ba1aec 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -348,11 +348,19 @@ public:
      * @param [in] chan The channel to switch to.
      * @param [in] bw The bandwidth (in Mhz) of the target channel.
      * @param [in] vht_center_frequency VHT center frequency.
+     * @param [in] csa_beacon_count Beacon count before switch.
+     * @param [in] punct_bitmap_valid Whether punct_bitmap carries a value that should be applied
+     * to this switch. The bitmap is only meaningful for the channel/bandwidth requested in this
+     * call, so it must always be supplied explicitly by the caller rather than retained from a
+     * previous, unrelated switch_channel() call.
+     * @param [in] punct_bitmap The static puncturing bitmap to apply, valid only when
+     * punct_bitmap_valid is true.
      *
      * @return true on success or false on error.
      */
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
-                                int csa_beacon_count = 5) = 0;
+                                int csa_beacon_count = 5, bool punct_bitmap_valid = false,
+                                uint16_t punct_bitmap = 0) = 0;
 
     /**
      * @brief Simulate AWGN (Additive White Gaussian Noise) interference on the radio.
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 14b8b3a02..14ecfc061 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -4992,7 +4992,8 @@ bool ap_wlan_hal_nl80211::sta_softblock_remove(const std::string &vap_name,
 }
 
 bool ap_wlan_hal_nl80211::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
-                                         int vht_center_frequency, int csa_beacon_count)
+                                         int vht_center_frequency, int csa_beacon_count,
+                                         bool punct_bitmap_valid, uint16_t punct_bitmap)
 {
     LOG(TRACE) << __func__ << " channel: " << chan << ", bw: " << bw
                << ", vht_center_frequency: " << vht_center_frequency;
@@ -5197,12 +5198,12 @@ bool ap_wlan_hal_nl80211::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
 
     cmd += " " + phy;
 
-    /// Static puncturing: include punct_bitmap if set.
+    /// Static puncturing: include punct_bitmap if the caller supplied one for this switch.
     // hostapd CHAN_SWITCH supports: punct_bitmap=<16-bit decimal>
-    if (m_punct_bitmap != 0) {
-        cmd += " punct_bitmap=" + std::to_string(m_punct_bitmap);
+    if (punct_bitmap_valid) {
+        cmd += " punct_bitmap=" + std::to_string(punct_bitmap);
         LOG(DEBUG) << "switch_channel: appending punct_bitmap="
-                << std::hex << m_punct_bitmap << std::dec;
+                << std::hex << punct_bitmap << std::dec;
     }
 
     LOG(INFO) << "switch_channel: sending CHAN_SWITCH cmd: " << cmd;
@@ -5881,12 +5882,10 @@ bool ap_wlan_hal_nl80211::set_primary_vlan_id(uint16_t primary_vlan_id)
 
 bool ap_wlan_hal_nl80211::set_disabled_subchannels(uint16_t bitmap)
 {
-    LOG(DEBUG) << "ap_wlan_hal_nl80211: set_disabled_subchannels, bitmap="
-               << std::hex << std::showbase << bitmap << std::dec << std::noshowbase;
-
-    // Store the bitmap so switch_channel() picks it up.
-    // switch_channel() appends "punct_bitmap=<value>" to the CHAN_SWITCH command.
-    m_punct_bitmap = bitmap;
+    // No-op on nl80211: the bitmap is applied directly as a punct_bitmap argument to the
+    // CHAN_SWITCH command issued by switch_channel(), not retained here. Retaining it in a
+    // member would let it leak into a later, unrelated switch_channel() call for a different
+    // channel/bandwidth, where the same bit pattern may no longer be a valid puncturing mask.
     return true;
 }
 
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
index 4160c5eb9..8dc10f095 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -70,7 +70,8 @@ public:
     virtual bool sta_softblock_remove(const std::string &vap_name,
                                       const std::string &client_mac) override;
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
-                                int csa_beacon_count) override;
+                                int csa_beacon_count, bool punct_bitmap_valid,
+                                uint16_t punct_bitmap) override;
     virtual bool simulate_awgn() override;
     virtual bool cancel_cac(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
                             int secondary_chan) override;
@@ -236,9 +237,6 @@ private:
     // Primary VLAN ID for the backhaul AP; set by set_primary_vlan_id() and
     // embedded in the hostapd conf by create_new_hostapd_conf_file().
     uint16_t m_primary_vlan_id = 0;
-    // Pending puncturing bitmap to be applied on next CHAN_SWITCH.
-    // Bit N = 1 means the Nth 20 MHz subchannel (LSB = lowest) is punctured.
-    uint16_t m_punct_bitmap = 0;
 
     /**
      * @brief Detect MLO capability for a connected STA and populate the MLO fields
diff --git a/common/beerocks/bwl/onewifi/ap_wlan_hal_onewifi.h b/common/beerocks/bwl/onewifi/ap_wlan_hal_onewifi.h
index 7b0b730a1..e3960f656 100644
--- a/common/beerocks/bwl/onewifi/ap_wlan_hal_onewifi.h
+++ b/common/beerocks/bwl/onewifi/ap_wlan_hal_onewifi.h
@@ -46,7 +46,9 @@ public:
                                               int vht_center_frequency, int delay,
                                               int window_size) override;
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw,
-                                int vht_center_frequency, int csa_beacon_count = 5) override;
+                                int vht_center_frequency, int csa_beacon_count = 5,
+                                bool punct_bitmap_valid = false,
+                                uint16_t punct_bitmap = 0) override;
     virtual bool cancel_cac(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
                             int secondary_channel_offset) override;
     virtual bool failsafe_channel_set(int chan, int bw, int vht_center_frequency) override;
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 2abce1958..0361be8b8 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -1134,7 +1134,8 @@ bool ap_wlan_hal_whm::sta_softblock_remove(const std::string &vap_name,
 }
 
 bool ap_wlan_hal_whm::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
-                                     int vht_center_frequency, int csa_beacon_count)
+                                     int vht_center_frequency, int csa_beacon_count,
+                                     bool punct_bitmap_valid, uint16_t punct_bitmap)
 {
     LOG(TRACE) << " channel: " << chan << ", bw enum: " << bw
                << " bw mhz: " << wbapi_utils::bandwidth_to_string(bw)
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.h b/common/beerocks/bwl/whm/ap_wlan_hal_whm.h
index d2418203e..16061ceaf 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.h
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.h
@@ -79,7 +79,8 @@ public:
     virtual bool sta_softblock_remove(const std::string &vap_name,
                                       const std::string &client_mac) override;
     virtual bool switch_channel(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
-                                int csa_beacon_count) override;
+                                int csa_beacon_count, bool punct_bitmap_valid,
+                                uint16_t punct_bitmap) override;
     virtual bool simulate_awgn() override;
     virtual bool cancel_cac(int chan, beerocks::eWiFiBandwidth bw, int vht_center_frequency,
                             int secondary_chan) override;
