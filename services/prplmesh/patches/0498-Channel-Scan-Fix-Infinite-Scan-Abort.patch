 #include <linux/nl80211.h>
 #include <net/if.h>
@@ -1888,12 +1892,66 @@ bool base_wlan_hal_nl80211::send_nl80211_msg(uint8_t command, int flags,
         return false;
     }
 
-    // Process the response
-    // TODO: Probably should be changed to select/epoll...
-    //       The file descriptor can be extracted by calling the
-    //       nl_socket_get_fd() function.
-    while (err > 0) {
-        nl_recvmsgs(m_nl80211_sock.get(), nl_callback.get());
+    // The response-processing loop below previously called the blocking nl_recvmsgs() with no
+    // timeout. This HAL method is always invoked from the monitor's single, synchronous
+    // event-loop thread, so if the kernel/driver never completes a request - no ACK, no ERROR,
+    // no FINISH callback is ever invoked for the sequence number libnl is waiting on -
+    // nl_recvmsgs() blocks forever and wedges that thread. Every subsequent nl80211 call,
+    // wpa_ctrl heartbeat check, and FSM step this thread is responsible for then silently stops.
+    //
+    // Bound the wait with poll() on the netlink socket's fd before each nl_recvmsgs() call, with
+    // a hard overall deadline for the whole response-processing loop. If the deadline is reached
+    // before libnl's err/ack/finish callback has cleared `err` to 0, give up and return false
+    // instead of blocking indefinitely.
+    {
+        constexpr int NL80211_RESPONSE_TIMEOUT_MS = 3000; // generous but bounded; see note above
+        const int sock_fd = nl_socket_get_fd(m_nl80211_sock.get());
+        if (sock_fd < 0) {
+            LOG(ERROR) << "nl_socket_get_fd() failed; cannot bound nl80211 response wait for "
+                          "command "
+                       << int(command);
+            return false;
+        }
+
+        const auto deadline = std::chrono::steady_clock::now() +
+                              std::chrono::milliseconds(NL80211_RESPONSE_TIMEOUT_MS);
+        while (err > 0) {
+            const auto now = std::chrono::steady_clock::now();
+            if (now >= deadline) {
+                LOG(ERROR) << "nl80211 command " << int(command) << " on iface " << ifName
+                           << " timed out after " << NL80211_RESPONSE_TIMEOUT_MS
+                           << " ms waiting for kernel response (no ACK/ERROR/FINISH) - "
+                              "aborting wait instead of blocking the event-loop thread "
+                              "indefinitely. This indicates the kernel/driver never completed "
+                              "the request (e.g. busy shared radio resource); the caller's "
+                              "existing failure-handling path will surface this cleanly.";
+                return false;
+            }
+            const int remaining_ms = static_cast<int>(
+                std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count());
+
+            struct pollfd pfd;
+            pfd.fd     = sock_fd;
+            pfd.events = POLLIN;
+            pfd.revents = 0;
+            const int poll_ret = poll(&pfd, 1, remaining_ms);
+            if (poll_ret < 0) {
+                if (errno == EINTR) {
+                    continue; // interrupted by a signal - just retry within the deadline
+                }
+                LOG(ERROR) << "poll() on nl80211 socket failed for command " << int(command)
+                           << ": " << strerror(errno);
+                return false;
+            }
+            if (poll_ret == 0) {
+                // Timed out this iteration without data; loop back and let the top-of-loop
+                // deadline check report/exit once the overall budget is exhausted.
+                continue;
+            }
+
+            // Data is available - this single nl_recvmsgs() call will not block.
+            nl_recvmsgs(m_nl80211_sock.get(), nl_callback.get());
+        }
     }
 
     return err == 0;
