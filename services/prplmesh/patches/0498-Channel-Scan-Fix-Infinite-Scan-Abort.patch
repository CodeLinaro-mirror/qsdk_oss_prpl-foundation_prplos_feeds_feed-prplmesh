diff --git a/agent/src/beerocks/slave/tasks/channel_scan_task.cpp b/agent/src/beerocks/slave/tasks/channel_scan_task.cpp
index c7da524..0cf84f9 100644
--- a/agent/src/beerocks/slave/tasks/channel_scan_task.cpp
+++ b/agent/src/beerocks/slave/tasks/channel_scan_task.cpp
@@ -180,11 +180,35 @@ void ChannelScanTask::work()
                 !is_terminal_state(current_radio_scan->current_state)) {
                 LOG(INFO) << "Aborted scan as scan request exceeds the SCAN_REQUEST_TIMEOUT_SEC";
                 abort_scan_request(current_scan_request);
+                // abort_scan_request() only sends an ABORT_CHANNEL_SCAN CMDU to the monitor; it
+                // does not by itself drive this radio scan's FSM to a terminal state. The FSM
+                // normally reaches SCAN_ABORTED via the
+                // ACTION_BACKHAUL_CHANNEL_SCAN_ABORTED_NOTIFICATION handler, but the monitor may
+                // have no active scan to abort (e.g. the trigger never became active because the
+                // radio was in use for other purposes), in which case no such notification is
+                // sent. Finalize the scan locally here so the request always reaches a terminal
+                // state and a report is produced, rather than relying solely on a notification
+                // that may never arrive.
+                set_radio_scan_status(current_radio_scan, eScanStatus::SCAN_ABORTED);
+                FSM_MOVE_STATE(current_radio_scan, eState::SCAN_ABORTED);
             }
             // Handle current radio-scan's state
             switch (current_radio_scan->current_state) {
             case eState::PENDING_TRIGGER: {
                 // Wait until Current-Scan resource is free.
+                //
+                // A scan whose trigger is never accepted by the driver (e.g. persistent -EBUSY
+                // because the radio's scan resource is in use elsewhere) would otherwise sit in
+                // PENDING_TRIGGER indefinitely, since there is no monitor notification that moves
+                // it out of this state. Apply the same overall request timeout used above so the
+                // request reaches a terminal state and a report is produced instead of looping.
+                if ((current_scan_request->scan_start_timestamp + SCAN_REQUEST_TIMEOUT_SEC) <
+                    std::chrono::system_clock::now()) {
+                    LOG(ERROR) << "Reached timeout while PENDING_TRIGGER (scan trigger never "
+                                  "accepted, radio likely busy)";
+                    set_radio_scan_status(current_radio_scan, eScanStatus::SCAN_NOT_COMPLETED);
+                    FSM_MOVE_STATE(current_radio_scan, eState::SCAN_FAILED);
+                }
                 break;
             }
             case eState::WAIT_FOR_SCAN_TRIGGERED: {
