Subject: [PATCH] Enabling traffic separation by default

Signed-off-by: Mahitha M <mmaddulu@qti.qualcomm.com>
---
 controller/nbapi/odl/controller.odl.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/controller/nbapi/odl/controller.odl.in b/controller/nbapi/odl/controller.odl.in
index 6c529683d..6c1d656a2 100644
--- a/controller/nbapi/odl/controller.odl.in
+++ b/controller/nbapi/odl/controller.odl.in
@@ -404,7 +404,7 @@
                     %persistent object TrafficSeparation {
                         /* If true, then prplMesh Controller applies TS policies for the network */
                         %persistent bool Enable {
-                            default false;
+                            default true;
                         }
 
                         /* VLAN ID to use for private/home SSIDs */
