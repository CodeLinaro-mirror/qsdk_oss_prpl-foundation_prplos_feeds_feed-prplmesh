+// ---------------------------------------------------------------------------
+// MQTT helpers
+// ---------------------------------------------------------------------------
+
+int NeighborDbAgentTask::push_nbr_db_set_to_hostapd(
+    const std::vector<std::pair<std::vector<uint8_t>, std::vector<uint8_t>>> &entries)
+{
+    auto db      = AgentDB::get();
+    auto ap_alid = db->bridge.mac;
+
+    // Adapt entries once — same list is reused for every SMD SET.
+    static const uint8_t zero_mac[6] = {0};
+    std::vector<std::pair<const uint8_t *, std::vector<uint8_t>>> adapted;
+    adapted.reserve(entries.size());
+    for (const auto &e : entries) {
+        if (e.first.size() != 6)
+            continue;
+        adapted.emplace_back(e.first.data(), e.second);
+    }
+
+    // Issue one SET per SMD ID so every entry is stored with the correct SMD
+    // tag in hostapd. Without the tag, entries are invisible to SMD-scoped GET
+    // queries. With multiple SMD IDs each SET is an independent MQTT publish.
+    // Fall back to a single untagged SET if no SMD IDs are configured.
+    int published = 0;
+    if (db->smd_identifiers.empty()) {
+        auto packed = bwl::smd_nbr_db_tlv::pack_nbr_db_set(ap_alid.oct,
+                                                             false, zero_mac,
+                                                             zero_mac, adapted);
+        if (!packed.empty() &&
+            m_btl_ctx.hal_smd_send(packed.data(), static_cast<int>(packed.size())) == 0) {
+            published = 1;
+        } else {
+            LOG(ERROR) << "AP_DEBUG: push_nbr_db_set_to_hostapd: untagged SET failed";
+        }
+    } else {
+        for (const auto &smd_id : db->smd_identifiers) {
+            auto packed = bwl::smd_nbr_db_tlv::pack_nbr_db_set(ap_alid.oct,
+                                                                 true, smd_id.oct,
+                                                                 zero_mac, adapted);
+            if (packed.empty()) {
+                LOG(ERROR) << "AP_DEBUG: push_nbr_db_set_to_hostapd: packing failed for SMD ID "
+                           << smd_id;
+                continue;
+            }
+            if (m_btl_ctx.hal_smd_send(packed.data(), static_cast<int>(packed.size())) != 0) {
+                LOG(ERROR) << "AP_DEBUG: push_nbr_db_set_to_hostapd: MQTT publish failed for SMD ID "
+                           << smd_id;
+                continue;
+            }
+            published++;
+            LOG(DEBUG) << "AP_DEBUG: push_nbr_db_set_to_hostapd: published SET for SMD ID "
+                       << smd_id << " with " << entries.size() << " entries ("
+                       << packed.size() << " bytes)";
+        }
+    }
+
+    if (published > 0)
+        m_last_set_published_at = std::chrono::steady_clock::now();
+
+    return published;
+}
+
+bool NeighborDbAgentTask::push_nbr_db_clear_to_hostapd()
+{
+    auto db      = AgentDB::get();
+    auto ap_alid = db->bridge.mac;
+
+    static const uint8_t zero_mac[6] = {0};
+    auto packed = bwl::smd_nbr_db_tlv::pack_nbr_db_clear(ap_alid.oct, false, zero_mac,
+                                                           /*has_mld_addr=*/false, zero_mac,
+                                                           /*has_bssid=*/false, zero_mac);
+    if (packed.empty()) {
+        LOG(ERROR) << "AP_DEBUG: push_nbr_db_clear_to_hostapd: packing failed";
+        return false;
+    }
+
+    int rc = m_btl_ctx.hal_smd_send(packed.data(), static_cast<int>(packed.size()));
+    if (rc != 0) {
+        LOG(ERROR) << "AP_DEBUG: push_nbr_db_clear_to_hostapd: MQTT publish failed (rc=" << rc
+                   << ")";
+        return false;
+    }
+    LOG(DEBUG) << "AP_DEBUG: push_nbr_db_clear_to_hostapd: published CLEAR (" << packed.size()
+               << " bytes)";
+    return true;
 }
