+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _BWL_SMD_NBR_DB_TLV_H_
+#define _BWL_SMD_NBR_DB_TLV_H_
+
+/*
+ * MQTT wire-format constants, packing, and parsing for the hostapd Neighbor DB API.
+ *
+ * Frame format:
+ *   [MSG_ID header TLV: 6 bytes][payload TLVs]
+ *
+ * MSG_ID header:
+ *   type=0x8001 (2B BE), len=0x0002 (2B BE), msg_id (2B BE)
+ *
+ * Payload TLV:
+ *   type (2B BE), len (2B BE), value (len bytes)
+ *
+ * All multi-byte integers are big-endian except the 802.11 NRE bssid_info field
+ * (4 bytes little-endian, per 802.11 standard).
+ */
+
+#include <cstdint>
+#include <cstring>
+#include <utility>
+#include <vector>
+
+namespace bwl {
+namespace smd_nbr_db_tlv {
+
+// ---------------------------------------------------------------------------
+// MQTT topics
+// ---------------------------------------------------------------------------
+
+static constexpr const char *TOPIC_RECEIVE  = "hostapd/receive/SMD";
+static constexpr const char *TOPIC_TRANSMIT = "hostapd/transmit/SMD";
+
+// ---------------------------------------------------------------------------
+// MSG_ID values
+// ---------------------------------------------------------------------------
+
+static constexpr uint16_t TLV_GLOBAL_MSG_ID_TYPE = 0x8001;
+static constexpr uint16_t TLV_GLOBAL_MSG_ID_LEN  = 2;
+static constexpr size_t   MSG_HDR_SIZE           = 6; // type(2) + len(2) + value(2)
+
+// MSG_IDs encode FEATURE nibble (bits 14:8) | OPERATION (bits 7:0).
+// MQTT_FEAT_SMD = 2 per hostapd mqtt_feature_map.h, so all SMD CMDs have high byte 0x02.
+static constexpr uint16_t CMD_ID_NEIGHBOR_DB_SET   = 0x0201;
+static constexpr uint16_t CMD_ID_NEIGHBOR_DB_GET   = 0x0202;
+static constexpr uint16_t CMD_ID_NEIGHBOR_DB_CLEAR = 0x0203;
+
+static constexpr uint16_t EVT_ID_NEIGHBOR_DB_SET_RESP   = 0x0081;
+static constexpr uint16_t EVT_ID_NEIGHBOR_DB_GET_RESP   = 0x0082;
+static constexpr uint16_t EVT_ID_NEIGHBOR_DB_CLEAR_RESP = 0x0083;
+
+// ---------------------------------------------------------------------------
+// Status codes
+// ---------------------------------------------------------------------------
+
+enum class eSmdNbrDbStatus : uint8_t {
+    OK            = 0,
+    INVALID_PARAM = 1,
+    NOT_FOUND     = 2,
+    NO_RESOURCE   = 3,
+    INTERNAL      = 4,
+};
+
+// ---------------------------------------------------------------------------
+// Response payload structs
+// ---------------------------------------------------------------------------
+
+struct sNbrDbSetResp {
+    uint8_t status = static_cast<uint8_t>(eSmdNbrDbStatus::INTERNAL);
+};
+
+struct sNbrDbClearResp {
+    uint8_t status = static_cast<uint8_t>(eSmdNbrDbStatus::INTERNAL);
+};
+
+struct sNbrDbGetResp {
+    uint8_t status = static_cast<uint8_t>(eSmdNbrDbStatus::INTERNAL);
+    std::vector<std::vector<uint8_t>> nre_entries; // each entry: raw 802.11 NRE body bytes
+};
+
+// ---------------------------------------------------------------------------
+// NRE length limits (enforced by hostapd)
+// ---------------------------------------------------------------------------
+
+static constexpr uint8_t  NRE_LEN_MIN = 13;
+static constexpr uint16_t NRE_LEN_MAX = 1024; // NRE body + subelements can exceed 255 bytes
+
+// ---------------------------------------------------------------------------
+// Internal helpers
+// ---------------------------------------------------------------------------
+
+namespace detail {
+
+static inline void put_u16_be(std::vector<uint8_t> &out, uint16_t v)
+{
+    out.push_back(static_cast<uint8_t>(v >> 8));
+    out.push_back(static_cast<uint8_t>(v & 0xff));
+}
+
+static inline uint16_t get_u16_be(const uint8_t *buf, size_t off)
+{
+    return static_cast<uint16_t>((uint16_t(buf[off]) << 8) | buf[off + 1]);
+}
+
+static inline void append_tlv(std::vector<uint8_t> &out, uint16_t type, const uint8_t *value,
+                               uint16_t value_len)
+{
+    put_u16_be(out, type);
+    put_u16_be(out, value_len);
+    out.insert(out.end(), value, value + value_len);
+}
+
+static inline void append_tlv_u8(std::vector<uint8_t> &out, uint16_t type, uint8_t v)
+{
+    append_tlv(out, type, &v, 1);
+}
+
+static inline void append_tlv_u16_be(std::vector<uint8_t> &out, uint16_t type, uint16_t v)
+{
+    uint8_t tmp[2];
+    tmp[0] = static_cast<uint8_t>(v >> 8);
+    tmp[1] = static_cast<uint8_t>(v & 0xff);
+    append_tlv(out, type, tmp, 2);
+}
+
+static inline void append_tlv_mac(std::vector<uint8_t> &out, uint16_t type, const uint8_t mac[6])
+{
+    append_tlv(out, type, mac, 6);
+}
+
+static inline void write_msg_hdr(std::vector<uint8_t> &out, uint16_t msg_id)
+{
+    put_u16_be(out, TLV_GLOBAL_MSG_ID_TYPE);
+    put_u16_be(out, TLV_GLOBAL_MSG_ID_LEN);
+    put_u16_be(out, msg_id);
+}
+
+} // namespace detail
+
+// ---------------------------------------------------------------------------
+// Parsing
+// ---------------------------------------------------------------------------
+
+// Returns the MSG_ID from bytes 4-5 of the buffer (big-endian).
+// Returns 0 if buffer is too short.
+static inline uint16_t parse_msg_id(const void *buf, int len)
+{
+    if (!buf || len < static_cast<int>(MSG_HDR_SIZE)) {
+        return 0;
+    }
+    const auto *p = static_cast<const uint8_t *>(buf);
+    return detail::get_u16_be(p, 4);
+}
+
+// Parses EVT_ID_NEIGHBOR_DB_SET_RESP. On malformed input returns status=INTERNAL.
+static inline sNbrDbSetResp parse_nbr_db_set_resp(const void *buf, int len)
+{
+    sNbrDbSetResp result;
+    if (!buf || len < static_cast<int>(MSG_HDR_SIZE)) {
+        return result;
+    }
+    const auto *p     = static_cast<const uint8_t *>(buf);
+    int off           = static_cast<int>(MSG_HDR_SIZE);
+    while (off + 4 <= len) {
+        uint16_t type    = detail::get_u16_be(p, off);
+        uint16_t tlv_len = detail::get_u16_be(p, off + 2);
+        off += 4;
+        if (off + tlv_len > len) {
+            break;
+        }
+        if (type == 0x0001 && tlv_len >= 1) { // TLV_NEIGHBOR_DB_SET_RESP_STATUS
+            result.status = p[off];
+        }
+        off += tlv_len;
+    }
+    return result;
+}
+
+// Parses EVT_ID_NEIGHBOR_DB_CLEAR_RESP. On malformed input returns status=INTERNAL.
+static inline sNbrDbClearResp parse_nbr_db_clear_resp(const void *buf, int len)
+{
+    sNbrDbClearResp result;
+    if (!buf || len < static_cast<int>(MSG_HDR_SIZE)) {
+        return result;
+    }
+    const auto *p = static_cast<const uint8_t *>(buf);
+    int off       = static_cast<int>(MSG_HDR_SIZE);
+    while (off + 4 <= len) {
+        uint16_t type    = detail::get_u16_be(p, off);
+        uint16_t tlv_len = detail::get_u16_be(p, off + 2);
+        off += 4;
+        if (off + tlv_len > len) {
+            break;
+        }
+        if (type == 0x0001 && tlv_len >= 1) { // TLV_NEIGHBOR_DB_CLEAR_RESP_STATUS
+            result.status = p[off];
+        }
+        off += tlv_len;
+    }
+    return result;
+}
+
+// Parses EVT_ID_NEIGHBOR_DB_GET_RESP.
+// Container TLVs (wire type has bit 14 set = 0x4000) contain inner TLVs
+// (wire type has bit 13 set = 0x2000) for NRE_LEN (0x2001) and NRE (0x2002).
+// NRE entries with length outside [NRE_LEN_MIN, NRE_LEN_MAX] are skipped.
+static inline sNbrDbGetResp parse_nbr_db_get_resp(const void *buf, int len)
+{
+    sNbrDbGetResp result;
+    if (!buf || len < static_cast<int>(MSG_HDR_SIZE)) {
+        return result;
+    }
+    const auto *p = static_cast<const uint8_t *>(buf);
+    int off       = static_cast<int>(MSG_HDR_SIZE);
+    while (off + 4 <= len) {
+        uint16_t type    = detail::get_u16_be(p, off);
+        uint16_t tlv_len = detail::get_u16_be(p, off + 2);
+        off += 4;
+        if (off + tlv_len > len) {
+            break;
+        }
+        if (type == 0x0001 && tlv_len >= 1) { // STATUS
+            result.status = p[off];
+        } else if ((type & 0x4000) && !(type & 0x2000)) { // container TLV (NRE_ENTRY)
+            // Parse inner TLVs of this container
+            int inner_end  = off + tlv_len;
+            int inner_off  = off;
+            uint16_t nre_len = 0;
+            bool has_nre_len = false;
+            while (inner_off + 4 <= inner_end) {
+                uint16_t inner_type = detail::get_u16_be(p, inner_off);
+                uint16_t inner_len  = detail::get_u16_be(p, inner_off + 2);
+                inner_off += 4;
+                if (inner_off + inner_len > inner_end) {
+                    break;
+                }
+                if (inner_type == 0x2001 && inner_len >= 2) { // NRE_LEN
+                    nre_len     = detail::get_u16_be(p, inner_off);
+                    has_nre_len = true;
+                } else if (inner_type == 0x2002 && has_nre_len) { // NRE
+                    if (nre_len >= NRE_LEN_MIN && nre_len <= NRE_LEN_MAX &&
+                        nre_len <= inner_len) {
+                        result.nre_entries.emplace_back(p + inner_off, p + inner_off + nre_len);
+                    }
+                }
+                inner_off += inner_len;
+            }
+        }
+        off += tlv_len;
+    }
+    return result;
+}
+
+// ---------------------------------------------------------------------------
+// Packing
+// ---------------------------------------------------------------------------
+
+// Entry type for SET: {bssid[6], nre_body_bytes}
+// NRE body: first 6 bytes MUST equal bssid. Minimum 13 bytes.
+// Entries with nre_len outside [NRE_LEN_MIN, NRE_LEN_MAX] are skipped.
+// hostapd SET policy (mqtt_tlv_map.h TLV_NEIGHBOR_DB_SET_*):
+//   type 1=AP_ALID type 2=HAS_SMD_ID type 3=SMD_ID type 4=NUM_NRE
+//   per-entry: type 5=HAS_MLD_ADDR type 6=MLD_ADDR type 7=BSSID type 8=NRE_LEN type 9=NRE
+static inline std::vector<uint8_t>
+pack_nbr_db_set(const uint8_t ap_alid[6], bool has_smd_id, const uint8_t smd_id[6],
+                const uint8_t mld_addr[6],
+                const std::vector<std::pair<const uint8_t *, std::vector<uint8_t>>> &entries)
+{
+    static const uint8_t zero_mac[6] = {0};
+    bool has_mld_addr                = (memcmp(mld_addr, zero_mac, 6) != 0);
+
+    uint16_t num_nre = 0;
+    for (const auto &e : entries)
+        if (e.second.size() >= NRE_LEN_MIN && e.second.size() <= NRE_LEN_MAX)
+            num_nre++;
+
+    std::vector<uint8_t> out;
+    out.reserve(256);
+
+    detail::write_msg_hdr(out, CMD_ID_NEIGHBOR_DB_SET);
+    detail::append_tlv_mac(out, 0x0001, ap_alid);               // AP_ALID
+    detail::append_tlv_u8(out, 0x0002, has_smd_id ? 1 : 0);    // HAS_SMD_ID
+    if (has_smd_id)
+        detail::append_tlv_mac(out, 0x0003, smd_id);            // SMD_ID
+    detail::append_tlv_u16_be(out, 0x0004, num_nre);            // NUM_NRE
+
+    for (const auto &entry : entries) {
+        const uint8_t *bssid = entry.first;
+        const auto &nre      = entry.second;
+        if (nre.size() < NRE_LEN_MIN || nre.size() > NRE_LEN_MAX)
+            continue;
+        auto nre_len = static_cast<uint16_t>(nre.size());
+        detail::append_tlv_u8(out, 0x0005, has_mld_addr ? 1 : 0);       // HAS_MLD_ADDR
+        if (has_mld_addr)
+            detail::append_tlv_mac(out, 0x0006, mld_addr);               // MLD_ADDR
+        detail::append_tlv_mac(out, 0x0007, bssid);                      // BSSID
+        detail::append_tlv_u16_be(out, 0x0008, nre_len);                 // NRE_LEN
+        detail::append_tlv(out, 0x0009, nre.data(), nre_len);            // NRE
+    }
+
+    return out;
+}
+
+// Convenience overload accepting sMacAddr-like structs (6-byte arrays embedded in struct).
+// The caller provides bssid and nre as separate vectors.
+static inline std::vector<uint8_t>
+pack_nbr_db_set_simple(const uint8_t ap_alid[6],
+                       const std::vector<std::pair<std::vector<uint8_t>, std::vector<uint8_t>>> &entries)
+{
+    static const uint8_t zero_mac[6] = {0};
+    std::vector<std::pair<const uint8_t *, std::vector<uint8_t>>> adapted;
+    adapted.reserve(entries.size());
+    for (const auto &e : entries) {
+        if (e.first.size() != 6) {
+            continue;
+        }
+        adapted.emplace_back(e.first.data(), e.second);
+    }
+    return pack_nbr_db_set(ap_alid, false, zero_mac, zero_mac, adapted);
+}
+
+// hostapd GET policy (mqtt_tlv_map.h TLV_NEIGHBOR_DB_GET_*):
+//   type 1=AP_ALID type 2=HAS_SMD_ID type 3=SMD_ID type 4=GLOBAL_ENTRIES(optional)
+//   type 5=HAS_MLD_ADDR type 6=MLD_ADDR type 7=HAS_BSSID type 8=BSSID
+static inline std::vector<uint8_t> pack_nbr_db_get(const uint8_t ap_alid[6], bool has_smd_id,
+                                                    const uint8_t smd_id[6],
+                                                    bool has_mld_addr, const uint8_t mld_addr[6],
+                                                    bool has_bssid, const uint8_t bssid[6])
+{
+    std::vector<uint8_t> out;
+    out.reserve(64);
+
+    detail::write_msg_hdr(out, CMD_ID_NEIGHBOR_DB_GET);
+    detail::append_tlv_mac(out, 0x0001, ap_alid);
+    detail::append_tlv_u8(out, 0x0002, has_smd_id ? 1 : 0);
+    if (has_smd_id) {
+        detail::append_tlv_mac(out, 0x0003, smd_id);
+        detail::append_tlv_u8(out, 0x0004, 0); // GLOBAL_ENTRIES=0: local (self) entries only
+    }
+    detail::append_tlv_u8(out, 0x0005, has_mld_addr ? 1 : 0);       // HAS_MLD_ADDR
+    if (has_mld_addr)
+        detail::append_tlv_mac(out, 0x0006, mld_addr);               // MLD_ADDR
+    detail::append_tlv_u8(out, 0x0007, has_bssid ? 1 : 0);          // HAS_BSSID
+    if (has_bssid)
+        detail::append_tlv_mac(out, 0x0008, bssid);                  // BSSID
+
+    return out;
+}
+
+// hostapd CLEAR policy (mqtt_tlv_map.h TLV_NEIGHBOR_DB_CLEAR_*):
+//   type 1=AP_ALID type 2=HAS_SMD_ID type 3=SMD_ID
+//   type 4=HAS_MLD_ADDR type 5=MLD_ADDR type 6=HAS_BSSID type 7=BSSID
+static inline std::vector<uint8_t> pack_nbr_db_clear(const uint8_t ap_alid[6], bool has_smd_id,
+                                                      const uint8_t smd_id[6],
+                                                      bool has_mld_addr, const uint8_t mld_addr[6],
+                                                      bool has_bssid, const uint8_t bssid[6])
+{
+    std::vector<uint8_t> out;
+    out.reserve(32);
+
+    detail::write_msg_hdr(out, CMD_ID_NEIGHBOR_DB_CLEAR);
+    detail::append_tlv_mac(out, 0x0001, ap_alid);
+    detail::append_tlv_u8(out, 0x0002, has_smd_id ? 1 : 0);
+    if (has_smd_id)
+        detail::append_tlv_mac(out, 0x0003, smd_id);
+    detail::append_tlv_u8(out, 0x0004, has_mld_addr ? 1 : 0);       // HAS_MLD_ADDR
+    if (has_mld_addr)
+        detail::append_tlv_mac(out, 0x0005, mld_addr);               // MLD_ADDR
+    detail::append_tlv_u8(out, 0x0006, has_bssid ? 1 : 0);          // HAS_BSSID
+    if (has_bssid)
+        detail::append_tlv_mac(out, 0x0007, bssid);                  // BSSID
+
+    return out;
+}
+
+} // namespace smd_nbr_db_tlv
+} // namespace bwl
+
+#endif // _BWL_SMD_NBR_DB_TLV_H_
