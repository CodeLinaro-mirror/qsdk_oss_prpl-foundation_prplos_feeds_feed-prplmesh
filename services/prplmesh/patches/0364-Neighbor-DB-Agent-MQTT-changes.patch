 void ApAutoConfigurationTask::handle_vs_ap_enabled_notification(
@@ -5148,6 +5215,32 @@ void ApAutoConfigurationTask::handle_vs_ap_enabled_notification(
                                            TrafficSeparationTask::eEvent::TS_NEW_FH_IFACE,
                                            vap_info.iface_name);
     }
+
+    // Trigger neighbor DB collection whenever a VAP comes up and the controller's
+    // neighbor info reporting policy covers it. Handles:
+    //   (a) role-based: all-fBSS or all-bBSS policy (bssid_valid=0)
+    //   (b) per-BSSID: specific BSSIDs listed by controller (bssid_valid=1)
+    //   (c) external VAP restarts (UCI wifi reload, netifd) — same AP_ENABLED path
+    //   (d) SMD ID or other VAP configuration changes that hostapd reflects via AP_ENABLED
+    // Tagged REASON_AP_ENABLED so the task can suppress echoes from our own SET's beacon
+    // update while still reacting to genuine VAP changes (which arrive outside the window).
+    {
+        const auto &pol = db->neighbor_info_reporting_policy;
+        if (pol.should_trigger(vap_info.mac,
+                               vap_info.fronthaul_vap,
+                               vap_info.backhaul_vap)) {
+            LOG(DEBUG) << "AP_ENABLED for VAP " << vap_info.mac
+                       << " matches neighbor info reporting policy"
+                       << " — triggering neighbor DB collection";
+            NeighborDbAgentTask::sTriggerSendLocalNeighborInfoEvent ev;
+            ev.reason_code = NeighborDbAgentTask::REASON_AP_ENABLED;
+            ev.reason      = "AP_ENABLED iface=" + std::string(vap_info.iface_name);
+            m_btl_ctx.task_pool_try_send_event(
+                eTaskType::NEIGHBOR_DB,
+                static_cast<uint8_t>(NeighborDbAgentTask::TRIGGER_SEND_LOCAL_NEIGHBOR_INFO),
+                &ev);
+        }
+    }
 }
 
