+    // Trigger neighbor DB collection after credentials have been applied to hostapd.
+    // AP-ENABLED may not always follow RELOAD_CONFIG (e.g. conf unchanged, MLO suppression),
+    // so this is the guaranteed sync point that covers all cases.
+    // The drop-if-COLLECTING guard in NeighborDbAgentTask deduplicates concurrent fires
+    // from multiple radios; only the first one actually runs.
+    if (db->neighbor_info_reporting_policy.any_enabled()) {
+        LOG(DEBUG) << "WIFI_CREDENTIALS_UPDATE_RESPONSE from " << radio->front.iface_name
+                   << " — triggering neighbor DB collection (policy active)";
+        NeighborDbAgentTask::sTriggerSendLocalNeighborInfoEvent ev;
+        ev.reason_code = NeighborDbAgentTask::REASON_CREDENTIALS_UPD;
+        ev.reason      = "WIFI_CREDENTIALS_UPDATE_RESPONSE iface=" + radio->front.iface_name;
+        m_btl_ctx.task_pool_try_send_event(
+            eTaskType::NEIGHBOR_DB,
+            static_cast<uint8_t>(NeighborDbAgentTask::TRIGGER_SEND_LOCAL_NEIGHBOR_INFO),
+            &ev);
+    }
