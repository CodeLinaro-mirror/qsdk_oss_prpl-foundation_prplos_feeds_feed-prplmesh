+    // SMD session identifiers received from the controller via tlvQcaSmdPolicyConfig TLVs
+    // in the M2 message. Populated by ap_autoconfiguration_task and read by NeighborDbAgentTask
+    // to issue per-SMD MQTT GET queries when collecting local neighbor info.
+    std::vector<sMacAddr> smd_identifiers;
+
+    // Persists the controller's tlvWifi8NeighborInformationReportingPolicy so that
+    // handle_vs_ap_enabled_notification() can evaluate the correct trigger scope on every
+    // VAP AP_ENABLED (prplMesh-initiated RELOAD_CONFIG or external wifi reload/netifd).
+    struct sNeighborInfoReportingPolicy {
+        bool report_fbss = false; // all fronthaul VAPs (bssid_valid=0, bit5)
+        bool report_bbss = false; // all backhaul VAPs  (bssid_valid=0, bit6)
+        // Specific BSSIDs (bssid_valid=1); empty means no per-BSSID policy active.
+        std::unordered_set<sMacAddr> specific_bssids;
+
+        bool any_enabled() const
+        {
+            return report_fbss || report_bbss || !specific_bssids.empty();
+        }
+
+        // Returns true if this VAP should trigger a neighbor DB collection on AP_ENABLED.
+        bool should_trigger(const sMacAddr &bssid, bool is_fronthaul, bool is_backhaul) const
+        {
+            if (report_fbss && is_fronthaul)                              return true;
+            if (report_bbss && is_backhaul)                               return true;
+            if (!specific_bssids.empty() && specific_bssids.count(bssid)) return true;
+            return false;
+        }
+    } neighbor_info_reporting_policy;
+
