From 7ca2f08c7735be5873e25504a99048f111d9d44c Mon Sep 17 00:00:00 2001
From: Aryan Khare <aryakhar@qti.qualcomm.com>
Date: Fri, 27 Feb 2026 15:41:38 +0530
Subject: [PATCH] Fixes test_80211v test cases on Airties TH

Enables bss_transition, disassoc_imminent and other flags related to BTM
with handling the UCI persistency for each field.

Signed-off-by: Aryan Khare <aryakhar@qti.qualcomm.com>
---
 agent/config/beerocks_agent.conf.in                 |  2 +-
 common/beerocks/bwl/include/bwl/ap_wlan_hal.h       |  2 +-
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp |  8 ++++++++
 framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 10 +++++++++-
 4 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/agent/config/beerocks_agent.conf.in b/agent/config/beerocks_agent.conf.in
index 22e508851..c158c3c80 100644
--- a/agent/config/beerocks_agent.conf.in
+++ b/agent/config/beerocks_agent.conf.in
@@ -62,7 +62,7 @@ clients_unicast_measurements=0
 
 # send_btm_to_non_11v_sta = 0 -> Do not send BTM requests to STAs that do not support 802.11v
 # send_btm_to_non_11v_sta = 1 -> Allow sending BTM requests to STAs even if they do not support 802.11v
-send_btm_to_non_11v_sta=0
+send_btm_to_non_11v_sta=1
 
 # beacon_11k_default_measurement_mode = BEACON_MEASUREMENT_MODE_PASSIVE (0) -> Passive measurement mode
 # beacon_11k_default_measurement_mode = BEACON_MEASUREMENT_MODE_ACTIVE (1) -> Active measurement mode
diff --git a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
index d2c694b04..a11fc9be4 100644
--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -94,7 +94,7 @@ public:
         int reason              = 0;
         bool pref_list_included = 0;
         bool abridged           = 0;
-        bool disassoc_imminent  = 0;
+        bool disassoc_imminent  = 1;
     };
 
     // Public methods
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 36056707d..a360a5d59 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1723,6 +1723,10 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     }
                 }
                 conf.set_create_vap_value(vap_id, "multi_ap", multi_ap);
+                conf.set_create_vap_value(vap_id, "bss_transition", 1);
+                conf.set_create_vap_value(vap_id, "rrm_neighbor_report", 1);
+                conf.set_create_vap_value(vap_id, "rrm_beacon_report", 1);
+
                 //required to update uci wireless
                 bss_it.multi_ap = multi_ap;
                 // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
@@ -3166,6 +3170,10 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
     conf.set_create_vap_value(vap_id,"notify_mgmt_frames", "1");
     conf.set_create_vap_value(vap_id,"ctrl_interface",
                                std::string(bwl::nl80211::base_ctrl_path) + "hostapd");
+    conf.set_create_vap_value(vap_id, "bss_transition", 1);
+    conf.set_create_vap_value(vap_id, "rrm_neighbor_report", 1);
+    conf.set_create_vap_value(vap_id, "rrm_beacon_report", 1);
+
 
     if (!assign_auth_encr_parameters(conf,vap_id, bss_conf)) {
         LOG(ERROR) << "Failed to set the authentication/encryption parameters!";
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 3aaebcf8b..ca2b2403b 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -507,7 +507,9 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 		    options["multi_ap_backhaul_ssid"] = configuration.backhaul_wps_ssid;
     		    options["multi_ap_backhaul_key"]  = configuration.backhaul_wps_passphrase;
 	    }
-	    
+            options["bss_transition"] = "1";
+            options["ieee80211k"] = "1";
+
 	    std::string device_section;
 	    
 	    if (!radio_id.empty() &&
@@ -610,6 +612,9 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
                 options["multi_ap_backhaul_ssid"] = config.backhaul_wps_ssid;
                 options["multi_ap_backhaul_key"] = config.backhaul_wps_passphrase;
             }
+            options["bss_transition"] = "1";
+            options["ieee80211k"] = "1";
+
 
             return options;
         };
@@ -645,6 +650,9 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
         if (configuration.wps_pushbutton) {
             mldOptions["wps_pushbutton"] = "1";
         }
+	mldOptions["bss_transition"] = "1";
+	mldOptions["ieee80211k"] = "1";
+
 
         if (!uci_set_section(package_name, mld_section_type, mld_section_name, mldOptions, true)) {
             LOG(ERROR) << "Failed to set wireless configuration for MLD: " << mld_id_val << " at section " << mld_section_name;
-- 
2.34.1

