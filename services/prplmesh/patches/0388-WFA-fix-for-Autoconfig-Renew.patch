From 0d02d44f8ed7af4f1a768ad3c315feed16f823f3 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Thu, 3 Sep 2026 11:20:59 +0530
Subject: [PATCH] WFA fix for Autoconfig Renew

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 common/beerocks/bcl/source/beerocks_ucc_listener.cpp | 10 ++++++++++
 controller/src/beerocks/master/controller.cpp        |  2 +-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
index 5a23e09..1d443fe 100644
--- a/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
+++ b/common/beerocks/bcl/source/beerocks_ucc_listener.cpp
@@ -612,6 +612,16 @@ void beerocks_ucc_listener::handle_wfa_ca_command(int fd, const std::string &com
         auto message_type =
             static_cast<uint16_t>(std::strtoul(message_type_str.c_str(), nullptr, 16));
 
+        // Per IEEE 1905.1 specification, AP-Autoconfiguration Renew messages (type 0x000A)
+        // must be sent to the IEEE 1905.1 multicast address (01:80:c2:00:00:13), not to the
+        // unicast AL-MAC address provided in DestALid.
+        if (ieee1905_1::eMessageType(message_type) ==
+            ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE) {
+            LOG(DEBUG) << "AP-Autoconfiguration Renew: overriding destination from " << dest_alid
+                       << " to IEEE 1905.1 multicast address (01:80:c2:00:00:13)";
+            dest_alid = "01:80:c2:00:00:13";
+        }
+
         if (!ieee1905_1::eMessageTypeValidate::check(message_type)) {
             err_string = "invalid param value '" + message_type_str +
                          "' for param name 'MessageTypeValue', message type not found";
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index d028100..6b37e81 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -1136,7 +1136,7 @@ bool Controller::handle_cmdu_1905_autoconfiguration_search(const sMacAddr &src_m
     if (chirp_tlv_rx && m_dpp_configurator_task) {
         auto agent = database.m_agents.get(al_mac);
         if (agent) {
-            if (security_enabled) {
+            if (security_enabled && controller_supports_dpp) {
                 // 0xA9 TLV was included — agent will run Peer Discovery + EAPOL.
                 // Block plaintext CMDUs until TK is installed.
                 agent->dpp_security_required = true;
-- 
