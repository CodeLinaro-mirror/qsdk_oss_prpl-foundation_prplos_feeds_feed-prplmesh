-bool ApAutoConfigurationTask::populate_mld_id_in_bss_infos(const std::string &radio_iface,
-                                                           std::vector<sBssConfig> &bss_infos)
+int8_t ApAutoConfigurationTask::get_mld_unit_from_lookup_table(eVapType vap_type,
+                                                                eRadioType radio_type) const
 {
-    auto radio_it = m_ap_mld_requests_infos.find(radio_iface);
-    if (radio_it == m_ap_mld_requests_infos.end()) {
-        LOG(DEBUG) << "No MLD configuration found for radio interface: " << radio_iface;
-        return true;
+    // Validate vap_type range
+    uint8_t vap_type_idx = static_cast<uint8_t>(vap_type);
+    if (vap_type_idx > static_cast<uint8_t>(eVapType::OTHER)) {
+        LOG(WARNING) << "Invalid vap_type: " << static_cast<int>(vap_type_idx)
+                     << ", returning DISABLED_MLDUNIT";
+        return DISABLED_MLDUNIT;
     }
 
-    const auto &ssid_mld_map = radio_it->second;
-    for (auto &bss_info : bss_infos) {
-        const std::string &ssid = bss_info.payload_config.ssid;
-        auto ssid_it            = ssid_mld_map.find(ssid);
-        if (ssid_it != ssid_mld_map.end()) {
-            const auto &mld_info = ssid_it->second;
-            bss_info.mld_id      = mld_info.mld_unit;
-            bss_info.smd_mac     = mld_info.smd_mac;
-            LOG(DEBUG) << "Populated BSS config for SSID " << ssid
-                       << ": mld_id=" << int(bss_info.mld_id) << ", smd_mac=" << bss_info.smd_mac;
-        } else {
-            bss_info.mld_id  = DISABLED_MLDUNIT;
-            bss_info.smd_mac = net::network_utils::ZERO_MAC;
-        }
+    // Validate radio_type range
+    uint8_t radio_type_idx = static_cast<uint8_t>(radio_type);
+    if (radio_type_idx >= static_cast<uint8_t>(eRadioType::RADIO_TYPE_MAX)) {
+        LOG(WARNING) << "Invalid radio_type: " << static_cast<int>(radio_type_idx)
+                     << ", returning DISABLED_MLDUNIT";
+        return DISABLED_MLDUNIT;
     }
 
-    return true;
+    int8_t mld_unit = m_mld_unit_lookup_table[vap_type_idx][radio_type_idx];
+
+    LOG(DEBUG) << "MLD unit lookup: vap_type=" << static_cast<int>(vap_type)
+               << ", radio_type=" << static_cast<int>(radio_type)
+               << " -> mld_unit=" << static_cast<int>(mld_unit);
+
+    return mld_unit;
+}
+
+ApAutoConfigurationTask::eRadioType
+ApAutoConfigurationTask::determine_radio_type(eFreqType freq_type, bool is_mlo_capable) const
+{
+    // If MLO capable, return MLO type
+    if (is_mlo_capable) {
+        LOG(DEBUG) << "Radio is MLO capable, returning MLO radio type";
+        return eRadioType::MLO;
+    }
+
+    // Otherwise, determine SLO type based on frequency
+    switch (freq_type) {
+    case eFreqType::FREQ_24G:
+        LOG(DEBUG) << "Radio frequency is 2.4GHz, returning SLO_2G";
+        return eRadioType::SLO_2G;
+
+    case eFreqType::FREQ_5G:
+        LOG(DEBUG) << "Radio frequency is 5GHz, returning SLO_5G";
+        return eRadioType::SLO_5G;
+
+    case eFreqType::FREQ_5GL:
+        LOG(DEBUG) << "Radio frequency is 5GHz Low, returning SLO_5GL";
+        return eRadioType::SLO_5GL;
+
+    case eFreqType::FREQ_5GH:
+        LOG(DEBUG) << "Radio frequency is 5GHz High, returning SLO_5G";
+        return eRadioType::SLO_5G;
+
+    case eFreqType::FREQ_6G:
+        LOG(DEBUG) << "Radio frequency is 6GHz, returning SLO_6G";
+        return eRadioType::SLO_6G;
+
+    default:
+        LOG(WARNING) << "Unknown frequency type: " << static_cast<int>(freq_type)
+                     << ", defaulting to SLO_2G";
+        return eRadioType::SLO_2G;
+    }
 }
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
