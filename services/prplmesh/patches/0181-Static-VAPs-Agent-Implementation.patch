@@ -472,14 +472,72 @@ private:
     bool add_wsc_m1_tlv(const std::string &radio_iface);
 
     /**
-     * @brief Find an available MLD unit ID for AP MLD.
+     * @brief Radio type for MLD unit lookup table.
      *
-     * Searches for an unused MLD unit by checking which units are already assigned
-     * to AP MLD configurations.
+     * Defines the radio types used as column indices in the MLD unit lookup table.
+     */
+    enum class eRadioType : uint8_t {
+        MLO = 0,      ///< Multi-Link Operation (MLO) - 2.4G + 5G + 6G
+        SLO_2G,       ///< Single-Link Operation 2.4 GHz
+        SLO_5G,      ///< Single-Link Operation 5 GHz High
+        SLO_6G,       ///< Single-Link Operation 6 GHz
+        SLO_5GL,      ///< Single-Link Operation 5 GHz Low
+        RADIO_TYPE_MAX
+    };
+
+    /**
+     * @brief MLD unit lookup table indexed by VAP type and radio type.
+     *
+     * This 2D array maps (vap_type, radio_type) to MLD unit IDs.
+     *
+     * Rows: Indexed by sequential VAP type index (0-7):
+     *   0=HOME, 1=GUEST, 2=VIDEO, 3=BACKHAUL, 4=HOTSPOT, 5=STAFF, 6=ISOLATED, 7=OTHER
+     * Columns: Indexed by eRadioType enum values (MLO, SLO_2G, SLO_5G, SLO_6G, SLO_5GL)
+     *
+     * Values:
+     *   - Valid MLD unit ID (0 to max_mlds-1): BSS should use this MLD unit
+     *   - DISABLED_MLDUNIT (-1): BSS should not be part of any MLD
+     *
+     * Example usage:
+     *   int8_t mld_unit = get_mld_unit_from_lookup_table(eVapType::HOME, eRadioType::MLO);
+     *
+     * Note: This table should be manually populated with desired MLD unit assignments
+     * based on deployment requirements. Access via get_mld_unit_from_lookup_table()
+     * which handles the eVapType to index mapping.
+     */
+    static constexpr int8_t m_mld_unit_lookup_table[8]
+        [static_cast<uint8_t>(eRadioType::RADIO_TYPE_MAX)] = {
+        // Format: {MLO, SLO_2G, SLO_5G, SLO_6G, SLO_5GL}
+
+        /* HOME */     {3, 19, 35, 51, 67},
+        /* GUEST */    {8, 24, 40, 56, 72},
+        /* VIDEO */    {9, 25, 41, 57, 73},
+        /* BACKHAUL */ {7, 23, 39, 55, 71},
+        /* HOTSPOT */  {4, 20, 36, 52, 68},
+        /* STAFF */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
+        /* ISOLATED */ {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
+        /* OTHER */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT}
+    };
+
+    /**
+     * @brief Get MLD unit from lookup table based on VAP type and radio type.
+     *
+     * @param vap_type VAP type from custom_alias (HOME, GUEST, VIDEO, etc.)
+     * @param radio_type Radio type (MLO, SLO_2G, SLO_5G, SLO_6G, SLO_5GL)
+     *
+     * @return MLD unit ID from lookup table, or DISABLED_MLDUNIT if not found/disabled
+     */
+    int8_t get_mld_unit_from_lookup_table(eVapType vap_type, eRadioType radio_type) const;
+
+    /**
+     * @brief Determine radio type based on frequency type and MLO capability.
+     *
+     * @param freq_type Frequency type of the radio (FREQ_24G, FREQ_5G, FREQ_5GL, FREQ_5GH, FREQ_6G)
+     * @param is_mlo_capable Whether the radio supports MLO
      *
-     * @return Available MLD unit ID (0 to max_mlds-1), or DISABLED_MLDUNIT if none available.
+     * @return Radio type for lookup table indexing
      */
-    int8_t find_available_ap_mld_unit();
+    eRadioType determine_radio_type(eFreqType freq_type, bool is_mlo_capable) const;
 };
 
