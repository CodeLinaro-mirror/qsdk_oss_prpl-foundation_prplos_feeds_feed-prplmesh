+std::string BackhaulManager::get_radio_band(const sMacAddr &radio_mac)
+{
+    auto db    = AgentDB::get();
+    auto radio = db->get_radio_by_mac(radio_mac, AgentDB::eMacType::RADIO);
+    if (!radio) {
+        LOG(ERROR) << "get_radio_band: radio not found in AgentDB for MAC " << radio_mac;
+        return {};
+    }
+
+    const auto freq_type  = radio->wifi_channel.get_freq_type();
+    const auto radio_band = beerocks::utils::freq_type_to_radio_band_name(freq_type);
+    if (radio_band.empty()) {
+        LOG(ERROR) << "get_radio_band: unknown frequency type " << int(freq_type)
+                   << " for radio " << radio_mac;
+    }
+    return radio_band;
+}
