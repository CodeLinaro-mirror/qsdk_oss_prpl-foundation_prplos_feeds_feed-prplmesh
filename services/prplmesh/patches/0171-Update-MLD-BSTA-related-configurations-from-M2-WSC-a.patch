+eBstaSupplicantRestartStatus bpl_cfg_update_bsta_mld_grp(const std::string &radio_band,
+                                                         int8_t mld_unit)
+{
+    LOG(DEBUG) << "bpl_cfg_update_bsta_mld_grp: radio_band=" << radio_band
+               << " mld_unit=" << int(mld_unit);
+
+    const std::string package_name  = "wireless";
+    const std::string section_type  = "wifi-iface";
+    const std::string mld_sect_type = "wifi-mld";
+
+    // Get all wifi-iface sections once; shared by both the mld_unit=-1 path and the
+    // normal path via find_bsta_iface_section.
+    std::vector<std::string> all_sections;
+    if (!uci_get_all_sections(package_name, section_type, all_sections)) {
+        LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to get all wifi-iface sections";
+        return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
+    }
+
+    // Use find_bsta_iface_section to locate the matching bSTA wifi-iface section
+    // (mode=sta, multi_ap=BSS_TYPE_BACKHAUL, band matches radio_band).
+    const std::string matched_section = find_bsta_iface_section(all_sections, radio_band);
+
+    // If mld_unit == -1, remove the bSTA section (or just its mld option when it is the
+    // only section referencing mld0).
+    if (mld_unit == -1) {
+        if (matched_section.empty()) {
+            LOG(DEBUG) << "bpl_cfg_update_bsta_mld_grp: mld_unit=-1, no matching wifi-iface "
+                       << "section found for radio_band=" << radio_band << ", nothing to delete";
+            return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
+        }
+
+        // If this section has mld="mld0", check whether it is the only such section.
+        // If it is the only one, delete the wifi-mld section and remove the mld option
+        // from the wifi-iface section instead of deleting the section itself.
+        std::string current_mld_value;
+        uci_get_option(package_name, section_type, matched_section, "mld", current_mld_value);
+
+        if (current_mld_value == "mld0") {
+            // Count other wifi-iface sections with mld="mld0" AND mode="sta"
+            int mld0_sta_count = 0;
+            for (const auto &other_sec : all_sections) {
+                if (other_sec == matched_section) {
+                    continue;
+                }
+                std::string other_mode, other_mld;
+                if (uci_get_option(package_name, section_type, other_sec, "mode", other_mode) &&
+                    other_mode == "sta" &&
+                    uci_get_option(package_name, section_type, other_sec, "mld", other_mld) &&
+                    other_mld == "mld0") {
+                    mld0_sta_count++;
+                }
+            }
+
+            if (mld0_sta_count == 0) {
+                LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: mld_unit=-1, section "
+                          << matched_section
+                          << " is the only wifi-iface with mld=mld0 and mode=sta; "
+                          << "removing wifi-mld section mld0 and mld option from wifi-iface";
+
+                if (uci_section_exists(package_name, mld_sect_type, "mld0")) {
+                    if (!uci_delete_section(package_name, mld_sect_type, "mld0", true)) {
+                        LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to delete "
+                                   << "wifi-mld section mld0";
+                        return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
+                    }
+                    LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: deleted wifi-mld section mld0";
+                }
+
+                // Remove the "mld" option by setting it to "" (uci_set_section removes it)
+                OptionsUnorderedMap remove_mld_opts;
+                remove_mld_opts["mld"] = "";
+                if (!uci_set_section(package_name, section_type, matched_section,
+                                     remove_mld_opts, true)) {
+                    LOG(ERROR) << "bpl_cfg_update_bsta_mld_grp: failed to remove mld option "
+                               << "from section " << matched_section;
+                    return eBstaSupplicantRestartStatus::SUPP_RST_NOT_REQUIRED;
+                }
+                LOG(INFO) << "bpl_cfg_update_bsta_mld_grp: removed mld option from "
+                          << "wifi-iface section " << matched_section;
+                return eBstaSupplicantRestartStatus::SUPP_RST_REQUIRED;
+            }
+        }
