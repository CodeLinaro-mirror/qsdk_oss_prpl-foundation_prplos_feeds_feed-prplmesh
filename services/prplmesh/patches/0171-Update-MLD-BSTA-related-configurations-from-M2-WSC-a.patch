+
+/**
+ * @brief Return the refined radio-band string for a wifi-device section.
+ *
+ * Reads the "band" option and refines "5g" to "5gl" or "5gh" based on the
+ * "channels" option.  Returns an empty string when the band cannot be read.
+ */
+static std::string get_refined_band(const std::string &device_section)
+{
+    std::string band;
+    if (!uci_get_option("wireless", "wifi-device", device_section, "band", band)) {
+        return "";
+    }
+    if (band == "5g") {
+        std::string channel_range;
+        if (uci_get_option("wireless", "wifi-device", device_section, "channels",
+                           channel_range)) {
+            if (channel_range == "36-64") {
+                band = "5gl";
+            } else if (channel_range == "100-165") {
+                band = "5gh";
+            }
+        }
+    }
+    return band;
+}
+
+/**
+ * @brief Convert WSC authentication/encryption types to a UCI encryption string.
+ */
+static std::string get_encryption_string(WSC::eWscAuth authentication_type,
+                                         WSC::eWscEncr encryption_type)
+{
+    std::string encryption = "none";
+    if (authentication_type == WSC::eWscAuth::WSC_AUTH_WPA2PSK) {
+        encryption = "psk2";
+        if (encryption_type == WSC::eWscEncr::WSC_ENCR_TKIP) {
+            encryption += "+tkip";
+        } else if (encryption_type == WSC::eWscEncr::WSC_ENCR_AES) {
+            encryption += "+aes";
+        }
+    } else if (authentication_type == WSC::eWscAuth::WSC_AUTH_SAE) {
+        encryption = "sae";
+    } else if (authentication_type ==
+               static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_SAE |
+                                          WSC::eWscAuth::WSC_AUTH_WPA2PSK)) {
+        encryption = "sae-mixed";
+    }
+    return encryption;
+}
+
+/**
+ * @brief Find the first wifi-iface section in @a all_sections that matches
+ *        bSTA criteria: mode=sta, multi_ap=BSS_TYPE_BACKHAUL, and whose
+ *        associated wifi-device band matches @a radio_band.
+ *
+ * @return Section name of the first match, or empty string if none found.
+ */
+static std::string find_bsta_iface_section(const std::vector<std::string> &all_sections,
+                                           const std::string &radio_band)
+{
+    const std::string pkg  = "wireless";
+    const std::string type = "wifi-iface";
+    for (const auto &sec : all_sections) {
+        std::string mode_val;
+        if (!uci_get_option(pkg, type, sec, "mode", mode_val) || mode_val != "sta") {
+            continue;
+        }
+        std::string multi_ap_val;
+        uci_get_option(pkg, type, sec, "multi_ap", multi_ap_val);
+        if (multi_ap_val != std::to_string(beerocks::eBssType::BSS_TYPE_BACKHAUL)) {
+            continue;
+        }
+        std::string device_val;
+        if (!uci_get_option(pkg, type, sec, "device", device_val)) {
+            continue;
+        }
+        if (get_refined_band(device_val) == radio_band) {
+            return sec;
+        }
+    }
+    return "";
+}
