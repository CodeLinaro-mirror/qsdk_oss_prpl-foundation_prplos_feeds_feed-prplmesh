---
 controller/src/beerocks/master/controller.cpp | 12 +++++++
 .../periodic/topology_query_operation.cpp     | 35 +++++++++++++++++++
 .../periodic/topology_query_operation.h       | 31 ++++++++++++++++
 3 files changed, 78 insertions(+)
 create mode 100644 controller/src/beerocks/master/periodic/topology_query_operation.cpp
 create mode 100644 controller/src/beerocks/master/periodic/topology_query_operation.h

diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index d94c6fda5..e30cc32fc 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -10,6 +10,7 @@
 #include "on_action.h"
 #include "periodic/persistent_data_commit_operation.h"
 #include "periodic/persistent_database_aging.h"
+#include "periodic/topology_query_operation.h"
 #include "son_actions.h"
 #include "son_management.h"
 #include "tasks/agent_monitoring_task.h"
@@ -159,6 +160,11 @@ constexpr auto tasks_timer_period = std::chrono::milliseconds(250);
  */
 constexpr auto operations_timer_period = std::chrono::milliseconds(1000);
 
+/**
+ * Interval between successive TOPOLOGY_QUERY_MESSAGE broadcasts to all connected agents
+ */
+constexpr auto topology_query_interval_sec = std::chrono::seconds(60);
+
 Controller::Controller(db &database_,
                        std::unique_ptr<beerocks::btl::BrokerClientFactory> broker_client_factory,
                        std::unique_ptr<beerocks::UccServer> ucc_server,
@@ -244,6 +250,12 @@ bool Controller::start()
         }
     }
 
+    // Periodically send TOPOLOGY_QUERY_MESSAGE to every connected agent to keep the
+    // controller's topology view in sync, independent of the persistent DB setting.
+    auto topology_query_op = std::make_shared<topology_query_operation>(
+        topology_query_interval_sec, database, cmdu_tx);
+    operations.add_operation(topology_query_op);
+
     // GW & GW Switch nodes are need to be added in case of Controller only mode
     // Normally node/database objects are added with SLAVE JOIN messages
     // In case of Controller only mode, prplMesh agent will not start JOIN process.
diff --git a/controller/src/beerocks/master/periodic/topology_query_operation.cpp b/controller/src/beerocks/master/periodic/topology_query_operation.cpp
new file mode 100644
index 000000000..11896d58b
--- /dev/null
+++ b/controller/src/beerocks/master/periodic/topology_query_operation.cpp
@@ -0,0 +1,35 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "topology_query_operation.h"
+#include "son_actions.h"
+
+#include <easylogging++.h>
+
+#define OPERATION_LOG(a) (LOG(a) << "operation " << operation_name << " id " << id << ": ")
+
+using namespace son;
+
+topology_query_operation::topology_query_operation(std::chrono::seconds period_interval_sec_,
+                                                    db &database_,
+                                                    ieee1905_1::CmduMessageTx &cmdu_tx_,
+                                                    const std::string &operation_name_)
+    : periodic_operation(period_interval_sec_, operation_name_), m_database(database_),
+      m_cmdu_tx(cmdu_tx_)
+{
+}
+
+void topology_query_operation::periodic_operation_function()
+{
+    auto agents = m_database.get_all_connected_agents();
+    for (const auto &agent : agents) {
+        if (!son_actions::send_topology_query_msg(agent->al_mac, m_cmdu_tx, m_database)) {
+            OPERATION_LOG(WARNING) << "Failed sending TOPOLOGY_QUERY_MESSAGE to agent "
+                                   << agent->al_mac;
+        }
+    }
+
+    OPERATION_LOG(TRACE) << "Sent TOPOLOGY_QUERY_MESSAGE to " << agents.size()
+                         << " connected agent(s)";
+}
\ No newline at end of file
diff --git a/controller/src/beerocks/master/periodic/topology_query_operation.h b/controller/src/beerocks/master/periodic/topology_query_operation.h
new file mode 100644
index 000000000..4f3b51749
--- /dev/null
+++ b/controller/src/beerocks/master/periodic/topology_query_operation.h
@@ -0,0 +1,31 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _TOPOLOGY_QUERY_OPERATION_H_
+#define _TOPOLOGY_QUERY_OPERATION_H_
+
+#include "../db/db.h"
+#include "periodic_operation.h"
+
+#include <tlvf/CmduMessageTx.h>
+
+namespace son {
+class topology_query_operation : public periodic_operation {
+public:
+    topology_query_operation(
+        std::chrono::seconds period_interval_sec_, db &database_,
+        ieee1905_1::CmduMessageTx &cmdu_tx_,
+        const std::string &operation_name_ = std::string("topology query operation"));
+    virtual ~topology_query_operation() {}
+
+protected:
+    virtual void periodic_operation_function() override;
+
+private:
+    db &m_database;
+    ieee1905_1::CmduMessageTx &m_cmdu_tx;
+};
+} // namespace son
+
+#endif
\ No newline at end of file
