From f74c3b87aeac7ae4eaba16253c2758caacc37ab9 Mon Sep 17 00:00:00 2001
From: Hemanth Krishna Srirama <hsrirama@qti.qualcomm.com>
Date: Mon, 22 Jun 2026 14:18:19 +0530
Subject: [PATCH] ApMld Reconfig for DM addition

Signed-off-by: Hemanth Krishna Srirama <hsrirama@qti.qualcomm.com>
---
 controller/nbapi/odl/controller.odl.in |  7 ++++++
 controller/nbapi/on_action.cpp         | 31 ++++++++++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/controller/nbapi/odl/controller.odl.in b/controller/nbapi/odl/controller.odl.in
index cf5e64509..d09e96d11 100644
--- a/controller/nbapi/odl/controller.odl.in
+++ b/controller/nbapi/odl/controller.odl.in
@@ -505,6 +505,13 @@
                     }
                     /* Update all unassociated stations stats, from all agents and all radios */
                     bool UpdateUnassociatedStationsStats();
+
+                    void ReconfigApmld(
+                        %in %mandatory string al_mac,
+                        %in %mandatory string mld_mac,
+                        %in %mandatory string ruid,
+                        %in %mandatory bool add_link
+                    );
                 }
 
     @DATAELEMENTS_ROOT_DM_Footer@
diff --git a/controller/nbapi/on_action.cpp b/controller/nbapi/on_action.cpp
index 3475d948a..f350cf9ed 100644
--- a/controller/nbapi/on_action.cpp
+++ b/controller/nbapi/on_action.cpp
@@ -475,6 +475,36 @@ amxd_status_t client_steering(amxd_object_t *object, amxd_function_t *func, amxc
     return amxd_status_ok;
 }
 
+amxd_status_t reconfig_apmld(amxd_object_t *object, amxd_function_t *func, amxc_var_t *args,
+	                              amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    auto al_mac = GET_CHAR(args, "al_mac");
+    auto mld_mac = GET_CHAR(args, "mld_mac");
+    auto ruid = GET_CHAR(args, "ruid");
+    bool add_link = GET_BOOL(args, "add_link");
+
+    if (!al_mac || !mld_mac || !ruid) {
+        LOG(ERROR) << "Failed to get proper arguments.";
+        return amxd_status_parameter_not_found;
+    }
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "Failed to get controller context.";
+        return amxd_status_unknown_error;
+    }
+
+    if (!controller_ctx->reconfig_apmld(tlvf::mac_from_string(al_mac), tlvf::mac_from_string(mld_mac),
+			                tlvf::mac_from_string(ruid), add_link)) {
+        LOG(ERROR) << "Failed to reconfig apmld from NBAPI for Agent: " << al_mac
+                   << " on MLD MAC: " << mld_mac << " with ruid: " << ruid
+                   << " with operation " << (add_link ? "add_link" : "remove_link");
+        return amxd_status_unknown_error;
+    }
+    return amxd_status_ok;
+}
+
 /**
  * @brief Initiate channel scan from NBAPI for given radio and channels.
  *
@@ -1775,6 +1805,7 @@ std::vector<beerocks::nbapi::sFunctions> get_func_list(void)
         {"access_point_commit", DATAELEMENTS_ROOT_DM ".Network.AccessPointCommit",
          access_point_commit},
         {"client_steering", DATAELEMENTS_ROOT_DM ".Network.ClientSteering", client_steering},
+	{"reconfig_apmld", DATAELEMENTS_ROOT_DM ".Network.ReconfigApmld", reconfig_apmld},
         {"trigger_scan", DATAELEMENTS_ROOT_DM ".Network.Device.Radio.ScanTrigger", trigger_scan},
         {"BTMRequest", DATAELEMENTS_ROOT_DM ".Network.Device.Radio.BSS.STA.MultiAPSTA.BTMRequest",
          btm_request},
-- 
