     } traffic_separation;
 
     struct {
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 4b878b9ef..2bf457342 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -399,6 +399,23 @@ void ApAutoConfigurationTask::work()
             break;
         }
         case eState::SEND_AP_AUTOCONFIGURATION_WSC_M1: {
+            auto db = AgentDB::get();
+            // If TS is active but the initial VLAN interface has not yet been created,
+            // hold M1 here. The early AP capability report must reach the controller
+            // before M1 so it can include MLO configuration in M2; gating M1 on
+            // ts_applied guarantees the order: VLAN creation → early AP cap → M1.
+            if (db->traffic_separation.primary_vlan_id != 0 && !db->traffic_separation.ts_applied) {
+                LOG(DEBUG) << "Waiting for TS VLAN interface before sending M1 for " << radio_iface;
+                break;
+            }
+            // Send early AP capability immediately before M1 (if not already sent).
+            // Must precede M1 so the controller knows about MLO support when processing M1.
+            if (db->controller_info.early_ap_capability &&
+                !db->controller_info.early_ap_capability_report_sent) {
+                LOG(INFO) << "Sending EARLY_AP_CAPABILITY Before M1 for " << radio_iface;
+                db->controller_info.early_ap_capability_report_sent = true;
+                m_btl_ctx.send_event(slave_thread::eEvent::CONTROLLER_EARLY_AP_CAPABILITY);
+            }
             send_ap_autoconfiguration_wsc_m1_message(radio_iface);
             conf_params.timeout =
                 std::chrono::steady_clock::now() +
@@ -2522,6 +2539,26 @@ bool ApAutoConfigurationTask::handle_agent_ap_mld_configuration_tlv(
         process_missing_mld_links(radio->front.iface_name);
     }
 
+    // Trigger re-autoconfiguration for radios newly added to MLD configuration.
+    // This handles the timing issue where a radio (e.g. 6GHz) received its M2 before
+    // the AP MLD configuration request arrived, resulting in mld_id=-1 for all its BSSes.
+    // Now that the MLD config is known, force a new M1/M2 exchange so the controller
+    // can send the correct MLD IDs for this radio.
+    for (const auto &new_iface_kv : m_ap_mld_requests_infos) {
+        const auto &iface_name = new_iface_kv.first;
+        if (prev_ap_mld_requests.find(iface_name) == prev_ap_mld_requests.end()) {
+            // This radio is newly added to MLD configuration
+            auto conf_it = m_radios_conf_params.find(iface_name);
+            if (conf_it != m_radios_conf_params.end() &&
+                conf_it->second.state == eState::CONFIGURED) {
+                LOG(INFO) << "Radio " << iface_name
+                          << " newly added to MLD config while already CONFIGURED"
+                          << " — triggering re-autoconfiguration to obtain MLD IDs";
+                FSM_MOVE_STATE(iface_name, eState::SEND_AP_AUTOCONFIGURATION_WSC_M1);
+            }
+        }
+    }
+
     return true;
 }
 
