+bool cfg_set_wifi_iface_multi_ap_vlanid(const std::string &iface_name, uint16_t vlanid)
+{
+    const std::string pkg = "wireless";
+    bool any_updated      = false;
+
+    OptionsUnorderedMap options;
+    options["multi_ap_vlanid"] = std::to_string(vlanid);
+
+    // Update ALL wifi-iface sections with matching ifname.
+    // For MLO backhaul APs, multiple sections (one per band) share the same ifname.
+    {
+        const std::string type = "wifi-iface";
+        std::vector<std::string> all_sections;
+        if (uci_get_all_sections(pkg, type, all_sections)) {
+            for (const auto &sec : all_sections) {
+                std::string ifname_val;
+                if (!uci_get_option(pkg, type, sec, "ifname", ifname_val) ||
+                    ifname_val != iface_name) {
+                    continue;
+                }
+                if (!uci_set_section(pkg, type, sec, options, false)) {
+                    LOG(ERROR) << "cfg_set_wifi_iface_multi_ap_vlanid: failed for section=" << sec;
+                } else {
+                    LOG(DEBUG) << "cfg_set_wifi_iface_multi_ap_vlanid: set multi_ap_vlanid="
+                               << vlanid << " section=" << sec << " iface=" << iface_name;
+                    any_updated = true;
+                }
+            }
+        }
+    }
+
+    // Also update wifi-mld sections with matching ifname (MLO backhaul AP MLD sections).
+    {
+        const std::string mld_type = "wifi-mld";
+        std::vector<std::string> mld_sections;
+        if (uci_get_all_sections(pkg, mld_type, mld_sections)) {
+            for (const auto &sec : mld_sections) {
+                std::string ifname_val;
+                if (!uci_get_option(pkg, mld_type, sec, "ifname", ifname_val) ||
+                    ifname_val != iface_name) {
+                    continue;
+                }
+                if (!uci_set_section(pkg, mld_type, sec, options, false)) {
+                    LOG(ERROR) << "cfg_set_wifi_iface_multi_ap_vlanid: failed for mld section=" << sec;
+                } else {
+                    LOG(DEBUG) << "cfg_set_wifi_iface_multi_ap_vlanid: set multi_ap_vlanid="
+                               << vlanid << " mld section=" << sec << " iface=" << iface_name;
+                    any_updated = true;
+                }
+            }
+        }
+    }
+
+    if (any_updated) {
+        uci_commit_changes(pkg);
+    } else {
+        LOG(DEBUG) << "cfg_set_wifi_iface_multi_ap_vlanid: no section found for iface=" << iface_name;
+    }
+
+    return any_updated;
+}
+
 } // namespace bpl
 } // namespace beerocks
