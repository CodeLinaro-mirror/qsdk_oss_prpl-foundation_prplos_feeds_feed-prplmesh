             if (!conf) {
-                LOG(ERROR) << "Autoconfiguration: no hostapd config to apply configuration!";
-                return false;
+                // The BSSID may be a STA link MAC that was marked as "in use" in the BSSID pool
+                // but is not present in any hostapd AP conf file (e.g. MLO STA link address).
+                // Release it and skip this BSS entry so the remaining VAPs can still be configured.
+                LOG(WARNING) << "Autoconfiguration: no hostapd config found for bssid="
+                             << tlvf::mac_to_string(bss_it.bssid)
+                             << " (may be a STA link MAC) - skipping this BSS entry";
+                m_radio_info.bssid_pool[tlvf::mac_to_string(bss_it.bssid)] = false;
+                continue;
             }
             auto &vap_id = conf.get_vap_by_bssid(tlvf::mac_to_string(bss_it.bssid));
                 LOG(INFO) << "vap_id: " << vap_id;
@@ -2753,7 +2760,77 @@ bool ap_wlan_hal_nl80211::set_radio_mbo_assoc_disallow(bool enable)
 
 bool ap_wlan_hal_nl80211::set_primary_vlan_id(uint16_t primary_vlan_id)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
+    LOG(INFO) << "set_primary_vlan_id " << primary_vlan_id
+              << " radio=" << m_radio_info.iface_name;
+
+    // Store vlanid so create_new_hostapd_conf_file() can embed multi_ap_vlanid when the
+    // backhaul AP is created after this call (timing: set_primary_vlan_id runs
+    // before the backhaul AP is added to available_vaps).
+    m_primary_vlan_id = primary_vlan_id;
+
+    // Base interface name of this radio (e.g. "wlan2" from "wlan2_link0").
+    std::string radio_base_iface;
+    extractLinkBaseInterface(m_radio_info.iface_name, radio_base_iface);
+
+    for (const auto &vap : m_radio_info.available_vaps) {
+        if (!vap.second.backhaul) {
+            continue;
+        }
+        std::string base_iface;
+        extractLinkBaseInterface(vap.second.bss, base_iface);
+
+        // Cross-radio MLO: the backhaul AP link belongs to a different radio's interface.
+        // Sending RELOAD_CONFIG to it reconfigures the entire MLD and removes this radio's
+        // control socket, causing an ap_manager restart loop.
+        bool is_cross_radio_mlo = (!radio_base_iface.empty() &&
+                                   vap.second.bss.find(radio_base_iface) == std::string::npos);
+
+        LOG(DEBUG) << "set_primary_vlan_id: bss=" << vap.second.bss
+                   << " base_iface=" << base_iface
+                   << " cross_radio_mlo=" << (is_cross_radio_mlo ? "yes" : "no");
+
+        // Persist to UCI (survives reboots).
+        if (!beerocks::bpl::cfg_set_wifi_iface_multi_ap_vlanid(base_iface, primary_vlan_id)) {
+            LOG(ERROR) << "Failed to set multi_ap_vlanid in UCI for iface=" << base_iface;
+        }
+
+        // Update the running hostapd conf and reload.
+        // Skip RELOAD_CONFIG for cross-radio MLO links — sending it to a peer-radio
+        // interface removes this radio's control socket and triggers a restart loop.
+        prplmesh::hostapd::Configuration conf = load_hostapd_config(vap.second.bss, "");
+        if (conf) {
+            // Conf file uses "interface=<base_iface>"; fall back to base_iface if BSSID
+            // lookup fails (e.g. link-specific BSSID differs from conf BSSID).
+            const auto &vap_id = conf.get_vap_by_bssid(vap.second.mac);
+            const std::string &target_vap = vap_id.empty() ? base_iface : vap_id;
+            conf.set_create_vap_value(target_vap, "multi_ap_vlanid",
+                                      std::to_string(primary_vlan_id));
+            if (!conf.store(target_vap)) {
+                LOG(ERROR) << "set_primary_vlan_id: failed to save hostapd conf for bss="
+                           << vap.second.bss;
+            } else {
+                if (is_cross_radio_mlo) {
+                    LOG(DEBUG) << "set_primary_vlan_id: skipping RELOAD_CONFIG for cross-radio"
+                               << " MLO bss=" << vap.second.bss;
+                } else {
+                    // Send RELOAD_CONFIG to base_iface (e.g. "wlan1_3"), not the link-specific
+                    // name, because the conf file has "interface=<base_iface>".
+                    LOG(DEBUG) << "set_primary_vlan_id: RELOAD_CONFIG base_iface=" << base_iface
+                               << " vlanid=" << primary_vlan_id;
+                    if (!wpa_ctrl_send_msg("RELOAD_CONFIG", base_iface)) {
+                        LOG(WARNING) << "set_primary_vlan_id: RELOAD_CONFIG failed for"
+                                     << " base_iface=" << base_iface;
+                    } else {
+                        LOG(INFO) << "set_primary_vlan_id: multi_ap_vlanid=" << primary_vlan_id
+                                  << " applied to base_iface=" << base_iface;
+                    }
+                }
+            }
+        } else {
+            LOG(WARNING) << "set_primary_vlan_id: could not load hostapd conf for bss="
+                         << vap.second.bss;
+        }
+    }
     return true;
 }
 
@@ -4004,6 +4081,17 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
                             : MULTIAP_HOP_COUNT_EXTENDER;
         conf.set_create_vap_value(vap_id, "assocresp_elements",
             build_multiap_assocresp_ie(hop_count));
+
+        // If a primary VLAN ID was already received (set_primary_vlan_id was called
+        // before this backhaul AP was created), embed multi_ap_vlanid directly in the
+        // conf file so hostapd advertises the VLAN ID in association responses
+        // immediately — without needing a subsequent RELOAD_CONFIG.
+        if (m_primary_vlan_id != 0) {
+            LOG(DEBUG) << "create_new_hostapd_conf_file: multi_ap_vlanid=" << m_primary_vlan_id
+                       << " ifname=" << ifname;
+            conf.set_create_vap_value(vap_id, "multi_ap_vlanid",
+                                      std::to_string(m_primary_vlan_id));
+        }
     }
     auto ieee80211be_sprt = conf.get_head_value("ieee80211be");
 
