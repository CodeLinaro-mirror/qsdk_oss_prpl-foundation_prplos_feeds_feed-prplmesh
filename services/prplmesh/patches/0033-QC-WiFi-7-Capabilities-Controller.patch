From ac44e0c942a82edd556c63878e8f54df829c216c Mon Sep 17 00:00:00 2001
From: Praveen Babu <pravbabu@qti.qualcomm.com>
Date: Tue, 24 Jun 2025 20:15:21 +0530
Subject: [PATCH] QC WiFi-7 Capabilities Controller

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 controller/nbapi/odl/capabilities.odl.in  | 64 +++++++++++++++++++++++
 controller/nbapi/odl/device.odl.in        | 12 +++++
 controller/src/beerocks/master/db/agent.h |  1 +
 controller/src/beerocks/master/db/db.cpp  |  1 +
 4 files changed, 78 insertions(+)

diff --git a/controller/nbapi/odl/capabilities.odl.in b/controller/nbapi/odl/capabilities.odl.in
index 26dc67264..8f0f1d6be 100644
--- a/controller/nbapi/odl/capabilities.odl.in
+++ b/controller/nbapi/odl/capabilities.odl.in
@@ -158,5 +158,69 @@
             %read-only string VBSSIDFixedBitsMask;
             %read-only string VBSSIDFixedBitsValue;
         }
+
+        %read-only object WiFi7APRole {
+            %read-only bool EMLMRSupport;
+            %read-only bool EMLSRSupport;
+            %read-only bool STRSupport;
+            %read-only bool NSTRSupport;
+            %read-only bool TIDLinkMapNegotiation;
+
+            object EMLMRFreqSeparation[] {
+                counted with EMLMRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+
+            object EMLSRFreqSeparation[] {
+                counted with EMLSRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+
+            object STRFreqSeparation[] {
+                counted with STRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+
+            object NSTRFreqSeparation[] {
+                counted with NSTRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+           }
+        }
+
+        %read-only object WiFi7bSTARole {
+            %read-only bool EMLMRSupport;
+            %read-only bool EMLSRSupport;
+            %read-only bool STRSupport;
+            %read-only bool NSTRSupport;
+            %read-only bool TIDLinkMapNegotiation;
+
+            object EMLMRFreqSeparation[] {
+                counted with EMLMRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+
+            object EMLSRFreqSeparation[] {
+                counted with EMLSRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+
+            object STRFreqSeparation[] {
+                counted with STRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+
+            object NSTRFreqSeparation[] {
+                counted with NSTRFreqSeparationNumberOfEntries;
+                %read-only string RUID;
+                %read-only uint32 FreqSeparation;
+            }
+        }
     }
 }
diff --git a/controller/nbapi/odl/device.odl.in b/controller/nbapi/odl/device.odl.in
index 1dc6052ef..e1cc19e9b 100644
--- a/controller/nbapi/odl/device.odl.in
+++ b/controller/nbapi/odl/device.odl.in
@@ -309,6 +309,18 @@
 
         %instance bool UpdateVBSSCapabilities();
 
+        %read-only uint32 MaxNumMLDs;
+
+        %read-only uint32 APMLDMaxLinks = 0 {
+            on action validate call check_range [0, 15];
+        }
+
+        %read-only uint32 bSTAMLDMaxLinks = 0 {
+            on action validate call check_range [0, 15];
+        }
+
+        %read-only string TIDLinkMapCapacity;
+
         /*
         ** The list of APMLD objects.
         */
diff --git a/controller/src/beerocks/master/db/agent.h b/controller/src/beerocks/master/db/agent.h
index 052a62196..73c64a777 100644
--- a/controller/src/beerocks/master/db/agent.h
+++ b/controller/src/beerocks/master/db/agent.h
@@ -586,6 +586,7 @@ public:
     // Key: MLD ID
     std::unordered_map<int8_t, sAPMLD> configured_ap_mlds;
 
+    uint8_t max_num_mlds       = 0;
     uint8_t ap_maximum_links   = 0;
     uint8_t bsta_maximum_links = 0;
 
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 0c53ba58f..81559a6ef 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -1736,6 +1736,7 @@ bool db::set_wifi7_agent_capabilities(wfa_map::tlvWifi7AgentCapabilities &wifi7_
         return false;
     }
 
+    agent->max_num_mlds = static_cast<uint8_t>(wifi7_agt_caps_tlv.max_num_mlds());
     agent->ap_maximum_links = static_cast<uint8_t>(wifi7_agt_caps_tlv.flags1().ap_maximum_links);
     agent->bsta_maximum_links =
         static_cast<uint8_t>(wifi7_agt_caps_tlv.flags1().bsta_maximum_links);
-- 
