                << ", current m_controller_reachable=" << int(m_controller_reachable)
                << ", current m_backhaul_l2_connected=" << int(m_backhaul_l2_connected);
 
+    // Send FH VAP state to all AP managers based on controller reachability.
+    // Disable when controller is not reachable, enable when it becomes reachable.
+    LOG(DEBUG) << "Controller reachability changed - sending FH VAP "
+               << (reachable ? "enable" : "disable") << " to all AP managers";
+    send_fh_vap_state_to_ap_managers(reachable);
+
     if (m_controller_reachable == reachable) {
         LOG(ERROR) << "Reachability hasn't changed. Returning early.";
         return;
@@ -5412,6 +5440,37 @@ void slave_thread::update_bsta_state_to_ap_managers()
         });
 }
 
+void slave_thread::send_fh_vap_state_to_ap_managers(bool enable)
+{
+#ifdef USE_PRPLMESH_NLHAL
+    LOG(DEBUG) << "send_fh_vap_state_to_ap_managers: "
+               << (enable ? "enabling" : "disabling") << " FH VAPs on all radios";
+
+    m_radio_managers.do_on_each_radio_manager(
+        [&](sManagedRadio &radio_manager, const std::string &fronthaul_iface) {
+            if (radio_manager.ap_manager_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+                LOG(DEBUG) << "send_fh_vap_state_to_ap_managers: skipping " << fronthaul_iface
+                           << " - AP manager not connected";
+                return true;
+            }
+
+            auto request_out = message_com::create_vs_message<
+                beerocks_message::cACTION_APMANAGER_SET_FH_VAPS_STATE>(cmdu_tx);
+            if (!request_out) {
+                LOG(ERROR) << "Failed building cACTION_APMANAGER_SET_FH_VAPS_STATE for "
+                           << fronthaul_iface;
+                return true;
+            }
+
+            request_out->enable() = enable ? 1 : 0;
+            LOG(DEBUG) << "send_fh_vap_state_to_ap_managers: sending SET_FH_VAPS_STATE("
+                       << (enable ? "enable" : "disable") << ") to " << fronthaul_iface;
+            send_cmdu(radio_manager.ap_manager_fd, cmdu_tx);
+            return true;
+        });
+#endif
+}
