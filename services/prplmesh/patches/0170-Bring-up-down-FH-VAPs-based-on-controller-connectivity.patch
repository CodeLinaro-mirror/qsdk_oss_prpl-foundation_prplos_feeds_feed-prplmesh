+bool ap_wlan_hal_nl80211::enable_all_fh_vaps()
+{
+    LOG(DEBUG) << "enable_all_fh_vaps: enabling all fronthaul VAPs on radio " << get_iface_name();
+
+    bool success = true;
+    bool is_6g   = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G);
+
+    for (const auto &vap_entry : m_radio_info.available_vaps) {
+        const auto &vap = vap_entry.second;
+        if (vap.bss.empty()) {
+            continue;
+        }
+        if (!vap.fronthaul) {
+            continue;
+        }
+
+        // Extract link_id from the VAP interface name to determine if this is an MLO link
+        int link_id = -1;
+        extractLinkId(vap.bss, link_id);
+
+        LOG(DEBUG) << "enable_all_fh_vaps: FH VAP " << vap.bss << " link_id=" << link_id
+                   << " is_6g=" << is_6g;
+
+        if (link_id >= 0) {
+            // MLO link: check operational status before sending commands
+            bool link_operational = m_nl80211_client->check_link_id_operational(vap.bss, link_id);
+            LOG(DEBUG) << "enable_all_fh_vaps: Link " << link_id
+                       << " operational status: " << (link_operational ? "true" : "false");
+
+            if (link_operational) {
+                // Link is already operational, no need to reload
+                LOG(DEBUG) << "enable_all_fh_vaps: link " << link_id
+                           << " already operational on " << vap.bss << ", skipping";
+            } else {
+                // For 6G radio: send STOP_AP before RELOAD
+                if (is_6g) {
+                    LOG(DEBUG) << "enable_all_fh_vaps: 6G radio - sending STOP_AP to FH VAP "
+                               << vap.bss;
+                    if (!wpa_ctrl_send_msg("STOP_AP", vap.bss)) {
+                        LOG(ERROR) << "enable_all_fh_vaps: STOP_AP command failed for FH VAP "
+                                   << vap.bss;
+                        success = false;
+                        continue;
+                    }
+                }
+                LOG(DEBUG) << "enable_all_fh_vaps: sending RELOAD to FH VAP " << vap.bss;
+                if (!wpa_ctrl_send_msg("RELOAD", vap.bss)) {
+                    LOG(ERROR) << "enable_all_fh_vaps: RELOAD command failed for FH VAP "
+                               << vap.bss;
+                    success = false;
+                }
+            }
+        } else {
+
+            if (beerocks::net::network_utils::linux_iface_is_up_and_running(vap.bss)) {
+                // interface is already operational, no need to reload
+                LOG(DEBUG) << "enable_all_fh_vaps: link " << " already operational on " << vap.bss << ", skipping";
+            } else {
+                // Non-MLO VAP: for 6G radio send STOP_AP before RELOAD
+                if (is_6g) {
+                    LOG(DEBUG) << "enable_all_fh_vaps: 6G radio - sending STOP_AP to FH VAP "
+                               << vap.bss;
+                    if (!wpa_ctrl_send_msg("STOP_AP", vap.bss)) {
+                        LOG(ERROR) << "enable_all_fh_vaps: STOP_AP command failed for FH VAP "
+                                   << vap.bss;
+                        success = false;
+                        continue;
+                    }
+                }
+                LOG(DEBUG) << "enable_all_fh_vaps: sending RELOAD to FH VAP " << vap.bss;
+                if (!wpa_ctrl_send_msg("RELOAD", vap.bss)) {
+                    LOG(ERROR) << "enable_all_fh_vaps: RELOAD command failed for FH VAP " << vap.bss;
+                    success = false;
+                }
+            }
+        }
+    }
+    return success;
+}
+
+bool ap_wlan_hal_nl80211::disable_all_fh_vaps()
+{
+    LOG(DEBUG) << "disable_all_fh_vaps: disabling all fronthaul VAPs on radio " << get_iface_name();
+
+    bool success = true;
+
+    for (const auto &vap_entry : m_radio_info.available_vaps) {
+        const auto &vap = vap_entry.second;
+        if (vap.bss.empty()) {
+            continue;
+        }
+        if (!vap.fronthaul) {
+            continue;
+        }
+
+        // Extract link_id from the VAP interface name to determine if this is an MLO link
+        int link_id = -1;
+        extractLinkId(vap.bss, link_id);
+
+        LOG(DEBUG) << "disable_all_fh_vaps: FH VAP " << vap.bss << " link_id=" << link_id;
+
+        if (link_id >= 0) {
+            // MLO link: check operational status before sending STOP_AP
+            bool link_operational = m_nl80211_client->check_link_id_operational(vap.bss, link_id);
+            LOG(DEBUG) << "disable_all_fh_vaps: Link " << link_id
+                       << " operational status: " << (link_operational ? "true" : "false");
+
+            if (link_operational) {
+                LOG(DEBUG) << "disable_all_fh_vaps: sending STOP_AP to FH VAP " << vap.bss;
+                if (!wpa_ctrl_send_msg("STOP_AP", vap.bss)) {
+                    LOG(ERROR) << "disable_all_fh_vaps: STOP_AP command failed for FH VAP "
+                               << vap.bss;
+                    success = false;
+                }
+            } else {
+                LOG(DEBUG) << "disable_all_fh_vaps: link " << link_id
+                           << " not operational on " << vap.bss << ", skipping STOP_AP";
+            }
+        } else {
+            // Non-MLO VAP: send STOP_AP
+            LOG(DEBUG) << "disable_all_fh_vaps: sending STOP_AP to FH VAP " << vap.bss;
+            if (!wpa_ctrl_send_msg("STOP_AP", vap.bss)) {
+                LOG(ERROR) << "disable_all_fh_vaps: STOP_AP command failed for FH VAP " << vap.bss;
+                success = false;
+            }
+        }
+    }
+    return success;
+}
