From 2ce27a06dedfcf4e7cedbb9ebdd9d103e4f59308 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 11 Feb 2026 09:35:45 +0530
Subject: [PATCH] update ap_mld_mac as parent bssid for mlo clients

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../fronthaul_manager/ap_manager/ap_manager.cpp      | 12 +++++++++++-
 common/beerocks/bcl/include/bcl/beerocks_defines.h   |  2 +-
 common/beerocks/bwl/shared/nl80211_client_impl.cpp   |  1 +
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index c5fae73f3..a80688db6 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2569,7 +2569,17 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
 
         notification->mac()          = msg->params.mac;
         notification->vap_id()       = msg->params.vap_id;
-        notification->bssid()        = tlvf::mac_from_string(vap_node->second.mac);
+
+        LOG(DEBUG) << "BSSID: " << vap_node->second.mac << " AP_MLD_MAC: " << vap_node->second.ap_mld_mac;
+  
+        if (!vap_node->second.ap_mld_mac.empty()) {
+            LOG(DEBUG) << "AP_MLD_MAC is not empty - use ap_mld_mac as parent bssid";
+            notification->bssid()        = tlvf::mac_from_string(vap_node->second.ap_mld_mac);
+        } else {
+            LOG(DEBUG) << "AP_MLD_MAC is empty - use ap_mac as parent bssid";
+            notification->bssid()        = tlvf::mac_from_string(vap_node->second.mac);
+        }
+ 
         notification->capabilities() = msg->params.capabilities;
         if (msg->params.association_frame_length == 0) {
             LOG(DEBUG) << "no association frame";
diff --git a/common/beerocks/bcl/include/bcl/beerocks_defines.h b/common/beerocks/bcl/include/bcl/beerocks_defines.h
index d3b4f1b86..6b6b2c92a 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_defines.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_defines.h
@@ -52,7 +52,7 @@ constexpr char CONF_FILES_WRITABLE_PATH[] = "./";
 #define RADIOIDX_2G 0
 #define RADIOIDX_5G 1
 #define RADIOIDX_6G 2
-
+#define RADIOIDX_5GH 3
 namespace beerocks {
 namespace ieee1905_1_consts {
 static constexpr int DISCOVERY_NOTIFICATION_TIMEOUT_SEC = 60;
diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index a0d9314c1..deb9e8b10 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -158,6 +158,7 @@ bool nl80211_client_impl::get_iface_with_link_idx(const std::string &iface_rad_i
                             case RADIOIDX_2G: match = (freq >= 2400 && freq <= 2500); break;
                             case RADIOIDX_5G: match = (freq >= 4900 && freq <= 5900); break;
                             case RADIOIDX_6G: match = (freq >= 5925 && freq <= 7125); break;
+                            case RADIOIDX_5GH: match = (freq >= 5490 && freq <= 5835); break;
                             default: LOG(ERROR) << "Invalid radio_type"; break;
                     }
 
-- 
2.34.1

