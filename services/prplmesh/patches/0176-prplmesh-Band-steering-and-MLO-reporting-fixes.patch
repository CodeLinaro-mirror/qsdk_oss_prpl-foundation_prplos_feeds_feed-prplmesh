+void db::dm_fire_steer_summary_stats_event(const Station &station)
+{
+    if (station.dm_path.empty()) {
+        return;
+    }
+
+    const auto &s = station.steering_summary_stats;
+
+    /*
+     * Fire QCOM_Vendor.SteeringSummaryStatsUpdated vendor event.
+     *
+     * External strategy applications (e.g. qmesh-steering-app) subscribe to this
+     * event and use the delta in BTMSuccesses / BTMFailures to determine the steer
+     * outcome without polling the DM:
+     *   - BTMSuccesses increased → steer accepted + STA roamed → cancel BTM timer
+     *   - BTMFailures  increased → steer rejected → reprogram BTM timer to eBTMAssociationTime
+     *
+     * Fields carried in the event:
+     *   MACAddress    — STA MAC (used as the primary key by the steering app)
+     *   BTMAttempts   — cumulative BTM requests sent to this STA
+     *   BTMSuccesses  — cumulative successful steers (STA roamed to target)
+     *   BTMFailures   — cumulative failed steers (STA rejected or timed out)
+     *   LastSteerTime — Unix timestamp of the last steering attempt
+     */
+    /*
+     * Fire QCOM_Vendor.SteeringSummaryStatsUpdated vendor event using
+     * trigger_event_with_data() — same mechanism as all other vendor events.
+     * The qmesh-lib subscribes to this event path and delivers
+     * QMESH_EVENT_STEERING_SUMMARY_STATS_UPDATED to the steering app.
+     */
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.SteeringSummaryStatsUpdated";
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    const std::string mac_str = tlvf::mac_to_string(station.mac);
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress",    mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",        station.dm_path.c_str());
+    amxc_var_add_key(uint64_t,  &event_data, "BTMAttempts",   s.btm_attempts);
+    amxc_var_add_key(uint64_t,  &event_data, "BTMSuccesses",  s.btm_successes);
+    amxc_var_add_key(uint64_t,  &event_data, "BTMFailures",   s.btm_failures);
+    amxc_var_add_key(uint32_t,  &event_data, "LastSteerTime", s.last_steer_time);
+
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
+
+    if (ok) {
+        LOG(DEBUG) << "dm_fire_steer_summary_stats_event: STA=" << station.mac
+                   << " attempts=" << s.btm_attempts
+                   << " successes=" << s.btm_successes
+                   << " failures=" << s.btm_failures;
+    } else {
+        LOG(WARNING) << "dm_fire_steer_summary_stats_event: trigger_event_with_data failed for STA="
+                     << station.mac;
+    }
+}
