From e54daea72b2ded0f06d5f0c4edca1f3b2ed90e65 Mon Sep 17 00:00:00 2001
From: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
Date: Sat, 29 Aug 2026 17:25:36 +0530
Subject: [PATCH] AWGN channel change reason code & DM simulation fix

Signed-off-by: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 23 ++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 463f39ae0..07526eb82 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -1246,10 +1246,27 @@ bool ap_wlan_hal_whm::simulate_awgn()
     // On WHM, the equivalent ubus-cli command is:
     //   ubus-cli "WiFi.AccessPoint.{X}.DCS.Simulation(type=4)"
 
-    std::string ap_path = wbapi_utils::search_path_ap_by_iface(m_radio_info.iface_name);
+    // WiFi.AccessPoint.{X} instances are keyed by the VAP/BSS Alias, not the radio's own
+    // iface_name. Resolve the first active fronthaul VAP for this radio (same pattern as
+    // start_wps_pbc()).
+    std::string main_vap_ifname;
+    for (const auto &vap_kv : m_radio_info.available_vaps) {
+        if (!vap_kv.second.bss.empty() && vap_kv.second.fronthaul) {
+            main_vap_ifname = vap_kv.second.bss;
+            break;
+        }
+    }
+
+    if (main_vap_ifname.empty()) {
+        LOG(ERROR) << "simulate_awgn: no fronthaul VAP found in available_vaps for radio "
+                   << m_radio_info.iface_name;
+        return false;
+    }
+
+    std::string ap_path = wbapi_utils::search_path_ap_by_iface(main_vap_ifname);
     if (ap_path.empty()) {
         LOG(ERROR) << "simulate_awgn: failed to resolve AccessPoint path for iface "
-                   << m_radio_info.iface_name;
+                   << main_vap_ifname;
         return false;
     }
 
@@ -1913,7 +1930,7 @@ bool ap_wlan_hal_whm::process_radio_channel_change_event(const AmbiorixVariant *
         else if (chan_change_reason == "EP_MOVE") {
             LOG(INFO) << "Channel change event received due to backhaul STA endpoint move";
             m_radio_info.last_csa_sw_reason = ChanSwReason::Unknown;
-        } else if ( chan_change_reason == "INITIAL" ) {
+        } else if ( chan_change_reason == "AWGN" ) {
             LOG(INFO) << "Channel change event received due to AWGN";
             m_radio_info.last_csa_sw_reason = ChanSwReason::Unknown;
         }
-- 
