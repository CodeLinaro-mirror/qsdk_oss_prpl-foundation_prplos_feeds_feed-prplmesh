 bool base_wlan_hal_nl80211::wpa_ctrl_send_msg(const std::string &cmd, char **reply,
                                               const std::string &ifname)
 {
-    if (!reply || !(*reply)) {
+    if (!reply) {
         LOG(ERROR) << "Invalid reply pointer!";
         return false;
     }
