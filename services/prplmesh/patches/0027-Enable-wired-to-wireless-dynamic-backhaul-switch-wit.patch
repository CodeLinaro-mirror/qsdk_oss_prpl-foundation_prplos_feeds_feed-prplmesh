From 027c087df4860151b2b4b72964eed46d7eb754d8 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:23:47 +0530
Subject: [PATCH 27/31] Enable wired to wireless dynamic backhaul switch with
 sta iface

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     | 65 +++++++++++++++++++
 .../slave/backhaul_manager/backhaul_manager.h |  2 +
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 31 +++++++--
 .../bwl/nl80211/base_wlan_hal_nl80211.cpp     | 29 ++++++++-
 4 files changed, 122 insertions(+), 5 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 0c3e3997f..ef62edbf0 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -101,6 +101,10 @@ BackhaulManager::BackhaulManager(const config_file::sConfigSlave &config,
       slave_sta_ifaces(slave_sta_ifaces_), m_beerocks_temp_path(config.temp_path),
       m_ucc_listener_port(string_utils::stoi(config.ucc_listener_port))
 {
+
+    for (const auto& iface : slave_sta_ifaces) {
+        LOG(DEBUG) << " BH_MNGR-STA_IFACE: " << iface;
+    }
     configuration_stop_on_failure_attempts = stop_on_failure_attempts_;
     stop_on_failure_attempts               = stop_on_failure_attempts_;
     LOG(DEBUG) << "stop_on_failure_attempts=" << stop_on_failure_attempts;
@@ -832,6 +836,10 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
         if (db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless) {
             FSM_MOVE_STATE(INIT_HAL);
         } else { // EType::Wired
+
+            if (!db->device_conf.local_gw && !m_backhaul_switch) {
+                create_sta_hal_for_bh_switching();
+            }
             FSM_MOVE_STATE(CONNECTED);
         }
 
@@ -854,6 +862,22 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)
             }
         }
 
+        if ((!db->device_conf.local_gw) && wired_backhaul && !m_backhaul_switch) {
+            for (auto &radio_info : m_radios_info) {
+                auto radio = db->radio(radio_info->sta_iface);
+                if (!radio) {
+                    continue;
+                }
+                if (radio_info->sta_wlan_hal) {
+                    // Disconnect Backhaul sta connection
+                    radio_info->sta_wlan_hal->disconnect_backhaul_sta();
+
+                    // Enable all AP VAPS in the radio
+                    send_slaves_enable();
+                }
+            }
+        }
+
         handle_backhaul_connect();
         stop_on_failure_attempts = configuration_stop_on_failure_attempts;
 
@@ -3477,4 +3501,45 @@ void BackhaulManager::clear_radio_handlers(
         radio_info->sta_hal_int_events = beerocks::net::FileDescriptor::invalid_descriptor;
     }
 }
+
+void BackhaulManager::create_sta_hal_for_bh_switching()
+{
+    auto db = AgentDB::get();
+
+    for (auto &radio_info : m_radios_info) {
+        std::string iface = radio_info->sta_iface;
+        if (radio_info->sta_iface.empty())
+            continue;
+
+        LOG(DEBUG) << FSM_CURR_STATE_STR << " iface: " << radio_info->sta_iface;
+
+        // Create a HAL instance if doesn't exists
+        if (!radio_info->sta_wlan_hal) {
+
+            bwl::hal_conf_t hal_conf;
+
+            if (!beerocks::bpl::bpl_cfg_get_wpa_supplicant_ctrl_path(radio_info->sta_iface,
+                                                                     hal_conf.wpa_ctrl_path)) {
+                LOG(ERROR) << "Couldn't get hostapd control path";
+            }
+
+            if (beerocks::bpl::cfg_get_management_mode() == BPL_MGMT_MODE_MULTIAP_AGENT) {
+                hal_conf.is_repeater = true;
+            }
+
+            using namespace std::placeholders; // for `_1`
+            radio_info->sta_wlan_hal = bwl::sta_wlan_hal_create(
+                radio_info->sta_iface,
+                std::bind(&BackhaulManager::hal_event_handler, this, _1, radio_info->sta_iface),
+                hal_conf);
+            LOG_IF(!radio_info->sta_wlan_hal, FATAL) << "Failed creating HAL instance!";
+        } else {
+            LOG(DEBUG) << "STA HAL exists...";
+        }
+
+        // Attach in BLOCKING mode
+        auto attach_state = radio_info->sta_wlan_hal->attach(true);
+        LOG(DEBUG) << "attach_state: " <<attach_state;
+    }
+}
 } // namespace beerocks
diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h
index 9e0192edc..2bab5046b 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.h
@@ -652,6 +652,8 @@ private:
     std::string m_selected_backhaul;
 
     bool m_remove_platform_manager_client = false;
+
+    void create_sta_hal_for_bh_switching();
 };
 
 } // namespace beerocks
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 4c7002475..a301f404a 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -551,6 +551,21 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
 
     nl80211_client::radio_info radio_info;
     nl80211_client::eht_info eht_info;
+
+    if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_UNKNOWN) {
+
+        std::string base_interface="";
+        extractLinkBaseInterface(m_radio_info.iface_name, base_interface);
+
+        if (!beerocks::net::network_utils::linux_iface_is_up_and_running(base_interface)) {
+            LOG(ERROR) << "iface " << base_interface << " is not in up state, trigger reload";
+            if (!wpa_ctrl_send_msg("RELOAD")) {
+                LOG(ERROR) << "RELOAD command to hostapd failed";
+            }
+        } else {
+            LOG(DEBUG) << "iface " << base_interface << " is in up state, skip reload";
+        }
+    }
     if (!m_nl80211_client->get_radio_info(get_iface_name(), radio_info)) {
 
         LOG(ERROR) << "Unable to read radio info for interface " << m_radio_info.iface_name;
@@ -2617,11 +2632,19 @@ void ap_wlan_hal_nl80211::generate_new_bssid(uint16_t new_vap_index,sMacAddr &ne
 bool ap_wlan_hal_nl80211::reload_all_ap_vaps()
 {
     LOG(TRACE) << __func__;
-    if (!wpa_ctrl_send_msg("RELOAD")) {
-        LOG(ERROR) << "RELOAD command to hostapd failed";
-        return false;
-    }
 
+    std::string base_interface="";
+    extractLinkBaseInterface(m_radio_info.iface_name, base_interface);
+
+    if (!beerocks::net::network_utils::linux_iface_is_up_and_running(base_interface)) {
+        LOG(ERROR) << "iface " << base_interface << " is not in up state, trigger reload";
+        if (!wpa_ctrl_send_msg("RELOAD")) {
+            LOG(ERROR) << "RELOAD command to hostapd failed";
+            return false;
+        }
+    } else {
+        LOG(DEBUG) << "iface " << base_interface << " is in up state, skip reload";
+    }
     return true;
 }
 
diff --git a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
index 1cb4fbc1f..27a028d92 100644
--- a/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/base_wlan_hal_nl80211.cpp
@@ -864,9 +864,16 @@ bool base_wlan_hal_nl80211::refresh_vaps_info(int id)
         vap_element.mac  = reply["bssid[" + std::to_string(vap_id) + "]"];
         vap_element.ssid = reply["ssid[" + std::to_string(vap_id) + "]"];
 
+        std::string mld_mac_key = "mld_addr[" + std::to_string(vap_id) + "]";
+        
+        auto it = reply.find(mld_mac_key);
+        if (it != reply.end()) {
+            vap_element.ap_mld_mac = it->second;
+        }
+
         // Store the VAP element
         LOG(DEBUG) << "Detected VAP ID (" << vap_id << ") - MAC: " << vap_element.mac
-                   << ", SSID: " << vap_element.ssid << ", BSS: " << vap_element.bss;
+                   << ", SSID: " << vap_element.ssid << ", BSS: " << vap_element.bss << ", AP_MLD_MAC: " << vap_element.ap_mld_mac;
 
         // Since some of the required information is not exist on the "STATUS" command reply, it
         // was pre-inserted when configured the BSSs. Therefore, not overriding the whole struct at
@@ -1208,6 +1215,26 @@ bool base_wlan_hal_nl80211::register_wpa_ctrl_interface(const std::string &inter
         return false;
     }
 
+    bool exists = false;
+    if (interface != global_iface) { 
+        if (m_radio_info.active_BSSs.empty()) {
+            m_radio_info.active_BSSs.push_back(interface);
+            LOG(DEBUG) << "Active BSSs is empty : added  " << interface;
+        } else {
+            for (const auto& existing_bss : m_radio_info.active_BSSs) {
+                if (existing_bss == interface) {
+                    LOG(DEBUG) << "Interface " << interface << " is already there in Active_BSSs ";
+                    exists = true;
+                    break;
+                }
+            }
+            if (!exists) {
+                m_radio_info.active_BSSs.push_back(interface);
+                LOG(DEBUG) << "Interface " << interface << " is newly added in Active_BSSs ";
+            }
+        }
+    }
+
     return true;
 }
 
