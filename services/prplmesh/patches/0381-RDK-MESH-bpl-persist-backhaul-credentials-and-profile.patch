+static cJSON *load_config_json();
 
 void set_ambiorix_impl_ptr(const std::shared_ptr<beerocks::nbapi::Ambiorix> &ptr)
 {
@@ -175,7 +178,19 @@ int cfg_is_non_prplmesh_controller()
 
 bool bpl_cfg_get_agent_multi_ap_profile(uint32_t &profile)
 {
-    profile = 2; // Default to profile 2
+    // Profile must be 3 (Multi-AP Profile 3) for AP Metrics and Target Data (td)
+    // functions to work correctly. Profiles 1 and 2 do not support the extended
+    // AP metrics TLVs required by those features.
+    profile = 3;
+    cJSON *root = load_config_json();
+    if (root) {
+        cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+        cJSON *val        = config_obj ? cJSON_GetObjectItem(config_obj, "multi_ap_profile") : nullptr;
+        if (val && cJSON_IsNumber(val)) {
+            profile = static_cast<uint32_t>(val->valueint);
+        }
+        cJSON_Delete(root);
+    }
     return true;
 }
 
@@ -437,6 +452,29 @@ int cfg_get_backhaul_vaps(char *backhaul_vaps_buf, const int buf_len)
 int cfg_get_beerocks_credentials(const int radio_dir, char ssid[BPL_SSID_LEN],
                                  char pass[BPL_PASS_LEN], char sec[BPL_SEC_LEN])
 {
+    if (radio_dir != BPL_RADIO_BACK) return 0;
+
+    cJSON *root = load_config_json();
+    if (!root) return -1;
+
+    cJSON *cfg = cJSON_GetObjectItem(root, "config");
+    if (!cfg) { cJSON_Delete(root); return -1; }
+
+    cJSON *j_ssid = cJSON_GetObjectItem(cfg, "ssid");
+    cJSON *j_pass = cJSON_GetObjectItem(cfg, "key_passphrase");
+    cJSON *j_mode = cJSON_GetObjectItem(cfg, "mode_enabled");
+
+    const char *ssid_val = (j_ssid && cJSON_IsString(j_ssid)) ? cJSON_GetStringValue(j_ssid) : nullptr;
+    if (!ssid_val || !ssid_val[0]) { cJSON_Delete(root); return -1; }
+
+    snprintf(ssid, BPL_SSID_LEN, "%s", ssid_val);
+    if (j_pass && cJSON_IsString(j_pass))
+        snprintf(pass, BPL_PASS_LEN, "%s", cJSON_GetStringValue(j_pass));
+    snprintf(sec, BPL_SEC_LEN, "%s",
+             (j_mode && cJSON_IsString(j_mode)) ? cJSON_GetStringValue(j_mode) : "WPA2-Personal");
+
+    cJSON_Delete(root);
+    LOG(INFO) << "cfg_get_beerocks_credentials: ssid='" << ssid << "'";
     return 0;
 }
 
