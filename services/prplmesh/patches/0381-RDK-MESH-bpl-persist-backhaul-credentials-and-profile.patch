 int cfg_get_sta_iface(const char iface[BPL_IFNAME_LEN], char sta_iface[BPL_IFNAME_LEN])
 {
-    (void)iface;
-    if (sta_iface) {
-        sta_iface[0] = '\0';
+    if (!sta_iface) return -1;
+    sta_iface[0] = '\0';
+
+    if (!iface || iface[0] == '\0') return -1;
+
+    cJSON *root = load_config_json();
+    if (!root) return -1;
+
+    for (int radio_idx = 0; radio_idx < BPL_MAX_RADIOS_SUPPORTED; radio_idx++) {
+        char radio_key[BPL_RADIO_KEY_BUF_LEN];
+        snprintf(radio_key, sizeof(radio_key), "radio%d", radio_idx);
+        cJSON *radio_obj = cJSON_GetObjectItem(root, radio_key);
+        if (!radio_obj) continue;
+        cJSON *hostap_obj = cJSON_GetObjectItem(radio_obj, "hostap_iface");
+        if (!hostap_obj || !cJSON_IsString(hostap_obj)) continue;
+        const char *hostap_str = cJSON_GetStringValue(hostap_obj);
+        if (!hostap_str || strcmp(hostap_str, iface) != 0) continue;
+        cJSON *sta_obj = cJSON_GetObjectItem(radio_obj, "sta_iface");
+        if (!sta_obj || !cJSON_IsString(sta_obj)) { cJSON_Delete(root); return -1; }
+        const char *sta_str = cJSON_GetStringValue(sta_obj);
+        if (!sta_str || strlen(sta_str) == 0) { cJSON_Delete(root); return -1; }
+        strlcpy(sta_iface, sta_str, BPL_IFNAME_LEN);
+        LOG(INFO) << "cfg_get_sta_iface: " << iface << " -> " << sta_iface;
+        cJSON_Delete(root);
+        return 0;
     }
-    return 0;
+
+    cJSON_Delete(root);
+    return -1;
 }
 
