@@ -859,10 +921,90 @@ bool bpl_cfg_get_wireless_settings(std::list<son::wireless_utils::sBssInfoConf>
     return true;
 }
 
+// Read qmesh.json into a cJSON root (caller must cJSON_Delete). Returns nullptr on failure.
+static cJSON *load_config_json()
+{
+    std::lock_guard<std::mutex> lock(s_config_file_mutex);
+    if (!config_file_path) return nullptr;
+    std::ifstream f(config_file_path);
+    if (!f.is_open()) return nullptr;
+    std::string s((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    f.close();
+    return cJSON_Parse(s.c_str());
+}
+
+// Write a cJSON root back to qmesh.json. Returns false on failure.
+static bool save_config_json(cJSON *root)
+{
+    std::lock_guard<std::mutex> lock(s_config_file_mutex);
+    if (!config_file_path || !root) return false;
+    char *str = cJSON_Print(root);
+    if (!str) return false;
+    std::string tmp_path = std::string(config_file_path) + ".tmp";
+    std::ofstream f(tmp_path, std::ios::trunc);
+    bool ok = f.is_open();
+    if (ok) { f << str; f.close(); ok = (std::rename(tmp_path.c_str(), config_file_path) == 0); }
+    free(str);
+    return ok;
+}
+
+// Map mode_enabled string -> WSC auth + encr
+static void map_mode_to_wsc(const char *mode,
+                             WSC::eWscAuth &auth, WSC::eWscEncr &encr)
+{
+    if (!mode) { auth = WSC::eWscAuth::WSC_AUTH_WPA2PSK; encr = WSC::eWscEncr::WSC_ENCR_AES; return; }
+    if (strcmp(mode, "WPA3-Personal") == 0 || strcmp(mode, "SAE") == 0) {
+        auth = WSC::eWscAuth::WSC_AUTH_SAE;         encr = WSC::eWscEncr::WSC_ENCR_AES;
+    } else if (strcmp(mode, "WPA3-Personal-Transition") == 0) {
+        auth = static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_WPA2PSK | WSC::eWscAuth::WSC_AUTH_SAE);
+        encr = WSC::eWscEncr::WSC_ENCR_AES;
+    } else if (strcmp(mode, "WPA-Personal") == 0 || strcmp(mode, "WPAPSK") == 0) {
+        auth = WSC::eWscAuth::WSC_AUTH_WPAPSK;      encr = WSC::eWscEncr::WSC_ENCR_TKIP;
+    } else {
+        LOG(WARNING) << "map_mode_to_wsc: unknown mode='" << (mode ? mode : "null")
+                     << "', defaulting to WPA2-Personal";
+        auth = WSC::eWscAuth::WSC_AUTH_WPA2PSK;     encr = WSC::eWscEncr::WSC_ENCR_AES;
+    }
+}
+
+// Map WSC auth -> mode_enabled string (inverse of map_mode_to_wsc)
+static const char *wsc_auth_to_mode(WSC::eWscAuth auth)
+{
+    const bool has_sae = (auth & WSC::eWscAuth::WSC_AUTH_SAE) ||
+                         (auth & WSC::eWscAuth::WSC_AUTH_SAE_AKM24);
+    if (has_sae && (auth & WSC::eWscAuth::WSC_AUTH_WPA2PSK))
+        return "WPA3-Personal-Transition";
+    if (has_sae)
+        return "WPA3-Personal";
+    if (auth & WSC::eWscAuth::WSC_AUTH_WPAPSK)
+        return "WPA-Personal";
+    return "WPA2-Personal";
+}
+
 bool bpl_cfg_get_wifi_credentials(const std::string &iface,
                                   son::wireless_utils::sBssInfoConf &configuration)
 {
-    return true;
+    cJSON *root = load_config_json();
+    if (!root) return false;
+
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (!config_obj) { cJSON_Delete(root); return false; }
+
+    cJSON *ssid_obj = cJSON_GetObjectItem(config_obj, "ssid");
+    cJSON *key_obj  = cJSON_GetObjectItem(config_obj, "key_passphrase");
+    cJSON *mode_obj = cJSON_GetObjectItem(config_obj, "mode_enabled");
+
+    if (ssid_obj && cJSON_IsString(ssid_obj))
+        configuration.ssid = cJSON_GetStringValue(ssid_obj);
+    if (key_obj && cJSON_IsString(key_obj))
+        configuration.network_key = cJSON_GetStringValue(key_obj);
+    if (mode_obj && cJSON_IsString(mode_obj))
+        map_mode_to_wsc(cJSON_GetStringValue(mode_obj),
+                        configuration.authentication_type, configuration.encryption_type);
+
+    cJSON_Delete(root);
+    LOG(INFO) << "bpl_cfg_get_wifi_credentials: ssid='" << configuration.ssid << "' iface=" << iface;
+    return !configuration.ssid.empty();
 }
 
 bool cfg_get_link_metrics_request_interval(std::chrono::seconds &link_metrics_request_interval_sec)
@@ -910,9 +1052,29 @@ bool bpl_cfg_set_sta_vap_bh_credentials(const std::string &iface,
                                         const std::string &radio_band)
 {
     (void)iface;
-    (void)configuration;
     (void)radio_band;
-    return true;
+    cJSON *root = load_config_json();
+    if (!root) return false;
+
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (!config_obj) { cJSON_Delete(root); return false; }
+
+    // Update ssid, key_passphrase, mode_enabled in the config block
+    cJSON_DeleteItemFromObject(config_obj, "ssid");
+    cJSON_AddStringToObject(config_obj, "ssid", configuration.ssid.c_str());
+
+    cJSON_DeleteItemFromObject(config_obj, "key_passphrase");
+    cJSON_AddStringToObject(config_obj, "key_passphrase", configuration.network_key.c_str());
+
+    cJSON_DeleteItemFromObject(config_obj, "mode_enabled");
+    cJSON_AddStringToObject(config_obj, "mode_enabled",
+                            wsc_auth_to_mode(configuration.authentication_type));
+
+    bool ok = save_config_json(root);
+    cJSON_Delete(root);
+    LOG(INFO) << "bpl_cfg_set_sta_vap_bh_credentials: updated qmesh.json ssid='"
+              << configuration.ssid << "' result=" << ok;
+    return ok;
 }
 
 eBstaSupplicantRestartStatus bpl_cfg_update_bsta_mld_grp(const std::string &radio_band,
