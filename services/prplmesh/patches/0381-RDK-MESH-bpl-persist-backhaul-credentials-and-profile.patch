+#ifdef BEEROCKS_RDKB
+/**
+ * @brief Check if the gateway is reachable on a given interface using the
+ *        kernel neighbour table (`ip neigh show`) and bridge FDB (`bridge fdb show`).
+ *
+ * On RDKB, physical eth ports are bridge slaves with no IP address so arping
+ * fails. Instead: resolve the gateway MAC scoped to `iface` from the neighbour
+ * table, then confirm it appears in the bridge FDB for that port.
+ *
+ * @param [in] iface  Physical interface (bridge slave port) to check.
+ * @param [in] gw_ip  Gateway IPv4 address string.
+ * @return true if the gateway MAC is in the bridge FDB for iface, false otherwise.
+ */
+bool cfg_confirm_gateway_reachable(const std::string &iface, const std::string &gw_ip);
+#endif // BEEROCKS_RDKB
