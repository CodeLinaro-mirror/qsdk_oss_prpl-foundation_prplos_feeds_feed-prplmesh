     return true;
 }
 
+bool cfg_confirm_gateway_reachable(const std::string &iface, const std::string &gw_ip)
+{
+    // Reject shell metacharacters in caller-supplied strings before building popen commands.
+    // gw_ip comes from DHCP; iface comes from config — both are expected to be IPv4
+    // dotted-decimal and Linux interface names respectively. IPv6 is not supported here.
+    auto has_shell_metachar = [](const std::string &s) {
+        for (char c : s) {
+            if (!isalnum(static_cast<unsigned char>(c)) &&
+                c != '.' && c != ':' && c != '-' && c != '_')
+                return true;
+        }
+        return s.empty();
+    };
+    if (has_shell_metachar(gw_ip) || has_shell_metachar(iface)) {
+        LOG(ERROR) << "cfg_confirm_gateway_reachable: invalid characters in gw_ip='"
+                   << gw_ip << "' or iface='" << iface << "'";
+        return false;
+    }
+
+    // Step 1: resolve gateway MAC from kernel neighbour table via `ip neigh show`.
+    // Do NOT scope to `iface` — on RDKB the neighbour entry is learned on the bridge,
+    // not the physical slave port. Step 2 (bridge FDB) scopes the result to iface.
+    // Output: "<ip> dev <bridge> lladdr <mac> <state>"
+    FILE *fp = popen(("ip neigh show " + gw_ip + " 2>/dev/null").c_str(), "r");
+    std::string mac_str;
+    if (fp) {
+        char buf[256] = {};
+        while (fgets(buf, sizeof(buf), fp) != nullptr) {
+            std::string line(buf);
+            auto pos = line.find("lladdr ");
+            if (pos != std::string::npos) {
+                pos     += 7;
+                auto end = line.find(' ', pos);
+                mac_str  = line.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+                while (!mac_str.empty() && (mac_str.back() == '\n' || mac_str.back() == '\r'))
+                    mac_str.pop_back();
+                break;
+            }
+        }
+        pclose(fp);
+    } else {
+        LOG(ERROR) << "cfg_confirm_gateway_reachable: popen failed for ip neigh show";
+        return false;
+    }
+    if (mac_str.empty()) {
+        LOG(INFO) << "cfg_confirm_gateway_reachable: " << gw_ip << " not in neighbour table on " << iface;
+        return false;
+    }
+
+    // Step 2: confirm the gateway MAC appears in the bridge FDB for this port.
+    fp = popen(("bridge fdb show dev " + iface + " 2>/dev/null").c_str(), "r");
+    bool reachable = false;
+    if (fp) {
+        std::string mac_lower = mac_str;
+        for (char &c : mac_lower) c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
+        char buf[256] = {};
+        while (fgets(buf, sizeof(buf), fp) != nullptr) {
+            std::string line(buf);
+            for (char &c : line) c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
+            reachable = (line.find(mac_lower) != std::string::npos);
+            if (reachable) break;
+        }
+        pclose(fp);
+    } else {
+        LOG(ERROR) << "cfg_confirm_gateway_reachable: popen failed for bridge fdb show";
+        return false;
+    }
+
+    LOG(INFO) << "cfg_confirm_gateway_reachable: " << gw_ip << " (" << mac_str << ") "
+              << (reachable ? "" : "not ") << "reachable on " << iface;
+    return reachable;
+}
