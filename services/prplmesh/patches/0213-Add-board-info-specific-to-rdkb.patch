+
+#include <bpl/bpl_board.h>
+
+#include <cjson/cJSON.h>
+#include <fstream>
+#include <sstream>
+
+#define QMESH_JSON_PATH "/etc/config/qmesh.json"
+
+namespace beerocks {
+namespace bpl {
+
+/**
+ * @brief Read and parse qmesh.json file
+ * 
+ * @return cJSON* Parsed JSON object or nullptr on failure
+ */
+static cJSON *load_qmesh_json()
+{
+    std::ifstream file(QMESH_JSON_PATH);
+    if (!file.is_open()) {
+        return nullptr;
+    }
+
+    std::stringstream buffer;
+    buffer << file.rdbuf();
+    file.close();
+
+    std::string content = buffer.str();
+    if (content.empty()) {
+        return nullptr;
+    }
+
+    cJSON *json = cJSON_Parse(content.c_str());
+    return json;
+}
+
+/**
+ * @brief Get string value from JSON object
+ * 
+ * @param json JSON object
+ * @param section Section name
+ * @param key Key name
+ * @param default_value Default value if not found
+ * @return std::string Value from JSON or default value
+ */
+static std::string get_json_string(cJSON *json, const char *section, const char *key,
+                                    const std::string &default_value)
+{
+    if (!json) {
+        return default_value;
+    }
+
+    cJSON *section_obj = cJSON_GetObjectItemCaseSensitive(json, section);
+    if (!section_obj) {
+        return default_value;
+    }
+
+    cJSON *item = cJSON_GetObjectItemCaseSensitive(section_obj, key);
+    if (!item || !cJSON_IsString(item)) {
+        return default_value;
+    }
+
+    return std::string(item->valuestring);
+}
+
+bool get_board_info(sBoardInfo &board_info)
+{
+    // RDKB-specific implementation
+    // Try to read from qmesh.json first
+    cJSON *json = load_qmesh_json();
+
+    if (json) {
+        // Read board information from qmesh.json config section
+        board_info.manufacturer       = get_json_string(json, "config", "manufacturer", "");
+        board_info.manufacturer_model = get_json_string(json, "config", "model_name", "");
+        board_info.serial_number      = get_json_string(json, "config", "serial_number", "");
+        board_info.model_number       = get_json_string(json, "config", "model_number", "");
+
+        cJSON_Delete(json);
+
+        // If we got valid values from qmesh.json, return success
+        if (!board_info.manufacturer.empty() && !board_info.manufacturer_model.empty()) {
+            return true;
+        }
+    }
+
+    // Fallback: Set default values if qmesh.json is not available or incomplete
+    board_info.manufacturer       = "RDK";
+    board_info.manufacturer_model = "Linux";
+    
+    return true;
+}
+
+} // namespace bpl
+} // namespace beerocks
