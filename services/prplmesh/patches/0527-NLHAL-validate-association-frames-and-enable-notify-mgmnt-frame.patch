From ac4784029ef9e067c7788be35b7ff5337747ddf7 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Mon, 12 Oct 2026 09:39:48 +0530
Subject: [PATCH] NLHAL: validate association frames and enable management
 notifications

Validate cached association frame BSSIDs against the current VAP before
including them in connected-client events, preventing frames from other
VAPs from being attributed to the client.

Enable hostapd management frame notifications for standard and MLD VAP
configurations.

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 54 ++++++++++++-------
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     |  2 +
 2 files changed, 38 insertions(+), 18 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 76ab3bdf7..ecac79a72 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -8030,15 +8030,24 @@ bool ap_wlan_hal_nl80211::generate_connected_clients_events(
             } else {
                 // Add the latest association frame
                 // PPM-1718: parse the association frame and make sure it belongs to the right MAC address.
-                auto &frame_info  = it->second;
-                msg->params.bssid = frame_info->bssid;
-                auto &frame_body  = frame_info->data;
-                // Add the latest association frame
-                std::copy(frame_body.begin(), frame_body.end(), msg->params.association_frame);
-                msg->params.association_frame_length = frame_body.size();
-                assoc_frame_type                     = assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST;
-                if (frame_info->type == eManagementFrameType::REASSOCIATION_REQUEST) {
-                    assoc_frame_type = assoc_frame::AssocReqFrame::REASSOCIATION_REQUEST;
+                const std::string &cur_bss_mac = m_radio_info.available_vaps[vap.first].mac;
+                auto &frame_info               = it->second;
+                const std::string frame_bssid  = tlvf::mac_to_string(frame_info->bssid);
+                if (frame_bssid != cur_bss_mac) {
+                    LOG(WARNING) << "Ignoring assoc frame for STA " << client_mac
+                                 << ": frame BSSID=" << frame_bssid
+                                 << ", current VAP BSSID=" << cur_bss_mac;
+                    msg->params.association_frame_length = 0;
+                } else {
+                    msg->params.bssid = frame_info->bssid;
+                    auto &frame_body  = frame_info->data;
+                    // Add the latest association frame
+                    std::copy(frame_body.begin(), frame_body.end(), msg->params.association_frame);
+                    msg->params.association_frame_length = frame_body.size();
+                    assoc_frame_type                     = assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST;
+                    if (frame_info->type == eManagementFrameType::REASSOCIATION_REQUEST) {
+                        assoc_frame_type = assoc_frame::AssocReqFrame::REASSOCIATION_REQUEST;
+                    }
                 }
             }
 
@@ -8543,15 +8552,24 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         } else {
             // Add the latest association frame
             // PPM-1718: parse the association frame and make sure it belongs to the right MAC address.
-            auto &frame_info  = it_sta->second;
-            msg->params.bssid = frame_info->bssid;
-            auto &frame_body  = frame_info->data;
-            // Add the latest association frame
-            std::copy(frame_body.begin(), frame_body.end(), msg->params.association_frame);
-            msg->params.association_frame_length = frame_body.size();
-            assoc_frame_type                     = assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST;
-            if (frame_info->type == eManagementFrameType::REASSOCIATION_REQUEST) {
-                assoc_frame_type = assoc_frame::AssocReqFrame::REASSOCIATION_REQUEST;
+            const std::string &cur_bss_mac = m_radio_info.available_vaps[vap_id].mac;
+            auto &frame_info               = it_sta->second;
+            const std::string frame_bssid  = tlvf::mac_to_string(frame_info->bssid);
+            if (frame_bssid != cur_bss_mac) {
+                LOG(WARNING) << "Ignoring assoc frame for STA " << src_mac
+                             << ": frame BSSID=" << frame_bssid
+                             << ", current VAP BSSID=" << cur_bss_mac;
+                msg->params.association_frame_length = 0;
+            } else {
+                msg->params.bssid = frame_info->bssid;
+                auto &frame_body  = frame_info->data;
+                // Add the latest association frame
+                std::copy(frame_body.begin(), frame_body.end(), msg->params.association_frame);
+                msg->params.association_frame_length = frame_body.size();
+                assoc_frame_type                     = assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST;
+                if (frame_info->type == eManagementFrameType::REASSOCIATION_REQUEST) {
+                    assoc_frame_type = assoc_frame::AssocReqFrame::REASSOCIATION_REQUEST;
+                }
             }
         }
 
diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 44576cec7..7c5127872 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -1481,6 +1481,7 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 
             // Enable hostapd reporting of connection failures.
             options["report_connection_failures"] = "1";
+            options["notify_mgmt_frames"]          = "1";
 
 
             // Set hidden option based on hidden_ssid from BSS Advanced Configuration TLV
@@ -1823,6 +1824,7 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 
             // Enable hostapd reporting of connection failures (MLD path).
             options["report_connection_failures"] = "1";
+            options["notify_mgmt_frames"]          = "1";
 
             // Persist SSID advertisement state in UCI.
             // hidden_ssid ENABLED  -> option hidden 1 (SSID not advertised)
-- 
2.34.1

