+
+#ifndef _ONEWIFI_DATA_MODEL_H_
+#define _ONEWIFI_DATA_MODEL_H_
+
+/**
+ * @file onewifi_data_model.h
+ * @brief Lightweight EasyMesh data model for prplMesh OneWifi HAL.
+ * The static accessor callbacks registered with webconfig_proto_easymesh_init()
+ * use this data model as the `data_model` pointer.
+ */
+
+#include <ccsp/bus_common.h>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include <mutex>
+
+extern "C" {
+#include "em_base.h"
+#include "webconfig_external_proto.h"
+#include "wifi_webconfig.h"
+}
+
+namespace bwl {
+namespace onewifi {
+
+// Maximum sizes matching unified-wifi-mesh limits
+static constexpr unsigned int ONEWIFI_DM_MAX_RADIOS    = EM_MAX_RADIO_PER_AGENT;
+static constexpr unsigned int ONEWIFI_DM_MAX_BSS       = EM_MAX_RADIO_PER_AGENT * EM_MAX_BSS_PER_RADIO;
+static constexpr unsigned int ONEWIFI_DM_MAX_OP_CLASS  = EM_MAX_OP_CLASS * EM_MAX_RADIO_PER_AGENT;
+static constexpr unsigned int ONEWIFI_DM_MAX_STA       = EM_MAX_STA_PER_AGENT;
+
+/**
+ * @brief Lightweight EasyMesh data model for prplMesh OneWifi HAL.
+ *
+ * Mirrors the dm_easy_mesh_t pattern from unified-wifi-mesh, providing
+ * the same static accessor callbacks that can be registered with
+ * webconfig_proto_easymesh_init().
+ */
+class onewifi_data_model_t {
+public:
+    // =========================================================================
+    // Data storage
+    // =========================================================================
+    em_device_info_t            m_device_info;
+    em_network_info_t           m_network_info;
+    em_ieee_1905_security_info_t m_security_info;
+
+    em_radio_info_t             m_radio[ONEWIFI_DM_MAX_RADIOS];
+    em_bss_info_t               m_bss[ONEWIFI_DM_MAX_BSS];
+    em_op_class_info_t          m_op_class[ONEWIFI_DM_MAX_OP_CLASS];
+
+    // STA maps (assoc, disassoc, consolidated) - keyed by MAC string
+    std::vector<em_sta_info_t>  m_assoc_sta;
+    std::vector<em_sta_info_t>  m_disassoc_sta;
+    std::vector<em_sta_info_t>  m_consolidated_sta;
+
+    // AP MLD info
+    std::vector<em_ap_mld_info_t>   m_ap_mld;
+    std::vector<em_bsta_mld_info_t> m_bsta_mld;
+    std::vector<em_assoc_sta_mld_info_t> m_assoc_sta_mld;
+
+    // Channel scan results (populated by put_scan_results callback during decode)
+    std::vector<em_scan_result_t>   m_scan_results;
+
+    // Counters
+    unsigned int m_num_radios   = 0;
+    unsigned int m_num_bss      = 0;
+    unsigned int m_num_op_class = 0;
+
+    // HAL capabilities from OneWifi (populated during DML decode)
+    // Contains wifi_radio_capabilities_t per radio with mode bitmask
+    wifi_hal_capability_t m_hal_cap = {};
+    bool m_hal_cap_valid = false;
+
+    // Radio capabilities from OneWifi (populated during DML decode)
+    // Contains HT/VHT/HE/WiFi6/WiFi7 capabilities per radio
+    em_radio_cap_info_t m_radio_cap[ONEWIFI_DM_MAX_RADIOS];
+
+    // Association status info (for BTM responses and assoc state changes)
+    struct AssocStatusInfo {
+        bool is_btm_response = false;
+        bool is_assoc_change = false;
+        bool is_associated = false;
+        std::string target_bssid;
+        std::string bssid;
+        uint8_t btm_status_code = 0;
+        uint8_t dialog_token = 0;
+        uint16_t reason_code = 0;
+    };
+    std::unordered_map<std::string, AssocStatusInfo> assoc_status;
+
+    // Scan results info (for channel scan reports)
+    struct ScanResultInfo {
+        uint8_t channel = 0;
+        uint8_t utilization = 0;
+        int8_t noise = 0;
+        int8_t signal_strength = 0;
+        std::string bssid;
+        std::string ssid;
+    };
+    std::unordered_map<std::string, ScanResultInfo> scan_results;
+
+    // Beacon report info (for RRM beacon reports)
+    struct BeaconReportInfo {
+        std::string sta_mac;
+        std::string bssid;
+        uint8_t channel = 0;
+        uint8_t op_class = 0;
+        uint8_t rcpi = 0;
+        uint8_t rsni = 0;
+        uint16_t duration = 0;
+        uint8_t dialog_token = 0;
+        uint8_t rep_mode = 0;
+    };
+    std::unordered_map<std::string, BeaconReportInfo> beacon_reports;
+
+    // VapName to InterfaceName mapping (from OneWifi WiFiVapCap configuration)
+    // Key: VapName (e.g., "private_ssid_2g"), Value: InterfaceName (e.g., "wlan0")
+    // IMPORTANT: This map is accessed from multiple threads (AP HAL writes, Monitor HAL reads)
+    // Use the thread-safe accessor methods below instead of direct access.
+    std::unordered_map<std::string, std::string> vap_name_to_interface;
+
+    // =========================================================================
+    // Constructor / init
+    // =========================================================================
+    onewifi_data_model_t()
+    {
+        memset(&m_device_info, 0, sizeof(m_device_info));
+        memset(&m_network_info, 0, sizeof(m_network_info));
+        memset(&m_security_info, 0, sizeof(m_security_info));
+        memset(m_radio, 0, sizeof(m_radio));
+        memset(m_bss, 0, sizeof(m_bss));
+        memset(m_op_class, 0, sizeof(m_op_class));
+        memset(m_radio_cap, 0, sizeof(m_radio_cap));
+    }
+
+    void reset()
+    {
+        memset(&m_device_info, 0, sizeof(m_device_info));
+        memset(&m_network_info, 0, sizeof(m_network_info));
+        memset(&m_security_info, 0, sizeof(m_security_info));
+        memset(m_radio, 0, sizeof(m_radio));
+        memset(m_bss, 0, sizeof(m_bss));
+        memset(m_op_class, 0, sizeof(m_op_class));
+        memset(m_radio_cap, 0, sizeof(m_radio_cap));
+        m_assoc_sta.clear();
+        m_disassoc_sta.clear();
+        m_consolidated_sta.clear();
+        m_ap_mld.clear();
+        m_bsta_mld.clear();
+        m_assoc_sta_mld.clear();
+        m_scan_results.clear();
+        m_num_radios   = 0;
+        m_num_bss      = 0;
+        m_num_op_class = 0;
+        // Note: m_hal_cap is NOT reset here - it persists across encode/decode cycles
+    }
+
+    // =========================================================================
+    // Instance accessors
+    // =========================================================================
+    em_device_info_t *get_device_info() { return &m_device_info; }
+    em_network_info_t *get_network_info() { return &m_network_info; }
+    em_ieee_1905_security_info_t *get_ieee_1905_security_info() { return &m_security_info; }
+
+    unsigned int get_num_radios() const { return m_num_radios; }
+    void set_num_radios(unsigned int n) { m_num_radios = (n < ONEWIFI_DM_MAX_RADIOS) ? n : ONEWIFI_DM_MAX_RADIOS; }
+
+    unsigned int get_num_op_class() const { return m_num_op_class; }
+    void set_num_op_class(unsigned int n) { m_num_op_class = (n < ONEWIFI_DM_MAX_OP_CLASS) ? n : ONEWIFI_DM_MAX_OP_CLASS; }
+
+    unsigned int get_num_bss() const { return m_num_bss; }
+    void set_num_bss(unsigned int n) { m_num_bss = (n < ONEWIFI_DM_MAX_BSS) ? n : ONEWIFI_DM_MAX_BSS; }
+
+    em_radio_info_t *get_radio_info(unsigned int index)
+    {
+        if (index >= ONEWIFI_DM_MAX_RADIOS) return nullptr;
+        return &m_radio[index];
+    }
+
+    em_bss_info_t *get_bss_info(unsigned int index)
+    {
+        if (index >= ONEWIFI_DM_MAX_BSS) return nullptr;
+        return &m_bss[index];
+    }
+
+    em_op_class_info_t *get_op_class_info(unsigned int index)
+    {
+        if (index >= ONEWIFI_DM_MAX_OP_CLASS) return nullptr;
+        return &m_op_class[index];
+    }
+
+    em_bss_info_t *get_bss_info_with_mac(mac_address_t mac)
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        for (unsigned int i = 0; i < m_num_bss; i++) {
+            if (memcmp(m_bss[i].bssid.mac, mac, sizeof(mac_address_t)) == 0) {
+                return &m_bss[i];
+            }
+        }
+        return nullptr;
+    }
+
+    // WARNING: These iteration methods are NOT thread-safe when used in a loop.
+    // The returned pointer can become dangling if another thread modifies the vector
+    // (e.g., via put_sta_info) between get_first/get_next calls.
+    // Callers should ensure exclusive access during the entire iteration, or copy
+    // the data before iterating.
+    // TODO: Refactor to use index-based iteration or provide a thread-safe iterator API.
+    em_sta_info_t *get_first_sta_info(em_target_sta_map_t target)
+    {
+        // NOTE: No lock here - caller must ensure thread-safety for the entire iteration
+        auto &vec = get_sta_vec(target);
+        return vec.empty() ? nullptr : &vec[0];
+    }
+
+    em_sta_info_t *get_next_sta_info(em_sta_info_t *sta, em_target_sta_map_t target)
+    {
+        // NOTE: No lock here - caller must ensure thread-safety for the entire iteration
+        auto &vec = get_sta_vec(target);
+        for (size_t i = 0; i + 1 < vec.size(); i++) {
+            if (&vec[i] == sta) return &vec[i + 1];
+        }
+        return nullptr;
+    }
+
+    em_sta_info_t *get_sta_info(mac_address_t sta_mac, bssid_t bssid,
+                                mac_address_t radio_mac, em_target_sta_map_t target)
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        auto &vec = get_sta_vec(target);
+        for (auto &sta : vec) {
+            if (memcmp(sta.id, sta_mac, sizeof(mac_address_t)) == 0 &&
+                memcmp(sta.bssid, bssid, sizeof(mac_address_t)) == 0) {
+                return &sta;
+            }
+        }
+        return nullptr;
+    }
+
+    void put_sta_info(em_sta_info_t *info, em_target_sta_map_t target)
+    {
+        if (!info) return;
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+
+        // Remove from opposite list to prevent duplicates when adding to assoc/disassoc maps.
+        // When adding to assoc, remove from disassoc (and vice versa).
+        // When adding to consolidated map, no removal occurs (consolidated is independent).
+        if (target == em_target_sta_map_assoc || target == em_target_sta_map_disassoc) {
+            em_target_sta_map_t opposite_target = (target == em_target_sta_map_assoc) 
+                                                   ? em_target_sta_map_disassoc 
+                                                   : em_target_sta_map_assoc;
+            auto &opp_vec = get_sta_vec(opposite_target);
+            for (auto it = opp_vec.begin(); it != opp_vec.end(); ) {
+                if (memcmp(it->id, info->id, sizeof(mac_address_t)) == 0 &&
+                    memcmp(it->bssid, info->bssid, sizeof(mac_address_t)) == 0) {
+                    it = opp_vec.erase(it);
+                } else {
+                    ++it;
+                }
+            }
+        }
+
+        auto &vec = get_sta_vec(target);
+        // Update existing or append
+        for (auto &sta : vec) {
+            if (memcmp(sta.id, info->id, sizeof(mac_address_t)) == 0 &&
+                memcmp(sta.bssid, info->bssid, sizeof(mac_address_t)) == 0) {
+                sta = *info;
+                return;
+            }
+        }
+        vec.push_back(*info);
+    }
+
+    void put_scan_results(em_scan_result_t *scan_result)
+    {
+        if (!scan_result) return;
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        // Update existing entry (same op_class + channel) or append
+        for (auto &entry : m_scan_results) {
+            if (entry.id.op_class == scan_result->id.op_class &&
+                entry.id.channel  == scan_result->id.channel) {
+                entry = *scan_result;
+                return;
+            }
+        }
+        m_scan_results.push_back(*scan_result);
+    }
+
+    size_t get_num_scan_results() const
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        return m_scan_results.size();
+    }
+
+    em_scan_result_t *get_scan_result(size_t index)
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        if (index >= m_scan_results.size()) return nullptr;
+        return &m_scan_results[index];
+    }
+
+    void update_ap_mld_info(em_ap_mld_info_t *ap_mld_info)
+    {
+        if (!ap_mld_info) return;
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        for (auto &entry : m_ap_mld) {
+            if (memcmp(entry.mac_addr, ap_mld_info->mac_addr, sizeof(mac_address_t)) == 0) {
+                entry = *ap_mld_info;
+                return;
+            }
+        }
+        m_ap_mld.push_back(*ap_mld_info);
+    }
+
+    void update_bsta_mld_info(em_bsta_mld_info_t *bsta_mld_info)
+    {
+        if (!bsta_mld_info) return;
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        for (auto &entry : m_bsta_mld) {
+            if (memcmp(entry.mac_addr, bsta_mld_info->mac_addr, sizeof(mac_address_t)) == 0) {
+                entry = *bsta_mld_info;
+                return;
+            }
+        }
+        m_bsta_mld.push_back(*bsta_mld_info);
+    }
+
+    void update_assoc_sta_mld_info(em_assoc_sta_mld_info_t *assoc_sta_mld_info)
+    {
+        if (!assoc_sta_mld_info) return;
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        for (auto &entry : m_assoc_sta_mld) {
+            if (memcmp(entry.mac_addr, assoc_sta_mld_info->mac_addr, sizeof(mac_address_t)) == 0) {
+                entry = *assoc_sta_mld_info;
+                return;
+            }
+        }
+        m_assoc_sta_mld.push_back(*assoc_sta_mld_info);
+    }
+
+    em_ap_mld_info_t *get_ap_mld_frm_bssid(mac_address_t bss_id)
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        for (auto &entry : m_ap_mld) {
+            for (int i = 0; i < entry.num_affiliated_ap; i++) {
+                if (memcmp(entry.affiliated_ap[i].mac_addr, bss_id, sizeof(mac_address_t)) == 0) {
+                    return &entry;
+                }
+            }
+        }
+        return nullptr;
+    }
+
+    // Radio capability accessors
+    em_radio_cap_info_t *get_radio_cap_info(unsigned int index)
+    {
+        if (index >= ONEWIFI_DM_MAX_RADIOS) return nullptr;
+        return &m_radio_cap[index];
+    }
+
+    em_radio_cap_info_t *get_radio_cap_by_mac(mac_address_t mac)
+    {
+        for (unsigned int i = 0; i < m_num_radios; i++) {
+            if (memcmp(m_radio_cap[i].ruid.mac, mac, sizeof(mac_address_t)) == 0) {
+                return &m_radio_cap[i];
+            }
+        }
+        return nullptr;
+    }
+
+    void set_radio_cap_info(unsigned int index, const em_radio_cap_info_t *cap_info)
+    {
+        if (index >= ONEWIFI_DM_MAX_RADIOS || !cap_info) return;
+        m_radio_cap[index] = *cap_info;
+    }
+
+    // Thread-safe accessors for vap_name_to_interface map
+    void set_vap_name_mapping(const std::string &vap_name, const std::string &interface_name)
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        vap_name_to_interface[vap_name] = interface_name;
+    }
+
+    bool get_vap_name_mapping(const std::string &vap_name, std::string &interface_name) const
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        auto it = vap_name_to_interface.find(vap_name);
+        if (it != vap_name_to_interface.end()) {
+            interface_name = it->second;
+            return true;
+        }
+        return false;
+    }
+
+    size_t get_vap_name_mapping_count() const
+    {
+        std::lock_guard<std::mutex> lock(m_data_mutex);
+        return vap_name_to_interface.size();
+    }
+
+    // =========================================================================
+    // Static C-style callbacks (matching webconfig_proto_easymesh_init signature)
+    // These cast the void* data_model back to onewifi_data_model_t* and call
+    // the corresponding instance method.
+    // =========================================================================
+    static unsigned int get_num_radios(void *dm)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_num_radios();
+    }
+    static void set_num_radios(void *dm, unsigned int n)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->set_num_radios(n);
+    }
+    static unsigned int get_num_op_class(void *dm)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_num_op_class();
+    }
+    static void set_num_op_class(void *dm, unsigned int n)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->set_num_op_class(n);
+    }
+    static unsigned int get_num_bss(void *dm)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_num_bss();
+    }
+    static void set_num_bss(void *dm, unsigned int n)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->set_num_bss(n);
+    }
+    static em_device_info_t *get_device_info(void *dm)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_device_info();
+    }
+    static em_network_info_t *get_network_info(void *dm)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_network_info();
+    }
+    static em_radio_info_t *get_radio_info(void *dm, unsigned int index)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_radio_info(index);
+    }
+    static em_ieee_1905_security_info_t *get_ieee_1905_security_info(void *dm)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_ieee_1905_security_info();
+    }
+    static em_bss_info_t *get_bss_info(void *dm, unsigned int index)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_bss_info(index);
+    }
+    static em_op_class_info_t *get_op_class_info(void *dm, unsigned int index)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_op_class_info(index);
+    }
+    static em_sta_info_t *get_first_sta_info(void *dm, em_target_sta_map_t target)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_first_sta_info(target);
+    }
+    static em_sta_info_t *get_next_sta_info(void *dm, em_sta_info_t *sta, em_target_sta_map_t target)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_next_sta_info(sta, target);
+    }
+    static em_sta_info_t *get_sta_info(void *dm, mac_address_t sta_mac, bssid_t bssid,
+                                       mac_address_t radio_mac, em_target_sta_map_t target)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_sta_info(sta_mac, bssid, radio_mac, target);
+    }
+    static void put_sta_info(void *dm, em_sta_info_t *info, em_target_sta_map_t target)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->put_sta_info(info, target);
+    }
+    static em_bss_info_t *get_bss_info_with_mac(void *dm, mac_address_t mac)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_bss_info_with_mac(mac);
+    }
+    static void put_scan_results(void *dm, em_scan_result_t *scan_result)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->put_scan_results(scan_result);
+    }
+    static void update_ap_mld_info(void *dm, em_ap_mld_info_t *ap_mld_info)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->update_ap_mld_info(ap_mld_info);
+    }
+    static void update_bsta_mld_info(void *dm, em_bsta_mld_info_t *bsta_mld_info)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->update_bsta_mld_info(bsta_mld_info);
+    }
+    static void update_assoc_sta_mld_info(void *dm, em_assoc_sta_mld_info_t *assoc_sta_mld_info)
+    {
+        static_cast<onewifi_data_model_t *>(dm)->update_assoc_sta_mld_info(assoc_sta_mld_info);
+    }
+    static em_ap_mld_info_t *get_ap_mld_frm_bssid(void *dm, mac_address_t bss_id)
+    {
+        return static_cast<onewifi_data_model_t *>(dm)->get_ap_mld_frm_bssid(bss_id);
+    }
+
+    /**
+     * @brief Get radio capabilities by index
+     * 
+     * Static callback for webconfig_proto_easymesh_init().
+     * Returns radio capabilities populated by OneWifi during DML decode.
+     * 
+     * @param dm Pointer to data model instance
+     * @param index Radio index
+     * @return Pointer to em_radio_cap_info_t or nullptr if not found
+     */
+    static em_radio_cap_info_t *get_radio_cap_info(void *dm, int index)
+    {
+        if (!dm || index < 0) return nullptr;
+        return static_cast<onewifi_data_model_t *>(dm)->get_radio_cap_info(static_cast<unsigned int>(index));
+    }
+
+private:
+    mutable std::mutex m_data_mutex;
+
+    std::vector<em_sta_info_t> &get_sta_vec(em_target_sta_map_t target)
+    {
+        switch (target) {
+        case em_target_sta_map_assoc:       return m_assoc_sta;
+        case em_target_sta_map_disassoc:    return m_disassoc_sta;
+        case em_target_sta_map_consolidated:
+        default:                            return m_consolidated_sta;
+        }
+    }
+};
+
