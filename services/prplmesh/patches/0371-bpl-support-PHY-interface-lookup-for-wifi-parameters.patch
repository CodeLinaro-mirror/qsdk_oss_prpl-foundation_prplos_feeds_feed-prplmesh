From 05f3c067ed6d65c7e31db79fb1c1d42c2ea2d792 Mon Sep 17 00:00:00 2001
From: Dhivya <dsankar@qti.qualcomm.com>
Date: Wed, 26 Aug 2026 19:59:18 +0530
Subject: [PATCH] bpl: support PHY interface lookup for wifi parameters

Signed-off-by: Dhivya <dsankar@qti.qualcomm.com>
---
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 123 +++++++++++++++---
 1 file changed, 107 insertions(+), 16 deletions(-)

diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 3ad3d5a..81d55c9 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -606,41 +606,132 @@ int cfg_get_all_prplmesh_wifi_interfaces(BPL_WLAN_IFACE *interfaces, int *num_of
     return RETURN_OK;
 }
 
-int cfg_get_wifi_params(const std::string &iface, struct BPL_WLAN_PARAMS *wlan_params)
+static int cfg_get_wifi_params_from_phy(const std::string &phy_name,
+                                        struct BPL_WLAN_PARAMS *wlan_params)
 {
     if (!wlan_params) {
-        MAPF_ERR("cfg_get_wifi_params: invalid input: wlan_params = " << intptr_t(wlan_params));
         return RETURN_ERR;
     }
 
-    // The UCI "disabled" setting is optional, defaults to false if not present
+    auto pos = phy_name.rfind('.');
+    if (pos == std::string::npos) {
+        return RETURN_ERR;
+    }
+
+    // phy00.0 -> 0
+    // phy00.1 -> 1
+    // phy00.2 -> 2
+    // phy00.3 -> 3 (quadband support)
+
+    std::string radio_id = phy_name.substr(pos + 1);
+
+    std::string radio_section;
+
+    if (!uci_find_section_by_option("wireless",
+                                    "wifi-device",
+                                    "radio",
+                                    radio_id,
+                                    radio_section) ||
+        radio_section.empty()) {
+
+        MAPF_ERR("Failed to find wifi-device for radio="
+                 << radio_id);
+
+        return RETURN_ERR;
+    }
+
+    // disabled
     bool disabled = false;
-    cfg_uci_get_wireless_bool(TYPE_RADIO, iface.c_str(), "disabled", &disabled);
+
+    cfg_uci_get_wireless_bool(TYPE_RADIO,
+                              radio_section.c_str(),
+                              "disabled",
+                              &disabled);
+
     wlan_params->enabled = !disabled;
 
-    if (cfg_uci_get_wireless_bool(TYPE_RADIO, iface.c_str(), "sub_band_dfs", &wlan_params->sub_band_dfs) ==
-        RETURN_ERR) {
-        // Failed to find "sub_band_dfs", set to to default value.
+    // sub_band_dfs
+    if (cfg_uci_get_wireless_bool(TYPE_RADIO,
+                                  radio_section.c_str(),
+                                  "sub_band_dfs",
+                                  &wlan_params->sub_band_dfs) == RETURN_ERR) {
         wlan_params->sub_band_dfs = false;
     }
 
-    // The UCI "channel" setting is not documented as optional, but for Intel
-    // wireless (as probably for other drivers) it is. We do not want to
-    // fail when wifi still works fine, so default to "auto" (0) and if
-    // can't get the channel from UCI just move on.
+    // channel
     wlan_params->channel = 0;
-    cfg_get_channel(iface, &wlan_params->channel);
+
+    std::string channel;
+    if (uci_get_option("wireless",
+                       "wifi-device",
+                       radio_section,
+                       "channel",
+                       channel)) {
+        wlan_params->channel = std::stoi(channel);
+    }
 
     // country code
-    char alpha_2[MAX_UCI_BUF_LEN] = {0};
-    cfg_uci_get_wireless_from_ifname(TYPE_RADIO, iface.c_str(), "country", alpha_2);
+    std::string country;
+    if (uci_get_option("wireless",
+                       "wifi-device",
+                       radio_section,
+                       "country",
+                       country) &&
+        country.size() >= 2) {
 
-    wlan_params->country_code[0] = alpha_2[0];
-    wlan_params->country_code[1] = alpha_2[1];
+        wlan_params->country_code[0] = country[0];
+        wlan_params->country_code[1] = country[1];
+        wlan_params->country_code[2] = '\0';
+    }
 
     return RETURN_OK;
 }
 
+int cfg_get_wifi_params(const std::string &iface, struct BPL_WLAN_PARAMS *wlan_params)
+{
+    if (!wlan_params) {
+        MAPF_ERR("cfg_get_wifi_params: invalid input: wlan_params = "
+                 << intptr_t(wlan_params));
+        return RETURN_ERR;
+    }
+
+    if (iface.find("phy00.") == 0) {
+        return cfg_get_wifi_params_from_phy(iface, wlan_params);
+    } else {
+
+        // The UCI "disabled" setting is optional, defaults to false if not present
+        bool disabled = false;
+        cfg_uci_get_wireless_bool(TYPE_RADIO, iface.c_str(), "disabled", &disabled);
+        wlan_params->enabled = !disabled;
+
+        if (cfg_uci_get_wireless_bool(TYPE_RADIO, iface.c_str(),
+                                      "sub_band_dfs",
+                                      &wlan_params->sub_band_dfs) == RETURN_ERR) {
+            // Failed to find "sub_band_dfs", set to to default value.
+            wlan_params->sub_band_dfs = false;
+        }
+
+        // The UCI "channel" setting is not documented as optional, but for Intel
+        // wireless (as probably for other drivers) it is. We do not want to
+        // fail when wifi still works fine, so default to "auto" (0) and if
+        // can't get the channel from UCI just move on.
+        wlan_params->channel = 0;
+        cfg_get_channel(iface, &wlan_params->channel);
+
+        // country code
+        char alpha_2[MAX_UCI_BUF_LEN] = {0};
+        cfg_uci_get_wireless_from_ifname(TYPE_RADIO,
+                                         iface.c_str(),
+                                         "country",
+                                         alpha_2);
+
+        wlan_params->country_code[0] = alpha_2[0];
+        wlan_params->country_code[1] = alpha_2[1];
+
+        return RETURN_OK;
+    }
+}
+
 bool bpl_cfg_get_wireless_settings(std::list<son::wireless_utils::sBssInfoConf> &wireless_settings)
 {
     // Get all "wireless.wifi-iface" section names in UCI configuration
-- 
