+bool ap_wlan_hal_nl80211::apply_pending_hostapd_reload(
+    PendingHostapdReload &pending_reload)
+{
+    if (!pending_reload.required) {
+        LOG(DEBUG) << "RECONSTRA no hostapd reload queued for this VAP transaction RECONSTRA";
+        return true;
+    }
+
+    const auto reload_start = std::chrono::steady_clock::now();
+    int reload_attempts       = 1;
+
+    LOG(DEBUG) << "RECONSTRA batched hostapd reload start: changed_bss_count="
+               << pending_reload.changed_bss.size()
+               << " control_iface=" << pending_reload.control_iface
+               << " RECONSTRA";
+
+    // RELOAD_CONFIG is hostapd-interface scoped. Do not use the generic ten-attempt
+    // control-client retry loop here: if hostapd accepted a request but its reply timed
+    // out, replaying the command queues another complete interface/MLO reload.
+    bool reload_timed_out = false;
+    if (!wpa_ctrl_send_msg("RELOAD_CONFIG", pending_reload.control_iface, 1,
+                           &reload_timed_out)) {
+        if (!reload_timed_out) {
+            LOG(ERROR) << "batched hostapd reload failed without timeout; no recovery reload "
+                       << "sent RECONSTRA";
+            return false;
+        }
+
+        LOG(DEBUG) << "RECONSTRA batched hostapd reload request did not complete; "
+                      "checking hostapd readiness before one recovery attempt RECONSTRA";
+
+        // A STATUS response confirms that the control endpoint is responsive again. The
+        // first RELOAD_CONFIG may already have completed, so this is deliberately bounded
+        // to one recovery request rather than using the generic retry count.
+        std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        LOG(DEBUG) << "RECONSTRA reconnecting hostapd control socket before readiness check for "
+                   << pending_reload.control_iface << " RECONSTRA";
+        if (!reconnect_wpa_ctrl_cmd_socket(pending_reload.control_iface)) {
+            LOG(ERROR) << "hostapd control socket reconnect failed after batched reload "
+                       << "RECONSTRA";
+            return false;
+        }
+        if (!wpa_ctrl_send_msg("STATUS", pending_reload.control_iface, 1)) {
+            LOG(ERROR) << "hostapd readiness check failed after batched reload RECONSTRA";
+            return false;
+        }
+
+        LOG(DEBUG) << "RECONSTRA hostapd readiness check succeeded; "
+                      "sending one batched reload recovery request RECONSTRA";
+        reload_attempts++;
+        if (!wpa_ctrl_send_msg("RELOAD_CONFIG", pending_reload.control_iface, 1)) {
+            LOG(ERROR) << "batched hostapd reload recovery failed RECONSTRA";
+            return false;
+        }
+    }
+
+    for (auto &callback : pending_reload.on_success) {
+        callback();
+    }
+
+    const auto reload_duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - reload_start);
+    LOG(DEBUG) << "RECONSTRA batched hostapd reload complete: changed_bss_count="
+               << pending_reload.changed_bss.size() << " attempts=" << reload_attempts
+               << " duration_ms=" << reload_duration_ms.count() << " RECONSTRA";
+    return true;
+}
