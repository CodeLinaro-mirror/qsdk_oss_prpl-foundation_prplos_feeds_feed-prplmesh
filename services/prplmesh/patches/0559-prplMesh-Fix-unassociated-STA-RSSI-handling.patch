From 89d23c5db4f3e51e4a5337acf489154e21cde197 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Thu, 22 Oct 2026 11:06:31 +0530
Subject: [PATCH] [prplMesh] Fix unassociated STA RSSI handling for updated NRP
 RSSI format (CR-4634095)

The ath12k driver changed the NRP RSSI debugfs output format as part of
CR-4634095. The previous format exposed SNR values in the RSSI column,
while the new format reports actual RSSI values in dBm and adds
dedicated SNR fields.

Update the unassociated STA link metrics path to parse the new format
correctly and stop applying SNR-to-RSSI conversion on values that are
already reported in dBm.

Specifically:
- Fix field parsing in `read_peer_neighbor_rssi()` to match the updated
  debugfs layout.
- Remove the `rssi_db_to_dbm()` conversion in
  `process_roc_expired_event()` and use the driver-reported RSSI value
  directly.

This prevents incorrect RSSI reporting caused by converting already
normalized RSSI values.

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 .../bwl/nl80211/mon_wlan_hal_nl80211.cpp      | 23 +++++++++++++------
 1 file changed, 16 insertions(+), 7 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
index 94b0469ff..2b1faaffd 100644
--- a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
@@ -2392,15 +2392,20 @@ bool mon_wlan_hal_nl80211::read_peer_neighbor_rssi(const std::string &mac_addres
     // Read the first data line
     if (!std::getline(iss, line))
         return false;
-    // Split by whitespace
+    // CR-4634095: NRP RSSI debugfs format changed — new format has 6 columns:
+    //   Neighbor Peer MAC  RSSI  Avg RSSI  SNR  Avg SNR  Time
+    // Old format had 3 columns where the "RSSI" column actually contained SNR in dB:
+    //   Neighbor Peer MAC  RSSI  Avg RSSI  Time
+    // Use Avg RSSI (3rd column, e.g., -22 dBm) — more stable than instantaneous RSSI,
+    // mirroring the associated STA path which prefers NL80211_STA_INFO_SIGNAL_AVG.
     std::istringstream fieldss(line);
-    std::string mac_str, rssi_str, time_str;
-    if (!(fieldss >> mac_str >> rssi_str >> time_str))
+    std::string mac_str, rssi_str, avg_rssi_str;
+    if (!(fieldss >> mac_str >> rssi_str >> avg_rssi_str))
         return false;
     // Remove exception handling (no exceptions in prplMesh build).
     char *endptr  = nullptr;
-    long rssi_val = std::strtol(rssi_str.c_str(), &endptr, 10);
-    if (endptr == rssi_str.c_str() || *endptr != '\0' || rssi_val < -128 || rssi_val > 127)
+    long rssi_val = std::strtol(avg_rssi_str.c_str(), &endptr, 10);
+    if (endptr == avg_rssi_str.c_str() || *endptr != '\0' || rssi_val < -128 || rssi_val > 127)
         return false;
     rssi = static_cast<int8_t>(rssi_val);
     return true;
@@ -2570,8 +2575,12 @@ bool mon_wlan_hal_nl80211::process_roc_expired_event()
             sUnassociatedStationStats new_stat;
             new_stat.mac_adress = tlvf::mac_from_string(measurement.mac_address);
 
-            // Convert RSSI-dB to dBm (using noise_floor_to_chanwidth = 94)
-            int rssi_dbm = rssi_db_to_dbm(rssi, 94);
+            // CR-4634095: The new NRP RSSI debugfs format provides RSSI directly in dBm.
+            // No noise-floor conversion needed — rssi_db_to_dbm() was for the old format
+            // where the "RSSI" column actually contained SNR in dB (e.g., 80 dB SNR →
+            // rssi_db_to_dbm(80, 94) = -14 dBm). New format: RSSI column = actual RSSI
+            // in dBm (e.g., -21 dBm). Applying rssi - 94 would give -115 dBm — wrong.
+            int rssi_dbm = static_cast<int>(rssi);
 
             // Store dBm in signal_strength. son_slave_thread converts dBm → RCPI
             // via convert_rcpi_from_rssi(). Do NOT pre-compute RCPI here — that
