From a8b64759581c17894be5cc65d7745a3103f4ae20 Mon Sep 17 00:00:00 2001
From: Sandeep Tomer <stomer@qti.qualcomm.com>
Date: Wed, 4 Nov 2026 15:19:04 +0530
Subject: [PATCH] prplMesh: forward DPP onboarding policy to AP Manager

The WHM HAL runs in AP Manager, where cfg_get_onboarding_type() has no
Agent/Controller BPL configuration context and defaults to WSC. This
suppresses DPP relay and CCE operation on SAE/PSK BSSs without DPP AKM,
even when the agent is configured for DPP onboarding.

Read the configured onboarding policy in the agent and forward it in
ACTION_APMANAGER_CONFIGURE. Cache the flag before HAL creation and pass
it through hal_conf_t. Use it in update_vap_credentials() and
set_cce_indication(), preserving the existing DPP AKM, relay and CCE
conditions. Refresh the policy whenever AP Manager reconnects and is
configured; do not derive it from runtime onboarding fallback state.

Append the Boolean to the CONFIGURE YAML definition. The normal CMake
build regenerates the TLVF message classes from this definition.

Signed-off-by: Sandeep Tomer <stomer@qti.qualcomm.com>
---
 .../src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp | 5 ++++-
 agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h | 2 ++
 agent/src/beerocks/slave/son_slave_thread.cpp                | 4 ++++
 common/beerocks/bwl/include/bwl/base_wlan_hal_types.h        | 3 +++
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp                  | 4 ++--
 .../tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml  | 2 ++
 6 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 1d57989..49597fe 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -495,6 +495,7 @@ bool ApManager::create_ap_wlan_hal()
     hal_conf.ap_acs_enabled     = acs_enabled;
     hal_conf.certification_mode = certification_mode;
     hal_conf.multi_ap_profile   = multi_ap_profile;
+    hal_conf.dpp_onboarding     = m_dpp_onboarding;
     // Active ACS channel selection : propagate the AgentDB flag into the bwl HAL so that
     // nl80211 start_platform_acs() can decide to drive the driver ACS (acs clear/set_block_chan_list
     // + acs invoke 0) instead of the stubbed no-op.
@@ -1474,6 +1475,7 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
         certification_mode = config->certification_mode();
         multi_ap_profile   = config->multi_ap_profile();
+        m_dpp_onboarding   = static_cast<bool>(config->dpp_onboarding());
         /**
          * Channel-selection approach knobs forwarded from the agent process (beerocks_agent.conf).
          * They must be cached BEFORE create_ap_wlan_hal() is called (below, in this same handler),
@@ -1498,7 +1500,8 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         m_radio_disable    = static_cast<bool>(config->radio_disable());
         LOG(DEBUG) << "ACTION_APMANAGER_CONFIGURE: local_gw=" << m_local_gw
                    << " radio_disable=" << m_radio_disable
-                   << " rsn_overriding_supported=" << rsn_overriding_supported;
+                   << " rsn_overriding_supported=" << rsn_overriding_supported
+                   << " dpp_onboarding=" << m_dpp_onboarding;
 
         if (create_ap_wlan_hal()) {
             LOG(DEBUG) << "Move to ATTACHING state";
diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
index 91b4a8a..bc92ddf 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
@@ -418,6 +418,8 @@ private:
     std::unique_ptr<beerocks::CmduClient> m_slave_client;
 
     bool certification_mode = false;
+    // Configured onboarding policy received from the agent in ACTION_APMANAGER_CONFIGURE.
+    bool m_dpp_onboarding = false;
     /**
      * Channel-selection approach knobs, received from the agent process in
      * cACTION_APMANAGER_CONFIGURE (originating from beerocks_agent.conf). They MUST NOT be read
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index a13980c..b0c9b6d 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4335,6 +4335,10 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         config_msg->channel() = db->device_conf.front_radio.config.at(iface).configured_channel;
         config_msg->certification_mode() = db->device_conf.certification_mode;
         config_msg->multi_ap_profile()   = static_cast<uint8_t>(db->device_conf.multi_ap_profile);
+        // AP Manager has no BPL onboarding configuration context. Forward the configured
+        // policy, rather than the runtime onboarding state, which may fall back to WSC.
+        config_msg->dpp_onboarding() =
+            static_cast<uint8_t>(bpl::cfg_get_onboarding_type() == "DPP");
         /**
          * Channel-selection approach knobs (from beerocks_agent.conf). The ap_manager/BWL HAL runs
          * in a SEPARATE process whose AgentDB copy is NOT populated, therefore these knobs must be
diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index c1bca61..06143ca 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -314,6 +314,9 @@ struct hal_conf_t {
     std::string phy_name;
     bool radio_disable = false;
     bool enable_cotdma = false;
+    // Configured DPP onboarding policy forwarded by the agent through AP Manager.
+    // The HAL process cannot read this policy through BPL's Agent/Controller context.
+    bool dpp_onboarding = false;
 };
 
 //sta_wlan_hal
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index eb0f1ea..799eb0e 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -1140,7 +1140,7 @@ bool ap_wlan_hal_whm::update_vap_credentials(
                    << " authentication_type: " << bss_info_conf.authentication_type
                    << " mld_unit: " << mld_unit;
 
-        const bool dpp_onboarding = beerocks::bpl::cfg_get_onboarding_type() == "DPP";
+        const bool dpp_onboarding = get_hal_conf().dpp_onboarding;
         const bool dpp_enabled_for_bss = dpp_onboarding || dpp_akm;
         const bool cce_relay = bss_info_conf.fronthaul && dpp_enabled_for_bss &&
                                m_cce_indication_received && m_advertise_cce;
@@ -2735,7 +2735,7 @@ bool ap_wlan_hal_whm::set_cce_indication(uint16_t advertise_cce)
     m_cce_indication_received = true;
     m_advertise_cce           = advertise_cce != 0;
 
-    const bool dpp_onboarding = beerocks::bpl::cfg_get_onboarding_type() == "DPP";
+    const bool dpp_onboarding = get_hal_conf().dpp_onboarding;
     if (!dpp_onboarding) {
         LOG(DEBUG) << "DPP CCE indication received while DPP onboarding is disabled; "
                    << "not configuring a DPP relay";
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index a414f68..a9d45c1 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -59,6 +59,8 @@ cACTION_APMANAGER_CONFIGURE:
   # AP Capability TLV). The RSN Diagnostic Report TLV is only added to the Failed Connection
   # Message when this is set.
   rsn_overriding_supported: uint8_t #bool
+  # Configured onboarding policy read in the agent; AP Manager has no BPL config context.
+  dpp_onboarding: uint8_t #bool
 
 cACTION_APMANAGER_JOINED_NOTIFICATION:
   _type: class
-- 
