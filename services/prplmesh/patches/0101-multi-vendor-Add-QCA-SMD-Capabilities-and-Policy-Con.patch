+
+// RECEIVE side: Specific parser for SMD capabilities TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_smd_capabilities_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // Now we can safely call addVendorClass to parse and consume the TLV
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaSmdCapabilities>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA SMD capabilities TLV";
+        return nullptr;
+    }
+
+    // Extract capability bits
+    uint8_t capabilities   = tlv->capabilities();
+    bool smd_capable       = (capabilities & 0x80) != 0; // Bit 7
+    bool smd_dl_forwarding = (capabilities & 0x40) != 0; // Bit 6
+
+    LOG(INFO) << "Parsed QCA SMD capabilities TLV: "
+              << "smdCapable=" << (smd_capable ? "true" : "false")
+              << ", smdDlForwarding=" << (smd_dl_forwarding ? "true" : "false");
+
+    return tlv;
+}
+
+// RECEIVE side: Specific parser for SMD policy config TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_smd_policy_config_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // Now we can safely call addVendorClass to parse and consume the TLV
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaSmdPolicyConfig>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA SMD policy config TLV";
+        return nullptr;
+    }
+
+    // Extract all policy fields
+    uint16_t smd_timeout              = tlv->smd_timeout();
+    uint8_t smd_max_prepared_ap_mlds  = tlv->smd_max_prepared_ap_mlds();
+    uint8_t smd_dl_forwarding         = tlv->smd_dl_forwarding();
+    uint8_t smd_ptk_mode              = tlv->smd_ptk_mode();
+    uint8_t smd_type                  = tlv->smd_type();
+    uint8_t smd_default_dl_drain_time = tlv->smd_default_dl_drain_time();
+
+    LOG(INFO) << "Parsed QCA SMD policy config TLV: "
+              << "timeout=" << smd_timeout
+              << ", maxPreparedApMLDs=" << static_cast<int>(smd_max_prepared_ap_mlds)
+              << ", dlForwarding=" << static_cast<int>(smd_dl_forwarding)
+              << ", ptkMode=" << static_cast<int>(smd_ptk_mode)
+              << ", type=" << static_cast<int>(smd_type)
+              << ", defaultDlDrainTime=" << static_cast<int>(smd_default_dl_drain_time);
+
+    return tlv;
+}
