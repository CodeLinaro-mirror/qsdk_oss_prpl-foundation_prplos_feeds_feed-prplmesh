+// SEND side: Add SMD capabilities TLV to outgoing message
+bool tlvf_qca_utils::add_qca_smd_capabilities_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto tlv_smd_cap = cmdu_tx.addClass<qca::tlvQcaSmdCapabilities>();
+    if (!tlv_smd_cap) {
+        LOG(ERROR) << "Failed to add QCA SMD capabilities TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv_smd_cap->vendor_oui() = (sVendorOUI(qca::qcaVendorOUI::OUI_QCA));
+
+    // Set TLV ID
+    tlv_smd_cap->tlv_id() = static_cast<int>(qca::eQcaTlVId::QCA_SMD_CAPABILITIES);
+
+    // Set RUID (Radio Unique Identifier) - initialize to zeros
+    // This will be populated by the caller with the actual radio MAC address
+    std::fill_n(tlv_smd_cap->ruid().oct, 6, 0);
+
+    // Set capabilities - default to 0 (both bits false)
+    // Bit 7: smdCapable = 0 (not supported)
+    // Bit 6: smdDlForwarding = 0 (not supported)
+    // Bits 5-0: Reserved = 0
+    tlv_smd_cap->capabilities() = 0x00;
+
+    LOG(INFO) << "Added QCA SMD capabilities TLV";
+    return true;
+}
+
+// SEND side: Add SMD policy config TLV to outgoing message
+bool tlvf_qca_utils::add_qca_smd_policy_config_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    // Check if this is M1 by looking for AP Radio Basic Capabilities TLV
+    // AP_AUTOCONFIGURATION_WSC_MESSAGE is used bidirectionally:
+    // - M1: Agent -> Controller (contains AP Radio Basic Capabilities TLV)
+    // - M2: Controller -> Agent (does NOT contain AP Radio Basic Capabilities TLV)
+    // This TLV should only be added in M2 (controller response)
+
+    auto ap_radio_basic_cap = cmdu_tx.getClass<wfa_map::tlvApRadioBasicCapabilities>();
+    if (ap_radio_basic_cap) {
+        LOG(DEBUG) << "AP Radio Basic Capabilities TLV found (M1 message), skipping QCA SMD policy "
+                      "config TLV";
+        return true;
+    }
+
+    // This is M2 (no AP Radio Basic Capabilities TLV), proceed with adding policy config TLV
+    auto tlv_smd_policy = cmdu_tx.addClass<qca::tlvQcaSmdPolicyConfig>();
+    if (!tlv_smd_policy) {
+        LOG(ERROR) << "Failed to add QCA SMD policy config TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv_smd_policy->vendor_oui() = (sVendorOUI(qca::qcaVendorOUI::OUI_QCA));
+
+    // Set TLV ID
+    tlv_smd_policy->tlv_id() = static_cast<int>(qca::eQcaTlVId::QCA_SMD_POLICY_CONFIG);
+
+    // Set RUID (Radio Unique Identifier) - initialize to zeros
+    std::fill_n(tlv_smd_policy->ruid().oct, 6, 0);
+
+    // Set SMD Identifier - initialize to zeros
+    std::fill_n(tlv_smd_policy->smd_identifier().oct, 6, 0);
+
+    // Set all policy fields to default values (0)
+    tlv_smd_policy->smd_timeout()               = 0;
+    tlv_smd_policy->smd_max_prepared_ap_mlds()  = 0;
+    tlv_smd_policy->smd_dl_forwarding()         = 0;
+    tlv_smd_policy->smd_ptk_mode()              = 0;
+    tlv_smd_policy->smd_type()                  = 0;
+    tlv_smd_policy->smd_default_dl_drain_time() = 0;
+
+    LOG(INFO) << "Added QCA SMD policy config TLV";
+    return true;
+}
