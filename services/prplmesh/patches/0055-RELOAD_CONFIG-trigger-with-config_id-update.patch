From 7475c35dd2221ff377b1f8a121c07079336e7938 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 14 Jan 2026 14:26:24 +0530
Subject: [PATCH] RELOAD_CONFIG trigger with config_id update for updating
 vap credentials

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 68 ++++---------------
 .../hostapd/include/hostapd/configuration.h   |  9 ++-
 .../beerocks/hostapd/source/configuration.cpp | 49 +++++++++++--
 controller/config/CMakeLists.txt              |  4 +-
 4 files changed, 66 insertions(+), 64 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index ee2215ddb..ed1998935 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -982,7 +982,7 @@ bool ap_wlan_hal_nl80211::set_channel(int chan, beerocks::eWiFiBandwidth bw, int
     }
 
     // store the result:
-    if (!conf.store()) {
+    if (!conf.store("")){
         LOG(ERROR) << "set_channel: cannot save hostapd config!";
         return false;
     }
@@ -1461,7 +1461,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     updated_base_conf.add_new_vap_to_default_config(new_vap);
                     m_radio_info.hostapd_new_bss_config.clear();
                     // store the default config
-                    if (!updated_base_conf.store()) {
+                    if (!updated_base_conf.append_new_bss_to_default_hostapd_conf()) {
                         LOG(ERROR) << "Autoconfiguration: failed to add new bss in default config file!";
                     }
                 } else {
@@ -1674,7 +1674,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 }
 
                 if (conf.update_required()) {
-                    if (!conf.store()) {
+                    if (!conf.store(vap_id)) {
                         LOG(ERROR) << "Autoconfiguration: cannot save hostapd config!";
                         continue;
                     }
@@ -1735,59 +1735,12 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                                 }
                             }
                         } else {
-                            if(links_present > 1)
-                            {
-                                LOG(DEBUG) << "CHECK FOR TRIGGER STOP_MLD " ;
-                                int8_t active_link = 0;
-                                m_nl80211_client->get_mlo_active_link_count(vap_info.bss,active_link);
-
-                                LOG(DEBUG) << "Active link count: " <<  active_link;
-
-                                if (active_link == links_present) {
-                                    LOG(DEBUG) << "TRIGGER STOP_MLD FOR " << vap_info.bss;
-                                    const std::string cmd("STOP_MLD");
-                                    if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
-                                        LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
-                                        continue;
-                                    }
-                                    LOG(INFO) << "STOP_MLD successful";
-                                }
-                                std::stringstream reload_bss;
-                                std::string conf_path =
-                                    std::string(bwl::nl80211::base_ctrl_path) + "hostapd-" + m_radio_info.phy_name + ".conf";
-                                reload_bss << "RELOAD_CONFIG_BSS bss_config=" <<conf_path;
-                                if (!wpa_ctrl_send_msg(reload_bss.str(),vap_info.bss)) {
-                                    LOG(ERROR) << reload_bss.str() << " command to hostapd has failed - send reload_config";
-                                    continue;
-                                }
-                                LOG(INFO) << "RELOAD_CONFIG_BSS successful";
-                            } else {
-                                const std::string cmd("STOP_AP");
-                                if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
-                                    LOG(DEBUG) << "SKIP STOP_AP ON 6G RADIO: " ;
-                                } else {
-                                    if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
-                                        LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
-                                        continue;
-                                    }
-                                    LOG(INFO) << "STOP_AP successful";
-                                }
-                                std::stringstream reload_bss;
-                                std::string conf_path =
-                                    std::string(bwl::nl80211::base_ctrl_path) + "hostapd-" + m_radio_info.phy_name + ".conf";
-                                reload_bss << "RELOAD_CONFIG_BSS bss_config=" <<conf_path;
-                                if (!wpa_ctrl_send_msg(reload_bss.str(),vap_info.bss)) {
-                                    LOG(ERROR) << reload_bss.str() << " command to hostapd has failed - send reload_config";
-
-                                    const std::string cmd_2("RELOAD_CONFIG");
-                                    if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
-                                        LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
-                                        continue;
-                                    }
-                                    LOG(INFO) << "RELOAD_CONFIG successful";
-                                }
-
+                            const std::string cmd("RELOAD_CONFIG");
+                            if (!wpa_ctrl_send_msg(cmd,vap_info.bss)) {
+                                LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed for " << vap_info.bss;
+                                continue;
                             }
+                            LOG(INFO) << "RELOAD_CONFIG successful for " << vap_info.bss;
                         }
                    }
                 }
@@ -3092,7 +3045,10 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
         conf.set_create_vap_value(vap_id,"no_deauth_unknown_sta", "1");
     }
 
-    if (!conf.store()) {
+    // set dummy config_id value to generate correct config_id
+    conf.set_create_vap_value(vap_id,"config_id", "1234567890abcdef");
+
+    if (!conf.store(vap_id)) {
         LOG(ERROR) << "Failed to store the hostapd configuration!";
         return false;
     }
diff --git a/common/beerocks/hostapd/include/hostapd/configuration.h b/common/beerocks/hostapd/include/hostapd/configuration.h
index 4cb450464..cb225a11a 100644
--- a/common/beerocks/hostapd/include/hostapd/configuration.h
+++ b/common/beerocks/hostapd/include/hostapd/configuration.h
@@ -68,7 +68,7 @@ public:
      * into the file it was loaded from, effectively changing the configuration
      * @return *this (as bool, see above)
      */
-    bool store();
+    bool store(const std::string &bss_name);
 
     /**
      * @brief set key/value in the head section
@@ -224,6 +224,13 @@ public:
     std::vector<std::pair<std::string, std::vector<std::string>>> get_hostapd_bss_config();    
  
     void add_new_vap_to_default_config (const std::pair<std::string, std::vector<std::string>>& new_vap);
+
+    /**
+     * @brief append the dynamically created BSS section to default configuration
+     * @return *this (as bool, see above)
+     */
+    bool append_new_bss_to_default_hostapd_conf();
+
 private:
     /**
      * @brief helper: load configuration based on array of strings
diff --git a/common/beerocks/hostapd/source/configuration.cpp b/common/beerocks/hostapd/source/configuration.cpp
index c8f61b2b9..c2f956bef 100644
--- a/common/beerocks/hostapd/source/configuration.cpp
+++ b/common/beerocks/hostapd/source/configuration.cpp
@@ -90,7 +90,7 @@ bool Configuration::load(const std::set<std::string> &vap_indications)
     return *this;
 }
 
-bool Configuration::store()
+bool Configuration::store(const std::string &bss_name)
 {
     std::ofstream out_file(m_configuration_file, std::ofstream::out | std::ofstream::trunc);
 
@@ -109,7 +109,7 @@ bool Configuration::store()
         for (auto &line : vap.second) {
             // skip any existing config_id line (e.g. set by netfid),
             // it will be set again at the end.
-            if (line.rfind("config_id=", 0) == 0) {
+            if ((line.rfind("config_id=", 0) == 0) && (!bss_name.empty()) && (bss_name == vap.first)){
                 config_id_supported = true;
                 continue;
             }
@@ -126,11 +126,49 @@ bool Configuration::store()
                 LOG(ERROR) << "Unable to compute sha256 of the configuration!";
                 return false;
             };
-            out_file << "config_id=";
+
+            std::string config_id_string;
+            config_id_string.reserve(64); // 32 bytes * 2 hex chars
+
             for (const auto &c : config_id) {
-                out_file << beerocks::string_utils::int_to_hex_string(c, 2);
+                config_id_string +=  beerocks::string_utils::int_to_hex_string(c, 2);
             }
-            out_file << "\n";
+            out_file << "config_id=" << config_id_string << "\n";
+            set_create_vap_value(vap.first,"config_id",config_id_string);
+        }
+    }
+
+    m_ok              = true;
+    m_last_message    = m_configuration_file + " was stored";
+    m_update_required = false;
+
+    // close the file
+    out_file.close();
+    if (out_file.fail()) {
+        m_last_message    = strerror(errno);
+        m_ok              = false;
+        m_update_required = true;
+    }
+
+    return *this;
+}
+
+bool Configuration::append_new_bss_to_default_hostapd_conf()
+{
+    std::ofstream out_file(m_configuration_file, std::ofstream::out | std::ofstream::trunc);
+
+    // store the head
+    for (const auto &line : m_hostapd_config_head) {
+        out_file << line << "\n";
+    }
+
+    // store the next ones ('bss=')
+    for (auto &vap : m_hostapd_config_vaps) {
+
+        // add empty line for readability
+        out_file << "\n";
+        for (auto &line : vap.second) {
+            out_file << line << "\n";
         }
     }
 
@@ -149,6 +187,7 @@ bool Configuration::store()
     return *this;
 }
 
+
 bool Configuration::set_create_head_value(const std::string &key, const std::string &value)
 {
     // search for the key
diff --git a/controller/config/CMakeLists.txt b/controller/config/CMakeLists.txt
index 1b133614f..c9388535c 100644
--- a/controller/config/CMakeLists.txt
+++ b/controller/config/CMakeLists.txt
@@ -1,6 +1,6 @@
-set(BEEROCKS_CONTROLLER_DATAELEMENTS_VAP_CONFIGS 0)
+set(BEEROCKS_CONTROLLER_DATAELEMENTS_VAP_CONFIGS 1)
 if (NOT USE_PRPLMESH_WHM)
-        set(BEEROCKS_CONTROLLER_DATAELEMENTS_VAP_CONFIGS 1)
+        set(BEEROCKS_CONTROLLER_DATAELEMENTS_VAP_CONFIGS 0)
 endif()
 
 configure_file(
