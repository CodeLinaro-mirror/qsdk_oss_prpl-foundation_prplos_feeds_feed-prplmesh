From bd115eeeed0103f5335f4a166fb3e8e374e39642 Mon Sep 17 00:00:00 2001
From: Sandeep Tomer <stomer@qti.qualcomm.com>
Date: Thu, 22 Oct 2026 00:00:00 +0530
Subject: [PATCH] [prplmesh] fix connection fail RSN classification

AP-STA-POSSIBLE-PSK-MISMATCH is informational and carries no status or
reason code. The nl80211 and WHM HALs converted it into a Failed
Connection Message with fallback values (status=1, reason=0). hostapd
also emits CTRL-EVENT-CONNECTION-FAIL for the same attempt (for example
reason_code=14 for an EAPOL Message 2 MIC failure), so every wrong
passphrase attempt produced two Failed Connection Messages, one of them
with wrong codes. Log the informational event and rely on
CTRL-EVENT-CONNECTION-FAIL as the authoritative report.

Also preserve the RSN phase assigned by the HAL for STA_Connection_Fail.
Previously ApManager overwrote it with association failure. The legacy
event types carry no frame_type and are still mapped in ApManager.

Signed-off-by: Sandeep Tomer <stomer@qti.qualcomm.com>
---
 .../fronthaul_manager/ap_manager/ap_manager.cpp       |  5 +++++
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp   | 12 ++++++++++--
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp           | 19 ++++++++-----------
 3 files changed, 23 insertions(+), 13 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 147ad1462..ec8816875 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -5333,6 +5333,11 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
         // (EasyMesh R6.1 §17.2.106).
         bwl::eRsnError rsn_error = bwl::eRsnError::NONE;
         switch (event) {
+        case Event::STA_Connection_Fail:
+            // Already classified in the HAL from frame_type/reason_code; don't
+            // override it with the event-type-driven default below.
+            rsn_error = sta_conn_fail->rsn_error;
+            break;
         case Event::WPA_Event_EAP_Timeout_Failure:
         case Event::WPA_Event_EAP_Timeout_Failure2:
         case Event::WPS_Event_Timeout:
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 2d163bb20..e08e87996 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -9381,8 +9381,7 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
     case Event::WPS_Event_Timeout:
     case Event::WPS_Event_Fail:
     case Event::WPA_Event_SAE_Unknown_Password_Identifier:
-    case Event::WPS_Event_Cancel:
-    case Event::AP_Sta_Possible_Psk_Mismatch: {
+    case Event::WPS_Event_Cancel: {
 
         LOG(DEBUG) << "Sta Connection Failure";
         auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sStaConnectionFail));
@@ -9413,6 +9412,15 @@ bool ap_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         event_queue_push(event, msg_buff);
         break;
     }
+    case Event::AP_Sta_Possible_Psk_Mismatch:
+        // Informational hostapd indication that carries no status/reason code. Do not report it
+        // as a Failed Connection Message with default codes: the CTRL-EVENT-CONNECTION-FAIL that
+        // hostapd emits right after it (for example reason_code=14 for an EAPOL Message 2 MIC
+        // failure) is the authoritative failure report.
+        LOG(DEBUG) << "Ignoring informational AP-STA-POSSIBLE-PSK-MISMATCH for sta "
+                   << parsed_obj[bwl::EVENT_KEYLESS_PARAM_MAC]
+                   << "; waiting for CTRL-EVENT-CONNECTION-FAIL";
+        break;
 
     // MAPC-NEGOTIATION-STATUS negotiation_status=<N> src_bssid=<MAC> dst_bssid=<MAC>
     // Per-BSS event delivered on the wpa_ctrl socket of the local BSS involved in the
diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index eb0f1ea5d..d1c8d7fb0 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -3639,17 +3639,6 @@ bool ap_wlan_hal_whm::process_wpa_ctrl_event(const beerocks::wbapi::AmbiorixVari
     case Event::WPA_Event_EAP_Timeout_Failure:
     case Event::WPA_Event_EAP_Timeout_Failure2:
     case Event::WPA_Event_SAE_Unknown_Password_Identifier:
-    case Event::AP_Sta_Possible_Psk_Mismatch:
-        /* example PSK Mismatch notification
-            eobject = "WiFi.AccessPoint.[vap5g0priv].",
-            eventData = "<3>AP-STA-POSSIBLE-PSK-MISMATCH 6c:f7:84:d8:32:af",
-            // or with status/reason code
-            // eventData = "<3>AP-STA-POSSIBLE-PSK-MISMATCH 6c:f7:84:d8:32:af status=14/reason=15",
-            ifName = "wlan2.1",
-            notification = "wpaCtrlEvents",
-            object = "WiFi.AccessPoint.vap5g0priv.",
-            path = "WiFi.AccessPoint.1."
-        */
     case Event::STA_Connection_Fail:
         /* EasyMesh R6.1 CTRL-EVENT-CONNECTION-FAIL (forwarded by pWHM):
             eventData = "<3>CTRL-EVENT-CONNECTION-FAIL addr=<sta> bssid=<ap>
@@ -3781,6 +3770,14 @@ bool ap_wlan_hal_whm::process_wpa_ctrl_event(const beerocks::wbapi::AmbiorixVari
         event_queue_push(event, msg_buff);
         break;
     }
+    case Event::AP_Sta_Possible_Psk_Mismatch:
+        // This is an informational hostapd indication, not a definitive connection-failure
+        // report. It contains no authoritative status/reason code on this platform. Do not
+        // create a Failed Connection Message with fallback values; the corresponding
+        // CTRL-EVENT-CONNECTION-FAIL event carries the actual result.
+        LOG(DEBUG) << "Ignoring informational AP-STA-POSSIBLE-PSK-MISMATCH for interface "
+                   << interface << "; waiting for CTRL-EVENT-CONNECTION-FAIL";
+        break;
     // Unhandled events
     default:
         LOG(ERROR) << "Unhandled event received: " << int(event);
-- 
