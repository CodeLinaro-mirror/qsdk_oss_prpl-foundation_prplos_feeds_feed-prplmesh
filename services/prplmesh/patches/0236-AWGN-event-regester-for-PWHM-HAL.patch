+void ap_wlan_hal_whm::subscribe_to_awgn_events()
+{
+    // Subscribe to wpaCtrlEvents on ALL AccessPoint paths without VAP filtering.
+    // wld sends INTERFERENCE-DETECTED on the AP path but its internal handler fails
+    // (logged as [x]), so the standard subscribe_to_ap_events VAP filter may block it.
+    // This dedicated subscription catches INTERFERENCE-DETECTED regardless of which
+    // AP path wld uses, and only processes AWGN events.
+    auto event_handler        = std::make_shared<sAmbiorixEventHandler>();
+    event_handler->event_type = AMX_CL_WPA_CTRL_EVT;
+
+    event_handler->callback_fn = [this](AmbiorixVariant &event_data) -> void {
+        std::string event_str;
+        if (!event_data.read_child<>(event_str, "eventData") || event_str.empty()) {
+            LOG(WARNING) << "[AWGN-DBG] received event but eventData empty/missing";
+            return;
+        }
+
+        // Only handle INTERFERENCE-DETECTED events
+        if (event_str.find("INTERFERENCE-DETECTED") == std::string::npos) {
+            return;
+        }
+
+        // Verify this event belongs to a VAP of this radio instance
+        std::string if_name;
+        if (!event_data.read_child(if_name, "ifName") || if_name.empty()) {
+            LOG(WARNING) << "[AWGN-DBG] INTERFERENCE-DETECTED but no ifName - dropping";
+            return;
+        }
+        if (m_vapsExtInfo.find(if_name) == m_vapsExtInfo.end()) {
+            LOG(WARNING) << "[AWGN-DBG] ifName=" << if_name
+                         << " not in vapsExtInfo for this radio - dropping";
+            return;
+        }
+
+        LOG(WARNING) << "[AWGN-DBG] INTERFERENCE-DETECTED accepted for ifName="
+                     << if_name << " -> calling process_wpa_ctrl_event";
+        process_wpa_ctrl_event(event_data);
+    };
+
+    // Subscribe to all AP paths - no VAP filter restriction
+    std::string filter = "(path matches '" + wbapi_utils::search_path_ap() +
+                         "[0-9]+.$') && (notification == '" + AMX_CL_WPA_CTRL_EVT + "')";
+
+    LOG(WARNING) << "[AWGN-DBG] subscribe_to_awgn_events: filter=" << filter
+                 << " radio=" << get_iface_name();
+    m_ambiorix_cl.subscribe_to_object_event(wbapi_utils::search_path_ap(), event_handler, filter);
+}
+
 bool ap_wlan_hal_whm::simulate_awgn()
 {
-    // WHM platform does not use wpa_ctrl sockets; AWGN simulation via DCS_SIM
-    // is not supported on this platform. Return false to indicate unsupported.
-    LOG(WARNING) << "simulate_awgn: DCS_SIM not supported on WHM platform";
-    return false;
+    // Trigger AWGN simulation on the WHM platform by invoking the DCS.Simulation RPC method
+    // with type=4 on the AccessPoint object for this radio.
+    //
+    // This is the WHM equivalent of the nl80211 "DCS sim 4" wpa_ctrl command.
+    // On WHM, the equivalent ubus-cli command is:
+    //   ubus-cli "WiFi.AccessPoint.{X}.DCS.Simulation(type=4)"
+
+    std::string ap_path = wbapi_utils::search_path_ap_by_iface(m_radio_info.iface_name);
+    if (ap_path.empty()) {
+        LOG(ERROR) << "simulate_awgn: failed to resolve AccessPoint path for iface "
+                   << m_radio_info.iface_name;
+        return false;
+    }
+
+    const std::string dcs_path = ap_path + "DCS.";
+    LOG(INFO) << "simulate_awgn: calling Simulation(type=4) on " << dcs_path;
+
+    AmbiorixVariant args(AMXC_VAR_ID_HTABLE);
+    args.add_child("type", 4);
+    AmbiorixVariant result;
+
+    if (!m_ambiorix_cl.call(dcs_path, "Simulation", args, result)) {
+        LOG(ERROR) << "simulate_awgn: call Simulation failed for " << dcs_path;
+        return false;
+    }
+
+    LOG(INFO) << "simulate_awgn: Simulation(type=4) called successfully on " << dcs_path;
+    return true;
 }
 
