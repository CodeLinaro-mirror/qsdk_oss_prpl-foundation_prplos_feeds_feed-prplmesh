-    struct nl_sock *sock = nl_socket_alloc();
-    if (!sock) {
-        return false;
-    }
-
-    if (genl_connect(sock) < 0) {
-        nl_socket_free(sock);
+    if (link_iface.empty()) {
         return false;
     }
 
-    int nl80211_id = genl_ctrl_resolve(sock, "nl80211");
