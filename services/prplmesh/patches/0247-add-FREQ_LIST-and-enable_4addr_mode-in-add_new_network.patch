From 60750450b85e6cac4daf7edb2ffdfd66b5b522ff Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Mon, 29 Jun 2026 12:16:07 +0530
Subject: [PATCH] add FREQ_LIST and enable_4addr_mode in add_new_network

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../bwl/nl80211/sta_wlan_hal_nl80211.cpp      | 46 +++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
index 99255a270..955df1f5d 100644
--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
@@ -698,6 +698,34 @@ bool sta_wlan_hal_nl80211::add_new_network(son::wireless_utils::sBssInfoConf bSt
     std::string sta_iface = get_iface_name();
 
     LOG(INFO) << "Add a new network for interface: " << sta_iface;
+
+    // Retrieve the supported frequency list from wpa_supplicant before adding the network.
+    // The GET_FREQ_LIST command returns a space-separated list of frequencies (in MHz),
+    // e.g. "2412 2417 ... 5180 5200 ... 6135 ...".  We pass this directly to the
+    // freq_list network parameter so that wpa_supplicant only scans/connects on
+    // frequencies that the radio actually supports.
+    std::string freq_list;
+    {
+        char *reply = nullptr;
+        const std::string freq_cmd = "GET_FREQ_LIST";
+        if (!wpa_ctrl_send_msg(freq_cmd, &reply) || !reply) {
+            LOG(WARNING) << "GET_FREQ_LIST failed for interface " << sta_iface
+                         << ", proceeding without freq_list";
+        } else {
+            freq_list = std::string(reply);
+            // Trim trailing whitespace / newline characters that wpa_supplicant appends.
+            auto pos = freq_list.find_last_not_of(" \t\r\n");
+            if (pos != std::string::npos) {
+                freq_list.erase(pos + 1);
+            } else {
+                freq_list.clear();
+            }
+            if (!freq_list.empty()) {
+                LOG(DEBUG) << "GET_FREQ_LIST for " << sta_iface << ": " << freq_list;
+            }
+        }
+    }
+
     // Add a new network
     auto network_id = add_network();
     if (network_id < 0) {
@@ -771,6 +799,24 @@ bool sta_wlan_hal_nl80211::add_new_network(son::wireless_utils::sBssInfoConf bSt
         return false;
     }
 
+    // Set the FREQ_LIST obtained from GET_FREQ_LIST so that wpa_supplicant restricts
+    // scanning and association to the frequencies supported by this radio.
+    if (!freq_list.empty()) {
+        if (!set_network(network_id, "freq_list", freq_list)) {
+            LOG(WARNING) << "Failed setting FREQ_LIST on interface " << sta_iface
+                         << ", continuing without FREQ_LIST restriction";
+            // Non-fatal: proceed even if FREQ_LIST could not be set.
+        } else {
+            LOG(DEBUG) << "FREQ_LIST set for network " << network_id
+                       << " on interface " << sta_iface;
+        }
+    }
+
+    // Enable 4-address (WDS) mode for the backhaul STA network so that the
+    // wpa_supplicant uses 4-address frames on this link.
+    if (!set_network(network_id, "enable_4addr_mode", "1")) {
+        LOG(ERROR) << "Failed setting enable_4addr_mode on interface " << sta_iface;
+    }
 
     // Enable the network
     if (!enable_network(network_id)) {
-- 
