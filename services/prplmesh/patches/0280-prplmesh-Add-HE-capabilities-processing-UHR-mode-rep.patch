+#
+---
+
+_namespace: qca
+_include:
+  {
+    tlvf/ieee_1905_1/sVendorOUI.h,
+    tlvf/qca/eQcaTlvTypeMap.h,
+    tlvf/common/sMacAddr.h,
+  }
+
+# Vendor Specific QCA WiFi-8 / UHR Operating Mode TLV
+# Sent by the agent in AP_CAPABILITY_REPORT_MESSAGE.
+# Carries a per-radio UHR mode indicator derived from the configured
+# htmode UCI option (wireless.radioN.htmode starts with "UHR").
+# The controller writes Radio.{i}.X_QCA_UhrMode per radio to the DM.
+#
+# Wire format (tlvValue):
+#   - vendor_oui      : 3 octets  - Qualcomm OUI
+#   - tlv_id          : 2 octets  - QCA_WIFI8_CAPABILITIES (0x0005)
+#   - num_radio       : 1 octet   - Number of per-radio entries
+#   - [per radio, repeated num_radio times]:
+#       - ruid        : 6 octets  - Radio Unique Identifier
+#       - flags       : 1 octet   - Bit 7: uhr_mode, Bits 6-0: reserved
+
+tlvQcaWifi8Capabilities:
+  _type: class
+  _is_tlv_class: True
+  type:
+    _type: eQcaTlvTypeMap
+    _value_const: TLV_VENDOR_SPECIFIC
+  length: uint16_t
+  vendor_oui:
+    _type: sVendorOUI
+  tlv_id:
+    _type: uint16_t
+  num_radio:
+    _type: uint8_t
+    _length_var: True
+    _comment: "Number of per-radio entries"
+  radio_list:
+    _type: cQcaWifi8RadioEntry
+    _length: [ num_radio ]
+
+cQcaWifi8RadioEntry:
+  _type: class
+  ruid:
+    _type: sMacAddr
+    _comment: "Radio Unique Identifier"
+  flags:
+    _type: uint8_t
+    _comment: "Bit 7: uhr_mode (htmode starts with UHR), Bits 6-0: reserved"
