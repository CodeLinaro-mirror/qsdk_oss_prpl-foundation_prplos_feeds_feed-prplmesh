+// RECEIVE side: Parse QCA WiFi-8 capabilities TLV (per-radio).
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_wifi8_capabilities_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaWifi8Capabilities>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA WiFi-8 capabilities TLV";
+        return nullptr;
+    }
+    LOG(INFO) << "Parsed QCA WiFi-8 capabilities TLV: " << tlv->num_radio() << " radio(s)";
+    for (size_t i = 0; i < tlv->num_radio(); i++) {
+        auto result = tlv->radio_list(i);
+        if (std::get<0>(result)) {
+            cQcaWifi8RadioEntry &entry = std::get<1>(result);
+            bool uhr = (entry.flags() & 0x80) != 0;
+            LOG(DEBUG) << "  RUID=" << tlvf::mac_to_string(entry.ruid())
