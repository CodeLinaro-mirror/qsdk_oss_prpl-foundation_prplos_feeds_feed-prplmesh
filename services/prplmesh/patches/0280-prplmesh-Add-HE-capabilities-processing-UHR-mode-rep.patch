+bool bpl_cfg_get_radio_htmode(const std::string &iface, std::string &htmode)
+{
+    htmode.clear();
+
+    LOG(DEBUG) << "bpl_cfg_get_radio_htmode: gelumala iface=" << iface;
+
+    /* Build lookup candidates: try full name first, then strip MLD link suffix
+     * (e.g. "wlan1_link0" → "wlan1") to match the wifi-iface ifname. */
+    std::vector<std::string> candidates = {iface};
+    auto pos = iface.rfind("_link");
+    if (pos != std::string::npos) {
+        candidates.push_back(iface.substr(0, pos));
+    }
+
+    /* Also try mapping phy00.X to radio0_bandX format for new UCI structure */
+    if (iface.find("phy00.") == 0) {
+        std::string band_num = iface.substr(6); // Extract the band number after "phy00."
+        candidates.push_back("radio0_band" + band_num);
+        LOG(DEBUG) << "bpl_cfg_get_radio_htmode: added band candidate=radio0_band" << band_num;
+    }
+
+    for (const auto &candidate : candidates) {
+        LOG(DEBUG) << "bpl_cfg_get_radio_htmode: trying candidate=" << candidate;
+
+        /* First, try to read htmode directly from band section (new format: wireless.radio0_band0.htmode) */
+        if (uci_get_option("wireless", "", candidate, "htmode", htmode)) {
+            LOG(DEBUG) << "bpl_cfg_get_radio_htmode: iface=" << iface
+                       << " matched=" << candidate
+                       << " htmode=" << htmode << " (from band section)";
+            return true;
+        }
+
+        /* Step 1: find wireless.wifi-iface section whose ifname == candidate */
+        std::string iface_section;
+        if (!uci_find_section_by_option("wireless", "wifi-iface", "ifname",
+                                         candidate, iface_section) || iface_section.empty()) {
+            LOG(DEBUG) << "bpl_cfg_get_radio_htmode: no wifi-iface for ifname=" << candidate;
+            continue;
+        }
+        LOG(DEBUG) << "bpl_cfg_get_radio_htmode: found iface_section=" << iface_section;
+
+        /* Step 2: get the device (wifi-device section name) from that wifi-iface */
+        std::string device_section;
+        if (!uci_get_option("wireless", "wifi-iface", iface_section, "device",
+                             device_section) || device_section.empty()) {
+            LOG(DEBUG) << "bpl_cfg_get_radio_htmode: no device in section " << iface_section;
+            continue;
+        }
+        LOG(DEBUG) << "bpl_cfg_get_radio_htmode: found device_section=" << device_section;
+
+        /* Step 3: Try to read htmode from wireless.radio0_band0.htmode format first
+         * (band-specific htmode, e.g., wireless.radio0_band0.htmode) */
+        std::string band_section = device_section;
+        if (!band_section.empty()) {
+            if (uci_get_option("wireless", "", band_section, "htmode", htmode)) {
+                LOG(DEBUG) << "bpl_cfg_get_radio_htmode: iface=" << iface
+                           << " matched=" << candidate << " band_section=" << band_section
+                           << " htmode=" << htmode << " (from band section)";
+                return true;
+            }
+        }
+
+        /* Step 4: Fallback - read htmode from wireless.wifi-device.<device> */
+        if (!uci_get_option("wireless", "wifi-device", device_section, "htmode", htmode)) {
+            LOG(DEBUG) << "bpl_cfg_get_radio_htmode: no htmode for device " << device_section;
+            continue;
+        }
+        LOG(DEBUG) << "bpl_cfg_get_radio_htmode: iface=" << iface
+                   << " matched=" << candidate << " device=" << device_section
+                   << " htmode=" << htmode << " (from wifi-device)";
+        return true;
+    }
+    LOG(DEBUG) << "bpl_cfg_get_radio_htmode: failed to find htmode for iface=" << iface;
+    return false;
+}
