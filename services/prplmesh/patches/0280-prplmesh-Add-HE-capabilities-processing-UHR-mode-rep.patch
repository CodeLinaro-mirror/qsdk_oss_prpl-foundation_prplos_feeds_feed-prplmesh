+bool db::set_ap_he_capabilities(wfa_map::tlvApHeCapabilities &he_caps_tlv)
+{
+    auto radio = get_radio_by_uid(he_caps_tlv.radio_uid());
+    if (!radio) {
+        LOG(ERROR) << "Failed to get radio with RUID: " << he_caps_tlv.radio_uid();
+        return false;
+    }
+
+    LOG(DEBUG) << "set_ap_he_capabilities: processing HE capabilities for ruid=" << he_caps_tlv.radio_uid()
+               << " dm_path=" << radio->dm_path;
+
+    if (radio->dm_path.empty()) {
+        LOG(DEBUG) << "set_ap_he_capabilities: dm_path is empty, skipping";
+        return true;
+    }
+
+    bool ret_val = true;
+
+    // Extract MCS/NSS data from supported_he_mcs array
+    uint8_t mcs_length = he_caps_tlv.supported_he_mcs_length();
+    uint8_t *mcs_data = he_caps_tlv.supported_he_mcs(0);
+
+    LOG(DEBUG) << "set_ap_he_capabilities: mcs_length=" << (int)mcs_length;
+    if (mcs_data) {
+        LOG(DEBUG) << "set_ap_he_capabilities: mcs_data[0]=" << std::hex << (int)mcs_data[0]
+                   << " mcs_data[1]=" << (int)(mcs_length > 1 ? mcs_data[1] : 0) << std::dec;
+    }
+
+    if (mcs_data && mcs_length > 0) {
+        // Extract RX MCS/NSS (bytes 0-1)
+        uint16_t mcs_nss_rx = 0;
+        if (mcs_length >= 1) {
+            mcs_nss_rx = static_cast<uint16_t>(mcs_data[0]);
+        }
+        if (mcs_length >= 2) {
+            mcs_nss_rx |= (static_cast<uint16_t>(mcs_data[1]) << 8);
+        }
+        LOG(DEBUG) << "set_ap_he_capabilities: setting MCSNSSRxSet=" << std::hex << mcs_nss_rx << std::dec;
+        ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                             "MCSNSSRxSet", mcs_nss_rx);
+
+        // Extract TX MCS/NSS (bytes 2-3)
+        uint16_t mcs_nss_tx = 0;
+        if (mcs_length >= 3) {
+            mcs_nss_tx = static_cast<uint16_t>(mcs_data[2]);
+        }
+        if (mcs_length >= 4) {
+            mcs_nss_tx |= (static_cast<uint16_t>(mcs_data[3]) << 8);
+        }
+        LOG(DEBUG) << "set_ap_he_capabilities: setting MCSNSSTxSet=" << std::hex << mcs_nss_tx << std::dec;
+        ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                             "MCSNSSTxSet", mcs_nss_tx);
+    } else {
+        LOG(DEBUG) << "set_ap_he_capabilities: no MCS data to set";
+    }
+
+    // Extract flags1 bit-fields
+    auto &flags1 = he_caps_tlv.flags1();
+    uint8_t tx_ss = static_cast<uint8_t>(flags1.max_num_of_supported_tx_spatial_streams) + 1;
+    uint8_t rx_ss = static_cast<uint8_t>(flags1.max_num_of_supported_rx_spatial_streams) + 1;
+    LOG(DEBUG) << "set_ap_he_capabilities: flags1 tx_ss=" << (int)tx_ss
+               << " rx_ss=" << (int)rx_ss
+               << " he160=" << (int)flags1.he_support_160mhz
+               << " he80_80=" << (int)flags1.he_support_80_80mhz;
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "MaxNumberOfTxSpatialStreams", tx_ss);
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "MaxNumberOfRxSpatialStreams", rx_ss);
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "HE160", static_cast<bool>(flags1.he_support_160mhz));
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "HE8080", static_cast<bool>(flags1.he_support_80_80mhz));
+
+    // Extract flags2 bit-fields
+    auto &flags2 = he_caps_tlv.flags2();
+    LOG(DEBUG) << "set_ap_he_capabilities: flags2 su_bf=" << (int)flags2.su_beamformer_capable
+               << " mu_bf=" << (int)flags2.mu_beamformer_capable
+               << " ul_mimo=" << (int)flags2.ul_mu_mimo_capable
+               << " ul_ofdma=" << (int)flags2.ul_ofdm_capable
+               << " dl_ofdma=" << (int)flags2.dl_ofdm_capable;
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "SUBeamformer", static_cast<bool>(flags2.su_beamformer_capable));
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "MUBeamformer", static_cast<bool>(flags2.mu_beamformer_capable));
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "ULMUMIMO", static_cast<bool>(flags2.ul_mu_mimo_capable));
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "ULOFDMA", static_cast<bool>(flags2.ul_ofdm_capable));
+    ret_val &= m_ambiorix_datamodel->set(radio->dm_path + ".Capabilities.WiFi6APRole",
+                                         "DLOFDMA", static_cast<bool>(flags2.dl_ofdm_capable));
+
+    LOG(DEBUG) << "set_ap_he_capabilities: completed with ret_val=" << ret_val;
+    return ret_val;
