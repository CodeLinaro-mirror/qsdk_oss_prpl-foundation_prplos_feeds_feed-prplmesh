+}
+// SEND side: Add QCA WiFi-8 capabilities TLV (per-radio UHR mode).
+// One entry per radio registered via set_radio_wifi8_mode().
+// No TLV is added if no radio reported UHR mode.
+bool tlvf_qca_utils::add_qca_wifi8_capabilities_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    LOG(INFO) << "add_qca_wifi8_capabilities_tlv: gelumala";
+    if (s_radio_wifi8_modes.empty()) {
+        LOG(DEBUG) << "Skipping QCA WiFi-8 TLV: no radios registered";
+        return true;
+    }
+
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaWifi8Capabilities>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to add QCA WiFi-8 capabilities TLV";
+        s_radio_wifi8_modes.clear();
+        return false;
+    }
+
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+    tlv->tlv_id()     = static_cast<uint16_t>(qca::eQcaTlVId::QCA_WIFI8_CAPABILITIES);
+
+    for (const auto &entry : s_radio_wifi8_modes) {
+        auto radio_entry = tlv->create_radio_list();
+        if (!radio_entry) {
+            LOG(ERROR) << "Failed to create radio_list entry";
+            s_radio_wifi8_modes.clear();
+            return false;
+        }
+        std::copy(entry.ruid.begin(), entry.ruid.end(), radio_entry->ruid().oct);
+        radio_entry->flags() = entry.uhr_mode ? 0x80 : 0x00; /* bit 7: uhr_mode */
+        if (!tlv->add_radio_list(radio_entry)) {
+            LOG(ERROR) << "Failed to add radio_list entry";
+            s_radio_wifi8_modes.clear();
+            return false;
+        }
+        LOG(INFO) << "QCA WiFi-8 TLV: RUID=" << tlvf::mac_to_string(radio_entry->ruid())
+                  << " uhr_mode=" << (entry.uhr_mode ? "true" : "false");
+    }
+
+    LOG(INFO) << "Added QCA WiFi-8 capabilities TLV: " << s_radio_wifi8_modes.size() << " radio(s)";
+    s_radio_wifi8_modes.clear();
+    return true;
+}
+
+void tlvf_qca_utils::set_radio_wifi8_mode(const uint8_t *ruid_bytes, bool uhr_mode)
+{
+    if (!ruid_bytes) return;
+    sRadioWifi8Mode entry;
+    std::copy(ruid_bytes, ruid_bytes + 6, entry.ruid.begin());
+    entry.uhr_mode = uhr_mode;
+    LOG(INFO) << "set_radio_wifi8_mode: gelumala";
+    s_radio_wifi8_modes.push_back(entry);
+}
+
+void tlvf_qca_utils::clear_radio_wifi8_modes()
+{
+    s_radio_wifi8_modes.clear();
+}
