@@ -123,5 +123,11 @@ bool get_ruid_chipset_vendor(const sMacAddr &ruid, std::string &chipset_vendor)
     return false;
 }
 
+bool cfg_get_dhcp_gateway_ip(std::string &gw_ip)
+{
