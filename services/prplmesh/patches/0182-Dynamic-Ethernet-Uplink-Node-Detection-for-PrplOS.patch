 bool cfg_set_wifi_iface_multi_ap_vlanid(const std::string &iface_name, uint16_t vlanid);
 
+/**
+ * @brief Retrieves the gateway IP address from DHCP configuration.
+ *
+ * For PrplOS (USE_PRPLMESH_NLHAL): Queries Device.DHCPv4.Client.*.DHCPServer
+ * where Device.DHCPv4.Client.*.Enable is set to true.
+ * For OpenWrt: Uses ip route command to get default gateway.
+ *
+ * @param [out] gw_ip Gateway IP address.
+ * @return true on success, false otherwise.
+ */
+bool cfg_get_dhcp_gateway_ip(std::string &gw_ip);
+
