diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
index 5d47642bf..30b0f5d9b 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg.cpp
@@ -711,5 +711,54 @@ bool cfg_set_wifi_iface_multi_ap_vlanid(const std::string &iface_name, uint16_t
     return true;
 }
 
+bool cfg_get_dhcp_gateway_ip(std::string &gw_ip)
+{
+    // Resolve all Device.DHCPv4.Client.* instance paths
+    std::vector<std::string> client_paths;
+    if (!m_ambiorix_cl_ubus.resolve_path_multi("Device.DHCPv4.Client.*", client_paths)) {
+        MAPF_ERR("cfg_get_dhcp_gateway_ip: Failed to resolve Device.DHCPv4.Client paths");
+        return false;
+    }
+
+    if (client_paths.empty()) {
+        MAPF_ERR("cfg_get_dhcp_gateway_ip: No Device.DHCPv4.Client instances found");
+        return false;
+    }
+
+    // Iterate through all DHCPv4.Client instances to find enabled one with gateway IP
+    for (const auto &client_path : client_paths) {
+        MAPF_DBG("cfg_get_dhcp_gateway_ip: Checking client path: " << client_path);
+
+        // Check if Enable parameter is true
+        bool enabled = false;
+        if (!m_ambiorix_cl_ubus.get_param(enabled, client_path, "Enable")) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Failed to read Enable for " << client_path);
+            continue;
+        }
+
+        if (!enabled) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Client " << client_path << " is not enabled");
+            continue;
+        }
+
+        // Read DHCPServer parameter (gateway IP)
+        std::string dhcp_server;
+        if (!m_ambiorix_cl_ubus.get_param(dhcp_server, client_path, "DHCPServer")) {
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Failed to read DHCPServer for " << client_path);
+            continue;
+        }
+
+        if (!dhcp_server.empty()) {
+            gw_ip = dhcp_server;
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Found gateway IP: " << gw_ip << " from "
+                                                                    << client_path);
+            return true;
+        }
+    }
+
+    MAPF_ERR("cfg_get_dhcp_gateway_ip: No enabled DHCP client with gateway IP found");
+    return false;
+}
+
 } // namespace bpl
 } // namespace beerocks
diff --git a/framework/platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp b/framework/platform/bpl/cfg/dummy/bpl_cfg_dummy.cpp
