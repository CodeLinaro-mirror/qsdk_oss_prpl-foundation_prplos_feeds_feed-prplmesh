diff --git a/framework/platform/bpl/cfg/linux/bpl_cfg.cpp b/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
index cf6371148..8a3a5d54e 100644
--- a/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/linux/bpl_cfg.cpp
@@ -1041,5 +1041,27 @@ bool cfg_set_wifi_iface_multi_ap_vlanid(const std::string &iface_name, uint16_t
     return true;
 }
 
+bool cfg_get_dhcp_gateway_ip(std::string &gw_ip)
+{
+    std::string cmd = "ip r | awk '/^def/{print $3}'";
+    FILE *fp = popen(cmd.c_str(), "r");
+    if (fp) {
+        char buffer[128];
+        if (fgets(buffer, sizeof(buffer), fp) != nullptr) {
+            gw_ip = buffer;
+            gw_ip.erase(gw_ip.find_last_not_of(" \n\r\t") + 1);
+            MAPF_DBG("cfg_get_dhcp_gateway_ip: Command output [" << cmd << "]: " << gw_ip);
+        }
+        pclose(fp);
+    }
+
+    if (gw_ip.empty()) {
+        MAPF_ERR("cfg_get_dhcp_gateway_ip: Could not resolve gateway IP from command: " << cmd);
+        return false;
+    }
+
+    return true;
+}
+
 } // namespace bpl
 } // namespace beerocks
