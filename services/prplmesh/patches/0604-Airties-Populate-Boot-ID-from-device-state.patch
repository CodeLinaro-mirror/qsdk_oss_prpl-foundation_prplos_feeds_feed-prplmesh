+++ b/common/beerocks/multi_vendor/airties/src/tlvf_airties_utils.cpp
@@ -12,6 +12,7 @@
 #include <bcl/beerocks_utils.h>
 #include <bcl/network/network_utils.h>
 #include <bcl/son/son_wireless_utils.h>
+#include <bpl/bpl_cfg.h>
 #include <bpl/common/utils/utils.h>
 #include <algorithm>
 #include <cstdio>
@@ -38,6 +39,32 @@ using namespace airties;
 using namespace beerocks;
 using namespace wbapi;
 
+namespace {
+
+uint32_t get_airties_boot_id()
+{
+    std::string boot_id_str;
+    if (!beerocks::bpl::cfg_get_device_boot_id(boot_id_str) || boot_id_str.empty()) {
+        LOG(WARNING) << "Airties DeviceInfo: could not read device boot ID, using fallback boot_id=1";
+        return 1;
+    }
+
+    uint32_t boot_id = 0;
+    for (const auto c : boot_id_str) {
+        boot_id = (boot_id << 8) | static_cast<uint8_t>(c);
+    }
+    if (!boot_id) {
+        LOG(WARNING) << "Airties DeviceInfo: device boot ID converted to zero, using fallback boot_id=1";
+        return 1;
+    }
+
+    LOG(DEBUG) << "Airties DeviceInfo: using device boot ID length=" << boot_id_str.length()
+               << ", boot_id=" << boot_id;
+    return boot_id;
+}
+
