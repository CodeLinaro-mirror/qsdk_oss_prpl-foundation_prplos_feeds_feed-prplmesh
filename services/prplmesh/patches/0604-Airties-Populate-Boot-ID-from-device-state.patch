index a0117157d..32dda3516 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_device_info.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_device_info.cpp
@@ -112,5 +112,39 @@ bool cfg_get_client_password(std::string &client_password)
     return false;
 }
 
+bool cfg_get_device_boot_id(std::string &boot_id)
+{
+    constexpr const char reboots_path[] = "Device.DeviceInfo.Reboots.";
+
+    auto reboots_obj = m_ambiorix_cl_ubus.get_object(reboots_path);
+    if (!reboots_obj) {
+        LOG(WARNING) << "Failed to get DeviceInfo Reboots object";
+        return false;
+    }
+
+    uint32_t reboot_entries = 0;
+    std::string timestamp;
+
+    if (!reboots_obj->read_child(reboot_entries, "RebootNumberOfEntries") || reboot_entries == 0) {
+        LOG(WARNING) << "DeviceInfo Reboots object has no reboot entries";
+        return false;
+    }
+
+    auto reboot_obj = m_ambiorix_cl_ubus.get_object(std::string(reboots_path) + "Reboot." +
+                                                    std::to_string(reboot_entries) + ".");
+    if (!reboot_obj || !reboot_obj->read_child(timestamp, "TimeStamp")) {
+        LOG(WARNING) << "Failed to read latest DeviceInfo Reboot timestamp";
+        return false;
+    }
+
+    if (timestamp.empty()) {
+        LOG(WARNING) << "Latest DeviceInfo Reboot entry has no timestamp";
+        return false;
+    }
+
+    boot_id = timestamp;
+    return true;
+}
+
