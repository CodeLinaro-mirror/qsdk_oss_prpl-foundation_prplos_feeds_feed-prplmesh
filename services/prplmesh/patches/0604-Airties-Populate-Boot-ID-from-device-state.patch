 #include <mapf/common/logger.h>
 
 #include "bpl_cfg_helper.h"
@@ -113,6 +114,17 @@ bool cfg_get_client_password(std::string &client_password)
     return get_prplmesh_config_string("client_password", client_password);
 }
 
+bool cfg_get_device_boot_id(std::string &boot_id)
+{
+    std::ifstream boot_id_file("/proc/sys/kernel/random/boot_id");
+
+    if (!std::getline(boot_id_file, boot_id) || boot_id.empty()) {
+        return false;
+    }
+
+    return true;
+}
