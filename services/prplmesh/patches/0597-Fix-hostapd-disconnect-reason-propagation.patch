-        const auto sta_mac   = tlvf::mac_to_string(msg->params.mac);
-        const auto cache_key = std::to_string(vap_id) + ":" + sta_mac;
-        const auto reason_it = m_pending_disconnection_reasons.find(cache_key);
-        if (reason_it != m_pending_disconnection_reasons.end()) {
-            const auto reason_age = std::chrono::steady_clock::now() - reason_it->second.received_at;
-            if (reason_age <= PENDING_DISCONNECTION_REASON_MAX_AGE) {
-                msg->params.reason = reason_it->second.reason;
-                LOG(DEBUG) << "Using cached disconnect reason=" << msg->params.reason
-                           << " for STA " << sta_mac << " on vap_id=" << vap_id;
-            } else {
-                LOG(DEBUG) << "Discarding stale disconnect reason for STA " << sta_mac
-                           << " on vap_id=" << vap_id;
+        const auto sta_mac = tlvf::mac_to_string(msg->params.mac);
+
+        // Prefer the reason carried by hostapd's AP-STA-DISCONNECTED event. The generic
+        // event parser stores key=value fields in parsed_obj, but this handler must explicitly
+        // propagate the reason into the notification consumed by the AP manager.
+        const auto event_reason_it = parsed_obj.find("reason");
+        if (event_reason_it != parsed_obj.end() && !event_reason_it->second.empty()) {
+            msg->params.reason = static_cast<uint16_t>(
+                beerocks::string_utils::stoi(event_reason_it->second));
+            LOG(DEBUG) << "Using hostapd disconnect reason=" << msg->params.reason
+                       << " for STA " << sta_mac << " on vap_id=" << vap_id;
+        } else {
+            // Fall back to the cached on-air reason for client-originated disconnect frames.
+            const auto cache_key = std::to_string(vap_id) + ":" + sta_mac;
+            const auto reason_it = m_pending_disconnection_reasons.find(cache_key);
+            if (reason_it != m_pending_disconnection_reasons.end()) {
+                const auto reason_age =
+                    std::chrono::steady_clock::now() - reason_it->second.received_at;
+                if (reason_age <= PENDING_DISCONNECTION_REASON_MAX_AGE) {
+                    msg->params.reason = reason_it->second.reason;
+                    LOG(DEBUG) << "Using cached disconnect reason=" << msg->params.reason
+                               << " for STA " << sta_mac << " on vap_id=" << vap_id;
+                } else {
+                    LOG(DEBUG) << "Discarding stale disconnect reason for STA " << sta_mac
+                               << " on vap_id=" << vap_id;
+                }
+                // Do not erase on use: hostapd reports AP-STA-DISCONNECTED on both the global
+                // and the per-VAP control sockets and each one is forwarded as a separate
+                // disconnect event, so the duplicate must see the same reason. Entries expire
+                // by age instead.
             }
-            // Do not erase on use: hostapd reports AP-STA-DISCONNECTED on both the global and
-            // the per-VAP control sockets and each one is forwarded as a separate disconnect
-            // event, so the duplicate must see the same reason. Entries expire by age instead.
         }
 
         // Add the message to the queue
