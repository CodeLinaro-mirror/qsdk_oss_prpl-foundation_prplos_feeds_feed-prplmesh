                 if (!response) {
-                    LOG(ERROR) << "Failed building WIFI_CREDENTIALS_UPDATE_RESPONSE RECONSTRA";
+                    LOG(ERROR) << "Failed building WIFI_CREDENTIALS_UPDATE_RESPONSE";
