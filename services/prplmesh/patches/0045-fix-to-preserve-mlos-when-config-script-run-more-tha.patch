From 8753314e0d005ce3003867b09b9425d374916739 Mon Sep 17 00:00:00 2001
From: Hemanth Krishna Srirama <hsrirama@qti.qualcomm.com>
Date: Fri, 24 Oct 2025 20:28:04 +0530
Subject: [PATCH] fix to preserve mlos when config script run more than one
 time

Signed-off-by: Hemanth Krishna Srirama <hsrirama@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 5eac1d0..1a94c9d 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -633,12 +633,15 @@ bool ap_wlan_hal_whm::update_vap_credentials(
 
         // Skip update if no changes for FronthaulBSS/BackhaulBSS
         std::string current_ssid, current_password, current_mode;
+	     int8_t current_mldID = -1;
         m_ambiorix_cl.get_param(current_ssid, wifi_ssid_path, "SSID");
         m_ambiorix_cl.get_param(current_password, wifi_vap_path + "Security.", "KeyPassPhrase");
         m_ambiorix_cl.get_param(current_mode, wifi_vap_path + "Security.", "ModeEnabled");
+	     m_ambiorix_cl.get_param(current_mldID, wifi_ssid_path, "MLDUnit");
         if (current_ssid == bss_info_conf.ssid && current_password == bss_info_conf.network_key &&
             current_mode ==
-                wbapi_utils::security_mode_to_string(bss_info_conf.authentication_type)) {
+                wbapi_utils::security_mode_to_string(bss_info_conf.authentication_type) &&
+		         current_mldID == bss_info_conf.mld_id) {
             LOG(DEBUG) << "No changes detected for " << ifname
                        << ". Skipping update for VAP: " << wifi_vap_path;
             continue; // Skip updating this VAP
-- 
2.34.1

