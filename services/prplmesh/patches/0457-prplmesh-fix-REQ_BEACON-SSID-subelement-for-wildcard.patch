From c8e9d28e19555fb02fbb45ef8671d7c1e10397c3 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Tue, 29 Sep 2026 15:40:07 +0530
Subject: [PATCH] [prplmesh] fix REQ_BEACON SSID subelement for wildcard BSSID
 surveys

Two fixes to sta_beacon_11k_request() in mon_wlan_hal_nl80211.cpp:

1. Wildcard-BSSID SSID subelement guard

   When the caller issues a beacon request with BSSID=ff:ff:ff:ff:ff:ff
   and no explicit SSID (use_optional_ssid=0 or ssid[0]=='\0'), the
   previous code fell through to the VAP-lookup fallback and injected
   the local BSS's SSID into the request.  This incorrectly narrows an
   "any AP" survey (e.g. Airties DV Command-1) to only the AP whose
   SSID was guessed, causing the STA to report measurements only for
   that AP instead of all visible APs.

   Fix: gate the VAP-lookup fallback on !is_wildcard_bssid.  A wildcard
   BSSID with no caller-supplied SSID now produces a REQ_BEACON with no
   SSID subelement, which is the correct wire format for an unfiltered
   neighbor survey.  The existing behaviour for specific BSSIDs (inject
   best-effort SSID for strict clients like iPhones) is unchanged.

2. Consolidated REQ_BEACON log line

   Replace the two separate LOG(DEBUG) statements ("__func__ - cmd" and
   "Beacon Metric Query - Hostapd command preparation") with a single
   "REQ_BEACON framed:" line that covers every field that went into the
   wire command: sta_mac, bssid (with wildcard annotation), ssid,
   op_class, channel, rand_ival, duration, measurement_mode, req_mode
   (with parallel/enable/request/report/mandatory_duration breakdown),
   reporting_detail, ap_ch_report_len, interface, base_interface,
   link_id, and the raw cmd hex.  A single grep on "REQ_BEACON framed"
   is now sufficient to reconstruct any beacon request from logs without
   decoding the raw hex by hand.

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 .../bwl/nl80211/mon_wlan_hal_nl80211.cpp      | 48 +++++++++++--------
 1 file changed, 29 insertions(+), 19 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
index f825ad5fb..318d2e5d2 100644
--- a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
@@ -1111,15 +1111,18 @@ bool mon_wlan_hal_nl80211::sta_beacon_11k_request(const std::string &vap_iface_n
     // Trust the SSID already resolved upstream (req.ssid) when the caller supplied one -
     // it reflects the SSID actually requested in the 1905 Beacon Metrics Query TLV.
     // Only fall back to looking it up from VAP info (first VAP on this base interface with
-    // a non-empty SSID) when the caller didn't supply one, so a beacon request is still sent
-    // with a best-effort SSID subelement for strict clients like iPhones that refuse beacon
-    // requests without one (causes "Invalid 11k report length!" on response parsing).
+    // a non-empty SSID) when the caller didn't supply one AND the request targets a specific
+    // BSSID, so a beacon request is still sent with a best-effort SSID subelement for strict
+    // clients like iPhones that refuse beacon requests without one (causes "Invalid 11k report
+    // length!" on response parsing). For a wildcard BSSID with no caller-supplied SSID, the
+    // caller wants an unfiltered "any AP" survey (e.g. Airties DV Command-1) - injecting a
+    // locally-guessed SSID here would incorrectly narrow that survey.
     std::string ssid_for_request;
     if (req.use_optional_ssid && req.ssid[0] != '\0') {
         ssid_for_request = std::string(reinterpret_cast<const char *>(req.ssid),
                                        strnlen(reinterpret_cast<const char *>(req.ssid),
                                                sizeof(req.ssid)));
-    } else {
+    } else if (!is_wildcard_bssid) {
         std::string base_target_iface;
         extractBase1Interface(vap_iface_name, base_target_iface);
         for (const auto &vap : m_radio_info.available_vaps) {
@@ -1192,21 +1195,28 @@ bool mon_wlan_hal_nl80211::sta_beacon_11k_request(const std::string &vap_iface_n
         }
     }
 
-    // Print the command
-    LOG(DEBUG) << __func__ << " - " << cmd;
-
-    LOG(DEBUG) << "Beacon Metric Query - Hostapd command preparation: "
-                << "sta_mac=" << tlvf::mac_to_string(req.sta_mac.oct)
-                << ", bssid=" << tlvf::mac_to_string(req.bssid.oct)
-                << ", op_class=" << int(op_class)
-                << ", channel=" << int(req.channel)
-                << ", duration=" << measurement_duration << " TU (config-driven)"
-                << ", measurement_mode=" << int(measurement_mode)
-                << ", req_mode=0x" << std::hex << int(req_mode) << std::dec
-                << ", interface=" << vap_iface_name
-                << ", base_interface=" << base_vap_iface
-                << ", link_id=" << int(link_id)
-                << ", cmd=[" << cmd << "]";
+    // Framed REQ_BEACON command summary - single line covering every field that went
+    // into the wire command, so a support/driver-team log grep on "REQ_BEACON framed"
+    // is enough to reconstruct the request without decoding the raw hex by hand.
+    LOG(DEBUG) << "REQ_BEACON framed: sta_mac=" << tlvf::mac_to_string(req.sta_mac.oct)
+               << ", bssid=" << tlvf::mac_to_string(req.bssid.oct)
+               << (is_wildcard_bssid ? " (wildcard)" : " (specific)")
+               << ", ssid=" << (ssid_for_request.empty() ? "<none>" : ssid_for_request)
+               << ", op_class=" << int(op_class)
+               << ", channel=" << int(req.channel)
+               << ", rand_ival=" << req.rand_ival
+               << ", duration=" << measurement_duration << " TU (config-driven)"
+               << ", measurement_mode=" << int(measurement_mode)
+               << ", req_mode=0x" << std::hex << int(req_mode) << std::dec
+               << " (parallel=" << int(req.parallel) << ", enable=" << int(req.enable)
+               << ", request=" << int(request) << ", report=" << int(report)
+               << ", mandatory_duration=" << int(req.mandatory_duration) << ")"
+               << ", reporting_detail=" << int(req.reporting_detail)
+               << ", ap_ch_report_len=" << int(req.use_optional_ap_ch_report)
+               << ", interface=" << vap_iface_name
+               << ", base_interface=" << base_vap_iface
+               << ", link_id=" << int(link_id)
+               << ", cmd=[" << cmd << "]";
 
     // Send REQ_BEACON to link interfaces, trying the STA's resolved associated
     // link first (preferred_link_idx, computed above) and only falling back to
-- 
