+bool db::dm_set_channel_preference(
+    const std::shared_ptr<wfa_map::tlvChannelPreference> &channel_preference_tlv)
+{
+    const auto &radio_uid = channel_preference_tlv->radio_uid();
+    auto radio            = get_radio_by_uid(radio_uid);
+    if (!radio) {
+        LOG(ERROR) << "Failed to get Radio Object with uid: " << radio_uid;
+        return false;
+    }
+
+    if (radio->dm_path.empty()) {
+        return true;
+    }
+
+    const std::string channel_preference_path = radio->dm_path + ".ChannelPreference";
+
+    // Clear existing ChannelPreference instances before repopulating
+    if (!m_ambiorix_datamodel->remove_all_instances(channel_preference_path)) {
+        LOG(ERROR) << "Failed to remove all instances of " << channel_preference_path;
+        return false;
+    }
+
+    // Iterate over operating classes in the TLV and populate the data model
+    for (size_t i = 0; i < channel_preference_tlv->operating_classes_list_length(); i++) {
+        if (!std::get<0>(channel_preference_tlv->operating_classes_list(i))) {
+            LOG(ERROR) << "Invalid operating class entry at index " << i
+                       << " in tlvChannelPreference for radio " << radio_uid;
+            continue;
+        }
+
+        auto &operating_class = std::get<1>(channel_preference_tlv->operating_classes_list(i));
+        const auto op_cls_num = operating_class.operating_class();
+        const auto &flags     = operating_class.flags();
+
+        auto instance_path = m_ambiorix_datamodel->add_instance(channel_preference_path);
+        if (instance_path.empty()) {
+            LOG(ERROR) << "Failed to add ChannelPreference instance for operating class "
+                       << int(op_cls_num) << " on radio " << radio_uid;
+            return false;
+        }
+
+        bool ret_val = true;
+        ret_val &= m_ambiorix_datamodel->set(instance_path, "OperatingClass", op_cls_num);
+        ret_val &= m_ambiorix_datamodel->set(instance_path, "Preference", flags.preference);
+        ret_val &= m_ambiorix_datamodel->set(instance_path, "ReasonCode", flags.reason_code);
+
+        if (!ret_val) {
+            LOG(ERROR) << "Failed to set ChannelPreference fields for operating class "
+                       << int(op_cls_num) << " on radio " << radio_uid;
+            return false;
+        }
+
+        // Populate the Channel sub-list for this operating class
+        const auto channel_list_path = instance_path + ".Channel";
+        const auto channel_count     = operating_class.channel_list_length();
+
+        for (int ch_idx = 0; ch_idx < channel_count; ch_idx++) {
+            auto channel_ptr = operating_class.channel_list(ch_idx);
+            if (!channel_ptr) {
+                LOG(ERROR) << "Failed to get channel at index " << ch_idx << " for operating class "
+                           << int(op_cls_num) << " on radio " << radio_uid;
+                continue;
+            }
+
+            auto channel_instance = m_ambiorix_datamodel->add_instance(channel_list_path);
+            if (channel_instance.empty()) {
+                LOG(ERROR) << "Failed to add Channel instance under " << channel_list_path
+                           << " for operating class " << int(op_cls_num) << " on radio "
+                           << radio_uid;
+                return false;
+            }
+
+            if (!m_ambiorix_datamodel->set(channel_instance, "Channel",
+                                           static_cast<uint32_t>(*channel_ptr))) {
+                LOG(ERROR) << "Failed to set Channel value " << int(*channel_ptr)
+                           << " for operating class " << int(op_cls_num) << " on radio "
+                           << radio_uid;
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
