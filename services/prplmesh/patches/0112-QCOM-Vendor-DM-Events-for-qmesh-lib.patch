+/**
+ * @brief Initiates setting Channel Selection parameters with the Creation TLV at the current Radio and the given parameters
+ *
+ * Example of usage:
+ * ubus call Device.WiFi.DataElements.Network.Device.1.Radio.1 ChannelSelectionRequest
+ * '{"Class":{"1": {"Channel": {"1": {"Channel":1,"Preference":1}}, "OpClass":81}}}'
+ *
+ */
+amxd_status_t channel_selection_request(amxd_object_t *object, amxd_function_t *func,
+                                        amxc_var_t *args, amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "Failed to get controller context.";
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_t radio_mac;
+    amxc_var_init(&radio_mac);
+    amxd_object_get_param(object, "ID", &radio_mac);
+    std::string radio_mac_str = amxc_var_constcast(cstring_t, &radio_mac);
+    amxc_var_clean(&radio_mac);
+
+    if (radio_mac_str.empty()) {
+        LOG(ERROR) << "radio_mac is empty";
+        return amxd_status_parameter_not_found;
+    }
+
+    sMacAddr radio_uid = tlvf::mac_from_string(radio_mac_str);
+    amxc_var_clean(ret);
+
+    std::unordered_map<uint16_t /* opclass 0xff00, preference 0x00ff */,
+                       std::vector<uint8_t> /* channels */
+                       >
+        preference_map;
+
+    const amxc_var_t *classes = GET_ARG(args, "Class");
+    amxc_var_for_each(class_instance, classes)
+    {
+        amxc_var_t *opclass_var = GET_ARG(class_instance, "OpClass");
+        amxc_var_t *channel_var = GET_ARG(class_instance, "Channel");
+        if (opclass_var == NULL)
+            continue;
+
+        const uint32_t opclass_val = amxc_var_dyncast(uint32_t, opclass_var);
+        if (opclass_val > 255) {
+            LOG(WARNING) << "OpClass value " << opclass_val << " is out of range";
+            return amxd_status_invalid_arg;
+        }
+
+        if (channel_var) {
+            const amxc_var_t *channels = channel_var;
+            amxc_var_for_each(channel_instance, channels)
+            {
+                amxc_var_t *channel_num_var  = GET_ARG(channel_instance, "Channel");
+                amxc_var_t *channel_pref_var = GET_ARG(channel_instance, "Preference");
+                if (channel_num_var == NULL)
+                    continue;
+                if (channel_pref_var == NULL)
+                    continue;
+
+                const uint32_t channel_num = amxc_var_dyncast(uint32_t, channel_num_var);
+                const uint32_t pref        = amxc_var_dyncast(uint32_t, channel_pref_var);
+
+                if (channel_num > 255) {
+                    LOG(WARNING) << "Channel number value " << channel_num << " is out of range";
+                    return amxd_status_invalid_arg;
+                }
+
+                if (pref > 15) {
+                    LOG(WARNING) << "Preference value " << pref << " is out of range";
+                    return amxd_status_invalid_arg;
+                }
+
+                const uint16_t pref_key = (opclass_val << 8) | pref;
+                preference_map[pref_key].push_back((uint8_t)channel_num);
+            }
+        }
+    }
+
+    /* This virtually compresses the per-channel preferences
+     * into per-opclass preferences. Not only reduces the
+     * report size on the wire, it makes it easier to
+     * inspect too.
+     */
+    std::vector<std::tuple<uint8_t, uint8_t, std::vector<uint8_t>>> preferences;
+    for (const auto &preference : preference_map) {
+        const uint8_t op_class                 = preference.first >> 8;
+        const uint8_t preference_value         = preference.first & 0x00FF;
+        const std::vector<uint8_t> it_channels = preference.second;
+        std::stringstream channel_ss;
+        for (const auto &chan : it_channels) {
+            channel_ss << std::to_string((uint32_t)chan) << " ";
+        }
+        std::string channels_str = channel_ss.str();
+        LOG(DEBUG) << "Final preference to send: "
+                   << "Radio: " << radio_mac_str << " OpClass: " << (uint32_t)op_class
+                   << " Preference: " << (uint32_t)preference_value
+                   << " Channels: " << channels_str;
+        const std::tuple<uint8_t, uint8_t, std::vector<uint8_t>> channel_preference = {
+            (uint8_t)op_class, preference_value, it_channels};
+        preferences.push_back(channel_preference);
+    }
+
+    if (!controller_ctx->trigger_channel_selection_request(radio_uid, preferences)) {
+        LOG(ERROR) << "Failed to set channel selection parameters";
+        return amxd_status_unknown_error;
+    }
+
+    return amxd_status_ok;
+}
+
+/**
+ * @brief Initiate channel scan request from NBAPI for given radio with optional parameters.
+ *
+ * Example of usage (scan all channels with default dwell time):
+ * ubus call Device.WiFi.DataElements.Network.Device.1.Radio.1 TriggerChannelScanRequest
+ *
+ * Example of usage (scan specific channels with custom dwell time):
+ * ubus call Device.WiFi.DataElements.Network.Device.1.Radio.1 TriggerChannelScanRequest
+ * '{"channels_list": "36,44", "dwell_time_ms": 100}'
+ *
+ * Per Multi-AP spec section 17.1.x, sends a Channel Scan Request message to the agent.
+ * The agent will perform a fresh scan and return results via Channel Scan Report.
+ * If no channels are specified, all supported channels of the radio are scanned.
+ */
+amxd_status_t trigger_channel_scan_request(amxd_object_t *object, amxd_function_t *func,
+                                           amxc_var_t *args, amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "Failed to get controller context.";
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_t value;
+    amxc_var_init(&value);
+    amxd_object_get_param(object, "ID", &value);
+    std::string radio_mac = amxc_var_constcast(cstring_t, &value);
+    amxc_var_clean(&value);
+
+    if (radio_mac.empty()) {
+        LOG(ERROR) << "radio_mac is empty";
+        return amxd_status_parameter_not_found;
+    }
+
+    // Get optional dwell time (use PREFERRED_DWELLTIME_MS if not provided or zero)
+    int dwell_time_ms =
+        static_cast<int>(amxc_var_dyncast(uint32_t, GET_ARG(args, "dwell_time_ms")));
+    if (dwell_time_ms <= 0) {
+        dwell_time_ms = PREFERRED_DWELLTIME_MS;
+    }
+
+    // Parse optional channels list; empty means scan all supported channels
+    std::array<uint8_t, beerocks::message::SUPPORTED_CHANNELS_LENGTH> channel_pool = {};
+    uint8_t pool_size                                                              = 0;
+
+    const char *channels_list_cstr = GET_CHAR(args, "channels_list");
+    if (channels_list_cstr && channels_list_cstr[0] != '\0') {
+        std::string channels_list(channels_list_cstr);
+        std::vector<std::string> channels_vec =
+            beerocks::string_utils::str_split(channels_list, ',');
+        for (const auto &channel_str : channels_vec) {
+            if (pool_size >= beerocks::message::SUPPORTED_CHANNELS_LENGTH) {
+                LOG(WARNING) << "Channel pool is full, ignoring remaining channels";
+                break;
+            }
+            int channel_num = atoi(channel_str.c_str());
+            if (channel_num < std::numeric_limits<uint8_t>::min() ||
+                channel_num > std::numeric_limits<uint8_t>::max() || channel_num <= 0) {
+                LOG(ERROR) << "Channel #" << channel_num << " is out of range.";
+                return amxd_status_unknown_error;
+            }
+            channel_pool[pool_size++] = static_cast<uint8_t>(channel_num);
+        }
+    }
+
+    LOG(INFO) << "NBAPI TriggerChannelScanRequest for radio: " << radio_mac
+              << ", channels: " << (pool_size == 0 ? "all" : std::to_string(pool_size))
+              << ", dwell_time_ms: " << dwell_time_ms;
+
+    if (!controller_ctx->trigger_scan(tlvf::mac_from_string(radio_mac), channel_pool, pool_size,
+                                      dwell_time_ms)) {
+        LOG(ERROR) << "Failed to trigger channel scan request from NBAPI for radio: " << radio_mac;
+        return amxd_status_unknown_error;
+    }
+
+    return amxd_status_ok;
+}
+
+/**
+ * @brief Initiate channel preference query from NBAPI for given radio.
+ *
+ * Example of usage:
+ * ubus call Device.WiFi.DataElements.Network.Device.1.Radio.1 TriggerChannelPreferenceQuery
+ *
+ * This will send a Channel Preference Query message to the agent per Multi-AP spec section 17.1.9.
+ * The agent shall respond within one second with a Channel Preference Report message.
+ */
+amxd_status_t trigger_channel_preference_query(amxd_object_t *object, amxd_function_t *func,
+                                               amxc_var_t *args, amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "Failed to get controller context.";
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_t value;
+
+    amxc_var_init(&value);
+    amxd_object_get_param(object, "ID", &value);
+    std::string radio_mac = amxc_var_constcast(cstring_t, &value);
+    amxc_var_clean(&value);
+
+    if (radio_mac.empty()) {
+        LOG(ERROR) << "radio_mac is empty";
+        return amxd_status_parameter_not_found;
+    }
+
+    if (!controller_ctx->trigger_channel_preference_query(tlvf::mac_from_string(radio_mac))) {
+        LOG(ERROR) << "Failed to trigger channel preference query from NBAPI for radio: "
+                   << radio_mac;
+        return amxd_status_unknown_error;
+    }
+
+    return amxd_status_ok;
+}
+
 // Events
 
 /**
@@ -1413,7 +1645,16 @@ std::vector<beerocks::nbapi::sFunctions> get_func_list(void)
          remove_unassociated_station},
         {"update_unassociatedStations_stats",
          DATAELEMENTS_ROOT_DM ".Network.UpdateUnassociatedStationsStats",
-         update_unassociatedStations_stats}};
+         update_unassociatedStations_stats},
+        {"channel_selection_request",
+         DATAELEMENTS_ROOT_DM ".Network.Device.Radio.ChannelSelectionRequest",
+         channel_selection_request},
+        {"trigger_channel_preference_query",
+         DATAELEMENTS_ROOT_DM ".Network.Device.Radio.ChannelPreferenceQuery",
+         trigger_channel_preference_query},
+        {"trigger_channel_scan_request",
+         DATAELEMENTS_ROOT_DM ".Network.Device.Radio.ChannelScanRequest",
+         trigger_channel_scan_request}};
     return functions_list;
 }
 
