+bool AmbiorixImpl::trigger_event_with_data(const std::string &object_path,
+                                           const std::string &event_name, void *event_data)
+{
+    amxd_object_t *event_obj = find_object(object_path);
+    if (!event_obj) {
+        LOG(ERROR) << "Failed to find event object at path: " << object_path;
+        return false;
+    }
+
+    // Cast void* to amxc_var_t* for the Ambiorix API
+    amxc_var_t *data = static_cast<amxc_var_t *>(event_data);
+    amxd_object_trigger_signal(event_obj, event_name.c_str(), data);
+
+    LOG(DEBUG) << "Triggered event '" << event_name << "' with data at '" << object_path << "'";
+    return true;
+}
+
 AmbiorixImpl::~AmbiorixImpl()
 {
     remove_event_loop();
