+bool db::dm_trigger_qcom_vendor_event(const sMacAddr &mac, const std::string &dm_path,
+                                      const std::string &event_name)
+{
+    if (dm_path.empty()) {
+        LOG(DEBUG) << "dm_path is empty, skipping event trigger for " << event_name;
+        return true;
+    }
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    const std::string mac_str = tlvf::mac_to_string(mac);
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress", mac_str.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath", dm_path.c_str());
+
+    // New path structure: Device.WiFi.DataElements.Network.QCOM_Vendor.EventName
+    const std::string vendor_event_obj = DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor." + event_name;
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+
+    if (!ok) {
+        LOG(ERROR) << "Failed to trigger Event at " << vendor_event_obj << " mac=" << mac_str
+                   << " dm_path=" << dm_path;
+    } else {
+        LOG(DEBUG) << "Triggered Event at " << vendor_event_obj << " mac=" << mac_str
+                   << " dm_path=" << dm_path;
+    }
+    amxc_var_clean(&event_data);
+    return ok;
+}
