     bool handle_wsc_m8_tlv(const std::string &radio_iface, std::shared_ptr<WSC::m8> m8,
                            sBStaConfig &info);
+    bool fill_bsta_info_from_backhaul_bss(const std::string &radio_iface,
+                                          const std::vector<sBssConfig> &bss_infos,
+                                          sBStaConfig &info);
 
