Subject: [PATCH] [Airties] Fix for M8 absent in M2

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 61 +++++++++++++++----
 .../slave/tasks/ap_autoconfiguration_task.h   |  3 +
 2 files changed, 51 insertions(+), 13 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 2cdb09829..fcd956700 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -3023,10 +3023,17 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
         return;
     }
 
-    sBStaConfig bsta_info;
-    if (m8 && !handle_wsc_m8_tlv(radio->front.iface_name, m8, bsta_info)) {
-        LOG(ERROR) << "handle_wsc_m8_tlv has failed!";
-        return;
+    sBStaConfig bsta_info = {};
+    bool has_bsta_info    = false;
+    if (m8) {
+        if (!handle_wsc_m8_tlv(radio->front.iface_name, m8, bsta_info)) {
+            LOG(ERROR) << "handle_wsc_m8_tlv has failed!";
+            return;
+        }
+        has_bsta_info = true;
+    } else {
+        has_bsta_info =
+            fill_bsta_info_from_backhaul_bss(radio->front.iface_name, bss_infos, bsta_info);
     }
 
     // MLD
@@ -3223,19 +3230,17 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_wsc(ieee1905_1::CmduMe
                     radio->front.iface_mac, new_credentials);
             }
 
-            // Do not propagate a bSTA credentials update to backhaul_manager when the M8 carried
-            // a teardown (or empty-SSID, which the M2/M8 parsers treat equivalently to teardown)
-            // bSTA config - there's no valid AP to connect to, so backhaul_manager must keep
-            // whatever credentials it already has instead of overwriting them with garbage.
-            bool bsta_is_teardown =
+            // Do not propagate an empty or teardown bSTA config to backhaul_manager. There is no
+            // valid AP to connect to, so backhaul_manager must keep its current credentials.
+            const bool bsta_is_teardown =
                 static_cast<bool>(bsta_info.payload_config.bss_type &
                                    WSC::eWscVendorExtSubelementBssType::TEARDOWN) ||
                 bsta_info.payload_config.ssid.empty();
-            if (m8 && !bsta_is_teardown) {
+            if (has_bsta_info && !bsta_is_teardown) {
                 send_bsta_configuration(radio->front.iface_mac, bsta_info);
-            } else if (m8) {
-                LOG(DEBUG) << "Skipping bSTA credentials update to backhaul_manager - M8 "
-                              "carried a teardown/empty bSTA config for "
+            } else if (has_bsta_info) {
+                LOG(DEBUG) << "Skipping bSTA credentials update to backhaul_manager - "
+                              "bSTA config is teardown/empty for "
                            << radio->front.iface_name;
             } else if (db->controller_info.early_ap_capability) {
                 send_enable_disable_endpoint(radio->front.iface_mac, false);
@@ -4682,6 +4687,36 @@ bool ApAutoConfigurationTask::handle_wsc_m8_tlv(const std::string &radio_iface,
     return true;
 }
 
+bool ApAutoConfigurationTask::fill_bsta_info_from_backhaul_bss(
+    const std::string &radio_iface, const std::vector<sBssConfig> &bss_infos, sBStaConfig &info)
+{
+    auto backhaul_bss = std::find_if(
+        bss_infos.begin(), bss_infos.end(), [](const sBssConfig &bss_info) {
+            const auto bss_type = bss_info.payload_config.bss_type;
+            const bool backhaul_bss =
+                static_cast<bool>(bss_type & WSC::eWscVendorExtSubelementBssType::BACKHAUL_BSS);
+            const bool teardown =
+                static_cast<bool>(bss_type & WSC::eWscVendorExtSubelementBssType::TEARDOWN);
+
+            return backhaul_bss && !teardown && !bss_info.payload_config.ssid.empty();
+        });
+
+    if (backhaul_bss == bss_infos.end()) {
+        LOG(DEBUG) << "No Backhaul BSS found in M2 for bSTA configuration on "
+                   << radio_iface;
+        return false;
+    }
+
+    info                = {};
+    info.payload_config = backhaul_bss->payload_config;
+    info.payload_config.bss_type = WSC::eWscVendorExtSubelementBssType::BACKHAUL_STA;
+
+    LOG(INFO) << "Using M2 Backhaul BSS as bSTA configuration for " << radio_iface
+              << ": bssid=" << info.payload_config.bssid << ", ssid=" << info.payload_config.ssid;
+
+    return true;
+}
+
 bool ApAutoConfigurationTask::send_ap_mld_configuration(const std::string &radio_iface,
                                                         std::string ssid, int8_t mld_unit,
                                                         uint8_t mld_mode, bool reconfigure)
