---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index a04c1ca..99d3157 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -667,7 +667,10 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         } else {
             new_obj.add_child("EncryptionMode", encryption_mode);
             new_obj.add_child("KeyPassPhrase", bss_info_conf.network_key);
-        }
+            if (security_mode == "WPA3-Personal" || security_mode == "WPA2-WPA3-Personal")  {
+	      new_obj.add_child("SAEPassphrase", bss_info_conf.network_key);
+	}
+		}
         ret = m_ambiorix_cl.update_object(wifi_ap_sec_path, new_obj);
 
         if (!ret) {
