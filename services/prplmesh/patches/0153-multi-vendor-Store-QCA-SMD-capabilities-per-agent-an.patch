From 029495439d7c085f73f559215950be2439d0bd92 Mon Sep 17 00:00:00 2001
From: Vignesh Sridharan <vignsrid@qti.qualcomm.com>
Date: Tue, 23 Jun 2026 22:08:40 +0530
Subject: [PATCH] multi-vendor: Store QCA SMD capabilities per-agent and  gate
 SMD Policy Config TLV

Parse the QCA SMD Capabilities TLV in the Early AP Capability Report,
store all capability bits (smd_capable, smd_dl_forwarding) in the agent
DB, and pass them as a sQcaSmdCapabilities struct via a C-linkage wrapper
to gate SMD Policy Config TLV inclusion per-agent in M2 responses.

Signed-off-by: Vignesh Sridharan <vignsrid@qti.qualcomm.com>
---
 .../multi_vendor/qca/include/tlvf_qca_utils.h | 28 +++++++++++++
 .../multi_vendor/qca/src/multi_vendor_qca.cpp |  7 ++++
 .../multi_vendor/qca/src/tlvf_qca_utils.cpp   | 18 ++++++++
 controller/src/beerocks/master/controller.cpp | 42 ++++++++++++++++++-
 controller/src/beerocks/master/db/agent.h     |  7 ++++
 5 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/multi_vendor/qca/include/tlvf_qca_utils.h b/common/beerocks/multi_vendor/qca/include/tlvf_qca_utils.h
index f52087242..9cd259e74 100644
--- a/common/beerocks/multi_vendor/qca/include/tlvf_qca_utils.h
+++ b/common/beerocks/multi_vendor/qca/include/tlvf_qca_utils.h
@@ -13,6 +13,18 @@
 
 namespace qca {
 
+/**
+ * @brief SMD capability data reported by an agent via the QCA SMD Capabilities TLV.
+ *
+ * Bit 7 of the capabilities byte → smd_capable
+ * Bit 6 of the capabilities byte → smd_dl_forwarding
+ * Bits 5-0 are reserved.
+ */
+struct sQcaSmdCapabilities {
+    bool smd_capable       = false; ///< Bit 7: SMD capable
+    bool smd_dl_forwarding = false; ///< Bit 6: SMD DL forwarding support
+};
+
 /**
  * @brief SMD policy profile data for TLV generation (controller-side only).
  *
@@ -69,6 +81,18 @@ public:
      */
     static void set_smd_profiles(const std::vector<sQcaSmdPolicyProfile> &profiles);
 
+    /**
+     * @brief Set the SMD capabilities of the current target agent.
+     *
+     * Must be called by the controller before invoking add_vs_tlv() for
+     * AP_AUTOCONFIGURATION_WSC_MESSAGE so that add_qca_smd_policy_config_tlv()
+     * can gate TLV inclusion on a per-agent basis.
+     * The capabilities are reset to {} inside add_qca_smd_policy_config_tlv() after use.
+     *
+     * @param caps SMD capabilities struct populated from the QCA SMD Capabilities TLV.
+     */
+    static void set_current_agent_smd_capabilities(const sQcaSmdCapabilities &caps);
+
     /**
      * @brief Clear all stored SMD policy profiles.
      */
@@ -94,6 +118,10 @@ public:
     static std::shared_ptr<BaseClass> parse_qca_vs_tlv(ieee1905_1::CmduMessageRx &cmdu_rx);
 
 private:
+    // Per-invocation capabilities: set by the controller before add_vs_tlv() and consumed
+    // (then reset) inside add_qca_smd_policy_config_tlv().
+    static sQcaSmdCapabilities s_current_agent_smd_caps;
+
     /**
      * @brief Parses QCA version info TLV (specific parser).
      *
diff --git a/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp b/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp
index 6546e6fc9..006e17778 100644
--- a/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp
+++ b/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp
@@ -111,3 +111,10 @@ extern "C" void add_qca_smd_profile_entry(const qca::sQcaSmdPolicyProfile *profi
 }
 
 extern "C" void clear_qca_smd_profiles() { qca::tlvf_qca_utils::clear_smd_profiles(); }
+
+extern "C" void set_qca_current_agent_smd_capabilities(const qca::sQcaSmdCapabilities *caps)
+{
+    if (caps) {
+        qca::tlvf_qca_utils::set_current_agent_smd_capabilities(*caps);
+    }
+}
diff --git a/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp b/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
index b143fe6ff..0761febf6 100644
--- a/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
+++ b/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
@@ -18,6 +18,10 @@ using namespace qca;
 // Static storage for SMD policy profiles (populated from controller config at init time)
 static std::vector<qca::sQcaSmdPolicyProfile> s_smd_profiles;
 
+// Per-invocation capabilities: set by the controller before add_vs_tlv() and consumed
+// (then reset) inside add_qca_smd_policy_config_tlv().
+qca::sQcaSmdCapabilities tlvf_qca_utils::s_current_agent_smd_caps = {};
+
 void tlvf_qca_utils::set_smd_profiles(const std::vector<sQcaSmdPolicyProfile> &profiles)
 {
     s_smd_profiles = profiles;
@@ -31,6 +35,11 @@ void tlvf_qca_utils::add_smd_profile(const sQcaSmdPolicyProfile &profile)
     s_smd_profiles.push_back(profile);
 }
 
+void tlvf_qca_utils::set_current_agent_smd_capabilities(const sQcaSmdCapabilities &caps)
+{
+    s_current_agent_smd_caps = caps;
+}
+
 // SEND side: Add version TLV to outgoing message
 bool tlvf_qca_utils::add_qca_version_info_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
 {
@@ -92,10 +101,17 @@ bool tlvf_qca_utils::add_qca_smd_capabilities_tlv(ieee1905_1::CmduMessageTx &cmd
 // SEND side: Add SMD policy config TLV(s) to outgoing message
 // Note: This handler is only registered on the controller, so it will only be called for M2 messages.
 // One TLV is added per configured SMD profile. Profiles are set via set_smd_profiles() at init time.
+// The target agent must be SMD capable (set via set_current_agent_smd_capable()) for TLVs to be added.
 bool tlvf_qca_utils::add_qca_smd_policy_config_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
 {
+    if (!s_current_agent_smd_caps.smd_capable) {
+        LOG(DEBUG) << "Skipping QCA SMD policy config TLV: agent is not SMD capable";
+        return true;
+    }
+
     if (s_smd_profiles.empty()) {
         LOG(WARNING) << "No SMD profiles configured, skipping QCA SMD policy config TLV";
+        s_current_agent_smd_caps = {};
         return true;
     }
 
@@ -137,6 +153,8 @@ bool tlvf_qca_utils::add_qca_smd_policy_config_tlv(ieee1905_1::CmduMessageTx &cm
                   << " default_dl_drain_time=" << static_cast<int>(profile.default_dl_drain_time);
     }
 
+    // Reset the per-invocation capabilities after use so they do not carry over to the next M2
+    s_current_agent_smd_caps = {};
     return true;
 }
 
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 29029eab8..e4f5d73fa 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -30,6 +30,11 @@
 #include "tasks/dynamic_channel_selection_task.h"
 
 #include "multi_vendor.h"
+#include <tlvf/qca/tlvQcaSmdCapabilities.h>
+#include <tlvf_qca_utils.h>
+
+// C-linkage wrapper for QCA SMD per-agent capabilities struct (defined in multi_vendor_qca.cpp)
+extern "C" void set_qca_current_agent_smd_capabilities(const qca::sQcaSmdCapabilities *caps);
 
 #include <bcl/beerocks_backport.h>
 #include <bcl/beerocks_utils.h>
@@ -1897,6 +1902,13 @@ bool Controller::handle_cmdu_1905_autoconfiguration_WSC(const sMacAddr &src_mac,
     add_bss_advanced_configuration_tlv(database, cmdu_tx, m1->mac_addr(), ruid, bss_info_confs,
                                        radio->band);
 
+    // Set per-agent SMD capabilities struct so that add_qca_smd_policy_config_tlv() inside
+    // add_vs_tlv() can gate TLV inclusion on a per-agent basis.
+    qca::sQcaSmdCapabilities smd_caps;
+    smd_caps.smd_capable       = agent->smd_capable;
+    smd_caps.smd_dl_forwarding = agent->smd_dl_forwarding;
+    set_qca_current_agent_smd_capabilities(&smd_caps);
+
     // Add vendor-specific TLVs
     if (!multi_vendor::tlvf_handler::add_vs_tlv(
             cmdu_tx, ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_WSC_MESSAGE)) {
@@ -6242,7 +6254,35 @@ bool Controller::handle_cmdu_1905_early_ap_capability_report_message(
     auto mid = cmdu_rx.getMessageId();
     LOG(INFO) << "Received EARLY_AP_CAPABILITY_REPORT_MESSAGE, mid=" << std::dec << int(mid);
 
-    return handle_ap_capability_report(src_mac, cmdu_rx, true);
+    if (!handle_ap_capability_report(src_mac, cmdu_rx, true)) {
+        return false;
+    }
+
+    // Parse QCA SMD Capabilities TLV (already auto-parsed by the multi-vendor framework
+    // via CmduMessageRx vendor TLV parser callback) and store the result in the agent DB.
+    auto agent = database.m_agents.get(src_mac);
+    if (!agent) {
+        LOG(ERROR) << "Agent not found for src_mac=" << src_mac;
+        return false;
+    }
+
+    auto smd_cap_tlv = cmdu_rx.getClass<qca::tlvQcaSmdCapabilities>();
+    if (smd_cap_tlv) {
+        uint8_t capabilities     = smd_cap_tlv->capabilities();
+        agent->smd_capable       = (capabilities & 0x80) != 0; // Bit 7: smdCapable
+        agent->smd_dl_forwarding = (capabilities & 0x40) != 0; // Bit 6: smdDlForwarding
+        LOG(INFO) << "Agent " << src_mac
+                  << " SMD capable: " << (agent->smd_capable ? "true" : "false")
+                  << " smd_dl_forwarding: " << (agent->smd_dl_forwarding ? "true" : "false")
+                  << " (capabilities=0x" << std::hex << static_cast<int>(capabilities) << ")";
+    } else {
+        agent->smd_capable       = false;
+        agent->smd_dl_forwarding = false;
+        LOG(DEBUG) << "No QCA SMD Capabilities TLV in Early AP Cap from " << src_mac
+                   << ", agent is not SMD capable";
+    }
+
+    return true;
 }
 
 bool Controller::add_unassociated_station(const sMacAddr &station_mac_addr, uint8_t channel,
diff --git a/controller/src/beerocks/master/db/agent.h b/controller/src/beerocks/master/db/agent.h
index 76a034e5c..fb6a7027e 100644
--- a/controller/src/beerocks/master/db/agent.h
+++ b/controller/src/beerocks/master/db/agent.h
@@ -93,6 +93,13 @@ public:
 
     // RSN Overriding support
     bool rsn_overriding_supported = false;
+
+    // SMD (Seamless Mobility Domain) capabilities, set from QCA SMD Capabilities TLV
+    // received in EARLY_AP_CAPABILITY_REPORT_MESSAGE.
+    // smd_capable: Bit 7 of the capabilities byte.
+    // smd_dl_forwarding: Bit 6 of the capabilities byte.
+    bool smd_capable       = false;
+    bool smd_dl_forwarding = false;
     /**
      * @brief Max Total Number of unique VLAN identifiers the Multi-AP Agent supports.
      *
-- 
2.34.1

