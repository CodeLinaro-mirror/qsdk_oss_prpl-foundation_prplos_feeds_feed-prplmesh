+int bml_internal::send_client_assoc_control(const sMacAddr &bssid,
+                                            uint8_t association_control,
+                                            uint16_t time_period_sec,
+                                            uint8_t sta_count,
+                                            const char **sta_macs)
+{
+    LOG(DEBUG) << "Client association control: BSSID=" << bssid
+               << ", control=" << int(association_control)
+               << ", period=" << time_period_sec << "s"
+               << ", STA count=" << int(sta_count);
+
+    if (!is_local_master()) {
+        LOG(ERROR) << "Command supported only on local master";
+        return -BML_RET_OP_NOT_SUPPORTED;
+    }
+
+    if (!m_sockMaster) {
+        int ret = connect_to_master();
+        if (ret != BML_RET_OK) {
+            LOG(ERROR) << "Failed to connect to master";
+            return ret;
+        }
+    }
+
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_BML_CLIENT_ASSOC_CONTROL_REQUEST>(cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "Failed to create CLIENT_ASSOC_CONTROL_REQUEST";
+        return -BML_RET_OP_FAILED;
+    }
+
+    request->bssid()               = bssid;
+    request->association_control() = association_control;
+    request->time_period_sec()     = time_period_sec;
+    request->sta_count()           = sta_count;
+
+    for (uint8_t i = 0; i < sta_count; i++) {
+        auto sta_tuple = request->sta_list(i);
+        if (!std::get<0>(sta_tuple)) {
+            LOG(ERROR) << "Failed to access sta_list element " << int(i);
+            return -BML_RET_OP_FAILED;
+        }
+        std::get<1>(sta_tuple) = tlvf::mac_from_string(std::string(sta_macs[i]));
+    }
+
+    int result = 0;
+    int ret = send_bml_cmdu(result, request->get_action_op());
+    if (ret != BML_RET_OK) {
+        LOG(ERROR) << "send_bml_cmdu failed: " << ret;
+        return ret;
+    }
+    if (result != 0) {
+        LOG(ERROR) << "Client association control failed with error: " << result;
+        return result;
+    }
+
+    return BML_RET_OK;
+}
