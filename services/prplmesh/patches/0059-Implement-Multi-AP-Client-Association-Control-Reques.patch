diff --git a/controller/src/beerocks/bml/bml.cpp b/controller/src/beerocks/bml/bml.cpp
index 7d0059b07..ea5bb4ae0 100644
--- a/controller/src/beerocks/bml/bml.cpp
+++ b/controller/src/beerocks/bml/bml.cpp
@@ -728,6 +728,52 @@ int bml_get_unassoc_sta_rcpi_query_result(BML_CTX ctx, const char *sta_mac,
                                                    sta_info);
 }
 
+int bml_trigger_client_assoc_control(BML_CTX ctx, const char *bssid,
+                                     uint8_t association_control,
+                                     uint16_t time_period_sec,
+                                     uint8_t sta_count,
+                                     const char **sta_macs)
+{
+    if (!ctx || !bssid || !sta_macs || sta_count == 0) {
+        return -BML_RET_INVALID_ARGS;
+    }
+
+    // Validate association_control mode (must be 0x00-0x03)
+    if (association_control > BML_CLIENT_ASSOC_CONTROL_INDEFINITE_BLOCK) {
+        LOG(ERROR) << "Invalid association control mode: " << int(association_control)
+                   << " (valid range: 0x00-0x03)";
+        return -BML_RET_INVALID_ARGS;
+    }
+
+    // Validate time_period_sec based on mode
+    if (association_control == BML_CLIENT_ASSOC_CONTROL_TIMED_BLOCK && time_period_sec == 0) {
+        LOG(ERROR) << "TIMED_BLOCK mode (0x02) requires time_period_sec > 0";
+        return -BML_RET_INVALID_ARGS;
+    }
+
+    if (association_control == BML_CLIENT_ASSOC_CONTROL_INDEFINITE_BLOCK && time_period_sec != 0) {
+        LOG(WARNING) << "INDEFINITE_BLOCK mode (0x03) ignores time_period_sec parameter (provided: "
+                     << time_period_sec << "s)";
+    }
+
+    if (association_control == BML_CLIENT_ASSOC_CONTROL_UNBLOCK && time_period_sec != 0) {
+        LOG(WARNING) << "UNBLOCK mode (0x01) ignores time_period_sec parameter (provided: "
+                     << time_period_sec << "s)";
+    }
+
+    // Validate STA count
+    if (sta_count > BML_CLIENT_ASSOC_MAX_STA_COUNT) {
+        LOG(ERROR) << "STA count " << int(sta_count) << " exceeds maximum "
+                   << BML_CLIENT_ASSOC_MAX_STA_COUNT;
+        return -BML_RET_INVALID_ARGS;
+    }
+
+    auto pBML = static_cast<bml_internal *>(ctx);
+    return pBML->send_client_assoc_control(tlvf::mac_from_string(std::string(bssid)),
+                                           association_control, time_period_sec,
+                                           sta_count, sta_macs);
+}
