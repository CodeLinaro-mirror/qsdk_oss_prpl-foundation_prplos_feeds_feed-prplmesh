+    BML_CLIENT_ASSOC_ERR_SUCCESS = 0,
+    BML_CLIENT_ASSOC_ERR_INVALID_PARAMS = 1,
+    BML_CLIENT_ASSOC_ERR_AGENT_NOT_FOUND = 2,
