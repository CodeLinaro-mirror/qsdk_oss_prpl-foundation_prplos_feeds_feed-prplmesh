+                LOG(ERROR) << "Invalid association control mode: " << int(association_control);
+                valid_mode = false;
+                auto response = message_com::create_vs_message<
+                    beerocks_message::cACTION_BML_CLIENT_ASSOC_CONTROL_RESPONSE>(
+                        cmdu_tx, beerocks_header->id());
+                if (response) {
+                    response->op_error_code() = BML_CLIENT_ASSOC_ERR_INVALID_MODE;
+                    controller_ctx->send_cmdu(sd, cmdu_tx);
+                }
+                break;
+        }
+
+        // Only proceed if we have a valid mode
+        if (!valid_mode) {
+            break;
+        }
+
+        // Send client association control request to agent
+        bool success = son_actions::send_client_association_control(
+            database, cmdu_tx, agent_mac, bssid, station_list, time_period_sec, assoc_flag);
+
+        LOG(DEBUG) << "Client association control " << (success ? "sent" : "failed")
+                   << " to agent " << agent_mac;
+
+        // Send response to BML client
+        auto response = message_com::create_vs_message<
+            beerocks_message::cACTION_BML_CLIENT_ASSOC_CONTROL_RESPONSE>(
+                cmdu_tx, beerocks_header->id());
+        if (response) {
+            response->op_error_code() = success ? BML_CLIENT_ASSOC_ERR_SUCCESS
+                                                : BML_CLIENT_ASSOC_ERR_AGENT_NOT_FOUND;
+            controller_ctx->send_cmdu(sd, cmdu_tx);
+        }
+        break;
+    }
