+#define BML_CLIENT_ASSOC_CONTROL_TIMED_BLOCK       0x02  /* Timed block with auto-expiration */
+#define BML_CLIENT_ASSOC_CONTROL_INDEFINITE_BLOCK  0x03  /* Indefinite block with disassociation */
+#define BML_CLIENT_ASSOC_MAX_STA_COUNT             16    /* Maximum STAs per request */
+
