+int cli_bml::bml_trigger_client_assoc_control_caller(int numOfArgs)
+{
+    if (numOfArgs < 5) {
+        LOG(ERROR) << "Insufficient arguments. Usage: <bssid> <association_control> "
+                   << "<time_period_sec> <sta_count> <sta_mac_1> [<sta_mac_2> ...]";
+        return -1;
+    }
+
+    std::string bssid = args.stringArgs[0];
+    int association_control = args.intArgs[1];
+    int time_period_sec = args.intArgs[2];
+    int sta_count = args.intArgs[3];
+
+    // Validate association_control is in valid range [0-3]
+    if (association_control < BML_CLIENT_ASSOC_CONTROL_BLOCK ||
+        association_control > BML_CLIENT_ASSOC_CONTROL_INDEFINITE_BLOCK) {
+        LOG(ERROR) << "Invalid association_control: " << association_control
+                   << " (must be 0=BLOCK, 1=UNBLOCK, 2=TIMED_BLOCK, or 3=INDEFINITE_BLOCK)";
+        return -1;
+    }
+
+    // Validate time_period_sec requirements based on mode
+    if (association_control == BML_CLIENT_ASSOC_CONTROL_TIMED_BLOCK) {
+        if (time_period_sec <= 0) {
+            LOG(ERROR) << "TIMED_BLOCK mode requires time_period_sec > 0, got: " << time_period_sec;
+            return -1;
+        }
+    } else if ((association_control == BML_CLIENT_ASSOC_CONTROL_UNBLOCK ||
+                association_control == BML_CLIENT_ASSOC_CONTROL_INDEFINITE_BLOCK) &&
+               time_period_sec != 0) {
+        LOG(WARNING) << "Mode " << int(association_control)
+                     << " does not use time_period_sec, but non-zero value provided: "
+                     << time_period_sec << " (will be ignored)";
+    }
+
+    if (sta_count <= 0 || sta_count > BML_CLIENT_ASSOC_MAX_STA_COUNT) {
+        LOG(ERROR) << "Invalid sta_count: " << sta_count
+                   << " (must be 1-" << BML_CLIENT_ASSOC_MAX_STA_COUNT << ")";
+        return -1;
+    }
+
+    if (numOfArgs < 4 + sta_count) {
+        LOG(ERROR) << "Insufficient STA MAC addresses. Expected " << sta_count
+                   << " but got " << (numOfArgs - 4);
+        return -1;
+    }
+
+    if (!beerocks::net::network_utils::is_valid_mac(bssid)) {
+        LOG(ERROR) << "Invalid BSSID: " << bssid;
+        return -1;
+    }
+
+    // Collect and validate STA MAC addresses
+    std::vector<std::string> sta_mac_strings;
+    for (int i = 0; i < sta_count; i++) {
+        std::string sta_mac = args.stringArgs[4 + i];
+        if (!beerocks::net::network_utils::is_valid_mac(sta_mac)) {
+            LOG(ERROR) << "Invalid STA MAC at position " << (i + 1) << ": " << sta_mac;
+            return -1;
+        }
+        sta_mac_strings.push_back(sta_mac);
+    }
+
+    return trigger_client_assoc_control(bssid, uint8_t(association_control),
+                                       uint16_t(time_period_sec), uint8_t(sta_count),
+                                       sta_mac_strings);
+}
+
+int cli_bml::trigger_client_assoc_control(const std::string &bssid,
+                                         uint8_t association_control,
+                                         uint16_t time_period_sec,
+                                         uint8_t sta_count,
+                                         const std::vector<std::string> &sta_macs)
+{
+    std::cout << "Client Association Control Request:" << std::endl;
+    std::cout << "  BSSID: " << bssid << std::endl;
+    std::cout << "  Control: " << int(association_control)
+              << " (" << (association_control == BML_CLIENT_ASSOC_CONTROL_BLOCK ? "BLOCK" : "UNBLOCK")
+              << ")" << std::endl;
+    std::cout << "  Period: " << time_period_sec << " seconds" << std::endl;
+    std::cout << "  STA count: " << int(sta_count) << std::endl;
+    std::cout << "  STA MACs:" << std::endl;
+    
+    for (size_t i = 0; i < sta_macs.size(); i++) {
+        std::cout << "    [" << (i + 1) << "] " << sta_macs[i] << std::endl;
+    }
+
+    // Convert to C string array
+    std::vector<const char *> sta_mac_ptrs;
+    for (const auto &mac : sta_macs) {
+        sta_mac_ptrs.push_back(mac.c_str());
+    }
+
+    int ret = bml_trigger_client_assoc_control(ctx, bssid.c_str(), association_control,
+                                               time_period_sec, sta_count,
+                                               sta_mac_ptrs.data());
+
+    if (ret == BML_RET_OK) {
+        std::cout << "SUCCESS: Request sent" << std::endl;
+    } else {
+        std::cout << "FAILED: Error code " << ret << std::endl;
+    }
+
+    printBmlReturnVals("bml_trigger_client_assoc_control", ret);
+
+    return 0;
+}
