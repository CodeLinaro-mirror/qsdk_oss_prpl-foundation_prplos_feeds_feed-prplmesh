From c05e7a79ee1ed88339584c4b658f7f639554b9df Mon Sep 17 00:00:00 2001
From: Aryan Khare <aryakhar@qti.qualcomm.com>
Date: Fri, 8 May 2026 15:26:28 +0530
Subject: [PATCH] Fixes VAP Interface Index Mismatch (in bml_conn_map output)
 on PRPLOS whm-> uses actual iface suffix as vap_id slot in refresh_vaps_info

Signed-off-by: Aryan Khare <aryakhar@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/base_wlan_hal_whm.cpp | 27 +++++++++++++++----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
index 22b0a8e95..b5f226df3 100644
--- a/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/base_wlan_hal_whm.cpp
@@ -1332,17 +1332,34 @@ bool base_wlan_hal_whm::refresh_vaps_info(int id)
     }
 
     while (!curr_vaps.empty() && !empty_slots.empty()) {
-        int slot = empty_slots.back();
-        LOG(INFO) << "insert new_vap with mac " << curr_vaps.begin()->first << " in slot " << slot;
+        // Try to use the actual interface suffix as the vap_id slot so that the vap_id
+        // matches the kernel interface name suffix (e.g., wlan0.1 -> vap_id=1).
+        // This ensures bml_conn_map shows the correct interface names matching 'iw dev'.
+        const auto &ap_obj = curr_vaps.begin()->second;
+        auto ifname        = wbapi_utils::get_ap_iface(ap_obj);
+        auto iface_ids     = beerocks::utils::get_ids_from_iface_string(ifname);
+        int slot;
+        if (iface_ids.vap_id >= beerocks::IFACE_VAP_ID_MIN) {
+            // Use the actual interface suffix as the slot
+            slot   = iface_ids.vap_id;
+            auto it = std::find(empty_slots.begin(), empty_slots.end(), slot);
+            if (it != empty_slots.end()) {
+                empty_slots.erase(it);
+            }
+        } else {
+            slot = empty_slots.back();
+            empty_slots.pop_back();
+        }
+        LOG(INFO) << "insert new_vap with mac " << curr_vaps.begin()->first << " in slot " << slot
+                  << " (ifname=" << ifname << ")";
 
-        ret |= refresh_vap_info(slot, curr_vaps.begin()->second);
+        ret = refresh_vap_info(slot, curr_vaps.begin()->second);
         if ((saved_vaps.find(slot) != saved_vaps.end()) &&
             check_enabled_vap(saved_vaps[slot].bss)) {
             newEnabledVaps.push_back(saved_vaps[slot].bss);
         }
-        empty_slots.pop_back();
         curr_vaps.erase(curr_vaps.begin()->first);
-        detectNewVaps |= true;
+        detectNewVaps = true;
     }
 
     if (detectNewVaps) {
-- 
2.34.1

