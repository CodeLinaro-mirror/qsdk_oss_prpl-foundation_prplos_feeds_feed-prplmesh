From 9ab3de0aefa274aae8f01e2de68939412a8688d1 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Tue, 23 Jun 2026 15:42:45 +0530
Subject: [PATCH] nlhal: vap update notification from ap_manager to monitor
 thread

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 |  25 +++-
 .../fronthaul_manager/ap_manager/ap_manager.h |   3 +-
 .../fronthaul_manager/monitor/monitor.cpp     | 110 ++++++++++++++++++
 .../fronthaul_manager/monitor/monitor.h       |   3 +
 agent/src/beerocks/slave/son_slave_thread.cpp |  18 +++
 .../tlvf/beerocks_message_action.yaml         |   7 +-
 .../tlvf/beerocks_message_apmanager.yaml      |   3 +
 .../tlvf/beerocks_message_monitor.yaml        |   3 +
 8 files changed, 168 insertions(+), 4 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 992be78f6..cf6a3055e 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2127,6 +2127,18 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             ap_wlan_hal->update_vap_credentials(bss_info_conf_list, backhaul_wps_ssid,
                                                 backhaul_wps_passphrase, bridge_name);
 
+#ifdef USE_PRPLMESH_NLHAL
+            // Notify monitor thread to refresh its VAP DB after credentials update
+            auto vap_update_notif = message_com::create_vs_message<
+                beerocks_message::cACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION>(cmdu_tx);
+            if (!vap_update_notif) {
+                LOG(ERROR) << "Failed building cACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION!";
+            } else {
+                LOG(DEBUG) << "Sending VAP DB update notification to slave after update_vap_credentials";
+                send_cmdu(cmdu_tx);
+            }
+#endif
+
             auto vap_timeout = std::chrono::steady_clock::now() + wait_for_vaps_enable_timeout_sec;
             bool all_vaps_enabled = false, all_mld_updated = false;
             while (std::chrono::steady_clock::now() < vap_timeout) {
@@ -2199,6 +2211,7 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             const auto &radio_vaps              = ap_wlan_hal->get_radio_info().available_vaps;
             response->number_of_bss_available() = radio_vaps.size();
             send_cmdu(cmdu_tx);
+
         } else {
             LOG(ERROR) << "discard new configuration because "
                        << (perform_update ? "configuration is empty" : "radio not enabled");
@@ -2675,7 +2688,17 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         ap_wlan_hal->update_mld_mode(request->ssid(), request->mld_mode());
 
 #ifdef USE_PRPLMESH_NLHAL
-        ap_wlan_hal->handle_mld_reconfig(request->ssid(),request->mld_unit());
+        ap_wlan_hal->handle_mld_reconfig(request->ssid(), request->mld_unit());
+
+        // Notify monitor thread to refresh its VAP DB after MLD reconfig
+        auto vap_update_notif = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION>(cmdu_tx);
+        if (!vap_update_notif) {
+            LOG(ERROR) << "Failed building cACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION!";
+        } else {
+            LOG(DEBUG) << "Sending VAP DB update notification to slave after handle_mld_reconfig";
+            send_cmdu(cmdu_tx);
+        }
 #endif
 
         break;
diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
index 915d13241..395e53967 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
@@ -19,8 +19,8 @@
 #include <bcl/network/file_descriptor.h>
 #include <beerocks/tlvf/beerocks_message_apmanager.h>
 
-#include <atomic>
 #include <list>
+#include <memory>
 
 namespace son {
 class ApManager {
@@ -360,6 +360,7 @@ private:
 
     /* Timer callback for scheduled Beacon Metrics Responses */
     void beacon_metrics_response_cb(int fd);
+
 };
 
 } // namespace son
diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
index c96590207..5d60b17cf 100644
--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
@@ -1129,6 +1129,7 @@ bool Monitor::update_ap_stats()
     // Update radio statistics
     if (!mon_wlan_hal->update_radio_stats(radio_stats.hal_stats)) {
         LOG(ERROR) << "Failed updating Radio statistics!";
+#ifdef USE_PRPLMESH_NLHAL
         // check base radio interface exists or not
         if(mon_wlan_hal->check_base_iface_exists()) {
             LOG(ERROR) << "Base interface exists - still radio_stats failed ";
@@ -1203,6 +1204,9 @@ bool Monitor::update_ap_stats()
             auto radio_node = mon_db.get_radio_node();
             radio_node->set_iface(updated_iface);
         }
+#else
+        return false;
+#endif
     }
 
     // Update the measurement timestamp
@@ -1872,6 +1876,112 @@ void Monitor::handle_cmdu_vs_message(ieee1905_1::CmduMessageRx &cmdu_rx)
         send_cmdu(cmdu_tx);
         break;
     }
+#ifdef USE_PRPLMESH_NLHAL
+    case beerocks_message::ACTION_MONITOR_VAP_DB_UPDATE_NOTIFICATION: {
+        LOG(DEBUG) << "received ACTION_MONITOR_VAP_DB_UPDATE_NOTIFICATION — refreshing VAP DB";
+
+        // Read hostap_iface from prplmesh config
+        int radio_id = 0;
+        std::string radio_iface = mon_wlan_hal->get_radio_info().iface_name;
+        std::string base_radio_iface;
+        size_t pos = radio_iface.find("_link");
+        if (pos != std::string::npos) {
+            base_radio_iface = radio_iface.substr(0, pos);
+        } else {
+            base_radio_iface = radio_iface; // fallback if "_link" not found
+        }
+
+
+        switch (mon_wlan_hal->get_radio_info().frequency_band) {
+            case beerocks::FREQ_24G: radio_id = 0; break;
+            case beerocks::FREQ_5G: radio_id = 1;  break;
+            case beerocks::FREQ_6G: radio_id = 2;  break;
+            case beerocks::FREQ_5GL: radio_id = 1;  break;
+            case beerocks::FREQ_5GH: radio_id = 3;  break;
+            default: break;
+        }
+
+        std::string hostapd_iface;
+        if (beerocks::bpl::cfg_get_hostap_iface(radio_id, hostapd_iface) < 0) {
+            LOG(ERROR) << "Failed to get latest hostapd iface";
+            return;
+        }
+
+        // check if hostap_iface from config equals the base interface
+        if (hostapd_iface == base_radio_iface) {
+            LOG(INFO) << "hostap_iface matches base interface - update vaps info alone in db ";
+            mon_db.clear();
+            // Initialize VAPs in the DB
+            update_vaps_in_db();
+
+            // external event registration for all vaps
+            m_mon_hal_ext_events = mon_wlan_hal->get_ext_events_fds();
+            if (!m_mon_hal_ext_events.empty()) {
+                for (auto &ext_event_fd : m_mon_hal_ext_events) {
+                    if (ext_event_fd < 0) {
+                        ext_event_fd = beerocks::net::FileDescriptor::invalid_descriptor;
+                        continue;
+                    }
+                    if (!register_ext_events_handlers(ext_event_fd)) {
+                        LOG(DEBUG) << "External events queue with fd = " << ext_event_fd << " is already registered ";
+                    }
+                }
+            }
+        } else {
+            LOG(ERROR) << "hostap_iface from config differs from base interface - check prplmesh config for any changes in base iface";
+
+            std::string updated_iface(hostapd_iface);
+            LOG(DEBUG) << "base_radio: " << base_radio_iface << " updated_iface: " << updated_iface;
+
+            std::string base_radio_bssid = tlvf::mac_to_string(m_radio_mac);
+
+            if (!mon_wlan_hal->get_bss_link_name(updated_iface, base_radio_bssid)) {
+                LOG(ERROR) << " get_bss_link_id failed ";
+                return;
+            }
+            LOG(DEBUG) << " updated_iface with link: " << updated_iface;
+
+            std::string remove_iface;
+            for (auto &active_fd : m_mon_hal_ext_events) {
+                if (active_fd > 0) {
+                    remove_iface = mon_wlan_hal->get_iface_from_fd(active_fd);
+                    if (!remove_iface.empty()) {
+                        if (!mon_wlan_hal->remove_ctrl_skt(remove_iface)) {
+                            LOG(ERROR) << "Failed to remove the BSS!";
+                        }
+                    }
+                    m_event_loop->remove_handlers(active_fd);
+                }
+            }
+
+            m_mon_hal_ext_events = {beerocks::net::FileDescriptor::invalid_descriptor};
+            mon_wlan_hal->set_base_radio_iface_name(updated_iface);
+            mon_wlan_hal->create_wpa_ctrl_skt(updated_iface);
+            mon_wlan_hal->set_iface_name(updated_iface);
+
+            mon_db.clear();
+            // Initialize VAPs in the DB
+            update_vaps_in_db();
+
+            // external event registration for all vaps
+            m_mon_hal_ext_events = mon_wlan_hal->get_ext_events_fds();
+            if (!m_mon_hal_ext_events.empty()) {
+                for (auto &ext_event_fd : m_mon_hal_ext_events) {
+                    if (ext_event_fd < 0) {
+                        ext_event_fd = beerocks::net::FileDescriptor::invalid_descriptor;
+                        continue;
+                    }
+                    if (!register_ext_events_handlers(ext_event_fd)) {
+                        LOG(DEBUG) << "External events queue with fd = " << ext_event_fd << " is already registered ";
+                    }
+                }
+            }
+            auto radio_node = mon_db.get_radio_node();
+            radio_node->set_iface(updated_iface);
+        }
+        break;
+    }
+#endif
     default: {
         LOG(ERROR) << "Unsupported MONITOR action_op: " << int(beerocks_header->action_op());
         break;
diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor.h b/agent/src/beerocks/fronthaul_manager/monitor/monitor.h
index 82b2ec387..e8b78bd22 100644
--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.h
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.h
@@ -23,6 +23,8 @@
 #include <bcl/network/file_descriptor.h>
 #include <beerocks/tlvf/beerocks_message_monitor.h>
 
+#include <memory>
+
 // Monitor HAL
 #include <bwl/mon_wlan_hal.h>
 
@@ -211,6 +213,7 @@ private:
     std::shared_ptr<beerocks::CmduClient> m_slave_client;
 
     bool m_remove_agent_client = false;
+
 };
 } // namespace son
 
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index ff4687253..0f7895ca6 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4195,6 +4195,24 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         }
         break;
     }
+#ifdef USE_PRPLMESH_NLHAL
+    case beerocks_message::ACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION: {
+        LOG(DEBUG) << "received ACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION — forwarding to monitor";
+        auto &radio_manager = m_radio_managers[fronthaul_iface];
+        if (radio_manager.monitor_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+            LOG(WARNING) << "Monitor not connected, cannot forward VAP DB update notification";
+            break;
+        }
+        auto notif = message_com::create_vs_message<
+            beerocks_message::cACTION_MONITOR_VAP_DB_UPDATE_NOTIFICATION>(cmdu_tx);
+        if (!notif) {
+            LOG(ERROR) << "Failed building cACTION_MONITOR_VAP_DB_UPDATE_NOTIFICATION!";
+            break;
+        }
+        send_cmdu(radio_manager.monitor_fd, cmdu_tx);
+        break;
+    }
+#endif
     default: {
         if (!m_task_pool.handle_cmdu(cmdu_rx, 0, {}, {}, fd, beerocks_header)) {
             LOG(ERROR) << "Unknown AP_MANAGER message, action_op: "
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
