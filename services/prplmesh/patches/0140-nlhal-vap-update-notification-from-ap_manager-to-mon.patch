   ACTION_APMANAGER_AFFILIATED_LINK_CHANGED_NOTIFICATION: 82
   ACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL: 83
   ACTION_APMANAGER_BSTA_STATE_NOTIFICATION: 84
-  ACTION_APMANAGER_ENUM_END: 85
+  ACTION_APMANAGER_VAP_DB_UPDATE_NOTIFICATION: 85
+  ACTION_APMANAGER_ENUM_END: 86
 
 ####################################################
 ####################################################
@@ -334,8 +335,10 @@ eActionOp_MONITOR:
   ACTION_MONITOR_STEERING_CLIENT_SET_RESPONSE: 83
   ACTION_MONITOR_STEERING_EVENT_CLIENT_ACTIVITY_NOTIFICATION: 84
   ACTION_MONITOR_STEERING_EVENT_SNR_XING_NOTIFICATION: 85
+  
+  ACTION_MONITOR_VAP_DB_UPDATE_NOTIFICATION: 86
 
-  ACTION_MONITOR_ENUM_END: 86
+  ACTION_MONITOR_ENUM_END: 87
 
 ####################################################
 ####################################################
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 513c894d2..a66fbd995 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
