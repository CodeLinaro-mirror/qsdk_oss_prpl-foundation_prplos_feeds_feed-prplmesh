diff --git a/common/beerocks/bwl/onewifi/onewifi_log.h b/common/beerocks/bwl/onewifi/onewifi_log.h
new file mode 100644
index 000000000..38e7ad609
--- /dev/null
+++ b/common/beerocks/bwl/onewifi/onewifi_log.h
@@ -0,0 +1,67 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _ONEWIFI_LOG_H_
+#define _ONEWIFI_LOG_H_
+
+// Logging backend selection:
+// #define ONEWIFI_LOG_USE_FILE    // Use file logging
+// Default: cout (printf) if not defined
+
+// Log file configuration
+#define ONEWIFI_LOG_FILE_PATH "/tmp/onewifibwl.log"
+#define ONEWIFI_LOG_FILE_MAX_SIZE (1024 * 1024)  // 1MB
+
+#if defined(ONEWIFI_LOG_USE_FILE)
+    #include <cstdio>
+    #include <ctime>
+    #include <cstdarg>
+    #include <sys/stat.h>
+    
+    static inline void onewifi_file_log_fmt(const char *level, const char *func, int line, const char *fmt, ...) {
+        // Check file size and rotate if needed (1MB max)
+        struct stat st;
+        if (stat(ONEWIFI_LOG_FILE_PATH, &st) == 0 && st.st_size >= ONEWIFI_LOG_FILE_MAX_SIZE) {
+            remove(ONEWIFI_LOG_FILE_PATH);  // Delete to save space
+        }
+        
+        FILE *fp = fopen(ONEWIFI_LOG_FILE_PATH, "a");
+        if (!fp) return;
+        
+        time_t t = time(nullptr);
+        char time_buf[32];
+        strftime(time_buf, sizeof(time_buf), "%Y-%m-%d %H:%M:%S", localtime(&t));
+        fprintf(fp, "%s [%s] (%s:%d): ", time_buf, level, func, line);
+        
+        va_list args;
+        va_start(args, fmt);
+        vfprintf(fp, fmt, args);
+        va_end(args);
+        
+        fprintf(fp, "\n");
+        fclose(fp);
+    }
+    
+    #define ONEWIFI_LOG_ERROR(fmt, ...)   onewifi_file_log_fmt("ERROR", __FUNCTION__, __LINE__, fmt, ##__VA_ARGS__)
+    #define ONEWIFI_LOG_WARN(fmt, ...)    onewifi_file_log_fmt("WARN ", __FUNCTION__, __LINE__, fmt, ##__VA_ARGS__)
+    #define ONEWIFI_LOG_INFO(fmt, ...)    onewifi_file_log_fmt("INFO ", __FUNCTION__, __LINE__, fmt, ##__VA_ARGS__)
+    #define ONEWIFI_LOG_DEBUG(fmt, ...)   onewifi_file_log_fmt("DEBUG", __FUNCTION__, __LINE__, fmt, ##__VA_ARGS__)
+    #define ONEWIFI_LOG_TRACE(fmt, ...)   onewifi_file_log_fmt("TRACE", __FUNCTION__, __LINE__, fmt, ##__VA_ARGS__)
+
+#else
+    // Default: cout with printf-style formatting
+    #include <cstdio>
+    #define ONEWIFI_LOG_ERROR(fmt, ...) \
+        do { printf("[ERROR] %s:%d: " fmt "\n", __FUNCTION__, __LINE__, ##__VA_ARGS__); fflush(stdout); } while(0)
+    #define ONEWIFI_LOG_WARN(fmt, ...) \
+        do { printf("[WARN ] %s:%d: " fmt "\n", __FUNCTION__, __LINE__, ##__VA_ARGS__); fflush(stdout); } while(0)
+    #define ONEWIFI_LOG_INFO(fmt, ...) \
+        do { printf("[INFO ] %s:%d: " fmt "\n", __FUNCTION__, __LINE__, ##__VA_ARGS__); fflush(stdout); } while(0)
+    #define ONEWIFI_LOG_DEBUG(fmt, ...) \
+        do { printf("[DEBUG] %s:%d: " fmt "\n", __FUNCTION__, __LINE__, ##__VA_ARGS__); fflush(stdout); } while(0)
+    #define ONEWIFI_LOG_TRACE(fmt, ...) \
+        do { printf("[TRACE] %s:%d: " fmt "\n", __FUNCTION__, __LINE__, ##__VA_ARGS__); fflush(stdout); } while(0)
+#endif
+
+#endif // _ONEWIFI_LOG_H_
