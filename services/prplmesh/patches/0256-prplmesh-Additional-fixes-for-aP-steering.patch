From 10218ba9286ce60f3fce16af39edc8546c91fec5 Mon Sep 17 00:00:00 2001
From: Sureshkumar <suresure@qti.qualcomm.com>
Date: Sat, 4 Jul 2026 12:20:58 +0530
Subject: [PATCH] [prplmesh] Additional fixes for aP steering 	1.Operating
 channel report tx power update fix         2.ACL Apply debug print correction
 to dispaly proper           association control modes

Signed-off-by: Sureshkumar <suresure@qti.qualcomm.com>
---
 .../bwl/shared/nl80211_client_impl.cpp        | 62 +++++++++++++++----
 .../src/beerocks/cli/beerocks_cli_bml.cpp     | 11 +++-
 2 files changed, 58 insertions(+), 15 deletions(-)

diff --git a/common/beerocks/bwl/shared/nl80211_client_impl.cpp b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
index 064e408ae..32a348923 100644
--- a/common/beerocks/bwl/shared/nl80211_client_impl.cpp
+++ b/common/beerocks/bwl/shared/nl80211_client_impl.cpp
@@ -1501,21 +1501,57 @@ bool nl80211_client_impl::get_tx_power_dbm(const std::string &interface_name, ui
                 return;
             }
 
-            //TODO: PRPLMESH_NLHAL_MLO To be updated for parsing MLO Links
             if (tb[NL80211_ATTR_WIPHY_TX_POWER_LEVEL]) {
                 power = nla_get_u32(tb[NL80211_ATTR_WIPHY_TX_POWER_LEVEL]) * 0.01; // mBm to dBm
-            } else if(tb[NL80211_ATTR_MLO_LINKS]) {
-              int ret=0;
-              nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
-                  nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
-                  if (link[NL80211_ATTR_MLO_LINK_ID]) {
-                      if (link[NL80211_ATTR_WIPHY_TX_POWER_LEVEL]) {
-                          power = nla_get_u32(link[NL80211_ATTR_WIPHY_TX_POWER_LEVEL]) * 0.01; // mBm to dBm
-                      } else {
-                          LOG(WARNING) << "Failed to get tx power in mlo link!";
-                      }
-                  }
-              }
+            } else if (tb[NL80211_ATTR_MLO_LINKS]) {
+                /* MLO interface: iterate over per-link TX power entries.
+                 *
+                 * Bug fix: the previous code overwrote 'power' for every link,
+                 * leaving the last link's TX power (often the 6G LPI value) for
+                 * all radios.  The correct behaviour is:
+                 *
+                 *   - If interface_name encodes a link ID (e.g. "wlan1_link2"),
+                 *     extract that ID and only use the TX power from the matching
+                 *     MLO link.
+                 *   - If no link ID is encoded (plain MLD interface name), fall
+                 *     back to the first link's TX power so we at least return a
+                 *     valid value instead of the last (arbitrary) link's value.
+                 */
+                int target_link_id = -1;
+                bwl::base_wlan_hal::extractLinkId(interface_name, target_link_id);
+
+                bool found = false;
+                int ret    = 0;
+                nla_for_each_nested(attrs, tb[NL80211_ATTR_MLO_LINKS], ret) {
+                    nla_parse_nested(link, NL80211_ATTR_MAX, attrs, NULL);
+                    if (!link[NL80211_ATTR_MLO_LINK_ID]) {
+                        continue;
+                    }
+                    int link_id = nla_get_u8(link[NL80211_ATTR_MLO_LINK_ID]);
+
+                    /* Skip links that don't match the requested link ID.
+                     * When target_link_id == -1 (no link suffix in interface_name)
+                     * accept the first link we find as a best-effort fallback. */
+                    if (target_link_id != -1 && link_id != target_link_id) {
+                        continue;
+                    }
+
+                    if (link[NL80211_ATTR_WIPHY_TX_POWER_LEVEL]) {
+                        power = nla_get_u32(link[NL80211_ATTR_WIPHY_TX_POWER_LEVEL]) * 0.01; // mBm to dBm
+                        found = true;
+                        LOG(DEBUG) << "get_tx_power_dbm: iface=" << interface_name
+                                   << " link_id=" << link_id
+                                   << " power=" << power << " dBm";
+                    } else {
+                        LOG(WARNING) << "get_tx_power_dbm: no TX power attr for link_id=" << link_id;
+                    }
+                    break; /* stop after the matching (or first) link */
+                }
+                if (!found) {
+                    LOG(WARNING) << "get_tx_power_dbm: TX power not found for iface="
+                                 << interface_name
+                                 << " (target_link_id=" << target_link_id << ")";
+                }
             } else {
                 LOG(WARNING) << "Failed to get tx power!";
                 return;
diff --git a/controller/src/beerocks/cli/beerocks_cli_bml.cpp b/controller/src/beerocks/cli/beerocks_cli_bml.cpp
index cb625c437..300709462 100644
--- a/controller/src/beerocks/cli/beerocks_cli_bml.cpp
+++ b/controller/src/beerocks/cli/beerocks_cli_bml.cpp
@@ -2889,9 +2889,16 @@ int cli_bml::trigger_client_assoc_control(const std::string &bssid,
 {
     std::cout << "Client Association Control Request:" << std::endl;
     std::cout << "  BSSID: " << bssid << std::endl;
+    const char *control_str;
+    switch (association_control) {
+        case BML_CLIENT_ASSOC_CONTROL_BLOCK:            control_str = "BLOCK";            break;
+        case BML_CLIENT_ASSOC_CONTROL_UNBLOCK:          control_str = "UNBLOCK";          break;
+        case BML_CLIENT_ASSOC_CONTROL_TIMED_BLOCK:      control_str = "TIMED_BLOCK";      break;
+        case BML_CLIENT_ASSOC_CONTROL_INDEFINITE_BLOCK: control_str = "INDEFINITE_BLOCK"; break;
+        default:                                        control_str = "UNKNOWN";          break;
+    }
     std::cout << "  Control: " << int(association_control)
-              << " (" << (association_control == BML_CLIENT_ASSOC_CONTROL_BLOCK ? "BLOCK" : "UNBLOCK")
-              << ")" << std::endl;
+              << " (" << control_str << ")" << std::endl;
     std::cout << "  Period: " << time_period_sec << " seconds" << std::endl;
     std::cout << "  STA count: " << int(sta_count) << std::endl;
     std::cout << "  STA MACs:" << std::endl;
-- 
