From 0c22040200b76469945b6bebc1d69a0c057dbbd9 Mon Sep 17 00:00:00 2001
From: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
Date: Mon, 22 Jun 2026 20:24:42 +0530
Subject: [PATCH] skip non-5GHz bands for CAC status and CAC completion TLVs

Signed-off-by: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
---
 .../slave/tasks/channel_selection_task.cpp    | 62 ++++++++++++++-----
 1 file changed, 48 insertions(+), 14 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
index cec9ef97a..98c3e7b1a 100644
--- a/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/channel_selection_task.cpp
@@ -1456,12 +1456,8 @@ bool ChannelSelectionTask::create_radio_operation_restriction_tlv(const sMacAddr
 
 bool ChannelSelectionTask::create_cac_completion_report_tlv()
 {
-    auto cac_completion_report_tlv = m_cmdu_tx.addClass<wfa_map::tlvProfile2CacCompletionReport>();
-    if (!cac_completion_report_tlv) {
-        LOG(ERROR) << "Failed to create CAC Completion Report TLV";
-        return false;
-    }
-
+    // CAC is a 5 GHz DFS mechanism — skip 2.4 GHz and 6 GHz radios entirely.
+    // One TLV per 5G radio to stay within MAX_TLV_SIZE (1492 B).
     CacStatusDatabase cac_status_database;
     auto db = AgentDB::get();
 
@@ -1473,10 +1469,31 @@ bool ChannelSelectionTask::create_cac_completion_report_tlv()
             return false;
         }
 
+        const auto freq_type = radio->wifi_channel.get_freq_type();
+        if (freq_type != beerocks::eFreqType::FREQ_5G &&
+            freq_type != beerocks::eFreqType::FREQ_5GL &&
+            freq_type != beerocks::eFreqType::FREQ_5GH) {
+            LOG(DEBUG) << "Skipping CAC Completion Report TLV for non-5G radio: " << radio_mac
+                       << " (freq_type=" << int(freq_type) << ")";
+            continue;
+        }
+
+        LOG(DEBUG) << "Creating CAC Completion Report TLV for radio: " << radio_mac
+                   << " (CMDU size before: " << m_cmdu_tx.getMessageLength() << ")";
+
+        auto cac_completion_report_tlv = m_cmdu_tx.addClass<wfa_map::tlvProfile2CacCompletionReport>();
+        if (!cac_completion_report_tlv) {
+            LOG(ERROR) << "Failed to create CAC Completion Report TLV for radio: " << radio_mac;
+            return false;
+        }
+
         if (!cac_status_database.add_cac_completion_report_tlv(radio, cac_completion_report_tlv)) {
-            LOG(DEBUG) << "Failed to add CAC Completion Report TLV for " << radio->front.iface_mac;
+            LOG(DEBUG) << "Failed to populate CAC Completion Report TLV for " << radio->front.iface_mac;
             return false;
         }
+
+        LOG(DEBUG) << "CAC Completion Report TLV for radio: " << radio_mac
+                   << " (CMDU size after: " << m_cmdu_tx.getMessageLength() << ")";
     }
 
     return true;
@@ -1484,12 +1501,8 @@ bool ChannelSelectionTask::create_cac_completion_report_tlv()
 
 bool ChannelSelectionTask::create_cac_status_report_tlv()
 {
-    auto cac_status_report_tlv = m_cmdu_tx.addClass<wfa_map::tlvProfile2CacStatusReport>();
-    if (!cac_status_report_tlv) {
-        LOG(ERROR) << "Failed to create CAC Status Report TLV";
-        return false;
-    }
-
+    // CAC is a 5 GHz DFS mechanism — skip 2.4 GHz and 6 GHz radios entirely.
+    // One TLV per 5G radio to stay within MAX_TLV_SIZE (1492 B).
     CacStatusDatabase cac_status_database;
     auto db = AgentDB::get();
 
@@ -1501,10 +1514,31 @@ bool ChannelSelectionTask::create_cac_status_report_tlv()
             return false;
         }
 
+        const auto freq_type = radio->wifi_channel.get_freq_type();
+        if (freq_type != beerocks::eFreqType::FREQ_5G &&
+            freq_type != beerocks::eFreqType::FREQ_5GL &&
+            freq_type != beerocks::eFreqType::FREQ_5GH) {
+            LOG(DEBUG) << "Skipping CAC Status Report TLV for non-5G radio: " << radio_mac
+                       << " (freq_type=" << int(freq_type) << ")";
+            continue;
+        }
+
+        LOG(DEBUG) << "Creating CAC Status Report TLV for radio: " << radio_mac
+                   << " (CMDU size before: " << m_cmdu_tx.getMessageLength() << ")";
+
+        auto cac_status_report_tlv = m_cmdu_tx.addClass<wfa_map::tlvProfile2CacStatusReport>();
+        if (!cac_status_report_tlv) {
+            LOG(ERROR) << "Failed to create CAC Status Report TLV for radio: " << radio_mac;
+            return false;
+        }
+
         if (!cac_status_database.add_cac_status_report_tlv(radio, cac_status_report_tlv)) {
-            LOG(DEBUG) << "Failed to add CAC Status Report TLV for " << radio_mac;
+            LOG(DEBUG) << "Failed to populate CAC Status Report TLV for " << radio_mac;
             return false;
         }
+
+        LOG(DEBUG) << "CAC Status Report TLV for radio: " << radio_mac
+                   << " (CMDU size after: " << m_cmdu_tx.getMessageLength() << ")";
     }
 
     return true;
-- 
2.34.1

