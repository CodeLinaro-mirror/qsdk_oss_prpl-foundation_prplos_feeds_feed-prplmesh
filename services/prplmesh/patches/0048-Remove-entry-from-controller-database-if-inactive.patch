From 47312ede6568569e23d40404cb258b3e5dce4de9 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Tue, 13 Jan 2026 15:42:52 +0530
Subject: [PATCH 46/54] Remove entry from controller database if inactive

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../src/beerocks/master/db/network_map.cpp    | 26 ++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/controller/src/beerocks/master/db/network_map.cpp b/controller/src/beerocks/master/db/network_map.cpp
index c0d009e03..0a3533fc7 100644
--- a/controller/src/beerocks/master/db/network_map.cpp
+++ b/controller/src/beerocks/master/db/network_map.cpp
@@ -105,8 +105,13 @@ void network_map::send_bml_network_map_message(db &database, int fd,
             data_start = reinterpret_cast<uint8_t *>(response->buffer(0));
         }
 
-        fill_bml_agent_data(database, agent, data_start + size, size_left);
+        auto filled_size = fill_bml_agent_data(database, agent, data_start + size, size_left);
+        if (filled_size == 0) {
+            // No data was filled, either due to an error or because the agent was inactive
+            return;
+        }
 
+        // Only proceed if data was successfully filled
         response->node_num()++;
         size += node_len;
 
@@ -310,6 +315,23 @@ std::ptrdiff_t network_map::fill_bml_agent_data(db &database, std::shared_ptr<Ag
         return 0;
     }
 
+    const auto agent_last_contacted = database.get_agent_last_contact_time(agent->al_mac);
+    const auto now                  = std::chrono::system_clock::now();
+    const auto inactive_duration = now - agent_last_contacted;
+    const auto inactive_threshold = std::chrono::seconds(125); //65+60 seconds of wait
+
+    //check if agent is inactive for more than 125 seconds, if yes, then remove the entry from db
+    if(inactive_duration > inactive_threshold){
+        LOG(INFO) << "Removing inactive data from database: " << agent->al_mac
+                << ", inactive for "
+                << std::chrono::duration_cast<std::chrono::seconds>(inactive_duration).count()
+                << " seconds";
+        
+        //remove agent from database
+        database.remove_agent(agent->al_mac);
+        return 0;
+    }
+
     std::ptrdiff_t node_len = sizeof(BML_NODE);
     if (node_len > buffer_size) {
         LOG(ERROR) << "buffer overflow!";
@@ -342,8 +364,6 @@ std::ptrdiff_t network_map::fill_bml_agent_data(db &database, std::shared_ptr<Ag
 
     tlvf::mac_from_string(node->mac, tlvf::mac_to_string(agent->al_mac));
 
-    const auto agent_last_contacted = database.get_agent_last_contact_time(agent->al_mac);
-    const auto now                  = std::chrono::system_clock::now();
     /*
     65 seconds is derived from the logic of sending out
     topology discovery packet by all 1905 entities
-- 
