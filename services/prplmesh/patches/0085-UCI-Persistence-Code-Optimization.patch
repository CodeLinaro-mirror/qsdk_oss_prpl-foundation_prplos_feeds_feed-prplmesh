From ef10dde8599a4fc99b3ba7904a865a1bbe44b0c7 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Wed, 25 Feb 2026 10:38:58 +0530
Subject: [PATCH 5/7] UCI Persistence Code Optimization

Scenario:
During continuous reboots of the agent, an issue was observed where additional interface (iface)
entries were being appended to the wireless configuration file.

Fix:
Optimized the UCI persistence logic to prevent the creation of duplicate interface entries.

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../platform/bpl/cfg/uci/bpl_cfg_wifi.cpp     | 156 +++++++++---------
 1 file changed, 74 insertions(+), 82 deletions(-)

diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 8e89a3850..4ae8eea59 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -616,25 +616,26 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
         const std::string mld_section_type = "wifi-mld";
         std::string mld_section_name = "mld" + std::to_string(mld_id_val+1);
 
-        if(!uci_section_exists(package_name, mld_section_type, mld_section_name)) {
-            LOG(INFO) << "The mld section doesnt exist for mld" << mld_id_val;
+        bool mld_section_exists = uci_section_exists(package_name, mld_section_type, mld_section_name);
 
-            if(!uci_add_section(package_name, mld_section_type, mld_section_name, true)) {
-                    LOG(ERROR) << "Failed to add new section for MLD: " << mld_section_name;
-                    return false;
+        if (!mld_section_exists) {
+            LOG(INFO) << "Creating new MLD section: " << mld_section_name;
+
+            if (!uci_add_section(package_name, mld_section_type, mld_section_name, true)) {
+                LOG(ERROR) << "Failed to add new section for MLD: " << mld_section_name;
+                return false;
             }
-            LOG(INFO) << "uci_add_section added mld section successfully for: " << mld_section_name;
+        } else {
+            LOG(INFO) << "MLD section " << mld_section_name << " already exists, updating configuration";
         }
-        
+
         OptionsUnorderedMap mldOptions;
         mldOptions["ssid"] = configuration.ssid;
-
         mldOptions["key"] = configuration.network_key;
-
         mldOptions["ifname"] = iface;
-        if(!configuration.multi_ap.empty()) {
+        if (!configuration.multi_ap.empty()) {
                 mldOptions["multi_ap"] = configuration.multi_ap;
-        }else {
+        } else {
             mldOptions["wds"] = "1"; //wds enabled only when multi_ap not present
         }
 
@@ -648,100 +649,91 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             return false;
         }
 
-	    std::string old_section_name;
-        //bool updated_old_section = false;
-
-        //if old_section_name is not equal to new_section_name but configs of old section name is prsent in
-        //wireless, then update the wireless to new configs 
-        LOG(DEBUG) << "The old iface and new are: " <<configuration.old_iface_name << " and " << iface ;
+        LOG(INFO) << "Successfully configured MLD section: " << mld_section_name 
+                  << " (ssid=" << configuration.ssid << ")";
 
-        if(!uci_find_section_by_option(package_name, section_type, option_name, configuration.old_iface_name, old_section_name)){
-                LOG(ERROR) << "Cant find any Section with iface: " << configuration.old_iface_name;
-                return false;
-        }
-        if(!old_section_name.empty())
-        {
-            LOG(DEBUG) << "Section found: " << old_section_name;
-            std::string device_val;
-            if (uci_get_option(package_name, section_type, old_section_name, "device", device_val)) {
-                if (device_val == resolve_device_section(configuration.freq_band)) {
-                    LOG(DEBUG) << "Section found and device matches: " << old_section_name;
-                    OptionsUnorderedMap mldOptions2 = build_map_options(iface, configuration);
-                    
-                    if (!uci_set_section(package_name, section_type, old_section_name, mldOptions2, true)) {
-                        LOG(ERROR) << "Failed to set wireless configuration for interface " << iface << " at section " << old_section_name;
-                        return false;
-                    }
-                }else{
-                    LOG(WARNING) << "Section found for iface " << configuration.old_iface_name
-                        << " but device mismatch: expected " << resolve_device_section(configuration.freq_band)
-                        << ", found " << device_val;
-                }
-            }else {
-                LOG(WARNING) << "Section found for iface " << configuration.old_iface_name
-                    << " but device option missing.";
-            }
-        }
+        std::string target_section;
+        bool section_found = false;
 
         std::string device_section = resolve_device_section(configuration.freq_band);
         std::string MLD_ID = "mld" + std::to_string(mld_id_val + 1);
 
+        // Search for existing section with matching (ifname OR old_ifname) + device + mld
         std::vector<std::string> all_iface_sections;
         if (!uci_get_all_sections(package_name, section_type, all_iface_sections)) {
             LOG(ERROR) << "Failed to get all wifi-iface sections";
             return false;
         }
-        LOG(DEBUG) << "Resolved device section: " << device_section;
-        LOG(INFO) << "MLD_ID: " << MLD_ID;
-        LOG(INFO) << "ifname: " << iface;
-
-        std::string matching_iface_section;
-        bool found_matching = false;
 
         for (const auto &section : all_iface_sections) {
             std::string ifname_val, device_val, mld_val;
-            if (uci_get_option(package_name, section_type, section, "ifname", ifname_val) &&
-                uci_get_option(package_name, section_type, section, "device", device_val) &&
-                uci_get_option(package_name, section_type, section, "mld", mld_val)) {
-                
-                LOG(DEBUG) << "Checking section: " << section
-                        << " | ifname: " << ifname_val
-                        << " | device: " << device_val
-                        << " | mld: " << mld_val;
-
-                if ((ifname_val == iface) && (device_val == device_section) && (mld_val == MLD_ID)) {
-                    matching_iface_section = section;
-                    found_matching = true;
-                    break;
-                }
+            if (!uci_get_option(package_name, section_type, section, "ifname", ifname_val)) {
+                LOG(DEBUG) << "Failed to get 'ifname' from section " << section;
+                continue;
             }
-        }
+            if (!uci_get_option(package_name, section_type, section, "device", device_val)) {
+                LOG(DEBUG) << "Failed to get 'device' from section " << section;
+                continue;
+            }
+            // mld option is optional, so we don't check return value
+            uci_get_option(package_name, section_type, section, "mld", mld_val);
 
-        if (found_matching) {
-            LOG(INFO) << "Found existing iface section with matching ifname, device, and mld: " << matching_iface_section;
-            OptionsUnorderedMap update_options = build_map_options(iface, configuration);
-            if (!uci_set_section(package_name, section_type, matching_iface_section, update_options, true)) {
-                LOG(ERROR) << "Failed to update existing iface section: " << matching_iface_section;
-                return false;
+            // Match by device first
+            if (device_val != device_section) {
+                continue;
             }
-        } else {
-            LOG(INFO) << "No matching iface section found, creating a new one";
+
+            bool ifname_matches = false;
+            if (!configuration.old_iface_name.empty()) {
+                // If old_iface_name provided, match by old name OR new name
+                ifname_matches = (ifname_val == configuration.old_iface_name) || (ifname_val == iface);
+            } else {
+                // If old_iface_name NOT provided, only match by new name
+                ifname_matches = (ifname_val == iface);
+            }
+
+            bool mld_matches = false;
+            if (mld_val.empty()) {
+                // Section has no MLD yet - can be converted to MLD
+                mld_matches = true;
+            } else if (mld_val == MLD_ID) {
+                // Section already has matching MLD
+                mld_matches = true;
+            }
+            // If mld_val has different MLD ID, don't match (mld_matches stays false)
+
+            if (ifname_matches && mld_matches) {
+                target_section = section;
+                section_found = true;
+                LOG(INFO) << "Found existing section: " << section
+                        << " (ifname=" << ifname_val << " -> " << iface
+                        << ", device=" << device_val << ", mld=" << (mld_val.empty() ? "none" : mld_val) << " -> " << MLD_ID << ")";
+                break;
+            }
+        }
+
+        if (!section_found) {
             int iface_index = 0;
             do {
-                section_name = "iface_wlan" + std::to_string(iface_index++);
-            } while (uci_section_exists(package_name, section_type, section_name));
+                target_section = "iface_wlan" + std::to_string(iface_index++);
+            } while (uci_section_exists(package_name, section_type, target_section));
 
-            if (!uci_add_section(package_name, section_type, section_name, true)) {
-                LOG(ERROR) << "Failed to add new section for interface " << iface;
+            if (!uci_add_section(package_name, section_type, target_section, true)) {
+                LOG(ERROR) << "Failed to add new section: " << target_section;
                 return false;
             }
+            LOG(INFO) << "Created new section: " << target_section << " for device: " << device_section;
+        }
 
-            OptionsUnorderedMap fresh_iface_options = build_map_options(iface, configuration);
-            if (!uci_set_section(package_name, section_type, section_name, fresh_iface_options, true)) {
-                LOG(ERROR) << "Failed to set wireless configuration for interface " << iface << " at section " << section_name;
-                return false;
-            }
+        OptionsUnorderedMap options = build_map_options(iface, configuration);
+        if (!uci_set_section(package_name, section_type, target_section, options, true)) {
+            LOG(ERROR) << "Failed to update section: " << target_section;
+            return false;
         }
+
+        LOG(INFO) << "Successfully configured section: " << target_section
+                << " (ifname=" << iface << ", device=" << device_section << ", mld=" << MLD_ID << ")";
+
     }
     return true;
 }
