From 1bd217586a640a40c09f4845974033bc27b82827 Mon Sep 17 00:00:00 2001
From: Praveen Babu <pravbabu@qti.qualcomm.com>
Date: Mon, 25 Aug 2025 12:05:46 +0530
Subject: [PATCH] Wired Backhaul Interface default value update

Signed-off-by: Praveen Babu <pravbabu@qti.qualcomm.com>
---
 CMakeLists.txt                                  | 2 +-
 agent/src/beerocks/slave/nbapi/odl/agent.odl.in | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index db4c8bcc3..9594a6ab2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -174,7 +174,7 @@ if (TARGET_PLATFORM STREQUAL "openwrt")
         set(BEEROCKS_WLAN2_IFACE "wlan1")
         set(BEEROCKS_WLAN2_STEERING_VAPS "wlan1.0")
     else()
-        set(BEEROCKS_BH_WIRE_IFACE "wan" CACHE STRING "Backhaul wire iface")
+        set(BEEROCKS_BH_WIRE_IFACE "eth1" CACHE STRING "Backhaul wire iface")
         set(BEEROCKS_WLAN2_IFACE "wlan1")
         set(BEEROCKS_WLAN2_STEERING_VAPS "wlan1.0")
     endif()
diff --git a/agent/src/beerocks/slave/nbapi/odl/agent.odl.in b/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
index 9fc3067ed..72151da15 100644
--- a/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
+++ b/agent/src/beerocks/slave/nbapi/odl/agent.odl.in
@@ -31,7 +31,7 @@
 
             /* Specifies the network interface to use for wired backhaul */
             %persistent string BackhaulWireInterface {
-                default "wan";
+                default "eth1";
             }
 
             /* Number of retry attempts before the agent stops due to failures. 0 disables retries */
-- 
2.34.1

