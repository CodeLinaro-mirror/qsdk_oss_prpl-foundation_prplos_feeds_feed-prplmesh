+/**
+ * @brief Send Multi-AP Policy Config Request from NBAPI
+ *
+ * Example of usage:
+ * ubus call Device.WiFi.DataElements.Network.Device.1 SendPolicyConfigRequest
+ *
+ */
+amxd_status_t send_policy_config_request(amxd_object_t *object, amxd_function_t *func,
+                                         amxc_var_t *args, amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "SendPolicyConfigRequest: Failed to get controller context.";
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_t value;
+    amxc_var_init(&value);
+    amxd_object_get_param(object, "ID", &value);
+    std::string agent_mac_str = amxc_var_constcast(cstring_t, &value);
+    amxc_var_clean(&value);
+
+    if (agent_mac_str.empty()) {
+        LOG(ERROR) << "SendPolicyConfigRequest: agent_mac_str is empty";
+        return amxd_status_parameter_not_found;
+    }
+
+    sMacAddr agent_mac = tlvf::mac_from_string(agent_mac_str);
+
+    if (!controller_ctx->send_policy_config_request(agent_mac)) {
+        LOG(ERROR) << "SendPolicyConfigRequest: Failed to send policy config request to agent: " << agent_mac_str;
+        return amxd_status_unknown_error;
+    }
+
+    LOG(INFO) << "SendPolicyConfigRequest: Successfully sent policy config request to agent: " << agent_mac_str;
+    return amxd_status_ok;
+}
+
+/**
+ * @brief Send Beacon Metrics Query from NBAPI
+ *
+ * Example of usage:
+ * ubus call Device.WiFi.DataElements.Network.Device.1 SendBeaconMetricsQuery \
+ * '{"sta_mac":"aa:bb:cc:dd:ee:ff", "operating_class":81, "channel":6, "bssid":"00:00:00:00:00:00", "ssid":"TestSSID"}'
+ *
+ */
+amxd_status_t send_beacon_metrics_query(amxd_object_t *object, amxd_function_t *func,
+                                        amxc_var_t *args, amxc_var_t *ret)
+{
+    auto controller_ctx = g_database->get_controller_ctx();
+
+    if (!controller_ctx) {
+        LOG(ERROR) << "SendBeaconMetricsQuery: Failed to get controller context.";
+        return amxd_status_unknown_error;
+    }
+
+    amxc_var_t value;
+    amxc_var_init(&value);
+    amxd_object_get_param(object, "ID", &value);
+    std::string agent_mac_str = amxc_var_constcast(cstring_t, &value);
+    amxc_var_clean(&value);
+
+    if (agent_mac_str.empty()) {
+        LOG(ERROR) << "SendBeaconMetricsQuery: agent_mac_str is empty";
+        return amxd_status_parameter_not_found;
+    }
+
+    // Validate and get sta_mac (required parameter)
+    std::string sta_mac_str;
+    auto sta_mac_cstr = amxc_var_dyncast(cstring_t, GET_ARG(args, "sta_mac"));
+    if (!sta_mac_cstr) {
+        LOG(ERROR) << "SendBeaconMetricsQuery: sta_mac parameter is required";
+        return amxd_status_parameter_not_found;
+    }
+    sta_mac_str.assign(sta_mac_cstr);
+    free(sta_mac_cstr);  // free the dynamically allocated string
+
+    // Validate operating_class (optional): read as uint32_t first to detect out-of-range values
+    uint32_t operating_class_raw = amxc_var_dyncast(uint32_t, GET_ARG(args, "operating_class"));
+    if (operating_class_raw > std::numeric_limits<uint8_t>::max()) {
+        LOG(ERROR) << "SendBeaconMetricsQuery: operating_class value " << operating_class_raw
+                   << " is out of valid range [0-255]";
+        return amxd_status_invalid_value;
+    }
+    uint8_t operating_class = static_cast<uint8_t>(operating_class_raw);
+
+    // Validate channel: read as uint32_t first to detect out-of-range values
+    uint32_t channel_raw = amxc_var_dyncast(uint32_t, GET_ARG(args, "channel"));
+    if (channel_raw > std::numeric_limits<uint8_t>::max()) {
+        LOG(ERROR) << "SendBeaconMetricsQuery: channel value " << channel_raw
+                   << " is out of valid range [0-255]";
+        return amxd_status_invalid_value;
+    }
+    uint8_t channel = static_cast<uint8_t>(channel_raw);
+
+    // Get bssid (optional parameter, defaults to wildcard)
+    std::string bssid_str;
+    auto bssid_cstr = amxc_var_dyncast(cstring_t, GET_ARG(args, "bssid"));
+    if (bssid_cstr) {
+        bssid_str.assign(bssid_cstr);
+        free(bssid_cstr);  // free the dynamically allocated string
+    } else {
+        bssid_str = "00:00:00:00:00:00"; // Default to wildcard BSSID
+    }
+
+    // Get ssid (optional parameter)
+    std::string ssid;
+    auto ssid_cstr = amxc_var_dyncast(cstring_t, GET_ARG(args, "ssid"));
+    if (ssid_cstr) {
+        ssid.assign(ssid_cstr);
+        free(ssid_cstr);  // free the dynamically allocated string
+    }
+
+    sMacAddr agent_mac = tlvf::mac_from_string(agent_mac_str);
+    sMacAddr sta_mac   = tlvf::mac_from_string(sta_mac_str);
+    sMacAddr bssid     = tlvf::mac_from_string(bssid_str);
+
+    if (!controller_ctx->send_beacon_metrics_query(agent_mac, sta_mac, operating_class, channel,
+                                                   bssid, ssid)) {
+        LOG(ERROR) << "SendBeaconMetricsQuery: Failed to send BEACON_METRICS_QUERY_MESSAGE to agent: " << agent_mac_str;
+        return amxd_status_unknown_error;
+    }
+
+    LOG(INFO) << "SendBeaconMetricsQuery: Successfully sent BEACON_METRICS_QUERY_MESSAGE to agent: " << agent_mac_str;
+    return amxd_status_ok;
+}
