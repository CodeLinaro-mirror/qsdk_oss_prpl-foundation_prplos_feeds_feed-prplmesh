 }
 
+bool Controller::send_policy_config_request(const sMacAddr &agent_mac)
+{
+    LOG(DEBUG) << "NBAPI SendPolicyConfigRequest for agent " << agent_mac;
+
+    auto agent = database.m_agents.get(agent_mac);
+    if (!agent) {
+        LOG(ERROR) << "Agent with mac is not found in database mac=" << agent_mac;
+        return false;
+    }
+
+    // Create and send Multi-AP Policy Config Request message
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE)) {
+        LOG(ERROR) << "Failed building MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE!";
+        return false;
+    }
+
+    // Add Traffic Separation Policy TLV
+    if (!agent_monitoring_task::add_traffic_separation_policy_tlv(database, cmdu_tx, agent_mac)) {
+        LOG(ERROR) << "Failed to add Traffic Separation Policy TLV for agent: " << agent_mac;
+        return false;
+    }
+
+    // Add Profile-2 Default 802.1Q Settings TLV
+    if (!agent_monitoring_task::add_profile_2default_802q_settings_tlv(database, cmdu_tx, agent_mac)) {
+        LOG(ERROR) << "Failed to add Profile-2 Default 802.1Q Settings TLV for agent: " << agent_mac;
+        return false;
+    }
+
+    // Send the CMDU to the agent
+    if (!son_actions::send_cmdu_to_agent(agent_mac, cmdu_tx, database)) {
+        LOG(ERROR) << "Failed to send Multi-AP Policy Config Request to agent: " << agent_mac;
+        return false;
+    }
+
+    LOG(DEBUG) << "Successfully sent Multi-AP Policy Config Request to agent " << agent_mac;
+    return true;
+}
+
+bool Controller::send_beacon_metrics_query(const sMacAddr &agent_mac, const sMacAddr &sta_mac,
+                                           uint8_t operating_class, uint8_t channel,
+                                           const sMacAddr &bssid, const std::string &ssid)
+{
+    LOG(DEBUG) << "NBAPI SendBeaconMetricsQuery for agent " << agent_mac << " sta " << sta_mac;
+
+    auto agent = database.m_agents.get(agent_mac);
+    if (!agent) {
+        LOG(ERROR) << "Agent with mac is not found in database mac=" << agent_mac;
+        return false;
+    }
+
+    // Create Beacon Metrics Query message
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::BEACON_METRICS_QUERY_MESSAGE)) {
+        LOG(ERROR) << "Failed building BEACON_METRICS_QUERY_MESSAGE!";
+        return false;
+    }
+
+    // Add Beacon Metrics Query TLV
+    auto beacon_metrics_query_tlv = cmdu_tx.addClass<wfa_map::tlvBeaconMetricsQuery>();
+    if (!beacon_metrics_query_tlv) {
+        LOG(ERROR) << "Failed to add tlvBeaconMetricsQuery TLV";
+        return false;
+    }
+
+    beacon_metrics_query_tlv->associated_sta_mac()     = sta_mac;
+    beacon_metrics_query_tlv->operating_class()        = operating_class;
+    beacon_metrics_query_tlv->channel_number()         = channel;
+    beacon_metrics_query_tlv->bssid()                  = bssid;
+    beacon_metrics_query_tlv->reporting_detail_value() = 0;
+
+    // Set SSID if provided
+    if (!ssid.empty()) {
+        if (!beacon_metrics_query_tlv->alloc_ssid(ssid.length())) {
+            LOG(ERROR) << "Failed to allocate SSID buffer";
+            return false;
+        }
+        std::memcpy(beacon_metrics_query_tlv->ssid(), ssid.data(), ssid.length());
+        beacon_metrics_query_tlv->ssid_length() = ssid.length();
+    } else {
+        beacon_metrics_query_tlv->ssid_length() = 0;
+    }
+
+    LOG(INFO) << "SendBeaconMetricsQuery: agent=" << agent_mac << " sta=" << sta_mac
+              << " op_class=" << (int)operating_class << " channel=" << (int)channel
+              << " bssid=" << bssid << " ssid=" << (ssid.empty() ? "(empty)" : ssid);
+
+    // Send the CMDU to the agent
+    if (!son_actions::send_cmdu_to_agent(agent_mac, cmdu_tx, database)) {
+        LOG(ERROR) << "Failed to send Beacon Metrics Query to agent: " << agent_mac;
+        return false;
+    }
+
+    LOG(DEBUG) << "Successfully sent Beacon Metrics Query to agent " << agent_mac;
+    return true;
+}
