-    LOG(DEBUG) << "Received BEACON_METRICS_RESPONSE_MESSAGE from " << src_mac 
+    LOG(DEBUG) << "Received BEACON_METRICS_RESPONSE_MESSAGE from " << src_mac
                << ", mid=0x" << std::hex << mid;
 
+    // Extract beacon metrics response TLV
+    auto beacon_response_tlv = cmdu_rx.getClass<wfa_map::tlvBeaconMetricsResponse>();
+    if (beacon_response_tlv) {
+        auto sta_mac = beacon_response_tlv->associated_sta_mac();
+        LOG(DEBUG) << "Processing beacon metrics for STA " << sta_mac;
+
+        // Process each measurement report
+        for (size_t i = 0; i < beacon_response_tlv->measurement_report_list_length(); i++) {
+            auto report_tuple = beacon_response_tlv->measurement_report_list(i);
+            if (!std::get<0>(report_tuple)) {
+                LOG(WARNING) << "Failed to get measurement report " << i;
+                continue;
+            }
+
+            auto &report = std::get<1>(report_tuple);
+
+            LOG(DEBUG) << "Beacon Report: STA=" << sta_mac
+                       << " BSSID=" << report.bssid()
+                       << " Channel=" << int(report.channel())
+                       << " OpClass=" << int(report.op_class())
+                       << " RCPI=" << int(report.rcpi())
+                       << " RSNI=" << int(report.rsni())
+                       << " Duration=" << report.duration()
+                       << " MeasurementToken=" << int(report.measurement_token());
+
+            // Store beacon measurement in the data model
+            beerocks_message::sBeaconResponse11k beacon = {};
+            beacon.sta_mac           = sta_mac;
+            beacon.bssid             = report.bssid();
+            beacon.channel           = report.channel();
+            beacon.op_class          = report.op_class();
+            beacon.rcpi              = report.rcpi();
+            beacon.rsni              = report.rsni();
+            beacon.duration          = report.duration();
+            beacon.measurement_token = report.measurement_token();
+            beacon.rep_mode          = report.measurement_req_mode();
+            beacon.phy_type          = report.phy_type();
+            beacon.ant_id            = report.antenna_id();
+            beacon.start_time        = report.start_time();
+            beacon.parent_tsf        = report.parent_tsf();
+            beacon.dialog_token      = 0; // Not available in 1905 TLV
+
+            if (!database.dm_add_sta_beacon_measurement(beacon)) {
+                LOG(ERROR) << "Failed to store beacon measurement in DM for STA " << sta_mac;
+            }
+        }
+    }
+
     // Build ACK message CMDU
     auto cmdu_tx_header = cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE);
     if (!cmdu_tx_header) {
@@ -5076,6 +5126,101 @@ bool Controller::send_btm_request(const bool &disassoc_imminent,
