Subject: [PATCH] Controller db code dump fix

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 controller/src/beerocks/master/db/db.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 63a5a81f6..0233f16ca 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -7342,7 +7342,7 @@ bool db::dm_add_sta_element(const sMacAddr &al_mac, const sMacAddr &bssid, Stati
                 path_to_sta + ".[MACAddress == '%s'].",
                 tlvf::mac_to_string(station.mac));
             if (existing_index) {
-                station.dm_path = path_to_sta + "." + std::to_string(existing_index) + ".";
+                station.dm_path = path_to_sta + "." + std::to_string(existing_index);
                 LOG(DEBUG) << "dm_add_sta_element: reusing existing DM STA entry "
                            << station.dm_path << " for " << station.mac << " (re-onboard)";
                 if (dm_reused) { *dm_reused = true; }
