+CoordinatedTdmaTask::CoordinatedTdmaTask(slave_thread &btl_ctx,
+                                         ieee1905_1::CmduMessageTx &cmdu_tx)
+    : Task(eTaskType::COORDINATED_TDMA), m_btl_ctx(btl_ctx), m_cmdu_tx(cmdu_tx)
+{
+    LOG(INFO) << "CoordinatedTdmaTask started";
+}
+
+void CoordinatedTdmaTask::work()
+{
+    // Fully event driven - no periodic/FSM work needed. All state lives in
+    // AgentDB::coordinated_aps and is updated directly by the handlers below.
+}
+
+bool CoordinatedTdmaTask::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                                      const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                                      std::shared_ptr<beerocks_header> beerocks_header)
+{
+    auto msg_type = static_cast<ieee1905_1::eMessageType>(cmdu_rx.getMessageType());
+
+    switch (msg_type) {
+    case ieee1905_1::eMessageType::COTDMA_CONFIGURATION_MESSAGE:
+        return handle_cotdma_configuration_message(cmdu_rx, src_mac);
+
+    default:
+        break;
+    }
+    return false;
+}
+
+bool CoordinatedTdmaTask::handle_cotdma_configuration_message(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                              const sMacAddr &src_mac)
+{
+    const auto mid = cmdu_rx.getMessageId();
+
+    LOG(DEBUG) << "CoordinatedTdmaTask: received COTDMA_CONFIGURATION_MESSAGE, mid=" << std::hex
+              << mid << std::dec;
+
+    m_cmdu_tx.create(mid, ieee1905_1::eMessageType::ACK_MESSAGE);
+    LOG(DEBUG) << "Sending ACK message to the controller, mid=" << std::hex << mid << std::dec;
+    m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+
+    return parse_cotdma_config(cmdu_rx);
+}
+
+bool CoordinatedTdmaTask::parse_cotdma_config(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    bool ok = true;
+
+    // Parse TLV_COTDMA_SHARING_AP_CONFIGURATION
+    auto sharing_ap_cfg = cmdu_rx.getClass<wfa_map::tlvCoTDMASharingApConfiguration>();
+    if (sharing_ap_cfg) {
+        LOG(DEBUG) << "CoordinatedTdmaTask: TLV_COTDMA_SHARING_AP_CONFIGURATION received";
+        if (!handle_sharing_ap_configuration(*sharing_ap_cfg)) {
+            LOG(WARNING) << "CoordinatedTdmaTask: handle_sharing_ap_configuration reported "
+                            "missing coordinated_aps entries";
+            ok = false;
+        }
+    }
+
+    // Parse the QCA VS TLV_QCA_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG (Sharing AP side)
+    auto sharing_fwd_cfg = cmdu_rx.getClass<qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig>();
+    if (sharing_fwd_cfg) {
+        LOG(DEBUG) << "CoordinatedTdmaTask: TLV_QCA_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG received";
+        if (!handle_sharing_ap_dl_scs_msdu_fwd_config(*sharing_fwd_cfg)) {
+            LOG(WARNING) << "CoordinatedTdmaTask: handle_sharing_ap_dl_scs_msdu_fwd_config reported "
+                            "missing coordinated_aps entries";
+            ok = false;
+        }
+    }
+
+    // Parse the QCA VS TLV_QCA_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG (Shared AP side)
+    auto shared_fwd_cfg = cmdu_rx.getClass<qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig>();
+    if (shared_fwd_cfg) {
+        LOG(DEBUG) << "CoordinatedTdmaTask: TLV_QCA_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG received";
+        if (!handle_shared_ap_dl_scs_msdu_fwd_config(*shared_fwd_cfg)) {
+            LOG(WARNING) << "CoordinatedTdmaTask: handle_shared_ap_dl_scs_msdu_fwd_config reported "
+                            "missing coordinated_aps entries";
+            ok = false;
+        }
+    }
+
+    return ok;
+}
+
+bool CoordinatedTdmaTask::handle_sharing_ap_configuration(
+    wfa_map::tlvCoTDMASharingApConfiguration &tlv)
+{
+    bool ok = true;
+
+    const sMacAddr sharing_bssid = tlv.sharing_bssid();
+    const bool is_remove =
+        (tlv.config_mode() == static_cast<uint8_t>(wfa_map::eCoTDMAConfigMode::REMOVE));
+
+    auto db = AgentDB::get();
+    auto coordinated_map_it = db->coordinated_aps.find(sharing_bssid);
+    if (coordinated_map_it == db->coordinated_aps.end()) {
+        LOG(ERROR) << "CoordinatedTdmaTask: no coordinated_aps entry for sharing_bssid="
+                   << sharing_bssid;
+        return false;
+    }
+    auto &coordinated_map = coordinated_map_it->second;
+
+    // Collect the shared_bss_list entries for the HAL call, and update the DB per-entry.
+    std::vector<wfa_map::sSharedBssEntry> shared_bss_list;
+    shared_bss_list.reserve(tlv.shared_bss_count());
+
+    for (size_t i = 0; i < tlv.shared_bss_count(); ++i) {
+        auto result = tlv.shared_bss_list(i);
+        if (!std::get<0>(result)) {
+            LOG(ERROR) << "CoordinatedTdmaTask: failed to read shared_bss_list[" << i << "]";
+            ok = false;
+            continue;
+        }
+        wfa_map::sSharedBssEntry &entry = std::get<1>(result);
+
+        auto state_it = coordinated_map.find(entry.shared_bssid);
+        if (state_it == coordinated_map.end()) {
+            LOG(ERROR) << "CoordinatedTdmaTask: no coordinated_aps entry for shared_bssid="
+                       << entry.shared_bssid << " (sharing_bssid=" << sharing_bssid << ")";
+            ok = false;
+            continue;
+        }
+
+        if (is_remove) {
+            state_it->second.status = AgentDB::sCoordinatedAPs::TEARDOWN_PENDING;
+            LOG(DEBUG) << "CoordinatedTdmaTask: set TEARDOWN_PENDING for shared_bssid="
+                       << entry.shared_bssid << " (sharing_bssid=" << sharing_bssid << ")";
+        } else {
+            state_it->second.status = AgentDB::sCoordinatedAPs::ESTABLISH_PENDING;
+            LOG(DEBUG) << "CoordinatedTdmaTask: set ESTABLISH_PENDING for shared_bssid="
+                       << entry.shared_bssid << " (sharing_bssid=" << sharing_bssid << ")";
+        }
+
+        shared_bss_list.push_back(entry);
+    }
+
+    for (const auto &entry : shared_bss_list) {
+        // Enable/disable CoTDMA for this sharing-shared bssid pair
+
+        if (!apply_cotdma_config(sharing_bssid, !is_remove, entry.shared_bssid)) {
+            LOG(WARNING) << "CoordinatedTdmaTask: apply_cotdma_config ("
+                         << (is_remove ? "REMOVE" : "ADD") << ") failed for sharing_bssid="
+                         << sharing_bssid << " shared_bssid=" << entry.shared_bssid;
+            ok = false;
+        }
+    }
+
+    return ok;
+}
+
+bool CoordinatedTdmaTask::handle_sharing_ap_dl_scs_msdu_fwd_config(
+    qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig &tlv)
+{
+    bool ok = true;
+    auto db = AgentDB::get();
+
+    for (size_t i = 0; i < tlv.qmid_count(); i++) {
+        auto result = tlv.qmid_entries(i);
+        if (!std::get<0>(result)) {
+            LOG(ERROR) << "CoordinatedTdmaTask: failed to read qmid_entries[" << i << "]";
+            ok = false;
+            continue;
+        }
+
+        qca::sQmidSharingConfigEntry &entry = std::get<1>(result);
+        // Bit 7: Remove/Add QMID (0=Remove, 1=Add)
+        bool is_add = (entry.config_mode & 0x80) != 0;
+        LOG(DEBUG) << " config_mode=" << (is_add ? "add" : "delete")
+                    << " sharing_bssid=" << tlvf::mac_to_string(entry.sharing_bssid)
+                    << " bsta_mac=" << tlvf::mac_to_string(entry.bsta_mac)
+                    << " shared_bssid=" << tlvf::mac_to_string(entry.shared_bssid)
+                    << " qmid=" << entry.qmid;
+
+        const sMacAddr &sharing_bssid = entry.sharing_bssid;
+        const sMacAddr &shared_bssid  = entry.shared_bssid;
+        const sMacAddr &bsta_mac      = entry.bsta_mac;
+        const uint16_t qmid           = entry.qmid;
+
+        auto coordinated_map_it = db->coordinated_aps.find(sharing_bssid);
+        if (coordinated_map_it == db->coordinated_aps.end()) {
+            LOG(ERROR) << "CoordinatedTdmaTask: no coordinated_aps entry for sharing_bssid="
+                       << sharing_bssid;
+            ok = false;
+            continue;
+        }
+        auto &coordinated_map = coordinated_map_it->second;
+
+        auto state_it = coordinated_map.find(shared_bssid);
+        if (state_it == coordinated_map.end()) {
+            LOG(ERROR) << "CoordinatedTdmaTask: no coordinated_aps entry for shared_bssid="
+                       << shared_bssid << " (sharing_bssid=" << sharing_bssid << ")";
+            ok = false;
+            continue;
+        }
+
+        if (is_add) {
+            if (state_it->second.status != AgentDB::sCoordinatedAPs::Established) {
+                state_it->second.status = AgentDB::sCoordinatedAPs::ESTABLISH_PENDING;
+                LOG(DEBUG) << "CoordinatedTdmaTask: set ESTABLISH_PENDING for shared_bssid="
+                           << shared_bssid << " (sharing_bssid=" << sharing_bssid << ")";
+
+                if (!apply_cotdma_config(sharing_bssid, true, shared_bssid)) {
+                    LOG(WARNING) << "CoordinatedTdmaTask: apply_cotdma_config (QMID ADD) failed "
+                                    "for sharing_bssid="
+                                 << sharing_bssid;
+                }
+            }
+
+            if (!send_cotdma_e2e_config(sharing_bssid, 1, qmid, shared_bssid,
+                                        bsta_mac)) {
+                LOG(WARNING) << "CoordinatedTdmaTask: send_cotdma_e2e_config (ADD) failed for "
+                                "sharing_bssid="
+                             << sharing_bssid;
+            }
+        } else {
+            // Remove: send E2E config only, no coordinated_aps map change.
+            if (!send_cotdma_e2e_config(sharing_bssid, 0, qmid, shared_bssid,
+                                        bsta_mac)) {
+                LOG(WARNING) << "CoordinatedTdmaTask: send_cotdma_e2e_config (REMOVE) failed for "
+                                "sharing_bssid="
+                             << sharing_bssid;
+            }
+        }
+    }
+
+    return ok;
+}
+
+bool CoordinatedTdmaTask::handle_shared_ap_dl_scs_msdu_fwd_config(
+    qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig &tlv)
+{
+    bool ok = true;
+    auto db = AgentDB::get();
+
+    for (size_t i = 0; i < tlv.qmid_count(); i++) {
+        auto result = tlv.qmid_entries(i);
+        if (!std::get<0>(result)) {
+            LOG(ERROR) << "CoordinatedTdmaTask: failed to read qmid_entries[" << i << "]";
+            ok = false;
+            continue;
+        }
+
+        qca::sQmidSharedConfigEntry &entry = std::get<1>(result);
+
+        // Copy fields out of the TLV entry locally before use, rather than referencing the
+        // TLV buffer directly across the send_cotdma_e2e_config() call.
+        const sMacAddr shared_bssid = entry.shared_bssid;
+        const sMacAddr peer_bssid   = entry.peer_bssid;
+        const uint16_t qmid         = entry.qmid;
+        // Bit 7: Remove/Add QMID (0=Remove, 1=Add). send_cotdma_e2e_config() expects a
+        // plain 1 (add) / 0 (delete) config_mode, not the raw bitmask.
+        const bool is_add        = (entry.config_mode & 0x80) != 0;
+        const uint8_t config_mode = is_add ? 1 : 0;
+
+        LOG(INFO) << " config_mode=" << (is_add ? "add" : "delete")
+                    << " shared_bssid=" << tlvf::mac_to_string(shared_bssid)
+                    << " peer_bssid=" << tlvf::mac_to_string(peer_bssid)
+                    << " qmid=" << qmid;
+
+        if (!send_cotdma_e2e_config(shared_bssid, config_mode, qmid, peer_bssid,
+                                    beerocks::net::network_utils::ZERO_MAC)) {
+            LOG(WARNING) << "CoordinatedTdmaTask: send_cotdma_e2e_config failed for "
+                            "shared_bssid="
+                            << shared_bssid;
+            ok = false;
+        }
+    }
+
+    return ok;
+}
+
+bool CoordinatedTdmaTask::apply_cotdma_config(
+    const sMacAddr &sharing_bssid, bool cotdma_enabled, const sMacAddr &shared_bssid)
+{
+    // Send cACTION_APMANAGER_SET_MAPC_STA_REQUEST to the ap_manager that owns
+    // sharing_bssid. The ap_manager calls ap_wlan_hal->set_mapc_sta(sharing_bssid,
+    // cotdma_enabled, shared_bss) which sends the per-BSS wpa_ctrl command.
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_APMANAGER_SET_MAPC_STA_REQUEST>(m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to create cACTION_APMANAGER_SET_MAPC_STA_REQUEST";
+        return false;
+    }
+
+    // config_mode doubles as the enable/disable flag for this request:
+    // 1 = add / enable Co-TDMA on sharing_bssid, 0 = remove / disable.
+    request->sharing_bssid() = sharing_bssid;
+    request->cotdma_enabled() = cotdma_enabled ? 1 : 0;
+    request->shared_bssid() = shared_bssid;
+
+    LOG(DEBUG) << "CoordinatedTdmaTask: sending SET_MAPC_STA_REQUEST sharing_bssid="
+              << sharing_bssid << " cotdma_enabled=" << cotdma_enabled
+              << " shared_bssid=" << shared_bssid;
+
+    return send_cmdu_to_ap_manager_for_bssid(sharing_bssid, m_cmdu_tx);
+}
+
+bool CoordinatedTdmaTask::send_cotdma_e2e_config(const sMacAddr &cotdma_local_bssid,
+                                                 uint8_t config_mode, uint16_t qmid,
+                                                 const sMacAddr &cotdma_peer_bssid,
+                                                 const sMacAddr &cotdma_backhaul_bsta)
+{
+    // Send cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST to the ap_manager that owns
+    // cotdma_local_bssid. The ap_manager calls ap_wlan_hal->send_cotdma_e2e_config().
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST>(m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to create "
+                      "cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST";
+        return false;
+    }
+
+    request->cotdma_local_bssid()   = cotdma_local_bssid;
+    request->config_mode()          = config_mode;
+    request->qmid()                 = qmid;
+    request->cotdma_peer_bssid()      = cotdma_peer_bssid;
+    request->cotdma_backhaul_bsta() = cotdma_backhaul_bsta;
+
+    LOG(DEBUG) << "CoordinatedTdmaTask: sending COTDMA_E2E_CONFIG_REQUEST cotdma_local_bssid="
+              << cotdma_local_bssid << " config_mode=" << int(config_mode) << " qmid=" << qmid
+              << " cotdma_peer_bssid=" << cotdma_peer_bssid
+              << " cotdma_backhaul_bsta=" << cotdma_backhaul_bsta;
+
+    return send_cmdu_to_ap_manager_for_bssid(cotdma_local_bssid, m_cmdu_tx);
+}
+
+bool CoordinatedTdmaTask::send_cmdu_to_ap_manager_for_bssid(const sMacAddr &bssid,
+                                                      ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    auto db    = AgentDB::get();
+    auto radio = db->get_radio_by_mac(bssid, AgentDB::eMacType::BSSID);
+    if (!radio) {
+        LOG(WARNING) << "send_cmdu_to_ap_manager_for_bssid: no radio found for bssid=" << bssid;
+        return false;
+    }
+
+    const int ap_manager_fd = m_btl_ctx.get_ap_manager_fd(radio->front.iface_name);
+    if (ap_manager_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(WARNING) << "send_cmdu_to_ap_manager_for_bssid: ap_manager_fd invalid for iface="
+                     << radio->front.iface_name;
+        return false;
+    }
+
+    return m_btl_ctx.send_cmdu(ap_manager_fd, cmdu_tx);
+}
+
+bool CoordinatedTdmaTask::handle_mapc_negotiation_status_event(const sMacAddr &src_bssid,
+                                                                const sMacAddr &dst_bssid,
+                                                                uint8_t negotiation_status)
+{
+    LOG(DEBUG) << "CoordinatedTdmaTask: MAPC-NEGOTIATION-STATUS event src_bssid=" << src_bssid
+              << " dst_bssid=" << dst_bssid << " negotiation_status=" << int(negotiation_status);
+
+    return report_mapc_negotiation_status(negotiation_status, src_bssid, dst_bssid);
+}
+
+bool CoordinatedTdmaTask::handle_mapc_discovery_report_event(const sMacAddr &src_bssid,
+                                                              const sMacAddr &dst_bssid,
+                                                              uint16_t peer_cap, uint16_t local_cap)
+{
+    LOG(DEBUG) << "CoordinatedTdmaTask: MAPC-DISCOVERY-REPORT event src_bssid=" << src_bssid
+              << " dst_bssid=" << dst_bssid << " peer_cap=0x" << std::hex << peer_cap
+              << " local_cap=0x" << local_cap << std::dec;
+
+    // ToDo : Add sanity to make sure dst bssid of MAPC Discovery Report received is for the current Agent.
+    // Look up (or create, with neg_status=IDLE) the coordinated_aps entry for this pair, and
+    // update its mapc_capabilities with the peer's reported capability bitmap.
+    {
+        auto db = AgentDB::get();
+        auto &coordinated_map = db->coordinated_aps[dst_bssid];
+        auto &state           = coordinated_map[src_bssid];
+        // operator[] default-constructs a new sCoordinatedAPs (neg_status=IDLE) if the entry
+        // did not already exist, which is exactly the required behavior.
+        state.mapc_capabilities = peer_cap;
+    }
+
+    // Build and send MAPC_REPORT_MESSAGE with tlvMapcCapabilityUpdate to Controller
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::MAPC_REPORT_MESSAGE)) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to create MAPC_REPORT_MESSAGE for discovery "
+                      "report";
+        return false;
+    }
+    auto tlv = m_cmdu_tx.addClass<wfa_map::tlvMapcCapabilityUpdate>();
+    if (!tlv) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to allocate tlvMapcCapabilityUpdate";
+        return false;
+    }
+    tlv->local_bssid() = dst_bssid;
+    // NOTE: alloc_peer_bss_capabilities() itself increments peer_bss_count() internally
+    // (it does `*m_peer_bss_count += count`). Do NOT pre-assign peer_bss_count() before
+    // calling alloc, or the field will end up double-counted relative to the actually
+    // allocated/serialized entries, producing a malformed TLV that fails to parse on the
+    // receiving end (buffPtrIncrementSafe() failure due to peer_bss_count() not matching
+    // the real number of sMapcBssCapability entries present in the TLV).
+    if (!tlv->alloc_peer_bss_capabilities(1)) {
+        LOG(ERROR) << "CoordinatedTdmaTask: alloc_peer_bss_capabilities(1) failed";
+        return false;
+    }
+    auto bss_cap_tuple = tlv->peer_bss_capabilities(0);
+    if (!std::get<0>(bss_cap_tuple)) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to access peer_bss_capabilities[0]";
+        return false;
+    }
+    auto &peer_bss_cap                  = std::get<1>(bss_cap_tuple);
+    peer_bss_cap.bssid                  = src_bssid;
+    peer_bss_cap.mapc_capability_bitmap = peer_cap;
+    peer_bss_cap.ctdma_profile_len      = 0;
+    peer_bss_cap.ctdma_profile          = 0;
+
+    m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+    return true;
+}
+
+bool CoordinatedTdmaTask::report_mapc_negotiation_status(uint8_t negotiation_status_val,
+                                                          const sMacAddr &source_bssid,
+                                                          const sMacAddr &destination_bssid)
+{
+    bool entry_found = false;
+    const bool success = (negotiation_status_val != 0);
+
+    // Update AgentDB coordinated_aps map based on negotiation result
+    {
+        auto db = AgentDB::get();
+        auto coordinated_map_it = db->coordinated_aps.find(source_bssid);
+        if (coordinated_map_it != db->coordinated_aps.end()) {
+            auto &coordinated_map = coordinated_map_it->second;
+            auto state_it = coordinated_map.find(destination_bssid);
+            if (state_it != coordinated_map.end()) {
+                entry_found = true;
+                if (success) {
+                    state_it->second.status = AgentDB::sCoordinatedAPs::Established;
+                    LOG(DEBUG) << "CoordinatedTdmaTask: negotiation SUCCESS, marking Established "
+                                  "for "
+                               << destination_bssid << " (sharing_bssid=" << source_bssid << ")";
+                } else {
+                    state_it->second.status = AgentDB::sCoordinatedAPs::Torn;
+                    LOG(DEBUG) << "CoordinatedTdmaTask: negotiation FAILURE, marking Torn for "
+                               << destination_bssid << " (sharing_bssid=" << source_bssid << ")";
+                }
+            }
+        }
+
+        if (!entry_found) {
+            LOG(ERROR) << "CoordinatedTdmaTask: no coordinated_aps entry for sharing_bssid="
+                       << source_bssid << " shared_bssid=" << destination_bssid;
+        }
+    }
+
+    // Build and send MAPC_REPORT_MESSAGE with tlvMapcNegotiationStatus to Controller regardless
+    // of whether the DB entry was found, so the Controller is always informed of the outcome.
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::MAPC_REPORT_MESSAGE)) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to create MAPC_REPORT_MESSAGE for negotiation";
+        return entry_found;
+    }
+    auto tlv = m_cmdu_tx.addClass<wfa_map::tlvMapcNegotiationStatus>();
+    if (!tlv) {
+        LOG(ERROR) << "CoordinatedTdmaTask: failed to allocate tlvMapcNegotiationStatus";
+        return entry_found;
+    }
+
+    // flags: Bit 7: negotiationType (0=Teardown, 1=Establishment),
+    //        Bit 6: negotiationStatus (0=Fail, 1=Success)
+    uint8_t flags = 0;
+    flags |= 0x80; // Establishment (this path is only used for negotiation establish/fail today)
+    if (success) {
+        flags |= 0x40;
+    }
+
+    tlv->flags()            = flags;
+    tlv->local_mapc_bssid()  = source_bssid;
+    tlv->remote_mapc_bssid() = destination_bssid;
+
+    m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx);
+    return entry_found;
+}
+
+} // namespace coordinated_tdma
+} // namespace beerocks
