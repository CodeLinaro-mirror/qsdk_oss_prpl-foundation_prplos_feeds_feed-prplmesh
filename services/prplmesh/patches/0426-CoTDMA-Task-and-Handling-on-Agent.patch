+#ifndef _COORDINATED_TDMA_TASK_H_
+#define _COORDINATED_TDMA_TASK_H_
+
+#include "task.h"
+#include "task_pool_interface.h"
+#include <bpl/bpl.h>
+#include <tlvf/CmduMessageTx.h>
+#include <tlvf/wfa_map/tlvCoTDMASharingApConfiguration.h>
+#include <tlvf/qca/tlvQcaCoTDMASharingApDlScsMsduFwdConfig.h>
+#include <tlvf/qca/tlvQcaCoTDMASharedApDlScsMsduFwdConfig.h>
+#include <vector>
+
+namespace beerocks {
+
+class slave_thread;
+
+namespace coordinated_tdma {
+
+/**
+ * @brief Agent-side Coordinated TDMA (Co-TDMA) task.
+ *
+ * This task is fully event driven - it has no internal FSM/state of its own.
+ * All negotiation state is kept in AgentDB::coordinated_aps (per sharing_bssid ->
+ * shared_bssid -> negotiation status), which is the single source of truth.
+ *
+ * Responsibilities:
+ *  - Handles COTDMA_CONFIGURATION_MESSAGE (0x804A) from the Controller, which carries:
+ *      * TLV_COTDMA_SHARING_AP_CONFIGURATION (wfa_map::tlvCoTDMASharingApConfiguration)
+ *      * QCA VS TLV_QCA_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG
+ *        (qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig)
+ *      * QCA VS TLV_QCA_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG
+ *        (qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig)
+ *  - Updates the AgentDB::coordinated_aps map according to the received TLVs, and
+ *    triggers the corresponding HAL-level configuration (via the ap_manager, over
+ *    cACTION_APMANAGER_SET_MAPC_STA_REQUEST / cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST).
+ *  - Handles the MAPC-NEGOTIATION-STATUS event from hostapd (once the hostapd event
+ *    plumbing is wired) via handle_mapc_negotiation_status_event(), updating the
+ *    coordinated_aps map and reporting the outcome to the Controller.
+ *  - Handles other MAPC events (Capability Report, Negotiation Response) received from
+ *    hostapd via Vendor Specific messages, forwarding them to the Controller.
+ */
+class CoordinatedTdmaTask : public Task {
+public:
+    CoordinatedTdmaTask(slave_thread &btl_ctx, ieee1905_1::CmduMessageTx &cmdu_tx);
+
+    bool handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                     const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                     std::shared_ptr<beerocks_header> beerocks_header) override;
+    void work() override;
+
+    /**
+     * @brief Handle a MAPC-NEGOTIATION-STATUS event from hostapd.
+     *
+     * Expected hostapd ctrl event format (to be wired later once the hostapd event
+     * plumbing is in place):
+     *   "MAPC-NEGOTIATION-STATUS negotiation_status=<0|1> src_bssid=<MAC> dst_bssid=<MAC>"
+     *
+     * This method assumes the event contents have already been parsed by the caller
+     * into src_bssid, dst_bssid and negotiation_status. src_bssid corresponds to the
+     * sharing_bssid (outer key of AgentDB::coordinated_aps) and dst_bssid corresponds to
+     * the shared_bssid (inner key). negotiation_status is 0 for failure, 1 for success.
+     *
+     * On success, sets the corresponding coordinated_aps entry's neg_status to
+     * Established. On failure, sets it to Torn. Then sends a MAPC_REPORT_MESSAGE to the
+     * Controller carrying a tlvMapcNegotiationStatus TLV with the outcome.
+     *
+     * @param src_bssid Sharing BSSID (Negotiation Request Initiator).
+     * @param dst_bssid Shared BSSID (Negotiation Request Responder).
+     * @param negotiation_status 0 for failure, 1 for success.
+     * @return true if the coordinated_aps map entry was found and updated, false
+     *         otherwise. The report to the Controller is sent regardless.
+     */
+    bool handle_mapc_negotiation_status_event(const sMacAddr &src_bssid, const sMacAddr &dst_bssid,
+                                              uint8_t negotiation_status);
+
+    /**
+     * @brief Handle a MAPC-DISCOVERY-REPORT event from hostapd.
+     *
+     * Expected hostapd ctrl event format (to be wired later once the hostapd event
+     * plumbing is in place):
+     *   "MAPC-DISCOVERY-REPORT src=<MAC> dst=<MAC> peer_cap=<hex> local_cap=<hex>"
+     *
+     * This method assumes the event contents have already been parsed by the caller
+     * into dst (local BSSID that sent the discovery request),
+     * src (peer BSSID from whom the MAPC discovery response was received),
+     * peer_cap (the peer's MAPC capability bitmap) and local_cap (local MAPC capability bitmap).
+     *
+     * Looks up coordinated_aps[dst][src]; if the entry does not already exist, it is
+     * created with neg_status = IDLE. In either case, the entry's mapc_capabilities is
+     * updated with peer_cap. A MAPC_REPORT_MESSAGE with a tlvMapcCapabilityUpdate TLV
+     * (single entry for src, bitmap = peer_cap) is then sent to the Controller.
+     *
+     * @param src_bssid peer BSSID which responded to the discovery request.
+     * @param dst_bssid local BSSID which sent the discovery report.
+     * @param peer_cap MAPC capability bitmap advertised by peer BSSID.
+     * @param local_cap MAPC capability bitmap advertised by local BSSID.
+     * @return true on success (the report was built and sent to the Controller).
+     */
+    bool handle_mapc_discovery_report_event(const sMacAddr &src_bssid, const sMacAddr &dst_bssid,
+                                            uint16_t peer_cap, uint16_t local_cap);
+
+private:
+    /**
+     * @brief Handle COTDMA_CONFIGURATION_MESSAGE from the Controller.
+     * @param cmdu_rx Received CMDU.
+     * @param src_mac Controller AL MAC address.
+     * @return true if handled.
+     */
+    bool handle_cotdma_configuration_message(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                             const sMacAddr &src_mac);
+
+    /**
+     * @brief Handle MAPC Capability Report from hostapd.
+     * @param cmdu_rx Received CMDU.
+     * @param beerocks_header Beerocks header.
+     * @return true if handled.
+     */
+    bool handle_mapc_capability_report(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                       std::shared_ptr<beerocks_header> beerocks_header);
+
+    /**
+     * @brief Handle MAPC Negotiation Response Status from hostapd (VS message path).
+     * @param cmdu_rx Received CMDU.
+     * @param beerocks_header Beerocks header.
+     * @return true if handled.
+     */
+    bool handle_mapc_negotiation_response(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                          std::shared_ptr<beerocks_header> beerocks_header);
+
+    /**
+     * @brief Parse the Co-TDMA TLVs from the received COTDMA_CONFIGURATION_MESSAGE CMDU and
+     * update the AgentDB::coordinated_aps map + trigger the HAL-level configuration.
+     *
+     * @param cmdu_rx Received CMDU containing the Co-TDMA TLVs.
+     * @return true on success, false if any mandatory TLV is missing/malformed, or if a
+     *         referenced coordinated_aps entry could not be found.
+     */
+    bool parse_cotdma_config(ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Handle the TLV_COTDMA_SHARING_AP_CONFIGURATION TLV contents.
+     *
+     * For every shared_bssid entry in the TLV, look up the corresponding entry in
+     * AgentDB::coordinated_aps[sharing_bssid]. If the entry is not found, that entry is
+     * skipped and the overall return value is false (processing of the remaining valid
+     * entries still continues, and the HAL is still updated for those).
+     *
+     * - config_mode == REMOVE: set neg_status = TEARDOWN_PENDING, and send
+     *   cACTION_APMANAGER_SET_MAPC_STA_REQUEST to hostapd with delete (cotdma disabled) for
+     *   the shared_bssid.
+     * - config_mode == ADD: set neg_status = ESTABLISH_PENDING, and send
+     *   cACTION_APMANAGER_SET_MAPC_STA_REQUEST to hostapd with add (cotdma enabled) for the
+     *   shared_bssid.
+     *
+     * @param tlv Parsed tlvCoTDMASharingApConfiguration.
+     * @return true if all referenced coordinated_aps entries were found and updated,
+     *         false if any entry was missing.
+     */
+    bool handle_sharing_ap_configuration(wfa_map::tlvCoTDMASharingApConfiguration &tlv);
+
+    /**
+     * @brief Handle the QCA VS TLV_QCA_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG TLV contents.
+     *
+     * For every QMID entry in the TLV, look up the corresponding entry in
+     * AgentDB::coordinated_aps[sharing_bssid]. If the entry is not found, that entry is
+     * skipped and the overall return value is false.
+     *
+     * - config_mode bit-7 == Add (1), and current neg_status != Established:
+     *     -- set neg_status = ESTABLISH_PENDING
+     *     -- send cACTION_APMANAGER_SET_MAPC_STA_REQUEST to hostapd with add for the
+     *        shared_bssid
+     *     -- send cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST with the corresponding TLV
+     *        values (qmid, bsta_mac as cotdma_backhaul_bsta)
+     * - config_mode bit-7 == Remove (0):
+     *     -- send cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST with the corresponding TLV
+     *        values
+     *     -- No change to the coordinated_aps map
+     *
+     * @param tlv Parsed TLV from CMDU
+     * @return true if all referenced coordinated_aps entries were found, false otherwise.
+     *         Returns true (no-op) if the TLV is not present in the CMDU.
+     */
+    bool handle_sharing_ap_dl_scs_msdu_fwd_config(qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig &tlv);
+
+    /**
+     * @brief Handle the QCA VS TLV_QCA_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG TLV contents.
+     *
+     *     -- send cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST with the corresponding TLV
+     *        values
+     *     -- No change to the coordinated_aps map
+     *
+     * @param tlv Parsed TLV from CMDU
+     * @return true if all referenced coordinated_aps entries were found, false otherwise.
+     *         Returns true (no-op) if the TLV is not present in the CMDU.
+     */
+    bool handle_shared_ap_dl_scs_msdu_fwd_config(qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig &tlv);
+
+    /**
+     * @brief Sends a CMDU to the AP manager that owns the given BSSID.
+     *
+     * Looks up the radio owning @p bssid in AgentDB, resolves the corresponding
+     * radio manager, and calls send_cmdu(ap_manager_fd, cmdu_tx).
+     *
+     * @param bssid  BSSID of the local BSS whose AP manager should receive the message.
+     * @param cmdu_tx CMDU message to send.
+     * @return true on success, false if the radio or AP manager FD is not found.
+     */
+    bool send_cmdu_to_ap_manager_for_bssid(const sMacAddr &bssid,
+                                           ieee1905_1::CmduMessageTx &cmdu_tx);
+
+    /**
+     * @brief Apply the parsed Co-TDMA STA configuration by calling the qmesh HAL API.
+     *
+     * Sends cACTION_APMANAGER_SET_MAPC_STA_REQUEST to the ap_manager that owns
+     * @p sharing_bssid. The ap_manager calls
+     * ap_wlan_hal->set_mapc_sta(sharing_bssid, cotdma_enabled, shared_bssid) which sends
+     * the per-BSS wpa_ctrl command.
+     *
+     * @param sharing_bssid BSSID of the sharing AP (selects the per-BSS socket).
+     * @param cotdma_enabled true to enable Co-TDMA (ADD), false to disable (REMOVE).
+     * @param shared_bssid BSSID of the shared BSS
+     * @return true on success, false on error.
+     */
+    bool apply_cotdma_config(const sMacAddr &sharing_bssid, bool cotdma_enabled,
+                             const sMacAddr &shared_bssid);
+
+    /**
+     * @brief Send the Co-TDMA E2E configuration (QMID + peer info) to the ap_manager.
+     *
+     * Sends cACTION_APMANAGER_COTDMA_E2E_CONFIG_REQUEST to the ap_manager that owns
+     * @p cotdma_local_bssid. The ap_manager calls ap_wlan_hal->send_cotdma_e2e_config(), which
+     * sends the NL vendor sub-command to configure QMID and the corresponding TXoP.
+     *
+     * @param cotdma_local_bssid BSSID of the sharing AP (selects the per-BSS socket).
+     * @param config_mode 1=add QMID, 0=delete QMID.
+     * @param qmid QMID configured for the peer.
+     * @param cotdma_peer_bssid Multi-AP peer MAC (shared_bssid or peer_mac depending on TLV).
+     * @param cotdma_backhaul_bsta Multi-AP peer bSTA connected to this AP (bsta_mac).
+     * @return true on success, false on error.
+     */
+    bool send_cotdma_e2e_config(const sMacAddr &cotdma_local_bssid,
+                                uint8_t config_mode, uint16_t qmid,
+                                const sMacAddr &cotdma_peer_bssid,
+                                const sMacAddr &cotdma_backhaul_bsta);
+
+    /**
+     * @brief Update AgentDB::coordinated_aps for the given negotiation result and send a
+     * MAPC_REPORT_MESSAGE (tlvMapcNegotiationStatus) to the Controller.
+     *
+     * @param negotiation_status_val 0 for failure, 1 for success (wfa_map::eMapcNegotiationStatus)
+     * @param source_bssid Sharing BSSID (src_bssid)
+     * @param destination_bssid Shared BSSID (dst_bssid)
+     * @return true if the coordinated_aps entry was found and updated, false otherwise.
+     *         The report to the Controller is sent regardless.
+     */
+    bool report_mapc_negotiation_status(uint8_t negotiation_status_val,
+                                        const sMacAddr &source_bssid,
+                                        const sMacAddr &destination_bssid);
+
+    slave_thread &m_btl_ctx;
+    ieee1905_1::CmduMessageTx &m_cmdu_tx;
+};
+
+} // namespace coordinated_tdma
+} // namespace beerocks
