+bool ApAutoConfigurationTask::handle_mapc_configuration_policy(
+    wfa_map::tlvMapcConfigurationPolicy &tlv)
+{
+    // For each local BSS entry in the MAPC Configuration Policy TLV, flatten the
+    // permitted remote BSSIDs across all remote agents and send a
+    // cACTION_APMANAGER_SET_MAPC_VALID_COAP_LIST_REQUEST to the ap_manager that owns
+    // that local_bssid. The ap_manager calls ap_wlan_hal->set_mapc_valid_coap_list()
+    // which programs the permitted remote BSSID list into the driver via wpa_ctrl.
+    const uint8_t n_local_bss = tlv.local_bss_count();
+    LOG(DEBUG) << "handle_mapc_configuration_policy: local_bss_count=" << int(n_local_bss);
+
+    for (uint8_t i = 0; i < n_local_bss; i++) {
+        auto local_bss_tuple = tlv.local_bss_list(i);
+        if (!std::get<0>(local_bss_tuple)) {
+            LOG(ERROR) << "Failed to get local_bss_list[" << int(i) << "]";
+            return false;
+        }
+        auto &local_bss = std::get<1>(local_bss_tuple);
+
+        const sMacAddr &local_bssid = local_bss.local_bssid();
+
+        // Flatten permitted remote BSSIDs across all remote agents
+        std::vector<sMacAddr> permitted_bssids;
+        const uint8_t n_remote_agents = local_bss.remote_agent_count();
+        for (uint8_t j = 0; j < n_remote_agents; j++) {
+            auto remote_agent_tuple = local_bss.remote_agent_list(j);
+            if (!std::get<0>(remote_agent_tuple)) {
+                LOG(ERROR) << "Failed to get remote_agent_list[" << int(j) << "]";
+                continue;
+            }
+            auto &remote_agent = std::get<1>(remote_agent_tuple);
+            const uint8_t n_permitted = remote_agent.permitted_remote_bss_count();
+            for (uint8_t k = 0; k < n_permitted; k++) {
+                auto perm_bss_tuple = remote_agent.permitted_remote_bss_list(k);
+                if (!std::get<0>(perm_bss_tuple)) {
+                    LOG(ERROR) << "Failed to get permitted_remote_bss_list[" << int(k) << "]";
+                    continue;
+                }
+                permitted_bssids.push_back(
+                    std::get<1>(perm_bss_tuple).permitted_remote_bssid());
+            }
+        }
+
+        // Build the CMDU
+        auto request = message_com::create_vs_message<
+            beerocks_message::cACTION_APMANAGER_SET_MAPC_VALID_COAP_LIST_REQUEST>(m_cmdu_tx);
+        if (!request) {
+            LOG(ERROR) << "Failed to create cACTION_APMANAGER_SET_MAPC_VALID_COAP_LIST_REQUEST";
+            return false;
+        }
+
+        request->local_bssid() = local_bssid;
+
+        const uint8_t n_permitted = static_cast<uint8_t>(permitted_bssids.size());
+        if (!request->alloc_permitted_bssids(n_permitted)) {
+            LOG(ERROR) << "alloc_permitted_bssids(" << int(n_permitted) << ") failed";
+            return false;
+        }
+        for (uint8_t j = 0; j < n_permitted; j++) {
+            std::get<1>(request->permitted_bssids(j)) = permitted_bssids[j];
+        }
+
+        LOG(DEBUG) << "MAPC config policy: sending SET_MAPC_VALID_COAP_LIST_REQUEST"
+                   << " local_bssid=" << local_bssid
+                   << " n_permitted=" << int(n_permitted);
+
+        auto db    = AgentDB::get();
+        auto radio = db->get_radio_by_mac(local_bssid, AgentDB::eMacType::BSSID);
+        if (!radio) {
+            LOG(WARNING) << "handle_mapc_configuration_policy: no radio found for bssid=" << local_bssid;
+            continue;
+        }
+
+        auto ap_manager_fd = m_btl_ctx.get_ap_manager_fd(radio->front.iface_name);
+        if (ap_manager_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+            LOG(ERROR) << "Invalid AP manager fd for radio " << radio->front.iface_name;
+            continue;
+        }
+
+        m_btl_ctx.send_cmdu(ap_manager_fd, m_cmdu_tx);
+    }
+
+    return true;
+}
