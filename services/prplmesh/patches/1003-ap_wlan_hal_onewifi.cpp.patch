+void ap_wlan_hal_onewifi::on_ap_metrics_data(const char *json_str, unsigned int len)
+{
+    if (!json_str || len == 0) return;
+
+    ONEWIFI_LOG_DEBUG("on_ap_metrics_data: received AP metrics report from OneWifi (len=%u)", len);
+
+    webconfig_external_easymesh_t ext_data = {};
+    webconfig_t config = {};
+    if (!init_webconfig_for_decode(ext_data, config)) {
+        ONEWIFI_LOG_ERROR("on_ap_metrics_data: webconfig init failed");
+        return;
+    }
+
+    // Use em_ap_metrics_report subdoc type to decode radio + BSS + STA stats
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_em_ap_metrics_report;
+    if (safe_webconfig_decode(&config, json_str, &ext_data, &type) != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("on_ap_metrics_data: safe_webconfig_decode failed");
+        return;
+    }
+
+    // Extract decoded report and update m_radio_info so Monitor HAL can read:
+    //   - Radio stats via update_radio_stats()  → m_radio_info.noise/utilization/transmit/receive
+    //   - BSS stats via update_vap_stats()      → m_radio_info.available_vaps (tx/rx bytes)
+    //   - STA stats via update_stations_stats() → data model STA entries
+  
+
+    ONEWIFI_LOG_INFO("on_ap_metrics_data: updated data model with AP metrics");
+}
