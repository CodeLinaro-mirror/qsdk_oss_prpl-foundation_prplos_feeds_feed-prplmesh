+bool ap_wlan_hal_onewifi::refresh_onewifi_subdoc(const char *logname, webconfig_subdoc_type_t type,
+                                                 m2ctrl_radioconfig *m2_cfg,
+                                                 void *policy_config)
+{
+    ONEWIFI_LOG_INFO("refresh_onewifi_subdoc: %s type=%d", logname, type);
+
+    // Check and open bus connection if needed (reuses existing connection if already open)
+    //if (!check_and_open_bus()) {
+    //    ONEWIFI_LOG_ERROR("Failed to open bus connection");
+    //    return false;
+    //}
+
+    // Get bus descriptor for sending data
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (!desc) {
+        ONEWIFI_LOG_ERROR("Bus descriptor is NULL, cannot send subdoc");
+        return false;
+    }
+    // Initialize webconfig for encoding
+    webconfig_external_easymesh_t ext_data;
+    webconfig_t config;
+    memset(&ext_data, 0, sizeof(webconfig_external_easymesh_t));
+    memset(&config, 0, sizeof(webconfig_t));
+    
+    // Note: For encoding (not decoding), we need to pass m2_cfg and policy_config
+    // So we can't use init_webconfig_for_decode() directly. Instead, we initialize
+    // the protocol with the encode-specific parameters, then init the config.
+    webconfig_proto_easymesh_init(&ext_data,
+                                  m_data_model.get(),
+                                  m2_cfg,
+                                  policy_config,
+                                  onewifi_data_model_t::get_num_radios,
+                                  onewifi_data_model_t::set_num_radios,
+                                  onewifi_data_model_t::get_num_op_class,
+                                  onewifi_data_model_t::set_num_op_class,
+                                  onewifi_data_model_t::get_num_bss,
+                                  onewifi_data_model_t::set_num_bss,
+                                  onewifi_data_model_t::get_device_info,
+                                  onewifi_data_model_t::get_network_info,
+                                  onewifi_data_model_t::get_radio_info,
+                                  onewifi_data_model_t::get_ieee_1905_security_info,
+                                  onewifi_data_model_t::get_bss_info,
+                                  onewifi_data_model_t::get_op_class_info,
+                                  onewifi_data_model_t::get_first_sta_info,
+                                  onewifi_data_model_t::get_next_sta_info,
+                                  onewifi_data_model_t::get_sta_info,
+                                  onewifi_data_model_t::put_sta_info,
+                                  onewifi_data_model_t::get_bss_info_with_mac,
+                                  onewifi_data_model_t::put_scan_results,
+                                  onewifi_data_model_t::update_ap_mld_info,
+                                  onewifi_data_model_t::update_bsta_mld_info,
+                                  onewifi_data_model_t::update_assoc_sta_mld_info,
+                                  onewifi_data_model_t::get_ap_mld_frm_bssid,
+                                  onewifi_data_model_t::get_radio_cap_info);
+    
+    config.initializer = webconfig_initializer_onewifi;
+    config.apply_data  = webconfig_dummy_apply;
+
+    if (webconfig_init(&config) != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("Failed to initialize webconfig");
+        return false;
+    }
+
+    // Encode M2 configuration to OneWifi format
+    char *encoded_str = nullptr;
+    ONEWIFI_LOG_INFO("Calling webconfig_easymesh_encode for type=%d", type);
+    webconfig_error_t encode_result = webconfig_easymesh_encode(&config, &ext_data, type, &encoded_str);
+    if (encode_result != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("Failed to encode webconfig subdoc: type=%d error=%d", type, encode_result);
+        ONEWIFI_LOG_ERROR("Data model state: num_radios=%u num_bss=%u", 
+                          m_data_model->get_num_radios(), m_data_model->get_num_bss());
+        return false;
+    }
+
+    ONEWIFI_LOG_INFO("Subdoc encode success, length=%zu", strlen(encoded_str));
+
+    // Prepare bus data
+    raw_data_t l_bus_data = {};
+    memset(&l_bus_data, 0, sizeof(raw_data_t));
+    l_bus_data.data_type      = bus_data_type_string;
+    l_bus_data.raw_data.bytes = encoded_str;
+    if (encoded_str != nullptr) {
+        l_bus_data.raw_data_len   = strlen(encoded_str);
+    }
+
+    // Send to OneWifi via bus
+    ONEWIFI_LOG_INFO("Sending subdoc to OneWifi via %s", WIFI_WEBCONFIG_DOC_DATA_SOUTH);
+    ONEWIFI_LOG_DEBUG("Subdoc data: type=%d len=%u", l_bus_data.data_type, l_bus_data.raw_data_len);
+    ONEWIFI_LOG_DEBUG("Subdoc content (first 500 chars): %.500s", encoded_str);
+    
+    // Error 11 means invalid bus handle - verify and log bus handle state
+    ONEWIFI_LOG_DEBUG("About to call bus_set_fn with bus_hdl, state=%d", static_cast<int>(get_state()));
+    
+    int bus_result = desc->bus_set_fn(m_bus_hdl_ptr, WIFI_WEBCONFIG_DOC_DATA_SOUTH, &l_bus_data);
+    bool success = (bus_result == 0);
+
+    if (success) {
+        ONEWIFI_LOG_INFO("Successfully sent %s subdoc to OneWifi", logname);
+    } else {
+        ONEWIFI_LOG_ERROR("Failed to send %s subdoc to OneWifi, bus_set_fn returned: %d", logname, bus_result);
+        ONEWIFI_LOG_ERROR("Bus state: %d, descriptor valid: %s", 
+                          static_cast<int>(get_state()),
+                          desc ? "yes" : "no");
+    }
+
+    return success;
+}
