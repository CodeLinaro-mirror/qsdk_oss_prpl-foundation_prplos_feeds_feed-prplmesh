+bool ap_wlan_hal_onewifi::process_sta_event(em_sta_info_t *sta, const mac_address_t &current_radio_mac, bool is_connected, bool send_events)
+{
+    if (!sta) return false;
+
+    // Lookup BSS
+    em_bss_info_t *bss = m_data_model->get_bss_info_with_mac(sta->bssid);
+    if (!bss) {
+        ONEWIFI_LOG_DEBUG("process_sta_event: BSS not found for STA %02x:%02x:%02x:%02x:%02x:%02x",
+                          sta->id[0], sta->id[1], sta->id[2], sta->id[3], sta->id[4], sta->id[5]);
+        return false;
+    }
+
+    // Use helper for consistency with rest of codebase
+    if (!bss_belongs_to_radio(bss, current_radio_mac)) {
+        return false;
+    }
+
+    // Get physical interface name
+    std::string physical_iface;
+    if (!m_data_model->get_vap_name_mapping(bss->bssid.name, physical_iface)) {
+        physical_iface = bss->bssid.name;
+    }
+
+    // Get VAP ID
+    int8_t vap_id = get_vap_id_with_bss(physical_iface);
+    if (vap_id < 0) {
+        return false;
+    }
+
+    // Only push events if send_events is true
+    if (send_events) {
+        // Push appropriate AP event
+        if (is_connected) {
+            auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION *>(msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+
+            memcpy(msg->params.mac.oct, sta->id, sizeof(mac_address_t));
+            memcpy(msg->params.bssid.oct, sta->bssid, sizeof(mac_address_t));
+            msg->params.vap_id = vap_id;
+
+            // Copy association frame if present
+            if (sta->frame_body_len > 0 && sta->frame_body_len <= beerocks::message::ASSOCIATION_MAX_LENGTH) {
+                memcpy(msg->params.association_frame, sta->frame_body, sta->frame_body_len);
+                msg->params.association_frame_length = sta->frame_body_len;
+
+                auto assoc_frame = assoc_frame::AssocReqFrame::parse(
+                    msg->params.association_frame, msg->params.association_frame_length,
+                    assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST);
+                if (assoc_frame) {
+                    son::assoc_frame_utils::get_station_capabilities_from_assoc_frame(
+                        assoc_frame, msg->params.capabilities);
+                }
+            }
+
+            event_queue_push(static_cast<int>(Event::STA_Connected), msg_buff);
+            ONEWIFI_LOG_DEBUG("process_sta_event: Pushed AP STA_Connected for %02x:%02x:%02x:%02x:%02x:%02x vap_id=%d",
+                              sta->id[0], sta->id[1], sta->id[2], sta->id[3], sta->id[4], sta->id[5], int(vap_id));
+        } else {
+            auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION *>(msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION));
+
+            memcpy(msg->params.mac.oct, sta->id, sizeof(mac_address_t));
+            msg->params.vap_id = vap_id;
+            msg->params.reason = 0;
+            msg->params.source = 0;
+            msg->params.type   = 0;
+
+            event_queue_push(static_cast<int>(Event::STA_Disconnected), msg_buff);
+            ONEWIFI_LOG_DEBUG("process_sta_event: Pushed AP STA_Disconnected for %02x:%02x:%02x:%02x:%02x:%02x vap_id=%d",
+                              sta->id[0], sta->id[1], sta->id[2], sta->id[3], sta->id[4], sta->id[5], int(vap_id));
+        }
+    } else {
+        ONEWIFI_LOG_DEBUG("process_sta_event: Loaded STA data (no event) for %02x:%02x:%02x:%02x:%02x:%02x vap_id=%d connected=%d",
+                          sta->id[0], sta->id[1], sta->id[2], sta->id[3], sta->id[4], sta->id[5], int(vap_id), is_connected);
+    }
+
     return true;
 }
 
+void ap_wlan_hal_onewifi::on_sta_assoc_status_data(const char *data, unsigned int len)
+{
+    if (!data || len < sizeof(rdk_sta_data_t)) {
+        ONEWIFI_LOG_WARN("AP: on_sta_assoc_status_data invalid data len=%u expected=%zu", 
+                         len, sizeof(rdk_sta_data_t));
+        return;
+    }
+
+    // Data is binary rdk_sta_data_t structure
+    const rdk_sta_data_t *sta_data = reinterpret_cast<const rdk_sta_data_t *>(data);
+    
+    // Get STA MAC from bss_info.bssid (this field contains the STA MAC, not BSSID)
+    sMacAddr sta_mac = {};
+    memcpy(sta_mac.oct, sta_data->bss_info.bssid, sizeof(sta_mac.oct));
+    
+    // Get BSSID (VAP MAC) from interface name
+    std::string bssid_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(sta_data->interface_name, bssid_str)) {
+        ONEWIFI_LOG_WARN("AP: on_sta_assoc_status_data: Failed to get BSSID for interface=%s", 
+                         sta_data->interface_name);
+        return;
+    }
+    
+    mac_address_t bssid;
+    tlvf::mac_from_string(bssid, bssid_str);
+    
+    // Get BSS info from data model
+    em_bss_info_t *bss = m_data_model->get_bss_info_with_mac(bssid);
+    if (!bss) {
+        ONEWIFI_LOG_DEBUG("AP: on_sta_assoc_status_data: BSS not found for interface=%s", 
+                          sta_data->interface_name);
+        return;
+    }
+    
+    // Get MAC address of current HAL's radio interface
+    std::string current_radio_mac_str = get_radio_mac();
+    if (current_radio_mac_str.empty()) {
+        ONEWIFI_LOG_ERROR("AP: on_sta_assoc_status_data: Failed to get radio MAC from current HAL interface=%s", 
+                          get_iface_name().c_str());
+        return;
+    }
+    
+    mac_address_t current_radio_mac;
+    tlvf::mac_from_string(current_radio_mac, current_radio_mac_str);
+    
+    // Check if this BSS belongs to the current radio by comparing RUIDs
+    if (memcmp(bss->ruid.mac, current_radio_mac, sizeof(mac_address_t)) != 0) {
+        ONEWIFI_LOG_DEBUG("AP: on_sta_assoc_status_data: BSS does not belong to current radio, skipping");
+        return;
+    }
+    
+    // Determine if this is connect or disconnect
+    bool is_connected = (sta_data->stats.connect_status != 0);
+    
+    // Get physical interface name using VapName from OneWifi configuration
+    std::string vap_name = bss->bssid.name;
+    std::string physical_iface;
+
+    // Try to get interface name from OneWifi VapName mapping (thread-safe)
+    if (m_data_model->get_vap_name_mapping(vap_name, physical_iface)) {
+        ONEWIFI_LOG_DEBUG("on_sta_assoc_status_data: Mapped VapName '%s' to physical interface '%s'",
+                        vap_name.c_str(), physical_iface.c_str());
+    } else {
+        ONEWIFI_LOG_WARN("on_sta_assoc_status_data: Failed to map VapName '%s' to physical interface, using VapName as fallback",
+                       vap_name.c_str());
+        physical_iface = vap_name;
+    }
+    
+    // Get VAP ID from physical interface name
+    int8_t vap_id = get_vap_id_with_bss(physical_iface);
+    if (vap_id < 0) {
+        ONEWIFI_LOG_DEBUG("AP: on_sta_assoc_status_data vap_id not found for interface=%s, using 0", 
+                          physical_iface.c_str());
+        vap_id = 0;
+    }
+    
+    ONEWIFI_LOG_INFO("AP: on_sta_assoc_status_data:%s sta_mac=%s on interface=%s vap_id=%d",
+                     (is_connected ? " CONNECTED" : " DISCONNECTED"),
+                     tlvf::mac_to_string(sta_mac).c_str(), sta_data->interface_name, int(vap_id));
+
+    if (is_connected) {
+        // Push STA_Connected event to AP
+        auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+        auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION *>(msg_buff.get());
+        LOG_IF(!msg, FATAL) << "Failed allocating sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION";
+        
+        memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+        msg->params.vap_id = vap_id;
+        memcpy(msg->params.mac.oct, sta_mac.oct, sizeof(sta_mac.oct));
+        
+        event_queue_push(static_cast<int>(Event::STA_Connected), msg_buff);
+        ONEWIFI_LOG_DEBUG("AP: Pushed STA_Connected event vap_id=%d", int(vap_id));
+    } else {
+        // Push STA_Disconnected event to AP
+        auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION));
+        auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION *>(msg_buff.get());
+        LOG_IF(!msg, FATAL) << "Failed allocating sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION";
+        
+        memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION));
+        memcpy(msg->params.mac.oct, sta_mac.oct, sizeof(sta_mac.oct));
+        msg->params.vap_id = vap_id;
+        
+        event_queue_push(static_cast<int>(Event::STA_Disconnected), msg_buff);
+        ONEWIFI_LOG_DEBUG("AP: Pushed STA_Disconnected event vap_id=%d", int(vap_id));
+    }
+}
