+static bus_error_t onewifi_north_cb(char *event_name, bus_data_prop_t *p_data, void *ctx)
+{
+    auto self = static_cast<bwl::onewifi::base_wlan_hal_onewifi *>(ctx);
+    if (!self || !p_data || !p_data->value.raw_data.bytes || p_data->value.raw_data_len == 0) {
+        ONEWIFI_LOG_WARN("onewifi_north_cb: null or empty data");
+        return bus_error_invalid_input;
+    }
+    self->on_onewifi_north_data(static_cast<const char *>(p_data->value.raw_data.bytes),
+                                p_data->value.raw_data_len);
+    return bus_error_success;
+}
