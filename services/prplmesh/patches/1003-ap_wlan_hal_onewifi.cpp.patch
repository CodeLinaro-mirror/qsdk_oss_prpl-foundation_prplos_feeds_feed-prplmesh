+                    msg_buff.get());
+                LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+                memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+
+                memcpy(msg->params.mac.oct, sta->id, sizeof(mac_address_t));
+                memcpy(msg->params.bssid.oct, sta->bssid, sizeof(mac_address_t));
+                msg->params.vap_id = vap_id;
+
+                // Copy association frame if present
+                if (sta->frame_body_len > 0 &&
+                    sta->frame_body_len <= beerocks::message::ASSOCIATION_MAX_LENGTH) {
+                    memcpy(msg->params.association_frame, sta->frame_body, sta->frame_body_len);
+                    msg->params.association_frame_length = sta->frame_body_len;
+
+                    auto assoc_frame = assoc_frame::AssocReqFrame::parse(
+                        msg->params.association_frame, msg->params.association_frame_length,
+                        assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST);
+                    if (assoc_frame) {
+                        son::assoc_frame_utils::get_station_capabilities_from_assoc_frame(
+                            assoc_frame, msg->params.capabilities);
+                    }
+                }
+
+                event_queue_push(static_cast<int>(Event::STA_Connected), msg_buff);
+                ONEWIFI_LOG_DEBUG("AP: generate_connected_clients_events: pushed STA_Connected vap_id=%d",
+                                  int(vap_id));
+            }
+        }
+        sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_assoc);
+    }
+
     is_finished_all_clients = true;
     return true;
 }
 
+bool ap_wlan_hal_onewifi::load_connected_clients_data(bool send_events)
+{
+    ONEWIFI_LOG_DEBUG("AP: load_connected_clients_data: requesting associated clients data from OneWifi (send_events=%d)", send_events);
+
+    // Get bus descriptor
+    wifi_bus_desc_t *bus_desc = get_bus_descriptor();
+    if (!bus_desc || !bus_desc->bus_data_get_fn) {
+        ONEWIFI_LOG_ERROR("AP: load_connected_clients_data: bus descriptor or bus_data_get_fn is NULL");
+        return false;
+    }
+
+    // Request associated clients data from OneWifi
+    raw_data_t assoc_data = {};
+    if (bus_desc->bus_data_get_fn(m_bus_hdl_ptr, ONEWIFI_WEBCONFIG_GET_ASSOC, &assoc_data) != bus_error_success) {
+        ONEWIFI_LOG_ERROR("AP: load_connected_clients_data: Failed to get associated clients data");
+        return false;
+    }
+
+    // Process the received data if available
+    if (assoc_data.raw_data.bytes && assoc_data.raw_data_len > 0) {
+        ONEWIFI_LOG_INFO("AP: load_connected_clients_data: Received associated clients data (%u bytes)",
+                         assoc_data.raw_data_len);
+
+        // Debug print: Display full JSON data
+        ONEWIFI_LOG_DEBUG("AP: load_connected_clients_data: Full JSON data: %s",
+                          static_cast<const char *>(assoc_data.raw_data.bytes));
+
+        // Decode the associated clients data into the data model with optional event generation
+        on_sta_assoc_data(static_cast<const char *>(assoc_data.raw_data.bytes), assoc_data.raw_data_len, send_events);
+
+        // Free the allocated data
+        free(assoc_data.raw_data.bytes);
+        assoc_data.raw_data.bytes = nullptr;
+
+        ONEWIFI_LOG_DEBUG("AP: load_connected_clients_data: Successfully processed associated clients data (events %s)", 
+                          send_events ? "sent" : "not sent");
+        return true;
+    } else {
+        ONEWIFI_LOG_WARN("AP: load_connected_clients_data: No associated clients data received");
+        return true; // Not an error - there might be no clients
+    }
+}
+
 bool ap_wlan_hal_onewifi::pre_generate_connected_clients_events()
 {
+    ONEWIFI_LOG_DEBUG("AP: pre_generate_connected_clients_events: loading connected clients data with events for radio %s",
+                      get_iface_name().c_str());
+    
+    // Load connected clients data from OneWifi with events enabled.
+    if (!load_connected_clients_data(true)) {
+        ONEWIFI_LOG_ERROR("AP: pre_generate_connected_clients_events: Failed to load connected clients data");
+        return false;
+    }
+    
+    ONEWIFI_LOG_INFO("AP: pre_generate_connected_clients_events: Successfully loaded and generated events for connected clients on radio %s",
+                     get_iface_name().c_str());
     return true;
 }
 
