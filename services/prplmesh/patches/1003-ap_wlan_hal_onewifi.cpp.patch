+void ap_wlan_hal_onewifi::on_sta_assoc_data(const char *json_str, unsigned int len, bool send_events)
+{
+    if (!json_str || len == 0) return;
+
+    // Decode associated clients subdoc
+    unsigned int num_bss_before = m_data_model->get_num_bss();
+    
+    webconfig_external_easymesh_t ext_data = {};
+    webconfig_t config = {};
+    if (!init_webconfig_for_decode(ext_data, config)) {
+        ONEWIFI_LOG_ERROR("on_sta_assoc_data: webconfig init failed");
+        return;
+    }
+
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_associated_clients;
+    if (safe_webconfig_decode(&config, json_str, &ext_data, &type) != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("on_sta_assoc_data: safe_webconfig_decode failed");
+        return;
+    }
+
+    // WORKAROUND: Restore BSS count if changed during decode
+    unsigned int num_bss_after = m_data_model->get_num_bss();
+    if (num_bss_before != num_bss_after) {
+        ONEWIFI_LOG_WARN("on_sta_assoc_data: BSS count changed during decode (%u->%u), restoring", 
+                         num_bss_before, num_bss_after);
+        m_data_model->set_num_bss(num_bss_before);
+    }
+
+    // Get current radio MAC for filtering
+    std::string radio_mac_str = get_radio_mac();
+    if (radio_mac_str.empty()) {
+        ONEWIFI_LOG_ERROR("on_sta_assoc_data: Failed to get radio MAC");
+        return;
+    }
+    
+    mac_address_t current_radio_mac;
+    tlvf::mac_from_string(current_radio_mac, radio_mac_str);
+
+    // Process STAs from both assoc and disassoc maps
+    int processed_count = 0;
+    
+    // Process ASSOC map
+    em_sta_info_t *sta = m_data_model->get_first_sta_info(em_target_sta_map_assoc);
+    while (sta) {
+        if (process_sta_event(sta, current_radio_mac, sta->associated, send_events)) {
+            processed_count++;
+        }
+        sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_assoc);
+    }
+    
+    // Process DISASSOC map
+    sta = m_data_model->get_first_sta_info(em_target_sta_map_disassoc);
+    while (sta) {
+        if (process_sta_event(sta, current_radio_mac, false, send_events)) {
+            processed_count++;
+        }
+        sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_disassoc);
+    }
+    
+    ONEWIFI_LOG_INFO("on_sta_assoc_data: Processed %d STA %s for radio %s",
+                     processed_count, send_events ? "events" : "entries (no events)", get_iface_name().c_str());
+
+    // Notify Monitor HAL that STA data has been updated (after decoding is complete)
+    notify_monitor_hal(HalEventType::STA_DATA_UPDATED);
+}
