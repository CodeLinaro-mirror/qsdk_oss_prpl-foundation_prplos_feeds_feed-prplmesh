+void ap_wlan_hal_onewifi::on_onewifi_init_data(const char *json_str)
+{
+    if (!json_str) return;
+    ONEWIFI_LOG_DEBUG("AP: on_onewifi_init_data: decoding initial DML data");
+    on_onewifi_north_data(json_str, strlen(json_str));
+}
+
+void ap_wlan_hal_onewifi::on_onewifi_north_data(const char *json_str, unsigned int len)
+{
+    if (!json_str || len == 0) return;
+    ONEWIFI_LOG_INFO("AP: on_onewifi_north_data: len=%u", len);
+
+    // Parse subdoc type
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_private;
+    {
+        cJSON *json = cJSON_Parse(json_str);
+        if (!json) { ONEWIFI_LOG_ERROR("AP: failed to parse JSON"); return; }
+        cJSON *name_item = cJSON_GetObjectItemCaseSensitive(json, "SubDocName");
+        if (!cJSON_IsString(name_item) || !name_item->valuestring) {
+            cJSON_Delete(json); return;
+        }
+        const char *name = name_item->valuestring;
+        if (strcmp(name, "private") == 0) type = webconfig_subdoc_type_private;
+        else if (strcmp(name, "Vap_6G") == 0) type = webconfig_subdoc_type_vap_6G;
+        else if (strcmp(name, "Vap_5G") == 0) type = webconfig_subdoc_type_vap_5G;
+        else if (strcmp(name, "Vap_2.4G") == 0) type = webconfig_subdoc_type_vap_24G;
+        else if (strcmp(name, "radio") == 0) type = webconfig_subdoc_type_radio;
+        else if (strcmp(name, "radio_6G") == 0) type = webconfig_subdoc_type_radio_6G;
+        else if (strcmp(name, "radio_5G") == 0) type = webconfig_subdoc_type_radio_5G;
+        else if (strcmp(name, "radio_2.4G") == 0) type = webconfig_subdoc_type_radio_24G;
+        else if (strcmp(name, "mesh_sta") == 0 || strcmp(name, "mesh backhaul sta") == 0) type = webconfig_subdoc_type_mesh_sta;
+        else if (strcmp(name, "dml") == 0) type = webconfig_subdoc_type_dml;
+        else { ONEWIFI_LOG_DEBUG("AP: unhandled SubDocName=%s", name); cJSON_Delete(json); return; }
+        cJSON_Delete(json);
+    }
+
+    // Decode (large stack vars in this scope - freed when this function returns)
+    webconfig_external_easymesh_t ext_data = {};
+    webconfig_t config = {};
+    if (!init_webconfig_for_decode(ext_data, config)) {
+        ONEWIFI_LOG_ERROR("AP: webconfig init failed"); return;
+    }
+    webconfig_error_t rc = safe_webconfig_decode(&config, json_str, &ext_data, &type);
+    if (rc != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("AP: decode failed type=%d error=%d", type, rc); return;
+    }
+
+    ONEWIFI_LOG_DEBUG("AP: decoded subdoc type=%d radios=%u bss=%u",
+                      type, m_data_model->get_num_radios(), m_data_model->get_num_bss());
+
+    // Update radio info for DML/radio subdocs
+    if (type == webconfig_subdoc_type_dml || type == webconfig_subdoc_type_radio ||
+        type == webconfig_subdoc_type_radio_24G || type == webconfig_subdoc_type_radio_5G ||
+        type == webconfig_subdoc_type_radio_6G) {
+        if (m_data_model->get_num_radios() > 0) {
+            update_radio_info_from_data_model();
+            ONEWIFI_LOG_INFO("AP: radio info updated for subdoc type=%d", type);
+        }
+    }
 }
 
