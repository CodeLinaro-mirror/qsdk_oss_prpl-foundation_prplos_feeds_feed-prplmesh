+static bus_error_t onewifi_north_cb(char *event_name, raw_data_t *data, void *ctx)
+{
+    auto self = static_cast<bwl::onewifi::base_wlan_hal_onewifi *>(ctx);
+    if (!self || !data || !data->raw_data.bytes) {
+        ONEWIFI_LOG_WARN("onewifi_north_cb: null or empty data");
+        return bus_error_invalid_input;
+    }
+    // Use raw_data_t to get correct data pointer and length
+    const char *json_str = static_cast<const char *>(data->raw_data.bytes);
+    self->on_onewifi_north_data(json_str, strlen(json_str));
+    return bus_error_success;
+}
+
