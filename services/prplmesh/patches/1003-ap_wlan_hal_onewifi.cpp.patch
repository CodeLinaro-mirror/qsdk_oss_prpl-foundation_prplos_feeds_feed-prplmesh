 bool ap_wlan_hal_onewifi::set_channel(int chan, beerocks::eWiFiBandwidth bw, int center_channel)
 {
-    // TODO: Set channel via OneWifi Rbus
-    return true;
+    ONEWIFI_LOG_INFO("set_channel: chan=%d bw=%d center_freq=%d", chan, bw, center_channel);
+
+    // Update local radio info
+    m_radio_info.channel = chan;
+    m_radio_info.bandwidth = bw;
+    m_radio_info.vht_center_freq = center_channel;
+
+    // Update the data model with new channel configuration
+    // Channel is stored in the current operating class entry
+    if (m_data_model->get_num_radios() == 0) {
+        ONEWIFI_LOG_ERROR("No radio info available in data model");
+        return false;
+    }
+
+    em_radio_info_t *radio_info = m_data_model->get_radio_info(0);
+    if (!radio_info) {
+        ONEWIFI_LOG_ERROR("Failed to get radio info from data model");
+        return false;
+    }
+
+    // Get MAC address from interface name (matching OneWifi's mac_address_from_name logic)
+    // OneWifi uses: mac_address_from_name(radio_iface_map->interface_name, em_op_class_info->id.ruid)
+    // So we must compare against the MAC derived from the interface name, not radio_info->intf.mac
+    mac_address_t iface_mac;
+    std::string mac_str;
+    if (!beerocks::net::network_utils::linux_iface_get_mac(get_iface_name(), mac_str)) {
+        ONEWIFI_LOG_ERROR("Failed to get MAC from interface %s", get_iface_name().c_str());
+        return false;
+    }
+    
+    // Convert MAC string to mac_address_t for comparison
+    // Use tlvf::mac_from_string which converts string to byte array
+    tlvf::mac_from_string(iface_mac, mac_str);
+    
+    // Debug: Log interface MAC for comparison
+    ONEWIFI_LOG_INFO("Interface %s MAC: %02x:%02x:%02x:%02x:%02x:%02x",
+                     get_iface_name().c_str(),
+                     iface_mac[0], iface_mac[1], iface_mac[2],
+                     iface_mac[3], iface_mac[4], iface_mac[5]);
+    
+    // Find and update ALL current operating classes with new channel and bandwidth
+    // CRITICAL FIX: There may be multiple current operating classes (type=1) for the same radio
+    // We must update ALL of them, not just the first one, because the encoder may read from any of them
+    int updated_count = 0;
+    for (unsigned int i = 0; i < m_data_model->get_num_op_class(); i++) {
+        em_op_class_info_t *op_class = m_data_model->get_op_class_info(i);
+        if (op_class && op_class->id.type == em_op_class_type_current) {
+            // Debug: Log operating class RUID for comparison
+            ONEWIFI_LOG_INFO("OpClass[%u] RUID: %02x:%02x:%02x:%02x:%02x:%02x (type=%d)",
+                             i,
+                             op_class->id.ruid[0], op_class->id.ruid[1], op_class->id.ruid[2],
+                             op_class->id.ruid[3], op_class->id.ruid[4], op_class->id.ruid[5],
+                             op_class->id.type);
+        }
+        
+        if (op_class && op_class->id.type == em_op_class_type_current &&
+            memcmp(op_class->id.ruid, iface_mac, sizeof(mac_address_t)) == 0) {
+            // Update channel in current operating class
+            op_class->channel = chan;
+            
+            // Update operating class number based on bandwidth (if needed)
+            unsigned int new_op_class = op_class->op_class;
+            
+            // Map bandwidth to appropriate operating class for the frequency band
+            if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G) {
+                switch (bw) {
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_20:
+                        new_op_class = 81;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_40:
+                        new_op_class = 83;
+                        break;
+                    default:
+                        new_op_class = 81;
+                        break;
+                }
+            } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G) {
+                switch (bw) {
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_20:
+                        new_op_class = 115;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_40:
+                        new_op_class = 116;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_80:
+                        new_op_class = 128;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_160:
+                        new_op_class = 129;
+                        break;
+                    default:
+                        break;
+                }
+            } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
+                switch (bw) {
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_20:
+                        new_op_class = 131;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_40:
+                        new_op_class = 132;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_80:
+                        new_op_class = 133;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_160:
+                        new_op_class = 134;
+                        break;
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_320:
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_320_1:
+                    case beerocks::eWiFiBandwidth::BANDWIDTH_320_2:
+                        new_op_class = 137;
+                        break;
+                    default:
+                        break;
+                }
+            }
+            
+            if (new_op_class != op_class->op_class) {
+                op_class->op_class = new_op_class;
+                op_class->id.op_class = new_op_class;
+                ONEWIFI_LOG_INFO("Updated current op_class[%u] to %u for bandwidth %d", 
+                                 i, new_op_class, static_cast<int>(bw));
+            }
+            
+            updated_count++;
+            ONEWIFI_LOG_INFO("Updated current op_class[%u]: class=%u channel=%d", 
+                             i, op_class->op_class, chan);
+            // DO NOT break - continue to update ALL current operating classes
+        }
+    }
+
+    if (updated_count == 0) {
+        ONEWIFI_LOG_WARN("No current operating class found, channel update may not take effect");
+    } else {
+        ONEWIFI_LOG_INFO("Updated %d current operating class entries with new channel", updated_count);
+    }
+
+    // Map frequency band to em_freq_band_t for subdoc type determination
+    em_freq_band_t freq_band;
+    if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G) {
+        freq_band = em_freq_band_24;
+    } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G) {
+        freq_band = em_freq_band_5;
+    } else if (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G) {
+        freq_band = em_freq_band_60;
+    } else {
+        ONEWIFI_LOG_ERROR("Unknown frequency band: %d", m_radio_info.frequency_band);
+        return false;
+    }
+
+    // Get subdoc type using helper function
+    webconfig_subdoc_type_t subdoc_type = get_subdoc_radio_type_for_freq(freq_band);
+
+    ONEWIFI_LOG_INFO("Sending Radio subdoc (type=%d) with channel=%d bw=%d to OneWifi", 
+                     subdoc_type, chan, static_cast<int>(bw));
+
+    // Send radio configuration to OneWifi via webconfig encoding
+    bool result = refresh_onewifi_subdoc("Radio", subdoc_type, nullptr, nullptr);
+
+    if (result) {
+        ONEWIFI_LOG_INFO("Successfully set channel %d on radio %s", chan, get_iface_name().c_str());
+    } else {
+        ONEWIFI_LOG_ERROR("Failed to set channel %d on radio %s", chan, get_iface_name().c_str());
+    }
+
+    return result;
 }
 
