+void ap_wlan_hal_onewifi::on_sta_assoc_data(const char *json_str, unsigned int len)
+{
+    if (!json_str || len == 0) return;
+
+    ONEWIFI_LOG_DEBUG("on_sta_assoc_data: received STA association data from OneWifi");
+
+    webconfig_external_easymesh_t ext_data = {};
+    webconfig_t config = {};
+    if (!init_webconfig_for_decode(ext_data, config)) {
+        ONEWIFI_LOG_ERROR("on_sta_assoc_data: webconfig init failed");
+        return;
+    }
+
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_associated_clients;
+    if (safe_webconfig_decode(&config, json_str, &ext_data, &type) != webconfig_error_none) {
+        ONEWIFI_LOG_ERROR("on_sta_assoc_data: safe_webconfig_decode failed");
+        return;
+    }
+
+    ONEWIFI_LOG_DEBUG("on_sta_assoc_data: decoded STA association data successfully");
+
+    // Iterate all associated STAs and push STA_Connected / STA_Disconnected
+    em_sta_info_t *sta = m_data_model->get_first_sta_info(em_target_sta_map_assoc);
+    while (sta) {
+        em_bss_info_t *bss = m_data_model->get_bss_info_with_mac(sta->bssid);
+        if (!bss) {
+            sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_assoc);
+            continue;
+        }
+
+        int8_t vap_id = get_vap_id_with_bss(std::string(bss->bssid.name));
+        if (vap_id < 0) {
+            sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_assoc);
+            continue;
+        }
+
+        if (sta->associated) {
+            auto msg_buff =
+                ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION *>(
+                msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_ASSOCIATED_NOTIFICATION));
+
+            memcpy(msg->params.mac.oct, sta->id, sizeof(mac_address_t));
+            memcpy(msg->params.bssid.oct, sta->bssid, sizeof(mac_address_t));
+            msg->params.vap_id = vap_id;
+
+            // Copy raw association frame body if present
+            if (sta->frame_body_len > 0 &&
+                sta->frame_body_len <= beerocks::message::ASSOCIATION_MAX_LENGTH) {
+                memcpy(msg->params.association_frame, sta->frame_body, sta->frame_body_len);
+                msg->params.association_frame_length = sta->frame_body_len;
+
+                // Parse capabilities from the association frame
+                auto assoc_frame = assoc_frame::AssocReqFrame::parse(
+                    msg->params.association_frame, msg->params.association_frame_length,
+                    assoc_frame::AssocReqFrame::ASSOCIATION_REQUEST);
+                if (assoc_frame) {
+                    son::assoc_frame_utils::get_station_capabilities_from_assoc_frame(
+                        assoc_frame, msg->params.capabilities);
+                }
+            }
+
+            event_queue_push(static_cast<int>(Event::STA_Connected), msg_buff);
+            ONEWIFI_LOG_DEBUG("Pushed STA_Connected (assoc_data) vap_id=%d", int(vap_id));
+        } else {
+            auto msg_buff =
+                ALLOC_SMART_BUFFER(sizeof(sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION));
+            auto msg = reinterpret_cast<sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION *>(
+                msg_buff.get());
+            LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+            memset(msg_buff.get(), 0, sizeof(sACTION_APMANAGER_CLIENT_DISCONNECTED_NOTIFICATION));
+
+            memcpy(msg->params.mac.oct, sta->id, sizeof(mac_address_t));
+            msg->params.vap_id = vap_id;
+            msg->params.reason = 0;
+            msg->params.source = 0;
+            msg->params.type   = 0;
+
+            event_queue_push(static_cast<int>(Event::STA_Disconnected), msg_buff);
+            ONEWIFI_LOG_DEBUG("Pushed STA_Disconnected (assoc_data) vap_id=%d", int(vap_id));
+        }
+
+        sta = m_data_model->get_next_sta_info(sta, em_target_sta_map_assoc);
+    }
+}
