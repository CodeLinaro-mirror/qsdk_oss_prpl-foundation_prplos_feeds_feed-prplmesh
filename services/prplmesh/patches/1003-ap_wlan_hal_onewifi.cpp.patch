+bool ap_wlan_hal_onewifi::detach()
+{
+    ONEWIFI_LOG_DEBUG("Detaching OneWifi HAL for interface: %s", get_iface_name().c_str());
+    
+    wifi_bus_desc_t *bus_desc = get_bus_descriptor();
+    if (bus_desc && bus_desc->bus_event_unsubs_fn) {
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_WEBCONFIG_DOC_DATA_NORTH);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_WEBCONFIG_GET_ASSOC);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_ASSOC_STATUS_EVENT);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_EM_AP_METRICS_REPORT);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_EM_CHANNEL_SCAN_REPORT);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_EM_BEACON_REPORT);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_EM_STA_LINK_METRICS_REPORT);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_EC_BSS_INFO);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_LINK_REPORT);
+        bus_desc->bus_event_unsubs_fn(m_bus_hdl_ptr, ONEWIFI_CSA_BEACON_EVENT);
+        ONEWIFI_LOG_DEBUG("Unsubscribed from all OneWifi events");
+    }
+
+    if (bus_desc && bus_desc->bus_close_fn) {
+        bus_desc->bus_close_fn(m_bus_hdl_ptr);
+        ONEWIFI_LOG_DEBUG("Closed OneWifi bus connection");
+    }
+    if (m_bus_hdl_ptr) memset(m_bus_hdl_ptr, 0, sizeof(bus_handle_t));
+
+    ONEWIFI_LOG_INFO("OneWifi HAL detached for interface: %s", get_iface_name().c_str());
+    return base_wlan_hal_onewifi::detach();
+}
+
+HALState ap_wlan_hal_onewifi::attach(bool block)
+{
+    // Call base class to set up eventfd and mark operational
+    HALState state = base_wlan_hal_onewifi::attach(block);
+    if (state != HALState::Operational) return state;
+
+    ONEWIFI_LOG_INFO("AP: Attaching OneWifi HAL for interface: %s", get_iface_name().c_str());
+
+    // Open bus connection
+    if (!check_and_open_bus()) {
+        ONEWIFI_LOG_ERROR("AP: Failed to open OneWifi bus connection");
+        return (m_hal_state = HALState::Failed);
+    }
+    ONEWIFI_LOG_INFO("AP: Successfully opened OneWifi bus connection");
+
+    // Get bus descriptor for event subscriptions
+    wifi_bus_desc_t *bus_desc = get_bus_descriptor();
+    if (!bus_desc) {
+        ONEWIFI_LOG_ERROR("AP: Failed to get OneWifi bus descriptor");
+        return (m_hal_state = HALState::Failed);
+    }
+
+    // Use the correct function pointer type to avoid casting function pointers to void*,
+    // which is undefined behavior in C++. The reinterpret_cast to void* is deferred to
+    // the C API call site, which is the standard C/C++ interop pattern.
+    using bus_event_cb_fn_t = bus_error_t (*)(char *, raw_data_t *, void *);
+
+    struct EventSubscription {
+        const char*       event_name;
+        bus_event_cb_fn_t callback;
+        bool              is_critical;
+        const char*       description;
+    };
+
+    EventSubscription subscriptions[] = {
+        {ONEWIFI_WEBCONFIG_DOC_DATA_NORTH, onewifi_north_cb, true, "VAP/radio/mesh_sta config updates"},
+        {ONEWIFI_WEBCONFIG_GET_ASSOC, sta_assoc_cb, true, "STA association list updates"},
+        {ONEWIFI_ASSOC_STATUS_EVENT, sta_assoc_status_cb, true, "STA connect/disconnect events"},
+        {ONEWIFI_EM_AP_METRICS_REPORT, ap_metrics_cb, false, "AP metrics reports"},
+        {ONEWIFI_EM_CHANNEL_SCAN_REPORT, channel_scan_cb, false, "Channel scan results"},
+        {ONEWIFI_EM_BEACON_REPORT, beacon_report_cb, false, "11k beacon measurement reports"},
+        {ONEWIFI_EM_STA_LINK_METRICS_REPORT, sta_link_metrics_cb, false, "STA link quality metrics"},
+        {ONEWIFI_EC_BSS_INFO, bss_info_cb, false, "EasyConnect BSS info"},
+        {ONEWIFI_LINK_REPORT, link_report_cb, false, "Link quality reports"},
+        {ONEWIFI_CSA_BEACON_EVENT, csa_beacon_cb, false, "CSA beacon frames"}
+    };
+
+    for (const auto& sub : subscriptions) {
+        if (bus_desc->bus_event_subs_fn(m_bus_hdl_ptr, sub.event_name,
+                                        reinterpret_cast<void*>(sub.callback), this, 0) != bus_error_success) {
+            if (sub.is_critical) {
+                ONEWIFI_LOG_ERROR("AP: Failed to subscribe to CRITICAL event: %s", sub.event_name);
+                return (m_hal_state = HALState::Failed);
+            } else {
+                ONEWIFI_LOG_WARN("AP: Failed to subscribe to optional event: %s", sub.event_name);
+            }
+        } else {
+            ONEWIFI_LOG_DEBUG("AP: Subscribed to %s (%s)", sub.event_name, sub.description);
+        }
+    }
+
+    // Fetch initial DML data
+    raw_data_t init_data = {};
+    int num_retry = 0;
+    static constexpr int MAX_INIT_RETRIES = 10;
+    static constexpr int RETRY_SLEEP_MS = 500;
+
+    if (bus_desc->bus_data_get_fn) {
+        while (bus_desc->bus_data_get_fn(m_bus_hdl_ptr, ONEWIFI_WEBCONFIG_INIT_DML_DATA, &init_data) != bus_error_success) {
+            ONEWIFI_LOG_WARN("AP: Failed to get initial DML data, retry %d", num_retry + 1);
+            if (++num_retry >= MAX_INIT_RETRIES) {
+                ONEWIFI_LOG_ERROR("AP: Exceeded max retries for DML data. OneWifi may not be running.");
+                break;
+            }
+            usleep(RETRY_SLEEP_MS * 1000);
+        }
+    }
+
+    if (init_data.raw_data.bytes && init_data.raw_data_len > 0) {
+        ONEWIFI_LOG_INFO("AP: Received initial DML data from OneWifi");
+        on_onewifi_north_data(reinterpret_cast<const char *>(init_data.raw_data.bytes),
+                              init_data.raw_data_len);
+        free(init_data.raw_data.bytes);
+        init_data.raw_data.bytes = nullptr;
+    }
+
+    refresh_radio_info();
+    event_queue_push(static_cast<int>(bwl::ap_wlan_hal::Event::AP_Attached));
+
+    ONEWIFI_LOG_INFO("AP: OneWifi HAL attached successfully for interface: %s", get_iface_name().c_str());
+    return m_hal_state;
+}
+
+void ap_wlan_hal_onewifi::on_onewifi_init_data(const char *json_str)
+{
+    if (!json_str) return;
+    ONEWIFI_LOG_DEBUG("AP: on_onewifi_init_data: decoding initial DML data");
+    on_onewifi_north_data(json_str, strlen(json_str));
+}
+
+void ap_wlan_hal_onewifi::on_onewifi_north_data(const char *json_str, unsigned int len)
+{
+    if (!json_str || len == 0) return;
+    ONEWIFI_LOG_INFO("AP: on_onewifi_north_data: len=%u", len);
+    ONEWIFI_LOG_DEBUG("AP: on_onewifi_north_data: JSON (first 500 chars): %.500s", json_str);
+
+    // Parse subdoc type and extract WiFiVapCap for VapName to InterfaceName mapping
+    webconfig_subdoc_type_t type = webconfig_subdoc_type_private;
+    bool should_decode = false;  // Declare outside the block so it's accessible later
+    
+    {
+        cJSON *json = cJSON_Parse(json_str);
+        if (!json) { ONEWIFI_LOG_ERROR("AP: failed to parse JSON"); return; }
+
+        cJSON *name_item = cJSON_GetObjectItemCaseSensitive(json, "SubDocName");
+        if (!cJSON_IsString(name_item) || !name_item->valuestring) {
+            cJSON_Delete(json); return;
+        }
+        const char *name = name_item->valuestring;
+        
+        // Filter subdoc types based on current HAL's frequency band
+        // Only decode subdocs that match this radio's band
+
+        if (strcmp(name, "private") == 0) {
+            type = webconfig_subdoc_type_private;
+            should_decode = true; // private is for all bands
+        }
+        else if (strcmp(name, "Vap_6G") == 0) {
+            type = webconfig_subdoc_type_vap_6G;
+            should_decode = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G);
+        }
+        else if (strcmp(name, "Vap_5G") == 0) {
+            type = webconfig_subdoc_type_vap_5G;
+            should_decode = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G);
+        }
+        else if (strcmp(name, "Vap_2.4G") == 0) {
+            type = webconfig_subdoc_type_vap_24G;
+            should_decode = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G);
+        }
+        else if (strcmp(name, "radio") == 0) {
+            type = webconfig_subdoc_type_radio;
+            should_decode = true; // generic radio is for all bands
+        }
+        else if (strcmp(name, "radio_6G") == 0) {
+            type = webconfig_subdoc_type_radio_6G;
+            should_decode = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_6G);
+        }
+        else if (strcmp(name, "radio_5G") == 0) {
+            type = webconfig_subdoc_type_radio_5G;
+            should_decode = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_5G);
+        }
+        else if (strcmp(name, "radio_2.4G") == 0) {
+            type = webconfig_subdoc_type_radio_24G;
+            should_decode = (m_radio_info.frequency_band == beerocks::eFreqType::FREQ_24G);
+        }
+        else if (strcmp(name, "mesh_sta") == 0 || strcmp(name, "mesh backhaul sta") == 0) {
+            type = webconfig_subdoc_type_mesh_sta;
+            should_decode = true; // mesh_sta is for all bands
+        }
+        else if (strcmp(name, "associated clients") == 0) {
+            type = webconfig_subdoc_type_associated_clients;
+            should_decode = true; // associated clients is for all bands
+        }
+        else if (strcmp(name, "dml") == 0) {
+            type = webconfig_subdoc_type_dml;
+            should_decode = true; // dml is for all bands
+        }
+        else {
+            ONEWIFI_LOG_DEBUG("AP: unhandled SubDocName=%s", name);
+            cJSON_Delete(json);
+            return;
+        }
+
+        // Skip decoding if this subdoc doesn't match current radio's band
+        if (!should_decode) {
+            ONEWIFI_LOG_DEBUG("AP: Skipping SubDocName=%s (doesn't match radio band %d)", 
+                             name, m_radio_info.frequency_band);
+            cJSON_Delete(json);
+            return;
+        }
+
+        // Extract WiFiVapCap array to populate VapName to InterfaceName mapping
+        // This is present in "dml" subdoc type under WiFiCap
+        if (type == webconfig_subdoc_type_dml) {
+            cJSON *wifi_cap = cJSON_GetObjectItemCaseSensitive(json, "WiFiCap");
+            if (wifi_cap) {
+                cJSON *vap_cap_array = cJSON_GetObjectItemCaseSensitive(wifi_cap, "WiFiVapCap");
+                if (cJSON_IsArray(vap_cap_array)) {
+                    int vap_count = cJSON_GetArraySize(vap_cap_array);
+                    ONEWIFI_LOG_INFO("AP: Found WiFiVapCap array with %d entries", vap_count);
+
+                    for (int i = 0; i < vap_count; i++) {
+                        cJSON *vap_item = cJSON_GetArrayItem(vap_cap_array, i);
+                        if (!vap_item) continue;
+
+                        cJSON *vap_name_item = cJSON_GetObjectItemCaseSensitive(vap_item, "VapName");
+                        cJSON *mld_iface_name_item = cJSON_GetObjectItemCaseSensitive(vap_item, "mldInterfaceName");
+                        cJSON *iface_name_item = cJSON_GetObjectItemCaseSensitive(vap_item, "InterfaceName");
+
+                        if (cJSON_IsString(vap_name_item) && vap_name_item->valuestring) {
+                            std::string vap_name = vap_name_item->valuestring;
+                            std::string iface_name;
+
+                            if (cJSON_IsString(iface_name_item) && iface_name_item->valuestring && 
+                                strlen(iface_name_item->valuestring) > 0) {
+                                iface_name = iface_name_item->valuestring;
+                            }
+
+                            if (cJSON_IsString(mld_iface_name_item) && mld_iface_name_item->valuestring && 
+                                strlen(mld_iface_name_item->valuestring) > 0) {
+                                iface_name = mld_iface_name_item->valuestring;
+                            } else {
+                                // Default MLD interface name based on VapName
+                                // mesh_backhaul VAPs use phy00-mld1, others use phy00-mld0
+                                if (vap_name.find("mesh_backhaul") == 0) {
+                                    iface_name = "phy00-mld1";
+                                } else {
+                                    iface_name = "phy00-mld0";
+                                }
+                            }
+
+                            m_data_model->set_vap_name_mapping(vap_name, iface_name);
+                            ONEWIFI_LOG_INFO("AP: Mapped VapName '%s' -> InterfaceName '%s'",
+                                           vap_name.c_str(), iface_name.c_str());
+                        }
+                    }
+                    ONEWIFI_LOG_INFO("AP: Populated %zu VapName to InterfaceName mappings",
+                                   m_data_model->get_vap_name_mapping_count());
+                }
+            }
+        }
+
+        cJSON_Delete(json);
+    }
+
+    // Decode subdocs that passed should_decode filter (DML, radio, VAP, private)
+    if (should_decode && (type == webconfig_subdoc_type_dml || 
+                          type == webconfig_subdoc_type_radio ||
+                          type == webconfig_subdoc_type_radio_24G ||
+                          type == webconfig_subdoc_type_radio_5G ||
+                          type == webconfig_subdoc_type_radio_6G ||
+                          type == webconfig_subdoc_type_vap_24G ||
+                          type == webconfig_subdoc_type_vap_5G ||
+                          type == webconfig_subdoc_type_vap_6G ||
+                          type == webconfig_subdoc_type_private)) {
+        // Decode (large stack vars in this scope - freed when this function returns)
+        webconfig_external_easymesh_t ext_data = {};
+        webconfig_t config = {};
+        if (!init_webconfig_for_decode(ext_data, config)) {
+            ONEWIFI_LOG_ERROR("AP: webconfig init failed"); return;
+        }
+
+        webconfig_error_t rc = safe_webconfig_decode(&config, json_str, &ext_data, &type);
+        if (rc != webconfig_error_none) {
+            ONEWIFI_LOG_ERROR("AP: decode failed type=%d error=%d", type, rc); return;
+        }
+
+        ONEWIFI_LOG_DEBUG("AP: decoded subdoc type=%d radios=%u bss=%u",
+                      type, m_data_model->get_num_radios(), m_data_model->get_num_bss());
+
+        if (m_data_model->get_num_radios() > 0) {
+            update_radio_info_from_data_model();
+            ONEWIFI_LOG_INFO("AP: radio info updated for subdoc type=%d", type);
+        }
+
+        // For VAP-related subdocs push AP_Enabled / AP_Disabled per BSS
+        if (type == webconfig_subdoc_type_private  ||
+            type == webconfig_subdoc_type_vap_24G  ||
+            type == webconfig_subdoc_type_vap_5G   ||
+            type == webconfig_subdoc_type_vap_6G   ||
+            type == webconfig_subdoc_type_dml) {
+            // Get this radio's MAC to filter BSS entries that belong to it
+            std::string radio_mac_str = get_radio_mac();
+            mac_address_t radio_mac  = {};
+            if (!radio_mac_str.empty()) {
+                tlvf::mac_from_string(radio_mac, radio_mac_str);
+            }
+
+            for (unsigned int i = 0; i < m_data_model->get_num_bss(); i++) {
+                em_bss_info_t *bss = m_data_model->get_bss_info(i);
+                if (!bss) continue;
+
+                // Skip BSS with zero BSSID MAC
+                if (is_bss_zero_mac(bss)) continue;
+
+                // Skip BSS that does not belong to this radio
+                if (!radio_mac_str.empty() &&
+                    !bss_belongs_to_radio(bss, radio_mac)) continue;
+
+                // bssid.name holds the VapName; map it to the physical interface
+                std::string physical_iface;
+                if (!m_data_model->get_vap_name_mapping(bss->bssid.name, physical_iface)) {
+                    physical_iface = bss->bssid.name;
+                }
+
+                int8_t vap_id = get_vap_id_with_bss(physical_iface);
+                if (vap_id < 0) continue;
+
+                if (bss->enabled) {
+                    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sHOSTAP_ENABLED_NOTIFICATION));
+                    auto msg = reinterpret_cast<sHOSTAP_ENABLED_NOTIFICATION *>(msg_buff.get());
+                    LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+                    memset(msg_buff.get(), 0, sizeof(sHOSTAP_ENABLED_NOTIFICATION));
+                    msg->vap_id = vap_id;
+                    event_queue_push(static_cast<int>(Event::AP_Enabled), msg_buff);
+                    ONEWIFI_LOG_INFO("AP: Pushed AP_Enabled vap_id=%d iface=%s",
+                                     int(vap_id), physical_iface.c_str());
+                } else {
+                    auto msg_buff = ALLOC_SMART_BUFFER(sizeof(sHOSTAP_DISABLED_NOTIFICATION));
+                    auto msg = reinterpret_cast<sHOSTAP_DISABLED_NOTIFICATION *>(msg_buff.get());
+                    LOG_IF(!msg, FATAL) << "Memory allocation failed!";
+                    memset(msg_buff.get(), 0, sizeof(sHOSTAP_DISABLED_NOTIFICATION));
+                    msg->vap_id = vap_id;
+                    event_queue_push(static_cast<int>(Event::AP_Disabled), msg_buff);
+                    ONEWIFI_LOG_INFO("AP: Pushed AP_Disabled vap_id=%d iface=%s",
+                                     int(vap_id), physical_iface.c_str());
+                }
+            }
+        }
+    }
 }
 
