 bool ap_wlan_hal_nl80211::clear_blacklist()
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED";
-    return true;
+    // Send DENY_ACL CLEAR to every registered link interface so that stale
+    // DENY_ACL entries (e.g. from a TIMED_BLOCK before a prplmesh restart)
+    // are removed from hostapd.  The DENY_ACL list is per-link-interface in
+    // the MLO setup, so we must clear each link separately.
+    //
+    // We iterate available_vaps to collect the unique BSS interface names
+    // (e.g. wlan1_link0, wlan2_link0, ...) and send DENY_ACL CLEAR to each.
+    // Duplicate base interfaces (wlan1, wlan2, ...) are skipped because
+    // hostapd stores the ACL per-link, not per-MLD.
+    bool success = true;
+    std::set<std::string> cleared_ifaces;
+
+    for (const auto &vap : m_radio_info.available_vaps) {
+        const std::string &iface = vap.second.bss;
+        if (iface.empty()) {
+            continue;
+        }
+        if (cleared_ifaces.count(iface)) {
+            continue; // already cleared this interface
+        }
+        cleared_ifaces.insert(iface);
+
+        LOG(DEBUG) << "clear_blacklist: sending DENY_ACL CLEAR to iface=" << iface;
+        if (!wpa_ctrl_send_msg("DENY_ACL CLEAR", iface)) {
+            LOG(WARNING) << "clear_blacklist: DENY_ACL CLEAR failed for iface=" << iface;
+            success = false;
+        }
+    }
+
+    if (cleared_ifaces.empty()) {
+        LOG(WARNING) << "clear_blacklist: no VAPs available, nothing cleared";
+    }
+
+    return success;
 }
 
