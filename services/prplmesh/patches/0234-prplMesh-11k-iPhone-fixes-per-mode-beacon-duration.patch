 {
@@ -470,6 +496,77 @@ bool mon_wlan_hal_nl80211::sta_beacon_11k_request(const std::string &vap_iface_n
     // not set req.measurement_mode explicitly, but the task layer always sets it now.
     uint8_t measurement_mode = req.measurement_mode;
 
+    // Select measurement duration based on mode (from agent config, overrides req.duration).
+    // Matches Prop: BcnrptActiveDuration / BcnrptPassiveDuration / BcnrptBcnTableDuration.
+    uint16_t measurement_duration;
+    switch (measurement_mode) {
+        case BEACON_MEASUREMENT_MODE_ACTIVE:
+            measurement_duration = g_beacon_11k_active_measurement_duration;
+            break;
+        case BEACON_MEASUREMENT_MODE_PASSIVE:
+            measurement_duration = g_beacon_11k_passive_measurement_duration;
+            break;
+        default: // TABLE and any other mode
+            measurement_duration = g_beacon_11k_table_measurement_duration;
+            break;
+    }
+
+    // Per-STA measurement mode validation:
+    // If Active or Passive mode is requested, verify the STA actually supports it via
+    // hostapd's "STA <mac>" command (rrm_capability field).
+    // iPhones and some clients only support Beacon Table (mode=2) — sending Active/Passive
+    // to them causes hostapd to log "does not support active beacon report" and drop the request.
+    //
+    // This check is intentionally at the BWL layer so it does NOT impact higher-level callers
+    // (e.g., the steering app) that already set the correct mode per STA. If the steering app
+    // sets TABLE for iPhones, the check passes unchanged. If it sets Active/Passive for capable
+    // STAs, the check also passes unchanged. Only the global/default path is protected here.
+    //
+    // RRM Enabled Capabilities (IEEE 802.11-2020, Section 9.4.2.45), byte 0:
+    //   Bit 4 (0x10) = Beacon Passive Measurement Capability
+    //   Bit 5 (0x20) = Beacon Active Measurement Capability
+    //   Bit 6 (0x40) = Beacon Table Measurement Capability
+    if (measurement_mode != BEACON_MEASUREMENT_MODE_TABLE) {
+        // Find the first registered link interface to query STA capabilities
+        std::string query_iface;
+        for (int link_idx = 0; link_idx < 8; link_idx++) {
+            std::string link_iface = base_vap_iface + "_link" + std::to_string(link_idx);
+            if (is_wpa_ctrl_interface_registered(link_iface)) {
+                query_iface = link_iface;
+                break;
+            }
+        }
+        if (!query_iface.empty()) {
+            std::string sta_cmd = "STA " + tlvf::mac_to_string(req.sta_mac.oct);
+            char *sta_reply     = nullptr;
+            if (wpa_ctrl_send_msg(sta_cmd, &sta_reply, query_iface) && sta_reply) {
+                std::string reply_str(sta_reply);
+                auto rrm_pos = reply_str.find("rrm_capability=");
+                if (rrm_pos != std::string::npos) {
+                    // Parse first byte of rrm_capability (10 hex chars = 5 bytes)
+                    std::string rrm_hex  = reply_str.substr(rrm_pos + 15, 2);
+                    uint8_t rrm_byte0    = static_cast<uint8_t>(std::strtoul(rrm_hex.c_str(), nullptr, 16));
+                    bool supports_passive = (rrm_byte0 & 0x10) != 0;
+                    bool supports_active  = (rrm_byte0 & 0x20) != 0;
+                    if ((measurement_mode == BEACON_MEASUREMENT_MODE_PASSIVE && !supports_passive) ||
+                        (measurement_mode == BEACON_MEASUREMENT_MODE_ACTIVE  && !supports_active)) {
+                        LOG(DEBUG) << "Beacon 11k: STA " << tlvf::mac_to_string(req.sta_mac.oct)
+                                   << " does not support measurement_mode=" << int(measurement_mode)
+                                   << " (rrm_byte0=0x" << std::hex << int(rrm_byte0) << std::dec
+                                   << "), falling back to Beacon Table mode";
+                        measurement_mode = BEACON_MEASUREMENT_MODE_TABLE;
+                    }
+                } else {
+                    // No rrm_capability field → STA has no RRM support at all
+                    // Fall back to Beacon Table mode to avoid hostapd rejection
+                    LOG(DEBUG) << "Beacon 11k: STA " << tlvf::mac_to_string(req.sta_mac.oct)
+                               << " has no rrm_capability field, falling back to Beacon Table mode";
+                    measurement_mode = BEACON_MEASUREMENT_MODE_TABLE;
+                }
+            }
+        }
+    }
