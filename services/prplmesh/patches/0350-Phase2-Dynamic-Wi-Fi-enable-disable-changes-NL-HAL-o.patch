+#ifdef USE_PRPLMESH_NLHAL
+void BackhaulManager::start_backhaul_reconnect_watchdog(std::shared_ptr<sRadioInfo> radio_info)
+{
+    if (!radio_info) {
+        LOG(ERROR) << "start_backhaul_reconnect_watchdog called with null radio_info";
+        return;
+    }
+
+    auto db = AgentDB::get();
+    if (db->device_conf.local_gw) {
+        LOG(DEBUG) << "local_gw is set - not registering reconnect watchdog timer for "
+                   << radio_info->sta_iface;
+        return;
+    }
+
+    bool is_selected_backhaul_link =
+        !radio_info->sta_iface.empty() &&
+        radio_info->sta_iface == db->backhaul.selected_iface_name &&
+        db->backhaul.selected_iface_radio_mac != net::network_utils::ZERO_MAC &&
+        radio_info->radio_mac == db->backhaul.selected_iface_radio_mac;
+
+    if (!is_selected_backhaul_link) {
+        LOG(DEBUG) << "Radio " << radio_info->sta_iface
+                   << " is not the selected active backhaul link (selected="
+                   << db->backhaul.selected_iface_name
+                   << ") - not registering reconnect watchdog timer";
+        return;
+    }
+
+    if (radio_info->reconnect_watchdog_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(DEBUG) << "Reconnect watchdog timer already running for " << radio_info->sta_iface
+                   << " - not starting a second one";
+        return;
+    }
+
+    if (std::chrono::steady_clock::now() < radio_info->next_watchdog_start_allowed) {
+        LOG(DEBUG) << "Reconnect watchdog cooldown still active for " << radio_info->sta_iface
+                   << " - not re-arming yet";
+        return;
+    }
+
+    if (!db->device_conf.local_gw && m_eth_link_up) {
+        LOG(DEBUG) << "Wired backhaul is reachable - not registering reconnect watchdog timer "
+                      "for "
+                   << radio_info->sta_iface;
+        return;
+    }
+
+    std::string sta_iface = radio_info->sta_iface;
+    LOG(INFO) << "Starting backhaul reconnect watchdog timer for " << sta_iface
+              << " - first run immediately, then every 5 minutes";
+
+    // Note: a delay of exactly zero disarms a Linux timerfd (see timerfd_settime(2) - setting
+    // it_value to zero disarms the timer regardless of it_interval), so a 1ms delay is used
+    // instead to have the watchdog fire immediately for all practical purposes.
+    radio_info->reconnect_watchdog_timer = m_timer_manager->add_timer(
+        "Backhaul Reconnect Watchdog " + sta_iface, std::chrono::milliseconds(1),
+        std::chrono::minutes(5), [this, radio_info](int fd, beerocks::EventLoop &loop) {
+            LOG(DEBUG) << "Backhaul reconnect watchdog fired for " << radio_info->sta_iface
+                       << ", radio_disabled=" << radio_info->radio_disabled
+                       << ", is_connected="
+                       << (radio_info->sta_wlan_hal ? radio_info->sta_wlan_hal->is_connected()
+                                                     : false);
+
+            auto db = AgentDB::get();
+            if (!db->device_conf.local_gw &&
+                is_gateway_reachable_via_interface(db->ethernet.wan.iface_name)) {
+                LOG(INFO) << "Wired backhaul is reachable for " << radio_info->sta_iface
+                          << " - removing reconnect watchdog timer";
+                m_timer_manager->remove_timer(fd);
+                radio_info->reconnect_watchdog_timer =
+                    beerocks::net::FileDescriptor::invalid_descriptor;
+                radio_info->watchdog_owns_recovery = false;
+                return true;
+            }
+
+            bool is_selected_backhaul_link =
+                !radio_info->sta_iface.empty() &&
+                radio_info->sta_iface == db->backhaul.selected_iface_name &&
+                db->backhaul.selected_iface_radio_mac != net::network_utils::ZERO_MAC &&
+                radio_info->radio_mac == db->backhaul.selected_iface_radio_mac;
+            if (!is_selected_backhaul_link) {
+                LOG(DEBUG) << "Radio " << radio_info->sta_iface
+                          << " is no longer the selected backhaul link - removing reconnect "
+                             "watchdog timer";
+                m_timer_manager->remove_timer(fd);
+                radio_info->reconnect_watchdog_timer =
+                    beerocks::net::FileDescriptor::invalid_descriptor;
+                radio_info->watchdog_owns_recovery = false;
+                return true;
+            }
+
+            if (!radio_info->radio_disabled) {
+                LOG(DEBUG) << "Radio " << radio_info->sta_iface
+                          << " is no longer disabled - skipping reconnect attempt";
+                radio_info->watchdog_owns_recovery = false;
+                return true;
+            }
+
+            if (!radio_info->sta_wlan_hal) {
+                LOG(DEBUG) << "No sta_wlan_hal available for " << radio_info->sta_iface
+                          << " - skipping this watchdog cycle";
+                radio_info->watchdog_owns_recovery = false;
+                return true;
+            }
+
+            LOG(INFO) << "Disconnecting bSTA " << radio_info->sta_iface
+                      << " for this watchdog cycle before re-testing connectivity";
+            LOG(DEBUG) << "Watchdog now owns recovery for " << radio_info->sta_iface
+                       << " - suppressing automatic FSM disconnect handling until this cycle "
+                          "concludes";
+            radio_info->watchdog_owns_recovery = true;
+            radio_info->sta_wlan_hal->disconnect_backhaul_sta();
+
+            // Give the disconnect 30 seconds to settle, then attempt a reconnect; after that,
+            // wait another 30 seconds before checking whether the reconnect actually succeeded
+            // (association/4-way handshake happens asynchronously via the HAL event handler, so
+            // is_connected() right after reconnect_backhaul_sta() would not yet reflect it).
+            radio_info->reconnect_trigger_timer = m_timer_manager->add_timer(
+                "Backhaul Reconnect Trigger " + radio_info->sta_iface, std::chrono::seconds(30),
+                std::chrono::milliseconds::zero(),
+                [this, radio_info, fd](int trigger_fd, beerocks::EventLoop &trigger_loop) mutable {
+                    m_timer_manager->remove_timer(trigger_fd);
+                    radio_info->reconnect_trigger_timer =
+                        beerocks::net::FileDescriptor::invalid_descriptor;
+
+                    auto db = AgentDB::get();
+                    if (!db->device_conf.local_gw &&
+                        is_gateway_reachable_via_interface(db->ethernet.wan.iface_name)) {
+                        LOG(INFO) << "Wired backhaul is reachable for "
+                                  << radio_info->sta_iface << " - removing reconnect watchdog "
+                                     "timer instead of reconnecting";
+                        m_timer_manager->remove_timer(fd);
+                        radio_info->reconnect_watchdog_timer =
+                            beerocks::net::FileDescriptor::invalid_descriptor;
+                        radio_info->watchdog_owns_recovery = false;
+                        return true;
+                    }
+
+                    if (!radio_info->radio_disabled || !radio_info->sta_wlan_hal) {
+                        LOG(DEBUG) << "Radio " << radio_info->sta_iface
+                                  << " no longer disabled or has no sta_wlan_hal - skipping "
+                                     "reconnect trigger";
+                        radio_info->watchdog_owns_recovery = false;
+                        return true;
+                    }
+
+                    LOG(INFO) << "30-second disconnect wait elapsed for " << radio_info->sta_iface
+                              << " - attempting reconnect";
+                    radio_info->sta_wlan_hal->reconnect_backhaul_sta();
+
+                    // Give the reconnect 30 more seconds before checking whether it succeeded.
+                    radio_info->reconnect_check_timer = m_timer_manager->add_timer(
+                        "Backhaul Reconnect Check " + radio_info->sta_iface,
+                        std::chrono::seconds(30), std::chrono::milliseconds::zero(),
+                        [this, radio_info, fd](int check_fd, beerocks::EventLoop &check_loop) mutable {
+                            m_timer_manager->remove_timer(check_fd);
+                            radio_info->reconnect_check_timer =
+                                beerocks::net::FileDescriptor::invalid_descriptor;
+
+                            auto db = AgentDB::get();
+                            if (!db->device_conf.local_gw &&
+                                is_gateway_reachable_via_interface(db->ethernet.wan.iface_name)) {
+                                LOG(INFO) << "Wired backhaul is reachable for "
+                                          << radio_info->sta_iface
+                                          << " - removing reconnect watchdog timer";
+                                m_timer_manager->remove_timer(fd);
+                                radio_info->reconnect_watchdog_timer =
+                                    beerocks::net::FileDescriptor::invalid_descriptor;
+                                radio_info->watchdog_owns_recovery = false;
+                                return true;
+                            }
+
+                            if (!radio_info->radio_disabled || !radio_info->sta_wlan_hal) {
+                                LOG(DEBUG) << "Radio " << radio_info->sta_iface
+                                          << " no longer disabled or has no sta_wlan_hal - "
+                                             "skipping reconnect check";
+                                radio_info->watchdog_owns_recovery = false;
+                                return true;
+                            }
+
+                            if (radio_info->sta_wlan_hal->is_connected()) {
+                                LOG(INFO) << "bSTA " << radio_info->sta_iface
+                                          << " reconnected successfully - removing reconnect "
+                                             "watchdog timer and triggering agent "
+                                             "re-onboarding with controller";
+                                m_timer_manager->remove_timer(fd);
+                                radio_info->reconnect_watchdog_timer =
+                                    beerocks::net::FileDescriptor::invalid_descriptor;
+                                radio_info->next_watchdog_start_allowed =
+                                    std::chrono::steady_clock::now() + std::chrono::minutes(5);
+                                LOG(DEBUG) << "Releasing watchdog ownership of recovery for "
+                                           << radio_info->sta_iface << " - reconnect succeeded";
+                                radio_info->watchdog_owns_recovery = false;
+                                FSM_MOVE_STATE(INIT_HAL);
+                            } else {
+                                LOG(INFO) << "bSTA " << radio_info->sta_iface
+                                          << " still not connected after reconnect attempt - "
+                                             "disconnecting again and waiting for next 5-minute "
+                                             "watchdog cycle";
+                                radio_info->sta_wlan_hal->disconnect_backhaul_sta();
+                                LOG(DEBUG) << "Releasing watchdog ownership of recovery for "
+                                           << radio_info->sta_iface
+                                           << " - cycle concluded, FSM free to run until next "
+                                              "watchdog tick";
+                                radio_info->watchdog_owns_recovery = false;
+                            }
+
+                            return true;
+                        });
+
+                    return true;
+                });
+
+            return true;
+        });
+
+    if (radio_info->reconnect_watchdog_timer == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "Failed to create backhaul reconnect watchdog timer for " << sta_iface;
+    }
+}
