     // The VBSS spec leaves the actions needed to handle a Move Cancel up to the Agent.
-    if (!ap_wlan_hal->remove_bss(ifname)) {
+    if (!remove_bss(ifname)) {
         LOG(WARNING) << "Could not remove BSS '" << ifname << "'";
     }
     // TODO PPM-2191: renegotiate Block Acks.
@@ -2426,8 +2443,22 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             bss_info_conf_list.push_back(bss_info_conf);
         }
 
+#ifdef USE_PRPLMESH_NLHAL
+        // A vendor-reported "disabled" radio_state (real, or via a stub like the
+        // Airties Service-Status TLV on the nl80211 HAL where enable()/disable() are
+        // unimplemented no-ops) must not block configuration/teardown from being
+        // applied — otherwise a TEARDOWN M2 can never be honored and the controller
+        // never gets a WIFI_CREDENTIALS_UPDATE_RESPONSE, stalling the autoconfiguration
+        // FSM forever. Refresh radio info once for logging, then proceed regardless.
+        ap_wlan_hal->refresh_radio_info();
+        LOG(DEBUG) << "radio_state=" << ap_wlan_hal->get_radio_info().radio_state
+                   << " radio_state_lock=" << radio_state_lock
+                   << " - proceeding with vap credentials update regardless of radio state";
+        auto perform_update = true;
+#else
         // Before updating vap credentials we need to make sure hostapd is enabled.
         // Entering blocking state until radio is enabled again.
+#define WAIT_FOR_RADIO_ENABLE_TIMEOUT_SEC 100
         auto timeout = std::chrono::steady_clock::now() +
                        std::chrono::seconds(WAIT_FOR_RADIO_ENABLE_TIMEOUT_SEC);
         auto perform_update = false;
@@ -2443,12 +2474,53 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             }
             UTILS_SLEEP_MSEC(500);
         }
+#endif
 
         // Enabling VAPs and MLDs takes time to apply to the driver
         if (perform_update && !bss_info_conf_list.empty()) {
+            // An M2 with the Tear Down bit set tears down all currently operating BSS(es) on
+            // this radio. Back up the on-disk hostapd radio-level config to persistent UCI
+            // storage before update_vap_credentials() removes/rewrites it below, mirroring the
+            // backup done before an explicit ACTION_APMANAGER_RADIO_DISABLE_REQUEST - otherwise
+            // BSSes/MLD links can never be recreated on a later radio_enable if the hostapd*.conf
+            // for this radio is gone (tmpfs) and the system reboots.
+            bool all_teardown = std::all_of(bss_info_conf_list.begin(), bss_info_conf_list.end(),
+                                            [](const son::wireless_utils::sBssInfoConf &conf) {
+                                                return conf.teardown;
+                                            });
+            if (all_teardown) {
+                LOG(DEBUG) << "All BSS(es) on this radio are being torn down by M2 - backing up "
+                              "reference hostapd config before teardown";
+                ap_wlan_hal->backup_reference_hostapd_config();
+            }
+
             ap_wlan_hal->update_vap_credentials(bss_info_conf_list, backhaul_wps_ssid,
                                                 backhaul_wps_passphrase, bridge_name);
 
+            // The HAL already removed the interface (and its whole MLD-link/base-name
+            // family) for any torn-down BSS, but it has no knowledge of ApManager's
+            // m_dynamic_bss_ext_events_fds / event-loop registrations. This path bypasses
+            // ApManager::remove_bss(), which normally does this cleanup, so do it here by
+            // diffing m_dynamic_bss_ext_events_fds' keys against the HAL's current
+            // active_BSSs list - any key no longer present there is stale (its HAL-level
+            // fd, and the fds of its whole family, are already gone) and must be cleared.
+            const auto &active_BSSs = ap_wlan_hal->get_radio_info().active_BSSs;
+            for (auto fd_it = m_dynamic_bss_ext_events_fds.begin();
+                fd_it != m_dynamic_bss_ext_events_fds.end();) {
+                const auto &ifname = fd_it->first;
+                if (std::find(active_BSSs.begin(), active_BSSs.end(), ifname) !=
+                    active_BSSs.end()) {
+                    ++fd_it;
+                    continue;
+                }
+                int fd = fd_it->second;
+                if (!m_event_loop->remove_handlers(fd)) {
+                    LOG(WARNING) << "Unable to remove handlers for torn-down BSS fd " << fd;
+                }
+                LOG(DEBUG) << "Cleared dynamic ext-events fd for torn-down BSS " << ifname;
+                fd_it = m_dynamic_bss_ext_events_fds.erase(fd_it);
+            }
+
 #ifdef USE_PRPLMESH_NLHAL
             // Notify monitor thread to refresh its VAP DB after credentials update
             auto vap_update_notif = message_com::create_vs_message<
@@ -2534,9 +2606,39 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             response->number_of_bss_available() = radio_vaps.size();
             send_cmdu(cmdu_tx);
 
+#ifdef USE_PRPLMESH_NLHAL
+            // This M2-driven credentials-update path (unlike the async Event::AP_Disabled /
+            // handle_ap_enabled cases) never goes through the hostapd AP-ENABLED/AP-DISABLED
+            // notification handlers, so it needs its own radio_disable sync: non-AT controllers
+            // never send a Service-Status TLV, so a teardown-only M2 (zero remaining VAPs) or a
+            // real M2 (VAPs actually created) is the only signal we get that the radio has
+            // implicitly become disabled/enabled.
+            if (radio_vaps.empty()) {
+                if (!m_radio_disable) {
+                    m_radio_disable = true;
+                    if (!beerocks::bpl::bpl_cfg_set_radio_disable_by_phy(m_iface, true)) {
+                        LOG(ERROR) << "Failed to set radio_disable in UCI for phy=" << m_iface;
+                    }
+                    LOG(INFO) << "No VAPs remain on " << m_iface
+                              << " after credentials update - setting radio_disable";
+                }
+            } else if (m_radio_disable) {
+                m_radio_disable = false;
+                if (!beerocks::bpl::bpl_cfg_set_radio_disable_by_phy(m_iface, false)) {
+                    LOG(ERROR) << "Failed to clear radio_disable in UCI for phy=" << m_iface;
+                }
+                LOG(INFO) << "Valid VAP(s) received on " << m_iface
+                          << " after credentials update - clearing radio_disable";
+            }
+#endif
+
         } else {
+#ifdef USE_PRPLMESH_NLHAL
+            LOG(ERROR) << "discard new configuration because configuration is empty";
+#else
             LOG(ERROR) << "discard new configuration because "
                        << (perform_update ? "configuration is empty" : "radio not enabled");
+#endif
         }
         break;
     }
@@ -2580,11 +2682,40 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
             return;
         }
 
+#ifdef USE_PRPLMESH_NLHAL
+        // Set radio_disable proactively, before tearing down the interface, rather than
+        // waiting for the later AP_Disabled event to confirm it. is_radio_disabled() is
+        // polled every main-loop iteration by fronthaul_manager_main.cpp and relayed to
+        // Monitor's independent poll thread - if the flag only flips after disable()/the
+        // AP_Disabled round trip, there is a window where the wpa_ctrl socket is already
+        // gone but Monitor still believes the radio is enabled, and its hostapd
+        // ping/reattach fallback treats that as fatal (crashing the fronthaul process).
+        m_radio_disable = true;
+        if (!beerocks::bpl::bpl_cfg_set_radio_disable_by_phy(m_iface, true)) {
+            LOG(ERROR) << "Failed to set radio_disable in UCI for phy=" << m_iface;
+        }
+
+        // Back up the current on-disk hostapd radio-level config to persistent UCI storage
+        // before disabling, so BSSes/MLD links can be recreated on a later radio_enable even
+        // if every hostapd*.conf for this radio gets removed (tmpfs) and the system reboots.
+        ap_wlan_hal->backup_reference_hostapd_config();
+
         // Disable the radio interface
         if (!ap_wlan_hal->disable()) {
             LOG(ERROR) << "Failed disabling radio on iface: " << ap_wlan_hal->get_iface_name();
+            m_radio_disable = false;
+            if (!beerocks::bpl::bpl_cfg_set_radio_disable_by_phy(m_iface, false)) {
+                LOG(ERROR) << "Failed to clear radio_disable in UCI for phy=" << m_iface;
+            }
             return;
         }
+#else
+        // Disable the radio interface
+        if (!ap_wlan_hal->disable()) {
+            LOG(ERROR) << "Failed disabling radio on iface: " << ap_wlan_hal->get_iface_name();
+            return;
+        }
+#endif
         radio_state_lock = true;
         break;
     }
@@ -3889,6 +4020,46 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
         LOG(INFO) << "AP_Disabled on vap_id = " << int(msg->vap_id);
 
         if (msg->vap_id == beerocks::IFACE_RADIO_ID) {
+#ifdef USE_PRPLMESH_NLHAL
+            // If this AP_Disabled is the direct result of our own radio_disable request, the
+            // hostapd/wpa_ctrl socket is expected to be gone - retrying refresh_radio_info()
+            // against it for MAX_RADIO_DISABLED_TIMEOUT_SEC only adds noise/delay. Go straight
+            // to notifying the slave that the radio is disabled.
+            if (m_radio_disable) {
+                LOG(DEBUG) << "radio_disable already set for " << m_iface
+                           << " - skipping hostapd grace-time retry";
+            } else {
+            auto timeout = std::chrono::steady_clock::now() +
+                           std::chrono::seconds(MAX_RADIO_DISABLED_TIMEOUT_SEC);
+            auto notify_disabled = true;
+
+            while (std::chrono::steady_clock::now() < timeout) {
+                if (!ap_wlan_hal->refresh_radio_info()) {
+                    LOG(WARNING) << "Radio could be temporary disabled, wait grace time "
+                                 << std::chrono::duration_cast<std::chrono::seconds>(
+                                        timeout - std::chrono::steady_clock::now())
+                                        .count()
+                                 << " sec.";
+                    UTILS_SLEEP_MSEC(500);
+                    continue;
+                }
+
+                auto state = ap_wlan_hal->get_radio_info().radio_state;
+                if ((state != bwl::eRadioState::DISABLED) &&
+                    (state != bwl::eRadioState::UNINITIALIZED)) {
+                    LOG(DEBUG) << "Radio is not disabled (state=" << state
+                               << "), not forwarding disabled notification.";
+                    notify_disabled = false;
+                    break;
+                }
+                UTILS_SLEEP_MSEC(500);
+            }
+
+            if (!notify_disabled) {
+                break;
+            }
+            }
+#else
             auto timeout = std::chrono::steady_clock::now() +
                            std::chrono::seconds(MAX_RADIO_DISABLED_TIMEOUT_SEC);
             auto notify_disabled = true;
@@ -3918,6 +4089,7 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
             if (!notify_disabled) {
                 break;
             }
+#endif
         }
 
         // Pure-FH TS updates are per-VAP, so forward single-BSS disables as
@@ -3935,6 +4107,24 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
         response->vap_id() = msg->vap_id;
 
         send_cmdu(cmdu_tx);
+
+        // If this radio now has zero enabled VAPs left (last VAP torn down, or the M2 tore
+        // everything down), mark it disabled - even though no explicit
+        // ACTION_APMANAGER_RADIO_DISABLE_REQUEST was ever sent (non-AT controllers never send
+        // one). refresh_vaps_info() re-queries hostapd STATUS, so available_vaps reflects only
+        // VAPs that are still actually present at this point (platform-confirmed).
+#ifdef USE_PRPLMESH_NLHAL
+        if (!m_radio_disable) {
+            ap_wlan_hal->refresh_vaps_info();
+            if (ap_wlan_hal->get_radio_info().available_vaps.empty()) {
+                m_radio_disable = true;
+                if (!beerocks::bpl::bpl_cfg_set_radio_disable_by_phy(m_iface, true)) {
+                    LOG(ERROR) << "Failed to set radio_disable in UCI for phy=" << m_iface;
+                }
+                LOG(INFO) << "No VAPs remain on " << m_iface << " - setting radio_disable";
+            }
+        }
+#endif
     } break;
     case Event::Interface_Disabled: {
 
@@ -4860,6 +5050,21 @@ bool ApManager::handle_ap_enabled(int vap_id)
               << ", backhaul = " << vap_info.backhaul << ", apmld mac = " << vap_info.ap_mld_mac
               << ", link_id = " << vap_info.link_id;
 
+#ifdef USE_PRPLMESH_NLHAL
+    // A real VAP just came up on this radio - that is proof the radio is no longer disabled,
+    // even though no explicit ACTION_APMANAGER_RADIO_ENABLE_REQUEST was ever sent (non-AT
+    // controllers never send one). Persist to UCI here only, since ap_manager is the process
+    // that actually confirmed the platform-level enablement.
+    if (m_radio_disable) {
+        m_radio_disable = false;
+        if (!beerocks::bpl::bpl_cfg_set_radio_disable_by_phy(m_iface, false)) {
+            LOG(ERROR) << "Failed to clear radio_disable in UCI for phy=" << m_iface;
+        }
+        LOG(INFO) << "AP_Enabled on vap_id=" << int(vap_id) << " - clearing radio_disable for "
+                  << m_iface;
+    }
+#endif
+
     if (m_pending_qos_management_settings.valid && vap_info.fronthaul &&
         net::network_utils::is_valid_mac(vap_info.mac)) {
         const auto bssid = tlvf::mac_from_string(vap_info.mac);
@@ -5002,19 +5207,29 @@ bool ApManager::remove_bss(std::string &ifname)
 {
     LOG(DEBUG) << "Removing bss " << ifname;
 
-    if (m_dynamic_bss_ext_events_fds.count(ifname) < 1) {
-        LOG(WARNING) << "Could not find ext events fd for interface " << ifname;
-        // Continue, try to remove the BSS anyway.
+    std::vector<std::string> removed_family;
+    bool result = ap_wlan_hal->remove_bss(ifname, &removed_family);
+    if (removed_family.empty()) {
+        // HAL didn't report a family (e.g. lookup failed before it could remove anything) -
+        // fall back to cleaning up just the named interface's fd.
+        removed_family.push_back(ifname);
     }
-    int fd = m_dynamic_bss_ext_events_fds[ifname];
 
-    if (!m_event_loop->remove_handlers(fd)) {
-        LOG(WARNING) << "Unable to remove handlers for external event fd " << fd;
-        // Continue, try to remove the BSS anyway.
+    for (const auto &family_iface : removed_family) {
+        auto fd_it = m_dynamic_bss_ext_events_fds.find(family_iface);
+        if (fd_it == m_dynamic_bss_ext_events_fds.end()) {
+            LOG(WARNING) << "Could not find ext events fd for interface " << family_iface;
+            continue;
+        }
+        int fd = fd_it->second;
+        if (!m_event_loop->remove_handlers(fd)) {
+            LOG(WARNING) << "Unable to remove handlers for external event fd " << fd;
+            // Continue, try to remove the rest of the family anyway.
+        }
+        m_dynamic_bss_ext_events_fds.erase(fd_it);
     }
-    m_dynamic_bss_ext_events_fds.erase(ifname);
 
-    if (!ap_wlan_hal->remove_bss(ifname)) {
+    if (!result) {
         LOG(ERROR) << "Failed to remove the BSS!";
         return false;
     }
@@ -5067,6 +5282,17 @@ bool ApManager::register_ext_events_handlers(int fd)
             },
     };
 
+    // If this fd number is a stale leftover from a previously torn-down BSS/link (the
+    // HAL-side socket was closed and its fd freed, but nothing removed the matching
+    // entry from the event loop's own fd->handler map - e.g. BSSes/links torn down via
+    // the normal update_vap_credentials()->remove_bss()/remove_mld_link() path aren't
+    // tracked in m_dynamic_bss_ext_events_fds, so none of the existing per-fd cleanup
+    // paths catch them), EventLoopImpl::register_handlers() below would otherwise see
+    // the fd number "already there" and silently refuse to (re-)register it once the OS
+    // reuses that same fd for this new socket. Clear any such stale entry first; if there
+    // isn't one, remove_handlers() just logs a WARNING and returns false, which is fine.
+    m_event_loop->remove_handlers(fd);
+
     if (!m_event_loop->register_handlers(fd, ext_events_handlers)) {
         LOG(ERROR) << "Unable to register handlers for external event fd " << fd;
         return false;
diff --git a/agent/src/beerocks/fronthaul_manager/fronthaul_manager_main.cpp b/agent/src/beerocks/fronthaul_manager/fronthaul_manager_main.cpp
