         auto itFdMax =
             std::max_element(std::begin(m_ap_hal_ext_events), std::end(m_ap_hal_ext_events));
         if (itFdMax == std::end(m_ap_hal_ext_events) || *itFdMax == 0) {
-            // There is no socket for external events, so we simply try
