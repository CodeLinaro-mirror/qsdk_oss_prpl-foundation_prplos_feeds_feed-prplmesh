@@ -397,6 +397,24 @@ ApManager::ApManager(const std::string &iface, beerocks::logging &logger,
 void ApManager::resolve_iface_from_hostapd_conf()
 {
     beerocks::os_utils::resolve_iface_from_hostapd_conf(m_iface, m_if_ref_of_phy_id);
+
+/*
+    // The conf-file read above has no notion of identity - it will happily return whatever
+    // interface currently happens to be written into /var/run/hostapd-<phy>.conf, even if
+    // that's actually owned by a different phy slot after a crash-triggered respawn. UCI's
+    // own hostap_iface mapping for this phy is authoritative when available; reject a
+    // mismatching fallback result rather than silently binding to the wrong radio.
+    if (!m_if_ref_of_phy_id.empty()) {
+        std::string uci_hostap_iface;
+        if (beerocks::bpl::bpl_cfg_get_hostap_iface_by_phy(m_iface, uci_hostap_iface) &&
+            !uci_hostap_iface.empty() && uci_hostap_iface != m_if_ref_of_phy_id) {
+            LOG(WARNING) << "hostapd conf for " << m_iface << " resolved to "
+                        << m_if_ref_of_phy_id << " but UCI says this phy owns "
+                        << uci_hostap_iface << " - rejecting the mismatched conf-file result";
+            m_if_ref_of_phy_id.clear();
+        }
+    }
+*/
 }
 
 bool ApManager::create_ap_wlan_hal()
