+bool bpl_cfg_backup_hostapd_radio_config(const std::string &radio_id,
+                                         const std::vector<std::string> &head_lines,
+                                         const std::vector<std::string> &iface_lines)
+{
+    if (radio_id.empty()) {
+        LOG(ERROR) << "bpl_cfg_backup_hostapd_radio_config: empty radio_id";
+        return false;
+    }
+
+    const std::string package_name = "prplmesh";
+    const std::string section_type = "wifi-device-backup";
+
+    std::string section_name;
+    uci_find_section_by_option(package_name, section_type, "radio_id", radio_id, section_name);
+
+    if (section_name.empty()) {
+        section_name = "backup_" + radio_id;
+        std::replace(section_name.begin(), section_name.end(), ':', '_');
+        if (!uci_add_section(package_name, section_type, section_name, false)) {
+            // The deterministic name may already exist as a bare section shell left behind by an
+            // earlier backup attempt that added the section but never got as far as setting the
+            // radio_id option on it (e.g. it was interrupted before commit). In that case
+            // uci_find_section_by_option() above can never match it again (no radio_id option to
+            // match on), and uci_add_section() will keep colliding on the name forever unless we
+            // detect and reuse the existing shell here instead of bailing out.
+            if (!uci_section_exists(package_name, section_type, section_name)) {
+                LOG(ERROR) << "bpl_cfg_backup_hostapd_radio_config: failed to add section "
+                           << section_name;
+                return false;
+            }
+            LOG(WARNING) << "bpl_cfg_backup_hostapd_radio_config: section " << section_name
+                         << " already exists without a matching radio_id option - reusing it";
+        }
+    }
+
+    OptionsUnorderedMap options;
+    options["radio_id"] = radio_id;
+    if (!uci_set_section(package_name, section_type, section_name, options, false)) {
+        LOG(ERROR) << "bpl_cfg_backup_hostapd_radio_config: failed to set radio_id option on "
+                   << section_name;
+        return false;
+    }
+
+    // Replace the head_line contents atomically: drop any previously backed-up lines, then add
+    // the current lines back in order. head_line stores the radio-level ("head") config;
+    // iface_line (handled separately below) stores the primary/base interface's own vap config
+    // (its "interface=<iface>" line and everything up to the next vap marker), which
+    // Configuration::load() classifies as a vap rather than head content.
+    std::vector<std::string> old_head_lines;
+    uci_get_list_option(package_name, section_name, "head_line", old_head_lines);
+    for (const auto &line : old_head_lines) {
+        uci_del_list_option(package_name, section_name, "head_line", line, false);
+    }
+    for (const auto &line : head_lines) {
+        if (!uci_add_list_option(package_name, section_name, "head_line", line, false)) {
+            LOG(ERROR) << "bpl_cfg_backup_hostapd_radio_config: failed to add head_line '" << line
+                       << "' to section " << section_name;
+            return false;
+        }
+    }
+
+    // Unlike head_lines, iface_lines may legitimately come in empty from the caller (e.g. the
+    // on-disk conf being backed up right now happens to have no "interface=" vap section for
+    // the base radio interface). That is not the same as "there is no primary-interface config
+    // to preserve" - a good iface_line backup may already exist in UCI from an earlier, valid
+    // capture, and must not be wiped out by a call that simply failed to find one this time.
+    // Only replace the stored iface_line list when the caller actually captured something.
+    if (!iface_lines.empty()) {
+        std::vector<std::string> old_iface_lines;
+        uci_get_list_option(package_name, section_name, "iface_line", old_iface_lines);
+        for (const auto &line : old_iface_lines) {
+            uci_del_list_option(package_name, section_name, "iface_line", line, false);
+        }
+        for (const auto &line : iface_lines) {
+            if (!uci_add_list_option(package_name, section_name, "iface_line", line, false)) {
+                LOG(ERROR) << "bpl_cfg_backup_hostapd_radio_config: failed to add iface_line '"
+                           << line << "' to section " << section_name;
+                return false;
+            }
+        }
+    }
+
+    if (!uci_commit_changes(package_name)) {
+        LOG(ERROR) << "bpl_cfg_backup_hostapd_radio_config: failed to commit changes";
+        return false;
+    }
+
+    LOG(DEBUG) << "Backed up hostapd radio config for radio_id=" << radio_id << " ("
+               << head_lines.size() << " head lines, " << iface_lines.size()
+               << " iface lines) in section " << section_name;
+    return true;
+}
+
+bool bpl_cfg_restore_hostapd_radio_config(const std::string &radio_id,
+                                          std::vector<std::string> &head_lines,
+                                          std::vector<std::string> &iface_lines)
+{
+    head_lines.clear();
+    iface_lines.clear();
+
+    if (radio_id.empty()) {
+        LOG(ERROR) << "bpl_cfg_restore_hostapd_radio_config: empty radio_id";
+        return false;
+    }
+
+    const std::string package_name = "prplmesh";
+    const std::string section_type = "wifi-device-backup";
+
+    std::string section_name;
+    if (!uci_find_section_by_option(package_name, section_type, "radio_id", radio_id,
+                                    section_name) ||
+        section_name.empty()) {
+        LOG(DEBUG) << "bpl_cfg_restore_hostapd_radio_config: no backup section for radio_id="
+                   << radio_id;
+        return false;
+    }
+
+    if (!uci_get_list_option(package_name, section_name, "head_line", head_lines) ||
+        head_lines.empty()) {
+        LOG(DEBUG) << "bpl_cfg_restore_hostapd_radio_config: no head_line entries in section "
+                   << section_name;
+        return false;
+    }
+
+    // iface_lines may legitimately be empty for radios where no base-interface vap section
+    // existed at backup time; don't fail the restore for that alone.
+    uci_get_list_option(package_name, section_name, "iface_line", iface_lines);
+
+    LOG(DEBUG) << "Restored hostapd radio config for radio_id=" << radio_id << " ("
+               << head_lines.size() << " head lines, " << iface_lines.size()
+               << " iface lines) from section " << section_name;
+    return true;
+}
