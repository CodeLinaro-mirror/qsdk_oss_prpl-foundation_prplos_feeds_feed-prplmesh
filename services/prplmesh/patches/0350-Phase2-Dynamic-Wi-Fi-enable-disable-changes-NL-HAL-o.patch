+
+void BackhaulManager::handle_backhaul_radio_enabled(std::shared_ptr<sRadioInfo> radio_info)
+{
+    if (!radio_info) {
+        LOG(ERROR) << "handle_backhaul_radio_enabled called with null radio_info";
+        return;
+    }
+
+    LOG(INFO) << "Handling backhaul radio_enable for " << radio_info->sta_iface;
+
+    if (radio_info->watchdog_owns_recovery) {
+        LOG(DEBUG) << "Releasing watchdog ownership of recovery for " << radio_info->sta_iface
+                   << " - radio_enable arrived mid-cycle";
+        radio_info->watchdog_owns_recovery = false;
+    }
+
+    bool is_connected = radio_info->sta_wlan_hal && radio_info->sta_wlan_hal->is_connected();
+    if (!is_connected) {
+        LOG(INFO) << "bSTA " << radio_info->sta_iface
+                  << " not active on radio_enable - enabling/reconnecting";
+        if (radio_info->sta_wlan_hal) {
+            if (radio_info->added_network_status) {
+                LOG(DEBUG) << "Network already added for " << radio_info->sta_iface
+                          << " - sending reconnect";
+                radio_info->sta_wlan_hal->reconnect_backhaul_sta();
+            } else if (radio_info->bSta_conf.ssid.empty() ||
+                      radio_info->bSta_conf.network_key.empty()) {
+                LOG(WARNING) << "No valid bSTA credentials available for "
+                            << radio_info->sta_iface << " - cannot reconnect yet";
+            } else if (radio_info->sta_wlan_hal->add_new_network(radio_info->bSta_conf)) {
+                LOG(DEBUG) << "ADD NETWORK completed for " << radio_info->sta_iface;
+                radio_info->added_network_status = true;
+                radio_info->sta_wlan_hal->reconnect_backhaul_sta();
+            } else {
+                LOG(ERROR) << "Failed to add network for " << radio_info->sta_iface;
+            }
+        } else {
+            LOG(WARNING) << "No sta_wlan_hal available for " << radio_info->sta_iface
+                        << " - cannot reconnect";
+        }
+    } else {
+        LOG(DEBUG) << "bSTA " << radio_info->sta_iface << " already connected on radio_enable";
+    }
+
+    if (radio_info->reconnect_watchdog_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(INFO) << "Removing backhaul reconnect watchdog timer for " << radio_info->sta_iface;
+        m_timer_manager->remove_timer(radio_info->reconnect_watchdog_timer);
+        radio_info->reconnect_watchdog_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+
+    if (radio_info->reconnect_trigger_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(INFO) << "Removing backhaul reconnect trigger timer for " << radio_info->sta_iface;
+        m_timer_manager->remove_timer(radio_info->reconnect_trigger_timer);
+        radio_info->reconnect_trigger_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+
+    if (radio_info->reconnect_check_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(INFO) << "Removing backhaul reconnect check timer for " << radio_info->sta_iface;
+        m_timer_manager->remove_timer(radio_info->reconnect_check_timer);
+        radio_info->reconnect_check_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+
+    radio_info->next_watchdog_start_allowed = std::chrono::steady_clock::time_point::min();
+}
