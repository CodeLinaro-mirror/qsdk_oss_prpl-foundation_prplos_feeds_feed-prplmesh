+bool ap_wlan_hal_nl80211::backup_reference_hostapd_config()
+{
+    prplmesh::hostapd::Configuration base_conf = load_hostapd_config(m_radio_info.iface_name, "");
+    if (!base_conf) {
+        LOG(DEBUG) << "backup_reference_hostapd_config: no on-disk hostapd config found for "
+                   << m_radio_info.iface_name << ", nothing to back up";
+        return false;
+    }
+
+    auto head_lines = base_conf.get_hostapd_radio_config();
+    if (head_lines.empty()) {
+        LOG(DEBUG) << "backup_reference_hostapd_config: empty head config for "
+                   << m_radio_info.iface_name;
+        return false;
+    }
+
+    // Configuration::load() treats "interface=" itself as a vap boundary, so the primary/base
+    // interface's own section (its "interface=<iface>" line and everything up to the next vap
+    // marker) is classified as a vap keyed by the radio's iface_name, not as head content. Back
+    // that up too so it is not lost.
+    std::vector<std::string> iface_lines;
+    auto base_iface_vap = base_conf.get_hostapd_bss_config(m_radio_info.iface_name);
+    if (!base_iface_vap.empty()) {
+        iface_lines = base_iface_vap.front().second;
+    }
+
+    return beerocks::bpl::bpl_cfg_backup_hostapd_radio_config(m_radio_info.radio_id, head_lines,
+                                                              iface_lines);
