+bool Configuration::has_interface_section() const
+{
+    return std::any_of(m_hostapd_config_vaps.begin(), m_hostapd_config_vaps.end(),
+                        [](const std::pair<std::string, std::vector<std::string>> &vap) {
+                            return std::any_of(vap.second.begin(), vap.second.end(),
+                                                [](const std::string &line) {
+                                                    return line.rfind("interface=", 0) == 0;
+                                                });
+                        });
+}
+
+namespace {
+
+// Returns a predicate matching any existing vap section that add_new_vap_to_default_config()
+// would treat as "the same vap" as new_vap: same vap name, or same bssid= line (e.g. a
+// section restored from a UCI backup taken before this vap's on-disk conf was removed).
+std::function<bool(const std::pair<std::string, std::vector<std::string>> &)>
+make_is_same_vap_predicate(const std::pair<std::string, std::vector<std::string>> &new_vap)
+{
+    std::string new_bssid;
+    for (const auto &line : new_vap.second) {
+        if (line.rfind("bssid=", 0) == 0) {
+            new_bssid = line.substr(std::string("bssid=").length());
+            break;
+        }
+    }
+
+    return [&new_vap, new_bssid](const std::pair<std::string, std::vector<std::string>> &vap) {
+        if (vap.first == new_vap.first) {
+            return true;
+        }
+        if (new_bssid.empty()) {
+            return false;
+        }
+        return std::any_of(vap.second.begin(), vap.second.end(),
+                            [&new_bssid](const std::string &line) {
+                                return line.rfind("bssid=", 0) == 0 &&
+                                       beerocks::string_utils::case_insensitive_compare(
+                                           line.substr(std::string("bssid=").length()),
+                                           new_bssid);
+                            });
+    };
+}
+
+} // namespace
+
+bool Configuration::has_other_interface_section(
+    const std::pair<std::string, std::vector<std::string>> &new_vap) const
+{
+    auto is_same_vap = make_is_same_vap_predicate(new_vap);
+    return std::any_of(
+        m_hostapd_config_vaps.begin(), m_hostapd_config_vaps.end(),
+        [&is_same_vap](const std::pair<std::string, std::vector<std::string>> &vap) {
+            if (is_same_vap(vap)) {
+                return false;
+            }
+            return std::any_of(vap.second.begin(), vap.second.end(),
+                                [](const std::string &line) {
+                                    return line.rfind("interface=", 0) == 0;
+                                });
+        });
+}
+
 void Configuration::add_new_vap_to_default_config(const std::pair<std::string, std::vector<std::string>>& new_vap)
 {
+    // Find the bssid the new vap is being created with (if any), so a pre-existing vap
+    // section for the same interface/bss name and/or the same bssid (e.g. restored from a
+    // UCI backup taken before this vap's on-disk conf files were removed) can be updated
+    // in place with the new credentials instead of appended as a duplicate section.
+    auto is_same_vap = make_is_same_vap_predicate(new_vap);
+
+    auto existing_vap = std::find_if(m_hostapd_config_vaps.begin(), m_hostapd_config_vaps.end(),
+                                     is_same_vap);
+    if (existing_vap != m_hostapd_config_vaps.end()) {
+        LOG(DEBUG) << "add_new_vap_to_default_config: updating existing vap section for '"
+                   << existing_vap->first << "' with new credentials";
+        *existing_vap = new_vap;
+        return;
+    }
+
     LOG(DEBUG) << "add new vap section to default config file " ;
     m_hostapd_config_vaps.push_back(new_vap);
 }
