+            ap_wlan_hal->process_ext_events();
         }
 
         // Send Heartbeat notification if needed
@@ -1230,7 +1247,7 @@ void ApManager::handle_virtual_bss_move_cancel_request(ieee1905_1::CmduMessageRx
     client_info_tlv_tx->client_mac() = client_info_tlv_rx->client_mac();
