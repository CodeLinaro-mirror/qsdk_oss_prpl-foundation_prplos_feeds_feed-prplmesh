+bool mon_wlan_hal_nl80211::get_hostapd_conf_iface_name(std::string &iface_name)
+{
+    std::vector<std::string> hostapd_cfg_names;
+    std::string path = "/var/run/";
+
+    auto hasExtension = [](const std::string &filename, const std::string &extension) {
+        if (filename.length() >= extension.length()) {
+            return filename.compare(filename.length() - extension.length(), extension.length(),
+                                    extension) == 0;
+        }
+        return false;
+    };
+
+    DIR *dir = opendir(path.c_str());
+    if (!dir) {
+        LOG(ERROR) << "can't open the directory";
+        return false;
+    }
+
+    struct dirent *entry;
+    std::string hostapd_phy = "hostapd-" + m_radio_info.phy_name;
+    LOG(DEBUG) << "Looking for hostapd conf files starting with " << hostapd_phy;
+    while ((entry = readdir(dir)) != nullptr) {
+        if (entry->d_type == DT_REG &&
+            (strncmp(entry->d_name, hostapd_phy.c_str(), hostapd_phy.length()) == 0) &&
+            hasExtension(entry->d_name, ".conf")) {
+            hostapd_cfg_names.push_back(path + entry->d_name);
+        }
+    }
+    closedir(dir);
+
+    std::sort(hostapd_cfg_names.begin(), hostapd_cfg_names.end());
+
+    for (const auto &try_fname : hostapd_cfg_names) {
+        LOG(DEBUG) << "Trying to load " << try_fname << "...";
+
+        prplmesh::hostapd::Configuration hostapd_conf(try_fname);
+        if (!hostapd_conf.load("interface=", "bss=")) {
+            LOG(ERROR) << "Failed to load hostapd config file: " << try_fname;
+            continue;
+        }
+
+        auto vaps = hostapd_conf.get_hostapd_bss_config();
+        if (vaps.empty()) {
+            continue;
+        }
+
+        // first configured vap's name is the real interface name for this radio
+        iface_name = vaps.front().first;
+        if (!iface_name.empty()) {
+            LOG(DEBUG) << "Found interface " << iface_name << " in " << try_fname;
+            return true;
+        }
+    }
+
+    LOG(DEBUG) << "No interface found in any hostapd conf file for " << hostapd_phy
+              << " - treating radio as no-VAP mode";
+    return false;
+}
 
