From 793441cb96fa9b1218d677a6ba0fcbb6a37be21a Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Tue, 6 Oct 2026 12:32:56 +0530
Subject: [PATCH] NLHAL: Resolve WPS invalid network addition and skip WPS
 credential provisioning for 6 GHz BSSs

Configured scan_ssid for the newly added network

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../beerocks/slave/backhaul_manager/backhaul_manager.cpp  | 2 +-
 common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 8 ++++----
 common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp      | 4 ++++
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 498133582..698846ef4 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1948,7 +1948,7 @@ bool BackhaulManager::backhaul_fsm_wireless(bool &skip_select)
                         } else {
                             LOG(DEBUG) << "Failed to reconnect";
                         }
-                    } else {
+                    } else if (m_backhaul_switch) {
                         // wired to wireless switching - add bh credentials
                         // Check if bSta_conf has valid credentials, if not retrieve from bpl_cfg
                         if (radio_info->bSta_conf.ssid.empty() || radio_info->bSta_conf.network_key.empty()) {
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 0000e0f85..ef94873ac 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -6026,7 +6026,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     }
                 }
 
-                if(!m_radio_info.wps_pushbutton_configured && bss_it.fronthaul){
+                if(m_radio_info.frequency_band != beerocks::eFreqType::FREQ_6G && !m_radio_info.wps_pushbutton_configured && bss_it.fronthaul){
                     conf.set_create_vap_value(vap_id, "wps_state", bss_it.fronthaul ? "2" : "");
                     conf.set_create_vap_value(vap_id, "wps_independent", bss_it.fronthaul ? "1" : "");
                     conf.set_create_vap_value(vap_id, "config_methods","push_button");
@@ -6096,7 +6096,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                 bss_it.multi_ap = multi_ap;
                 // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
                 // quoted, while wpa_passphrase does not...
-                if (bss_it.fronthaul && !backhaul_wps_ssid.empty()) {
+                if (m_radio_info.frequency_band != beerocks::eFreqType::FREQ_6G && bss_it.fronthaul && !backhaul_wps_ssid.empty()) {
                     conf.set_create_vap_value(vap_id, "multi_ap_backhaul_ssid",
                             "\"" + backhaul_wps_ssid + "\"");
                     conf.set_create_vap_value(vap_id, "multi_ap_backhaul_wpa_passphrase",
@@ -10413,7 +10413,7 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
 //  multi_ap and wds_sta cannot co-exist for AP    
 //    conf.set_create_vap_value(vap_id, "wds_sta", "1");
 
-    if(!m_radio_info.wps_pushbutton_configured && bss_conf.fronthaul){
+    if(m_radio_info.frequency_band != beerocks::eFreqType::FREQ_6G && !m_radio_info.wps_pushbutton_configured && bss_conf.fronthaul){
         conf.set_create_vap_value(vap_id, "wps_state", bss_conf.fronthaul ? "2" : "");
         conf.set_create_vap_value(vap_id, "wps_independent", bss_conf.fronthaul ? "1" : "");
         conf.set_create_vap_value(vap_id, "config_methods","push_button");
@@ -10492,7 +10492,7 @@ bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son:
     bss_conf.multi_ap = multi_ap;
     // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
     // quoted, while wpa_passphrase does not...
-    if (bss_conf.fronthaul && !bss_conf.backhaul_wps_ssid.empty()) {
+    if (m_radio_info.frequency_band != beerocks::eFreqType::FREQ_6G && bss_conf.fronthaul && !bss_conf.backhaul_wps_ssid.empty()) {
         conf.set_create_vap_value(vap_id, "multi_ap_backhaul_ssid",
                                   "\"" + bss_conf.backhaul_wps_ssid + "\"");
         conf.set_create_vap_value(vap_id, "multi_ap_backhaul_wpa_passphrase",
diff --git a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
index aa0b34e71..8c7e0187a 100644
--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
@@ -1055,6 +1055,10 @@ bool sta_wlan_hal_nl80211::add_new_network(son::wireless_utils::sBssInfoConf bSt
         LOG(ERROR) << "Failed setting multi_ap_backhaul_sta on interface " << sta_iface;
         return false;
     }
+    if (!set_network(network_id, "scan_ssid","1")) {
+        LOG(ERROR) << "Failed setting scan_ssid on interface " << sta_iface;
+        return false;
+    }
 
     // Set the FREQ_LIST obtained from GET_FREQ_LIST so that wpa_supplicant restricts
     // scanning and association to the frequencies supported by this radio.
-- 
2.34.1

