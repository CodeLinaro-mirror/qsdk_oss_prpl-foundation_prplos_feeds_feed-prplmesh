From a9df7a5f1f23fc98077064ca62412e8e10fc4dcf Mon Sep 17 00:00:00 2001
From: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
Date: Fri, 19 Jun 2026 11:04:20 +0530
Subject: [PATCH] Single Link MLO Fix - Fixing E0 Payload

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp      | 14 ++++++++++++--
 controller/src/beerocks/master/controller.cpp      | 10 ++++++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 46fc99dc7..16a6e3763 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -4259,7 +4259,16 @@ bool ApAutoConfigurationTask::populate_mld_id_in_bss_infos(const std::string &ra
         }
 
         if (is_mlo_grouped) {
-            eRadioType radio_type = determine_radio_type(freq_type, is_mlo_grouped);
+            bool is_multi_link = false;
+            for (const auto &ap_mld_conf : db->ap_mld_configurations) {
+                if (ap_mld_conf.mld_config.mld_ssid == ssid) {
+                    if (ap_mld_conf.affiliated_aps.size() > 1) {
+                        is_multi_link = true;
+                    }
+                    break;
+                }
+            }
+            eRadioType radio_type = determine_radio_type(freq_type, is_multi_link);
             eVapType vap_type = bss_info.m2_config.vap_type;
             int8_t mld_unit = get_mld_unit_from_lookup_table(vap_type, radio_type);
 
@@ -4268,7 +4277,8 @@ bool ApAutoConfigurationTask::populate_mld_id_in_bss_infos(const std::string &ra
             LOG(DEBUG) << "Populated BSS config for SSID " << ssid
                        << ": vap_type=" << static_cast<int>(vap_type)
                        << ", radio_type=" << static_cast<int>(radio_type)
-                       << ", mld_id=" << int(bss_info.mld_id);
+                       << ", mld_id=" << int(bss_info.mld_id)
+                       << ", is_multi_link=" << is_multi_link;
 
             // Update the agent's database with this newly looked-up mld_unit
             m_ap_mld_requests_infos[radio_iface][ssid].mld_unit = mld_unit;
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index eb5702047..3edf56293 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -3727,6 +3727,14 @@ bool Controller::autoconfig_wsc_parse_radio_caps(
     */
     database.remove_hostap_supported_operating_classes(radio_mac);
 
+    // Collect operating classes into a temporary set so ap_basic_caps_operating_classes can be
+    // populated for all radios from the AP Capability Report, not just the radio whose M1 is
+    // currently being processed. add_agent_ap_mld_configuration_tlv uses this set to match
+    // radios to BSS configs when building the Agent AP MLD Configuration TLV; without populating
+    // it here, only the current M1's radio has the set filled, causing every M2 to carry a
+    // different (incomplete) affiliated-radio list instead of the full set for every M2.
+    std::set<uint8_t> op_class_set;
+
     std::stringstream ss;
     for (int oc_idx = 0; oc_idx < operating_classes_list_length; oc_idx++) {
         auto operating_class_tuple = radio_caps->operating_classes_info_list(oc_idx);
@@ -3759,11 +3767,13 @@ bool Controller::autoconfig_wsc_parse_radio_caps(
         // store operating class in the DB for this hostap
         database.add_hostap_supported_operating_class(
             radio_mac, operating_class, maximum_transmit_power_dbm, non_operable_channels);
+        op_class_set.insert(operating_class);
     }
 
     // Trigger AP radio basic capabilities event
     auto radio = database.get_radio_by_uid(radio_mac);
     if (radio) {
+        radio->ap_basic_caps_operating_classes = op_class_set;
         auto agent = database.get_agent_by_radio_uid(radio_mac);
         if (agent) {
             database.dm_trigger_ap_radio_basic_capabilities_event(radio_mac, radio->dm_path,
-- 
