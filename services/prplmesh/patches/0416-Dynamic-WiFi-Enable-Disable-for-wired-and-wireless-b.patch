+#ifdef USE_PRPLMESH_WHM
+unsigned son_actions::get_agent_hop_count(db &database, const sMacAddr &al_mac)
+{
+    unsigned hops           = 0;
+    sMacAddr current        = al_mac;
+    std::unordered_set<sMacAddr> visited;
+    while (current != database.get_local_bridge_mac() && current != network_utils::ZERO_MAC) {
+        if (!visited.insert(current).second) {
+            break;
+        }
+        auto agent = database.get_agent(current);
+        if (!agent) {
+            break;
+        }
+        current = agent->parent_mac;
+        ++hops;
+    }
+    return hops;
+}
+
+std::vector<sMacAddr> son_actions::get_agents_farthest_to_nearest(db &database)
+{
+    std::vector<sMacAddr> agent_alids;
+    for (const auto &agent : database.m_agents) {
+        // Skip local bridge (controller itself)
+        if (agent.first == database.get_local_bridge_mac()) {
+            continue;
+        }
+        agent_alids.push_back(agent.first);
+    }
+
+    std::sort(agent_alids.begin(), agent_alids.end(), [&](const sMacAddr &a, const sMacAddr &b) {
+        return get_agent_hop_count(database, a) > get_agent_hop_count(database, b);
+    });
+
+    return agent_alids;
+}
