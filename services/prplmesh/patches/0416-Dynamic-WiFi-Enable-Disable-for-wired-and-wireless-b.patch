+bool ap_wlan_hal_whm::get_radio_access_points(std::vector<std::pair<std::string, bool>> &aps)
+{
+    aps.clear();
+    auto result =
+        m_ambiorix_cl.get_object_multi<AmbiorixVariantMapSmartPtr>(wbapi_utils::search_path_ap_inst());
+    if (!result) {
+        LOG(ERROR) << "get_radio_access_points(): could not get AccessPoint objects for "
+                   << wbapi_utils::search_path_ap();
+        return false;
+    }
+
+    auto radio_index = wbapi_utils::get_object_id(m_radio_path);
+    for (auto &it : *result) {
+        const std::string &ap_path = it.first;
+        auto &ap_obj                = it.second;
+        if (ap_obj.empty()) {
+            continue;
+        }
+
+        std::string radio_path;
+        if (!m_ambiorix_cl.resolve_path(wbapi_utils::get_path_radio_reference(ap_obj),
+                                        radio_path) ||
+            wbapi_utils::get_object_id(radio_path) != radio_index) {
+            continue;
+        }
+
+        std::string alias = wbapi_utils::get_ap_iface(ap_obj);
+        if (alias.empty()) {
+            LOG(DEBUG) << "get_radio_access_points(): AP " << ap_path << " on radio "
+                       << m_radio_path << " has empty Alias, skipping";
+            continue;
+        }
+
+        bool enabled = false;
+        ap_obj.read_child(enabled, "Enable");
+        aps.emplace_back(alias, enabled);
+    }
+    return true;
+}
