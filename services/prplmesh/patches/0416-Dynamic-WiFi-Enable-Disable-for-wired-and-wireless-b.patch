+#if defined(USE_PRPLMESH_NLHAL) || defined(USE_PRPLMESH_WHM)
+bool BackhaulManager::is_backhaul_fully_disconnected()
+{
+    if (m_eth_link_up) {
+        return false;
+    }
+
+    for (auto &radio_info : m_radios_info) {
+        if (radio_info->sta_wlan_hal && radio_info->sta_wlan_hal->is_connected()) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+#endif
+
+#ifdef USE_PRPLMESH_WHM
+bool BackhaulManager::all_radios_disabled()
+{
+    if (m_radios_info.empty()) {
+        return false;
+    }
+
+    return std::all_of(m_radios_info.begin(), m_radios_info.end(),
+                        [](const std::shared_ptr<sRadioInfo> &radio_info) {
+                            return radio_info->radio_disabled;
+                        });
+}
+
+void BackhaulManager::maybe_start_backhaul_recovery_cycle()
+{
+    if (m_backhaul_recovery_cycle_active) {
+        return;
+    }
+
+    bool any_radio_has_sta_wlan_hal = std::any_of(
+        m_radios_info.begin(), m_radios_info.end(),
+        [](const std::shared_ptr<sRadioInfo> &radio_info) { return !!radio_info->sta_wlan_hal; });
+    if (!any_radio_has_sta_wlan_hal) {
+        // No WiFi EndPoint configured on any radio - nothing for this cycle to toggle.
+        return;
+    }
+
+    if (!is_backhaul_fully_disconnected() || !all_radios_disabled()) {
+        return;
+    }
+
+    LOG(INFO) << "No backhaul connectivity (wired nor wireless) and all radios are disabled - "
+                 "starting backhaul-loss recovery cycle";
+    m_backhaul_recovery_cycle_active = true;
+    recovery_cycle_stage1_enable_ep();
+}
+
+void BackhaulManager::recovery_cycle_stage1_enable_ep()
+{
+    if (!is_backhaul_fully_disconnected()) {
+        LOG(INFO) << "Backhaul connectivity restored before recovery cycle stage 1 could run - "
+                     "stopping cycle";
+        recovery_cycle_stop();
+        return;
+    }
+
+    LOG(INFO) << "Backhaul recovery cycle: re-enabling EP on all radios with a bSTA";
+    for (auto &radio_info : m_radios_info) {
+        if (radio_info->sta_wlan_hal) {
+            if (!radio_info->sta_wlan_hal->enable_disable_ep(true)) {
+                LOG(WARNING) << "Backhaul recovery cycle: enable_disable_ep(true) failed on iface "
+                             << radio_info->sta_iface;
+            }
+        }
+    }
+
+    m_timer_manager->remove_timer(m_recovery_cycle_timer);
+    m_recovery_cycle_timer = m_timer_manager->add_timer(
+        "Backhaul Recovery Cycle Stage 2", std::chrono::seconds(60),
+        std::chrono::milliseconds::zero(), [this](int fd, beerocks::EventLoop &loop) {
+            m_timer_manager->remove_timer(fd);
+            m_recovery_cycle_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+            recovery_cycle_stage2_recheck();
+            return true;
+        });
+}
+
+void BackhaulManager::recovery_cycle_stage2_recheck()
+{
+    if (is_backhaul_fully_disconnected()) {
+        LOG(INFO) << "Backhaul recovery cycle stage 2: still no connectivity - disabling EP "
+                     "again and moving to powersave stage";
+        for (auto &radio_info : m_radios_info) {
+            if (radio_info->sta_wlan_hal) {
+                if (!radio_info->sta_wlan_hal->enable_disable_ep(false)) {
+                    LOG(WARNING) << "Backhaul recovery cycle: enable_disable_ep(false) failed on "
+                                    "iface "
+                                 << radio_info->sta_iface;
+                }
+            }
+        }
+        recovery_cycle_stage3_powersave_enable();
+        return;
+    }
+
+    LOG(INFO) << "Backhaul recovery cycle stage 2: connectivity restored - stopping cycle";
+    recovery_cycle_stop();
+}
+
+void BackhaulManager::recovery_cycle_stage3_powersave_enable()
+{
+    LOG(INFO) << "Backhaul recovery cycle: requesting 6G powersave-enable on all radios";
+    for (auto &radio_info : m_radios_info) {
+        auto request = message_com::create_vs_message<
+            beerocks_message::cACTION_BACKHAUL_RADIO_POWERSAVE_ENABLE_REQUEST>(cmdu_tx);
+        if (!request) {
+            LOG(ERROR) << "Failed building cACTION_BACKHAUL_RADIO_POWERSAVE_ENABLE_REQUEST for "
+                       << radio_info->hostap_iface;
+            continue;
+        }
+        request->set_iface(radio_info->hostap_iface);
+        send_cmdu(m_agent_fd, cmdu_tx);
+        LOG(DEBUG) << "Backhaul recovery cycle: sent powersave-enable request for "
+                  << radio_info->hostap_iface;
+    }
+
+    m_timer_manager->remove_timer(m_recovery_cycle_timer);
+    m_recovery_cycle_timer = m_timer_manager->add_timer(
+        "Backhaul Recovery Cycle Stage 4", std::chrono::minutes(4),
+        std::chrono::milliseconds::zero(), [this](int fd, beerocks::EventLoop &loop) {
+            m_timer_manager->remove_timer(fd);
+            m_recovery_cycle_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+            recovery_cycle_stage4_powersave_disable();
+            return true;
+        });
+}
+
+void BackhaulManager::recovery_cycle_stage4_powersave_disable()
+{
+    LOG(INFO) << "Backhaul recovery cycle: requesting 6G powersave-disable on all radios";
+    for (auto &radio_info : m_radios_info) {
+        auto request = message_com::create_vs_message<
+            beerocks_message::cACTION_BACKHAUL_RADIO_POWERSAVE_DISABLE_REQUEST>(cmdu_tx);
+        if (!request) {
+            LOG(ERROR) << "Failed building cACTION_BACKHAUL_RADIO_POWERSAVE_DISABLE_REQUEST for "
+                       << radio_info->hostap_iface;
+            continue;
+        }
+        request->set_iface(radio_info->hostap_iface);
+        send_cmdu(m_agent_fd, cmdu_tx);
+        LOG(DEBUG) << "Backhaul recovery cycle: sent powersave-disable request for "
+                  << radio_info->hostap_iface;
+    }
+
+    m_timer_manager->remove_timer(m_recovery_cycle_timer);
+    m_recovery_cycle_timer = m_timer_manager->add_timer(
+        "Backhaul Recovery Cycle Stage 5", std::chrono::seconds(10),
+        std::chrono::milliseconds::zero(), [this](int fd, beerocks::EventLoop &loop) {
+            m_timer_manager->remove_timer(fd);
+            m_recovery_cycle_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+            recovery_cycle_stage5_loop_or_stop();
+            return true;
+        });
+}
+
+void BackhaulManager::recovery_cycle_stage5_loop_or_stop()
+{
+    if (is_backhaul_fully_disconnected()) {
+        LOG(INFO) << "Backhaul recovery cycle stage 5: still no connectivity - repeating cycle";
+        recovery_cycle_stage1_enable_ep();
+        return;
+    }
+
+    LOG(INFO) << "Backhaul recovery cycle stage 5: connectivity restored - stopping cycle";
+    recovery_cycle_stop();
+}
+
+void BackhaulManager::recovery_cycle_stop()
+{
+    if (m_recovery_cycle_timer != beerocks::net::FileDescriptor::invalid_descriptor) {
+        m_timer_manager->remove_timer(m_recovery_cycle_timer);
+        m_recovery_cycle_timer = beerocks::net::FileDescriptor::invalid_descriptor;
+    }
+
+    if (m_eFSMState != EState::CONNECTED && m_eFSMState != EState::OPERATIONAL) {
+        LOG(INFO) << "Backhaul recovery cycle: forcing FSM to CONNECTED (wired backhaul "
+                     "recovered while FSM was paused)";
+        auto db                       = AgentDB::get();
+        db->backhaul.connection_type = AgentDB::sBackhaul::eConnectionType::Wired;
+        FSM_MOVE_STATE(CONNECTED);
+    }
+
+    m_backhaul_recovery_cycle_active = false;
+
+    LOG(INFO) << "Backhaul recovery cycle: connectivity restored - triggering re-onboarding "
+                 "(Autoconfig renew) for all radios";
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_BACKHAUL_AUTOCONFIG_RENEW_REQUEST>(cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "Failed building cACTION_BACKHAUL_AUTOCONFIG_RENEW_REQUEST";
+        return;
+    }
+    send_cmdu(m_agent_fd, cmdu_tx);
+}
