+void ap_config_renew_sequencer_task::work()
+{
+    switch (state) {
+    case SEND_NEXT_UNICAST: {
+        if (next_agent_idx >= agents.size()) {
+            state = SEND_MULTICAST;
+            break;
+        }
+
+        agent_awaiting_m2 = agents[next_agent_idx];
+        ++next_agent_idx;
+
+        if (!database.config.enable_unicast_renew ||
+            !son_actions::send_single_ap_config_renew_msg(cmdu_tx, database, agent_awaiting_m2,
+                                                          false)) {
+            TASK_LOG(ERROR) << "Failed to send unicast AP-Config Renew to " << agent_awaiting_m2;
+        }
+
+        state = WAIT_FOR_AGENT;
+        wait_for_event(M2_SENT);
+        set_events_timeout(AGENT_M2_TIMEOUT_MS);
+        break;
+    }
+    case WAIT_FOR_AGENT: {
+        // Should not be reached directly - handle_event()/handle_events_timeout() move the
+        // state forward and re-arm wait_for_event() as needed.
+        break;
+    }
+    case SEND_MULTICAST: {
+        if (!son_actions::send_single_ap_config_renew_msg(
+                cmdu_tx, database, network_utils::MULTICAST_1905_MAC_ADDR, true)) {
+            TASK_LOG(ERROR) << "Failed to send multicast AP-Config Renew";
+        }
+        database.notify_cmdu_sent(network_utils::MULTICAST_1905_MAC_ADDR,
+                                  static_cast<uint16_t>(
+                                      ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE));
+
+        state = WAIT_AFTER_MULTICAST;
+        wait_for(AFTER_MULTICAST_WAIT_MS);
+        break;
+    }
+    case WAIT_AFTER_MULTICAST: {
+        state = SEND_LOCAL;
+        break;
+    }
+    case SEND_LOCAL: {
+        if (!son_actions::send_single_ap_config_renew_msg(
+                cmdu_tx, database, database.get_local_bridge_mac(), false)) {
+            TASK_LOG(ERROR) << "Failed to send unicast AP-Config Renew to local agent";
+        }
+        state = DONE;
+        finish();
+        break;
+    }
+    case DONE:
+    default: {
+        finish();
+        break;
+    }
+    }
+}
+
+void ap_config_renew_sequencer_task::handle_event(int event_type, void *obj)
+{
+    if (state != WAIT_FOR_AGENT || event_type != M2_SENT) {
+        return;
+    }
+
+    auto al_mac = reinterpret_cast<sMacAddr *>(obj);
+    if (!al_mac || *al_mac != agent_awaiting_m2) {
+        // M2 sent to some other agent unrelated to our current wait - keep waiting for the
+        // agent we actually care about, without resetting the original timeout deadline.
+        wait_for_event(M2_SENT);
+        return;
+    }
+
+    TASK_LOG(DEBUG) << "M2 confirmed for agent " << agent_awaiting_m2 << " - advancing";
+    state = SEND_NEXT_UNICAST;
+}
+
+void ap_config_renew_sequencer_task::handle_events_timeout(std::multiset<int> pending_events)
+{
+    if (state != WAIT_FOR_AGENT) {
+        return;
+    }
+
+    TASK_LOG(DEBUG) << "Timed out waiting for M2 confirmation from agent " << agent_awaiting_m2
+                    << " - proceeding anyway";
+    state = SEND_NEXT_UNICAST;
+}
+
+void ap_config_renew_sequencer_task::handle_task_end()
+{
+    if (database.get_ap_config_renew_sequencer_task_id() == id) {
+        database.assign_ap_config_renew_sequencer_task_id(-1);
+    }
+}
+#endif
