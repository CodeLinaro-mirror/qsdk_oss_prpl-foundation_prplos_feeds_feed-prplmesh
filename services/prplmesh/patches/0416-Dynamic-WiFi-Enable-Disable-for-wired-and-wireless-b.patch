+bool ap_wlan_hal_whm::powersave_enable()
+{
+    LOG(DEBUG) << "ap_wlan_hal_whm::powersave_enable() called for radio iface="
+               << m_radio_info.iface_name << " path=" << m_radio_path;
+    if (m_radio_info.frequency_band != beerocks::eFreqType::FREQ_6G) {
+        LOG(DEBUG) << "powersave_enable() no-op for non-6G radio iface="
+                   << m_radio_info.iface_name;
+        return true; // no-op for non-6G radios
+    }
+
+    AmbiorixVariant new_obj(AMXC_VAR_ID_HTABLE);
+    new_obj.add_child("PowerSaveEnable", true);
+    if (!m_ambiorix_cl.update_object(m_radio_path, new_obj)) {
+        LOG(ERROR) << "powersave_enable() failed on radio " << m_radio_path;
+        return false;
+    }
+    LOG(DEBUG) << "powersave_enable() set PowerSaveEnable=1 on radio " << m_radio_path;
+    return true;
+}
+
+bool ap_wlan_hal_whm::powersave_disable()
+{
+    LOG(DEBUG) << "ap_wlan_hal_whm::powersave_disable() called for radio iface="
+               << m_radio_info.iface_name << " path=" << m_radio_path;
+    if (m_radio_info.frequency_band != beerocks::eFreqType::FREQ_6G) {
+        LOG(DEBUG) << "powersave_disable() no-op for non-6G radio iface="
+                   << m_radio_info.iface_name;
+        return true; // no-op for non-6G radios
+    }
+
+    AmbiorixVariant new_obj(AMXC_VAR_ID_HTABLE);
+    new_obj.add_child("PowerSaveEnable", false);
+    if (!m_ambiorix_cl.update_object(m_radio_path, new_obj)) {
+        LOG(ERROR) << "powersave_disable() failed on radio " << m_radio_path;
+        return false;
+    }
+    LOG(DEBUG) << "powersave_disable() set PowerSaveEnable=0 on radio " << m_radio_path;
+    return true;
+}
