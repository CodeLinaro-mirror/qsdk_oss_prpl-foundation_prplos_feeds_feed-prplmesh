+bool son_actions::send_single_ap_config_renew_msg(ieee1905_1::CmduMessageTx &cmdu_tx, db &database,
+                                                  const sMacAddr &dest_mac, bool multicast)
+{
+    // Create AP-Configuration renew message
+    auto cmdu_header =
+        cmdu_tx.create(0, ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE);
+    if (!cmdu_header) {
+        LOG(ERROR) << "Failed building IEEE1905 AP_AUTOCONFIGURATION_RENEW_MESSAGE";
+        return false;
+    }
+
+    // Add MAC address TLV
+    auto tlvAlMac = cmdu_tx.addClass<ieee1905_1::tlvAlMacAddress>();
+    if (!tlvAlMac) {
+        LOG(ERROR) << "Failed addClass ieee1905_1::tlvAlMacAddress";
+        return false;
+    }
+    tlvAlMac->mac() = database.get_local_bridge_mac();
+
+    // Add Supported-Role TLV
+    auto tlvSupportedRole = cmdu_tx.addClass<ieee1905_1::tlvSupportedRole>();
+    if (!tlvSupportedRole) {
+        LOG(ERROR) << "Failed addClass ieee1905_1::tlvSupportedRole";
+        return false;
+    }
+    tlvSupportedRole->value() = ieee1905_1::tlvSupportedRole::REGISTRAR;
+
+    // Add Supported-Frequency-Band TLV
+    auto tlvSupportedFreqBand = cmdu_tx.addClass<ieee1905_1::tlvSupportedFreqBand>();
+    if (!tlvSupportedFreqBand) {
+        LOG(ERROR) << "Failed addClass ieee1905_1::tlvSupportedFreqBand";
+        return false;
+    }
+    // According to the Multi-AP Specification Version 2.0 section 7.1
+    // Ragardless of what is sent here, the Agent will handle the Renew eitherway
+    tlvSupportedFreqBand->value() = ieee1905_1::tlvSupportedFreqBand::eValue(0);
+
+    if (multicast) {
+        LOG(INFO) << "Send multicast AP_AUTOCONFIGURATION_RENEW_MESSAGE";
+        return son_actions::send_cmdu_to_agent(network_utils::MULTICAST_1905_MAC_ADDR, cmdu_tx,
+                                               database);
+    }
+
+    // For unicast, use the same frame but reset the relay bit in flags.
+    cmdu_header->flags().relay_indicator = 0;
+    LOG(INFO) << "Send unicast AP_AUTOCONFIGURATION_RENEW_MESSAGE to agent " << dest_mac
+              << " (hop_count=" << get_agent_hop_count(database, dest_mac) << ")";
+    if (!son_actions::send_cmdu_to_agent(dest_mac, cmdu_tx, database)) {
+        LOG(ERROR) << "Failed to send unicast AP_AUTOCONFIGURATION_RENEW_MESSAGE to agent "
+                   << dest_mac;
+        return false;
+    }
+    return true;
+}
+
+bool son_actions::send_ap_config_renew_msg_farthest_first(ieee1905_1::CmduMessageTx &cmdu_tx,
+                                                           db &database)
+{
+    // Used exclusively by the CLI "trigger_ap_config_renew" command
+    // (ACTION_CLI_TRIGGER_AP_CONFIG_RENEW_REQUEST handler in son_management.cpp). All other
+    // Renew triggers keep using send_ap_config_renew_msg() above, unmodified.
+    //
+    // Create AP-Configuration renew message
+    auto cmdu_header =
+        cmdu_tx.create(0, ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE);
+    if (!cmdu_header) {
+        LOG(ERROR) << "Failed building IEEE1905 AP_AUTOCONFIGURATION_RENEW_MESSAGE";
+        return false;
+    }
+
+    // Add MAC address TLV
+    auto tlvAlMac = cmdu_tx.addClass<ieee1905_1::tlvAlMacAddress>();
+    if (!tlvAlMac) {
+        LOG(ERROR) << "Failed addClass ieee1905_1::tlvAlMacAddress";
+        return false;
+    }
+    tlvAlMac->mac() = database.get_local_bridge_mac();
+
+    // Add Supported-Role TLV
+    auto tlvSupportedRole = cmdu_tx.addClass<ieee1905_1::tlvSupportedRole>();
+    if (!tlvSupportedRole) {
+        LOG(ERROR) << "Failed addClass ieee1905_1::tlvSupportedRole";
+        return false;
+    }
+    tlvSupportedRole->value() = ieee1905_1::tlvSupportedRole::REGISTRAR;
+
+    // Add Supported-Frequency-Band TLV
+    auto tlvSupportedFreqBand = cmdu_tx.addClass<ieee1905_1::tlvSupportedFreqBand>();
+    if (!tlvSupportedFreqBand) {
+        LOG(ERROR) << "Failed addClass ieee1905_1::tlvSupportedFreqBand";
+        return false;
+    }
+    // According to the Multi-AP Specification Version 2.0 section 7.1
+    // Ragardless of what is sent here, the Agent will handle the Renew eitherway
+    tlvSupportedFreqBand->value() = ieee1905_1::tlvSupportedFreqBand::eValue(0);
+
+    bool ret = true;
+
+    // Unicast renew first, ordered farthest-from-controller to nearest, so that agents
+    // deepest in the multi-hop topology - whose config changes are most likely to cascade
+    // to their own children - get to react before nodes closer to the controller.
+    // Multicast (sent last, below) then acts as a reliability backstop for any agent that
+    // missed its unicast copy.
+    // For unicast, use the same frame but reset the relay bit in flags.
+    if (database.config.enable_unicast_renew) {
+        cmdu_header->flags().relay_indicator = 0;
+
+        for (const auto &agent_alid : son_actions::get_agents_farthest_to_nearest(database)) {
+            LOG(INFO) << "Send unicast AP_AUTOCONFIGURATION_RENEW_MESSAGE to agent "
+                       << agent_alid
+                       << " (hop_count=" << son_actions::get_agent_hop_count(database, agent_alid)
+                       << ")";
+            if (!son_actions::send_cmdu_to_agent(agent_alid, cmdu_tx, database)) {
+                LOG(ERROR) << "Failed to send unicast AP_AUTOCONFIGURATION_RENEW_MESSAGE to agent "
+                           << agent_alid;
+                ret = false;
+            }
+        }
+
+        // Restore the relay bit forced by create() for AP_AUTOCONFIGURATION_RENEW_MESSAGE
+        // before sending the multicast copy below.
+        cmdu_header->flags().relay_indicator = 1;
+    }
+
+    LOG(INFO) << "Send AP_AUTOCONFIGURATION_RENEW_MESSAGE";
+    ret = son_actions::send_cmdu_to_agent(network_utils::MULTICAST_1905_MAC_ADDR, cmdu_tx,
+                                       database) &&
+          ret;
+
+    // Notify HealthMonitoringTask (via db) that a Renew was just sent
+    database.notify_cmdu_sent(network_utils::MULTICAST_1905_MAC_ADDR,
+                              static_cast<uint16_t>(ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_RENEW_MESSAGE));
+
+    return ret;
+}
+#endif
