+#ifndef _AP_CONFIG_RENEW_SEQUENCER_TASK_H_
+#define _AP_CONFIG_RENEW_SEQUENCER_TASK_H_
+
+#include "../db/db.h"
+#include "task.h"
+#include "task_pool.h"
+
+#include <vector>
+
+#ifdef USE_PRPLMESH_WHM
+namespace son {
+
+/**
+ * @brief Paces out the CLI "trigger_ap_config_renew" sequence: unicasts the
+ *        AP-Configuration Renew to remote agents one at a time, farthest-from-controller
+ *        first, giving each up to AGENT_M2_TIMEOUT_MS to complete its M1/M2 exchange before
+ *        moving to the next-nearest agent. Once every remote agent has been unicast to, it
+ *        sends the multicast Renew as a reliability backstop, waits
+ *        AFTER_MULTICAST_WAIT_MS, and only then unicasts the Renew to the local/co-located
+ *        agent (database.get_local_bridge_mac()) - deliberately last, so the local agent
+ *        reconfigures only after every other agent in the topology already has.
+ */
+class ap_config_renew_sequencer_task : public task {
+public:
+    ap_config_renew_sequencer_task(
+        db &database_, ieee1905_1::CmduMessageTx &cmdu_tx_, task_pool &tasks_,
+        const std::string &task_name_ = std::string("ap_config_renew_sequencer_task"));
+    virtual ~ap_config_renew_sequencer_task() {}
+
+    enum eEvent {
+        M2_SENT = 0,
+    };
+
+protected:
+    virtual void work() override;
+    virtual void handle_event(int event_type, void *obj) override;
+    virtual void handle_events_timeout(std::multiset<int> pending_events) override;
+    virtual void handle_task_end() override;
+
+private:
+    const int AGENT_M2_TIMEOUT_MS     = 4000;
+    const int AFTER_MULTICAST_WAIT_MS = 4000;
+
+    enum states {
+        SEND_NEXT_UNICAST = 0,
+        WAIT_FOR_AGENT,
+        SEND_MULTICAST,
+        WAIT_AFTER_MULTICAST,
+        SEND_LOCAL,
+        DONE,
+    };
+
+    db &database;
+    ieee1905_1::CmduMessageTx &cmdu_tx;
+    task_pool &tasks;
+
+    int state = SEND_NEXT_UNICAST;
+
+    std::vector<sMacAddr> agents;
+    size_t next_agent_idx = 0;
+    sMacAddr agent_awaiting_m2;
+};
+
+} // namespace son
+#endif
