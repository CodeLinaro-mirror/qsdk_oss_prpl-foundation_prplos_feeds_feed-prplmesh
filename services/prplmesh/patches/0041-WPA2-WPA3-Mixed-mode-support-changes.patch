From 10fb061a75cb9622970b4883b9beaa9b81eb52e9 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Tue, 13 Jan 2026 14:22:14 +0530
Subject: [PATCH 41/49] WPA2-WPA3 Mixed mode support changes

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
index 84aa01836..5489e9436 100644
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -53,6 +53,8 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
             return WSC::eWscAuth::WSC_AUTH_WPA2PSK;
         } else if ("sae" == encryption) {
             return WSC::eWscAuth::WSC_AUTH_SAE;
+        } else if ("sae-mixed" == encryption) {
+            return static_cast<WSC::eWscAuth>(WSC::eWscAuth::WSC_AUTH_SAE|WSC::eWscAuth::WSC_AUTH_WPA2PSK);
         }
         return WSC::eWscAuth::WSC_AUTH_INVALID;
     };
@@ -64,7 +66,7 @@ static bool bpl_cfg_get_bss_configuration(const std::string &section_name,
         } else if (contains("+tkip", encryption)) {
             return WSC::eWscEncr::WSC_ENCR_TKIP;
         } else if (("psk2" == encryption) || ("sae" == encryption) ||
-                   contains("+aes", encryption) || contains("+ccmp", encryption)) {
+                   contains("+aes", encryption) || contains("+ccmp", encryption) || ("sae-mixed" == encryption)) {
             return WSC::eWscEncr::WSC_ENCR_AES;
         }
         return WSC::eWscEncr::WSC_ENCR_INVALID;
@@ -457,6 +459,8 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 			    }
 		    } else if (authentication_type == WSC::eWscAuth::WSC_AUTH_SAE) {
 			    encryption = "sae";
+		    } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE|WSC::eWscAuth::WSC_AUTH_WPA2PSK)) {
+			    encryption = "sae-mixed";
 		    }
 		    return encryption;
 	    };
@@ -467,6 +471,9 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
 		    options["sae_pwe"] = "2";
             options["sae"] = "1";
 	    }
+        if (options["encryption"] == "sae-mixed") {
+                    options["sae_pwe"] = "2";
+            }
 	    options["key"] = configuration.network_key;
     	    options["ifname"] = iface;
     	    options["mode"] = "ap";
@@ -538,6 +545,8 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
                 }
             } else if (authentication_type == WSC::eWscAuth::WSC_AUTH_SAE) {
                 encryption = "sae";
+            } else if (authentication_type == (WSC::eWscAuth::WSC_AUTH_SAE|WSC::eWscAuth::WSC_AUTH_WPA2PSK)) {
+                encryption = "sae-mixed";
             }
             return encryption;
         };
@@ -587,6 +596,9 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
                 options["sae_pwe"] = "2";
                 options["sae"] = "1";
             }
+            if (options["encryption"] == "sae-mixed") {
+                options["sae_pwe"] = "2";
+            }
 
             options["key"] = config.network_key;
             options["ifname"] = iface;
@@ -642,6 +654,9 @@ bool bpl_cfg_set_wifi_credentials(const std::string &iface,
             mldOptions["sae_pwe"] = "2"; 
             mldOptions["sae"] = "1";
         }
+        if (mldOptions["encryption"] == "sae-mixed") {
+            mldOptions["sae_pwe"] = "2";
+        }
         mldOptions["key"] = configuration.network_key;
         mldOptions["ifname"] = iface;
         if(!configuration.multi_ap.empty()) {
-- 
