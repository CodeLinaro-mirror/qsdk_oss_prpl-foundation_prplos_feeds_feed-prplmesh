From 4f1ea2e8e04bddccd8cef42ea68ff0bfea62dbcb Mon Sep 17 00:00:00 2001
From: nushanth <nushanth@qti.qualcomm.com>
Date: Mon, 26 Oct 2026 17:38:50 +0530
Subject: [PATCH] backhaul_manager: recover backhaul FSM stuck in OPERATIONAL

Fix for missed-disconnect event in WHM_HAL and bml_conn_map
issue POST Wired to Wireless Switching

Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 .../backhaul_manager/backhaul_manager.cpp     | 15 +++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 7a50f4d..be52e3e 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1518,12 +1518,7 @@ bool BackhaulManager::backhaul_fsm_main(bool &skip_select)

                             reset_1905_security_for_connection_switch();

-                            // Don't restart FSM, stay in current state to allow reconnection.
-                            break;
                         }
-
-                        LOG(ERROR) << "Cannot switch to wireless backhaul in place: no valid STA "
-                                      "radio is available in AgentDB; restarting wireless FSM";
                     }
                 }
 
@@ -3634,6 +3636,16 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
             }
             m_task_pool.send_event(eTaskType::TOPOLOGY, TopologyTask::eEvent::AGENT_RADIO_STATE_CHANGED);
         }
+#if defined(USE_PRPLMESH_WHM)
+        else if (FSM_IS_IN_STATE(OPERATIONAL) &&
+                 db->backhaul.connection_type == AgentDB::sBackhaul::eConnectionType::Wireless &&
+                 db->backhaul.selected_iface_name == iface) {
+            LOG(INFO) << "Connected event on iface=" << iface
+                      << " while FSM already OPERATIONAL with no prior Disconnected event"
+                         " - treating as a missed-disconnect reconnect";
+            FSM_MOVE_STATE(CONNECTED);
+        }
+#endif
     } break;
 
     case Event::Disconnected: {
-- 
2.34.1

