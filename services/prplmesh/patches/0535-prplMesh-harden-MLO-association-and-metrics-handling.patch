+static constexpr const char *ASSOC_FRAMES_DB_LOCK_PATH = "/tmp/beerocks/sta_assoc_frames.lock";
+static constexpr const char *ASSOC_FRAMES_DB_DIR_PATH  = "/tmp/beerocks";
+
+class DbLock {
+public:
+    DbLock() : m_fd(::open(ASSOC_FRAMES_DB_LOCK_PATH, O_CREAT | O_RDWR | O_CLOEXEC, 0644))
+    {
+        if (m_fd < 0) {
+            LOG(ERROR) << "assoc frame DB: failed to open lock file "
+                       << ASSOC_FRAMES_DB_LOCK_PATH << ": " << std::strerror(errno);
+            return;
+        }
+        int result;
+        do {
+            result = ::flock(m_fd, LOCK_EX);
+        } while (result < 0 && errno == EINTR);
+        if (result < 0) {
+            LOG(ERROR) << "assoc frame DB: failed to lock " << ASSOC_FRAMES_DB_LOCK_PATH
+                       << ": " << std::strerror(errno);
+            ::close(m_fd);
+            m_fd = -1;
+            return;
+        }
+        m_locked = true;
+    }
+
+    ~DbLock()
+    {
+        if (m_fd < 0) return;
+        if (m_locked && ::flock(m_fd, LOCK_UN) < 0) {
+            LOG(ERROR) << "assoc frame DB: failed to unlock " << ASSOC_FRAMES_DB_LOCK_PATH
+                       << ": " << std::strerror(errno);
+        }
+        ::close(m_fd);
+    }
+
+    bool acquired() const { return m_locked; }
+    DbLock(const DbLock &)            = delete;
+    DbLock &operator=(const DbLock &) = delete;
+
+private:
+    int  m_fd     = -1;
+    bool m_locked = false;
+};
+
+static std::string assoc_frame_bytes_to_hex(const std::vector<uint8_t> &bytes)
+{
+    std::ostringstream hex;
+    for (uint8_t byte : bytes) {
+        hex << std::hex << std::setw(2) << std::setfill('0') << static_cast<int>(byte);
+    }
+    return hex.str();
+}
+
+static bool write_all(int fd, const std::string &data)
+{
+    size_t offset = 0;
+    while (offset < data.size()) {
+        const ssize_t written = ::write(fd, data.data() + offset, data.size() - offset);
+        if (written < 0 && errno == EINTR) continue;
+        if (written <= 0) return false;
+        offset += static_cast<size_t>(written);
+    }
+    return true;
+}
+
+static bool write_assoc_frame_db_atomic(const std::vector<std::string> &lines)
+{
+    char tmp_path[] = "/tmp/beerocks/sta_assoc_frames.txt.XXXXXX";
+    const int fd     = ::mkstemp(tmp_path);
+    if (fd < 0) {
+        LOG(ERROR) << "assoc frame DB: failed to create temporary file: "
+                   << std::strerror(errno);
+        return false;
+    }
+
+    std::string contents;
+    for (const auto &line : lines) {
+        contents += line;
+        contents.push_back('\n');
+    }
+
+    bool success = write_all(fd, contents);
+    if (success && ::fsync(fd) < 0) {
+        LOG(ERROR) << "assoc frame DB: failed to sync temporary file: "
+                   << std::strerror(errno);
+        success = false;
+    }
+    if (::close(fd) < 0) success = false;
+    if (!success) {
+        ::unlink(tmp_path);
+        return false;
+    }
+
+    if (::rename(tmp_path, ASSOC_FRAMES_DB_PATH) < 0) {
+        LOG(ERROR) << "assoc frame DB: failed to replace database: "
+                   << std::strerror(errno);
+        ::unlink(tmp_path);
+        return false;
+    }
+
+    const int dir_fd = ::open(ASSOC_FRAMES_DB_DIR_PATH, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dir_fd < 0) {
+        LOG(ERROR) << "assoc frame DB: failed to open database directory for sync: "
+                   << std::strerror(errno);
+        return false;
+    }
+    const bool dir_synced = (::fsync(dir_fd) == 0);
+    if (!dir_synced) {
+        LOG(ERROR) << "assoc frame DB: failed to sync database directory: "
+                   << std::strerror(errno);
+    }
+    ::close(dir_fd);
+    return dir_synced;
+}
+
+static bool decode_assoc_frame_hex(const std::string &hex_str, std::vector<uint8_t> &out)
+{
+    auto nibble = [](char c) -> int {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+    };
+    out.clear();
+    if (hex_str.empty() || hex_str.size() % 2) return false;
+    out.reserve(hex_str.size() / 2);
+    for (size_t i = 0; i < hex_str.size(); i += 2) {
+        const int hi = nibble(hex_str[i]);
+        const int lo = nibble(hex_str[i + 1]);
+        if (hi < 0 || lo < 0) {
+            out.clear();
+            return false;
+        }
+        out.push_back(static_cast<uint8_t>((hi << 4) | lo));
+    }
+    return true;
+}
+
+} // namespace
+
+bool persist_assoc_frame(const std::string &sta_mac, const std::vector<uint8_t> &frame)
+{
+    DbLock db_lock;
+    if (!db_lock.acquired()) return false;
+
+    std::vector<std::string> lines;
+    std::ifstream ifs(ASSOC_FRAMES_DB_PATH);
+    if (ifs) {
+        std::string line;
+        while (std::getline(ifs, line)) {
+            if (line.empty()) continue;
+            std::istringstream ss(line);
+            std::string mac;
+            ss >> mac;
+            if (mac != sta_mac) lines.push_back(line);
+        }
+    }
+    lines.push_back(sta_mac + " " + assoc_frame_bytes_to_hex(frame));
+    if (!write_assoc_frame_db_atomic(lines)) {
+        LOG(ERROR) << "Failed to persist assoc frame for " << sta_mac;
+        return false;
+    }
+    LOG(DEBUG) << "Persisted assoc frame for " << sta_mac << " (" << frame.size()
+               << " bytes) to " << ASSOC_FRAMES_DB_PATH;
+    return true;
+}
+
+bool remove_assoc_frame(const std::string &sta_mac)
+{
+    DbLock db_lock;
+    if (!db_lock.acquired()) return false;
+
+    std::ifstream ifs(ASSOC_FRAMES_DB_PATH);
+    if (!ifs) return true;
+    std::vector<std::string> lines;
+    std::string line;
+    bool removed = false;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) continue;
+        std::istringstream ss(line);
+        std::string mac;
+        ss >> mac;
+        if (mac == sta_mac) {
+            removed = true;
+        } else {
+            lines.push_back(line);
+        }
+    }
+    if (!removed) return true;
+    if (!write_assoc_frame_db_atomic(lines)) {
+        LOG(ERROR) << "Failed to remove persisted assoc frame for " << sta_mac;
+        return false;
+    }
+    LOG(DEBUG) << "Removed persisted assoc frame for " << sta_mac << " from "
+               << ASSOC_FRAMES_DB_PATH;
+    return true;
+}
+
+bool extract_mld_mac_from_assoc_frame(const std::vector<uint8_t> &frame,
+                                      std::string &mld_mac_out)
+{
+    static constexpr uint8_t IE_ID_EXTENSION     = 255;
+    static constexpr uint8_t IE_EXT_MULTI_LINK   = 107;
+    static constexpr size_t MLE_MLCTRL_OFFSET    = 1;
+    static constexpr size_t MLE_CINFO_LEN_OFFSET = 3;
+    static constexpr size_t MLE_CINFO_MAC_OFFSET = 4;
+    static constexpr size_t MLE_CINFO_MIN_LEN    = 7;
+    static constexpr uint16_t candidate_offsets[] = {4, 10};
+
+    size_t best_offset = 4;
+    int best_count     = -1;
+    for (uint16_t offset : candidate_offsets) {
+        if (frame.size() <= static_cast<size_t>(offset) + 2) continue;
+        size_t pos = offset;
+        int count  = 0;
+        while (pos + 2 <= frame.size()) {
+            const uint8_t element_len = frame[pos + 1];
+            if (pos + 2 + element_len > frame.size()) break;
+            ++count;
+            pos += 2 + element_len;
+        }
+        if (count > best_count) {
+            best_count  = count;
+            best_offset = offset;
+        }
+    }
+
+    size_t pos         = best_offset;
+    const uint8_t *mle = nullptr;
+    size_t mle_len     = 0;
+    while (pos + 2 <= frame.size()) {
+        const uint8_t id           = frame[pos];
+        const uint8_t element_len  = frame[pos + 1];
+        if (pos + 2 + element_len > frame.size()) break;
+        if (id == IE_ID_EXTENSION && element_len >= 1 && frame[pos + 2] == IE_EXT_MULTI_LINK) {
+            mle     = frame.data() + pos + 2;
+            mle_len = element_len;
+            break;
+        }
+        pos += 2 + element_len;
+    }
+    if (!mle || mle_len < MLE_CINFO_MAC_OFFSET + 6 ||
+        (mle[MLE_MLCTRL_OFFSET] & 0x07) != 0 ||
+        mle[MLE_CINFO_LEN_OFFSET] < MLE_CINFO_MIN_LEN) {
+        return false;
+    }
+
+    char mac_buf[18];
+    std::snprintf(mac_buf, sizeof(mac_buf), "%02x:%02x:%02x:%02x:%02x:%02x",
+                  mle[MLE_CINFO_MAC_OFFSET], mle[MLE_CINFO_MAC_OFFSET + 1],
+                  mle[MLE_CINFO_MAC_OFFSET + 2], mle[MLE_CINFO_MAC_OFFSET + 3],
+                  mle[MLE_CINFO_MAC_OFFSET + 4], mle[MLE_CINFO_MAC_OFFSET + 5]);
+    mld_mac_out = mac_buf;
+    return true;
+}
+
+std::vector<uint8_t> restore_assoc_frame_from_db(const std::string &sta_mac)
+{
+    std::ifstream ifs(ASSOC_FRAMES_DB_PATH);
+    if (!ifs) return {};
+    std::vector<uint8_t> valid_frame;
+    std::string line;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) continue;
+        std::istringstream ss(line);
+        std::string mac, hex_str;
+        ss >> mac >> hex_str;
+        if (mac != sta_mac) continue;
+        std::vector<uint8_t> frame;
+        if (!decode_assoc_frame_hex(hex_str, frame)) {
+            LOG(WARNING) << "assoc frame DB: corrupt entry for " << mac << ", skipping";
+            continue;
+        }
+        valid_frame = std::move(frame);
+    }
+    return valid_frame;
+}
+
+std::vector<uint8_t> restore_assoc_frame_from_db_by_mld_mac(const std::string &mld_mac)
+{
+    std::ifstream ifs(ASSOC_FRAMES_DB_PATH);
+    if (!ifs) return {};
+    std::string line;
+    while (std::getline(ifs, line)) {
+        if (line.empty()) continue;
+        std::istringstream ss(line);
+        std::string mac, hex_str;
+        ss >> mac >> hex_str;
+        if (mac.empty() || hex_str.empty()) continue;
+        std::vector<uint8_t> frame;
+        if (!decode_assoc_frame_hex(hex_str, frame)) {
+            LOG(WARNING) << "assoc frame DB: corrupt entry for " << mac << ", skipping";
+            continue;
+        }
+        std::string candidate_mld_mac;
+        if (extract_mld_mac_from_assoc_frame(frame, candidate_mld_mac) &&
+            candidate_mld_mac == mld_mac) {
+            return frame;
+        }
+    }
+    return {};
+}
