From 0aacd3a541ea89799074e271ee2313979983640b Mon Sep 17 00:00:00 2001
From: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
Date: Thu, 9 Jul 2026 18:58:32 +0530
Subject: [PATCH 263/265] traffic separation: r1 capability config and policy
 TLV storage

Report the custom-traffic-separation capability bit in the Profile-2 AP
Capability TLV based on the agent's configured is_custom_ts_enabled flag,
and persist the per-SSID traffic separation configs derived when building
the outgoing Traffic Separation Policy TLV so they are available via
db::get_traffic_separation_configuration() elsewhere (e.g. BML reporting).

Also fix the SEND_AP_AUTOCONFIGURATION_WSC_M1 state's TS VLAN-readiness
gate to skip wired backhaul: that gate holds M1 until the TS VLAN
interface is created (ts_applied) so the early AP capability report can
reach the controller before M1, letting the controller include MLO
configuration in M2. For wired backhaul, the parent trunk is an Ethernet
interface which does not get its own private VLAN subinterface (see
TrunkPortPlumbing8021q::apply(): only wireless trunks do), so ts_applied
is state that TS VLAN plumbing never needs to set on that path, and
gating M1 on it would stall the FSM. Excluded via
db->backhaul.connection_type != AgentDB::sBackhaul::eConnectionType::Wired.

Read via bpl::cfg_get_is_traffic_separation_enabled()/bpl_cfg.h, which is
implemented for both the UCI/OpenWrt backend (bpl/cfg/uci/bpl_cfg.cpp) and
the pwhm/Ambiorix data-model backend (bpl/cfg/dm/bpl_cfg.cpp via
read_controller_config_param("TrafficSeparation.Enable", ...)), so this
capability reporting works on both platforms without additional pwhm-side
changes.

Signed-off-by: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
---
 agent/src/beerocks/slave/agent_db.h                         | 1 +
 agent/src/beerocks/slave/beerocks_agent_main.cpp            | 6 ++++++
 .../src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp  | 6 +++++-
 .../src/beerocks/slave/tasks/capability_reporting_task.cpp  | 3 +++
 .../src/beerocks/master/tasks/agent_monitoring_task.cpp     | 5 +++++
 5 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/agent_db.h b/agent/src/beerocks/slave/agent_db.h
index d7410a9af..7f5ca4c1a 100644
--- a/agent/src/beerocks/slave/agent_db.h
+++ b/agent/src/beerocks/slave/agent_db.h
@@ -196,6 +196,7 @@ public:
             eUnsupportedProfileDisallowPolicy::NO_OVERRIDE;
         bool ts_bridge_mapping_enabled  = false;
         bool ts_persistence_enabled     = false;
+        bool is_custom_ts_enabled       = false;
 
         /**
          * @brief Flag to enable FH VAPs state control.
diff --git a/agent/src/beerocks/slave/beerocks_agent_main.cpp b/agent/src/beerocks/slave/beerocks_agent_main.cpp
index 20e897cbe..5879797ed 100644
--- a/agent/src/beerocks/slave/beerocks_agent_main.cpp
+++ b/agent/src/beerocks/slave/beerocks_agent_main.cpp
@@ -820,6 +820,12 @@ static int run_beerocks_slave(beerocks::config_file::sConfigSlave &beerocks_slav
                 db->device_conf.ts_persistence_enabled = uci_enabled;
             }
         }
+        {
+            bool ts_enabled = false;
+            if (beerocks::bpl::cfg_get_is_traffic_separation_enabled(ts_enabled)) {
+                db->device_conf.is_custom_ts_enabled = ts_enabled;
+            }
+        }
         db->init_data_model(amb_dm_obj);
 
         auto management_mode = beerocks::bpl::cfg_get_management_mode();
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 6bb960be4..9c63a0364 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -454,7 +454,8 @@ void ApAutoConfigurationTask::work()
             // hold M1 here. The early AP capability report must reach the controller
             // before M1 so it can include MLO configuration in M2; gating M1 on
             // ts_applied guarantees the order: VLAN creation → early AP cap → M1.
-            if (db->traffic_separation.primary_vlan_id != 0 && !db->traffic_separation.ts_applied) {
+            if (db->backhaul.connection_type != AgentDB::sBackhaul::eConnectionType::Wired &&
+                db->traffic_separation.primary_vlan_id != 0 && !db->traffic_separation.ts_applied) {
                 LOG(DEBUG) << "Waiting for TS VLAN interface before sending M1 for " << radio_iface;
                 break;
             }
@@ -1260,6 +1261,9 @@ bool ApAutoConfigurationTask::send_ap_autoconfiguration_wsc_m1_message(
         profile2_ap_capability_tlv->max_total_number_of_vids() =
             db->traffic_separation.max_number_of_vlans_ids;
 
+        profile2_ap_capability_tlv->capabilities_bit_field().traffic_separation =
+            db->device_conf.is_custom_ts_enabled ? 1 : 0;
+
         /* One AP Radio Advanced Capabilities TLV */
         auto ap_radio_advanced_capabilities_tlv =
             m_cmdu_tx.addClass<wfa_map::tlvProfile2ApRadioAdvancedCapabilities>();
diff --git a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
index 1c9d39015..675724f99 100644
--- a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
+++ b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
@@ -1335,6 +1335,9 @@ bool CapabilityReportingTask::add_profile2_ap_capability_tlv(ieee1905_1::CmduMes
     profile2_ap_capability_tlv->max_total_number_of_vids() =
         db->traffic_separation.max_number_of_vlans_ids;
 
+    profile2_ap_capability_tlv->capabilities_bit_field().traffic_separation =
+        db->device_conf.is_custom_ts_enabled ? 1 : 0;
+
     profile2_ap_capability_tlv->max_prioritization_rules() =
         db->device_conf.max_prioritization_rules;
     profile2_ap_capability_tlv->capabilities_bit_field().prioritization =
diff --git a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
index dde3de28d..44d7cad3b 100644
--- a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
+++ b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
@@ -926,6 +926,11 @@ bool agent_monitoring_task::add_traffic_separation_policy_tlv(db &database,
             database.get_bss_info_configuration(al_mac), private_vid, guest_vid);
         if (traffic_separation_configs.empty()) {
             LOG(WARNING) << "No fronthaul SSIDs found for custom TrafficSeparation policy";
+        } else {
+            database.clear_traffic_separation_configurations(al_mac);
+            for (const auto &config : traffic_separation_configs) {
+                database.add_traffic_separation_configuration(al_mac, config);
+            }
         }
     }
 
