+
 private:
     /**
      * @brief Handles the client-connected event in the CMDU server.
@@ -672,6 +689,32 @@ private:
     bool handle_tlv_wifi7_agent_capabilities(ieee1905_1::CmduMessageRx &cmdu_rx,
                                              std::shared_ptr<Agent> agent);
 
+    /**
+     * @brief Get info from 'WIFI8 Agent Capabilities' TLV (wfa_map::tlvWifi8AgentCapabilities),
+     * and update the Controller-DB MAPC sharing-BSSID structures for radios that report
+     * Co-TDMA support (flags1().coord_tdma_support).
+     *
+     * For each radio that reports Co-TDMA support:
+     *  - Every fronthaul BSSID of that radio becomes a "sharing BSSID" entry for this Agent
+     *    (Agent::sRadio::sBss::mapc_sharing_bss), with mapc_capability_bitmap set to CO_TDMA
+     *    and discovery/negotiation state (re)initialized for its candidate shared BSSIDs.
+     *  - Every fronthaul BSSID belonging to OTHER Agents' radios operating on the same
+     *    frequency band becomes a candidate "shared BSSID" for that sharing BSSID
+     *    (discovery_status=PENDING, negotiation_status=IDLE).
+     *  - Symmetrically, this Agent's new sharing BSSIDs are added to the shared-BSSID list
+     *    of any other Agent's existing sharing BSSIDs on the same band.
+     *
+     * After updating the DB, sends MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE (with
+     * TLV_MAPC_CONFIGURATION_POLICY) to this Agent and to every other Agent whose
+     * shared-BSSID list was updated as a result.
+     *
+     * @param cmdu_rx AP Capability Report message.
+     * @param agent shared ptr of agent sending the message.
+     * @return True on success, false otherwise.
+    */
+    bool handle_tlv_wifi8_agent_capabilities(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                             std::shared_ptr<Agent> agent);
+
     /**
      * @brief Get info from 'EHT Operations' TLV,
      * set data to EHT Operatons data element.
diff --git a/controller/src/beerocks/master/db/agent.h b/controller/src/beerocks/master/db/agent.h
index 96d336be3..1b9efa85c 100644
--- a/controller/src/beerocks/master/db/agent.h
+++ b/controller/src/beerocks/master/db/agent.h
@@ -568,6 +568,68 @@ public:
                 bool eht_default_pe_duration = false;
             } eht_operations;
 
+            /**
+             * @brief MAPC (Multi-AP Coordination) / Co-TDMA sharing state for this BSS,
+             * when this BSS is used as a "sharing BSSID".
+             *
+             * Populated when the owning Agent reports Wi-Fi 8 (802.11bn) capabilities with
+             * Co-TDMA support (wfa_map::tlvWifi8AgentCapabilities, flags1().coord_tdma_support)
+             * in an AP_CAPABILITY_REPORT_MESSAGE, for a Co-TDMA-capable radio's fronthaul BSS.
+             * Such a BSS becomes a "sharing BSSID", and maintains a list of "shared BSSID"
+             * candidates — BSSIDs belonging to OTHER Agents operating on the same frequency
+             * band — together with their MAPC discovery/negotiation state.
+             *
+             * Structure:
+             *   sBss -> mapc_sharing_bss -> { mapc_capability_bitmap, cotdma_profile,
+             *                                  shared_bssid -> { mapc_capability_bitmap,
+             *                                                    discovery_status,
+             *                                                    negotiation_status } }
+             */
+            struct sMapcSharedBss {
+                /** MAPC capability bitmap reported for the shared (peer) BSSID
+                 *  (see wfa_map::eMapcCapabilityBit). */
+                uint16_t mapc_capability_bitmap = 0;
+
+                enum class eDiscoveryStatus : uint8_t { PENDING = 0, DISCOVERED = 1 };
+                enum class eNegotiationStatus : uint8_t {
+                    IDLE              = 0,
+                    ESTABLISH_PENDING = 1,
+                    ESTABLISHED       = 2,
+                    TEARDOWN_PENDING  = 3,
+                    TORN              = 4,
+                };
+
+                eDiscoveryStatus discovery_status     = eDiscoveryStatus::PENDING;
+                eNegotiationStatus negotiation_status = eNegotiationStatus::IDLE;
+            };
+
+            struct sMapcSharingBss {
+                /** True once this BSS has actually been established/reported as a MAPC
+                 *  sharing BSSID (either via Wi-Fi 8 Co-TDMA capability report, or via a
+                 *  MAPC Capability Update TLV naming this BSSID as local_bssid). The other
+                 *  fields of this struct are only meaningful when is_valid is true. */
+                bool is_valid = false;
+
+                /** MAPC capability bitmap of this local (sharing) BSSID — set to Co-TDMA once
+                 *  Wi-Fi 8 capabilities with Co-TDMA support are received for the owning radio. */
+                uint16_t mapc_capability_bitmap = 0;
+
+                /** Co-TDMA profile (802.11 Co-TDMA Info/BW/CCFS/BSS-color etc.), mirroring
+                 *  wfa_map::sMapcBssCapability::ctdma_profile. Zero-initialized until an actual
+                 *  profile is learned via MAPC discovery/negotiation with a peer. */
+                uint64_t cotdma_profile    = 0;
+                uint8_t cotdma_profile_len = 0;
+
+                /** Candidate shared (peer) BSSIDs for MAPC discovery/negotiation with this
