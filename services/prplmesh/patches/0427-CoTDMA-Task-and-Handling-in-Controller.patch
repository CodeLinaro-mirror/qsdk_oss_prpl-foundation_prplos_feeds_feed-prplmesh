+#if defined(IEEE80211_BN)
+bool Controller::handle_tlv_wifi8_agent_capabilities(ieee1905_1::CmduMessageRx &cmdu_rx,
+                                                     std::shared_ptr<Agent> agent)
+{
+    auto wifi8_agt_caps_tlv = cmdu_rx.getClass<wfa_map::tlvWifi8AgentCapabilities>();
+    if (!wifi8_agt_caps_tlv) {
+        LOG(DEBUG) << "No WiFi 8 Agent Capabilities TLV in AP Capability Report";
+        return true;
+    }
+
+    if (!agent) {
+        LOG(ERROR) << "handle_tlv_wifi8_agent_capabilities: agent is null";
+        return false;
+    }
+
+    // Set of Agents whose shared_bssids list was updated as a result of processing this
+    // Agent's new sharing BSSIDs, so we know which OTHER Agents need to receive an updated
+    // MAPC Configuration Policy TLV.
+    std::set<sMacAddr> other_agents_to_update;
+
+    bool any_cotdma_radio = false;
+
+    for (size_t i = 0; i < wifi8_agt_caps_tlv->num_radio(); i++) {
+        auto result = wifi8_agt_caps_tlv->radio_wifi8_capabilities(i);
+        if (!std::get<0>(result)) {
+            LOG(ERROR) << "Failed to get radio_wifi8_capabilities entry " << i;
+            continue;
+        }
+        auto &radio_cap = std::get<1>(result);
+
+        if (!radio_cap.flags1().coord_tdma_support) {
+            continue; // radio does not support Co-TDMA
+        }
+        any_cotdma_radio = true;
+
+        const sMacAddr &ruid = radio_cap.ruid();
+        auto radio           = agent->radios.get(ruid);
+        if (!radio) {
+            LOG(WARNING) << "handle_tlv_wifi8_agent_capabilities: no radio found for ruid="
+                         << ruid << " on agent " << agent->al_mac;
+            continue;
+        }
+
+        const beerocks::eFreqType radio_band = radio->band;
+
+        // Gather this radio's fronthaul BSSes — each becomes a sharing BSSID for this Agent.
+        std::vector<std::shared_ptr<Agent::sRadio::sBss>> sharing_bsses_this_radio;
+        for (const auto &bss_entry : radio->bsses) {
+            if (!bss_entry.second || !bss_entry.second->fronthaul) {
+                continue;
+            }
+            sharing_bsses_this_radio.push_back(bss_entry.second);
+        }
+
+        for (const auto &sharing_bss : sharing_bsses_this_radio) {
+            const sMacAddr &sharing_bssid = sharing_bss->bssid;
+            auto &sharing_entry           = sharing_bss->mapc_sharing_bss;
+            sharing_entry.is_valid        = true;
+            sharing_entry.mapc_capability_bitmap =
+                static_cast<uint16_t>(wfa_map::eMapcCapabilityBit::CO_TDMA);
+            // cotdma_profile is populated later via MAPC discovery/negotiation with a peer;
+            // this TLV does not carry the actual Co-TDMA profile bits, so it is left at its
+            // zero-initialized default here.
+
+            // Populate shared_bssids with all BSSIDs from OTHER Agents on the same
+            // frequency band, and, symmetrically, register this sharing_bssid as a shared
+            // BSSID under any of those other Agents' own (already Co-TDMA capable) sharing
+            // BSSes.
+            for (auto &other_agent_pair : database.m_agents) {
+                auto &other_agent = other_agent_pair.second;
+                if (!other_agent || other_agent->al_mac == agent->al_mac) {
+                    continue;
+                }
+                for (auto &other_radio_pair : other_agent->radios) {
+                    auto &other_radio = other_radio_pair.second;
+                    if (!other_radio || other_radio->band != radio_band) {
+                        continue;
+                    }
+                    for (auto &other_bss_pair : other_radio->bsses) {
+                        auto &other_bss = other_bss_pair.second;
+                        if (!other_bss || !other_bss->fronthaul) {
+                            continue;
+                        }
+                        const sMacAddr &shared_bssid = other_bss_pair.first;
+
+                        // Add/refresh the shared BSSID entry under this Agent's sharing BSSID.
+                        auto &shared_entry = sharing_entry.shared_bssids[shared_bssid];
+                        shared_entry.discovery_status =
+                            Agent::sRadio::sBss::sMapcSharedBss::eDiscoveryStatus::PENDING;
+                        shared_entry.negotiation_status =
+                            Agent::sRadio::sBss::sMapcSharedBss::eNegotiationStatus::IDLE;
+
+                        // Symmetric update: if the other Agent's BSS is itself already a
+                        // sharing BSSID (it previously reported Wi-Fi 8 Co-TDMA capability),
+                        // add the current Agent's sharing BSSID to ITS shared_bssids list.
+                        if (other_bss->mapc_sharing_bss.is_valid) {
+                            auto &other_shared_entry =
+                                other_bss->mapc_sharing_bss.shared_bssids[sharing_bssid];
+                            other_shared_entry.discovery_status =
+                                Agent::sRadio::sBss::sMapcSharedBss::eDiscoveryStatus::PENDING;
+                            other_shared_entry.negotiation_status =
+                                Agent::sRadio::sBss::sMapcSharedBss::eNegotiationStatus::IDLE;
+                            other_agents_to_update.insert(other_agent->al_mac);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    if (!any_cotdma_radio) {
+        LOG(DEBUG) << "handle_tlv_wifi8_agent_capabilities: no radio reports Co-TDMA support "
+                      "for agent "
+                   << agent->al_mac;
+        return true;
+    }
+
+    // Send MAPC Configuration Policy to this Agent, with the complete (updated) list of
+    // sharing BSSIDs.
+    if (!send_mapc_configuration_policy(agent->al_mac)) {
+        LOG(ERROR) << "Failed sending MAPC Configuration Policy to agent " << agent->al_mac;
+    }
+
+    // Send MAPC Configuration Policy to every other Agent whose shared_bssids list was
+    // updated as a result of processing this Agent's Co-TDMA capability report.
+    for (const auto &other_al_mac : other_agents_to_update) {
+        if (!send_mapc_configuration_policy(other_al_mac)) {
+            LOG(ERROR) << "Failed sending MAPC Configuration Policy to agent " << other_al_mac;
+        }
+    }
+
+    return true;
+}
+#endif /* defined(IEEE80211_BN) */
+
+bool Controller::send_mapc_configuration_policy(const sMacAddr &agent_mac)
+{
+    auto agent = database.m_agents.get(agent_mac);
+    if (!agent) {
+        LOG(ERROR) << "send_mapc_configuration_policy: agent " << agent_mac << " not found";
+        return false;
+    }
+
+    // Collect all BSSes on this Agent that are active MAPC sharing BSSIDs (i.e. have a
+    // non-zero mapc_capability_bitmap set on their mapc_sharing_bss member).
+    std::vector<std::shared_ptr<Agent::sRadio::sBss>> sharing_bsses;
+    for (auto &radio_pair : agent->radios) {
+        auto &radio = radio_pair.second;
+        if (!radio) {
+            continue;
+        }
+        for (auto &bss_pair : radio->bsses) {
+            auto &bss = bss_pair.second;
+            if (bss && bss->mapc_sharing_bss.mapc_capability_bitmap != 0) {
+                sharing_bsses.push_back(bss);
+            }
+        }
+    }
+
+    if (sharing_bsses.empty()) {
+        LOG(DEBUG) << "send_mapc_configuration_policy: agent " << agent_mac
+                   << " has no sharing BSSIDs configured, nothing to send";
+        return true;
+    }
+
+    if (!cmdu_tx.create(0, ieee1905_1::eMessageType::MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE)) {
+        LOG(ERROR) << "Failed building MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE for MAPC "
+                      "Configuration Policy to agent "
+                   << agent_mac;
+        return false;
+    }
+
+    auto mapc_policy_tlv = cmdu_tx.addClass<wfa_map::tlvMapcConfigurationPolicy>();
+    if (!mapc_policy_tlv) {
+        LOG(ERROR) << "addClass wfa_map::tlvMapcConfigurationPolicy failed";
+        return false;
+    }
+    mapc_policy_tlv->flags() = 0; // leaderBSSIDConfigurationValid not used by this flow
+
+    for (auto &sharing_bss : sharing_bsses) {
+        const sMacAddr &sharing_bssid = sharing_bss->bssid;
+        auto &sharing_entry           = sharing_bss->mapc_sharing_bss;
+
+        auto local_bss = mapc_policy_tlv->create_local_bss_list();
+        if (!local_bss) {
+            LOG(ERROR) << "create_local_bss_list() failed";
+            continue;
+        }
+        local_bss->local_bssid()               = sharing_bssid;
+        local_bss->leader_bssid_configuration() = 0;
+        local_bss->mapc_feature_enable_bitmap() = sharing_entry.mapc_capability_bitmap;
+
+        // Group this sharing BSSID's shared_bssids by the remote Agent that owns each one.
+        std::map<sMacAddr, std::vector<sMacAddr>, sMacAddrLess> remote_bssids_per_agent;
+        for (auto &shared_pair : sharing_entry.shared_bssids) {
+            const sMacAddr &shared_bssid = shared_pair.first;
+            auto owning_agent            = database.get_bss_parent_agent(shared_bssid);
+            if (owning_agent == beerocks::net::network_utils::ZERO_MAC) {
+                LOG(WARNING) << "send_mapc_configuration_policy: could not resolve owning "
+                                "agent for shared BSSID "
+                             << shared_bssid << ", skipping";
+                continue;
+            }
+            remote_bssids_per_agent[owning_agent].push_back(shared_bssid);
+        }
+
+        for (auto &remote_agent_pair : remote_bssids_per_agent) {
+            auto remote_agent_entry = local_bss->create_remote_agent_list();
+            if (!remote_agent_entry) {
+                LOG(ERROR) << "create_remote_agent_list() failed";
+                continue;
+            }
+            remote_agent_entry->remote_agent_al_mac_address() = remote_agent_pair.first;
+
+            for (const auto &permitted_bssid : remote_agent_pair.second) {
+                auto permitted_entry = remote_agent_entry->create_permitted_remote_bss_list();
+                if (!permitted_entry) {
+                    LOG(ERROR) << "create_permitted_remote_bss_list() failed";
+                    continue;
+                }
+                permitted_entry->permitted_remote_bssid() = permitted_bssid;
+                if (!remote_agent_entry->add_permitted_remote_bss_list(permitted_entry)) {
+                    LOG(ERROR) << "add_permitted_remote_bss_list() failed";
+                }
+            }
+            if (!local_bss->add_remote_agent_list(remote_agent_entry)) {
+                LOG(ERROR) << "add_remote_agent_list() failed";
+            }
+        }
+
+        if (!mapc_policy_tlv->add_local_bss_list(local_bss)) {
+            LOG(ERROR) << "add_local_bss_list() failed";
+        }
+    }
+
+    LOG(INFO) << "Sending MULTI_AP_POLICY_CONFIG_REQUEST_MESSAGE with "
+                 "TLV_MAPC_CONFIGURATION_POLICY to agent "
+              << agent_mac << " (" << sharing_bsses.size() << " sharing BSSID(s))";
+
+    return son_actions::send_cmdu_to_agent(agent_mac, cmdu_tx, database);
+}
+
