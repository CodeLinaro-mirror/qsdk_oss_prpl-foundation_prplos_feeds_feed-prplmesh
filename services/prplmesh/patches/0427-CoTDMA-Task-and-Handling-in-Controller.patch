+std::vector<sMacAddr>
+coordinated_tdma_task::get_backhaul_radio_uids(const std::shared_ptr<Agent> &sharing_agent,
+                                               const std::shared_ptr<Agent> &shared_agent)
+{
+    std::vector<sMacAddr> radio_uids;
+
+    if (!sharing_agent || !shared_agent) {
+        return radio_uids;
+    }
+
+    // MLO backhaul: shared_agent's bSTA MLD is associated to an AP MLD on sharing_agent.
+    // Every affiliated AP of that AP MLD is a radio on sharing_agent that is part of THIS
+    // specific backhaul link to shared_agent (regardless of which single band
+    // shared_agent->backhaul.parent_interface happens to record).
+    const sMacAddr &ap_mld_mac = shared_agent->bsta_mld.ap_mld_mac;
+    if (ap_mld_mac != beerocks::net::network_utils::ZERO_MAC) {
+        auto ap_mld_it = sharing_agent->ap_mlds.find(ap_mld_mac);
+        if (ap_mld_it != sharing_agent->ap_mlds.end()) {
+            for (const auto &affiliated_ap_pair : ap_mld_it->second.affiliated_aps) {
+                radio_uids.push_back(affiliated_ap_pair.second.ruid);
+                TASK_LOG(DEBUG) << "get_backhaul_radio_uids: MLO backhaul, ap_mld_mac="
+                                << ap_mld_mac << " affiliated radio="
+                                << affiliated_ap_pair.second.ruid << " bssid="
+                                << affiliated_ap_pair.second.bssid;
+            }
+            if (!radio_uids.empty()) {
+                return radio_uids;
+            }
+            TASK_LOG(WARNING) << "get_backhaul_radio_uids: ap_mld_mac=" << ap_mld_mac
+                              << " found on sharing_agent=" << sharing_agent->al_mac
+                              << " but has no affiliated_aps, falling back to "
+                                 "parent_interface resolution";
+        } else {
+            TASK_LOG(WARNING) << "get_backhaul_radio_uids: shared_agent="
+                              << shared_agent->al_mac << " bsta_mld.ap_mld_mac=" << ap_mld_mac
+                              << " not found in sharing_agent=" << sharing_agent->al_mac
+                              << " ap_mlds, falling back to parent_interface resolution";
+        }
+    }
+
+    // Legacy (non-MLO) wireless backhaul: resolve shared_agent's backhaul.parent_interface
+    // as a BSSID on sharing_agent, and return its single owning radio.
+    const sMacAddr &backhaul_bssid = shared_agent->backhaul.parent_interface;
+    if (backhaul_bssid == beerocks::net::network_utils::ZERO_MAC) {
+        TASK_LOG(DEBUG) << "get_backhaul_radio_uids: shared_agent=" << shared_agent->al_mac
+                        << " has wired/unknown backhaul (parent_interface == ZERO_MAC)";
+        return radio_uids;
+    }
+
+    auto backhaul_bss = database.get_bss(backhaul_bssid, sharing_agent->al_mac);
+    if (!backhaul_bss) {
+        TASK_LOG(WARNING) << "get_backhaul_radio_uids: backhaul BSSID " << backhaul_bssid
+                          << " not found on sharing_agent=" << sharing_agent->al_mac;
+        return radio_uids;
+    }
+
+    radio_uids.push_back(backhaul_bss->radio.radio_uid);
+    TASK_LOG(DEBUG) << "get_backhaul_radio_uids: legacy (non-MLO) backhaul, radio="
+                    << backhaul_bss->radio.radio_uid;
+
+    return radio_uids;
+}
+
+void coordinated_tdma_task::log_mapc_sharing_bssids_map()
+{
+    using sMapcSharedBss = Agent::sRadio::sBss::sMapcSharedBss;
+
+    auto discovery_status_to_str = [](sMapcSharedBss::eDiscoveryStatus status) -> const char * {
+        switch (status) {
+        case sMapcSharedBss::eDiscoveryStatus::PENDING:
+            return "PENDING";
+        case sMapcSharedBss::eDiscoveryStatus::DISCOVERED:
+            return "DISCOVERED";
+        default:
+            return "UNKNOWN";
+        }
+    };
+
+    auto negotiation_status_to_str = [](sMapcSharedBss::eNegotiationStatus status) -> const char * {
+        switch (status) {
+        case sMapcSharedBss::eNegotiationStatus::IDLE:
+            return "IDLE";
+        case sMapcSharedBss::eNegotiationStatus::ESTABLISH_PENDING:
+            return "ESTABLISH_PENDING";
+        case sMapcSharedBss::eNegotiationStatus::ESTABLISHED:
+            return "ESTABLISHED";
+        case sMapcSharedBss::eNegotiationStatus::TEARDOWN_PENDING:
+            return "TEARDOWN_PENDING";
+        case sMapcSharedBss::eNegotiationStatus::TORN:
+            return "TORN";
+        default:
+            return "UNKNOWN";
+        }
+    };
+
+    TASK_LOG(DEBUG) << "==== MAPC Sharing BSSIDs Map (begin) ====";
+
+    bool any_sharing_bssid_found = false;
+
+    for (const auto &agent_pair : database.m_agents) {
+        const auto &agent = agent_pair.second;
+        if (!agent) {
+            continue;
+        }
+
+        for (const auto &radio_pair : agent->radios) {
+            const auto &radio = radio_pair.second;
+            if (!radio) {
+                continue;
+            }
+
+            for (const auto &bss_pair : radio->bsses) {
+                const auto &bss = bss_pair.second;
+                if (!bss || !bss->mapc_sharing_bss.is_valid) {
+                    continue;
+                }
+
+                any_sharing_bssid_found = true;
+
+                TASK_LOG(DEBUG) << "Sharing BSSID=" << bss->bssid << " (agent=" << agent->al_mac
+                                << ") mapc_capability_bitmap=0x" << std::hex
+                                << bss->mapc_sharing_bss.mapc_capability_bitmap << std::dec
+                                << " shared_bssids_count="
+                                << bss->mapc_sharing_bss.shared_bssids.size();
+
+                for (const auto &shared_pair : bss->mapc_sharing_bss.shared_bssids) {
+                    const sMacAddr &shared_bssid  = shared_pair.first;
+                    const sMapcSharedBss &shared_entry = shared_pair.second;
+
+                    TASK_LOG(DEBUG) << "    -> shared_bssid=" << shared_bssid
+                                    << " mapc_capability_bitmap=0x" << std::hex
+                                    << shared_entry.mapc_capability_bitmap << std::dec
+                                    << " discovery_status="
+                                    << discovery_status_to_str(shared_entry.discovery_status)
+                                    << " negotiation_status="
+                                    << negotiation_status_to_str(
+                                           shared_entry.negotiation_status);
+                }
+            }
+        }
+    }
+
+    if (!any_sharing_bssid_found) {
+        TASK_LOG(DEBUG) << "(no valid MAPC sharing BSSIDs found in DB)";
+    }
+
+    TASK_LOG(DEBUG) << "==== MAPC Sharing BSSIDs Map (end) ====";
+}
