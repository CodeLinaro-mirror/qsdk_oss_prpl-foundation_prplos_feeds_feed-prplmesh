+/**
+ * @brief Controller-side Coordinated TDMA (Co-TDMA) task.
+ *
+ * Responsibilities:
+ *  - Builds and sends COTDMA_CONFIGURATION_MESSAGE (0x8051) to a single target Agent.
+ *  - The message may carry up to 3 Co-TDMA TLVs, depending on the role of the target Agent
+ *    with respect to this task's configuration:
+ *      * TLV_COTDMA_SHARING_AP_CONFIGURATION (wfa_map::tlvCoTDMASharingApConfiguration) -
+ *        sent to the Agent that owns the Sharing AP BSSID.
+ *      * QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG
+ *        (qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig) - sent to the Agent that owns the
+ *        Sharing AP BSSID.
+ *      * QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG
+ *        (qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig) - sent to the Agent that owns the
+ *        Shared AP BSSID (which may be a different Agent than the Sharing AP owner; the
+ *        caller is responsible for instantiating a separate task targeting that Agent
+ *        with only shared_scs_entries populated when needed).
+ *  - Waits for ACK from the target Agent.
+ *  - Retries on timeout (up to MAX_RETRIES times).
+ *  - Marks the task as done once the Agent has ACKed or all retries are exhausted.
+ *  - Handles MAPC_REPORT_MESSAGE (0x8050) received from any Agent, carrying either:
+ *      * TLV_MAPC_CAPABILITY_UPDATE (wfa_map::tlvMapcCapabilityUpdate)
+ *      * TLV_MAPC_NEGOTIATION_STATUS (wfa_map::tlvMapcNegotiationStatus)
+ *    and updates the Controller DB (Agent::sRadio::sBss::mapc_sharing_bss) accordingly.
+ *
+ * Usage:
+ *   auto task = std::make_shared<coordinated_tdma_task>(database, cmdu_tx, config);
+ *   task_pool.add_task(task);
+ */
+class coordinated_tdma_task : public task {
+public:
+    /**
+     * @brief Per-Shared-BSS TXOP sharing parameters for TLV_COTDMA_SHARING_AP_CONFIGURATION.
+     *
+     * Mirrors wfa_map::sSharedBssEntry, minus the shared_bssid (passed separately to
+     * send_cotdma_configuration_message()).
+     */
+    struct sCoTDMAExtendedConfig {
+        uint8_t primary_ac                 = 2; ///< Access Category for TXOP sharing (BE/BK/VI/VO).
+        uint8_t max_shared_txop_duration   = 30; ///< Max shared TXOP duration, units of 100us.
+        uint16_t min_shared_txop_duration  = 10; ///< Min shared TXOP duration, units of 100us.
+        uint16_t service_start_time        = 0; ///< Service start time, units of 100us.
+        uint16_t service_interval          = 0; ///< Service interval, units of 100us (0: share unconditionally).
+        uint16_t service_end_time          = 0; ///< Service end time, units of 100us.
+        uint8_t priority                   = 1; ///< Priority (lower value = higher priority).
+    };
+
+    /**
+     * @brief QMID configuration parameters shared by the two Q2Q DL SCS MSDU forwarding
+     * TLVs (QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG and
+     * QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG).
+     */
+    struct sCoTDMAQMIDConfig {
+        sMacAddr bsta_mac; ///< BSTA MAC Address for the Repeater to which the QMID applies.
+        uint16_t qmid;     ///< QMID configured for the Peer.
+    };
+
+    /**
+     * @brief Construct a new coordinated_tdma_task.
+     *
+     * @param database  Reference to the controller database.
+     * @param cmdu_tx   Reference to the CMDU transmit buffer.
+     * @param tasks_    Reference to the task pool.
+     */
+    coordinated_tdma_task(db &database, ieee1905_1::CmduMessageTx &cmdu_tx,
+                          task_pool &tasks_);
+
+    ~coordinated_tdma_task() override = default;
+
+    /**
+     * @brief Handle incoming IEEE 1905.1 messages.
+     *
+     * Handles:
+     *  - ACK_MESSAGE from the target Agent in response to COTDMA_CONFIGURATION_MESSAGE.
+     *  - MAPC_REPORT_MESSAGE from any Agent (TLV_MAPC_CAPABILITY_UPDATE or
+     *    TLV_MAPC_NEGOTIATION_STATUS).
+     *
+     * @param src_mac  AL MAC address of the sender.
+     * @param cmdu_rx  Received CMDU.
+     * @return true if the message was handled by this task.
+     */
+    bool handle_ieee1905_1_msg(const sMacAddr &src_mac,
+                               ieee1905_1::CmduMessageRx &cmdu_rx) override;
+
+    /**
+     * @brief Events that can be pushed to this task via task_pool::push_event().
+     */
+    enum eEvent {
+        /**
+         * @brief Set up Co-TDMA sharing/shared configuration for the multi-hop agent
+         * path of a NETWORK_LEVEL QoS descriptor.
+         *
+         */
+        SETUP_COTDMA_FOR_QOS_PATH,
+    };
+
+    /**
+     * @brief Payload for SETUP_COTDMA_FOR_QOS_PATH.
+     *
+     * agent_path is ordered from the client-serving agent (index 0) to the
+     * root/gateway-most agent (last index)
+     */
+    struct sSetupCotdmaForQosPathEvent {
+        std::vector<sMacAddr> agent_path; ///< AL-MACs, path[0]=serving agent .. path[last]=root-most agent.
+        sMacAddr serving_bssid = beerocks::net::network_utils::ZERO_MAC; ///< BSSID on path[0] serving the client.
+        sMacAddr client_mac    = beerocks::net::network_utils::ZERO_MAC; ///< Client MAC address.
+        uint16_t qmid          = 0;                                     ///< Controller-assigned QMID.
+    };
+
+private:
+    /**
+     * @brief Handle an event pushed via task_pool::push_event().
+     *
+     * @param event_type  One of the eEvent values.
+     * @param obj         Pointer to the corresponding event payload struct.
+     */
+    void handle_event(int event_type, void *obj) override;
+
+    /**
+     * @brief Handle SETUP_COTDMA_FOR_QOS_PATH event.
+     *
+     * Walks the agent path from the root-most agent (path[last]) down to the
+     * serving agent (path[0]), pairing each adjacent (sharing_agent, shared_agent)
+     * hop and - if a valid, established Co-TDMA sharing/shared BSSID pair is found
+     * on the correct radios - configures DL SCS MSDU forwarding for the given QMID
+     * via send_cotdma_configuration_message().
+     *
+     * @param event  Parsed sSetupCotdmaForQosPathEvent payload.
+     */
+    void handle_setup_cotdma_for_qos_path(const sSetupCotdmaForQosPathEvent &event);
+
+    /**
+     * @brief Handle MAPC_REPORT_MESSAGE from an Agent.
+     *
+     * Dispatches to either handle_mapc_capability_update() or
+     * handle_mapc_negotiation_status() depending on which TLV is present.
+     *
+     * @param src_mac  AL MAC address of the sending Agent.
+     * @param cmdu_rx  Received CMDU.
+     * @return true if handled.
+     */
+    bool handle_mapc_report_message(const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Process tlvMapcCapabilityUpdate and update the DB.
+     *
+     * TLV carries a single local_bssid (the reporting Agent's sharing BSSID) plus a list of
+     * peer_bss_capabilities (candidate shared BSSIDs and their MAPC capability bitmaps).
+     *
+     * Sanity checks performed before applying any update:
+     *  - local_bssid must be one of the BSSID entries on the Agent identified by src_mac
+     *    (looked up via Agent::sRadio::sBss). If not found, the whole TLV is discarded.
+     *  - Each peer_bss_capabilities[i].bssid must belong to some OTHER Agent in the DB
+     *    (via db::get_bss_parent_agent()). Entries that don't resolve to any Agent are
+     *    discarded individually (the rest of the TLV is still processed).
+     *
+     * DB updates (on Agent::sRadio::sBss::mapc_sharing_bss for local_bssid's BSS):
+     *  - If mapc_sharing_bss.is_valid was not yet set (new sharing BSSID): sets is_valid,
+     *    sets mapc_capability_bitmap to the CO_TDMA default, and populates shared_bssids
+     *    with the (sanity-checked) peer BSSIDs.
+     *  - If mapc_sharing_bss.is_valid was already set: for each peer BSSID, either adds a
+     *    new sMapcSharedBss entry to shared_bssids (if not already present) or updates the
+     *    existing entry's mapc_capability_bitmap (if changed).
+     *
+     * Triggers Controller::send_mapc_configuration_policy():
+     *  - For ALL Agents, if a new sharing BSSID was marked valid (is_valid transitioned to
+     *    true) — since that sharing BSSID is now itself a valid candidate shared BSSID for
+     *    every other Agent's own sharing BSSIDs.
+     *  - For src_mac's Agent only, if no new sharing BSSID was marked valid but the
+     *    shared_bssids list changed (new entry added) or an existing entry's
+     *    mapc_capability_bitmap changed.
+     *
+     * @param src_mac  AL MAC address of the sending Agent.
+     * @param tlv      Parsed tlvMapcCapabilityUpdate.
+     */
+    void handle_mapc_capability_update(const sMacAddr &src_mac,
+                                       wfa_map::tlvMapcCapabilityUpdate &tlv);
+
+    /**
+     * @brief Process tlvMapcNegotiationStatus and update the DB.
+     *
+     * Looks up the sharing/shared BSSID pair (local_mapc_bssid / remote_mapc_bssid) across
+     * all known Agents' radios/BSSes (Agent::sRadio::sBss::mapc_sharing_bss.shared_bssids)
+     * and updates the matching sMapcSharedBss::negotiation_status entry to ESTABLISHED (on
+     * success) or TORN (on failure/teardown), based on the flags() field of the TLV.
+     *
+     * @param src_mac  AL MAC address of the sending Agent.
+     * @param tlv      Parsed tlvMapcNegotiationStatus.
+     */
+    void handle_mapc_negotiation_status(const sMacAddr &src_mac,
+                                        wfa_map::tlvMapcNegotiationStatus &tlv);
+
+    /**
+     * @brief Get the set of radio UIDs on @p sharing_agent that carry the wireless backhaul
+     * link to @p shared_agent.
+     *
+     * For an MLO backhaul (shared_agent->bsta_mld.ap_mld_mac != ZERO_MAC), this looks up the
+     * corresponding AP MLD on sharing_agent (sharing_agent->ap_mlds[ap_mld_mac]) and returns
+     * the RUID of every affiliated AP - i.e. every band/radio that is actually part of that
+     * specific MLO backhaul link between the two Agents (NOT just any radio on sharing_agent).
+     *
+     * For a legacy (non-MLO / single-link) wireless backhaul, falls back to resolving
+     * shared_agent->backhaul.parent_interface as a BSSID on sharing_agent and returning its
+     * single owning radio's UID.
+     *
+     * Returns an empty vector if the backhaul is wired/unknown, or if the link cannot be
+     * resolved (DB inconsistency).
+     *
+     * @param sharing_agent  The (potential) Sharing AP Agent (root-ward side of the hop).
+     * @param shared_agent   The (potential) Shared AP Agent (client-ward side of the hop).
+     * @return Vector of radio UIDs on sharing_agent that carry the backhaul link to
+     *         shared_agent.
+     */
+    std::vector<sMacAddr> get_backhaul_radio_uids(const std::shared_ptr<Agent> &sharing_agent,
+                                                  const std::shared_ptr<Agent> &shared_agent);
+
+    /**
+     * @brief Debug helper: dump the full MAPC sharing/shared BSSID map for every Agent
+     * currently known in the Controller DB.
+     *
+     * For every BSS across all Agents/radios that has a valid MAPC sharing BSSID
+     * (Agent::sRadio::sBss::mapc_sharing_bss.is_valid == true), logs the sharing BSSID
+     * (with its owning Agent's AL-MAC and mapc_capability_bitmap) followed by each of its
+     * candidate shared BSSIDs (with their mapc_capability_bitmap, discovery_status and
+     * negotiation_status).
+     *
+     * Intended to be called after any update to the MAPC sharing/shared BSSID DB state
+     * (e.g. at the end of handle_mapc_capability_update()) for debugging purposes.
+     */
+    void log_mapc_sharing_bssids_map();
+
+protected:
+    /**
+     * @brief Main task work function.
+     *
+     * Drives the state machine: sends the COTDMA_CONFIGURATION_MESSAGE, waits for ACK,
+     * and retries on timeout.
+     */
+    void work() override;
+
+private:
+    /**
+     * @brief Build and send COTDMA_CONFIGURATION_MESSAGE(s) for a Co-TDMA sharing/shared
+     * BSSID pair.
+     *
+     * Depending on which of @p extended_config / @p qmid_config are non-null, this may
+     * send up to two separate COTDMA_CONFIGURATION_MESSAGE CMDUs:
+     *  - To the Agent owning @p sharing_bssid: TLV_COTDMA_SHARING_AP_CONFIGURATION (if
+     *    @p extended_config is non-null) and/or QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG
+     *    (if @p qmid_config is non-null).
+     *  - To the Agent owning @p shared_bssid: QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG
+     *    (if @p qmid_config is non-null).
+     *
+     * @param sharing_bssid   Sharing AP BSSID.
+     * @param shared_bssid    Shared AP BSSID.
+     * @param config_mode     0=Add, 1=Remove (see wfa_map::eCoTDMAConfigMode).
+     * @param extended_config Optional pointer to Sharing AP Configuration TLV fields.
+     *                        May be nullptr if not applicable.
+     * @param qmid_config     Optional pointer to QMID forwarding configuration fields.
+     *                        May be nullptr if not applicable.
+     * @return true on success.
+     */
+    bool send_cotdma_configuration_message(const sMacAddr &sharing_bssid,
+                                           const sMacAddr &shared_bssid, uint8_t config_mode,
+                                           const sCoTDMAExtendedConfig *extended_config,
+                                           const sCoTDMAQMIDConfig *qmid_config);
+
+    /**
+     * @brief Add TLV_COTDMA_SHARING_AP_CONFIGURATION to the CMDU.
+     * @return true on success.
+     */
+    bool add_sharing_ap_configuration_tlv(const sMacAddr &sharing_bssid,
+                                          const sMacAddr &shared_bssid, uint8_t config_mode,
+                                          const sCoTDMAExtendedConfig &extended_config);
+
+    /**
+     * @brief Add QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG to the CMDU.
+     * @return true on success.
+     */
+    bool add_sharing_ap_dl_scs_msdu_fwd_config_tlv(const sMacAddr &sharing_bssid,
+                                                   const sMacAddr &shared_bssid,
+                                                   uint8_t config_mode,
+                                                   const sCoTDMAQMIDConfig &qmid_config);
+
+    /**
+     * @brief Add QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG to the CMDU.
+     * @return true on success.
+     */
+    bool add_shared_ap_dl_scs_msdu_fwd_config_tlv(const sMacAddr &sharing_bssid,
+                                                  const sMacAddr &shared_bssid,
+                                                  uint8_t config_mode,
+                                                  const sCoTDMAQMIDConfig &qmid_config);
+
+private:
+    db &database;
+    ieee1905_1::CmduMessageTx &cmdu_tx;
+    task_pool &tasks;
+};
+
+} // namespace son
+
+#endif // _CONTROLLER_COORDINATED_TDMA_TASK_H_
