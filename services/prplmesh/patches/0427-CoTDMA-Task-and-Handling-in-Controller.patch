+coordinated_tdma_task::coordinated_tdma_task(db &database, ieee1905_1::CmduMessageTx &cmdu_tx,
+                                             task_pool &tasks_)
+    : task("coordinated_tdma_task"), database(database), cmdu_tx(cmdu_tx), tasks(tasks_)
+{
+    // Register this task's ID in the database so other tasks
+    // can push events to it (Such as SETUP_COTDMA_FOR_QOS_PATH).
+    database.assign_coordinated_tdma_task_id(id);
+
+    TASK_LOG(INFO) << "coordinated_tdma_task created on Controller";
+}
+
+void coordinated_tdma_task::work()
+{
+    // No periodic work required.  The task is entirely event-driven:
+    //   - MAPC Capability Report from Agent - Update Cooridnating APs DB and send policy config is any changes.
+    //   - MAPC Negotiation Status - Update Coordinating APs DB and send CoTDMA Config for impacted QoS Flows
+    //   - CoTDMA Config Trigger from application
+}
+
+void coordinated_tdma_task::handle_event(int event_type, void *obj)
+{
+    switch (event_type) {
+    case eEvent::SETUP_COTDMA_FOR_QOS_PATH: {
+        std::unique_ptr<sSetupCotdmaForQosPathEvent> ev(
+            static_cast<sSetupCotdmaForQosPathEvent *>(obj));
+        if (ev) {
+            handle_setup_cotdma_for_qos_path(*ev);
+        }
+        // unique_ptr destructor frees memory automatically at end of scope
+        break;
+    }
+    default:
+        TASK_LOG(WARNING) << "Unhandled event_type " << event_type;
+        break;
+    }
+}
+
+void coordinated_tdma_task::handle_setup_cotdma_for_qos_path(
+    const sSetupCotdmaForQosPathEvent &event)
+{
+    // Rebuild the Agent path from the AL-MAC list supplied
+    std::vector<std::shared_ptr<Agent>> path;
+    path.reserve(event.agent_path.size());
+    for (const auto &al_mac : event.agent_path) {
+        auto agent = database.m_agents.get(al_mac);
+        if (!agent) {
+            TASK_LOG(WARNING) << "handle_setup_cotdma_for_qos_path: agent " << al_mac
+                              << " not found in DB, aborting Co-TDMA setup for client "
+                              << event.client_mac;
+            return;
+        }
+        path.push_back(agent);
+    }
+
+    const int total_hops = static_cast<int>(path.size());
+    if (total_hops < 2) {
+        // Nothing to configure for a single-hop (directly-connected) client.
+        return;
+    }
+
+    TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: client=" << event.client_mac
+                    << " qmid=" << event.qmid << " total_hops=" << total_hops;
+
+    // Walk the path from the root-most agent (path[last]) down to the serving agent
+    // (path[0]), pairing each adjacent hop as (sharing_agent, shared_agent).
+    for (int i = total_hops - 1; i >= 1; --i) {
+        const auto &sharing_agent = path[i];
+        const auto &shared_agent  = path[i - 1];
+
+        TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: --- iteration i=" << i
+                        << " sharing_agent=" << sharing_agent->al_mac
+                        << " shared_agent=" << shared_agent->al_mac << " ---";
+
+        // Get all radio UIDs on sharing_agent that carry the wireless backhaul link to
+        // shared_agent (may be more than one for an MLO backhaul spanning multiple bands).
+        auto backhaul_radio_uids = get_backhaul_radio_uids(sharing_agent, shared_agent);
+        if (backhaul_radio_uids.empty()) {
+            TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: no wireless backhaul radio(s) "
+                               "resolved between "
+                            << shared_agent->al_mac << " and " << sharing_agent->al_mac
+                            << ", skipping pair";
+            continue;
+        }
+
+        // Determine the downstream radio on shared_agent: either the radio serving the
+        // client directly (if shared_agent is the serving agent, i.e. i == 1) or the
+        // radio hosting the backhaul link down to the next agent in the path.
+        sMacAddr downstream_radio_uid = beerocks::net::network_utils::ZERO_MAC;
+        if (i == 1) {
+            auto serving_bss = database.get_bss(event.serving_bssid, shared_agent->al_mac);
+            if (!serving_bss) {
+                TASK_LOG(WARNING) << "handle_setup_cotdma_for_qos_path: serving BSSID "
+                                  << event.serving_bssid << " not found on agent "
+                                  << shared_agent->al_mac << ", skipping pair";
+                continue;
+            }
+            downstream_radio_uid = serving_bss->radio.radio_uid;
+            TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: downstream_radio_uid "
+                               "(client-serving radio on shared_agent)="
+                            << downstream_radio_uid;
+        } else {
+            const auto &next_hop_down       = path[i - 2];
+            const sMacAddr &next_hop_bssid = next_hop_down->backhaul.parent_interface;
+            if (next_hop_bssid == beerocks::net::network_utils::ZERO_MAC) {
+                TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: wired/unknown backhaul "
+                                   "between "
+                                << next_hop_down->al_mac << " and " << shared_agent->al_mac
+                                << ", skipping pair";
+                continue;
+            }
+            auto next_hop_bss = database.get_bss(next_hop_bssid, shared_agent->al_mac);
+            if (!next_hop_bss) {
+                TASK_LOG(WARNING) << "handle_setup_cotdma_for_qos_path: next-hop BSSID "
+                                  << next_hop_bssid << " not found on agent "
+                                  << shared_agent->al_mac << ", skipping pair";
+                continue;
+            }
+            downstream_radio_uid = next_hop_bss->radio.radio_uid;
+            TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: downstream_radio_uid "
+                               "(next-hop radio on shared_agent)="
+                            << downstream_radio_uid;
+        }
+
+        // Find a sharing BSS + corresponding shared BSSID pair. Two requirements must hold:
+        //  1. The sharing BSS must be on a radio that is part of the backhaul link between
+        //     sharing_agent and shared_agent (backhaul_radio_uids - may be more than one
+        //     radio for an MLO backhaul spanning multiple bands).
+        //  2. That sharing BSS must have a corresponding shared BSSID entry owned by
+        //     shared_agent, on shared_agent's downstream_radio_uid.
+        std::shared_ptr<Agent::sRadio::sBss> sharing_bss;
+        sMacAddr matched_shared_bssid = beerocks::net::network_utils::ZERO_MAC;
+
+        for (const auto &candidate_radio_uid : backhaul_radio_uids) {
+            auto radio_it = sharing_agent->radios.find(candidate_radio_uid);
+            if (radio_it == sharing_agent->radios.end() || !radio_it->second) {
+                TASK_LOG(WARNING) << "handle_setup_cotdma_for_qos_path: backhaul radio "
+                                  << candidate_radio_uid << " not found on agent "
+                                  << sharing_agent->al_mac << ", skipping";
+                continue;
+            }
+            const auto &candidate_radio = radio_it->second;
+
+            for (const auto &bss_pair : candidate_radio->bsses) {
+                const auto &candidate_sharing_bss = bss_pair.second;
+                if (!candidate_sharing_bss || !candidate_sharing_bss->mapc_sharing_bss.is_valid) {
+                    continue;
+                }
+
+                TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path:   trying sharing-BSS "
+                                   "candidate="
+                                << candidate_sharing_bss->bssid << " on sharing_agent radio="
+                                << candidate_radio->radio_uid;
+
+                for (const auto &shared_entry :
+                     candidate_sharing_bss->mapc_sharing_bss.shared_bssids) {
+                    TASK_LOG(DEBUG)
+                        << "handle_setup_cotdma_for_qos_path:     examining shared_bssid="
+                        << shared_entry.first << " negotiation_status="
+                        << static_cast<int>(shared_entry.second.negotiation_status);
+
+                    auto candidate_bss = database.get_bss(shared_entry.first, shared_agent->al_mac);
+                    if (!candidate_bss) {
+                        // Not owned by shared_agent - not a match for this pair.
+                        TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path:       not "
+                                           "owned by shared_agent "
+                                        << shared_agent->al_mac << ", skip";
+                        continue;
+                    }
+                    if (candidate_bss->radio.radio_uid != downstream_radio_uid) {
+                        TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path:       "
+                                           "radio_uid="
+                                        << candidate_bss->radio.radio_uid
+                                        << " != downstream_radio_uid=" << downstream_radio_uid
+                                        << ", skip";
+                        continue;
+                    }
+                    sharing_bss           = candidate_sharing_bss;
+                    matched_shared_bssid  = shared_entry.first;
+                    TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path:       MATCH: "
+                                       "sharing_bssid="
+                                    << sharing_bss->bssid
+                                    << " shared_bssid=" << matched_shared_bssid;
+                    break;
+                }
+                if (sharing_bss) {
+                    break;
+                }
+            }
+            if (sharing_bss) {
+                break;
+            }
+        }
+
+        if (!sharing_bss || matched_shared_bssid == beerocks::net::network_utils::ZERO_MAC) {
+            TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: no corresponding shared "
+                               "BSSID found on any radio of sharing_agent="
+                            << sharing_agent->al_mac << " -> shared agent "
+                            << shared_agent->al_mac << " on downstream radio "
+                            << downstream_radio_uid << ", skipping pair";
+            continue;
+        }
+
+        sCoTDMAQMIDConfig qmid_config{};
+        qmid_config.bsta_mac = shared_agent->backhaul.backhaul_interface;
+        qmid_config.qmid     = event.qmid;
+
+        TASK_LOG(DEBUG) << "handle_setup_cotdma_for_qos_path: configuring Co-TDMA for client "
+                        << event.client_mac << " qmid=" << event.qmid
+                        << " sharing_bssid=" << sharing_bss->bssid << " (agent "
+                        << sharing_agent->al_mac << ") shared_bssid=" << matched_shared_bssid
+                        << " (agent " << shared_agent->al_mac
+                        << ") bsta_mac=" << qmid_config.bsta_mac;
+
+        if (!send_cotdma_configuration_message(
+                sharing_bss->bssid, matched_shared_bssid,
+                static_cast<uint8_t>(wfa_map::eCoTDMAConfigMode::ADD), nullptr, &qmid_config)) {
+            TASK_LOG(ERROR) << "handle_setup_cotdma_for_qos_path: failed to send Co-TDMA "
+                               "DL SCS MSDU forwarding configuration for sharing_bssid="
+                            << sharing_bss->bssid << " shared_bssid=" << matched_shared_bssid;
+        }
+    }
+}
+
+bool coordinated_tdma_task::handle_ieee1905_1_msg(const sMacAddr &src_mac,
+                                                  ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    switch (cmdu_rx.getMessageType()) {
+    case ieee1905_1::eMessageType::MAPC_REPORT_MESSAGE:
+        return handle_mapc_report_message(src_mac, cmdu_rx);
+    default: {
+        return false;
+    }
+    }
+}
+
+bool coordinated_tdma_task::handle_mapc_report_message(const sMacAddr &src_mac,
+                                                       ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    TASK_LOG(DEBUG) << "Received MAPC_REPORT_MESSAGE from agent " << src_mac;
+
+    bool handled = false;
+
+    // Try tlvMapcCapabilityUpdate
+    auto cap_tlv = cmdu_rx.getClass<wfa_map::tlvMapcCapabilityUpdate>();
+    if (cap_tlv) {
+        handle_mapc_capability_update(src_mac, *cap_tlv);
+        handled = true;
+    }
+
+    // Try tlvMapcNegotiationStatus
+    auto neg_tlv = cmdu_rx.getClass<wfa_map::tlvMapcNegotiationStatus>();
+    if (neg_tlv) {
+        handle_mapc_negotiation_status(src_mac, *neg_tlv);
+        handled = true;
+    }
+
+    if (!handled) {
+        TASK_LOG(WARNING) << "MAPC_REPORT_MESSAGE from " << src_mac
+                          << " contains neither tlvMapcCapabilityUpdate nor "
+                             "tlvMapcNegotiationStatus";
+    }
+
+    return handled;
+}
+
+void coordinated_tdma_task::handle_mapc_capability_update(
+    const sMacAddr &src_mac, wfa_map::tlvMapcCapabilityUpdate &tlv)
+{
+    const sMacAddr &local_bssid = tlv.local_bssid();
+
+    TASK_LOG(DEBUG) << "Processing MAPC Capability Update from " << src_mac
+                    << " local_bssid=" << local_bssid
+                    << " peer_bss_count=" << static_cast<int>(tlv.peer_bss_count());
+
+    auto agent = database.get_agent(src_mac);
+    if (!agent) {
+        TASK_LOG(ERROR) << "handle_mapc_capability_update: agent not found for " << src_mac;
+        return;
+    }
+
+    // Sanity: local_bssid reported must be one of the BSSID entries on the Agent
+    // corresponding to src_mac.
+    auto local_bss = database.get_bss(local_bssid, src_mac);
+    if (!local_bss) {
+        TASK_LOG(ERROR) << "handle_mapc_capability_update: local_bssid " << local_bssid
+                        << " is not a BSSID of agent " << src_mac << ", discarding TLV";
+        return;
+    }
+
+    // Currently, MAPC negotiations are enabled only on FH VAPS. Check if BSSID is fronthaul
+    if (!local_bss->fronthaul) {
+        TASK_LOG(DEBUG) << "handle_mapc_capability_update: local_bssid " << local_bssid
+                        << " is not a fronthaul BSSID, discarding TLV";
+        return;        
+    }
+
+    auto &sharing_entry             = local_bss->mapc_sharing_bss;
+    const bool is_new_sharing_bssid = !sharing_entry.is_valid;
+
+    if (is_new_sharing_bssid) {
+        sharing_entry.is_valid = true;
+        sharing_entry.mapc_capability_bitmap =
+            static_cast<uint16_t>(wfa_map::eMapcCapabilityBit::CO_TDMA);
+        TASK_LOG(DEBUG) << "New MAPC sharing BSSID " << local_bssid << " (agent " << src_mac
+                        << ") marked valid, bitmap=0x" << std::hex
+                        << sharing_entry.mapc_capability_bitmap << std::dec;
+    }
+
+    // Sanity + apply: bssid in peer_bss_capabilities must be present on any OTHER Agent.
+    // If not found on any Agent, discard that peer_bss_capabilities entry.
+    bool shared_bssid_list_changed = false;
+
+    // Newly-added shared BSSIDs (for this sharing BSSID) that have the CO_TDMA capability
+    // bit set - a COTDMA_CONFIGURATION_MESSAGE (Sharing AP Configuration TLV, with default
+    // sCoTDMAExtendedConfig values) needs to be sent for each of these once the MAPC
+    // Configuration Policy has been (re-)sent below, covering both:
+    //  - a brand-new sharing BSSID (every processed entry is by definition new), and
+    //  - an already-existing sharing BSSID that gained a new shared BSSID.
+    std::vector<sMacAddr> new_cotdma_shared_bssids;
+
+    for (size_t i = 0; i < tlv.peer_bss_count(); ++i) {
+        auto result = tlv.peer_bss_capabilities(i);
+        if (!std::get<0>(result)) {
+            TASK_LOG(ERROR) << "Failed to read peer_bss_capabilities[" << i << "]";
+            continue;
+        }
+        auto &entry = std::get<1>(result);
+
+        auto peer_owning_agent = database.get_bss_parent_agent(entry.bssid);
+        if (peer_owning_agent == beerocks::net::network_utils::ZERO_MAC) {
+            TASK_LOG(WARNING) << "handle_mapc_capability_update: peer BSSID " << entry.bssid
+                              << " not found on any Agent in DB, discarding entry";
+            continue;
+        }
+
+        auto shared_it = sharing_entry.shared_bssids.find(entry.bssid);
+        if (shared_it == sharing_entry.shared_bssids.end()) {
+            // Not present yet - add a new shared_bssids entry for this peer BSSID.
+            auto &shared_entry                  = sharing_entry.shared_bssids[entry.bssid];
+            shared_entry.mapc_capability_bitmap = entry.mapc_capability_bitmap;
+            // discovery_status / negotiation_status keep their default values
+            // (PENDING / IDLE) as set by sMapcSharedBss's member initializers.
+            shared_bssid_list_changed = true;
+            TASK_LOG(DEBUG) << "Added new shared BSSID " << entry.bssid << " for sharing_bssid="
+                            << local_bssid << " (agent " << src_mac << ") bitmap=0x" << std::hex
+                            << entry.mapc_capability_bitmap << std::dec;
+
+            if (entry.mapc_capability_bitmap &
+                static_cast<uint16_t>(wfa_map::eMapcCapabilityBit::CO_TDMA)) {
+                new_cotdma_shared_bssids.push_back(entry.bssid);
+            }
+        } else if (shared_it->second.mapc_capability_bitmap != entry.mapc_capability_bitmap) {
+            // Already present - update the existing entry only if the bitmap changed.
+            const bool cotdma_was_enabled =
+                (shared_it->second.mapc_capability_bitmap &
+                 static_cast<uint16_t>(wfa_map::eMapcCapabilityBit::CO_TDMA)) != 0;
+            const bool cotdma_now_enabled =
+                (entry.mapc_capability_bitmap &
+                 static_cast<uint16_t>(wfa_map::eMapcCapabilityBit::CO_TDMA)) != 0;
+
+            shared_it->second.mapc_capability_bitmap = entry.mapc_capability_bitmap;
+            shared_bssid_list_changed                = true;
+            TASK_LOG(DEBUG) << "Updated mapc_capability_bitmap for shared BSSID " << entry.bssid
+                            << " under sharing_bssid=" << local_bssid << " (agent " << src_mac
+                            << ") bitmap=0x" << std::hex << entry.mapc_capability_bitmap
+                            << std::dec;
+
+            if (!cotdma_was_enabled && cotdma_now_enabled) {
+                // CO_TDMA capability transitioned from disabled to enabled for this
+                // already-existing shared BSSID - treat it the same as a newly-added
+                // CO_TDMA-capable shared BSSID.
+                new_cotdma_shared_bssids.push_back(entry.bssid);
+                TASK_LOG(DEBUG) << "CO_TDMA capability newly enabled for shared BSSID "
+                                << entry.bssid << " under sharing_bssid=" << local_bssid;
+            }
+        }
+    }
+
+    auto controller = database.get_controller_ctx();
+    if (!controller) {
+        TASK_LOG(ERROR) << "handle_mapc_capability_update: controller context not available, "
+                          "cannot send MAPC Configuration Policy";
+        return;
+    }
+
+    if (is_new_sharing_bssid) {
+        // New sharing BSSID established - every Agent may need the updated permitted-remote-BSS
+        // list (this sharing BSSID is now a valid candidate shared BSSID for other Agents'
+        // sharing BSSIDs too), so refresh the policy for ALL Agents.
+        for (auto &agent_pair : database.m_agents) {
+            if (!agent_pair.second) {
+                continue;
+            }
+            if (!controller->send_mapc_configuration_policy(agent_pair.second->al_mac)) {
+                TASK_LOG(ERROR) << "Failed sending MAPC Configuration Policy to agent "
+                                << agent_pair.second->al_mac;
+            }
+        }
+    } else if (shared_bssid_list_changed) {
+        // No new sharing BSSID, but the shared_bssids list (or an existing entry's bitmap)
+        // changed - only the reporting Agent needs a refreshed policy.
+        if (!controller->send_mapc_configuration_policy(src_mac)) {
+            TASK_LOG(ERROR) << "Failed sending MAPC Configuration Policy to agent " << src_mac;
+        }
+    }
+
+    // Send the initial Co-TDMA Sharing AP Configuration (default sCoTDMAExtendedConfig
+    // values, config_mode=ADD) for every newly-added CO_TDMA-capable shared BSSID, now that
+    // the MAPC Configuration Policy has been (re-)sent to the relevant Agent(s) above.
+    for (const auto &shared_bssid : new_cotdma_shared_bssids) {
+        sCoTDMAExtendedConfig extended_config{};
+        if (!send_cotdma_configuration_message(
+                local_bssid, shared_bssid, static_cast<uint8_t>(wfa_map::eCoTDMAConfigMode::ADD),
+                &extended_config, nullptr)) {
+            TASK_LOG(ERROR) << "Failed to send initial Co-TDMA Sharing AP Configuration for "
+                               "sharing_bssid="
+                            << local_bssid << " shared_bssid=" << shared_bssid;
+        }
+    }
+}
+
+void coordinated_tdma_task::handle_mapc_negotiation_status(
+    const sMacAddr &src_mac, wfa_map::tlvMapcNegotiationStatus &tlv)
+{
+    // flags: Bit 7: negotiationType (0=Teardown, 1=Establishment),
+    //        Bit 6: negotiationStatus (0=Fail, 1=Success)
+    const uint8_t flags        = tlv.flags();
+    const bool is_establishment = (flags & 0x80) != 0;
+    const bool is_success        = (flags & 0x40) != 0;
+
+    const sMacAddr &local_bssid  = tlv.local_mapc_bssid();
+    const sMacAddr &remote_bssid = tlv.remote_mapc_bssid();
+
+    TASK_LOG(DEBUG) << "Processing MAPC Negotiation Status from " << src_mac
+                    << " type=" << (is_establishment ? "Establishment" : "Teardown")
+                    << " status=" << (is_success ? "SUCCESS" : "FAIL")
+                    << " local_mapc_bssid=" << local_bssid
+                    << " remote_mapc_bssid=" << remote_bssid;
+
+    // Determine the target negotiation status to apply.
+    using sMapcSharedBss = Agent::sRadio::sBss::sMapcSharedBss;
+    sMapcSharedBss::eNegotiationStatus target_status;
+    if (is_establishment) {
+        target_status = is_success ? sMapcSharedBss::eNegotiationStatus::ESTABLISHED
+                                    : sMapcSharedBss::eNegotiationStatus::IDLE;
+    } else {
+        target_status = is_success ? sMapcSharedBss::eNegotiationStatus::TORN
+                                    : sMapcSharedBss::eNegotiationStatus::ESTABLISHED;
+    }
+
+    // Find and update the corresponding entry. The pairing may be recorded in either
+    // direction (sharing_bssid -> shared_bssid) across any BSS's mapc_sharing_bss.shared_bssids
+    // map, since the Controller DB may hold symmetric entries for both the initiator and the
+    // responder side of the negotiation.
+    bool found = false;
+    for (auto &agent_pair : database.m_agents) {
+        auto &agent = agent_pair.second;
+        if (!agent) {
+            continue;
+        }
+
+        for (auto &radio_pair : agent->radios) {
+            auto &radio = radio_pair.second;
+            if (!radio) {
+                continue;
+            }
+            for (auto &bss_pair : radio->bsses) {
+                auto &bss = bss_pair.second;
+                if (!bss) {
+                    continue;
+                }
+
+                // Direction 1: local_bssid is this sharing BSSID, remote_bssid is one of its
+                // shared BSSIDs.
+                if (bss->bssid == local_bssid) {
+                    auto shared_it = bss->mapc_sharing_bss.shared_bssids.find(remote_bssid);
+                    if (shared_it != bss->mapc_sharing_bss.shared_bssids.end()) {
+                        shared_it->second.negotiation_status = target_status;
+                        TASK_LOG(DEBUG) << "Updated negotiation_status for sharing_bssid="
+                                        << local_bssid << " shared_bssid=" << remote_bssid
+                                        << " (agent " << agent->al_mac << ")";
+                        found = true;
+                    }
+                }
+
+                // Direction 2 (symmetric entry): remote_bssid is this sharing BSSID,
+                // local_bssid is one of its shared BSSIDs.
+                if (bss->bssid == remote_bssid) {
+                    auto shared_it2 = bss->mapc_sharing_bss.shared_bssids.find(local_bssid);
+                    if (shared_it2 != bss->mapc_sharing_bss.shared_bssids.end()) {
+                        shared_it2->second.negotiation_status = target_status;
+                        TASK_LOG(DEBUG) << "Updated negotiation_status for sharing_bssid="
+                                        << remote_bssid << " shared_bssid=" << local_bssid
+                                        << " (agent " << agent->al_mac << ")";
+                        found = true;
+                    }
+                }
+            }
+        }
+
+        // ToDo If negotiation is torn down, check impacted DL SCS E2E MSDU forwarding
+        // Look up QoS Database, and check if impacted Agent's BSSID is in path to client
+    }
+
+    if (!found) {
+        TASK_LOG(WARNING) << "handle_mapc_negotiation_status: no matching DB entry found for "
+                             "local_mapc_bssid="
+                          << local_bssid << " remote_mapc_bssid=" << remote_bssid;
+    }
+}
+
+bool coordinated_tdma_task::send_cotdma_configuration_message(
+    const sMacAddr &sharing_bssid, const sMacAddr &shared_bssid, uint8_t config_mode,
+    const sCoTDMAExtendedConfig *extended_config, const sCoTDMAQMIDConfig *qmid_config)
+{
+    if (!extended_config && !qmid_config) {
+        TASK_LOG(ERROR) << "send_cotdma_configuration_message: both extended_config and "
+                           "qmid_config are null, nothing to send";
+        return false;
+    }
+
+    // --- Message to the Agent owning the Sharing AP BSSID ---
+    // Sent if either the Sharing AP Configuration TLV or the Sharing AP DL SCS MSDU
+    // forwarding TLV needs to be delivered.
+    if (extended_config || qmid_config) {
+        auto sharing_agent_mac = database.get_bss_parent_agent(sharing_bssid);
+        if (sharing_agent_mac == beerocks::net::network_utils::ZERO_MAC) {
+            TASK_LOG(ERROR) << "send_cotdma_configuration_message: could not resolve owning "
+                               "agent for sharing_bssid "
+                            << sharing_bssid;
+            return false;
+        }
+
+        if (!cmdu_tx.create(0, ieee1905_1::eMessageType::COTDMA_CONFIGURATION_MESSAGE)) {
+            TASK_LOG(ERROR) << "Failed to create COTDMA_CONFIGURATION_MESSAGE CMDU (sharing)";
+            return false;
+        }
+
+        // TLV_COTDMA_SHARING_AP_CONFIGURATION - Relevant when initiating MAPC negotiation
+        // without any QMIDs established for a client on Sharing BSSID
+        if (extended_config) {
+            if (!add_sharing_ap_configuration_tlv(sharing_bssid, shared_bssid, config_mode,
+                                                  *extended_config)) {
+                TASK_LOG(ERROR) << "Failed to add TLV_COTDMA_SHARING_AP_CONFIGURATION";
+                return false;
+            }
+        }
+
+        // QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG - sent to the Agent owning the
+        // Sharing AP BSSID.
+        if (qmid_config) {
+            if (!add_sharing_ap_dl_scs_msdu_fwd_config_tlv(sharing_bssid, shared_bssid,
+                                                           config_mode, *qmid_config)) {
+                TASK_LOG(ERROR)
+                    << "Failed to add QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG";
+                return false;
+            }
+        }
+
+        if (!son_actions::send_cmdu_to_agent(sharing_agent_mac, cmdu_tx, database)) {
+            TASK_LOG(ERROR) << "Failed to send COTDMA_CONFIGURATION_MESSAGE to "
+                            << sharing_agent_mac;
+            return false;
+        }
+
+        TASK_LOG(DEBUG) << "Sent COTDMA_CONFIGURATION_MESSAGE to " << sharing_agent_mac
+                       << " (sharing_bssid=" << sharing_bssid << ")";
+    }
+
+    // --- Message to the Agent owning the Shared AP BSSID ---
+    // QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG - sent to the Agent owning the
+    // Shared AP BSSID.
+    if (qmid_config) {
+        auto shared_agent_mac = database.get_bss_parent_agent(shared_bssid);
+        if (shared_agent_mac == beerocks::net::network_utils::ZERO_MAC) {
+            TASK_LOG(ERROR) << "send_cotdma_configuration_message: could not resolve owning "
+                               "agent for shared_bssid "
+                            << shared_bssid;
+            return false;
+        }
+
+        if (!cmdu_tx.create(0, ieee1905_1::eMessageType::COTDMA_CONFIGURATION_MESSAGE)) {
+            TASK_LOG(ERROR) << "Failed to create COTDMA_CONFIGURATION_MESSAGE CMDU (shared)";
+            return false;
+        }
+
+        if (!add_shared_ap_dl_scs_msdu_fwd_config_tlv(sharing_bssid, shared_bssid, config_mode,
+                                                      *qmid_config)) {
+            TASK_LOG(ERROR)
+                << "Failed to add QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG";
+            return false;
+        }
+
+        if (!son_actions::send_cmdu_to_agent(shared_agent_mac, cmdu_tx, database)) {
+            TASK_LOG(ERROR) << "Failed to send COTDMA_CONFIGURATION_MESSAGE to "
+                            << shared_agent_mac;
+            return false;
+        }
+
+        TASK_LOG(DEBUG) << "Sent COTDMA_CONFIGURATION_MESSAGE to " << shared_agent_mac
+                       << " (shared_bssid=" << shared_bssid << ")";
+    }
+
+    return true;
+}
+
+bool coordinated_tdma_task::add_sharing_ap_configuration_tlv(
+    const sMacAddr &sharing_bssid, const sMacAddr &shared_bssid, uint8_t config_mode,
+    const sCoTDMAExtendedConfig &extended_config)
+{
+    auto tlv = cmdu_tx.addClass<wfa_map::tlvCoTDMASharingApConfiguration>();
+    if (!tlv) {
+        TASK_LOG(ERROR) << "Failed to allocate tlvCoTDMASharingApConfiguration";
+        return false;
+    }
+
+    tlv->sharing_bssid() = sharing_bssid;
+    tlv->config_mode()   = config_mode;
+
+    // shared_bss_count is 1 for now.
+    if (!tlv->alloc_shared_bss_list(1)) {
+        TASK_LOG(ERROR) << "Failed to allocate shared_bss_list in TLV";
+        return false;
+    }
+    auto result = tlv->shared_bss_list(0);
+    if (!std::get<0>(result)) {
+        TASK_LOG(ERROR) << "Failed to access shared_bss_list[0]";
+        return false;
+    }
+    auto &entry                     = std::get<1>(result);
+    entry.shared_bssid              = shared_bssid;
+    entry.primary_ac                = extended_config.primary_ac;
+    entry.max_shared_txop_duration  = extended_config.max_shared_txop_duration;
+    entry.min_shared_txop_duration  = extended_config.min_shared_txop_duration;
+    entry.service_start_time        = extended_config.service_start_time;
+    entry.service_interval          = extended_config.service_interval;
+    entry.service_end_time          = extended_config.service_end_time;
+    entry.priority                  = extended_config.priority;
+
+    return true;
+}
+
+bool coordinated_tdma_task::add_sharing_ap_dl_scs_msdu_fwd_config_tlv(
+    const sMacAddr &sharing_bssid, const sMacAddr &shared_bssid, uint8_t config_mode,
+    const sCoTDMAQMIDConfig &qmid_config)
+{
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaCoTDMASharingApDlScsMsduFwdConfig>();
+    if (!tlv) {
+        TASK_LOG(ERROR) << "Failed to allocate tlvQcaCoTDMASharingApDlScsMsduFwdConfig";
+        return false;
+    }
+
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+    tlv->tlv_id() =
+        static_cast<uint16_t>(qca::eQcaTlVId::QCA_TLV_COTDMA_SHARING_AP_DL_SCS_MSDU_FWD_CONFIG);
+
+    // qmid_count is 1 for now.
+    if (!tlv->alloc_qmid_entries(1)) {
+        TASK_LOG(ERROR) << "Failed to allocate qmid_entries in Sharing AP forwarding TLV";
+        return false;
+    }
+    auto result = tlv->qmid_entries(0);
+    if (!std::get<0>(result)) {
+        TASK_LOG(ERROR) << "Failed to access sharing qmid_entries[0]";
+        return false;
+    }
+    auto &entry = std::get<1>(result);
+    // Bit 7: Remove/Add QMID (0=Remove, 1=Add)
+    entry.config_mode =
+        (config_mode == static_cast<uint8_t>(wfa_map::eCoTDMAConfigMode::ADD)) ? 0x80 : 0x00;
+    entry.sharing_bssid = sharing_bssid;
+    entry.bsta_mac      = qmid_config.bsta_mac;
+    entry.shared_bssid  = shared_bssid;
+    entry.qmid          = qmid_config.qmid;
+
+    return true;
+}
+
+bool coordinated_tdma_task::add_shared_ap_dl_scs_msdu_fwd_config_tlv(
+    const sMacAddr &sharing_bssid, const sMacAddr &shared_bssid, uint8_t config_mode,
+    const sCoTDMAQMIDConfig &qmid_config)
+{
+    auto tlv = cmdu_tx.addClass<qca::tlvQcaCoTDMASharedApDlScsMsduFwdConfig>();
+    if (!tlv) {
+        TASK_LOG(ERROR) << "Failed to allocate tlvQcaCoTDMASharedApDlScsMsduFwdConfig";
+        return false;
+    }
+
+    tlv->vendor_oui() = sVendorOUI(qca::qcaVendorOUI::OUI_QCA);
+    tlv->tlv_id() =
+        static_cast<uint16_t>(qca::eQcaTlVId::QCA_TLV_COTDMA_SHARED_AP_DL_SCS_MSDU_FWD_CONFIG);
+
+    // qmid_count is 1 for now.
+    if (!tlv->alloc_qmid_entries(1)) {
+        TASK_LOG(ERROR) << "Failed to allocate qmid_entries in Shared AP forwarding TLV";
+        return false;
+    }
+    auto result = tlv->qmid_entries(0);
+    if (!std::get<0>(result)) {
+        TASK_LOG(ERROR) << "Failed to access shared qmid_entries[0]";
+        return false;
+    }
+    auto &entry = std::get<1>(result);
+    // Bit 7: Remove/Add QMID (0=Remove, 1=Add)
+    entry.config_mode =
+        (config_mode == static_cast<uint8_t>(wfa_map::eCoTDMAConfigMode::ADD)) ? 0x80 : 0x00;
+    entry.shared_bssid = shared_bssid;
+    // peer_bssid is the sharing_bssid, per spec.
+    entry.peer_bssid = sharing_bssid;
+    entry.qmid     = qmid_config.qmid;
+
+    return true;
+}
