+
+#ifndef __TLVF_QCA_UTILS_H__
+#define __TLVF_QCA_UTILS_H__
+
+#include <memory>
+#include <tlvf/CmduMessageRx.h>
+#include <tlvf/CmduMessageTx.h>
+
+namespace qca {
+
+class tlvf_qca_utils {
+public:
+    /**
+     * @brief Adds QCA version info TLV to outgoing message (SEND side).
+     *
+     * @param[in,out] cmdu_tx CMDU message.
+     * @return True on success and false otherwise.
+     */
+    static bool add_qca_version_info_tlv(ieee1905_1::CmduMessageTx &cmdu_tx);
+
+    /**
+     * @brief Generic parser for QCA vendor-specific TLVs (RECEIVE side).
+     * 
+     * This function acts as a dispatcher that peeks at the TLV ID and routes
+     * to the appropriate specific parser. This allows handling multiple
+     * QCA TLVs in a single message without consuming the buffer prematurely.
+     *
+     * @param[in] cmdu_rx Received CMDU message.
+     * @return Parsed TLV as BaseClass shared pointer, or nullptr on failure.
+     */
+    static std::shared_ptr<BaseClass> parse_qca_vs_tlv(ieee1905_1::CmduMessageRx &cmdu_rx);
+
+private:
+    /**
+     * @brief Parses QCA version info TLV (specific parser).
+     *
+     * @param[in] cmdu_rx Received CMDU message.
+     * @return Parsed TLV as BaseClass shared pointer, or nullptr on failure.
+     */
+    static std::shared_ptr<BaseClass>
+    parse_qca_version_info_tlv(ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    // Future: Add more specific parsers here
+    // static std::shared_ptr<BaseClass> parse_qca_device_info_tlv(ieee1905_1::CmduMessageRx &cmdu_rx);
+};
+
+} // namespace qca
+
+#endif // __TLVF_QCA_UTILS_H__
diff --git a/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp b/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp
new file mode 100644
index 000000000..4eda3d240
--- /dev/null
+++ b/common/beerocks/multi_vendor/qca/src/multi_vendor_qca.cpp
@@ -0,0 +1,54 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "multi_vendor.h"
+#include "tlvf_qca_utils.h"
+
+using namespace qca;
+using namespace ieee1905_1;
+
+/**
+ * @class MultiVendorQCA
+ * @brief QCA vendor-specific TLV handler for IEEE 1905.1 messages.
+ *
+ * This class registers QCA vendor-specific TLV handlers and parsers for IEEE 1905.1 message types.
+ * Uses the new registration method without OUI-based maps - OUI checking is delegated to the
+ * individual parser functions.
+ *
+ * How it works:
+ *  1) Inherits from multi_vendor::tlvf_handler to access register_handler() and register_parser()
+ *  2) Inherits from qca::tlvf_qca_utils to use QCA-specific TLV handler/parser functions
+ *  3) In constructor, calls register_handler() for SEND side and register_parser() for RECEIVE side
+ *  4) Static instance ensures registration happens at program startup
+ */
+class MultiVendorQCA : public multi_vendor::tlvf_handler, public qca::tlvf_qca_utils {
+public:
+    /**
+     * @brief Constructor for the MultiVendorQCA class.
+     *
+     * Registers QCA vendor-specific TLV handlers and parsers for supported message types.
+     * Uses the new registration API that doesn't require OUI-based maps.
+     */
+    MultiVendorQCA()
+    {
+        LOG(INFO) << "MultiVendorQCA: registering QCA vendor-specific TLV handlers and parsers";
+
+        // Register SEND handler for AP_AUTOCONFIGURATION_SEARCH_MESSAGE
+        multi_vendor::tlvf_handler::register_handler(
+            eMessageType::AP_AUTOCONFIGURATION_SEARCH_MESSAGE, add_qca_version_info_tlv);
+
+        // Register RECEIVE parser for AP_AUTOCONFIGURATION_SEARCH_MESSAGE
+        // The parser (parse_qca_vs_tlv) checks OUI internally and returns nullptr if not QCA
+        multi_vendor::tlvf_handler::register_parser(
+            eMessageType::AP_AUTOCONFIGURATION_SEARCH_MESSAGE, parse_qca_vs_tlv);
+
+        // Add more message type registrations as needed
+        // multi_vendor::tlvf_handler::register_handler(<MessageType>, <YourSendHandler>);
+        // multi_vendor::tlvf_handler::register_parser(<MessageType>, <YourReceiveParser>);
+    }
+};
+
+// Static object of the QCA vendor object. This ensures the QCA vendor's handlers are
+// registered during the program's initialization.
+static MultiVendorQCA qca_vendor_obj;
diff --git a/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp b/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
new file mode 100644
index 000000000..04d17f67a
--- /dev/null
+++ b/common/beerocks/multi_vendor/qca/src/tlvf_qca_utils.cpp
@@ -0,0 +1,102 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.  
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "tlvf_qca_utils.h"
+#include "../../multi_vendor.h"
+#include <easylogging++.h>
+#include <tlvf/ieee_1905_1/sVendorOUI.h>
+#include <tlvf/qca/eQcaTLVId.h>
+#include <tlvf/qca/eQcaTlvTypeMap.h>
+#include <tlvf/qca/tlvQcaVersionInfo.h>
+
+using namespace qca;
+
+// SEND side: Add version TLV to outgoing message
+bool tlvf_qca_utils::add_qca_version_info_tlv(ieee1905_1::CmduMessageTx &cmdu_tx)
+{
+    LOG(INFO)
+        << "Registered this callback but not adding it in the cmdu message"
+           "This function is a reference for new QCA vendor TLVs";
+    return true;
+
+    auto tlv_qca_version = cmdu_tx.addClass<qca::tlvQcaVersionInfo>();
+    if (!tlv_qca_version) {
+        LOG(ERROR) << "Failed to add QCA version info TLV";
+        return false;
+    }
+
+    // Set vendor OUI
+    tlv_qca_version->vendor_oui() = (sVendorOUI(qca::qcaVendorOUI::OUI_QCA));
+
+    // Set TLV ID
+    tlv_qca_version->tlv_id() = static_cast<int>(qca::eQcaTlVId::QCA_VERSION_INFO);
+
+    // Set version information
+    tlv_qca_version->version_major() = 1;
+    tlv_qca_version->version_minor() = 0;
+    tlv_qca_version->version_patch() = 0;
+
+    LOG(INFO) << "Added QCA version info TLV (v1.0.0)";
+    return true;
+}
+
+// RECEIVE side: Generic parser that routes to specific parsers based on TLV ID
+std::shared_ptr<BaseClass> tlvf_qca_utils::parse_qca_vs_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    uint32_t vendor_oui = 0;
+    uint16_t tlv_id     = 0;
+
+    // Use the safe helper to validate and extract OUI + TLV ID with comprehensive bounds checking
+    // TLV structure: [type:1][length:2][vendor_oui:3][tlv_id:2][payload:variable]
+    // Extract 2-byte TLV ID at offset 0 (immediately after OUI)
+    if (!multi_vendor::tlvf_handler::safe_read_vendor_tlv_data(cmdu_rx, &tlv_id, sizeof(tlv_id), 0,
+                                                               &vendor_oui)) {
+        // Helper already logged the error
+        return nullptr;
+    }
+
+    // Convert TLV ID from network byte order
+    swap_16(tlv_id);
+
+    // Check if this is a QCA vendor TLV
+    if (vendor_oui != qca::qcaVendorOUI::OUI_QCA) {
+        LOG(DEBUG) << "Not a QCA vendor TLV, OUI mismatch: 0x" << std::hex << vendor_oui;
+        return nullptr;
+    }
+
+    LOG(DEBUG) << "Parsing QCA TLV with ID: 0x" << std::hex << tlv_id;
+
+    // Route to specific parser based on TLV ID
+    // Now we can safely call addClass since we know which TLV type to parse
+    switch (static_cast<qca::eQcaTlVId>(tlv_id)) {
+    case qca::eQcaTlVId::QCA_VERSION_INFO:
+        return parse_qca_version_info_tlv(cmdu_rx);
+
+        // Future: Add more cases for other QCA TLVs
+        // case qca::eQcaTlVId::QCA_DEVICE_INFO:
+        //     return parse_qca_device_info_tlv(cmdu_rx);
+
+    default:
+        LOG(WARNING) << "Unknown QCA TLV ID: 0x" << std::hex << tlv_id;
+        return nullptr;
+    }
+}
+
+// RECEIVE side: Specific parser for version info TLV
+std::shared_ptr<BaseClass>
+tlvf_qca_utils::parse_qca_version_info_tlv(ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // Now we can safely call addVendorClass to parse and consume the TLV
+    auto tlv = cmdu_rx.addVendorClass<qca::tlvQcaVersionInfo>();
+    if (!tlv) {
+        LOG(ERROR) << "Failed to parse QCA version info TLV";
+        return nullptr;
+    }
+
+    LOG(INFO) << "Parsed QCA version info TLV: v" << static_cast<int>(tlv->version_major()) << "."
+              << static_cast<int>(tlv->version_minor()) << "."
+              << static_cast<int>(tlv->version_patch());
+
+    return tlv;
+}
