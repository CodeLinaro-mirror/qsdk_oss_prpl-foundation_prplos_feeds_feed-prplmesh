From 5a63d1db43374a91818d1d9bb03908fab80999b1 Mon Sep 17 00:00:00 2001
From: Arockiasathish S <arocs@qti.qualcomm.com>
Date: Fri, 11 Sep 2026 13:10:19 +0530
Subject: [PATCH 2/6] [RDK][QMSH] Add Derive VAP information from Comcast haul
 type in M2

Signed-off-by: Arockiasathish S <arocs@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 27 +++++++++++++++++++
 .../tlvf/WSC/EncryptedSettingsPayload.h       | 21 +++++++++++++++
 .../tlvf/yaml/tlvf/WSC/eWscVendorExt.yaml     |  5 ++++
 .../tlvf/yaml/tlvf/WSC/eWscVendorId.yaml      |  3 +++
 4 files changed, 56 insertions(+)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 47797ebd3..3a963db60 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -34,6 +34,9 @@
 
 #include <tlvf/WSC/m1.h>
 #include <tlvf/WSC/eWscWifiCompatMode.h>
+#ifdef BEEROCKS_RDKB
+#include <bwl/onewifi_hal_map.h>
+#endif // BEEROCKS_RDKB
 #include <tlvf/qca/tlvQcaWifiCompatMode.h>
 #include <tlvf/airties/eAirtiesTLVId.h>
 #include <tlvf/airties/tlvAirtiesMsgType.h>
@@ -4147,6 +4150,27 @@ bool ApAutoConfigurationTask::handle_wsc_m2_tlv(
             LOG(INFO) << "Parsed VAP label from M2 Vendor Extension: '" << info.m2_config.vap_label << "' for SSID: " << info.payload_config.ssid;
         }
 
+        // For controllers that do not send Airties vendor extensions (e.g. rdk_controller),
+        // fall back to deriving vap_type and vap_label from the haul_type encoded in the
+        // Comcast vendor extension inside the encrypted settings.
+#ifdef BEEROCKS_RDKB
+        if (info.m2_config.vap_type == eVapType::OTHER && info.m2_config.vap_label.empty()) {
+            if (static_cast<em_haul_type_t>(info.payload_config.haul_type) != bwl::EM_HAUL_TYPE_INVALID) {
+                const em_haul_type_t haul = static_cast<em_haul_type_t>(info.payload_config.haul_type);
+                std::string vap_type_str, vap_label_str;
+                if (bwl::get_haul_type_label(static_cast<uint8_t>(haul),
+                                             vap_type_str, vap_label_str)) {
+                    info.m2_config.vap_type  = son::wireless_utils::string_to_vap_type(vap_type_str);
+                    info.m2_config.vap_label = vap_label_str;
+                    LOG(INFO) << "Derived vap_type=" << eVapType_str(info.m2_config.vap_type)
+                              << " vap_label='" << info.m2_config.vap_label
+                              << "' from encrypted haul_type=" << static_cast<int>(haul)
+                              << " for SSID: " << info.payload_config.ssid;
+                }
+            }
+        }
+#endif // BEEROCKS_RDKB
+
         info.m2_config.hidden_ssid = m2.hidden_ssid();
 
         uint8_t airties_bss_profile = 0;
@@ -5964,6 +5988,9 @@ bool ApAutoConfigurationTask::ap_autoconfiguration_wsc_parse_encrypted_settings(
     payload_config.network_key = config_data->network_key();
     payload_config.ssid        = config_data->ssid();
     payload_config.bss_type    = config_data->bss_type();
+#ifdef BEEROCKS_RDKB
+    payload_config.haul_type   = config_data->haul_type();
+#endif // BEEROCKS_RDKB
 
     // Get the Key Wrap Authenticator data
     auto kwa_data = config_data->key_wrap_authenticator();
diff --git a/framework/tlvf/src/include/tlvf/WSC/EncryptedSettingsPayload.h b/framework/tlvf/src/include/tlvf/WSC/EncryptedSettingsPayload.h
index ce8ae67a0..2a06858c6 100644
--- a/framework/tlvf/src/include/tlvf/WSC/EncryptedSettingsPayload.h
+++ b/framework/tlvf/src/include/tlvf/WSC/EncryptedSettingsPayload.h
@@ -10,6 +10,7 @@
 #define _TLVF_WSC_ENCRYPTEDSETTINGSPAYLOAD_H_
 
 #include <tlvf/WSC/WscAttrList.h>
+#include <tlvf/WSC/eWscVendorExt.h>
 #include <tlvf/tlvflogging.h>
 
 namespace WSC {
@@ -51,6 +52,9 @@ public:
 
         /* Multi-AP Identifier value (WFA Vendor Extension subelement: MULTI_AP_IDENTIFIER) */
         uint8_t bss_type{WSC::eWscVendorExtSubelementBssType::TEARDOWN};
+
+        /* Haul type from Comcast/RDK vendor extension (tag 0x01 in OUI d8:9c:8e); 0xFF = absent */
+        uint8_t haul_type{0xFF};
     };
 
     EncryptedSettingsPayload(uint8_t *buff, size_t buff_len, bool parse)
@@ -125,6 +129,23 @@ public:
 
         return default_value;
     };
+    uint8_t haul_type() const
+    {
+        for (auto &vendor_ext_attr : getAttrList<cWscAttrVendorExtension>()) {
+            if (vendor_ext_attr->vendor_id_0() != eWscVendorId::WSC_VENDOR_ID_COMCAST_1 ||
+                vendor_ext_attr->vendor_id_1() != eWscVendorId::WSC_VENDOR_ID_COMCAST_2 ||
+                vendor_ext_attr->vendor_id_2() != eWscVendorId::WSC_VENDOR_ID_COMCAST_3) {
+                continue;
+            }
+            auto vendor_data = vendor_ext_attr->vendor_data();
+            // Flat {tag(1), value(1)} encoding; vendor_data_length must be >= 2.
+            if (vendor_data != nullptr && vendor_ext_attr->vendor_data_length() >= 2 &&
+                vendor_data[0] == static_cast<uint8_t>(eWscComcastAttrHaulType::WSC_COMCAST_ATTR_HAUL_TYPE)) {
+                return vendor_data[1];
+            }
+        }
+        return static_cast<uint8_t>(eWscComcastAttrHaulType::WSC_COMCAST_HAUL_TYPE_INVALID);
+    };
     uint8_t *key_wrap_authenticator() const
     {
         auto attr = getAttr<cWscAttrKeyWrapAuthenticator>();
diff --git a/framework/tlvf/yaml/tlvf/WSC/eWscVendorExt.yaml b/framework/tlvf/yaml/tlvf/WSC/eWscVendorExt.yaml
index 41aa3ebc2..705fd322f 100644
--- a/framework/tlvf/yaml/tlvf/WSC/eWscVendorExt.yaml
+++ b/framework/tlvf/yaml/tlvf/WSC/eWscVendorExt.yaml
@@ -14,3 +14,8 @@ eWscVendorExtSubelementBssType:
 eWscVendorExtVersionIE:
   _type: enum
   WSC_VERSION2: 0x20
+
+eWscComcastAttrHaulType:
+  _type: enum
+  WSC_COMCAST_ATTR_HAUL_TYPE: 0x01
+  WSC_COMCAST_HAUL_TYPE_INVALID: 0xFF
diff --git a/framework/tlvf/yaml/tlvf/WSC/eWscVendorId.yaml b/framework/tlvf/yaml/tlvf/WSC/eWscVendorId.yaml
index 29a773743..3481e1f5c 100644
--- a/framework/tlvf/yaml/tlvf/WSC/eWscVendorId.yaml
+++ b/framework/tlvf/yaml/tlvf/WSC/eWscVendorId.yaml
@@ -10,3 +10,6 @@ eWscVendorId:
   WSC_VENDOR_ID_AIRTIES_1: 0x88
   WSC_VENDOR_ID_AIRTIES_2: 0x41
   WSC_VENDOR_ID_AIRTIES_3: 0xFC
+  WSC_VENDOR_ID_COMCAST_1: 0xD8
+  WSC_VENDOR_ID_COMCAST_2: 0x9C
+  WSC_VENDOR_ID_COMCAST_3: 0x8E
-- 
2.34.1

