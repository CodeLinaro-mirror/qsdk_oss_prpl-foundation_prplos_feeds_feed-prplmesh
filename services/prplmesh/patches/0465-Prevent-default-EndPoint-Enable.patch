From e6e638bb23baf85b8f9d2eaf76c1374031bf5f6a Mon Sep 17 00:00:00 2001
From: Vinu Bharath R <vinubhar@qti.qualcomm.com>
Date: Mon, 28 Sep 2026 15:21:01 +0530
Subject: [PATCH] Prevent default EndPoint Enable

Signed-off-by: Vinu Bharath R <vinubhar@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp | 12 +++---------
 1 file changed, 3 insertions(+), 9 deletions(-)

diff --git a/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
index 665e5245d..d743a069f 100644
--- a/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/sta_wlan_hal_whm.cpp
@@ -117,12 +117,12 @@ sta_wlan_hal_whm::sta_wlan_hal_whm(const std::string &iface_name, hal_event_cb_t
     }
 
     if (!m_ep_path.empty() && hal_conf.is_repeater) {
-        // Enable the endpoint instance
+        // Preserve the platform-configured EndPoint Enable state. The backhaul manager
+        // explicitly enables the EndPoint when a wireless connection attempt is required.
         AmbiorixVariant params(AMXC_VAR_ID_HTABLE);
-        params.add_child<bool>("Enable", true);
         params.add_child("MultiAPProfile", hal_conf.multi_ap_profile);
         bool ret = m_ambiorix_cl.update_object(m_ep_path, params);
-        LOG_IF((!ret), ERROR) << "Failed to enable endpoint, path:" << m_ep_path;
+        LOG_IF((!ret), ERROR) << "Failed to update endpoint MultiAPProfile, path:" << m_ep_path;
     }
 
     LOG(DEBUG) << "init sta_wlan_hal_whm for " << m_ep_path << " with radio " << m_radio_path;
@@ -908,12 +908,6 @@ bool sta_wlan_hal_whm::reconnect_backhaul_sta()
         return false;
     }
 
-    // Enable EndPoint
-    if (!enable_disable_ep(true)) {
-        LOG(ERROR) << "Failed to enable EndPoint for reconnection";
-        return false;
-    }
-
     LOG(DEBUG) << "Enabled profile_id " << m_active_profile_id << " for reconnection " << get_iface_name();
 
     return true;
-- 
2.34.1

