diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index f76e9da0e..ef7ba0851 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -25,6 +25,7 @@
 #include <cstring>
 #include <unistd.h>
 #include <cstdio>
+#include <cstdlib>
 #include <iomanip>
 #include <sstream>
 #include <thread>
@@ -9950,15 +9951,265 @@ bool ap_wlan_hal_nl80211::set_hop_count(uint8_t hop_count)
 bool ap_wlan_hal_nl80211::set_spatial_reuse_config(
     son::wireless_utils::sSpatialReuseParams &spatial_reuse_params)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return false;
+    const std::string target_iface = m_radio_info.iface_name;
+
+    if (!is_wpa_ctrl_interface_registered(target_iface)) {
+        LOG(DEBUG) << __func__ << ": iface " << target_iface
+                   << " not registered yet, registering its wpa_ctrl socket";
+        if (add_interface(target_iface) < 0) {
+            LOG(WARNING) << __func__ << ": add_interface(" << target_iface
+                         << ") failed; will still attempt hostapd commands";
+        }
+    }
+
+    const uint8_t sr_control =
+        (spatial_reuse_params.psr_disallowed ? 0x01 : 0x00) |
+        (spatial_reuse_params.non_srg_offset_valid ? 0x04 : 0x00) |
+        (spatial_reuse_params.srg_information_valid ? 0x08 : 0x00) |
+        (spatial_reuse_params.hesiga_spatial_reuse_value15_allowed ? 0x10 : 0x00);
+
+    LOG(INFO) << __func__ << ": setting spatial reuse config on iface=" << target_iface
+              << " bss_color=" << int(spatial_reuse_params.bss_color)
+              << " partial_bss_color=" << int(spatial_reuse_params.partial_bss_color)
+              << " he_spr_sr_control=" << int(sr_control)
+              << " psr_disallowed=" << spatial_reuse_params.psr_disallowed
+              << " non_srg_offset_valid=" << spatial_reuse_params.non_srg_offset_valid
+              << " srg_information_valid=" << spatial_reuse_params.srg_information_valid
+              << " hesiga_spatial_reuse_value15_allowed="
+              << spatial_reuse_params.hesiga_spatial_reuse_value15_allowed
+              << " non_srg_obsspd_max_offset="
+              << int(spatial_reuse_params.non_srg_obsspd_max_offset)
+              << " srg_obsspd_min_offset=" << int(spatial_reuse_params.srg_obsspd_min_offset)
+              << " srg_obsspd_max_offset=" << int(spatial_reuse_params.srg_obsspd_max_offset)
+              << " srg_bss_color_bitmap=" << spatial_reuse_params.srg_bss_color_bitmap
+              << " srg_partial_bssid_bitmap="
+              << spatial_reuse_params.srg_partial_bssid_bitmap;
+
+    auto send_hostapd_set = [&](const std::string &param, const std::string &value) {
+        const std::string cmd = "SET " + param + " " + value;
+        std::string reply;
+
+        LOG(DEBUG) << __func__ << ": sending hostapd command on iface=" << target_iface
+                   << " cmd='" << cmd << "'";
+        if (!wpa_ctrl_send_msg_bufsize(cmd, reply, BUFFER_SIZE, target_iface)) {
+            LOG(ERROR) << __func__ << ": hostapd command failed on iface=" << target_iface
+                       << " cmd='" << cmd << "' reply='" << reply << "'";
+            return false;
+        }
+        beerocks::string_utils::trim(reply);
+        LOG(DEBUG) << __func__ << ": hostapd command succeeded on iface=" << target_iface
+                   << " cmd='" << cmd << "' reply='" << reply << "'";
+        return true;
+    };
+
+    auto bitmap_uint64_to_string = [](uint64_t bitmap) {
+        std::string value;
+        for (int bit = 0; bit < 64; ++bit) {
+            if (!((bitmap >> bit) & 1)) {
+                continue;
+            }
+            if (!value.empty()) {
+                value += ' ';
+            }
+            value += std::to_string(bit);
+        }
+        return value;
+    };
+
+    bool success = true;
+    success &= send_hostapd_set("he_bss_color", std::to_string(spatial_reuse_params.bss_color));
+    success &= send_hostapd_set("he_bss_color_partial",
+                                std::to_string(spatial_reuse_params.partial_bss_color));
+    success &= send_hostapd_set("he_spr_sr_control", std::to_string(sr_control));
+    if (spatial_reuse_params.non_srg_offset_valid) {
+        success &= send_hostapd_set(
+            "he_spr_non_srg_obss_pd_max_offset",
+            std::to_string(spatial_reuse_params.non_srg_obsspd_max_offset));
+    }
+    if (spatial_reuse_params.srg_information_valid) {
+        success &= send_hostapd_set("he_spr_srg_obss_pd_min_offset",
+                                    std::to_string(spatial_reuse_params.srg_obsspd_min_offset));
+        success &= send_hostapd_set("he_spr_srg_obss_pd_max_offset",
+                                    std::to_string(spatial_reuse_params.srg_obsspd_max_offset));
+        success &= send_hostapd_set("he_spr_srg_bss_colors",
+                                    bitmap_uint64_to_string(
+                                        spatial_reuse_params.srg_bss_color_bitmap));
+        success &= send_hostapd_set(
+            "he_spr_srg_partial_bssid",
+            bitmap_uint64_to_string(spatial_reuse_params.srg_partial_bssid_bitmap));
+    }
+
+    if (!success) {
+        LOG(ERROR) << __func__ << ": failed to set one or more spatial reuse parameters on iface="
+                   << target_iface;
+        return false;
+    }
+
+    if (!update_beacon(target_iface)) {
+        LOG(ERROR) << __func__ << ": UPDATE_BEACON failed after spatial reuse config on iface="
+                   << target_iface;
+        return false;
+    }
+
+    LOG(INFO) << __func__ << ": spatial reuse config set successfully on iface=" << target_iface;
+    return true;
 }
 
 bool ap_wlan_hal_nl80211::get_spatial_reuse_config(
     son::wireless_utils::sSpatialReuseParams &spatial_reuse_params)
 {
-    LOG(TRACE) << __func__ << " - NOT IMPLEMENTED!";
-    return false;
+    const std::string target_iface = m_radio_info.iface_name;
+
+    if (!is_wpa_ctrl_interface_registered(target_iface)) {
+        LOG(DEBUG) << __func__ << ": iface " << target_iface
+                   << " not registered yet, registering its wpa_ctrl socket";
+        if (add_interface(target_iface) < 0) {
+            LOG(WARNING) << __func__ << ": add_interface(" << target_iface
+                         << ") failed; will still attempt hostapd commands";
+        }
+    }
+
+    auto get_hostapd_value = [&](const std::string &param, std::string &value) {
+        const std::string cmd = "GET " + param;
+        std::string reply;
+
+        LOG(DEBUG) << __func__ << ": sending hostapd command on iface=" << target_iface
+                   << " cmd='" << cmd << "'";
+        if (!wpa_ctrl_send_msg_bufsize(cmd, reply, BUFFER_SIZE, target_iface)) {
+            LOG(ERROR) << __func__ << ": hostapd command failed on iface=" << target_iface
+                       << " cmd='" << cmd << "' reply='" << reply << "'";
+            return false;
+        }
+        beerocks::string_utils::trim(reply);
+        value = reply;
+        LOG(DEBUG) << __func__ << ": hostapd returned " << param << "='" << value
+                   << "' on iface=" << target_iface;
+        return true;
+    };
+
+    auto get_hostapd_uint = [&](const std::string &param, uint64_t &value) {
+        std::string value_str;
+        if (!get_hostapd_value(param, value_str)) {
+            return false;
+        }
+        if (value_str.empty()) {
+            LOG(ERROR) << __func__ << ": empty hostapd value for " << param
+                       << " on iface=" << target_iface;
+            return false;
+        }
+
+        char *end = nullptr;
+        value     = std::strtoull(value_str.c_str(), &end, 0);
+        if (!end || *end != '\0') {
+            LOG(ERROR) << __func__ << ": invalid numeric hostapd value for " << param
+                       << " on iface=" << target_iface << " value='" << value_str << "'";
+            return false;
+        }
+        return true;
+    };
+
+    auto bitmap_string_to_uint64 = [](std::string bitmap_str) {
+        uint64_t result = 0;
+        beerocks::string_utils::trim(bitmap_str);
+        if (bitmap_str.empty()) {
+            return result;
+        }
+
+        for (auto &c : bitmap_str) {
+            if (c == ',') {
+                c = ' ';
+            }
+        }
+
+        std::istringstream ss(bitmap_str);
+        int bit = 0;
+        while (ss >> bit) {
+            if (bit < 0 || bit > 63) {
+                LOG(WARNING) << "Invalid spatial reuse bitmap bit index " << bit
+                             << " in hostapd value '" << bitmap_str << "'";
+                continue;
+            }
+            result |= (1ULL << bit);
+        }
+        return result;
+    };
+
+    uint64_t bss_color                = 0;
+    uint64_t partial_bss_color        = 0;
+    uint64_t sr_control               = 0;
+    bool success = true;
+    success &= get_hostapd_uint("he_bss_color", bss_color);
+    success &= get_hostapd_uint("he_bss_color_partial", partial_bss_color);
+    success &= get_hostapd_uint("he_spr_sr_control", sr_control);
+
+    if (!success) {
+        LOG(ERROR) << __func__ << ": failed to get mandatory spatial reuse parameters on iface="
+                   << target_iface;
+        return false;
+    }
+
+    spatial_reuse_params.bss_color = static_cast<uint8_t>(bss_color);
+    spatial_reuse_params.partial_bss_color = static_cast<uint8_t>(partial_bss_color);
+    spatial_reuse_params.psr_disallowed = sr_control & 0x01;
+    spatial_reuse_params.non_srg_offset_valid = sr_control & 0x04;
+    spatial_reuse_params.srg_information_valid = sr_control & 0x08;
+    spatial_reuse_params.hesiga_spatial_reuse_value15_allowed = sr_control & 0x10;
+
+    spatial_reuse_params.non_srg_obsspd_max_offset = 0;
+    spatial_reuse_params.srg_obsspd_min_offset     = 0;
+    spatial_reuse_params.srg_obsspd_max_offset     = 0;
+    spatial_reuse_params.srg_bss_color_bitmap      = 0;
+    spatial_reuse_params.srg_partial_bssid_bitmap  = 0;
+
+    if (spatial_reuse_params.non_srg_offset_valid) {
+        uint64_t non_srg_obsspd_max = 0;
+        if (!get_hostapd_uint("he_spr_non_srg_obss_pd_max_offset", non_srg_obsspd_max)) {
+            LOG(ERROR) << __func__ << ": failed to get Non-SRG OBSS PD max offset on iface="
+                       << target_iface;
+            return false;
+        }
+        spatial_reuse_params.non_srg_obsspd_max_offset =
+            static_cast<uint8_t>(non_srg_obsspd_max);
+    }
+
+    if (spatial_reuse_params.srg_information_valid) {
+        uint64_t srg_obsspd_min = 0;
+        uint64_t srg_obsspd_max = 0;
+        std::string srg_bss_colors;
+        std::string srg_partial_bssid;
+
+        success &= get_hostapd_uint("he_spr_srg_obss_pd_min_offset", srg_obsspd_min);
+        success &= get_hostapd_uint("he_spr_srg_obss_pd_max_offset", srg_obsspd_max);
+        success &= get_hostapd_value("he_spr_srg_bss_colors", srg_bss_colors);
+        success &= get_hostapd_value("he_spr_srg_partial_bssid", srg_partial_bssid);
+        if (!success) {
+            LOG(ERROR) << __func__ << ": failed to get SRG information on iface=" << target_iface;
+            return false;
+        }
+
+        spatial_reuse_params.srg_obsspd_min_offset = static_cast<uint8_t>(srg_obsspd_min);
+        spatial_reuse_params.srg_obsspd_max_offset = static_cast<uint8_t>(srg_obsspd_max);
+        spatial_reuse_params.srg_bss_color_bitmap = bitmap_string_to_uint64(srg_bss_colors);
+        spatial_reuse_params.srg_partial_bssid_bitmap = bitmap_string_to_uint64(srg_partial_bssid);
+    }
+
+    LOG(INFO) << __func__ << ": got spatial reuse config from iface=" << target_iface
+              << " bss_color=" << int(spatial_reuse_params.bss_color)
+              << " partial_bss_color=" << int(spatial_reuse_params.partial_bss_color)
+              << " he_spr_sr_control=" << sr_control
+              << " psr_disallowed=" << spatial_reuse_params.psr_disallowed
+              << " non_srg_offset_valid=" << spatial_reuse_params.non_srg_offset_valid
+              << " srg_information_valid=" << spatial_reuse_params.srg_information_valid
+              << " hesiga_spatial_reuse_value15_allowed="
+              << spatial_reuse_params.hesiga_spatial_reuse_value15_allowed
+              << " non_srg_obsspd_max_offset="
+              << int(spatial_reuse_params.non_srg_obsspd_max_offset)
+              << " srg_obsspd_min_offset=" << int(spatial_reuse_params.srg_obsspd_min_offset)
+              << " srg_obsspd_max_offset=" << int(spatial_reuse_params.srg_obsspd_max_offset)
+              << " srg_bss_color_bitmap=" << spatial_reuse_params.srg_bss_color_bitmap
+              << " srg_partial_bssid_bitmap="
+              << spatial_reuse_params.srg_partial_bssid_bitmap;
+    return true;
 }
 
