 {
+    /* Take ownership of the pending list up front: claim it under the lock and
+     * process the (slow, blocking) debugfs reads on a local copy. This keeps the
+     * lock hold short and guarantees that a concurrent
+     * sta_unassoc_rssi_measurement() on the monitor thread cannot append to the
+     * batch we are about to drain — an entry added after this point belongs to
+     * the next ROC scan, not this one. */
+    std::vector<UnassocMeasurementContext> measurements;
+    {
+        std::lock_guard<std::mutex> lock(m_pending_unassoc_mutex);
+        measurements.swap(m_pending_unassoc_measurements);
+    }
+
     LOG(DEBUG) << "Unassoc link metric query - slave gets driver event on scan complete: "
-                << "pending_measurements=" << m_pending_unassoc_measurements.size();
-
-    // Both the monitor and the ap_manager processes subscribe to the same nl80211
-    // mlme multicast group, so the kernel delivers the ROC-expired event to both.
-    // Only the process that initiated the ROC scan (the monitor) has pending
-    // measurements.  If this instance has none, the event belongs to another
-    // process — silently ignore it.  Without this guard the ap_manager pushes an
-    // empty Unassociation_Stations_Stats event which causes the controller to
-    // receive RCPI=32 (noise floor) for every unassoc query.
-    if (m_pending_unassoc_measurements.empty()) {
+                << "pending_measurements=" << measurements.size();
+
+    // An empty pending list means there is no measurement to report. This happens
+    // when the query was cancelled after the ROC was triggered but before this
+    // callback ran (see sta_unassoc_rssi_measurement's failure paths), or when a
+    // duplicate ROC-expired notification arrives. Return without pushing an event:
+    // pushing an empty Unassociation_Stations_Stats makes the controller record
+    // RCPI=32 (noise floor) for every unassoc query.
+    if (measurements.empty()) {
