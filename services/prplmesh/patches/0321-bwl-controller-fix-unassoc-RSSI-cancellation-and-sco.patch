     // Allocate buffer for the event data
     auto msg_buff = ALLOC_SMART_BUFFER(sizeof(stats_out));
@@ -1616,8 +1637,38 @@ bool mon_wlan_hal_nl80211::process_roc_expired_event()
 }
 
 /**
- * @brief Initiates RSSI measurement for a list of unassociated STAs.
+ * @brief Cancels the pending unassoc measurements for the given MACs.
+ *
+ * Removes each MAC's debugfs neighbor_peer entry and drops its context from
+ * m_pending_unassoc_measurements. Only the listed MACs are touched, so contexts
+ * belonging to another, still-in-flight ROC scan are left intact. A MAC that is
+ * no longer in the list (its scan already completed and drained it) is skipped.
  */
+void mon_wlan_hal_nl80211::drop_pending_unassoc_measurements(
+        const std::vector<std::string> &mac_addresses)
+{
+    for (const auto &mac_address : mac_addresses) {
+        bool was_pending = false;
+        {
+            std::lock_guard<std::mutex> lock(m_pending_unassoc_mutex);
+            auto it = std::find_if(m_pending_unassoc_measurements.begin(),
+                                   m_pending_unassoc_measurements.end(),
+                                   [&](const UnassocMeasurementContext &ctx) {
+                                       return ctx.mac_address == mac_address;
+                                   });
+            if (it != m_pending_unassoc_measurements.end()) {
+                m_pending_unassoc_measurements.erase(it);
+                was_pending = true;
+            }
+        }
+        /* Only undo the debugfs add if we actually owned the context; if the
+         * measurement already completed it removed the neighbor itself. */
+        if (was_pending) {
+            remove_peer_neighbor(mac_address);
+        }
+    }
+}
+
 bool mon_wlan_hal_nl80211::sta_unassoc_rssi_measurement(
         std::unordered_map<std::string, sUnassocStaParams> &new_list)
 {
@@ -1629,81 +1680,125 @@ bool mon_wlan_hal_nl80211::sta_unassoc_rssi_measurement(
 
     uint8_t first_channel = 0;
 
-    // Prepare all STAs for measurement
-    for (auto &sta : new_list) {
-        const std::string &mac_address = sta.first;
-        uint8_t channel                = sta.second.channel;
+    /* MACs this invocation added to the pending list. The list may already hold
+     * entries from a PREVIOUS, still-in-flight ROC scan (a repeat query arriving
+     * inside the ~600ms ROC window); those belong to that scan, not to this call,
+     * so this call must neither count them as its own work nor tear them down on
+     * its error paths. Tracked by MAC rather than by index because the sleeper
+     * thread of an earlier scan can drain the list while we are not holding the
+     * lock. */
+    std::vector<std::string> added_by_this_call;
+    size_t pre_existing_count = 0;
 
-        // Validate channel number
-        if (channel == 0) {
-            LOG(ERROR) << "Invalid channel (0) for STA: " << mac_address;
-            continue;
-        }
+    {
+        std::lock_guard<std::mutex> lock(m_pending_unassoc_mutex);
 
-        /* Pre-check: if this MAC is already in m_pending_unassoc_measurements,
-         * a ROC scan is already in progress for it (triggered by a previous query
-         * that arrived within the 600ms ROC window).  Skip the echo-add entirely
-         * to avoid the EEXIST kernel error storm — the in-flight ROC scan will
-         * return the RSSI when it expires. */
-        bool already_pending = std::any_of(
-            m_pending_unassoc_measurements.begin(),
-            m_pending_unassoc_measurements.end(),
-            [&](const UnassocMeasurementContext &ctx) {
-                return ctx.mac_address == mac_address;
-            });
-        if (already_pending) {
-            LOG(DEBUG) << "sta_unassoc_rssi_measurement: " << mac_address
-                       << " already in pending list — ROC scan in progress, skipping re-add";
-            continue;
-        }
+        pre_existing_count = m_pending_unassoc_measurements.size();
 
-        // Add STA to the driver's debugfs list for monitoring
-        bool already_exists = false;
-        if (!add_peer_neighbor(mac_address, &already_exists)) {
-            if (already_exists) {
-                /* STA is currently associated on this radio — driver cannot
-                 * measure it as an unassociated peer via ROC scan.  Skip it
-                 * silently; the unassoc query for this STA will return RCPI=0
-                 * (noise floor) which the steering app treats as no-measurement.
-                 *
-                 * Note: the "already in pending list" case (repeated query within
-                 * the 600ms ROC window) is handled by the pre-check above, so
-                 * EEXIST here genuinely means the STA is associated. */
-                LOG(INFO) << "sta_unassoc_rssi_measurement: skipping " << mac_address
-                          << " (associated peer on this radio)";
-            } else {
-                LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+        // Prepare all STAs for measurement
+        for (auto &sta : new_list) {
+            const std::string &mac_address = sta.first;
+            uint8_t channel                = sta.second.channel;
+
+            // Validate channel number
+            if (channel == 0) {
+                LOG(ERROR) << "Invalid channel (0) for STA: " << mac_address;
+                continue;
             }
-            continue;
-        }
 
-        // Use the channel of the first valid STA for the ROC scan
-        if (first_channel == 0) {
-            first_channel = channel;
-        }
+            /* Pre-check: if this MAC is already in m_pending_unassoc_measurements,
+             * a ROC scan is already in progress for it (triggered by a previous query
+             * that arrived within the 600ms ROC window).  Skip the echo-add entirely
+             * to avoid the EEXIST kernel error storm — the in-flight ROC scan will
+             * return the RSSI when it expires. */
+            bool already_pending = std::any_of(
+                m_pending_unassoc_measurements.begin(),
+                m_pending_unassoc_measurements.end(),
+                [&](const UnassocMeasurementContext &ctx) {
+                    return ctx.mac_address == mac_address;
+                });
+            if (already_pending) {
+                LOG(DEBUG) << "sta_unassoc_rssi_measurement: " << mac_address
+                           << " already in pending list — ROC scan in progress, skipping re-add";
+                continue;
+            }
 
-        // Store context for this measurement
-        UnassocMeasurementContext ctx;
-        ctx.mac_address = mac_address;
-        ctx.channel     = channel;
-        ctx.start_time  = std::chrono::steady_clock::now();
-        m_pending_unassoc_measurements.push_back(ctx);
+            // Add STA to the driver's debugfs list for monitoring
+            bool already_exists = false;
+            if (!add_peer_neighbor(mac_address, &already_exists)) {
+                if (already_exists) {
+                    /* STA is currently associated on this radio — driver cannot
+                     * measure it as an unassociated peer via ROC scan.  Skip it
+                     * silently; the unassoc query for this STA will return RCPI=0
+                     * (noise floor) which the steering app treats as no-measurement.
+                     *
+                     * Note: the "already in pending list" case (repeated query within
+                     * the 600ms ROC window) is handled by the pre-check above, so
+                     * EEXIST here genuinely means the STA is associated. */
+                    LOG(INFO) << "sta_unassoc_rssi_measurement: skipping " << mac_address
+                              << " (associated peer on this radio)";
+                } else {
+                    LOG(ERROR) << "Failed to add peer neighbor: " << mac_address;
+                }
+                continue;
+            }
+
+            // Use the channel of the first valid STA for the ROC scan
+            if (first_channel == 0) {
+                first_channel = channel;
+            }
+
+            // Store context for this measurement
+            UnassocMeasurementContext ctx;
+            ctx.mac_address = mac_address;
+            ctx.channel     = channel;
+            ctx.start_time  = std::chrono::steady_clock::now();
+            m_pending_unassoc_measurements.push_back(ctx);
+            added_by_this_call.push_back(mac_address);
+        }
     }
 
-    if (m_pending_unassoc_measurements.empty()) {
+    if (added_by_this_call.empty()) {
+        /* Nothing was added this call, so there is no new work and — critically —
+         * no channel to scan: first_channel is only ever set alongside a
+         * successful add. Testing the whole list for emptiness here instead
+         * meant that when every STA was skipped but an earlier scan was still
+         * in flight, we fell through to trigger_roc_scan(0), which failed
+         * ("invalid 2.4ghz channel: 0") and then ran the failure cleanup over
+         * the WHOLE list — deleting the in-flight scan's debugfs neighbor entry
+         * and clearing its context. The sleeper thread then found
+         * pending_measurements=0 and dropped the ROC event, so no
+         * Unassociation_Stations_Stats was ever pushed and the controller got
+         * no RCPI for the STA at all. */
+        if (pre_existing_count > 0) {
+            LOG(DEBUG) << "sta_unassoc_rssi_measurement: every requested STA is already being "
+                          "measured by an in-flight ROC scan ("
+                       << pre_existing_count
+                       << " pending) — not starting another; that scan will report the RSSI";
+            return true;
+        }
         LOG(ERROR) << "No valid STAs to measure";
         return false;
     }
 
+    /* Invariant: first_channel is assigned for every STA appended above, so a
+     * non-empty added_by_this_call implies a valid channel. Guard it anyway
+     * rather than risk handing channel 0 to the kernel. */
+    if (first_channel == 0) {
+        LOG(ERROR) << "sta_unassoc_rssi_measurement: " << added_by_this_call.size()
+                   << " STA(s) queued but no valid scan channel resolved";
+        drop_pending_unassoc_measurements(added_by_this_call);
+        return false;
+    }
+
     // Trigger a single ROC scan. All measurements will be based on this scan.
     uint32_t roc_duration_ms = 100;
     if (!trigger_roc_scan(first_channel, roc_duration_ms)) {
         LOG(ERROR) << "Failed to trigger ROC scan on channel " << int(first_channel);
-        // Clean up all pending measurements if ROC scan fails
-        for (auto &measurement : m_pending_unassoc_measurements) {
-            remove_peer_neighbor(measurement.mac_address);
-        }
-        m_pending_unassoc_measurements.clear();
+        /* Clean up only the measurements THIS call added. Entries from an
+         * earlier in-flight scan must survive — tearing them down here is what
+         * silently killed a good measurement that was about to complete. */
+        drop_pending_unassoc_measurements(added_by_this_call);
         return false;
     }
 
