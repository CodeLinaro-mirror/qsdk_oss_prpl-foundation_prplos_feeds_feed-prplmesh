     if (!mon_stats.add_radio_metrics(cmdu_tx, m_radio_mac, *mon_db.get_radio_node())) {
diff --git a/agent/src/beerocks/fronthaul_manager/monitor/monitor_stats.cpp b/agent/src/beerocks/fronthaul_manager/monitor/monitor_stats.cpp
