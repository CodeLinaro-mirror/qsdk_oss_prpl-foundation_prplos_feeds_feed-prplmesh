-        if (f) {
-            fclose(f);
-            LOG(INFO) << "handle_ap_autoconfiguration_wsc_renew: cleared " << mld_entrant_file;
-        } else {
-            LOG(WARNING) << "handle_ap_autoconfiguration_wsc_renew: failed to clear "
-                         << mld_entrant_file;
-        }
-    }
-#endif // USE_PRPLMESH_NLHAL
-
     for (const auto radio : db->get_radios_list()) {
         if (!radio) {
             return;
@@ -3416,8 +3395,12 @@ bool ApAutoConfigurationTask::handle_agent_ap_mld_configuration_tlv(
     };
 
     // Process all radios for missing mld links
-    for (auto radio : db->get_radios_list()) {
-        process_missing_mld_links(radio->front.iface_name);
