+bool bpl_cfg_set_wifi_compat_mode_uci(const son::wireless_utils::sBssInfoConf &bss_conf,
+                                      const std::string &old_bss_name,
+                                      const std::string &new_bss_name,
+                                      const std::string &radio_id)
+{
+    const std::string package_name = "wireless";
+    const std::string section_type = "wifi-iface";
+
+    LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: ssid='" << bss_conf.ssid
+              << "' old_bss='" << old_bss_name << "' new_bss='" << new_bss_name
+              << "' radio_id='" << radio_id
+              << "' wifi_compat_mode=" << int(bss_conf.wifi_compat_mode);
+
+    // Find the wifi-device section for this radio
+    std::string device_section;
+    if (!radio_id.empty() &&
+        uci_find_section_by_option("wireless", "wifi-device", "radio", radio_id,
+                                   device_section)) {
+        LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: found device section '"
+                  << device_section << "' for radio_id='" << radio_id << "'";
+    } else {
+        LOG(ERROR) << "bpl_cfg_set_wifi_compat_mode_uci: no wifi-device section found for"
+                   << " radio_id='" << radio_id << "'";
+        return false;
+    }
+
+    // Get all wifi-iface sections
+    std::vector<std::string> all_sections;
+    if (!uci_get_all_sections(package_name, section_type, all_sections)) {
+        LOG(ERROR) << "bpl_cfg_set_wifi_compat_mode_uci: failed to enumerate wifi-iface sections";
+        return false;
+    }
+
+    bool updated = false;
+    for (const auto &sec : all_sections) {
+        // Match by device (radio)
+        std::string device_val;
+        if (!uci_get_option(package_name, section_type, sec, "device", device_val) ||
+            device_val != device_section) {
+            continue;
+        }
+
+        // Match by SSID
+        std::string ssid_val;
+        if (!uci_get_option(package_name, section_type, sec, "ssid", ssid_val) ||
+            ssid_val != bss_conf.ssid) {
+            continue;
+        }
+
+        // Optionally narrow by old ifname (if provided)
+        if (!old_bss_name.empty()) {
+            std::string ifname_val;
+            if (uci_get_option(package_name, section_type, sec, "ifname", ifname_val) &&
+                !ifname_val.empty() && ifname_val != old_bss_name) {
+                LOG(DEBUG) << "bpl_cfg_set_wifi_compat_mode_uci: section=" << sec
+                           << " ifname='" << ifname_val << "' does not match old_bss='"
+                           << old_bss_name << "', skipping";
+                continue;
+            }
+        }
+
+        LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: matched section=" << sec
+                  << " (ssid='" << bss_conf.ssid << "' device='" << device_section << "')";
+
+        OptionsUnorderedMap options;
+        options["ifname"] = new_bss_name;
+
+        // For 11AX mode: capture the current mld value before clearing it so we can
+        // check afterwards whether this was the last link referencing that wifi-mld section.
+        std::string current_mld_val;
+
+        if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX) {
+            // MLO → SLO: set disable_11be=1, clear mld option
+            uci_get_option(package_name, section_type, sec, "mld", current_mld_val);
+            options["disable_11be"] = "1";
+            options["mld"]          = ""; // empty string removes the option
+            LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: 11AX mode -"
+                      << " setting disable_11be=1, clearing mld='" << current_mld_val
+                      << "', ifname='" << new_bss_name << "'";
+        } else if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
+            // SLO → MLO: clear disable_11be, set mld option if mld_id is valid
+            options["disable_11be"] = ""; // empty string removes the option
+            if (!bss_conf.mld_id.empty() &&
+                bss_conf.mld_id != std::to_string(beerocks::DISABLED_MLDUNIT)) {
+                // Before using the mld_id from bss_conf, check if an existing wifi-mld
+                // section already carries the same SSID. If so, reuse that section's
+                // mld_id so we don't create a duplicate MLD group for the same network.
+                std::string effective_mld_id = bss_conf.mld_id;
+                const std::string mld_section_type = "wifi-mld";
+                std::vector<std::string> all_mld_sections;
+                if (uci_get_all_sections(package_name, mld_section_type, all_mld_sections)) {
+                    for (const auto &mld_sec : all_mld_sections) {
+                        std::string mld_ssid_val;
+                        if (!uci_get_option(package_name, mld_section_type, mld_sec,
+                                            "ssid", mld_ssid_val)) {
+                            continue;
+                        }
+                        if (mld_ssid_val == bss_conf.ssid) {
+                            // Found an existing wifi-mld section with matching SSID.
+                            // Extract the numeric suffix (e.g. "mld3" → "3").
+                            std::string mld_index_str;
+                            for (char ch : mld_sec) {
+                                if (isdigit(static_cast<unsigned char>(ch))) {
+                                    mld_index_str += ch;
+                                }
+                            }
+                            if (!mld_index_str.empty()) {
+                                effective_mld_id = mld_index_str;
+                                LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: found existing"
+                                          << " wifi-mld section '" << mld_sec
+                                          << "' with ssid='" << bss_conf.ssid
+                                          << "', reusing mld_id=" << effective_mld_id;
+                            }
+                            break;
+                        }
+                    }
+                }
+                options["mld"] = "mld" + effective_mld_id;
+                LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: 11BE mode -"
+                          << " clearing disable_11be, mld='mld" << effective_mld_id
+                          << "', ifname='" << new_bss_name << "'";
+            } else {
+                LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: 11BE mode -"
+                          << " clearing disable_11be, no valid mld_id, ifname='"
+                          << new_bss_name << "'";
+            }
+        } else {
+            LOG(WARNING) << "bpl_cfg_set_wifi_compat_mode_uci: unrecognised wifi_compat_mode="
+                         << int(bss_conf.wifi_compat_mode) << " for ssid='" << bss_conf.ssid
+                         << "', only updating ifname";
+        }
+
+        if (!uci_set_section(package_name, section_type, sec, options, true)) {
+            LOG(ERROR) << "bpl_cfg_set_wifi_compat_mode_uci: failed to update section=" << sec;
+        } else {
+            LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: updated section=" << sec
+                      << " ifname='" << new_bss_name << "'";
+            updated = true;
+
+            // For 11AX mode: if this was the last/only wifi-iface section referencing
+            // the wifi-mld section, set disabled=1 in the wifi-mld section so that
+            // hostapd/netifd stops advertising the MLD while the section is preserved.
+            if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX &&
+                !current_mld_val.empty()) {
+                // Count remaining wifi-iface sections that still reference this wifi-mld section.
+                // Note: the section we just updated (sec) no longer has the mld option, but
+                // all_sections was fetched before the commit so we skip sec explicitly.
+                int remaining_refs = 0;
+                for (const auto &other_sec : all_sections) {
+                    if (other_sec == sec) {
+                        continue; // skip the section we just updated
+                    }
+                    std::string other_mld_val;
+                    if (uci_get_option(package_name, section_type, other_sec, "mld",
+                                       other_mld_val) &&
+                        other_mld_val == current_mld_val) {
+                        remaining_refs++;
+                    }
+                }
+                if (remaining_refs == 0) {
+                    // This was the last/only link — disable the wifi-mld section.
+                    const std::string mld_section_type = "wifi-mld";
+                    if (uci_section_exists(package_name, mld_section_type, current_mld_val)) {
+                        OptionsUnorderedMap mld_disable_opts;
+                        mld_disable_opts["disabled"] = "1";
+                        if (!uci_set_section(package_name, mld_section_type, current_mld_val,
+                                             mld_disable_opts, true)) {
+                            LOG(ERROR) << "bpl_cfg_set_wifi_compat_mode_uci: failed to set"
+                                       << " disabled=1 in wifi-mld section '"
+                                       << current_mld_val << "'";
+                        } else {
+                            LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: set disabled=1 in"
+                                      << " wifi-mld section '" << current_mld_val
+                                      << "' (last link removed for ssid='"
+                                      << bss_conf.ssid << "')";
+                        }
+                    }
+                } else {
+                    LOG(DEBUG) << "bpl_cfg_set_wifi_compat_mode_uci: wifi-mld section '"
+                               << current_mld_val << "' still has " << remaining_refs
+                               << " other link(s), not disabling";
+                }
+            }
+
+            // For 11BE mode: if the corresponding wifi-mld section was previously
+            // disabled (disabled='1'), re-enable it (disabled='0') now that a link
+            // is being added back to the MLD group.
+            if (bss_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
+                auto mld_it = options.find("mld");
+                if (mld_it != options.end() && !mld_it->second.empty()) {
+                    const std::string &mld_sec_name = mld_it->second;
+                    const std::string mld_section_type = "wifi-mld";
+                    if (uci_section_exists(package_name, mld_section_type, mld_sec_name)) {
+                        std::string mld_disabled_val;
+                        if (uci_get_option(package_name, mld_section_type, mld_sec_name,
+                                           "disabled", mld_disabled_val) &&
+                            mld_disabled_val == "1") {
+                            OptionsUnorderedMap mld_enable_opts;
+                            mld_enable_opts["disabled"] = "0";
+                            if (!uci_set_section(package_name, mld_section_type, mld_sec_name,
+                                                 mld_enable_opts, true)) {
+                                LOG(ERROR) << "bpl_cfg_set_wifi_compat_mode_uci: failed to set"
+                                           << " disabled=0 in wifi-mld section '"
+                                           << mld_sec_name << "'";
+                            } else {
+                                LOG(INFO) << "bpl_cfg_set_wifi_compat_mode_uci: set disabled=0 in"
+                                          << " wifi-mld section '" << mld_sec_name
+                                          << "' (link re-added for ssid='"
+                                          << bss_conf.ssid << "')";
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        // Update only the first matching section per radio
+        break;
+    }
+
+    if (!updated) {
+        LOG(WARNING) << "bpl_cfg_set_wifi_compat_mode_uci: no matching wifi-iface section found"
+                     << " for ssid='" << bss_conf.ssid << "' radio_id='" << radio_id << "'";
+    }
+
+    return updated;
+}
