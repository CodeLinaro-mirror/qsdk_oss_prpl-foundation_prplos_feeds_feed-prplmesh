+/**
+ * @brief Update the UCI wireless config for a wifi-compat-mode transition.
+ *
+ * Finds the wifi-iface section matching @p bss_conf.ssid and @p radio_id, then
+ * applies the following changes based on @p bss_conf.wifi_compat_mode:
+ *
+ *   WIFI_COMPAT_MODE_11AX (disable_11be=1, MLO → SLO):
+ *     - Sets   option disable_11be '1'
+ *     - Clears option mld          (removes the MLD group association)
+ *     - Sets   option ifname       to @p new_bss_name
+ *
+ *   WIFI_COMPAT_MODE_11BE (disable_11be=0, SLO → MLO):
+ *     - Clears option disable_11be (removes the option so hostapd defaults to EHT-enabled)
+ *     - Sets   option ifname       to @p new_bss_name
+ *     - Sets   option mld          to "mld<mld_id>" when bss_conf.mld_id is valid
+ *
+ * @param [in] bss_conf      BSS configuration carrying ssid, wifi_compat_mode and mld_id.
+ * @param [in] old_bss_name  Previous interface name (used to locate the section by ifname).
+ * @param [in] new_bss_name  New interface name to write into the ifname option.
+ * @param [in] radio_id      Radio identifier (e.g. "radio0") used to find the wifi-device section.
+ * @return true on success, false otherwise.
+ */
+bool bpl_cfg_set_wifi_compat_mode_uci(const son::wireless_utils::sBssInfoConf &bss_conf,
+                                      const std::string &old_bss_name,
+                                      const std::string &new_bss_name,
