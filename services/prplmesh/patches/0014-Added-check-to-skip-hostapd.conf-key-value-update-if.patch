From 2cda02066a4478dbaf90c49a6a3e2923d6983839 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:10:30 +0530
Subject: [PATCH 14/31] Added check to skip hostapd.conf key-value update if
 value is unchanged

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../beerocks/hostapd/source/configuration.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/common/beerocks/hostapd/source/configuration.cpp b/common/beerocks/hostapd/source/configuration.cpp
index fe98bd77a..cb463968b 100644
--- a/common/beerocks/hostapd/source/configuration.cpp
+++ b/common/beerocks/hostapd/source/configuration.cpp
@@ -233,6 +233,7 @@ const std::string Configuration::get_vap_by_bssid(const std::string &bssid) cons
 bool Configuration::set_create_vap_value(const std::string &vap, const std::string &key,
                                          const std::string &value)
 {
+    LOG(DEBUG) << "set_create_vap_value: key-"<< key << " value-" << value;
     // search for the requested vap
     auto find_vap = get_vap(std::string(__FUNCTION__) + " key/value: " + key + '/' + value, vap);
     if (!std::get<0>(find_vap)) {
@@ -251,10 +252,25 @@ bool Configuration::set_create_vap_value(const std::string &vap, const std::stri
 
     // delete the key-value if found
     if (line_iter != existing_vap->end()) {
-        line_iter = existing_vap->erase(line_iter);
+        std::string existing_value = line_iter->substr(line_iter->find('=') + 1);
+        LOG(DEBUG) << "existing_value:  "<< existing_value << " new value: " << value;
+
+        if (existing_value == value) {
+            LOG(DEBUG) << "Same value - no need to update ";
+            return true;
+        } else {
+            LOG(DEBUG) << "new value - need to update ";
+            line_iter = existing_vap->erase(line_iter);
+        }
     } else {
+        LOG(DEBUG) << "key-"<< key << " value-" << value << " not found for vap: " << vap;
         m_last_message =
             std::string(__FUNCTION__) + " the key '" + key + "' for vap " + vap + " was not found";
+
+        if (value.length() == 0) {
+            LOG(DEBUG) << "key is not found and value is empty - no need to update ";
+            return true;
+        }
     }
 
     // when the new value is provided add the key back with that new value
@@ -266,6 +282,7 @@ bool Configuration::set_create_vap_value(const std::string &vap, const std::stri
         }
         m_last_message =
             std::string(__FUNCTION__) + " the key '" + key + "' for vap " + vap + " was (re)added";
+            LOG(DEBUG) << " the key " << key + " for vap " << vap << " was (re)added with value: " << value;
     } else {
         m_last_message =
             std::string(__FUNCTION__) + " the key '" + key + "' for vap " + vap + " was deleted";
-- 
