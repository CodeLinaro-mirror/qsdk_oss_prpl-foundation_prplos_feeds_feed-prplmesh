From 252a6203a66bd239bf8dd034944c77ab266ab7e7 Mon Sep 17 00:00:00 2001
From: amalganesh <amalgane@qti.qualcomm.com>
Date: Thu, 30 Jul 2026 14:36:09 +0530
Subject: [PATCH] Fix stop_on_failure_attempts counter reset on wireless
 backhaul reconnect

Signed-off-by: amalganesh <amalgane@qti.qualcomm.com>
---
 .../src/beerocks/slave/backhaul_manager/backhaul_manager.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
index 7a1db0e..b3a0634 100644
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -2785,6 +2785,7 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
 
             // Send slave enable the AP's
             send_slaves_enable();
+            stop_on_failure_attempts = configuration_stop_on_failure_attempts;
             FSM_MOVE_STATE(CONNECTED);
         } else if (FSM_IS_IN_STATE(WIRELESS_ASSOCIATE_4ADDR_WAIT)) {
             LOG(DEBUG) << "successful connect on iface=" << iface;
@@ -2839,7 +2840,7 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
 
             // Send slaves to enable the AP's
             send_slaves_enable();
-
+            stop_on_failure_attempts = configuration_stop_on_failure_attempts;
             FSM_MOVE_STATE(CONNECTED);
         } else if (FSM_IS_IN_STATE(WIRELESS_WAIT_FOR_RECONNECT)) {
             LOG(DEBUG) << "reconnected successfully, continuing";
@@ -2849,6 +2850,7 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
                 m_task_pool.send_event(eTaskType::TOPOLOGY, TopologyTask::eEvent::AGENT_RADIO_STATE_CHANGED);
             }
 
+            stop_on_failure_attempts = configuration_stop_on_failure_attempts;
             FSM_MOVE_STATE(CONNECTED);
         } else if ((FSM_IS_IN_STATE(INITIATE_SCAN)) || (FSM_IS_IN_STATE(WAIT_FOR_SCAN_RESULTS)) || (FSM_IS_IN_STATE(WIRELESS_CONFIG_4ADDR_MODE))){
             LOG(DEBUG) << "Received STA Connected event in unexpected state -- move to CONNECTED state";
@@ -2857,6 +2859,7 @@ bool BackhaulManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t even
             // Send slaves to enable the AP's
             send_slaves_enable();
 
+            stop_on_failure_attempts = configuration_stop_on_failure_attempts;
             FSM_MOVE_STATE(CONNECTED);
         }
     } break;
-- 
2.34.1

