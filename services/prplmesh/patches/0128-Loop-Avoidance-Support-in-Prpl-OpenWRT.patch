+bool ap_wlan_hal_nl80211::set_hop_count(uint8_t hop_count)
+{
+    LOG(DEBUG) << "Setting hop_count=" << int(hop_count) << " on backhaul BSSes of radio "
+               << get_iface_name();
+
+    std::string vendor_ie = build_multiap_assocresp_ie(hop_count);
+    std::string cmd       = "SET assocresp_elements " + vendor_ie;
+    bool success          = true;
+
+    for (const auto &vap_entry : m_radio_info.available_vaps) {
+        const auto &vap = vap_entry.second;
+        if (vap.bss.empty()) {
+            continue;
+        }
+        if (!vap.backhaul) {  // Only update backhaul BSSes
+            continue;
+        }
+        if (!wpa_ctrl_send_msg(cmd, vap.bss)) {
+            LOG(ERROR) << "Failed to set hop_count=" << int(hop_count)
+                       << " on BSS " << vap.bss;
+            success = false;
+        } else {
+            LOG(DEBUG) << "Set hop_count=" << int(hop_count) << " on BSS " << vap.bss;
+        }
+    }
+    return success;
+}
