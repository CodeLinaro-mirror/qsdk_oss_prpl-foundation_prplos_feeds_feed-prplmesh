 #define NEIGHBOR_REPORT_SUBELEM_CANDIDATE_PREF_MAX_HEX "0301ff"
 
+// Multi-AP Vendor IE components for assocresp_elements
+// Wire format: <vendor_type(1)><length(1)><oui(3)><oui_type(1)><hop_count(1)>
+// Example (extender):   "dd050013741b01"
+// Example (local agent): "dd050013741b00"
+#define MULTIAP_VENDOR_IE_TYPE         0xDDU  // Vendor-specific IE type
+#define MULTIAP_VENDOR_IE_LENGTH       0x05U  // Length of the IE payload (5 bytes)
+#define QUALCOMM_VENDOR_OUI            "001374"  // Qualcomm OUI (3 bytes)
+#define MULTIAP_VENDOR_OUI_TYPE        0x1BU  // Multi-AP vendor OUI type
+#define MULTIAP_HOP_COUNT_EXTENDER     0x01U  // Hop count for standalone extenders
+#define MULTIAP_HOP_COUNT_LOCAL_AGENT  0x00U  // Hop count for local agents
+
 
 // Temporary storage for station capabilities
 struct SRadioCapabilitiesStrings {
@@ -334,6 +345,31 @@ bool fetch_mld_iface_by_ssid(const std::string &target_ssid, std::string &mld_if
 }
 
 
+// Builds the assocresp_elements hexdump for the Multi-AP backhaul vendor IE.
+// The IE is constructed from its individual components so that each field is
+// clearly identifiable and can be changed independently.
+//
+// @param hop_count  MULTIAP_HOP_COUNT_EXTENDER (0x01) for standalone extenders,
+//                   MULTIAP_HOP_COUNT_LOCAL_AGENT (0x00) for local agents.
+// @return  Lowercase hex string, e.g. "dd050013741b01".
+static std::string build_multiap_assocresp_ie(uint8_t hop_count)
+{
+    // Format: type(2) + len(2) + oui(6) + oui_type(2) + hop_count(2) + null(1) = 15 bytes
+    // Use a generously sized buffer to be safe against OUI string changes
+    char buf[32];
+    int written = snprintf(buf, sizeof(buf), "%02x%02x%s%02x%02x",
+             MULTIAP_VENDOR_IE_TYPE,
+             MULTIAP_VENDOR_IE_LENGTH,
+             QUALCOMM_VENDOR_OUI,
+             MULTIAP_VENDOR_OUI_TYPE,
+             hop_count);
+    if (written < 0 || static_cast<size_t>(written) >= sizeof(buf)) {
+        LOG(ERROR) << "build_multiap_assocresp_ie: buffer too small or encoding error";
+        return {};
+    }
+    return std::string(buf);
+}
