+                    conf.set_create_vap_value(vap_id, "assocresp_elements",
+                        build_multiap_assocresp_ie(hop_count));
+                }
+
                 //required to update uci wireless
                 bss_it.multi_ap = multi_ap;
                 // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
@@ -3231,6 +3275,34 @@ bool ap_wlan_hal_nl80211::configure_service_priority(const uint8_t *data)
     return false;
