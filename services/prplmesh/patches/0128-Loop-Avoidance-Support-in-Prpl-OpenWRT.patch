@@ -1203,6 +1203,34 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
     }
 
     switch (beerocks_header->action_op()) {
+    case beerocks_message::ACTION_APMANAGER_BSTA_STATE_NOTIFICATION: {
+        // Handle bSTA connect/disconnect: update hop count BEFORE any other action
+        auto notification = beerocks_header->addClass<
+            beerocks_message::cACTION_APMANAGER_BSTA_STATE_NOTIFICATION>();
+        if (!notification) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_BSTA_STATE_NOTIFICATION failed";
+            return;
+        }
+        if (!ap_wlan_hal) {
+            LOG(WARNING) << "ap_wlan_hal not ready, skipping hop count update";
+            return;
+        }
+        uint8_t hop_count;
+        if (notification->connected()) {
+            // bSTA connected: 0 = local agent (gateway), 1 = standalone extender
+            hop_count = m_local_gw ? 0 : 1;
+            LOG(INFO) << "bSTA connected: setting hop_count=" << int(hop_count)
+                      << " on radio " << m_iface;
+        } else {
+            // bSTA disconnected: 255 = unreachable
+            hop_count = 255;
+            LOG(INFO) << "bSTA disconnected: setting hop_count=255 on radio " << m_iface;
+        }
+        if (!ap_wlan_hal->set_hop_count(hop_count)) {
+            LOG(ERROR) << "Setting hop count failed on interface" << m_iface;
+        };
+        return;
+    }
     case beerocks_message::ACTION_APMANAGER_CONFIGURE: {
         LOG(TRACE) << "ACTION_APMANAGER_CONFIGURE";
 
@@ -1216,6 +1244,8 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
         certification_mode = config->certification_mode();
         multi_ap_profile   = config->multi_ap_profile();
+        m_local_gw         = static_cast<bool>(config->local_gw());
+        LOG(DEBUG) << "ACTION_APMANAGER_CONFIGURE: local_gw=" << m_local_gw;
 
         if (create_ap_wlan_hal()) {
             LOG(DEBUG) << "Move to ATTACHING state";
@@ -4197,7 +4227,6 @@ bool ApManager::handle_ap_enabled(int vap_id)
     notification->vap_info().ap_mld_mac = tlvf::mac_from_string(vap_info.ap_mld_mac);
 
     send_cmdu(cmdu_tx);
-
     return true;
 }
 
