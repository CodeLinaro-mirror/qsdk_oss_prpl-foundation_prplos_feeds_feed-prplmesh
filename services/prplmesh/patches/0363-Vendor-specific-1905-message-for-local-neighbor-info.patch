@@ -3,9 +3,11 @@
  */
 
 #include "neighbor_db_agent_task.h"
+#include "tlvf_qca_utils.h"
 
 #include <bcl/network/network_utils.h>
 #include <easylogging++.h>
+#include <tlvf/ieee_1905_1/eMessageType.h>
 #include <tlvf/qca/eQcaMsgType.h>
 #include <tlvf/qca/tlvQcaMsgType.h>
 #include <tlvf/qca/tlvQcaNeighborInformation.h>
@@ -115,32 +117,58 @@ std::vector<uint8_t> NeighborDbAgentTask::collect_local_neighbor_report()
 void NeighborDbAgentTask::send_local_neighbor_info_to_controller(
     const std::vector<uint8_t> &report_data)
 {
-    // [STUB] In the full implementation this function will:
-    //  1. Build a 1905 Local Neighbor Information Message.
-    //  2. Add Neighbor Information TLV (SMD TLV TBD) populated from report_data.
-    //  3. Transmit to the controller via slave_thread::send_cmdu_to_controller().
-    // The message is fire-and-forget; no response is expected.
-
     auto db                    = AgentDB::get();
     const auto controller_alid = db->controller_info.bridge_mac;
+    const auto agent_alid      = db->bridge.mac;
 
-    LOG(DEBUG) << "AP_DEBUG: [STUB] Sending Local Neighbor Information Message to controller "
+    LOG(DEBUG) << "AP_DEBUG: Sending Local Neighbor Information Message to controller "
                << controller_alid << " (NRE bytes=" << report_data.size() << ")";
 
     if (controller_alid == net::network_utils::ZERO_MAC) {
-        LOG(WARNING) << "AP_DEBUG: [STUB] Controller ALID is unknown (ZERO_MAC)."
-                     << " Message would be dropped in a real implementation.";
+        LOG(WARNING) << "AP_DEBUG: Controller ALID is unknown (ZERO_MAC). Dropping message.";
+        return;
     }
 
-    // TODO: Replace stub with actual 1905 message construction and transmission:
-    //
-    //   if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::LOCAL_NEIGHBOR_INFORMATION_MESSAGE)) {
-    //       LOG(ERROR) << "Failed to create LOCAL_NEIGHBOR_INFORMATION_MESSAGE";
-    //       return;
-    //   }
-    //   auto tlv = m_cmdu_tx.addClass<vendor_specific::tlvNeighborInformation>();
-    //   // populate tlv from report_data...
-    //   if (!m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx)) {
-    //       LOG(ERROR) << "Failed sending local neighbor info to controller";
-    //   }
+    // Step 1: Create a VENDOR_SPECIFIC_MESSAGE CMDU.
+    if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::VENDOR_SPECIFIC_MESSAGE)) {
+        LOG(ERROR) << "AP_DEBUG: Failed to create VENDOR_SPECIFIC_MESSAGE";
+        return;
+    }
+
+    // Step 2: Add the QCA message type TLV (must be first).
+    //         Identifies this as a Local Neighbor Information message (Agent → Controller).
+    if (!qca::tlvf_qca_utils::add_qca_msg_type_tlv(
+            m_cmdu_tx,
+            static_cast<uint16_t>(qca::eQcaMsgType::QCA_MSG_LOCAL_NEIGHBOR_INFO))) {
+        LOG(ERROR) << "AP_DEBUG: Failed to add QCA message type TLV";
+        return;
+    }
+
+    // Step 3: Build the neighbor entry from the local NRE data.
+    //         The agent reports its own ALID as the source of the NRE.
+    std::vector<qca::sQcaNeighborEntry> entries;
+    if (!report_data.empty()) {
+        qca::sQcaNeighborEntry entry;
+        entry.agent_alid = agent_alid;
+        entry.nre_bytes  = report_data;
+        entries.push_back(std::move(entry));
+    }
+
+    // Step 4: Add the QCA Neighbor Information TLV.
+    //         Even if entries is empty, the TLV is added so the controller
+    //         knows the agent's neighbor DB is empty.
+    if (!qca::tlvf_qca_utils::add_qca_neighbor_info_tlv(m_cmdu_tx, entries)) {
+        LOG(ERROR) << "AP_DEBUG: Failed to add QCA Neighbor Information TLV";
+        return;
+    }
+
+    // Step 5: Transmit (fire-and-forget; no response expected).
+    if (!m_btl_ctx.send_cmdu_to_controller({}, m_cmdu_tx)) {
+        LOG(ERROR) << "AP_DEBUG: Failed to send Local Neighbor Information Message to controller "
+                   << controller_alid;
+        return;
+    }
+
+    LOG(INFO) << "AP_DEBUG: Sent Local Neighbor Information Message to controller "
+              << controller_alid << " (NRE bytes=" << report_data.size() << ")";
 }
