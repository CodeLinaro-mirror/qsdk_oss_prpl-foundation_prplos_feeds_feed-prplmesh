     case qca::eQcaMsgType::QCA_MSG_LOCAL_NEIGHBOR_INFO:
@@ -165,26 +169,49 @@ bool NeighborDbCtrlTask::handle_local_neighbor_info_message(const sMacAddr &src_
                    << ", mid=" << std::hex << mid;
 
     // -----------------------------------------------------------------------
