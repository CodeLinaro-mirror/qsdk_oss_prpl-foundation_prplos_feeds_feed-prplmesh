@@ -30,9 +30,13 @@ namespace beerocks {
  *
  * Current implementation status
  * ------------------------------
- * This is a skeleton implementation. All 1905 message transmissions and hostapd API calls are
- * replaced by LOG(DEBUG) stubs so that the logic can be exercised without any external
- * dependencies. The stubs are clearly marked with "[STUB]" in the log output.
+ * send_local_neighbor_info_to_controller() is fully implemented: it builds and transmits
+ * a QCA VENDOR_SPECIFIC_MESSAGE with tlvQcaMsgType + tlvQcaNeighborInformation to the
+ * controller.
+ *
+ * collect_local_neighbor_report() remains a stub that returns an empty NRE byte vector.
+ * The real implementation will query hostapd for the IEEE 802.11 Neighbor Report Element.
+ * The stub is clearly marked with "[STUB]" in the log output.
  */
 class NeighborDbAgentTask : public Task {
 public:
@@ -117,14 +121,18 @@ private:
     std::vector<uint8_t> collect_local_neighbor_report();
 
     /**
-     * @brief [STUB] Send Local Neighbor Information Message to the controller.
+     * @brief Send Local Neighbor Information Message to the controller.
      *
-     * In the full implementation, this will build and transmit a 1905 Local Neighbor
-     * Information Message with the Neighbor Information TLV.
+     * Builds and transmits a QCA VENDOR_SPECIFIC_MESSAGE containing:
+     *   1. tlvQcaMsgType  (QCA_MSG_LOCAL_NEIGHBOR_INFO = 0x0002)
+     *   2. tlvQcaNeighborInformation  (one entry with the agent's own ALID + NRE bytes)
      *
      * The message is sent fire-and-forget; no response is expected.
+     * Silently drops the message if the controller ALID is not yet known (ZERO_MAC).
      *
-     * @param report_data Raw NRE bytes (placeholder).
+     * @param report_data Raw NRE bytes from collect_local_neighbor_report().
+     *                    May be empty; the TLV is still sent with num_neighbor_reports=0
+     *                    so the controller knows the agent's neighbor DB is empty.
      */
     void send_local_neighbor_info_to_controller(const std::vector<uint8_t> &report_data);
 
