+    auto neighbor_tlv = cmdu_rx.getClass<qca::tlvQcaNeighborInformation>();
+    if (!neighbor_tlv) {
+        TASK_LOG(ERROR) << "AP_DEBUG: Missing QCA Neighbor Information TLV from agent " << src_mac;
+        return false;
+    }
+
+    uint8_t count = neighbor_tlv->num_neighbor_reports();
+    TASK_LOG(DEBUG) << "AP_DEBUG: Neighbor Information TLV has " << int(count)
+                    << " NRE entry/entries from agent " << src_mac;
+
+    // -----------------------------------------------------------------------
+    // Step 2: Extract NRE bytes from the first (and only) neighbor report entry.
+    //         The agent sends exactly one entry containing its own NRE.
     // -----------------------------------------------------------------------
-    TASK_LOG(DEBUG) << "AP_DEBUG: [STUB] Parsing Neighbor Information TLV from agent " << src_mac
-                    << " (TLV type TBD – using placeholder NRE data)";
-    std::vector<uint8_t> nre_bytes; // placeholder
