From 37158cd7a0d6165bd41cde07572769eac3fbff06 Mon Sep 17 00:00:00 2001
From: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
Date: Sat, 13 Jun 2026 14:41:26 +0530
Subject: [PATCH] nl80211: bSTA: fallback to STATUS for vlanid on
 CTRL-EVENT-CONNECTED

When a backhaul STA connects to a traffic-separation-enabled AP, the
primary VLAN ID must be received so the agent can set up VLAN tagging
on the uplink. This value is carried in the Multi-AP IE of the
association response, and wpa_supplicant (with the STATUS patch applied)
makes it available in two ways:

  1. Appended to the CTRL-EVENT-CONNECTED event string as
     multi_ap_primary_vlanid=<id>

  2. In the STATUS command reply as multi_ap_primary_vlanid=<id>

Prior to this change, the nl80211 bSTA handler only read the value from
the CTRL-EVENT-CONNECTED event string. If that field was absent (e.g.
in a WPS onboarding scenario or with an unpatched wpa_supplicant),
primary_vlan_id was silently left as 0 and VLAN tagging was never
applied on the backhaul link, causing the agent to send untagged packets
that are dropped by the controller.

Add a fallback in the Connected event handler: when CTRL-EVENT-CONNECTED
does not carry multi_ap_profile or multi_ap_primary_vlanid, use the
values from the STATUS command that is already issued at the top of the
same handler via read_status(). The STATUS values are always populated
from the same association response (set by multi_ap_process_assoc_resp()
before WPA_COMPLETED is reached), so they are consistent.

Presence of each field is tracked with explicit boolean flags rather
than using 0 as a sentinel, so that an explicitly advertised
multi_ap_primary_vlanid=0 (meaning "no VLAN tagging") is never
incorrectly overwritten with a non-zero STATUS value.

Signed-off-by: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
---
 .../bwl/nl80211/sta_wlan_hal_nl80211.cpp      | 31 ++++++++++++++++---
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
index 09eccc659..99255a270 100644
--- a/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/sta_wlan_hal_nl80211.cpp
@@ -375,9 +375,12 @@ bool sta_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
         memset(msg_buff.get(), 0, sizeof(sACTION_BACKHAUL_CONNECTED_NOTIFICATION));
 
         // Parse Multi-AP profile and primary VLAN ID from the CTRL-EVENT-CONNECTED event.
-        // Validate with endptr to reject empty, non-numeric, or partial strings (e.g. "123abc"),
-        // and range-check before narrowing cast to avoid silent wrap-around.
-        if (parsed_obj.count("multi_ap_profile")) {
+        // Track presence explicitly so the STATUS fallback below can distinguish
+        // "field absent" from "field present with value 0" (which means "no VLAN").
+        bool event_has_profile = parsed_obj.count("multi_ap_profile") > 0;
+        bool event_has_vlanid  = parsed_obj.count("multi_ap_primary_vlanid") > 0;
+
+        if (event_has_profile) {
             const auto &val      = parsed_obj.at("multi_ap_profile");
             char *endptr         = nullptr;
             unsigned long parsed = std::strtoul(val.c_str(), &endptr, 10);
@@ -385,9 +388,10 @@ bool sta_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
                 msg->multi_ap_profile = static_cast<uint8_t>(parsed);
             } else {
                 LOG(WARNING) << "Invalid multi_ap_profile value: " << val;
+                event_has_profile = false;
             }
         }
-        if (parsed_obj.count("multi_ap_primary_vlanid")) {
+        if (event_has_vlanid) {
             const auto &val      = parsed_obj.at("multi_ap_primary_vlanid");
             char *endptr         = nullptr;
             unsigned long parsed = std::strtoul(val.c_str(), &endptr, 10);
@@ -395,10 +399,29 @@ bool sta_wlan_hal_nl80211::process_nl80211_event(parsed_obj_map_t &parsed_obj)
                 msg->multi_ap_primary_vlan_id = static_cast<uint16_t>(parsed);
             } else {
                 LOG(WARNING) << "Invalid multi_ap_primary_vlanid value: " << val;
+                event_has_vlanid = false;
             }
         }
         update_status(connection_status);
 
+        // Fallback: if CTRL-EVENT-CONNECTED didn't carry multi_ap_profile or
+        // multi_ap_primary_vlanid (e.g. unpatched wpa_supplicant), use the values
+        // from the STATUS command already read into connection_status above.
+        // Only apply when the field was genuinely absent from the event string —
+        // not when it was explicitly present with value 0 (which means "no VLAN").
+        if (!event_has_profile && connection_status.multi_ap_profile != 0) {
+            msg->multi_ap_profile = connection_status.multi_ap_profile;
+            LOG(DEBUG) << get_iface_name()
+                       << " - multi_ap_profile absent from CTRL-EVENT-CONNECTED, using STATUS value: "
+                       << int(msg->multi_ap_profile);
+        }
+        if (!event_has_vlanid && connection_status.multi_ap_primary_vlanid != 0) {
+            msg->multi_ap_primary_vlan_id = connection_status.multi_ap_primary_vlanid;
+            LOG(DEBUG) << get_iface_name()
+                       << " - multi_ap_primary_vlanid absent from CTRL-EVENT-CONNECTED, using STATUS value: "
+                       << msg->multi_ap_primary_vlan_id;
+        }
+
         // Forward the event
         event_queue_push(event, msg_buff);
 
-- 
