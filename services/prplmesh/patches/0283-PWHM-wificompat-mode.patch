From 8ffed87d95a0d53d4f4f8c7022c90199f8663340 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Fri, 24 Jul 2026 23:37:17 +0530
Subject: [PATCH] PWHM: wificomapt mode

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp   | 63 ++++++++++++++++++-
 controller/whm/wifi_manager.cpp               |  8 ++-
 .../platform/bpl/cfg/dm/bpl_cfg_wifi.cpp      | 15 +++++
 3 files changed, 83 insertions(+), 3 deletions(-)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index cea903e6e..7a9817f8f 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -721,12 +721,14 @@ bool ap_wlan_hal_whm::update_vap_credentials(
         std::string current_ssid, current_password, current_mode;
         int8_t current_mldID = -1;
         bool current_ssid_adv = true; // default: advertised
+        int current_disable11be = -1; // -1 means not yet fetched / unknown
         bool params_retrieved = true;
         params_retrieved &= m_ambiorix_cl.get_param(current_ssid, wifi_ssid_path, "SSID");
         params_retrieved &= m_ambiorix_cl.get_param(current_password, wifi_vap_path + "Security.", "KeyPassPhrase");
         params_retrieved &= m_ambiorix_cl.get_param(current_mode, wifi_vap_path + "Security.", "ModeEnabled");
         params_retrieved &= m_ambiorix_cl.get_param(current_mldID, wifi_ssid_path, "MLDUnit");
         m_ambiorix_cl.get_param(current_ssid_adv, wifi_vap_path, "SSIDAdvertisementEnabled");
+        m_ambiorix_cl.get_param(current_disable11be, wifi_vap_path, "Disable11be");
 
         // Derive the expected SSIDAdvertisementEnabled from bss_info_conf.hidden_ssid
         // hidden_ssid=ENABLED  → SSIDAdvertisementEnabled should be false (0)
@@ -737,6 +739,17 @@ bool ap_wlan_hal_whm::update_vap_credentials(
             expected_ssid_adv = false;
         }
 
+        // Derive the expected Disable11be from bss_info_conf.wifi_compat_mode:
+        //   WIFI_COMPAT_MODE_11AX → Disable11be=1
+        //   WIFI_COMPAT_MODE_11BE → Disable11be=0
+        //   WIFI_COMPAT_MODE_UNSET → -1 (no change expected, skip this check)
+        int expected_disable11be = -1;
+        if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX) {
+            expected_disable11be = 1;
+        } else if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
+            expected_disable11be = 0;
+        }
+
         if (params_retrieved &&
             current_ssid == bss_info_conf.ssid && current_password == bss_info_conf.network_key &&
             current_mode ==
@@ -744,7 +757,8 @@ bool ap_wlan_hal_whm::update_vap_credentials(
                                                      bss_info_conf.additional_auth,
                                                      bss_info_conf.freq_band) &&
                 current_mldID == mld_unit &&
-                current_ssid_adv == expected_ssid_adv) {
+                current_ssid_adv == expected_ssid_adv &&
+                (expected_disable11be == -1 || current_disable11be == expected_disable11be)) {
             LOG(DEBUG) << "No changes detected for " << ifname
                        << ". Skipping update for VAP: " << wifi_vap_path;
              continue; // Skip updating this VAP
@@ -791,6 +805,53 @@ bool ap_wlan_hal_whm::update_vap_credentials(
             LOG(ERROR) << "Failed to update Security object " << wifi_ap_sec_path;
             continue;
         }
+
+        // Set Disable11be based on wifi_compat_mode:
+        //   WIFI_COMPAT_MODE_11AX (802.11ax / Wi-Fi 6) -> Disable11be=1
+        //   WIFI_COMPAT_MODE_11BE (802.11be / Wi-Fi 7) -> Disable11be=0
+        //   WIFI_COMPAT_MODE_UNSET                     -> no change
+        if (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX ||
+            bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE) {
+            int new_disable11be =
+                (bss_info_conf.wifi_compat_mode == WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX)
+                    ? 1
+                    : 0;
+            // current_disable11be was already fetched above; reuse it here.
+            // If fetch failed it stays -1, which won't equal 0 or 1, so update proceeds.
+            if (current_disable11be == new_disable11be) {
+                LOG(DEBUG) << "Disable11be=" << new_disable11be << " already set for "
+                           << wifi_vap_path << ", skipping update";
+            } else {
+                LOG(DEBUG) << "wifi_compat_mode=" << (new_disable11be ? "11ax" : "11be")
+                           << ": setting Disable11be=" << new_disable11be << " for " << wifi_vap_path
+                           << " (current=" << current_disable11be << ")";
+                AmbiorixVariant disable11be_obj(AMXC_VAR_ID_HTABLE);
+                disable11be_obj.add_child("Disable11be", new_disable11be);
+                if (!m_ambiorix_cl.update_object(wifi_vap_path, disable11be_obj)) {
+                    LOG(WARNING) << "Failed to set Disable11be=" << new_disable11be << " for "
+                                 << wifi_vap_path;
+                }
+
+                // For 11be (Disable11be=0): re-apply MLDUnit after the mode transition.
+                // pWHM rejects MLDUnit assignment while the VAP is still in 11ax mode
+                // (Disable11be=1). The initial MLDUnit write (above) may have been silently
+                // ignored, leaving the VAP as a standalone SLO instead of joining the
+                // existing 11be MLD. Re-writing MLDUnit now that Disable11be=0 is committed
+                // ensures the 2G VAP is correctly added to the multi-link group.
+                if (new_disable11be == 0 && mld_unit != DISABLED_MLDUNIT) {
+                    LOG(INFO) << "11be mode set: re-applying MLDUnit=" << int(mld_unit)
+                              << " for SSID " << bss_info_conf.ssid
+                              << " path=" << wifi_ssid_path;
+                    AmbiorixVariant mld_unit_obj(AMXC_VAR_ID_HTABLE);
+                    mld_unit_obj.add_child("MLDUnit", mld_unit);
+                    if (!m_ambiorix_cl.update_object(wifi_ssid_path, mld_unit_obj)) {
+                        LOG(WARNING) << "Failed to re-apply MLDUnit=" << int(mld_unit)
+                                     << " after Disable11be=0 for " << wifi_ssid_path;
+                    }
+                }
+            }
+        }
+
         if (ifname == "new_interface") {
             // skip update of vap_info, new instance in vap_info will be added asynchronously on a pwhm event
             continue;
diff --git a/controller/whm/wifi_manager.cpp b/controller/whm/wifi_manager.cpp
index 99d5546ec..473e45116 100644
--- a/controller/whm/wifi_manager.cpp
+++ b/controller/whm/wifi_manager.cpp
@@ -170,14 +170,18 @@ void WifiManager::subscribe_to_bss_info_config_change()
     }
 
     // subscribe for VAPs enabling to re-trigger autoConf when new BSS is enabled
-    // and potentially resume previously timeouted agent configuration
+    // and potentially resume previously timeouted agent configuration.
+    // Also subscribe to Disable11be changes so that switching between Wi-Fi 6 / Wi-Fi 7
+    // compatibility modes triggers an autoconfig renew to propagate the new compat mode
+    // to all agents via the tlvBeerocksWifiCompatMode vendor extension in WSC M2.
     filter = "(path matches '" + wbapi_utils::search_path_ap() +
              "[0-9]+.$')"
              " && (notification == '" +
              AMX_CL_OBJECT_CHANGED_EVT +
              "')"
              " && (contains('parameters.Enable')"
-             " || contains('parameters.SSIDAdvertisementEnabled'))";
+             " || contains('parameters.SSIDAdvertisementEnabled')"
+             " || contains('parameters.Disable11be'))";
 
     if (!m_ambiorix_cl->subscribe_to_object_event(wbapi_utils::search_path_ap(), event_handler,
                                                   filter)) {
diff --git a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
index 694d1eb62..0ecea366d 100644
--- a/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/dm/bpl_cfg_wifi.cpp
@@ -17,6 +17,7 @@
 
 #include <tlvf/WSC/eWscAuth.h>
 #include <tlvf/WSC/eWscEncr.h>
+#include <tlvf/WSC/eWscWifiCompatMode.h>
 
 #include <tlvf/common/eVapType.h>
 
@@ -267,6 +268,20 @@ bool bpl_cfg_get_wireless_settings(std::list<son::wireless_utils::sBssInfoConf>
                    << " ssid_advertisement=" << ssid_adv_enabled
                    << " for iface=" << iface;
 
+        // Read Disable11be and map to wifi_compat_mode for the tlvBeerocksWifiCompatMode VS TLV.
+        // Disable11be=true  → WIFI_COMPAT_MODE_11AX (Wi-Fi 6 / 802.11ax, disable_11be=1)
+        // Disable11be=false → WIFI_COMPAT_MODE_11BE (Wi-Fi 7 / 802.11be, disable_11be=0)
+        // Disable11be absent → WIFI_COMPAT_MODE_UNSET (TLV entry omitted for this BSS)
+        bool disable11be = false;
+        if (ap.read_child(disable11be, "Disable11be")) {
+            configuration.wifi_compat_mode = disable11be
+                ? WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11AX
+                : WSC::eWscWifiCompatMode::WIFI_COMPAT_MODE_11BE;
+            LOG(DEBUG) << "bpl_cfg_get_wireless_settings: Disable11be=" << disable11be
+                       << " -> wifi_compat_mode=" << static_cast<int>(configuration.wifi_compat_mode)
+                       << " for iface=" << iface;
+        }
+
         bool ap_enable = false;
         ap.read_child(ap_enable, "Enable");
         if (ap_enable && bpl_cfg_get_wifi_credentials(iface, configuration)) {
-- 
2.34.1

