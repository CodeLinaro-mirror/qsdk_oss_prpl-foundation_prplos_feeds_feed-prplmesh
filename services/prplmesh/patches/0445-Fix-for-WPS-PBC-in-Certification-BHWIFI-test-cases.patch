From 124dedab9bfc2179c96b54fcbeb9ce873a5e783d Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Wed, 23 Sep 2026 22:06:15 +0530
Subject: [PATCH] Fix for WPS-PBC in Certification BHWIFI test cases

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 agent/config/scripts/reset_vaps.sh | 85 ++++++++++++++++++++++--------
 1 file changed, 64 insertions(+), 21 deletions(-)

diff --git a/agent/config/scripts/reset_vaps.sh b/agent/config/scripts/reset_vaps.sh
index 2a690e4..5f0771d 100644
--- a/agent/config/scripts/reset_vaps.sh
+++ b/agent/config/scripts/reset_vaps.sh
@@ -18,6 +18,9 @@
 #
 #   STA VAP (wlan<band>):
 #     device, network=lan, mode=sta, wps_pushbutton=1, multi_ap=1, wds=1
+#     Only created for radios whose target htmode is EHT (11be). Each such
+#     STA VAP is affiliated (mld=mld0) to a single non-AP MLD "wifi-mld"
+#     section named "mld0", mirroring bpl_cfg_update_bsta_mld_grp().
 #
 # htmode handling (per band, mirroring bpl_cfg_reset_ap_vaps_to_default):
 #   - If the radio's CURRENT htmode is EHT* (Wi-Fi 7 / 11be) -> keep it EHT<width> (11be).
@@ -102,6 +105,20 @@ if [ "$OS_TYPE" = "OpenWrt" ]; then
 
     echo "reset_vaps.sh: htmode 2G=$HTMODE_2G 5G=$HTMODE_5G 6G=$HTMODE_6G" > /dev/console
 
+    # is_eht <htmode> -> true if the htmode belongs to the EHT (11be/Wi-Fi 7) family.
+    is_eht() {
+        case "$1" in
+        EHT*) return 0 ;;
+        *) return 1 ;;
+        esac
+    }
+
+    # Non-AP MLD (backhaul STA) group name. Every STA VAP brought up on an
+    # EHT radio is affiliated to this single wifi-mld section.
+    MLD_NAME="mld0"
+    HAVE_EHT_STA=0
+    MLD_STA_IFNAME=""
+
     # Radio band section names. "wifi config" names the wifi-device sections
     # radio0_band{0,1,2}; keep those as the device references.
     radio2G="radio0_band0"
@@ -160,18 +177,23 @@ if [ "$OS_TYPE" = "OpenWrt" ]; then
     uci set wireless.@wifi-iface[-1].encryption='none'
     uci set wireless.@wifi-iface[-1].ifname='wlan0.1'
 
-    # STA VAP (wlan0): backhaul STA
-    uci add wireless wifi-iface
-    uci set wireless.@wifi-iface[-1].device="${radio2G}"
-    uci set wireless.@wifi-iface[-1].network='lan'
-    uci set wireless.@wifi-iface[-1].ifname='wlan0'
-    uci set wireless.@wifi-iface[-1].mode='sta'
-    uci set wireless.@wifi-iface[-1].wps_pushbutton='1'
-    uci set wireless.@wifi-iface[-1].multi_ap='1'
-    uci set wireless.@wifi-iface[-1].wds='1'
+    # STA VAP (wlan0): backhaul STA, only when the radio is running EHT (11be)
+    if is_eht "$HTMODE_2G"; then
+        uci add wireless wifi-iface
+        uci set wireless.@wifi-iface[-1].device="${radio2G}"
+        uci set wireless.@wifi-iface[-1].network='lan'
+        uci set wireless.@wifi-iface[-1].ifname='wlan1'
+        uci set wireless.@wifi-iface[-1].mode='sta'
+        uci set wireless.@wifi-iface[-1].wps_pushbutton='1'
+        uci set wireless.@wifi-iface[-1].multi_ap='1'
+        uci set wireless.@wifi-iface[-1].wds='1'
+        uci set wireless.@wifi-iface[-1].mld="${MLD_NAME}"
+        [ -z "$MLD_STA_IFNAME" ] && MLD_STA_IFNAME='wlan0'
+        HAVE_EHT_STA=1
+    fi
 
     # --- 5 GHz radio ---
-    # STA VAP (wlan1): backhaul STA
+    # STA VAP (wlan1): backhaul STA, only when the radio is running EHT (11be)
     uci add wireless wifi-iface
     uci set wireless.@wifi-iface[-1].device="${radio5G}"
     uci set wireless.@wifi-iface[-1].network='lan'
@@ -180,6 +202,11 @@ if [ "$OS_TYPE" = "OpenWrt" ]; then
     uci set wireless.@wifi-iface[-1].wps_pushbutton='1'
     uci set wireless.@wifi-iface[-1].multi_ap='1'
     uci set wireless.@wifi-iface[-1].wds='1'
+    if is_eht "$HTMODE_5G"; then
+        uci set wireless.@wifi-iface[-1].mld="${MLD_NAME}"
+        [ -z "$MLD_STA_IFNAME" ] && MLD_STA_IFNAME='wlan1'
+            HAVE_EHT_STA=1
+    fi
 
     # AP VAP (wlan1.1): open + fronthaul/backhaul (multi_ap=2) + WPS
     uci add wireless wifi-iface
@@ -192,16 +219,20 @@ if [ "$OS_TYPE" = "OpenWrt" ]; then
     uci set wireless.@wifi-iface[-1].wps_pushbutton='1'
     uci set wireless.@wifi-iface[-1].multi_ap='2'
 
-    # --- 6 GHz radio ---
-    # STA VAP (wlan2): backhaul STA
-    uci add wireless wifi-iface
-    uci set wireless.@wifi-iface[-1].device="${radio6G}"
-    uci set wireless.@wifi-iface[-1].network='lan'
-    uci set wireless.@wifi-iface[-1].ifname='wlan2'
-    uci set wireless.@wifi-iface[-1].mode='sta'
-    uci set wireless.@wifi-iface[-1].wps_pushbutton='1'
-    uci set wireless.@wifi-iface[-1].multi_ap='1'
-    uci set wireless.@wifi-iface[-1].wds='1'
+    # STA VAP (wlan2): backhaul STA, only when the radio is running EHT (11be)
+    if is_eht "$HTMODE_6G"; then
+        uci add wireless wifi-iface
+        uci set wireless.@wifi-iface[-1].device="${radio6G}"
+        uci set wireless.@wifi-iface[-1].network='lan'
+        uci set wireless.@wifi-iface[-1].ifname='wlan1'
+        uci set wireless.@wifi-iface[-1].mode='sta'
+        uci set wireless.@wifi-iface[-1].wps_pushbutton='1'
+        uci set wireless.@wifi-iface[-1].multi_ap='1'
+        uci set wireless.@wifi-iface[-1].wds='1'
+        uci set wireless.@wifi-iface[-1].mld="${MLD_NAME}"
+        [ -z "$MLD_STA_IFNAME" ] && MLD_STA_IFNAME='wlan2'
+        HAVE_EHT_STA=1
+    fi
 
     # AP VAP (wlan2.1): 6 GHz mandates WPA3-SAE (open BSS not allowed on 6 GHz)
     uci add wireless wifi-iface
@@ -214,6 +245,18 @@ if [ "$OS_TYPE" = "OpenWrt" ]; then
     uci set wireless.@wifi-iface[-1].key='0123456789'
     uci set wireless.@wifi-iface[-1].ifname='wlan2.1'
 
+    # Step 5b: If any backhaul STA VAP was brought up under EHT, create/refresh
+    #          the non-AP MLD "mld0" wifi-mld section grouping them, mirroring
+    #          bpl_cfg_update_bsta_mld_grp().
+    if [ "$HAVE_EHT_STA" = "1" ]; then
+        uci set wireless.${MLD_NAME}=wifi-mld
+        uci set wireless.${MLD_NAME}.ifname="${MLD_STA_IFNAME}"
+        uci set wireless.${MLD_NAME}.multi_ap='1'
+        uci set wireless.${MLD_NAME}.wps_pushbutton='1'
+        uci set wireless.${MLD_NAME}.disabled='0'
+        echo "reset_vaps.sh: non-AP MLD ${MLD_NAME} configured (ifname=${MLD_STA_IFNAME})" > /dev/console
+    fi
+
     # Step 6: Commit
     uci commit wireless
 
@@ -225,4 +268,4 @@ if [ "$OS_TYPE" = "OpenWrt" ]; then
     echo "reset_vaps.sh: wifi invoked and sleep completed" > /dev/console
 fi
 
-echo "reset_vaps.sh: Done" > /dev/console
\ No newline at end of file
+echo "reset_vaps.sh: Done" > /dev/console
-- 
2.34.1

