-void slave_wlan_hal_nl80211::send_ping()
+bool slave_wlan_hal_nl80211::reattach()
 {
-    // Send MQTT PINGREQ every 30 seconds to keep the broker connection alive.
-    constexpr int MQTT_PING_INTERVAL_SEC = 30;
+    if (!mqtt_client) {
+        LOG(ERROR) << "MQTT client is null, cannot reattach";
+        return false;
+    }
+
+    if (m_hal_state == HALState::Operational) {
+        mqtt_client->reconnect();
+        return true;
+    } else {
+        LOG(ERROR) << "Failed to initiate MQTT reconnect";
+        return false;
+    }
+}
+
+void slave_wlan_hal_nl80211::run_fsm()
+{
+    if (!mqtt_client) {
+        return;
+    }
+
     auto now = std::chrono::steady_clock::now();
-    auto elapsed_sec = std::chrono::duration_cast<std::chrono::seconds>(
-        now - last_ping_time_).count();
-    if (elapsed_sec >= MQTT_PING_INTERVAL_SEC) {
-        mqtt_client->ping();
-        last_ping_time_ = now;
+    if (std::chrono::duration_cast<std::chrono::milliseconds>(now - m_last_loop_run_time).count() >= MQTT_LOOP_RUN_INTERVAL) {
+        mqtt_client->run_loop();
+        m_last_loop_run_time = now;
     }
+
+    return;
 }
 
-// Dummy implementations for pure virtual functions
-bwl::HALState slave_wlan_hal_nl80211::attach(bool)
+HALState slave_wlan_hal_nl80211::attach(bool)
 {
-    return bwl::HALState::Operational;
+    if (mqtt_client && m_hal_state == HALState::Initializing) {
+        if(!mqtt_client->connect("localhost", 1883, 60)) {
+            LOG(ERROR) << "Failed to connect to MQTT broker";
+            return (m_hal_state = HALState::Failed);
+        }
+
+        LOG(DEBUG) << "MQTT Connection initiated";
+        return (m_hal_state = HALState::Operational);
+    }
+
+    return m_hal_state;
 }
 
 bool slave_wlan_hal_nl80211::detach()
 {
+    LOG(DEBUG) << "Detaching slave WLAN HAL and disconnecting MQTT client";
+
+    if (mqtt_client) {
+        LOG(DEBUG) << "Disconnecting MQTT client";
+        mqtt_client->disconnect();
+        m_hal_state = HALState::Initializing;
+    }
+
     return true;
 }
 
