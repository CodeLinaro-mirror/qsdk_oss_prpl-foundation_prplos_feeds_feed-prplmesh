 bool slave_thread::fsm_all()
 {
-    // Send MQTT PINGREQ keepalive to the broker if keepalive/2 seconds have
-    // elapsed since the last message exchange. This keeps the MQTT connection
-    // alive even when no SMD events are flowing.
-    send_slave_hal_ping();
+    //Run slave_wlan_hal FSM
+    slave_wlan_hal_fsm();
 
     auto radio_fsm = [&](const sManagedRadio &radio_manager, const std::string &fronthaul_iface) {
         if (!monitor_heartbeat_check(fronthaul_iface) ||
@@ -7865,8 +7873,68 @@ bool slave_thread::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_p
     typedef bwl::slave_wlan_hal::Event Event;
     auto event = (Event)(event_ptr->first);
     switch (event) {
+    case Event::Register_Ext_Event_Fd: {
+        auto ext_fd_ptr = std::static_pointer_cast<int>(event_ptr->second);
+        int ext_fd = *ext_fd_ptr;
+        beerocks::EventLoop::EventHandlers ext_event_handlers{
+            .name = "slave_hal_ext_events",
+            .on_read = [this](int fd, beerocks::EventLoop &loop) {
+                if (!m_slave_wlan_hal || !m_slave_wlan_hal->process_ext_events(fd)) {
+                    LOG(ERROR) << "on_read process_ext_events(" << fd << ") failed!";
+                    return false;
+                }
+                return true;
+            },
+            .on_write = nullptr,
+            .on_disconnect = [this](int fd, beerocks::EventLoop &loop) {
+                LOG(ERROR) << "slave_wlan_hal ext events disconnected! on fd " << fd;
+                auto it = std::find(slave_hal_ext_events.begin(), slave_hal_ext_events.end(), fd);
+                if (it != slave_hal_ext_events.end()) {
+                    slave_hal_ext_events.erase(it);
+                }
+                if (m_slave_wlan_hal) {
+                    m_slave_wlan_hal->reattach();
+                }
+                return true;
+            },
+            .on_error = [this](int fd, beerocks::EventLoop &loop) {
+                LOG(ERROR) << "slave_wlan_hal ext events error! on fd " << fd;
+                auto it = std::find(slave_hal_ext_events.begin(), slave_hal_ext_events.end(), fd);
+                if (it != slave_hal_ext_events.end()) {
+                    slave_hal_ext_events.erase(it);
+                }
+                if (m_slave_wlan_hal) {
+                    m_slave_wlan_hal->reattach();
+                }
+                return true;
+            },
+        };
+
+        if (m_event_loop->register_handlers(ext_fd, ext_event_handlers)) {
+            LOG(DEBUG) << "Registered handlers for slave_wlan_hal fd " << ext_fd;
+            // Add fd to slave_hal_ext_events
+            slave_hal_ext_events.push_back(ext_fd);
+        } else {
+            LOG(ERROR) << "Failed to register handlers for slave_wlan_hal fd " << ext_fd;
+        }
+        break;
+    }
+    case Event::Unregister_Ext_Event_Fd: {
+        auto ext_fd_ptr = std::static_pointer_cast<int>(event_ptr->second);
+        int ext_fd = *ext_fd_ptr;
+        if (m_event_loop->remove_handlers(ext_fd)) {
+            LOG(DEBUG) << "Removed handlers for slave_wlan_hal fd " << ext_fd;
+            auto it = std::find(slave_hal_ext_events.begin(), slave_hal_ext_events.end(), ext_fd);
+            if (it != slave_hal_ext_events.end()) {
+                slave_hal_ext_events.erase(it);
+            }
+        } else {
+            LOG(ERROR) << "Failed to remove handlers for slave_wlan_hal fd " << ext_fd;
+        }
+        break;
+    }
     case Event::SMD_Roaming_Completed: {
-        LOG(DEBUG) << "Received SMD Roaming topic Event " << event;
+        LOG(DEBUG) << "Received SMD Roaming Completed Event " << event;
         break;
     }
     default: {
@@ -7884,6 +7952,7 @@ bool slave_thread::register_event_handlers()
     slave_hal_int_events = m_slave_wlan_hal->get_int_events_fd();
     if (slave_hal_int_events < 0) {
         LOG(DEBUG) << "No slave_wlan_hal internal events fd to register";
+        return false;
     } else {
         beerocks::EventLoop::EventHandlers int_event_handlers{
             .name = "slave_hal_int_events",
@@ -7914,51 +7983,6 @@ bool slave_thread::register_event_handlers()
             LOG(DEBUG) << "Registered slave_wlan_hal int event with fd = " << slave_hal_int_events;
         }
     }
-    
-    // register external event handlers
-    slave_hal_ext_events = m_slave_wlan_hal->get_ext_events_fds();
-    if (slave_hal_ext_events.empty()) {
-        LOG(DEBUG) << "No slave_wlan_hal external events fds to register";
-    } else {
-        beerocks::EventLoop::EventHandlers ext_event_handlers{
-            .name = "slave_hal_ext_events",
-            .on_read = [this](int fd, beerocks::EventLoop &loop) {
-                if (!m_slave_wlan_hal || !m_slave_wlan_hal->process_ext_events(fd)) {
-                    LOG(ERROR) << "on_read process_ext_events(" << fd << ") failed!";
-                    return false;
-                }
-                return true;
-            },
-            .on_write = nullptr,
-            .on_disconnect = [this](int fd, beerocks::EventLoop &loop) {
-                LOG(ERROR) << "slave_wlan_hal ext events disconnected! on fd " << fd;
-                auto it = std::find(slave_hal_ext_events.begin(), slave_hal_ext_events.end(), fd);
-                if (it != slave_hal_ext_events.end()) {
-                    *it = beerocks::net::FileDescriptor::invalid_descriptor;
-                }
-                return false;
-            },
-            .on_error = [this](int fd, beerocks::EventLoop &loop) {
-                LOG(ERROR) << "slave_wlan_hal ext events error! on fd " << fd;
-                auto it = std::find(slave_hal_ext_events.begin(), slave_hal_ext_events.end(), fd);
-                if (it != slave_hal_ext_events.end()) {
-                    *it = beerocks::net::FileDescriptor::invalid_descriptor;
-                }
-                return false;
-            },
-        };
-        for (auto &ext_event_fd : slave_hal_ext_events) {
-            if (ext_event_fd > 0) {
-                if (!m_event_loop->register_handlers(ext_event_fd, ext_event_handlers)) {
-                    LOG(ERROR) << "Unable to register handlers for slave_wlan_hal ext event fd " << ext_event_fd;
-                    return false;
-                }
-                LOG(DEBUG) << "Registered slave_wlan_hal ext event with fd = " << ext_event_fd;
-            } else if (ext_event_fd < 0) {
-                ext_event_fd = beerocks::net::FileDescriptor::invalid_descriptor;
-            }
-        }
-    }
 
     return true;
 }
