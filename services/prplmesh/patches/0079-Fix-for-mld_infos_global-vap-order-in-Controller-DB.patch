From eafe34ed0c0f0d12b316881e18ba749a611acd4f Mon Sep 17 00:00:00 2001
From: nushanth <nushanth@qti.qualcomm.com>
Date: Fri, 20 Feb 2026 12:55:29 +0530
Subject: [PATCH 09/11] Fix for mld_infos_global vap order in Controller DB

Signed-off-by: nushanth <nushanth@qti.qualcomm.com>
---
 controller/src/beerocks/master/controller.cpp | 2 +-
 controller/src/beerocks/master/db/db.cpp      | 2 +-
 controller/src/beerocks/master/db/db.h        | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index 8cc4fcf3d..3e78c079d 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -1298,7 +1298,7 @@ static bool add_backhaul_sta_mld_configuration_tlv(db &database, ieee1905_1::Cmd
 {
     auto bh_sta_mld_configuration = cmdu_tx.addClass<wfa_map::tlvBackhaulStaMldConfiguration>();
 
-    std::unordered_map<std::string, wireless_utils::sMldInfoConf> &mld_configuration(
+    std::map<std::string, wireless_utils::sMldInfoConf> &mld_configuration(
         database.get_mld_info_configuration());
     const std::list<wireless_utils::sBssInfoConf> &bss_configuration(
         database.get_bss_info_configuration(agent.al_mac));
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 6cc9f6d82..f78ac5c2c 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -5978,7 +5978,7 @@ void db::add_traffic_separation_configuration(const sMacAddr &al_mac,
     traffic_separation_policy_configurations[al_mac].push_back(config);
 }
 
-std::unordered_map<std::string, wireless_utils::sMldInfoConf> &db::get_mld_info_configuration()
+std::map<std::string, wireless_utils::sMldInfoConf> &db::get_mld_info_configuration()
 {
     return mld_infos_global;
 }
diff --git a/controller/src/beerocks/master/db/db.h b/controller/src/beerocks/master/db/db.h
index b273ad55e..b1b86b4e4 100644
--- a/controller/src/beerocks/master/db/db.h
+++ b/controller/src/beerocks/master/db/db.h
@@ -2208,7 +2208,7 @@ public:
     /**
      * @brief Return mld_infos_global map with uid - MLD information.
      */
-    std::unordered_map<std::string, wireless_utils::sMldInfoConf> &get_mld_info_configuration();
+    std::map<std::string, wireless_utils::sMldInfoConf> &get_mld_info_configuration();
 
     /**
      * @brief Store MLD information in the mld_infos_global list.
@@ -3381,7 +3381,7 @@ private:
     /**
      * @brief This map holds MLD configurations for each MLD indentifier.
      */
-    std::unordered_map<std::string, wireless_utils::sMldInfoConf> mld_infos_global;
+    std::map<std::string, wireless_utils::sMldInfoConf> mld_infos_global;
 
     /**
      * @brief List of BSSs currently configured on the radio
-- 
