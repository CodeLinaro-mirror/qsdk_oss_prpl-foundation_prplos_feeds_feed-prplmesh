From 29e31d959c4f0008ecda0dd5658eb452af1e1bb2 Mon Sep 17 00:00:00 2001
From: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
Date: Thu, 23 Jul 2026 15:54:38 +0530
Subject: [PATCH] Channel Management Support in PrplOS

Signed-off-by: Tharunkumar Dhanasekaran <tdhanase@qti.qualcomm.com>
---
 common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
index 2abce1958..1b43a218e 100644
--- a/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
+++ b/common/beerocks/bwl/whm/ap_wlan_hal_whm.cpp
@@ -1800,6 +1800,11 @@ bool ap_wlan_hal_whm::set_disabled_subchannels(uint16_t bitmap)
         return false;
     }
 
+    // Store the applied bitmap so fill_cs_params() can report it in the resulting CSA
+    // notification, mirroring how the nl80211 HAL stores the driver-reported punct_bitmap
+    // in m_radio_info. 0 is a valid value (un-puncturing / clearing a previous pattern).
+    m_radio_info.puncturing_bitmap = bitmap;
+
     return true;
 }
 
