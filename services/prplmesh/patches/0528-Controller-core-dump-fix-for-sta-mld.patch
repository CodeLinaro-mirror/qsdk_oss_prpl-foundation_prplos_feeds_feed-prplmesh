From 7fb25030a6acfec5a94b4ee191e01bba80b12649 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 12 Oct 2026 19:29:08 +0530
Subject: [PATCH] Controller core dump fix for sta mld

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 controller/src/beerocks/master/db/db.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index b3f3e28c6..cf0c08b85 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -11010,6 +11010,11 @@ bool db::update_assoc_sta_mld(
                 }
             }
 
+            /* topology_task calls keep_new_prepare() on every AP MLD of the reporting
+             * agent, so this STA MLD may be queued in old_macs of this map.  Mark it as
+             * handled before erasing it; otherwise keep_new_remove_old() later does at()
+             * on a MAC that is no longer in the map and throws std::out_of_range. */
+            other_ap_mld_entry.second.sta_mlds.keep_new(sta_mld_mac);
             other_ap_mld_entry.second.sta_mlds.erase(sta_mld_mac);
         }
     }
-- 
2.34.1

