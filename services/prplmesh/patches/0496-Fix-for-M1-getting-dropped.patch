From 25596797ac77f98f02bf2d56aeb284963a9f39ef Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Tue, 6 Oct 2026 11:31:16 +0530
Subject: [PATCH] Fix for M1 getting dropped

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp | 37 +++++++++++++++++--
 1 file changed, 34 insertions(+), 3 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index 2cdb098..1db48d1 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -566,7 +566,17 @@ void ApAutoConfigurationTask::work()
                 db->controller_info.early_ap_capability_report_sent = true;
                 m_btl_ctx.send_event(slave_thread::eEvent::CONTROLLER_EARLY_AP_CAPABILITY);
             }
-            send_ap_autoconfiguration_wsc_m1_message(radio_iface);
+            if (!send_ap_autoconfiguration_wsc_m1_message(radio_iface)) {
+                // M1 could not actually be delivered (e.g. controller bridge_mac is
+                // not resolved yet). Don't arm the M2 wait for a message that was
+                // never sent — re-run discovery so bridge_mac gets refreshed.
+                LOG(WARNING) << "Failed sending WSC M1 for " << radio_iface
+                             << " - restarting controller discovery";
+                m_discovery_status[radio->wifi_channel.get_freq_type()].completed = false;
+                m_discovery_status[radio->wifi_channel.get_freq_type()].msg_sent  = false;
+                FSM_MOVE_STATE(radio_iface, eState::CONTROLLER_DISCOVERY);
+                break;
+            }
             conf_params.timeout =
                 std::chrono::steady_clock::now() +
                 std::chrono::seconds(beerocks::ieee1905_1_consts::AUTOCONFIG_M2_TIMEOUT_SECONDS);
@@ -1735,7 +1745,10 @@ bool ApAutoConfigurationTask::send_ap_autoconfiguration_wsc_m1_message(
         }
 
         LOG(INFO) << "Configured as non-prplMesh, not sending SLAVE_JOINED_NOTIFICATION";
-        m_btl_ctx.send_cmdu_to_controller(radio_iface, m_cmdu_tx);
+        if (!m_btl_ctx.send_cmdu_to_controller(radio_iface, m_cmdu_tx)) {
+            LOG(ERROR) << "Failed sending WSC M1 to controller for " << radio_iface;
+            return false;
+        }
         LOG(DEBUG) << "sending WSC M1 Size=" << m_cmdu_tx.getMessageLength();
         return true;
     }
@@ -1862,7 +1875,10 @@ bool ApAutoConfigurationTask::send_ap_autoconfiguration_wsc_m1_message(
             m_cmdu_tx, ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_WSC_MESSAGE)) {
         LOG(ERROR) << "Failed adding few TLVs in AP_AUTOCONFIGURATION_WSC_MESSAGE";
     }
-    m_btl_ctx.send_cmdu_to_controller(radio_iface, m_cmdu_tx);
+    if (!m_btl_ctx.send_cmdu_to_controller(radio_iface, m_cmdu_tx)) {
+        LOG(ERROR) << "Failed sending WSC M1 to controller for " << radio_iface;
+        return false;
+    }
     LOG(DEBUG) << "sending WSC M1 Size=" << m_cmdu_tx.getMessageLength();
     return true;
 }
@@ -3550,6 +3566,21 @@ void ApAutoConfigurationTask::restart_autoconfiguration_for_all_radios()
                          << radio->front.iface_name;
         }
 
+        // The controller's bridge MAC may have been invalidated (e.g. by a backhaul
+        // reconnect resetting it to ZERO_MAC) since the last successful discovery.
+        // Sending M1 to a ZERO_MAC destination is silently dropped by
+        // send_cmdu_to_controller(), which would otherwise leave this radio looping
+        // SEND_AP_AUTOCONFIGURATION_WSC_M1 <-> WAIT_AP_AUTOCONFIGURATION_WSC_M2
+        // forever, waiting on an M2 that can never arrive. Re-run discovery instead.
+        if (db->controller_info.bridge_mac == beerocks::net::network_utils::ZERO_MAC) {
+            LOG(WARNING) << "controller bridge_mac unknown on renew for "
+                         << radio->front.iface_name << " - restarting controller discovery";
+            m_discovery_status[radio->wifi_channel.get_freq_type()].completed = false;
+            m_discovery_status[radio->wifi_channel.get_freq_type()].msg_sent  = false;
+            FSM_MOVE_STATE(radio->front.iface_name, eState::CONTROLLER_DISCOVERY);
+            continue;
+        }
+
         FSM_MOVE_STATE(radio->front.iface_name, eState::SEND_AP_AUTOCONFIGURATION_WSC_M1);
     }
 }
-- 
2.34.1

