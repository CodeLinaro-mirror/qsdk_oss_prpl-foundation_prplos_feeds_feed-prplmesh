@@ -21,6 +21,7 @@ using namespace beerocks;
 using namespace net;
 
 static constexpr std::chrono::seconds HEARTBEAT_SENDING_PERIOD_SEC{2};
+static constexpr std::chrono::seconds HEARTBEAT_RESPONSE_TIMEOUT_SEC{1};
 static constexpr uint8_t MAX_HEARTBEAT_COUNT{8};
 static constexpr uint8_t INDIRECT_TIMEOUT_MULTIPLIER{3};
 
@@ -100,6 +101,10 @@ void ControllerConnectivityTask::work()
     }
     case eState::CONTROLLER_MONITORING: {
 
+        if (check_indirect_controller_health()) {
+            break;
+        }
+
         if (check_controller_message_timeout()) {
             clear_heartbeat_counters();
             FSM_MOVE_STATE(WAIT_RESPONSE_FROM_CONTROLLER);
@@ -215,6 +220,12 @@ void ControllerConnectivityTask::handle_event(uint8_t event_enum_value, const vo
         m_direct_link_to_controller                   = false;
         db->controller_info.direct_link_to_controller = false;
         m_backhaul_connected_time                     = std::chrono::steady_clock::now();
+        // Do not carry a pre-disconnect controller timestamp into the new
+        // discovery cycle. The first discovery frame is handled before the
+        // controller bridge MAC is stored, so it cannot refresh this value.
+        db->controller_info.last_controller_contact_time = m_backhaul_connected_time;
+        m_indirect_probe_waiting = false;
+        m_indirect_probe_failed  = false;
         m_btl_ctx.notify_controller_reachability(false);
         FSM_MOVE_STATE(WAIT_FOR_CONTROLLER_DISCOVERY);
         break;
@@ -227,6 +238,14 @@ void ControllerConnectivityTask::handle_event(uint8_t event_enum_value, const vo
     }
     case CONTROLLER_DISCOVERED: {
         LOG(ERROR) << "CONTROLLER_DISCOVERED is received";
+        // Discovery establishes a new monitoring epoch. Prevent a stale
+        // timestamp from immediately entering the heartbeat timeout path.
+        auto now = std::chrono::steady_clock::now();
+        AgentDB::get()->controller_info.last_controller_contact_time = now;
+        m_last_indirect_probe_send_time    = now;
+        m_last_indirect_probe_contact_time = now;
+        m_indirect_probe_waiting           = false;
+        m_indirect_probe_failed            = false;
         m_btl_ctx.notify_controller_reachability(true);
         FSM_MOVE_STATE(CONTROLLER_MONITORING);
         break;
@@ -291,6 +310,57 @@ bool ControllerConnectivityTask::check_controller_message_timeout()
     return false;
 }
 
+bool ControllerConnectivityTask::check_indirect_controller_health()
+{
+    if (m_direct_link_to_controller) {
+        return false;
+    }
+
+    auto db = AgentDB::get();
+    auto now = std::chrono::steady_clock::now();
+    auto last_contact = db->controller_info.last_controller_contact_time;
+
+    // Any controller traffic received after the probe was sent is treated as
+    // a successful response for the current probe epoch.
+    if (m_indirect_probe_waiting && last_contact > m_last_indirect_probe_contact_time) {
+        m_indirect_probe_waiting = false;
+        // Restore hop count only when leaving a failed sequence. Successful
+        // probes while already healthy do not update the AP managers.
+        if (m_indirect_probe_failed) {
+            LOG(INFO) << "Controller HLE probe recovered; restoring controller reachability";
+            m_btl_ctx.notify_controller_reachability(true);
+            m_indirect_probe_failed = false;
+        }
+    }
+
+    if (m_indirect_probe_waiting &&
+        std::chrono::duration_cast<std::chrono::seconds>(now - m_last_indirect_probe_send_time) >=
+            HEARTBEAT_RESPONSE_TIMEOUT_SEC) {
+        m_indirect_probe_waiting = false;
+        // Advertise hop_count=255 only when entering a failed sequence.
+        if (!m_indirect_probe_failed) {
+            LOG(WARNING) << "First indirect controller HLE probe missed; advertising hop_count=255";
+            m_btl_ctx.notify_controller_reachability(false);
+            m_indirect_probe_failed = true;
+        }
+    }
+
+    if (!m_indirect_probe_waiting &&
+        std::chrono::duration_cast<std::chrono::seconds>(now - m_last_indirect_probe_send_time) >=
+            HEARTBEAT_SENDING_PERIOD_SEC) {
+        m_last_indirect_probe_send_time    = now;
+        m_last_indirect_probe_contact_time = last_contact;
+        m_indirect_probe_waiting           = true;
+        if (send_hle_to_controller()) {
+            LOG(DEBUG) << "Sending proactive controller HLE probe for indirect agent";
+        } else {
+            LOG(WARNING) << "Failed sending proactive controller HLE probe for indirect agent";
+        }
+    }
+
+    return false;
+}
+
 bool ControllerConnectivityTask::check_controller_response_timeout()
 {
     auto db               = AgentDB::get();
