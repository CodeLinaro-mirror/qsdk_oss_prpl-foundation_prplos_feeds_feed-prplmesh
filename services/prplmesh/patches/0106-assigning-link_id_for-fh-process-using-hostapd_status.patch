+/**
+ * @brief Get operational interface from hostapd using hostapd_cli status command
+ * 
+ * This function discovers the operational interface by:
+ * 1. Scanning /var/run/hostapd for interfaces matching the base interface pattern
+ * 2. Querying each interface using hostapd_cli status to get frequency
+ * 3. Matching the frequency with the radio_idx to find the correct interface
+ * 
+ * @param base_iface Base interface name (e.g., "wlan0")
+ * @param radio_idx Radio index (0=2.4GHz, 1=5GHz, 2=6GHz, 3=5GHz-High)
+ * @return std::string Operational interface name, or empty string if not found
+ */
 #ifdef USE_PRPLMESH_NLHAL
+static std::string get_operational_iface_from_hostapd(const std::string &base_iface, int radio_idx)
+{
+    LOG(INFO) << "Attempting to get operational interface from hostapd for base_iface: "
+              << base_iface << ", radio_idx: " << radio_idx;
+
+    // Collect interfaces from /var/run/hostapd that match the base interface pattern
+    std::string hostapd_path = "/var/run/hostapd";
+    std::vector<std::string> matching_ifaces;
+
+    DIR *dir = opendir(hostapd_path.c_str());
+    if (dir != nullptr) {
+        struct dirent *entry;
+        while ((entry = readdir(dir)) != nullptr) {
+            std::string filename(entry->d_name);
+            // Match base interface (e.g., wlan0) or link interfaces (e.g., wlan0_link*)
+            if ((filename.find(base_iface + "_link") == 0)) {
+                matching_ifaces.push_back(filename);
+                LOG(DEBUG) << "Found matching interface in hostapd: " << filename;
+            }
+        }
+        closedir(dir);
+    } else {
+        LOG(ERROR) << "Failed to open directory " << hostapd_path << ": " << strerror(errno);
+        return std::string();
+    }
+
+    if (matching_ifaces.empty()) {
+        LOG(ERROR) << "No matching interfaces found in " << hostapd_path << " for base interface "
+                   << base_iface;
+        return std::string();
+    }
+
+    // Verify each interface using hostapd_cli status and match frequency with radio_idx
+    std::string operational_iface;
+
+    for (const auto &iface : matching_ifaces) {
+        std::string cmd = "hostapd_cli -i " + iface + " status 2>&1 | grep freq=";
+        LOG(DEBUG) << "Executing: " << cmd;
+
+        FILE *pipe = popen(cmd.c_str(), "r");
+        if (pipe) {
+            char buffer[256];
+            std::string result;
+            while (fgets(buffer, sizeof(buffer), pipe) != nullptr) {
+                result += buffer;
+            }
+            pclose(pipe);
+
+            // Extract frequency from the output
+            size_t freq_pos = result.find("freq=");
+            if (freq_pos != std::string::npos) {
+                freq_pos += 5; // Move past "freq="
+                size_t end_pos       = result.find('\n', freq_pos);
+                std::string freq_str = result.substr(freq_pos, end_pos - freq_pos);
+                int freq             = std::stoi(freq_str);
+
+                LOG(DEBUG) << "Interface " << iface << " frequency: " << freq;
+
+                // Match frequency with radio_idx
+                bool match = false;
+                switch (radio_idx) {
+                case 0: // RADIOIDX_2G
+                    match = (freq >= 2400 && freq <= 2500);
+                    break;
+                case 1: // RADIOIDX_5G
+                    match = (freq >= 4900 && freq <= 5900);
+                    break;
+                case 2: // RADIOIDX_6G
+                    match = (freq >= 5925 && freq <= 7125);
+                    break;
+                case 3: // RADIOIDX_5GH
+                    match = (freq >= 5490 && freq <= 5835);
+                    break;
+                default:
+                    LOG(ERROR) << "Invalid radio_idx: " << radio_idx;
+                    break;
+                }
+
+                if (match) {
+                    operational_iface = iface;
+                    LOG(INFO) << "Interface " << iface << " matches radio_idx " << radio_idx
+                              << " with frequency " << freq;
+                    break;
+                } else {
+                    LOG(DEBUG) << "Interface " << iface << " frequency " << freq
+                               << " does not match radio_idx " << radio_idx;
+                }
+            }
+        } else {
+            LOG(WARNING) << "Failed to execute hostapd_cli for interface " << iface;
+        }
+    }
+
+    if (operational_iface.empty()) {
+        LOG(ERROR) << "No operational interface found matching radio_idx " << radio_idx
+                   << " for base interface " << base_iface;
+    }
+
+    return operational_iface;
+}
