From e5d75687df50595e4d77abf98c154e83b27afe93 Mon Sep 17 00:00:00 2001
From: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
Date: Thu, 30 Jul 2026 15:35:17 +0530
Subject: [PATCH] changes to append uhr string for Channel Switch command

Signed-off-by: Sudharsan Eswaran <eswaran@qti.qualcomm.com>
---
 .../bwl/include/bwl/base_wlan_hal_types.h     |  1 +
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp       | 24 +++++++++++++++++--
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index 3923f20f4..fbf21f927 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -226,6 +226,7 @@ struct RadioInfo {
     std::array<uint8_t, beerocks::message::HE_MCS_SET_SIZE> he_mcs_set;
 
     bool eht_supported = false; ///< Is 802.11be (Extremely High Throughput) protocol supported
+    bool uhr_supported = false; ///< Is 802.11bn (Ultra High Reliability / Wi-Fi 8) protocol supported
 
     std::vector<std::string> hostapd_radio_config;
     std::vector<std::pair<std::string, std::vector<std::string>>> hostapd_new_bss_config;
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 330e64fa8..601de26d4 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1495,21 +1495,31 @@ bool ap_wlan_hal_nl80211::refresh_radio_info()
     // (phy_name is set inside base_wlan_hal_nl80211::refresh_radio_info())
     bool ret = base_wlan_hal_nl80211::refresh_radio_info();
 
-    // Check ieee80211be support from hostapd config file.
+    // Check ieee80211be/ieee80211bn support from hostapd config file.
     // Must be done after base refresh since load_hostapd_config uses m_radio_info.phy_name.
     bool ieee80211be_enabled = false;
+    bool ieee80211bn_enabled = false;
     {
         prplmesh::hostapd::Configuration hostapd_conf = load_hostapd_config(m_radio_info.iface_name, "");
         if (hostapd_conf) {
             auto ieee80211be_sprt = hostapd_conf.get_head_value("ieee80211be");
             LOG(INFO) << "refresh_radio_info: ieee80211be_sprt: " << ieee80211be_sprt;
             ieee80211be_enabled = !ieee80211be_sprt.empty();
+
+            auto ieee80211bn_sprt = hostapd_conf.get_head_value("ieee80211bn");
+            LOG(INFO) << "refresh_radio_info: ieee80211bn_sprt: " << ieee80211bn_sprt;
+            ieee80211bn_enabled = !ieee80211bn_sprt.empty();
         } else {
             LOG(WARNING) << "refresh_radio_info: unable to load hostapd config for "
-                         << m_radio_info.iface_name << ", ieee80211be check skipped";
+                         << m_radio_info.iface_name << ", ieee80211be/ieee80211bn check skipped";
         }
     }
 
+    // UHR (802.11bn / Wi-Fi 8) builds on top of EHT, so it is only considered supported
+    // when both the driver reports EHT support and hostapd has ieee80211bn enabled.
+    m_radio_info.uhr_supported =
+        radio_info.eht_cfg.eht_supported && ieee80211be_enabled && ieee80211bn_enabled;
+
     if (radio_info.eht_cfg.eht_supported && ieee80211be_enabled) {
                m_radio_info.eht_supported = radio_info.eht_cfg.eht_supported;
                m_radio_info.ap_modes_support.emlmr_support = radio_info.eht_cfg.ap_modes_support.emlmr_support;
@@ -3143,6 +3153,16 @@ bool ap_wlan_hal_nl80211::switch_channel(int chan, beerocks::eWiFiBandwidth bw,
         LOG(ERROR) << "No valid PHY mode found";
         return false;
     }
+
+    // UHR (802.11bn / Wi-Fi 8) rides on top of EHT. On UHR-capable VAPs, hostapd's
+    // chanswitch handler treats a CHAN_SWITCH that omits "uhr" as a request to disable
+    // UHR, and refuses it while the VAP is operating in UHR mode. So whenever the "eht"
+    // token is selected on a UHR-capable radio, "uhr" must be appended too. Wi-Fi 7-only
+    // radios never have uhr_supported set, so this cannot affect them.
+    if (m_radio_info.uhr_supported && phy.find("eht") != std::string::npos) {
+        phy += " uhr";
+    }
+
     cmd += " " + phy;
 
     /// Static puncturing: include punct_bitmap if set.
-- 
2.34.1

