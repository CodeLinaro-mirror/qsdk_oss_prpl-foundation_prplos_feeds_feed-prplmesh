From 01a0462fca539a2d1c2233e28abab5df87e0dce1 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Mon, 20 Apr 2026 10:56:45 +0530
Subject: [PATCH] Coredump issue fix due to size buffer issue

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 .../nl80211/src/tlvf_airties_utils_nl80211.cpp            | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
index 309357fde..da2bdf2aa 100644
--- a/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
+++ b/common/beerocks/multi_vendor/nl80211/src/tlvf_airties_utils_nl80211.cpp
@@ -719,6 +719,14 @@ bool devicemetrics_get_radio_info(std::shared_ptr<airties::tlvAirtiesDeviceMetri
             LOG(INFO) << "Radio MAC: " << radio->front.iface_mac << std::endl;
             LOG(INFO) << "Interface: " << radio->front.iface_name << std::endl;
             auto rad_list = tlvDevMetrics->create_radio_list();
+            // When either condition is true the buffer is full; break immediately because no
+            // subsequent radio entry will fit either.
+            if (!rad_list || !rad_list->isInitialized()) {
+                LOG(ERROR) << "create_radio_list() failed for radio "
+                           << radio->front.iface_mac
+                           << " - TLV buffer full, skipping remaining radios";
+                break;
+            }
             rad_list->radio_id() = radio->front.iface_mac;
             // Reading a single temp1_input for phy00 since all hwmon entries map to same PHY.
             // Future: when hwmon→radio mapping becomes available, update to read per‑radio temps.
-- 
