From 241161a1356b4ca4849796615640ad960bbfbf4f Mon Sep 17 00:00:00 2001
From: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
Date: Wed, 16 Sep 2026 00:02:36 +0530
Subject: [PATCH] Fix MLO client and link metric reporting

- Remove stale per-link client state after partial MLO disconnects.
- Prevent duplicate MLO clients in Associated Clients TLVs.
- Preserve monitor-provided link metrics when MLO metadata has no affiliated links.

Signed-off-by: Stephan Raj Ignatious Durairaj <signatio@qti.qualcomm.com>
---
 agent/src/beerocks/slave/son_slave_thread.cpp       |  5 +++++
 .../slave/tasks/link_metrics_collection_task.cpp    | 13 +++++++++++--
 agent/src/beerocks/slave/tasks/topology_task.cpp    | 13 +++++++++++++
 3 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index ed8231437..7e48c56fe 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4908,6 +4908,11 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         // preserved, so erase_client() is skipped exactly as before in that case.
         if (!is_mld_client || send_leave) {
             db->erase_client(client_mac);
+        } else {
+            // Partial MLO disconnect: remove only the disconnected link's per-radio entry
+            // while preserving the MLD record and the remaining affiliated links.
+            db->erase_client(client_mac, notification_in->params().bssid,
+                             /*erase_mlo_entry=*/false);
         }
 
         auto radio = db->get_radio_by_mac(bssid, AgentDB::eMacType::BSSID);
diff --git a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
index ea1831535..28abb39d9 100644
--- a/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
+++ b/agent/src/beerocks/slave/tasks/link_metrics_collection_task.cpp
@@ -1511,7 +1511,7 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
                 if (mld_info_ptr) { break; }
             }
 
-            if (mld_info_ptr) {
+            if (mld_info_ptr && !mld_info_ptr->affiliated_stas.empty()) {
                 /* MLO STA: emit one sStaLinkMetrics per affiliated link.
                  * Per spec §17.2.24:
                  *   sta_mac = affiliated STA MAC (link MAC)
@@ -1599,7 +1599,16 @@ void LinkMetricsCollectionTask::handle_ap_metrics_response(ieee1905_1::CmduMessa
                     collected_link_sta_macs.insert(aff_sta.affiliated_sta_mac);
                 }
             } else {
-                /* Non-MLO STA: emit as-is */
+                /* Preserve the monitor-provided metric if the MLO metadata is
+                 * incomplete.  An MLD record with no affiliated STAs must not
+                 * cause the station's link metric to be silently dropped. */
+                if (mld_info_ptr) {
+                    LOG(WARNING) << "MLO STA " << sta_mac
+                                 << " has no affiliated STAs; using monitor-provided link metric"
+                                 << " for BSSID " << bssid_info.bssid;
+                }
+
+                /* Non-MLO STA, or incomplete MLO metadata: emit as-is. */
                 link_metrics_response.push_back({sta_mac, bssid_info});
             }
         }
diff --git a/agent/src/beerocks/slave/tasks/topology_task.cpp b/agent/src/beerocks/slave/tasks/topology_task.cpp
index 8e3649bb4..ca1099d74 100644
--- a/agent/src/beerocks/slave/tasks/topology_task.cpp
+++ b/agent/src/beerocks/slave/tasks/topology_task.cpp
@@ -1168,6 +1168,19 @@ bool TopologyTask::add_associated_clients_tlv()
                 bss_list->bssid() = bssid.mac;
 
                 for (const auto &associated_client_entry : radio->associated_clients) {
+                    const bool is_mld_client =
+                        db->associated_sta_mlds.find(associated_client_entry.first) !=
+                        db->associated_sta_mlds.end();
+
+                    // MLO clients are added below from associated_sta_mlds. Do not add the
+                    // same client from radio->associated_clients as well, otherwise the
+                    // Associated Clients TLV contains duplicate client records under the
+                    // same BSS. The associated_sta_mlds check also protects against a stale
+                    // or corrected is_mlo flag in the radio client entry.
+                    if (associated_client_entry.second.is_mlo || is_mld_client) {
+                        continue;
+                    }
+
                     if (associated_client_entry.second.bssid != bssid.mac) {
                         continue;
                     }
-- 
