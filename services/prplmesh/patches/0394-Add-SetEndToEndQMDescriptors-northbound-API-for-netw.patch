+bool db::set_endtoend_qm_descriptor(const sMacAddr &client_mac, uint16_t qmid,
+                                    const std::string &descriptor_element)
+{
+    const std::string e2e_descriptor_path =
+        std::string(DATAELEMENTS_ROOT_DM) + ".Network.EndToEndQMDescriptor";
+
+    auto index = m_ambiorix_datamodel->get_instance_index(
+        e2e_descriptor_path + ".[ClientMAC == '%s'].", tlvf::mac_to_string(client_mac));
+
+    std::string instance_path;
+    if (index) {
+        instance_path = e2e_descriptor_path + "." + std::to_string(index);
+    } else {
+        instance_path = m_ambiorix_datamodel->add_instance(e2e_descriptor_path);
+        if (instance_path.empty()) {
+            LOG(ERROR) << "Failed to add EndToEndQMDescriptor instance for client "
+                       << client_mac;
+            return false;
+        }
+    }
+
+    bool ret_val = true;
+    ret_val &= m_ambiorix_datamodel->set(instance_path, "QMID",
+                                         static_cast<uint32_t>(qmid));
+    ret_val &= m_ambiorix_datamodel->set(instance_path, "ClientMAC", client_mac);
+    ret_val &= m_ambiorix_datamodel->set(instance_path, "DescriptorElement",
+                                         descriptor_element);
+    return ret_val;
+}
+
+bool db::remove_endtoend_qm_descriptor(const sMacAddr &client_mac)
+{
+    const std::string e2e_descriptor_path =
+        std::string(DATAELEMENTS_ROOT_DM) + ".Network.EndToEndQMDescriptor";
+    auto index = m_ambiorix_datamodel->get_instance_index(
+        e2e_descriptor_path + ".[ClientMAC == '%s'].", tlvf::mac_to_string(client_mac));
+    if (!index) {
+        return true;
+    }
+    return m_ambiorix_datamodel->remove_instance(e2e_descriptor_path, index);
+}
+
 bool db::set_controller_qm_descriptor(const sMacAddr &bssid, const sMacAddr &client_mac,
                                       const std::string &descriptor_element,
                                       eDescriptorSource     source_type,
@@ -8373,8 +8415,14 @@ bool db::set_controller_qm_descriptor(const sMacAddr &bssid, const sMacAddr &cli
         qmid = m_next_qmid;
     }
 
-    if (!set_qm_descriptor(bssid, client_mac, descriptor_element)) {
-        return false;
+    if (descriptor_config_type == eDescriptorConfigType::NETWORK_LEVEL) {
