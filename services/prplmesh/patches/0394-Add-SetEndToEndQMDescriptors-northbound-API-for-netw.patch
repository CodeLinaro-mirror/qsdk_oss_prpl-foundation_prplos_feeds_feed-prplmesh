+            return false;
+        }
+    } else {
+        if (!set_qm_descriptor(bssid, client_mac, descriptor_element)) {
+             return false;
+         }
     }
 
     sStoredQmDescriptor &entry   = key_map[key];
@@ -8438,7 +8486,8 @@ bool db::clear_transient_controller_qm_descriptors(const sMacAddr &al_mac)
 
         for (auto client_entry = bss_entry->second.begin();
              client_entry != bss_entry->second.end();) {
-            bool any_removed = false;
+            bool any_bss_level_removed     = false;
+            bool any_network_level_removed = false;
             for (auto key_entry = client_entry->second.begin();
                  key_entry != client_entry->second.end();) {
                 if (key_entry->second.request_type !=
@@ -8446,17 +8495,29 @@ bool db::clear_transient_controller_qm_descriptors(const sMacAddr &al_mac)
                     ++key_entry;
                     continue;
                 }
+                if (key_entry->second.descriptor_config_type ==
+                    eDescriptorConfigType::NETWORK_LEVEL) {
+                    any_network_level_removed = true;
+                } else {
+                    any_bss_level_removed = true;
+                }
                 key_entry = client_entry->second.erase(key_entry);
-                any_removed = true;
             }
 
-            if (any_removed) {
+            if (any_bss_level_removed) {
                 if (!remove_qm_descriptor(bss_entry->first, client_entry->first)) {
                     LOG(ERROR) << "Failed removing transient QMDescriptor for BSSID "
                                << bss_entry->first << ", client " << client_entry->first;
                     ret_val = false;
                 }
             }
+            if (any_network_level_removed) {
+                if (!remove_endtoend_qm_descriptor(client_entry->first)) {
+                    LOG(ERROR) << "Failed removing transient E2E QMDescriptor for client "
+                               << client_entry->first;
+                    ret_val = false;
+                }
+            }
 
             if (client_entry->second.empty()) {
                 client_entry = bss_entry->second.erase(client_entry);
@@ -8476,6 +8537,25 @@ bool db::clear_transient_controller_qm_descriptors(const sMacAddr &al_mac)
     return ret_val;
 }
 
+void db::clear_need_send_network_level_descriptor(const sMacAddr &bssid,
+                                                   const sMacAddr &client_mac,
+                                                   uint16_t descriptor_key)
+{
+    auto bss_it = m_controller_qm_descriptors.find(bssid);
+    if (bss_it == m_controller_qm_descriptors.end()) {
+        return;
+    }
+    auto cli_it = bss_it->second.find(client_mac);
+    if (cli_it == bss_it->second.end()) {
+        return;
+    }
+    auto key_it = cli_it->second.find(descriptor_key);
+    if (key_it == cli_it->second.end()) {
+        return;
+    }
+    key_it->second.need_send = false;
+}
