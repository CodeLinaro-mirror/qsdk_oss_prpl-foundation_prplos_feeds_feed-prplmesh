+/**
+ * @brief Handler for Device.WiFi.DataElements.Network.SetEndToEndQMDescriptors().
+ *
+ * Accepts a list of EndToEndQMDescriptor entries (each carrying ClientMAC and
+ * DescriptorElement), validates them, and stores each one in the controller
+ * database as APPLICATION-sourced, NETWORK_LEVEL so the controller can later
+ * push it to every agent on the end-to-end path to the client.
+ */
+amxd_status_t set_end_to_end_qm_descriptors(amxd_object_t * /*network_obj*/,
+                                             amxd_function_t * /*func*/,
+                                             amxc_var_t *args, amxc_var_t *ret)
+{
+    if (!g_database) {
+        LOG(ERROR) << "Invalid database access";
+        amxc_var_set(cstring_t, ret, "Error_Other");
+        return amxd_status_unknown_error;
+    }
+
+    auto controller = g_database->get_controller_ctx();
+    if (!controller) {
+        LOG(ERROR) << "Failed to get controller context";
+        amxc_var_set(cstring_t, ret, "Error_Other");
+        return amxd_status_unknown_error;
+    }
+
+    auto descriptors = get_list_argument(args, "EndToEndQMDescriptor");
+    if (!descriptors) {
+        LOG(ERROR) << "EndToEndQMDescriptor list is missing";
+        amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+        return amxd_status_invalid_value;
+    }
+
+    std::vector<sPendingQmDescriptor> pending;
+    std::set<std::pair<std::string, uint8_t>> descriptor_keys;
+
+    amxc_var_for_each(entry, descriptors)
+    {
+        std::string client_mac_str;
+        std::string descriptor_element;
+
+        if (!read_string_value(entry, "ClientMAC", client_mac_str) ||
+            !read_string_value(entry, "DescriptorElement", descriptor_element)) {
+            LOG(ERROR) << "EndToEndQMDescriptor entry is missing required fields";
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        if (!network_utils::is_valid_mac(client_mac_str)) {
+            LOG(ERROR) << "Invalid ClientMAC: " << client_mac_str;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        if (!is_strict_hex_string(descriptor_element)) {
+            LOG(ERROR) << "Invalid DescriptorElement for client " << client_mac_str;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        const auto descriptor_bytes =
+            beerocks::string_utils::hex_to_bytes<std::vector<uint8_t>>(descriptor_element);
+        if (!qos_management::is_valid_qos_management_descriptor_element(descriptor_bytes)) {
+            LOG(ERROR) << "Invalid DescriptorElement content for client " << client_mac_str;
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        const auto client_mac            = tlvf::mac_from_string(client_mac_str);
+        const auto normalized_client_mac = tlvf::mac_to_string(client_mac);
+        const auto descriptor_info =
+            qos_management::parse_qos_management_descriptor_element(descriptor_bytes);
+
+        if (!descriptor_keys.insert({normalized_client_mac, descriptor_info.scsid}).second) {
+            LOG(ERROR) << "Duplicate EndToEndQMDescriptor entry for client "
+                       << normalized_client_mac << " scsid "
+                       << static_cast<unsigned>(descriptor_info.scsid);
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        /* Validate client association during the input-validation phase so
+         * all preconditions are checked before any DB writes occur. */
+        const auto serving_bssid_str =
+            g_database->get_sta_parent(tlvf::mac_to_string(client_mac));
+        if (serving_bssid_str.empty() ||
+            !network_utils::is_valid_mac(serving_bssid_str)) {
+            LOG(ERROR) << "Client " << client_mac
+                       << " is not associated to any BSS; cannot store end-to-end descriptor";
+            amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+            return amxd_status_invalid_value;
+        }
+
+        const auto serving_bssid = tlvf::mac_from_string(serving_bssid_str);
+        pending.push_back({client_mac, serving_bssid, std::move(descriptor_element), descriptor_info.scsid});
+    }
+
+    if (pending.empty()) {
+        LOG(ERROR) << "EndToEndQMDescriptor list is empty";
+        amxc_var_set(cstring_t, ret, "Error_Invalid_Input");
+        return amxd_status_invalid_value;
+    }
+
+    for (const auto &desc : pending) {
+        if (!g_database->set_controller_qm_descriptor(
+                desc.serving_bssid, desc.client_mac, desc.descriptor_element,
+                son::db::eDescriptorSource::APPLICATION,
+                son::db::eDescriptorConfigType::NETWORK_LEVEL)) {
+            LOG(ERROR) << "Failed to store end-to-end QMDescriptor for client "
+                       << desc.client_mac;
+            amxc_var_set(cstring_t, ret, "Error_Other");
+            return amxd_status_unknown_error;
+        }
+    }
+
+    controller->trigger_prioritization_config();
+    amxc_var_set(cstring_t, ret, "Success");
+    return amxd_status_ok;
+}
