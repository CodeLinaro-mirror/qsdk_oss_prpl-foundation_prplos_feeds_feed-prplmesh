+bool ap_wlan_hal_nl80211::create_new_hostapd_conf_file(std::string &ifname, son::wireless_utils::sBssInfoConf &bss_conf,
+                                  std::string &bridge,std::string &conf_path,bool vbss)
+{
+    std::string vap_id;
+    // TODO: PPM-2347: check that the radio still has room for one more BSS.
+
+    prplmesh::hostapd::Configuration conf(conf_path);
+
+    conf.set_hostapd_radio_config(m_radio_info.hostapd_radio_config);
+
+    conf.add_hostapd_config(ifname, std::vector<std::string>{"interface=" + ifname,"bssid=" + tlvf::mac_to_string(bss_conf.bssid)});
+
+    vap_id = conf.get_vap_by_bssid(tlvf::mac_to_string(bss_conf.bssid));
+
+    if(vap_id.empty()){
+        LOG(ERROR) << "BSS Addtion failed";
+        return false;
+    }
+
+    // escape I
+    auto auth_type = son::wireless_utils::wsc_to_bwl_authentication(bss_conf.authentication_type);
+    if (auth_type == "INVALID") {
+        LOG(ERROR) << "Autoconfiguration: auth type is 'INVALID'; number: "
+                   << (uint16_t)bss_conf.authentication_type;
+        return false;
+    }
+
+    // escape II
+    auto enc_type = son::wireless_utils::wsc_to_bwl_encryption(bss_conf.encryption_type);
+    if (enc_type == "INVALID") {
+        LOG(ERROR) << "Autoconfiguration: enc_type is 'INVALID'; number: "
+                   << int(bss_conf.encryption_type);
+        return false;
+    }
+    conf.set_create_vap_value(vap_id,"ssid", bss_conf.ssid);
+    conf.set_create_vap_value(vap_id,"notify_mgmt_frames", "1");
+    conf.set_create_vap_value(vap_id,"ctrl_interface",
+                               std::string(bwl::nl80211::base_ctrl_path) + "hostapd/"+ ifname);
+
+    if (!assign_auth_encr_parameters(conf,vap_id, bss_conf)) {
+        LOG(ERROR) << "Failed to set the authentication/encryption parameters!";
+        return false;
+    }
+    conf.set_create_vap_value(vap_id, "wds_sta", "1");
+    conf.set_create_vap_value(vap_id, "wps_state", bss_conf.fronthaul ? "2" : "");
+    conf.set_create_vap_value(vap_id, "wps_independent", bss_conf.fronthaul ? "1" : "");
+    std::string multi_ap;
+    if (bss_conf.fronthaul) {
+        if (bss_conf.backhaul) {
+            multi_ap = "3";
+        } else {
+            multi_ap = "2";
+        }
+    } else {
+        if (bss_conf.backhaul) {
+            multi_ap = "1";
+        } else {
+            LOG(WARNING) << "BSS configured with fronthaul nor backhaul";
+            multi_ap = "0";
+        }
+    }
+    conf.set_create_vap_value(vap_id, "multi_ap", multi_ap);
+    //required to update uci wireless
+    bss_conf.multi_ap = multi_ap;
+    // oddly enough, multi_ap_backhaul_wpa_passphrase has to be
+    // quoted, while wpa_passphrase does not...
+    if (bss_conf.fronthaul && !bss_conf.backhaul_wps_ssid.empty()) {
+        conf.set_create_vap_value(vap_id, "multi_ap_backhaul_ssid",
+                                  "\"" + bss_conf.backhaul_wps_ssid + "\"");
+        conf.set_create_vap_value(vap_id, "multi_ap_backhaul_wpa_passphrase",
+                                  bss_conf.backhaul_wps_passphrase);
+    }
+    auto ieee80211be_sprt = conf.get_head_value("ieee80211be");
+
+    LOG(INFO) << "ieee80211be_sprt: " << ieee80211be_sprt;
+    if (!ieee80211be_sprt.empty()) {
+            conf.set_create_vap_value(vap_id, "mld_ap","1");
+    }
+
+    if (!bridge.empty()) {
+        conf.set_create_vap_value(vap_id,"bridge", bridge);
+    }
+    if (vbss) {
+        conf.set_create_vap_value(vap_id,"broadcast_deauth", "0");
+        conf.set_create_vap_value(vap_id,"no_deauth_unknown_sta", "1");
+    }
+
+    if (!conf.store()) {
+        LOG(ERROR) << "Failed to store the hostapd configuration!";
+        return false;
+    }
+
+    //get new bss info
+    m_radio_info.hostapd_new_bss_config.clear();
+    m_radio_info.hostapd_new_bss_config = conf.get_hostapd_bss_config();
+
+    LOG(DEBUG) << "Added new hostapd configuration in " << conf_path;
+
+    LOG(DEBUG) << "New BSS configuration: " << conf;
+
+    //set uci persist for the particular vapid
+    set_wifi_credentials_from_vap(vap_id, bss_conf, conf);
+
+    return true;
+}
