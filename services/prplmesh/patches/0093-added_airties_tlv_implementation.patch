+int uci_get_string(const std::string &param, std::string &out)
+{
+    char tmp[MAX_UCI_BUF_LEN] = {0};
+
+    if (cfg_get_prplmesh_param(param, tmp, sizeof(tmp)) != RETURN_OK) {
+        return RETURN_ERR;
+    }
+
+    out.assign(tmp);
+
+    // Trim trailing whitespace/newlines
+    while (!out.empty()) {
+        char c = out.back();
+        if (c == '\n' || c == '\r' || c == ' ' || c == '\t') {
+            out.pop_back();
+        } else {
+            break;
+        }
+    }
+
+    return RETURN_OK;
+}
