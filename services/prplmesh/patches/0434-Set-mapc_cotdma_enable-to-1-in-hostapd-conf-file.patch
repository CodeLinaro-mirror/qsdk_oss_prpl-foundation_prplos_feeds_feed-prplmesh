From c0141ed10ef073cc3411f09fa40bfee5d8a4a93b Mon Sep 17 00:00:00 2001
From: mpaluri <mpaluri@qti.qualcomm.com>
Date: Tue, 15 Sep 2026 13:14:14 -0700
Subject: [PATCH] Set mapc_cotdma_enable to 1 in hostapd conf file

When cotdma_enable is set in beerocks_agent conf, set
mapc_cotdma_enable and mapc_negotiation_mode in hostapd conf file

Signed-off-by: Manaswini Paluri <mpaluri@qti.qualcomm.com>

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 910b7d406..59e7a9bc0 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -451,6 +451,7 @@ bool ApManager::create_ap_wlan_hal()
     // not fully populated, so the decision flag must travel through hal_conf.)
     hal_conf.cbs_based_chansel_enable = cbs_based_chansel_enable;
     hal_conf.chansel_preference_report_refresh_enable = chansel_preference_report_refresh_enable;
+    hal_conf.enable_cotdma = enable_cotdma;
     LOG(DEBUG) << "[ACTIVE_ACS] create_ap_wlan_hal: iface=" << m_iface
                << " active_acs_chansel_enable=" << hal_conf.active_acs_chansel_enable
                << " cbs_based_chansel_enable=" << hal_conf.cbs_based_chansel_enable
@@ -1417,6 +1418,7 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         active_acs_chansel_enable = static_cast<bool>(config->active_acs_chansel_enable());
         chansel_preference_report_refresh_enable =
             static_cast<bool>(config->chansel_preference_report_refresh_enable());
+        enable_cotdma      = static_cast<bool>(config->enable_cotdma());
         m_local_gw         = static_cast<bool>(config->local_gw());
         m_radio_disable    = static_cast<bool>(config->radio_disable());
         LOG(DEBUG) << "ACTION_APMANAGER_CONFIGURE: local_gw=" << m_local_gw
diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
index 7d8c37dbe..c09dbbd9e 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
@@ -396,6 +396,7 @@ private:
     // completion, independent of the CBS-based channel-selection approach. Received from the agent
     // process in cACTION_APMANAGER_CONFIGURE (beerocks_agent.conf).
     bool chansel_preference_report_refresh_enable = false;
+    bool enable_cotdma = false;
     bool radio_state_lock   = false;
     uint8_t multi_ap_profile =
         wfa_map::tlvProfile2MultiApProfile::eMultiApProfile::MULTIAP_PROFILE_2;
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 1ab457abc..ef51cb65a 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4242,6 +4242,7 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
             static_cast<uint8_t>(db->device_conf.active_acs_chansel_enable);
         config_msg->chansel_preference_report_refresh_enable() =
             static_cast<uint8_t>(db->device_conf.chansel_preference_report_refresh_enable);
+        config_msg->enable_cotdma() = static_cast<uint8_t>(db->device_conf.enable_cotdma);
         LOG(DEBUG) << "[CBS] son_slave: sending CONFIGURE to fronthaul " << iface
                    << " with cbs_based_chansel_enable="
                    << int(config_msg->cbs_based_chansel_enable())
diff --git a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
index ad7d9eb7e..a5ceeb723 100644
--- a/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
+++ b/common/beerocks/bwl/include/bwl/base_wlan_hal_types.h
@@ -303,6 +303,7 @@ struct hal_conf_t {
     uint8_t multi_ap_profile = MULTIAP_PROFILE_2;
     std::string phy_name;
     bool radio_disable = false;
+    bool enable_cotdma = false;
 };
 
 //sta_wlan_hal
diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index 4752c1edd..595f4099a 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -5603,16 +5603,22 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     conf.set_create_vap_value(vap_id, "notify_mgmt_frames", "1");
                     /* Enable MAPC negotiation on fronthaul VAPs so hostapd participates in
                      * EasyMesh coordinated TDMA discovery and capability exchange. */
-                    if (conf.get_vap_value(vap_id, "mapc_negotiation_mode") != "1") {
+                    if (get_hal_conf().enable_cotdma &&
+                        conf.get_vap_value(vap_id, "mapc_cotdma_enable") != "1") {
+                        if (conf.set_create_vap_value(vap_id, "mapc_cotdma_enable", "1")) {
+                            LOG(INFO) << "update_vap_credentials: set mapc_cotdma_enable=1 "
+                                      << "in hostapd config for " << m_radio_info.iface_name;
+                        } else {
+                            LOG(WARNING) << "update_vap_credentials: failed to set "
+                                         << "mapc_cotdma_enable in hostapd config for "
+                                         << m_radio_info.iface_name;
+                        }
+                    }
+                    if (get_hal_conf().enable_cotdma &&
+                        conf.get_vap_value(vap_id, "mapc_negotiation_mode") != "1") {
                         if (conf.set_create_vap_value(vap_id, "mapc_negotiation_mode", "1")) {
-                            if (!conf.store("")) {
-                                LOG(WARNING) << "update_vap_credentials: failed to save "
-                                             << "mapc_negotiation_mode=1 in hostapd config for "
-                                             << m_radio_info.iface_name;
-                            } else {
-                                LOG(INFO) << "update_vap_credentials: set mapc_negotiation_mode=1 "
-                                          << "in hostapd config for " << m_radio_info.iface_name;
-                            }
+                            LOG(INFO) << "update_vap_credentials: set mapc_negotiation_mode=1 "
+                                      << "in hostapd config for " << m_radio_info.iface_name;
                         } else {
                             LOG(WARNING) << "update_vap_credentials: failed to set "
                                          << "mapc_negotiation_mode in hostapd config for "
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 6292799dd..cb139f69b 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -53,6 +53,9 @@ cACTION_APMANAGER_CONFIGURE:
   # the CBS-based channel-selection approach. Enables the channel-preference-report refresh / CPR
   # feature without requiring cbs_based_chansel_enable.
   chansel_preference_report_refresh_enable: uint8_t #bool
+  # When set, mapc_cotdma_enable=1 and mapc_negotiation_mode=1 are written to hostapd.conf
+  # for fronthaul VAPs so hostapd participates in CoTDMA coordination.
+  enable_cotdma: uint8_t #bool
 
 cACTION_APMANAGER_JOINED_NOTIFICATION:
   _type: class
-- 
2.34.1

