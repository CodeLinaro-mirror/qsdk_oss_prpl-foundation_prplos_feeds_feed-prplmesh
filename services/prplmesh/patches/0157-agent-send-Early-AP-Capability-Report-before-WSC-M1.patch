From 3fd78ef97ea02a141fdef099613c2ae64b086872 Mon Sep 17 00:00:00 2001
From: Nirmal Raj S <nirm@qti.qualcomm.com>
Date: Wed, 13 May 2026 15:43:18 +0530
Subject: [PATCH] agent: send Early AP Capability Report before WSC M1 in
 autoconfig FSM

Signed-off-by: Nirmal Raj S <nirm@qti.qualcomm.com>
---
 .../slave/tasks/ap_autoconfiguration_task.cpp     | 15 +++++++--------
 1 file changed, 7 insertions(+), 8 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index ba4e7c3e7..5bb94e6f8 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -965,13 +965,19 @@ bool ApAutoConfigurationTask::send_ap_autoconfiguration_search_message(
 bool ApAutoConfigurationTask::send_ap_autoconfiguration_wsc_m1_message(
     const std::string &radio_iface)
 {
+    auto db    = AgentDB::get();
+    // Send Early AP Capability
+    if (db->controller_info.early_ap_capability) {
+        LOG(INFO) << "Sending EARLY_AP_CAPABILITY Before M1 for " << radio_iface;
+        m_btl_ctx.send_event(slave_thread::eEvent::CONTROLLER_EARLY_AP_CAPABILITY);
+    }
+
     LOG(DEBUG) << "Sending AP_AUTOCONFIGURATION_WSC_MESSAGE with M1 " << radio_iface;
     if (!m_cmdu_tx.create(0, ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_WSC_MESSAGE)) {
         LOG(ERROR) << "Failed creating AP_AUTOCONFIGURATION_WSC_MESSAGE";
         return false;
     }
 
-    auto db    = AgentDB::get();
     auto radio = db->radio(radio_iface);
     if (!radio) {
         return false;
@@ -1452,13 +1458,6 @@ void ApAutoConfigurationTask::handle_ap_autoconfiguration_response(
                << " band, controller bridge_mac=" << src_mac
                << ", prplmesh_controller=" << prplmesh_controller;
 
-    // Send Early AP Capability
-    if (db->controller_info.early_ap_capability &&
-        !db->controller_info.early_ap_capability_report_sent) {
-        db->controller_info.early_ap_capability_report_sent = true;
-        m_btl_ctx.send_event(slave_thread::eEvent::CONTROLLER_EARLY_AP_CAPABILITY);
-    }
-
     // Update the AP Manager with the Multi-AP Controller Profile
     m_btl_ctx.m_radio_managers.do_on_each_radio_manager(
         [&](slave_thread::sManagedRadio &radio_manager,
-- 
2.34.1

