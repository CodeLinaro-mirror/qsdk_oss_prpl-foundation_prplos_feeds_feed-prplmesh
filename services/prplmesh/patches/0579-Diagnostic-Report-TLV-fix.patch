From 940283de77a21c88b7f014497c3b560de1a5d033 Mon Sep 17 00:00:00 2001
From: Sonali Naresh <sonanare@qti.qualcomm.com>
Date: Thu, 29 Oct 2026 14:30:50 +0530
Subject: [PATCH] Diagnostic Report TLV fix

Signed-off-by: Sonali Naresh <sonanare@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 36 +++++++++++++------
 .../fronthaul_manager/ap_manager/ap_manager.h |  3 ++
 agent/src/beerocks/slave/son_slave_thread.cpp |  2 ++
 .../tlvf/beerocks_message_apmanager.yaml      |  4 +++
 controller/src/beerocks/master/controller.cpp |  4 ++-
 5 files changed, 38 insertions(+), 11 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 26aa4d6..6da3e81 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -1485,10 +1485,12 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
         chansel_preference_report_refresh_enable =
             static_cast<bool>(config->chansel_preference_report_refresh_enable());
         enable_cotdma      = static_cast<bool>(config->enable_cotdma());
+        rsn_overriding_supported = static_cast<bool>(config->rsn_overriding_supported());
         m_local_gw         = static_cast<bool>(config->local_gw());
         m_radio_disable    = static_cast<bool>(config->radio_disable());
         LOG(DEBUG) << "ACTION_APMANAGER_CONFIGURE: local_gw=" << m_local_gw
-                   << " radio_disable=" << m_radio_disable;
+                   << " radio_disable=" << m_radio_disable
+                   << " rsn_overriding_supported=" << rsn_overriding_supported;
 
         if (create_ap_wlan_hal()) {
             LOG(DEBUG) << "Move to ATTACHING state";
@@ -5557,18 +5559,32 @@ bool ApManager::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_ptr)
             return false;
         }
         profile2_status_code_tlv->status_code() = sta_conn_fail->status;
-        auto profile2_reason_code_tlv = cmdu_tx.addClass<wfa_map::tlvProfile2ReasonCode>();
-        if (!profile2_reason_code_tlv) {
-            LOG(ERROR) << "addClass wfa_map::tlvProfile2ReasonCode!";
-            return false;
+
+        // Reason Code TLV is only added when Status Code == 0 (STA was disassociated or
+        // deauthenticated); when Status Code is non-zero (association/authentication
+        // failure), the Reason Code TLV must not be included (EasyMesh v6.0 §6.4).
+        if (sta_conn_fail->status == 0) {
+            auto profile2_reason_code_tlv = cmdu_tx.addClass<wfa_map::tlvProfile2ReasonCode>();
+            if (!profile2_reason_code_tlv) {
+                LOG(ERROR) << "addClass wfa_map::tlvProfile2ReasonCode!";
+                return false;
+            }
+            profile2_reason_code_tlv->reason_code() =
+                static_cast<wfa_map::tlvProfile2ReasonCode::eReasonCode>(sta_conn_fail->reason);
+        }
+
+        if (!rsn_overriding_supported) {
+            LOG(DEBUG) << "rsn_overriding_supported=0 from Agent: RSN Diagnostic Report TLV not "
+                          "added to Failed Connection Message";
         }
-        profile2_reason_code_tlv->reason_code() =
-            static_cast<wfa_map::tlvProfile2ReasonCode::eReasonCode>(sta_conn_fail->reason);
 
         // Per EasyMesh R6.1 §8/§17.2.106: only include the RSN Diagnostic Report TLV for
-        // RSNA BSSes (bss_uses_rsna, set by the HAL) with a classified RSN error.
-        if (sta_conn_fail->bss_uses_rsna &&
-            sta_conn_fail->rsn_error != bwl::eRsnError::NONE) {
+        // RSNA BSSes (bss_uses_rsna, set by the HAL) with a classified RSN error, and only
+        // when the Agent advertises RSN_Overriding=1 (beerocks_agent.conf::rsn_overriding_supported)
+        // in the AP Capability TLV. The flag comes from cACTION_APMANAGER_CONFIGURE since this
+        // process's AgentDB copy is not populated.
+        if (sta_conn_fail->bss_uses_rsna && sta_conn_fail->rsn_error != bwl::eRsnError::NONE &&
+            rsn_overriding_supported) {
             auto rsn_diag_tlv = cmdu_tx.addClass<wfa_map::tlvRsnDiagnosticReport>();
             if (!rsn_diag_tlv) {
                 LOG(ERROR) << "addClass wfa_map::tlvRsnDiagnosticReport failed!";
diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
index 91b4a8a..5319099 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.h
@@ -432,6 +432,9 @@ private:
     // process in cACTION_APMANAGER_CONFIGURE (beerocks_agent.conf).
     bool chansel_preference_report_refresh_enable = false;
     bool enable_cotdma = false;
+    // beerocks_agent.conf::rsn_overriding_supported, received in cACTION_APMANAGER_CONFIGURE.
+    // Gates the RSN Diagnostic Report TLV in the Failed Connection Message.
+    bool rsn_overriding_supported = false;
     bool radio_state_lock   = false;
 #if defined(USE_PRPLMESH_WHM) || defined(USE_PRPLMESH_NLHAL)
     bool m_vaps_teardown_confirmed = false;
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index cc1f3f7..99d56de 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -4028,6 +4028,8 @@ bool slave_thread::handle_cmdu_ap_manager_message(const std::string &fronthaul_i
         config_msg->chansel_preference_report_refresh_enable() =
             static_cast<uint8_t>(db->device_conf.chansel_preference_report_refresh_enable);
         config_msg->enable_cotdma() = static_cast<uint8_t>(db->device_conf.enable_cotdma);
+        config_msg->rsn_overriding_supported() =
+            static_cast<uint8_t>(db->device_conf.rsn_overriding_supported);
         LOG(DEBUG) << "[CBS] son_slave: sending CONFIGURE to fronthaul " << iface
                    << " with cbs_based_chansel_enable="
                    << int(config_msg->cbs_based_chansel_enable())
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 592e99c..68dc5ea 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -55,6 +55,10 @@ cACTION_APMANAGER_CONFIGURE:
   # When set, mapc_cotdma_enable=1 and mapc_negotiation_mode=1 are written to hostapd.conf
   # for fronthaul VAPs so hostapd participates in CoTDMA coordination.
   enable_cotdma: uint8_t #bool
+  # Mirrors beerocks_agent.conf::rsn_overriding_supported (RSN_Overriding bit advertised in the
+  # AP Capability TLV). The RSN Diagnostic Report TLV is only added to the Failed Connection
+  # Message when this is set.
+  rsn_overriding_supported: uint8_t #bool
 
 cACTION_APMANAGER_JOINED_NOTIFICATION:
   _type: class
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index e26abd5..825472e 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -4554,8 +4554,10 @@ bool Controller::handle_cmdu_1905_failed_connection_message(const sMacAddr &src_
     auto reason_code              = wfa_map::tlvProfile2ReasonCode::UNSPECIFIED_REASON;
     auto profile2_reason_code_tlv = cmdu_rx.getClass<wfa_map::tlvProfile2ReasonCode>();
 
+    // Reason Code TLV is only mandated when Status Code == 0 (EasyMesh v6.0 §6.4); when
+    // Status Code is non-zero the Agent legitimately omits it, so only flag it missing here.
     if (agent->profile > wfa_map::tlvProfile2MultiApProfile::eMultiApProfile::MULTIAP_PROFILE_1 &&
-        !profile2_reason_code_tlv) {
+        !profile2_reason_code_tlv && status_code == 0) {
         LOG(ERROR) << "Profile2 Reason Code tlv is not supplied for Agent " << src_mac
                    << " with profile enum " << agent->profile;
     }
-- 
2.34.1

