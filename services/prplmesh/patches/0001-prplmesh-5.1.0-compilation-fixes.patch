     include_directories(${MODULE_PATH}/cfg/dm)
 
     foreach (item ${bpl_platform_sources})
@@ -180,17 +225,19 @@ if (USE_PRPLMESH_WHM)
 
     list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl.cpp)
     list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl_cfg_wifi.cpp)
-    list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl_cfg_device_info.cpp)
-
+    list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl_cfg.cpp)
+    
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${WBAPI_SOCK}")
 
     list(APPEND BPL_LIBS wbapi)
 else ()
+    if(NOT DEFINED USE_PRPLMESH_NLHAL)
     file(GLOB_RECURSE bpl_platform_sources
         ${MODULE_PATH}/*/linux/*.c*
 	    ${MODULE_PATH}/service_prioritization/dummy/service_prio_utils_dummy.c*
         ${MODULE_PATH}/cfg/dummy/*.c*
     )
+    endif()
 endif()
 
 # BPL configuration via nbapi
@@ -200,6 +247,30 @@ if (_index EQUAL -1)
     message("APPEND bpl_platform_sources with ${MODULE_PATH}/cfg/dm/bpl_amx.cpp")
     list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl_amx.cpp)
 endif()
+
+# BPL device info functions (get_serial_number, get_model_number, etc.)
+# These functions are needed by bpl_board.cpp and require ambiorix client definitions from bpl.cpp
+# Skip adding dm/bpl.cpp and dm/bpl_cfg_device_info.cpp when USE_PRPLMESH_NLHAL is defined
+# as they require ambiorix/wbapi which is not available in NLHAL mode
+if(NOT USE_PRPLMESH_NLHAL)
+    list(FIND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl.cpp _index)
+    if (_index EQUAL -1)
+        message("APPEND bpl_platform_sources with ${MODULE_PATH}/cfg/dm/bpl.cpp")
+        list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl.cpp)
+        # bpl.cpp requires wbapi for AmbiorixClient
+        list(FIND BPL_LIBS wbapi _wbapi_index)
+        if (_wbapi_index EQUAL -1)
+            list(APPEND BPL_LIBS wbapi)
+        endif()
+    endif()
+
+    list(FIND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl_cfg_device_info.cpp _index)
+    if (_index EQUAL -1)
+        message("APPEND bpl_platform_sources with ${MODULE_PATH}/cfg/dm/bpl_cfg_device_info.cpp")
+        list(APPEND bpl_platform_sources ${MODULE_PATH}/cfg/dm/bpl_cfg_device_info.cpp)
+    endif()
+endif()
+
 list(APPEND BPL_LIBS nbapi)
 
