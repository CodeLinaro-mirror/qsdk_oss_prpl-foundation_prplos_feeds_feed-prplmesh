  * See LICENSE file for more details.
  */
-
+#ifdef USE_PRPLMESH_WHM
 #include "bpl_cfg_pwhm.h"
+#endif
 #include <bcl/beerocks_version.h>
 #include <bpl/bpl_cfg.h>
 #include <mapf/common/utils.h>
@@ -16,6 +17,7 @@ using namespace mapf;
 namespace beerocks {
 namespace bpl {
 
+#ifdef USE_PRPLMESH_WHM
 bool get_string_value_dm(std::string attr, std::string &value)
 {
     std::string dm                 = "DeviceInfo";
@@ -58,55 +60,82 @@ bool get_string_value_dm(std::string attr, std::string &value)
     return true;
 }
 
+#endif
+
 bool get_serial_number(std::string &serial_number)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "SerialNumber";
 
     if (!get_string_value_dm(attr, serial_number) || serial_number == "") {
         serial_number.assign("prplmesh12345");
     }
     return true;
+#else
+    LOG(ERROR) << "Assigning dummy serial_number due to Ambiorix dependency";
+    serial_number.assign("prplmesh12345");
+    return true;
+#endif
 }
 
 bool get_software_version(std::string &software_version)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "SoftwareVersion";
 
     if (!get_string_value_dm(attr, software_version) || software_version == "") {
         std::string version_string = beerocks::version::get_module_version();
         software_version.assign(version_string);
     }
+#else
+    LOG(ERROR) << "Assigning dummy software version due to Ambiorix dependency";
+    std::string version_string = beerocks::version::get_module_version();
+    software_version.assign(version_string);
+#endif
     return true;
 }
 
 bool get_manufacturer(std::string &manufacturer)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "Manufacturer";
 
     if (!get_string_value_dm(attr, manufacturer) || manufacturer == "") {
         manufacturer = "prplMesh";
     }
+#else
+    manufacturer = "prplMesh";
+#endif
 
     return true;
 }
 
 bool get_model_name(std::string &model_name)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "ModelName";
 
     if (!get_string_value_dm(attr, model_name) || model_name == "") {
         model_name = "Ubuntu";
     }
 
+#else
+    model_name = "Ubuntu";
+#endif
+
     return true;
 }
 
 bool get_model_number(std::string &model_number)
 {
+#ifdef USE_PRPLMESH_WHM
     std::string attr = "ModelNumber";
     if (!get_string_value_dm(attr, model_number) || model_number == "") {
         model_number = "18.04";
     }
+#else
+    model_number = "18.04";
+#endif
     return true;
 }
 
