index 000000000..70b358f37
--- /dev/null
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_device_info.cpp
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * SPDX-FileCopyrightText: 2016-2021 the prplMesh contributors (see AUTHORS.md)
+ *
+ * This code is subject to the terms of the BSD+Patent license.
+ * See LICENSE file for more details.
+ */
+
+#include <bcl/beerocks_version.h>
+#include <bpl/bpl_cfg.h>
+#include <mapf/common/logger.h>
+
+namespace beerocks {
+namespace bpl {
+
+/*
+ * Function to get the Serial Number
+ * Returns default value for NLHAL builds
+ */
+bool get_serial_number(std::string &serial_number)
+{
+    serial_number = "prplmesh12345";
+    return true;
+}
+
+/*
+ * Function to get the Software Version
+ * Returns the prplMesh version
+ */
+bool get_software_version(std::string &software_version)
+{
+    software_version = beerocks::version::get_module_version();
+    return true;
+}
+
+/*
+ * Function to get the Manufacturer
+ * Returns default value for NLHAL builds
+ */
+bool get_manufacturer(std::string &manufacturer)
+{
+    manufacturer = "prplMesh";
+    return true;
+}
+
+/*
+ * Function to get the Model Name
+ * Returns default value for NLHAL builds
+ */
+bool get_model_name(std::string &model_name)
+{
+    model_name = "OpenWrt";
+    return true;
+}
+
+/*
+ * Function to get the Model Number
+ * Returns default value for NLHAL builds
+ */
+bool get_model_number(std::string &model_number)
+{
+    model_number = "modelnumber12345";
+    return true;
+}
+
+/*
+ * Function to get max prioritization rules
+ * Not supported in NLHAL builds
+ */
+bool get_max_prioritization_rules(uint32_t &max_prioritization_rules)
+{
+    LOG(ERROR) << __func__ << ": not supported in NLHAL";
+    return false;
+}
+
+/*
+ * Function to get RUID chipset vendor
+ * Not supported in NLHAL builds
+ */
+bool get_ruid_chipset_vendor(const sMacAddr &ruid, std::string &chipset_vendor)
+{
+    LOG(ERROR) << __func__ << ": not supported in NLHAL";
+    return false;
+}
+
+} // namespace bpl
+} // namespace beerocks
