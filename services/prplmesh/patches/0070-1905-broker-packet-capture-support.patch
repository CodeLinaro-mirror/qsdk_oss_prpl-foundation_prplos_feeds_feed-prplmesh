+void Ieee1905Transport::init_pcap_capture(const std::string &filename)
+{
+    if (m_pcap_enabled) {
+        LOG(WARNING) << "PCAP capture already initialized";
+        return;
+    }
+
+    // Create a pcap handle for Ethernet (DLT_EN10MB)
+    m_pcap_handle = pcap_open_dead(DLT_EN10MB, 65535);
+    if (!m_pcap_handle) {
+        LOG(ERROR) << "Failed to create PCAP handle";
+        return;
+    }
+
+    // Open the dump file
+    m_pcap_dumper = pcap_dump_open(m_pcap_handle, filename.c_str());
+    if (!m_pcap_dumper) {
+        LOG(ERROR) << "Failed to open PCAP dump file: " << filename
+                   << " - Error: " << pcap_geterr(m_pcap_handle);
+        pcap_close(m_pcap_handle);
+        m_pcap_handle = nullptr;
+        return;
+    }
+
+    m_pcap_enabled = true;
+    LOG(INFO) << "PCAP capture initialized successfully to file: " << filename;
+}
+
+void Ieee1905Transport::write_to_pcap(const uint8_t *data, size_t len, const sMacAddr &src,
+                                      const sMacAddr &dst, bool is_tx)
+{
+    if (!m_pcap_enabled || !m_pcap_dumper) {
+        return;
+    }
+
+    // Create Ethernet header (14 bytes) + IEEE 1905.1 payload
+    std::vector<uint8_t> packet;
+    packet.reserve(14 + len);
+
+    // Destination MAC (6 bytes)
+    packet.insert(packet.end(), dst.oct, dst.oct + 6);
+
+    // Source MAC (6 bytes)
+    packet.insert(packet.end(), src.oct, src.oct + 6);
+
+    // EtherType for IEEE 1905.1 (0x893a) in network byte order
+    uint16_t ethertype       = htons(0x893a);
+    uint8_t *ethertype_bytes = reinterpret_cast<uint8_t *>(&ethertype);
+    packet.insert(packet.end(), ethertype_bytes, ethertype_bytes + 2);
+
+    // IEEE 1905.1 payload
+    packet.insert(packet.end(), data, data + len);
+
+    // Create pcap packet header
+    struct pcap_pkthdr pkthdr;
+    struct timeval tv;
+    gettimeofday(&tv, nullptr);
+    pkthdr.ts     = tv;
+    pkthdr.caplen = packet.size();
+    pkthdr.len    = packet.size();
+
+    // Write to pcap file
+    pcap_dump(reinterpret_cast<u_char *>(m_pcap_dumper), &pkthdr, packet.data());
+    pcap_dump_flush(m_pcap_dumper);
+}
+
+void Ieee1905Transport::close_pcap_capture()
+{
+    if (!m_pcap_enabled) {
+        return;
+    }
+
+    if (m_pcap_dumper) {
+        pcap_dump_close(m_pcap_dumper);
+        m_pcap_dumper = nullptr;
+    }
+    if (m_pcap_handle) {
+        pcap_close(m_pcap_handle);
+        m_pcap_handle = nullptr;
+    }
+    m_pcap_enabled = false;
+    LOG(INFO) << "PCAP capture closed";
+}
