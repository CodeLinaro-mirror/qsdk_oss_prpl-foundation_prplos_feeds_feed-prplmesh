+/*
+ * CBS "enable 1" retry policy.
+ *
+ * QCA hostapd emits CBS-STARTED before calling driver->set_cbs(). If set_cbs() returns an
+ * error (for example -EBUSY / Resource busy), hostapd synchronously emits CBS-ABORTED and the
+ * control command returns FAIL. Retrying at trigger_cbs() therefore reacts directly to the
+ * driver's result and does not need an arbitrary CBS-completion timeout (which would be unsafe
+ * for long 6GHz scans).
+ *
+ * Keep the retry count bounded: a persistent driver busy condition must never cause an infinite
+ * command loop. The brief delay lets the shared MLD/driver abort cleanup settle before retrying.
+ */
+#ifndef CBS_TRIGGER_MAX_ABORT_RETRIES
+#define CBS_TRIGGER_MAX_ABORT_RETRIES 3
+#endif
+
+#ifndef CBS_TRIGGER_RETRY_SETTLE_MS
+#define CBS_TRIGGER_RETRY_SETTLE_MS 500
+#endif
+
 #define MLD_PAIR_ENTRANT_FILE "/tmp/beerocks/mld_pair_entrant.txt"
 
 // Neighbor Report BSSID Information field value used for EasyMesh 11v steering tests.
@@ -5637,10 +5659,11 @@ bool ap_wlan_hal_nl80211::read_acs_ranks(std::vector<sAcsChannelRank> &out_ranks
 
