-    // The driver executes the command on the hapd owning the control socket.
+    // As with read_acs_ranks, target the specific interface for this radio. The driver executes
+    // the command on the hapd owning this link's control socket, so a Resource-busy failure and
+    // its retry remain isolated to the affected link/radio.
     const std::string target_iface = m_radio_info.iface_name;
 
     if (!is_wpa_ctrl_interface_registered(target_iface)) {
@@ -5650,13 +5673,35 @@ bool ap_wlan_hal_nl80211::trigger_cbs()
         }
     }
 
-    LOG(INFO) << "[CBS] trigger_cbs: sending '" << cmd << "' on iface=" << target_iface;
-    if (!wpa_ctrl_send_msg(cmd, target_iface)) {
-        LOG(ERROR) << "[CBS] trigger_cbs: '" << cmd << "' failed on iface=" << target_iface;
-        return false;
+    // Hostapd cbs.c emits CBS-STARTED before invoking driver->set_cbs(), then emits
+    // CBS-ABORTED and returns FAIL if set_cbs() returns an error (notably -EBUSY). Therefore the
+    // synchronous wpa_ctrl result is the authoritative retry decision. Do not wait for CBS
+    // completion: a valid 6GHz CBS scan may take substantially longer than other bands.
+    for (uint8_t retry = 0;; ++retry) {
+        LOG(INFO) << "[CBS] trigger_cbs: sending '" << cmd << "' on iface=" << target_iface
+                  << " (attempt " << int(retry + 1) << "/"
+                  << int(CBS_TRIGGER_MAX_ABORT_RETRIES + 1) << ")";
+
+        if (wpa_ctrl_send_msg(cmd, target_iface)) {
+            LOG(DEBUG) << "[CBS] trigger_cbs: '" << cmd << "' OK on iface=" << target_iface
+                       << (retry ? " after Resource-busy retry" : "");
+            return true;
+        }
+
+        if (retry >= CBS_TRIGGER_MAX_ABORT_RETRIES) {
+            LOG(ERROR) << "[CBS] trigger_cbs: '" << cmd << "' failed on iface=" << target_iface
+                       << " after " << int(CBS_TRIGGER_MAX_ABORT_RETRIES)
+                       << " bounded Resource-busy retry/retries; giving up";
+            return false;
+        }
+
+        LOG(WARNING) << "[CBS] trigger_cbs: '" << cmd << "' failed on iface=" << target_iface
+                     << " (hostapd reports CBS-ABORTED when driver set_cbs() rejects the request, "
+                        "e.g. Resource busy); retrying after "
+                     << CBS_TRIGGER_RETRY_SETTLE_MS << "ms (retry " << int(retry + 1) << "/"
+                     << int(CBS_TRIGGER_MAX_ABORT_RETRIES) << ")";
+        std::this_thread::sleep_for(std::chrono::milliseconds(CBS_TRIGGER_RETRY_SETTLE_MS));
     }
-    LOG(DEBUG) << "[CBS] trigger_cbs: '" << cmd << "' OK on iface=" << target_iface;
-    return true;
 }
 
