+            LOG(WARNING) << "[CBS] CBS-ABORTED received on interface " << interface
+                         << " (vap_id=" << vap_id
+                         << ") - driver aborted the CBS scan (e.g. Resource busy). The agent's "
+                            "ChannelSelectionTask retry-on-timeout will re-issue 'cbs enable 1'.";
+        } else {
+            LOG(DEBUG) << "Unhandled event received: " << opcode;
+        }
         break;
     };
     }
