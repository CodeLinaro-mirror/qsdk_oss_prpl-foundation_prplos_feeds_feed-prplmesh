+bool ChannelSelectionTask::issue_cbs_trigger(const sMacAddr &radio_mac)
+{
+    // Build and send the TRIGGER_CBS ("cbs enable 1") request for this radio.
+    //
+    // NOTE (design): this function is deliberately a thin, fire-and-forget send. The driver
+    // "Resource busy" (CBS-ABORTED) recovery is handled SYNCHRONOUSLY and LOCALLY in
+    // ap_wlan_hal_nl80211::trigger_cbs() (where the wpa_ctrl "CBS enable 1" FAIL is observed
+    // directly), NOT here with a wall-clock timeout - CBS completion time is band-dependent
+    // (6GHz can take > 1 minute) and a finish-timeout here would misfire into an infinite retry
+    // storm. See LLDs_Design_Doc/cbs_trigger_feedback_and_retry_design.md (Section 4.3).
+    auto request =
+        message_com::create_vs_message<beerocks_message::cACTION_BACKHAUL_HOSTAP_TRIGGER_CBS>(
+            m_cmdu_tx);
+    if (!request) {
+        LOG(ERROR) << "[CBS] issue_cbs_trigger: failed to build TRIGGER_CBS message for radio "
+                   << radio_mac;
+        return false;
+    }
+    auto agent_fd = m_btl_ctx.get_agent_fd();
+    if (agent_fd == beerocks::net::FileDescriptor::invalid_descriptor) {
+        LOG(ERROR) << "[CBS] issue_cbs_trigger: socket to Agent not found for radio " << radio_mac;
+        return false;
+    }
+    auto action_header         = message_com::get_beerocks_header(m_cmdu_tx)->actionhdr();
+    action_header->radio_mac() = radio_mac;
+    m_btl_ctx.send_cmdu(agent_fd, m_cmdu_tx);
+
+    LOG(DEBUG) << "[CBS] issue_cbs_trigger: TRIGGER_CBS sent for radio " << radio_mac;
+    return true;
+}
