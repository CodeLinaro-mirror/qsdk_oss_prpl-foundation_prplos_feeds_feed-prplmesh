+void ap_wlan_hal_nl80211::add_mld_entries(std::string mld_str, std::string mlo_iface)
+{
+    LOG(DEBUG) << "ADD_MLD_ENTRIES FOR: " << mlo_iface << " with mld_id: " << mld_str;
+
+    int8_t mld_id = beerocks::string_utils::stoi(mld_str);
+ 
+    auto it = std::find_if(m_radio_info.mld_entries.begin(), m_radio_info.mld_entries.end(),
+                           [mld_id](const auto& p) { return p.first == mld_id; });
+
+    if (it != m_radio_info.mld_entries.end()) {
+        // id exists -> replace iface name
+        LOG(DEBUG) << "mld_id "<< mld_id << " exists with " << it->second;
+        it->second = mlo_iface;
+    } else {
+        // id not found -> create new entry
+        LOG(DEBUG) << "new entry for mld_id "<< mld_id;
+        m_radio_info.mld_entries.emplace_back(mld_id, mlo_iface);
+    }
+}
 
