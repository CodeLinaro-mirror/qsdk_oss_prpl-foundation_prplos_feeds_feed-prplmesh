+/**
+ * Trigger 11k beacon metrics query for a specific STA
+ *
+ * @param [in] sta_mac STA MAC address
+ * @param [in] channel Target channel
+ * @param [in] op_class Operating class
+ * @param [in] duration Measurement duration in TUs
+ * @param [in] bssid Target BSSID (use ff:ff:ff:ff:ff:ff for broadcast to all agents)
+ *
+ * @return 0 on success.
+ */
+int cli_bml::trigger_11k_beacon_query(const std::string &sta_mac, uint8_t channel,
+                                     uint8_t op_class, uint16_t duration, const std::string &bssid)
+{
+    std::cout << __func__ << ", sta_mac=" << sta_mac << ", channel=" << int(channel)
+              << ", op_class=" << int(op_class) << ", duration=" << duration
+              << ", bssid=" << bssid << std::endl;
+
+    int ret = bml_11k_query_trigger(ctx, sta_mac.c_str(), channel, op_class, duration, bssid.c_str());
+
+    printBmlReturnVals("bml_11k_query_trigger", ret);
+
+    return 0;
+}
