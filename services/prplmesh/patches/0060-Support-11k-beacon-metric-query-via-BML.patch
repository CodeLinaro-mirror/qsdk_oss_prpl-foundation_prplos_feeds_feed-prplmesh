+/**
+ * Caller function for bml_11k_query_trigger
+ *
+ * @param [in] numOfArgs Num of received arguments
+ *
+ * @return 0 on success.
+ */
+int cli_bml::bml_11k_query_trigger_caller(int numOfArgs)
+{
+    if (numOfArgs == 5) {
+        return trigger_11k_beacon_query(args.stringArgs[0], uint8_t(args.intArgs[1]),
+                                       uint8_t(args.intArgs[2]), uint16_t(args.intArgs[3]),
+                                       args.stringArgs[4]);
+    }
+    return -1;
+}
