diff --git a/controller/src/beerocks/master/son_management.cpp b/controller/src/beerocks/master/son_management.cpp
index 996e5ba21..cb64e8bcf 100644
--- a/controller/src/beerocks/master/son_management.cpp
+++ b/controller/src/beerocks/master/son_management.cpp
@@ -27,6 +27,7 @@
 #include <bml_defs.h>
 
 #include <tlvf/tlvftypes.h>
+#include <tlvf/wfa_map/tlvBeaconMetricsQuery.h>
 #include <tlvf/wfa_map/tlvClientAssociationControlRequest.h>
 #include <tlvf/wfa_map/tlvUnassociatedStaLinkMetricsQuery.h>
 
@@ -74,6 +75,7 @@ void son_management::handle_cli_message(int sd, std::shared_ptr<beerocks_header>
     }
 
     switch (beerocks_header->action_op()) {
+
     case beerocks_message::ACTION_CLI_HOSTAP_STATS_MEASUREMENT: {
         auto request_in =
             beerocks_header->addClass<beerocks_message::cACTION_CLI_HOSTAP_STATS_MEASUREMENT>();
@@ -2688,6 +2690,154 @@ void son_management::handle_bml_message(int sd, std::shared_ptr<beerocks_header>
         break;
     }
 
+    case beerocks_message::ACTION_BML_11K_BEACON_QUERY_REQUEST: {
+        LOG(DEBUG) << "ACTION_BML_11K_BEACON_QUERY_REQUEST";
+
+        auto request = beerocks_header->addClass<
+            beerocks_message::cACTION_BML_11K_BEACON_QUERY_REQUEST>();
+        if (!request) {
+            LOG(ERROR) << "addClass cACTION_BML_11K_BEACON_QUERY_REQUEST failed";
+            break;
+        }
+
+        auto response = message_com::create_vs_message<
+            beerocks_message::cACTION_BML_11K_BEACON_QUERY_RESPONSE>(
+                cmdu_tx, beerocks_header->id());
+        if (!response) {
+            LOG(ERROR) << "Failed building message "
+                          "cACTION_BML_11K_BEACON_QUERY_RESPONSE !";
+            return;
+        }
+
+        auto sta_mac = request->sta_mac();
+        auto operating_class = request->operating_class();
+        auto channel = request->channel();
+        auto bssid = request->bssid();
+        
+        LOG(DEBUG) << "11k beacon query request for STA: " << sta_mac
+                   << ", channel=" << int(channel)
+                   << ", op_class=" << int(operating_class)
+                   << ", bssid=" << bssid;
+
+        // Send immediate response to BML
+        response->op_error_code() = uint8_t(0); // SUCCESS
+        controller_ctx->send_cmdu(sd, cmdu_tx);
+
+        // Get the STA's parent BSS to determine which agent to send to
+        auto client = database.get_station(sta_mac);
+        if (!client || !client->get_bss()) {
+            LOG(ERROR) << "Client " << sta_mac << " not found or not associated";
+            break;
+        }
+
+        auto hostap_mac = database.get_sta_parent(tlvf::mac_to_string(sta_mac));
+        
+        // Check if this is a broadcast request (wildcard BSSID = ff:ff:ff:ff:ff:ff)
+        bool is_broadcast = (bssid == tlvf::mac_from_string(network_utils::WILD_MAC_STRING));
+        
+        if (is_broadcast) {
+            LOG(DEBUG) << "Broadcasting IEEE 1905.1 Beacon Metrics Query to all agents for STA " << sta_mac;
+            
+            // Broadcast to all connected agents
+            for (const auto &agent : database.get_all_connected_agents()) {
+                // Create IEEE 1905.1 Beacon Metrics Query message (0x8011)
+                if (!cmdu_tx.create(0, ieee1905_1::eMessageType::BEACON_METRICS_QUERY_MESSAGE)) {
+                    LOG(ERROR) << "Failed to create BEACON_METRICS_QUERY_MESSAGE for agent " << agent->al_mac;
+                    continue;
+                }
+
