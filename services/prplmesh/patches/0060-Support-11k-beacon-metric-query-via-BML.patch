+                         response->op_error_code())) {
+                LOG(WARNING) << "Received ACTION_BML_11K_BEACON_QUERY_RESPONSE"
+                             << " response, but no one is waiting...";
+            }
+        } break;
         default: {
             LOG(WARNING) << "unhandled header BML action type 0x" << std::hex
                          << int(beerocks_header->action_op());
@@ -4347,6 +4363,85 @@ bool bml_internal::wake_up(uint8_t action_opcode, int value)
     return true;
 }
 
+int bml_internal::send_11k_beacon_query(const sMacAddr &sta_mac, uint8_t channel,
+                                        uint8_t op_class, uint16_t duration, const sMacAddr &bssid)
+{
+    LOG(DEBUG) << "send_11k_beacon_query for STA: " << sta_mac << ", channel=" << int(channel)
+               << ", op_class=" << int(op_class) << ", duration=" << duration
+               << ", bssid=" << bssid;
+
+    // Command supported only on local master
+    if (!is_local_master()) {
+        LOG(ERROR) << "Command supported only on local master!";
+        return (-BML_RET_OP_NOT_SUPPORTED);
+    }
+
+    // If the socket is not valid, attempt to re-establish the connection
+    if (!m_sockMaster) {
+        int iRet = connect_to_master();
+        if (iRet != BML_RET_OK) {
+            LOG(ERROR) << "send_11k_beacon_query - connect_to_master failed";
+            return iRet;
+        }
+    }
+
+    // Create the beacon query request message
+    auto request = message_com::create_vs_message<
+        beerocks_message::cACTION_BML_11K_BEACON_QUERY_REQUEST>(cmdu_tx);
+
+    if (!request) {
+        LOG(ERROR) << "Failed building cACTION_BML_11K_BEACON_QUERY_REQUEST message!";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    // Fill in the request parameters
+    request->sta_mac()          = sta_mac;
+    request->operating_class()  = op_class;
+    request->channel()          = channel;
+    request->bssid()            = bssid; // Target BSSID (ff:ff:ff:ff:ff:ff for broadcast)
+    request->reporting_detail() = 1; // Request all fixed fields and elements
+
+    // Debug log: 11k query frame transmission at Controller
+    LOG(DEBUG) << "11K_QUERY_TX_CONTROLLER: Transmitting 11k beacon query - "
+               << "STA_MAC=" << sta_mac 
+               << ", CHANNEL=" << int(channel)
+               << ", OP_CLASS=" << int(op_class)
+               << ", DURATION=" << duration;
+
+    // Empty SSID (wildcard)
+    if (!request->alloc_ssid(0)) {
+        LOG(ERROR) << "Failed to allocate SSID field";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    // No AP channel reports
+    if (!request->alloc_ap_channel_reports(0)) {
+        LOG(ERROR) << "Failed to allocate AP channel reports";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    // No specific element IDs requested
+    if (!request->alloc_element_ids(0)) {
+        LOG(ERROR) << "Failed to allocate element IDs";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    // Send the message and wait for response
+    int result = 0;
+    if (send_bml_cmdu(result, request->get_action_op()) != BML_RET_OK) {
+        LOG(ERROR) << "Send cACTION_BML_11K_BEACON_QUERY_REQUEST failed";
+        return (-BML_RET_OP_FAILED);
+    }
+
+    if (result != 0) {
+        LOG(ERROR) << "cACTION_BML_11K_BEACON_QUERY_REQUEST returned error code:" << result;
+        return result;
+    }
+
+    LOG(DEBUG) << "11k beacon query sent successfully for STA: " << sta_mac;
+    return BML_RET_OK;
+}
