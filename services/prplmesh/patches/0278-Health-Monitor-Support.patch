+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#ifndef _HEALTH_MONITORING_TASK_H_
+#define _HEALTH_MONITORING_TASK_H_
+
+#include "task.h"
+
+namespace beerocks {
+
+// Forward declaration for Agent context
+class slave_thread;
+
+class HealthMonitoringTask : public Task {
+public:
+    HealthMonitoringTask(slave_thread &btl_ctx, ieee1905_1::CmduMessageTx &cmdu_tx);
+    ~HealthMonitoringTask() {}
+
+    bool handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                     const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                     std::shared_ptr<beerocks_header> beerocks_header) override;
+
+private:
+    /**
+     * @brief Handle VENDOR_SPECIFIC_MESSAGE
+     *
+     * @param cmdu_rx Received CMDU.
+     * @param src_mac Source MAC address (controller AL-MAC) of the message.
+     * @param beerocks_header Parsed vendor-specific beerocks header.
+     * @return true if the message was handled, false otherwise.
+     */
+    bool handle_vendor_specific(ieee1905_1::CmduMessageRx &cmdu_rx, const sMacAddr &src_mac,
+                                std::shared_ptr<beerocks_header> beerocks_header);
+
+    slave_thread &m_btl_ctx;
+    ieee1905_1::CmduMessageTx &m_cmdu_tx;
+};
+
+} // namespace beerocks
+
+#endif // _HEALTH_MONITORING_TASK_H_
