+class HealthMonitoringTask : public task {
+public:
+    HealthMonitoringTask(db &database, ieee1905_1::CmduMessageTx &cmdu_tx);
+    ~HealthMonitoringTask() {}
+
+    bool handle_ieee1905_1_msg(const sMacAddr &src_mac,
+                               ieee1905_1::CmduMessageRx &cmdu_rx) override;
+
+#define FOREACH_HEALTH_MONITORING_STATE(STATE)                                                     \
+    STATE(INIT)                                                                                    \
+    STATE(MONITORING)
+
+    // State ENUM
+    enum class eState { FOREACH_HEALTH_MONITORING_STATE(GENERATE_ENUM) };
+
+protected:
+    void work() override;
+
+private:
+    db &m_database;
+    ieee1905_1::CmduMessageTx &m_cmdu_tx;
+
+    /**
+     * @brief Current FSM state. Starts at eState::INIT, moves to eState::MONITORING (and stays
+     * there permanently, since this task never "finishes") after one-time initialization of
+     * timer/tracking state has been performed on the first work() invocation.
+     */
+    eState m_fsm_state = eState::INIT;
+
+    /**
+     * @brief Move the FSM to a new state, logging the transition.
+     *
+     * @param new_state State to move to.
+     */
+    void fsm_move_state(eState new_state);
+
+    /**
+     * @brief Per-agent onboarding-episode tracking data.
+     *
+     * Presence of an agent's entry in m_onboarding_trackers means that agent's onboarding
+     * episode is still pending (waiting for full BSS report); the entry is erased as soon as
+     * the episode is resolved (either completed or found incomplete), so no separate state
+     * field is needed.
+     */
+    struct sOnboardingTracker {
+        /// time_point when the first Search was received from this agent (i.e. when tracking
+        /// began).
+        std::chrono::steady_clock::time_point start_time;
+
+        /// Set of radio UIDs that have been confirmed as fully onboarded (BSS count matches
+        /// configured non-teardown BSS count for that radio).
+        std::unordered_set<sMacAddr> confirmed_radios;
+    };
+
+    /**
+     * @brief Per-agent onboarding-episode tracking map.
+     *
+     * Key:   agent AL-MAC address
+     * Value: onboarding episode state for that agent
+     *
+     * Entry is added on first Search from an agent (see handle_ieee1905_1_msg()).
+     * Entry is removed when onboarding completes (all BSSes reported, see
+     * update_onboarding_progress()), or when CloningIncomplete fires, or when the
+     * entry is purged as stale (both handled in check_onboarding_trackers()).
+     */
+    std::unordered_map<sMacAddr, sOnboardingTracker> m_onboarding_trackers;
+
+    /// Interval between periodic onboarding checks (CloningIncomplete detection / stale-entry
+    /// purge). This timer/interval is specific to onboarding monitoring; other detectors added
+    /// to this task in the future should define their own dedicated interval/timer instead of
+    /// sharing this one.
+    static constexpr std::chrono::seconds ONBOARDING_MONITORING_CHECK_INTERVAL{5};
+
+    /// Time of last onboarding periodic check execution.
+    std::chrono::steady_clock::time_point m_onboarding_trackers_last_check_time;
+
+    /**
+     * @brief Per-agent RenewFailure tracking data.
+     *
+     * Snapshot of the expected per-radio SSID/BSSID configuration taken at the moment a Renew
+     * was observed to have been sent (see check_renew_trackers()), plus the set of radios that
+     * have since confirmed re-applying that configuration (via handle_topology_response()).
+     *
+     * Declared here (ahead of the onboarding-related member function declarations below) since
+     * update_renew_progress()'s signature references it, and nested-type references in member
+     * function declarations must resolve to an already-declared type at that point.
+     */
+    struct sRenewTracker {
+        /// time_point when this session was created (i.e. when the Renew was observed sent).
+        std::chrono::steady_clock::time_point start_time;
+
+        /// Per-radio expected SSID multiset, snapshotted from
+        /// database.get_configured_bss_info(ruid) (non-teardown entries) at session-creation
+        /// time. Key: radio UID.
+        std::unordered_map<sMacAddr, std::multiset<std::string>> expected_ssids_per_radio;
+
+        /// Set of radio UIDs that have confirmed matching their expected SSID set in a
+        /// subsequent TOPOLOGY_RESPONSE_MESSAGE.
+        std::unordered_set<sMacAddr> confirmed_radios;
+    };
+
+    /**
+     * @brief Per-agent RenewFailure session tracking map.
+     *
+     * Key:   agent AL-MAC address
+     * Value: RenewFailure session state for that agent
+     *
+     */
+    std::unordered_map<sMacAddr, sRenewTracker> m_renew_trackers;
+
+    /// Previously observed db::get_last_ap_config_renew_time() trigger time. Used to detect
+    /// that a new Renew was sent since the last time this task observed one.
+    std::chrono::steady_clock::time_point m_prev_renew_trigger_time;
+
+    static constexpr std::chrono::seconds RENEW_MONITORING_CHECK_INTERVAL{5};
+
+    /// Time of last renew-session periodic check execution.
+    std::chrono::steady_clock::time_point m_renew_trackers_last_check_time;
+
+    /**
+     * @brief Handle an AP_AUTOCONFIGURATION_SEARCH_MESSAGE by canceling any pending
+     * RenewFailure tracking and starting/continuing onboarding tracking for the sending agent.
+     *
+     * @param src_mac Source MAC address (agent AL-MAC) of the message.
+     * @param cmdu_rx Received CMDU.
+     */
+    void handle_search_message(const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Cancel any pending RenewFailure tracking for the given agent.
+     *
+     * Search is one of the two ways (along with a confirming TOPOLOGY_RESPONSE_MESSAGE with
+     * intended BSS/SSID config, see update_renew_progress()) that a Renew-triggered
+     * reconfiguration is considered resolved without needing a dedicated RenewFailure timeout.
+     * Once Search arrives, this reconfiguration attempt is tracked purely as an onboarding
+     * episode from here on. No-op if no renew tracker is present for this agent. Only invoked
+     * from handle_search_message().
+     *
+     * @param al_mac Agent AL-MAC to cancel renew tracking for.
+     */
+    void cancel_renew_tracking(const sMacAddr &al_mac);
+
+    /**
+     * @brief Start (or continue) onboarding tracking for the given agent.
+     *
+     * Records the first Search timestamp for this agent by creating a new onboarding tracker.
+     * Does NOT reset the start_time if a tracker already exists for this agent — we want the
+     * time of the first Search, not the most recent one, to measure the full onboarding
+     * episode duration. Only invoked from handle_search_message().
+     *
+     * @param al_mac Agent AL-MAC to start/continue onboarding tracking for.
+     */
+    void track_onboarding(const sMacAddr &al_mac);
+
+    /**
+     * @brief Check whether onboarding is currently being tracked for the given agent (i.e.
+     * an entry exists for it in m_onboarding_trackers).
+     *
+     * @param al_mac Agent AL-MAC to check.
+     * @return true if an onboarding tracker exists for al_mac, false otherwise.
+     */
+    bool is_onboarding_tracked(const sMacAddr &al_mac) const;
+
+    /**
+     * @brief Handle a TOPOLOGY_RESPONSE_MESSAGE to check for onboarding completion.
+     *
+     * @param src_mac Source MAC address (agent AL-MAC) of the message.
+     * @param cmdu_rx Received CMDU.
+     */
+    void handle_topology_response(const sMacAddr &src_mac, ieee1905_1::CmduMessageRx &cmdu_rx);
+
+    /**
+     * @brief Update an onboarding episode's per-radio reported-SSID progress from a
+     * TOPOLOGY_RESPONSE_MESSAGE, and finalize the episode (firing CloningKpiBreach if over
+     * threshold, then clearing tracking state) once all radios have reported. Only invoked
+     * from handle_topology_response(), passing the already-found iterator into
+     * m_onboarding_trackers to avoid a redundant re-lookup.
+     *
+     * Delegates to update_reported_radios() (mark newly-confirmed radios) followed by
+     * finalize_onboarding() (check completion and finalize if reached).
+     *
+     * @param al_mac Agent AL-MAC extracted from tlvDeviceInformation.
+     * @param episode_it Iterator into m_onboarding_trackers pointing at al_mac's entry (must
+     *                    not be m_onboarding_trackers.end()).
+     * @param tlvApInformation AP Operational BSS TLV from the message, or nullptr if absent.
+     */
+    void update_onboarding_progress(
+        const sMacAddr &al_mac,
+        std::unordered_map<sMacAddr, sOnboardingTracker>::iterator episode_it,
+        wfa_map::tlvApOperationalBSS *tlvApInformation);
+
+    /**
+     * @brief Mark the radios of the given onboarding episode that have now reported their
+     * fully-matching expected SSID configuration in a TOPOLOGY_RESPONSE_MESSAGE.
+     *
+     * Radios with no expected BSS configuration are trivially marked as reported (mirrors the
+     * legacy configured_count == 0 case). Only invoked from update_onboarding_progress().
+     *
+     * @param al_mac Agent AL-MAC (used for logging only).
+     * @param agent Agent whose expected SSID configuration is used for comparison.
+     * @param episode Onboarding episode whose confirmed_radios set is updated in-place.
+     * @param tlvApInformation AP Operational BSS TLV from the message, or nullptr if absent (no
+     *                          radios are updated in that case).
+     */
+    void update_reported_radios(const sMacAddr &al_mac, const std::shared_ptr<Agent> &agent,
+                                sOnboardingTracker &episode,
+                                wfa_map::tlvApOperationalBSS *tlvApInformation);
+
+    /**
+     * @brief Check whether the given onboarding episode has now had all its radios reported,
+     * and if so, finalize it: compute elapsed time since Search, fire CloningKpiBreach if over
+     * threshold (or log success otherwise), record the completion timestamp, and erase the
+     * episode. No-op if the episode isn't yet complete. Only invoked from
+     * update_onboarding_progress().
+     *
+     * @param al_mac Agent AL-MAC of the episode being checked.
+     * @param episode_it Iterator into m_onboarding_trackers pointing at al_mac's entry (must
+     *                    not be m_onboarding_trackers.end()). Erased if the episode is
+     *                    finalized.
+     * @param total_radio_count Total number of radios expected to report for this agent
+     *                           (typically agent->radios.size()).
+     */
+    void finalize_onboarding(
+        const sMacAddr &al_mac,
+        std::unordered_map<sMacAddr, sOnboardingTracker>::iterator episode_it,
+        size_t total_radio_count);
+
+    /**
+     * @brief Update a RenewFailure tracker's per-radio confirmed-SSID progress from a
+     * TOPOLOGY_RESPONSE_MESSAGE, finalizing (erasing) the tracker once all radios have
+     * confirmed. Only invoked from handle_topology_response(), passing the already-found
+     * iterator into m_renew_trackers to avoid a redundant re-lookup.
+     *
+     * @param al_mac Agent AL-MAC extracted from tlvDeviceInformation.
+     * @param renew_it Iterator into m_renew_trackers pointing at al_mac's entry (must not be
+     *                  m_renew_trackers.end()).
+     * @param tlvApInformation AP Operational BSS TLV from the message, or nullptr if absent.
+     */
+    void update_renew_progress(const sMacAddr &al_mac,
+                               std::unordered_map<sMacAddr, sRenewTracker>::iterator renew_it,
+                               wfa_map::tlvApOperationalBSS *tlvApInformation);
+
+    /**
+     * @brief Check whether a RenewFailure tracker is currently being tracked for the given
+     * agent (i.e. an entry exists for it in m_renew_trackers).
+     *
+     * @param al_mac Agent AL-MAC to check.
+     * @return true if a renew tracker exists for al_mac, false otherwise.
+     */
+    bool is_renew_tracked(const sMacAddr &al_mac) const;
+
+    /**
+     * @brief Per-agent timestamp of the most recent successful onboarding-episode completion.
+     */
+    std::unordered_map<sMacAddr, std::chrono::steady_clock::time_point>
+        m_last_onboarding_completion_time;
+
+    /**
+     * @brief Check whether enough time has elapsed since the last check_onboarding_trackers()
+     * invocation (per m_onboarding_trackers_last_check_time and
+     * ONBOARDING_MONITORING_CHECK_INTERVAL) to warrant running it again.
+     *
+     * @return true if check_onboarding_trackers() is due to run.
+     */
+    bool is_onboarding_trackers_check_due();
+
+    /**
+     * @brief Check whether m_onboarding_trackers currently has any entries.
+     *
+     * @return true if m_onboarding_trackers is non-empty.
+     */
+    bool has_onboarding_trackers() const;
+
+    /**
+     * @brief Iterate m_onboarding_trackers, detecting CloningIncomplete timeouts: fires
+     * CloningIncomplete for agents still alive but that never completed reporting their full
+     * configured BSS list, or silently purges the tracker (no event) for agents that have gone
+     * silent. Either way, erases the tracker once resolved. Only invoked from
+     * check_onboarding_trackers().
+     */
+    void process_onboarding_tracker_timeouts();
+
+    /**
+     * @brief Prune m_last_onboarding_completion_time entries for agents that have been fully
+     * removed from the database, as opposed to merely disconnected (which should NOT be
+     * pruned, since the agent may still reconnect using the same identity). Only invoked from
+     * check_onboarding_trackers().
+     */
+    void prune_stale_onboarding_completions();
+
+    /**
+     * @brief Detect CloningIncomplete and purge stale entries from m_onboarding_trackers.
+     *
+     * Delegates to process_onboarding_tracker_timeouts() (primary detection) followed by
+     * prune_stale_onboarding_completions() (secondary map hygiene, piggybacked on this same
+     * periodic tick).
+     */
+    void check_onboarding_trackers();
+
+    /**
+     * @brief Check whether enough time has elapsed since the last check_renew_trackers()
+     * invocation (per m_renew_trackers_last_check_time and RENEW_MONITORING_CHECK_INTERVAL)
+     * to warrant running it again.
+     *
+     * @return true if check_renew_trackers() is due to run.
+     */
+    bool is_renew_trackers_check_due();
+
+    /**
+     * @brief Create (or refresh) a RenewFailure tracker for every currently-connected agent.
+     *
+     * Only invoked from check_renew_trackers() after is_renew_triggered() has confirmed a new
+     * Renew was sent. No-op (with a log) if there are no connected agents.
+     */
+    void track_renew_for_connected_agents();
+
+    /**
+     * @brief Check whether m_renew_trackers currently has any entries.
+     *
+     * @return true if m_renew_trackers is non-empty.
+     */
+    bool has_renew_trackers() const;
+
+    /**
+     * @brief Iterate m_renew_trackers, detecting RenewFailure timeouts: fires RenewFailure for
+     * agents still alive but that never confirmed re-applying their expected BSS configuration,
+     * or silently purges the tracker (no event) for agents that have gone silent. Either way,
+     * erases the tracker once resolved. Only invoked from check_renew_trackers().
+     */
+    void process_renew_tracker_timeouts();
+
+    /**
+     * @brief Detect newly-sent Renews and RenewFailure timeouts across m_renew_trackers.
+     *
+     * Delegates to track_renew_for_connected_agents() (triggered by is_renew_triggered())
+     * followed by process_renew_tracker_timeouts() (guarded by has_renew_trackers()).
+     */
+    void check_renew_trackers();
+
+    /**
+     * @brief Check whether a new AP_AUTOCONFIGURATION_RENEW_MESSAGE has been sent since this
+     * task last observed one (per m_prev_renew_trigger_time), by querying
+     * database.get_last_ap_config_renew_time() directly.
+     *
+     * @return true if a new, not-yet-seen Renew send is detected.
+     */
+    bool is_renew_triggered() const;
+
+    /**
+     * @brief Attempt to create (or replace) a RenewFailure tracking session for the given agent.
+     *
+     * Skips session creation if onboarding is currently being tracked for the agent, or if its
+     * onboarding/renew confirmation already completed at/after the latest observed Renew-sent
+     * time (per m_last_onboarding_completion_time, compared against a fresh
+     * database.get_last_ap_config_renew_time() fetched internally). Otherwise creates a new
+     * sRenewTracker snapshotting the agent's expected per-radio SSID configuration via
+     * compute_expected_ssids_for_agent(), and installs it into m_renew_trackers[agent->al_mac]
+     * (replacing any existing session for that agent, since newer config intent supersedes
+     * older).
+     *
+     * Shared by check_renew_trackers() (periodic creation for all connected agents after a new
+     * Renew is detected) and handle_topology_response() (lazy creation for an agent whose
+     * confirming TOPOLOGY_RESPONSE_MESSAGE arrives before the next periodic check).
+     *
+     * @param agent Agent to consider creating a RenewFailure session for.
+     * @return true if a session was created for agent->al_mac, false if creation was skipped.
+     */
+    bool track_renew(const std::shared_ptr<Agent> &agent);
+
+    /**
+     * @brief Compute the expected per-radio SSID sets for an agent, based on the latest intended
+     * agent-level BSS configuration (database.get_bss_info_configuration(agent->al_mac))
+     *
+     * @param agent Agent to compute expected SSIDs for.
+     * @return Map of radio UID to multiset of expected SSIDs (only radios with at least one
+     *         non-teardown expected BSS are included).
+     */
+    std::unordered_map<sMacAddr, std::multiset<std::string>>
+    compute_expected_ssids_for_agent(const std::shared_ptr<Agent> &agent);
+
+    /**
+     * @brief Extract the set of SSIDs reported for a single radio entry from a
+     * TOPOLOGY_RESPONSE_MESSAGE's AP Operational BSS TLV.
+     *
+     * Shared by update_onboarding_progress() and update_renew_progress(),
+     * which both need to compare a radio's reported SSID set against an expected one.
+     *
+     * @param radio_entry A single radio entry from tlvApOperationalBSS::radio_list().
+     * @return Multiset of SSIDs reported for this radio (only BSSes with a valid ssid_str()).
+     */
+    static std::multiset<std::string>
+    extract_reported_ssids(wfa_map::cRadioInfo &radio_entry);
+
+    /**
+     * @brief Generate a new IncidentID value, based on the current system-clock time.
+     *
+     * Shared by all three event detectors (CloningKpiBreach, CloningIncomplete, RenewFailure)
+     * to avoid repeating the same time-conversion boilerplate at each call site.
+     *
+     * @return A monotonically-increasing-in-practice uint64_t incident identifier.
+     */
+    static uint64_t generate_incident_id();
+
+    /**
+     * @brief A deferred controller->agent health-monitor debug notification.
+     *
+     * Enqueued by enqueue_agent_notification() immediately after the controller's own local DM
+     * event has already fired, with send_time set to now + AGENT_NOTIFICATION_DELAY. This
+     * guarantees the controller's own DM event reaches the cloud before the agent is notified.
+     */
+    struct sPendingAgentNotification {
+        sMacAddr agent_al_mac;
+        beerocks_message::eHealthMonitorEventCode event_code;
+        uint64_t incident_id;
+        std::chrono::steady_clock::time_point send_time;
+    };
+
+    /// Queue of controller->agent health-monitor notifications awaiting their delayed send time.
+    std::vector<sPendingAgentNotification> m_pending_agent_notifications;
+
+    /// Minimum delay between a controller local DM event firing and the corresponding agent
+    /// notification being sent, so that the cloud receives the controller-side event first.
+    static constexpr std::chrono::seconds AGENT_NOTIFICATION_DELAY{1};
+
+    /**
+     * @brief Enqueue a deferred health-monitor notification to be sent to the given agent.
+     *
+     * Does not send immediately — the notification is sent by send_pending_agent_notifications()
+     * (invoked from work()) once AGENT_NOTIFICATION_DELAY has elapsed since this call.
+     *
+     * @param agent_al_mac AL-MAC of the agent to notify.
+     * @param event_code   Health-monitor event code identifying the incident.
+     * @param incident_id  IncidentID generated at detection time, relayed unchanged.
+     */
+    void enqueue_agent_notification(const sMacAddr &agent_al_mac,
+                                    beerocks_message::eHealthMonitorEventCode event_code,
+                                    uint64_t incident_id);
+
+    /**
+     * @brief Check whether any agent notifications are currently queued in
+     * m_pending_agent_notifications.
+     *
+     * @return true if m_pending_agent_notifications is non-empty.
+     */
+    bool has_pending_agent_notifications() const;
+
+    /**
+     * @brief Send any pending agent notifications whose delay has elapsed.
+     *
+     * Invoked from work() on every call (no dedicated gating interval needed, since each pending
+     * entry carries its own send_time). Sends ACTION_CONTROL_HEALTH_MONITOR_NOTIFICATION
+     * via son_actions::send_cmdu_to_agent(), then erases the sent entries from the queue.
+     */
+    void send_pending_agent_notifications();
+};
+
+} // namespace son
