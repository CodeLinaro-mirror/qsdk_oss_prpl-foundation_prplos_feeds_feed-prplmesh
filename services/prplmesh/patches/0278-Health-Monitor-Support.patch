diff --git a/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp b/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp
new file mode 100644
index 000000000..7684671b7
--- /dev/null
+++ b/agent/src/beerocks/slave/tasks/health_monitoring_task.cpp
@@ -0,0 +1,96 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: ISC
+ */
+
+#include "health_monitoring_task.h"
+
+#include "../agent_db.h"
+#include "../son_slave_thread.h"
+
+#include <beerocks/tlvf/beerocks_message.h>
+#include <beerocks/tlvf/beerocks_message_control.h>
+#include <easylogging++.h>
+#include <tlvf/ieee_1905_1/eMessageType.h>
+#include <tlvf/tlvftypes.h>
+
+using namespace beerocks;
+
+HealthMonitoringTask::HealthMonitoringTask(slave_thread &btl_ctx,
+                                           ieee1905_1::CmduMessageTx &cmdu_tx)
+    : Task(eTaskType::HEALTH_MONITORING), m_btl_ctx(btl_ctx), m_cmdu_tx(cmdu_tx)
+{
+    LOG(DEBUG) << "HEALTH_MONITORING: task created";
+}
+
+bool HealthMonitoringTask::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx, uint32_t iface_index,
+                                       const sMacAddr &dst_mac, const sMacAddr &src_mac, int fd,
+                                       std::shared_ptr<beerocks_header> beerocks_header)
+{
+    switch (cmdu_rx.getMessageType()) {
+    case ieee1905_1::eMessageType::VENDOR_SPECIFIC_MESSAGE: {
+        return handle_vendor_specific(cmdu_rx, src_mac, beerocks_header);
+    }
+    default: {
+        // Message was not handled, therefore return false.
+        return false;
+    }
+    }
+}
+
+bool HealthMonitoringTask::handle_vendor_specific(
+    ieee1905_1::CmduMessageRx &cmdu_rx, const sMacAddr &src_mac,
+    std::shared_ptr<beerocks_header> beerocks_header)
+{
+    if (!beerocks_header || beerocks_header->action() != beerocks_message::ACTION_CONTROL ||
+        beerocks_header->action_op() !=
+            beerocks_message::ACTION_CONTROL_HEALTH_MONITOR_NOTIFICATION) {
+        return false;
+    }
+
+    // Only process it here if it was sent in the controller->agent direction
+    if (beerocks_header->actionhdr()->direction() != beerocks::BEEROCKS_DIRECTION_AGENT) {
+        return false;
+    }
+
+    auto notification =
+        beerocks_header->addClass<beerocks_message::cACTION_CONTROL_HEALTH_MONITOR_NOTIFICATION>();
+    if (!notification) {
+        LOG(ERROR) << "HEALTH_MONITORING: addClass "
+                      "cACTION_CONTROL_HEALTH_MONITOR_NOTIFICATION failed";
+        return false;
+    }
+
+    auto db                  = AgentDB::get();
+    const auto controller_id = tlvf::mac_to_string(db->controller_info.bridge_mac);
+
+    const auto incident_id = notification->incident_id();
+
+    switch (notification->event_code()) {
+    case beerocks_message::eHealthMonitorEventCode_CLONING_KPI_BREACH: {
+        LOG(DEBUG) << "HEALTH_MONITORING: received CloningKpiBreach notification from "
+                      "controller "
+                   << src_mac << " incident_id=" << incident_id;
+        db->dm_trigger_cloning_kpi_breach_event(incident_id, "controller", controller_id);
+        break;
+    }
+    case beerocks_message::eHealthMonitorEventCode_CLONING_INCOMPLETE: {
+        LOG(DEBUG) << "HEALTH_MONITORING: received CloningIncomplete notification from "
+                      "controller "
+                   << src_mac << " incident_id=" << incident_id;
+        db->dm_trigger_cloning_incomplete_event(incident_id, "controller", controller_id);
+        break;
+    }
+    case beerocks_message::eHealthMonitorEventCode_RENEW_FAILURE: {
+        LOG(DEBUG) << "HEALTH_MONITORING: received RenewFailure notification from controller "
+                   << src_mac << " incident_id=" << incident_id;
+        db->dm_trigger_renew_failure_event(incident_id, "controller", controller_id);
+        break;
+    }
+    default:
+        LOG(WARNING) << "HEALTH_MONITORING: received unknown event_code "
+                    << int(notification->event_code()) << " from controller " << src_mac;
+        break;
+    }
+
+    return true;
+}
