+                                             uint32_t onboarding_time_ms,
+                                             uint32_t onboarding_threshold_ms)
+{
+    std::string agent_dm_path;
+    auto agent = get_agent(tlvf::mac_from_string(agent_id));
+    if (agent) {
+        agent_dm_path = agent->dm_path;
+    }
+
+    amxc_var_t event_data;
+    amxc_var_init(&event_data);
+    amxc_var_set_type(&event_data, AMXC_VAR_ID_HTABLE);
+
+    amxc_var_add_key(cstring_t, &event_data, "MACAddress",           agent_id.c_str());
+    amxc_var_add_key(cstring_t, &event_data, "DMPath",               agent_dm_path.c_str());
+    amxc_var_add_key(uint64_t,  &event_data, "IncidentID",           incident_id);
+    amxc_var_add_key(cstring_t, &event_data, "DetectedBy",           detected_by.c_str());
+    amxc_var_add_key(uint32_t,  &event_data, "OnboardingTimeMs",     onboarding_time_ms);
+    amxc_var_add_key(uint32_t,  &event_data, "OnboardingThresholdMs", onboarding_threshold_ms);
+
+    const std::string vendor_event_obj =
+        DATAELEMENTS_ROOT_DM ".Network.QCOM_Vendor.CloningKpiBreach";
+    const bool ok =
+        m_ambiorix_datamodel->trigger_event_with_data(vendor_event_obj, "Event", &event_data);
+    amxc_var_clean(&event_data);
