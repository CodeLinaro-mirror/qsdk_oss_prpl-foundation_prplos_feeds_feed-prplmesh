+constexpr std::chrono::seconds HealthMonitoringTask::RENEW_MONITORING_CHECK_INTERVAL;
+constexpr std::chrono::seconds HealthMonitoringTask::AGENT_NOTIFICATION_DELAY;
+
+static std::string s_ar_states[] = {FOREACH_HEALTH_MONITORING_STATE(GENERATE_STRING)};
+
+HealthMonitoringTask::HealthMonitoringTask(db &database, ieee1905_1::CmduMessageTx &cmdu_tx)
+    : task("health_monitoring_task"), m_database(database), m_cmdu_tx(cmdu_tx)
+{
+    // Validate configured health-monitoring timeouts: a misconfigured value of <= 0 (e.g. an
+    // explicit "0" in the config file) must not be used as-is, since it would cause detectors
+    // to fire immediately/continuously. Fall back to the documented defaults in that case.
+    if (m_database.config.health_monitoring_cloning_kpi_breach_threshold_ms.count() <= 0) {
+        LOG(WARNING) << "HEALTH_MONITORING: cloning_kpi_breach_threshold_ms must be > 0, "
+                        "using default "
+                     << DEFAULT_CLONING_KPI_BREACH_THRESHOLD_MS << " ms";
+        m_database.config.health_monitoring_cloning_kpi_breach_threshold_ms =
+            std::chrono::milliseconds(DEFAULT_CLONING_KPI_BREACH_THRESHOLD_MS);
+    }
+    if (m_database.config.health_monitoring_cloning_incomplete_timeout_ms.count() <= 0) {
+        LOG(WARNING) << "HEALTH_MONITORING: cloning_incomplete_timeout_ms must be > 0, "
+                        "using default "
+                     << DEFAULT_CLONING_INCOMPLETE_TIMEOUT_MS << " ms";
+        m_database.config.health_monitoring_cloning_incomplete_timeout_ms =
+            std::chrono::milliseconds(DEFAULT_CLONING_INCOMPLETE_TIMEOUT_MS);
+    }
+    if (m_database.config.health_monitoring_renew_failure_timeout_ms.count() <= 0) {
+        LOG(WARNING) << "HEALTH_MONITORING: renew_failure_timeout_ms must be > 0, "
+                        "using default "
+                     << DEFAULT_RENEW_FAILURE_TIMEOUT_MS << " ms";
+        m_database.config.health_monitoring_renew_failure_timeout_ms =
+            std::chrono::milliseconds(DEFAULT_RENEW_FAILURE_TIMEOUT_MS);
+    }
+
+    LOG(DEBUG) << "HEALTH_MONITORING: task created, cloning_kpi_breach_threshold_ms="
+               << m_database.config.health_monitoring_cloning_kpi_breach_threshold_ms.count()
+               << ", cloning_incomplete_timeout_ms="
+               << m_database.config.health_monitoring_cloning_incomplete_timeout_ms.count()
+               << ", renew_failure_timeout_ms="
+               << m_database.config.health_monitoring_renew_failure_timeout_ms.count();
+}
+
+void HealthMonitoringTask::fsm_move_state(eState new_state)
+{
+    LOG(TRACE) << "HEALTH_MONITORING: FSM: " << s_ar_states[int(m_fsm_state)] << " --> "
+               << s_ar_states[int(new_state)];
+    m_fsm_state = new_state;
+}
+
+bool HealthMonitoringTask::handle_ieee1905_1_msg(const sMacAddr &src_mac,
+                                                 ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    switch (cmdu_rx.getMessageType()) {
+
+    case ieee1905_1::eMessageType::AP_AUTOCONFIGURATION_SEARCH_MESSAGE: {
+        handle_search_message(src_mac, cmdu_rx);
+        break;
+    }
+
+    case ieee1905_1::eMessageType::TOPOLOGY_RESPONSE_MESSAGE: {
+        handle_topology_response(src_mac, cmdu_rx);
+        break;
+    }
+
+    default:
+        break;
+    }
+
+    // Never consume the message — other tasks (topology_task, controller) also handle it
+    return false;
+}
+
+void HealthMonitoringTask::handle_search_message(const sMacAddr &src_mac,
+                                                 ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    // Extract AL-MAC from the Search message
+    auto tlvAlMac = cmdu_rx.getClass<ieee1905_1::tlvAlMacAddress>();
+    if (!tlvAlMac) {
+        LOG(WARNING) << "HEALTH_MONITORING: Search without tlvAlMacAddress";
+        return;
+    }
+    const auto al_mac = tlvAlMac->mac();
+
+    // Any Search received must be treated as a fresh onboarding attempt, so cancel any
+    // in-progress Renew tracking for this agent before starting onboarding tracking.
+    cancel_renew_tracking(al_mac);
+    track_onboarding(al_mac);
+}
+
+void HealthMonitoringTask::cancel_renew_tracking(const sMacAddr &al_mac)
+{
+    if (m_renew_trackers.erase(al_mac) > 0) {
+        LOG(DEBUG) << "HEALTH_MONITORING: Search received from agent " << al_mac
+                   << ", canceling pending RenewFailure session";
+    }
+}
+
+void HealthMonitoringTask::track_onboarding(const sMacAddr &al_mac)
+{
+    // Record the first Search timestamp for this agent by creating a new onboarding
+    // episode. Do NOT reset if an episode is already tracked — we want the time of the
+    // first Search, not the most recent one, to measure the full onboarding episode
+    // duration.
+    if (!is_onboarding_tracked(al_mac)) {
+        sOnboardingTracker episode;
+        episode.start_time = std::chrono::steady_clock::now();
+        m_onboarding_trackers.emplace(al_mac, std::move(episode));
+        LOG(DEBUG) << "HEALTH_MONITORING: Search received from agent " << al_mac
+                   << ", onboarding timer started (kpi_breach_threshold="
+                   << m_database.config.health_monitoring_cloning_kpi_breach_threshold_ms.count()
+                   << " ms, incomplete_timeout="
+                   << m_database.config.health_monitoring_cloning_incomplete_timeout_ms.count()
+                   << " ms)";
+    } else {
+        LOG(TRACE) << "HEALTH_MONITORING: Repeated Search from agent " << al_mac
+                   << " (already tracked, timer not reset)";
+    }
+}
+
+bool HealthMonitoringTask::is_onboarding_tracked(const sMacAddr &al_mac) const
+{
+    return m_onboarding_trackers.find(al_mac) != m_onboarding_trackers.end();
+}
+
+void HealthMonitoringTask::handle_topology_response(const sMacAddr &src_mac,
+                                                    ieee1905_1::CmduMessageRx &cmdu_rx)
+{
+    auto tlvDeviceInformation = cmdu_rx.getClass<ieee1905_1::tlvDeviceInformation>();
+    if (!tlvDeviceInformation) {
+        return;
+    }
+    const auto al_mac = tlvDeviceInformation->mac();
+
+    auto tlvApInformation = cmdu_rx.getClass<wfa_map::tlvApOperationalBSS>();
+
+    if (is_onboarding_tracked(al_mac)) {
+        auto episode_it = m_onboarding_trackers.find(al_mac);
+        update_onboarding_progress(al_mac, episode_it, tlvApInformation.get());
+    } else if (is_renew_tracked(al_mac)) {
+        auto renew_it = m_renew_trackers.find(al_mac);
+        update_renew_progress(al_mac, renew_it, tlvApInformation.get());
+    } else if (is_renew_triggered()) {
+        // Neither onboarding nor renew is tracked for this agent. Lazily create a renew
+        // tracker since a Renew was sent since the last periodic check — closes a race where
+        // a confirming TOPOLOGY_RESPONSE_MESSAGE arrives before check_renew_trackers()'s next
+        // poll would otherwise have created it.
+        auto agent = m_database.m_agents.get(al_mac);
+        if (agent && track_renew(agent)) {
+            LOG(DEBUG) << "HEALTH_MONITORING: lazily created RenewFailure "
+                          "session for agent "
+                       << al_mac
+                       << ", triggered by an early TOPOLOGY_RESPONSE_MESSAGE "
+                          "arriving before the next periodic Renew check";
+
+            auto renew_it = m_renew_trackers.find(al_mac);
+            update_renew_progress(al_mac, renew_it, tlvApInformation.get());
+        }
+    }
+}
+
+void HealthMonitoringTask::update_onboarding_progress(
+    const sMacAddr &al_mac, std::unordered_map<sMacAddr, sOnboardingTracker>::iterator episode_it,
+    wfa_map::tlvApOperationalBSS *tlvApInformation)
+{
+    auto &episode = episode_it->second;
+
+    auto agent = m_database.m_agents.get(al_mac);
+    if (!agent) {
+        LOG(WARNING) << "HEALTH_MONITORING: agent " << al_mac
+                     << " not found in database, cannot check onboarding completion";
+        return;
+    }
+
+    update_reported_radios(al_mac, agent, episode, tlvApInformation);
+    finalize_onboarding(al_mac, episode_it, agent->radios.size());
+}
+
+void HealthMonitoringTask::update_reported_radios(
+    const sMacAddr &al_mac, const std::shared_ptr<Agent> &agent, sOnboardingTracker &episode,
+    wfa_map::tlvApOperationalBSS *tlvApInformation)
+{
+    if (!tlvApInformation) {
+        return;
+    }
+
+    auto &reported_radios = episode.confirmed_radios;
+
+    // Use full SSID-content matching rather than a simple BSS-count comparison
+    auto expected_ssids_per_radio = compute_expected_ssids_for_agent(agent);
+
+    for (uint8_t i = 0; i < tlvApInformation->radio_list_length(); i++) {
+        auto radio_entry = std::get<1>(tlvApInformation->radio_list(i));
+        const auto &ruid = radio_entry.radio_uid();
+
+        auto expected_it = expected_ssids_per_radio.find(ruid);
+        if (expected_it == expected_ssids_per_radio.end()) {
+            // No BSS expected for this radio (nothing configured, or none compatible) —
+            // trivially satisfied, mirroring the previous configured_count == 0 case.
+            LOG(DEBUG) << "HEALTH_MONITORING: agent " << al_mac << " radio " << ruid
+                       << " has no expected BSS configuration, trivially satisfied";
+            reported_radios.insert(ruid);
+            continue;
+        }
+
+        auto reported_ssids = extract_reported_ssids(radio_entry);
+
+        LOG(DEBUG) << "HEALTH_MONITORING: agent " << al_mac << " radio " << ruid
+                   << " reported_ssid_count=" << reported_ssids.size()
+                   << " expected_ssid_count=" << expected_it->second.size();
+
+        if (reported_ssids == expected_it->second) {
+            reported_radios.insert(ruid);
+        }
+    }
+}
+
+void HealthMonitoringTask::finalize_onboarding(
+    const sMacAddr &al_mac, std::unordered_map<sMacAddr, sOnboardingTracker>::iterator episode_it,
+    size_t total_radio_count)
+{
+    auto &episode = episode_it->second;
+
+    // Check if all radios of this agent have fully reported their configured BSSes
+    size_t reported_radio_count = episode.confirmed_radios.size();
+
+    if (total_radio_count > 0 && reported_radio_count < total_radio_count) {
+        return;
+    }
+
+    // Onboarding episode complete — compute elapsed time, fire CloningKpiBreach if over
+    // threshold, and clear tracking state.
+    auto now =
+        std::chrono::steady_clock::now();
+    auto elapsed_ms =
+        std::chrono::duration_cast<std::chrono::milliseconds>(now - episode.start_time);
+    const auto &threshold = m_database.config.health_monitoring_cloning_kpi_breach_threshold_ms;
+
+    if (elapsed_ms >= threshold) {
+        LOG(DEBUG) << "HEALTH_MONITORING: CloningKpiBreach - agent " << al_mac
+                   << " completed onboarding (all configured BSS/VAPs reported) after "
+                   << elapsed_ms.count() << " ms (threshold=" << threshold.count() << " ms)";
+
+        const std::string agent_id = tlvf::mac_to_string(al_mac);
+        auto incident_id            = generate_incident_id();
+
+        m_database.dm_trigger_cloning_kpi_breach_event(
+            incident_id, "controller", agent_id, static_cast<uint32_t>(elapsed_ms.count()),
+            static_cast<uint32_t>(threshold.count()));
+        enqueue_agent_notification(al_mac,
+                                   beerocks_message::eHealthMonitorEventCode_CLONING_KPI_BREACH,
+                                   incident_id);
+    } else {
+        LOG(DEBUG) << "HEALTH_MONITORING: agent " << al_mac
+                   << " completed onboarding within threshold (" << elapsed_ms.count()
+                   << " ms < " << threshold.count() << " ms), no CloningKpiBreach";
+    }
+
+    // Record that this agent has just completed an onboarding episode, regardless of whether
+    // CloningKpiBreach fired. Used by check_renew_trackers()/track_renew() to
+    // avoid creating a redundant RenewFailure session when this completion happened at/after a
+    // Renew send (see comment on m_last_onboarding_completion_time in the header for why this
+    // is needed in addition to the m_onboarding_trackers check).
+    m_last_onboarding_completion_time[al_mac] = now;
+
+    // Episode done — clear tracking state for this agent
+    m_onboarding_trackers.erase(episode_it);
+}
+
+bool HealthMonitoringTask::is_renew_tracked(const sMacAddr &al_mac) const
+{
+    return m_renew_trackers.find(al_mac) != m_renew_trackers.end();
+}
+
+void HealthMonitoringTask::update_renew_progress(
+    const sMacAddr &al_mac, std::unordered_map<sMacAddr, sRenewTracker>::iterator renew_it,
+    wfa_map::tlvApOperationalBSS *tlvApInformation)
+{
+    if (!tlvApInformation) {
+        return;
+    }
+    auto &session = renew_it->second;
+
+    for (uint8_t i = 0; i < tlvApInformation->radio_list_length(); i++) {
+        auto radio_entry = std::get<1>(tlvApInformation->radio_list(i));
+        const auto &ruid = radio_entry.radio_uid();
+
+        auto expected_it = session.expected_ssids_per_radio.find(ruid);
+        if (expected_it == session.expected_ssids_per_radio.end()) {
+            // This radio isn't part of the session (no configured BSSes at session
+            // creation time) — nothing to confirm.
+            continue;
+        }
+        if (session.confirmed_radios.count(ruid)) {
+            // Already confirmed.
+            continue;
+        }
+
+        auto reported_ssids = extract_reported_ssids(radio_entry);
+
+        if (reported_ssids == expected_it->second) {
+            session.confirmed_radios.insert(ruid);
+            LOG(DEBUG) << "HEALTH_MONITORING: RenewFailure session for agent " << al_mac
+                       << " radio " << ruid << " confirmed re-applied SSID configuration";
+        }
+    }
+
+    if (session.confirmed_radios.size() >= session.expected_ssids_per_radio.size()) {
+        // Record the confirmation timestamp so check_renew_trackers() (and the lazy
+        // session-creation logic in handle_topology_response()) can recognize that this
+        // agent's config is already known-good as of this moment, and correctly skip
+        // creating a redundant session for it on a subsequent Renew-detection pass — the same
+        // mechanism already used for Search-triggered onboarding-episode completions (see
+        // update_onboarding_progress()).
+        m_last_onboarding_completion_time[al_mac] = std::chrono::steady_clock::now();
+        LOG(DEBUG) << "HEALTH_MONITORING: RenewFailure session for agent " << al_mac
+                   << " fully confirmed, no event fired";
+        m_renew_trackers.erase(renew_it);
+    }
+}
+
+bool HealthMonitoringTask::is_renew_triggered() const
+{
+    auto last_renew_trigger_time = m_database.get_last_ap_config_renew_time();
+    return last_renew_trigger_time != std::chrono::steady_clock::time_point::min() &&
+           last_renew_trigger_time > m_prev_renew_trigger_time;
+}
+
+bool HealthMonitoringTask::track_renew(const std::shared_ptr<Agent> &agent)
+{
+    if (!agent) {
+        return false;
+    }
+
+    if (is_onboarding_tracked(agent->al_mac)) {
+        LOG(DEBUG) << "HEALTH_MONITORING: skipping RenewFailure session for agent "
+                   << agent->al_mac << ", onboarding still in progress";
+        return false;
+    }
+
+    auto last_renew_trigger_time = m_database.get_last_ap_config_renew_time();
+    auto completion_it            = m_last_onboarding_completion_time.find(agent->al_mac);
+    if (completion_it != m_last_onboarding_completion_time.end() &&
+        completion_it->second >= last_renew_trigger_time) {
+        LOG(DEBUG) << "HEALTH_MONITORING: skipping RenewFailure session for agent "
+                   << agent->al_mac
+                   << ", onboarding already completed at/after this Renew was sent";
+        return false;
+    }
+
+    sRenewTracker session;
+    session.start_time               = std::chrono::steady_clock::now();
+    session.expected_ssids_per_radio = compute_expected_ssids_for_agent(agent);
+
+    // Replace any still-pending previous session for this agent — newer config supersedes
+    // older intent. (Using erase+emplace rather than C++17's insert_or_assign(), since this
+    // project targets C++14.)
+    m_renew_trackers.erase(agent->al_mac);
+    m_renew_trackers.emplace(agent->al_mac, std::move(session));
+    return true;
+}
+
+bool HealthMonitoringTask::is_renew_trackers_check_due()
+{
+    auto now = std::chrono::steady_clock::now();
+    return now - m_renew_trackers_last_check_time >= RENEW_MONITORING_CHECK_INTERVAL;
+}
+
+void HealthMonitoringTask::track_renew_for_connected_agents()
+{
+    auto connected_agents = m_database.get_all_connected_agents();
+    if (connected_agents.empty()) {
+        LOG(DEBUG) << "HEALTH_MONITORING: detected new "
+                      "AP_AUTOCONFIGURATION_RENEW_MESSAGE send, but no agents are currently "
+                      "connected — nothing to track";
+        return;
+    }
+
+    LOG(DEBUG) << "HEALTH_MONITORING: detected new AP_AUTOCONFIGURATION_RENEW_MESSAGE "
+                  "send, starting RenewFailure monitoring sessions for all connected agents";
+
+    for (const auto &agent : connected_agents) {
+        track_renew(agent);
+    }
+}
+
+bool HealthMonitoringTask::has_renew_trackers() const
+{
+    return !m_renew_trackers.empty();
+}
+
+void HealthMonitoringTask::process_renew_tracker_timeouts()
+{
+    auto now = std::chrono::steady_clock::now();
+    const auto &renew_timeout = m_database.config.health_monitoring_renew_failure_timeout_ms;
+    const auto sys_now        = std::chrono::system_clock::now();
+
+    for (auto it = m_renew_trackers.begin(); it != m_renew_trackers.end();) {
+        auto &session = it->second;
+
+        auto elapsed_ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - session.start_time);
+
+        if (elapsed_ms < renew_timeout) {
+            ++it;
+            continue;
+        }
+
+        // Before firing RenewFailure, distinguish "agent alive but failed to confirm the
+        // expected config" from "agent has gone completely silent/removed" (e.g. via
+        // topology_task's dead-neighbor detection calling database.remove_agent()). In the
+        // latter case, firing RenewFailure would misleadingly suggest a config-specific
+        // failure for an agent that's simply gone — purge silently instead, mirroring the same
+        // alive-vs-silent distinction already used by check_onboarding_trackers().
+        auto last_contact = m_database.get_agent_last_contact_time(it->first);
+        auto elapsed_since_contact =
+            std::chrono::duration_cast<std::chrono::milliseconds>(sys_now - last_contact);
+
+        if (elapsed_since_contact >= renew_timeout) {
+            LOG(DEBUG) << "HEALTH_MONITORING: purging stale RenewFailure session for "
+                          "agent "
+                       << it->first << " (elapsed_since_last_contact="
+                       << elapsed_since_contact.count() << " ms >= " << renew_timeout.count()
+                       << " ms), agent appears silent/gone, no event fired";
+            it = m_renew_trackers.erase(it);
+            continue;
+        }
+
+        LOG(DEBUG) << "HEALTH_MONITORING: RenewFailure - agent " << it->first
+                   << " did not confirm re-applied BSS configuration after " << elapsed_ms.count()
+                   << " ms (threshold=" << renew_timeout.count() << " ms)";
+
+        auto incident_id = generate_incident_id();
+
+        m_database.dm_trigger_renew_failure_event(incident_id, "controller",
+                                                 tlvf::mac_to_string(it->first),
+                                                 static_cast<uint32_t>(elapsed_ms.count()),
+                                                 static_cast<uint32_t>(renew_timeout.count()));
+        enqueue_agent_notification(it->first,
+                                   beerocks_message::eHealthMonitorEventCode_RENEW_FAILURE,
+                                   incident_id);
+
+        it = m_renew_trackers.erase(it);
+    }
+}
+
+void HealthMonitoringTask::check_renew_trackers()
+{
+    m_renew_trackers_last_check_time = std::chrono::steady_clock::now();
+
+    // Detect whether a new Renew was sent since our last observation.
+    if (is_renew_triggered()) {
+        m_prev_renew_trigger_time = m_database.get_last_ap_config_renew_time();
+        track_renew_for_connected_agents();
+    }
+
+    if (has_renew_trackers()) {
+        process_renew_tracker_timeouts();
+    }
+}
+
+std::unordered_map<sMacAddr, std::multiset<std::string>>
+HealthMonitoringTask::compute_expected_ssids_for_agent(const std::shared_ptr<Agent> &agent)
+{
+    std::unordered_map<sMacAddr, std::multiset<std::string>> expected_ssids_per_radio;
+
+    if (!agent) {
+        return expected_ssids_per_radio;
+    }
+
+    auto &bss_info_confs = m_database.get_bss_info_configuration(agent->al_mac);
+
+    for (const auto &radio_entry : agent->radios) {
+        const auto &ruid = radio_entry.first;
+        const auto &radio = radio_entry.second;
+        if (!radio) {
+            continue;
+        }
+
+        std::multiset<std::string> expected_ssids;
+        for (const auto &bss_conf : bss_info_confs) {
+            if (bss_conf.teardown) {
+                continue;
+            }
+
+            // Operating-class compatibility check, mirroring
+            // son_actions::has_matching_operating_class(), but using the radio's cached
+            // capabilities (ap_basic_caps_operating_classes) instead of a live TLV, since we
+            // need this to work even before/without a fresh M1 round-trip.
+            bool operating_class_match = false;
+            for (auto operating_class : bss_conf.operating_class) {
+                if (radio->ap_basic_caps_operating_classes.count(operating_class)) {
+                    operating_class_match = true;
+                    break;
+                }
+            }
+            if (!operating_class_match) {
+                continue;
+            }
+
+            // Daisy-chaining exclusion, mirroring the logic in
+            // Controller::handle_cmdu_1905_autoconfiguration_WSC(): backhaul-only BSSes are
+            // skipped for non-gateway agents when daisy chaining is disabled.
+            if (m_database.settings_daisy_chaining_disabled() && !agent->is_gateway &&
+                bss_conf.backhaul && !bss_conf.fronthaul) {
+                continue;
+            }
+
+            expected_ssids.insert(bss_conf.ssid);
+        }
+
+        if (!expected_ssids.empty()) {
+            expected_ssids_per_radio[ruid] = std::move(expected_ssids);
+        }
+    }
+
+    return expected_ssids_per_radio;
+}
+
+std::multiset<std::string> HealthMonitoringTask::extract_reported_ssids(
+    wfa_map::cRadioInfo &radio_entry)
+{
+    std::multiset<std::string> reported_ssids;
+    for (uint8_t b = 0; b < radio_entry.radio_bss_list_length(); b++) {
+        auto bss_tuple = radio_entry.radio_bss_list(b);
+        if (!std::get<0>(bss_tuple)) {
+            continue;
+        }
+        reported_ssids.insert(std::get<1>(bss_tuple).ssid_str());
+    }
+    return reported_ssids;
+}
+
+uint64_t HealthMonitoringTask::generate_incident_id()
+{
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                     std::chrono::system_clock::now().time_since_epoch())
+                                     .count());
+}
+
+void HealthMonitoringTask::enqueue_agent_notification(
+    const sMacAddr &agent_al_mac, beerocks_message::eHealthMonitorEventCode event_code,
+    uint64_t incident_id)
+{
+    sPendingAgentNotification pending;
+    pending.agent_al_mac = agent_al_mac;
+    pending.event_code   = event_code;
+    pending.incident_id  = incident_id;
+    pending.send_time    = std::chrono::steady_clock::now() + AGENT_NOTIFICATION_DELAY;
+
+    m_pending_agent_notifications.push_back(pending);
+
+    LOG(DEBUG) << "HEALTH_MONITORING: enqueued health-monitor notification for agent "
+               << agent_al_mac << " event_code=" << int(event_code) << ", to be sent in "
+               << AGENT_NOTIFICATION_DELAY.count() << " s";
+}
+
+bool HealthMonitoringTask::has_pending_agent_notifications() const
+{
+    return !m_pending_agent_notifications.empty();
+}
+
+void HealthMonitoringTask::send_pending_agent_notifications()
+{
+    auto now = std::chrono::steady_clock::now();
+
+    for (auto it = m_pending_agent_notifications.begin();
+         it != m_pending_agent_notifications.end();) {
+        if (now < it->send_time) {
+            ++it;
+            continue;
+        }
+
+        auto notification = beerocks::message_com::create_vs_message<
+            beerocks_message::cACTION_CONTROL_HEALTH_MONITOR_NOTIFICATION>(m_cmdu_tx);
+        if (!notification) {
+            LOG(ERROR) << "HEALTH_MONITORING: Failed building "
+                          "cACTION_CONTROL_HEALTH_MONITOR_NOTIFICATION message for "
+                          "agent "
+                       << it->agent_al_mac;
+            it = m_pending_agent_notifications.erase(it);
+            continue;
+        }
+        notification->event_code()  = it->event_code;
+        notification->incident_id() = it->incident_id;
+
+        if (!son_actions::send_cmdu_to_agent(it->agent_al_mac, m_cmdu_tx, m_database)) {
+            LOG(ERROR) << "HEALTH_MONITORING: Failed to send health-monitor "
+                          "notification to agent "
+                       << it->agent_al_mac;
+        } else {
+            LOG(DEBUG) << "HEALTH_MONITORING: sent health-monitor notification to agent "
+                       << it->agent_al_mac << " event_code=" << int(it->event_code);
+        }
+
+        it = m_pending_agent_notifications.erase(it);
+    }
+}
+
+bool HealthMonitoringTask::is_onboarding_trackers_check_due()
+{
+    auto now = std::chrono::steady_clock::now();
+    return now - m_onboarding_trackers_last_check_time >= ONBOARDING_MONITORING_CHECK_INTERVAL;
+}
+
+void HealthMonitoringTask::process_onboarding_tracker_timeouts()
+{
+    auto now = std::chrono::steady_clock::now();
+    const auto &incomplete_threshold =
+        m_database.config.health_monitoring_cloning_incomplete_timeout_ms;
+    const auto sys_now = std::chrono::system_clock::now();
+
+    for (auto it = m_onboarding_trackers.begin(); it != m_onboarding_trackers.end();) {
+        auto &episode = it->second;
+
+        auto elapsed_since_search =
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - episode.start_time);
+
+        if (elapsed_since_search < incomplete_threshold) {
+            // Still within the grace period — keep waiting.
+            ++it;
+            continue;
+        }
+
+        // cloning_incomplete_timeout_ms has elapsed since the first Search without the agent
+        // completing onboarding. Decide whether the agent is still alive (fire CloningIncomplete)
+        // or has gone silent (purge silently, no event).
+        auto last_contact = m_database.get_agent_last_contact_time(it->first);
+        auto elapsed_since_contact =
+            std::chrono::duration_cast<std::chrono::milliseconds>(sys_now - last_contact);
+
+        if (elapsed_since_contact < incomplete_threshold) {
+            // Agent is alive but never completed reporting its full configured BSS list.
+            LOG(DEBUG) << "HEALTH_MONITORING: CloningIncomplete - agent " << it->first
+                       << " alive but never reported full configured BSS list after "
+                       << elapsed_since_search.count()
+                       << " ms (threshold=" << incomplete_threshold.count() << " ms)";
+
+            auto incident_id = generate_incident_id();
+
+            m_database.dm_trigger_cloning_incomplete_event(
+                incident_id, "controller", tlvf::mac_to_string(it->first),
+                static_cast<uint32_t>(elapsed_since_search.count()),
+                static_cast<uint32_t>(incomplete_threshold.count()));
+            enqueue_agent_notification(
+                it->first, beerocks_message::eHealthMonitorEventCode_CLONING_INCOMPLETE,
+                incident_id);
+        } else {
+            // Agent has gone silent — stale entry, purge without firing any event.
+            LOG(DEBUG) << "HEALTH_MONITORING: purging stale onboarding episode for agent "
+                       << it->first
+                       << " (elapsed_since_last_contact=" << elapsed_since_contact.count()
+                       << " ms >= " << incomplete_threshold.count() << " ms), no event fired";
+        }
+
+        // Either way, stop tracking this episode — CloningKpiBreach can never fire for it now.
+        it = m_onboarding_trackers.erase(it);
+    }
+}
+
+void HealthMonitoringTask::prune_stale_onboarding_completions()
+{
+    // Prune m_last_onboarding_completion_time entries for agents that have been fully removed
+    // from the database (e.g. via topology_task's dead-neighbor cleanup calling
+    // database.remove_agent()) — as opposed to merely disconnected (agent object still present
+    // with state == STATE_DISCONNECTED), which should NOT be pruned since the agent may still
+    // reconnect using the same identity and its prior completion timestamp remains meaningful.
+    // Piggybacks on this same periodic tick to avoid a dedicated timer for what is otherwise
+    // just routine map hygiene, preventing unbounded growth over the controller's lifetime as
+    // distinct agents come and go.
+    for (auto it = m_last_onboarding_completion_time.begin();
+         it != m_last_onboarding_completion_time.end();) {
+        if (!m_database.m_agents.get(it->first)) {
+            LOG(DEBUG) << "HEALTH_MONITORING: pruning stale onboarding-completion "
+                          "timestamp for agent "
+                       << it->first << ", agent no longer present in database";
+            it = m_last_onboarding_completion_time.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+bool HealthMonitoringTask::has_onboarding_trackers() const
+{
+    return !m_onboarding_trackers.empty();
+}
+
+void HealthMonitoringTask::check_onboarding_trackers()
+{
+    m_onboarding_trackers_last_check_time = std::chrono::steady_clock::now();
+
+    if (has_onboarding_trackers()) {
+        process_onboarding_tracker_timeouts();
+    }
+    prune_stale_onboarding_completions();
+}
+
+void HealthMonitoringTask::work()
+{
+    switch (m_fsm_state) {
+    case eState::INIT: {
+        m_onboarding_trackers_last_check_time = std::chrono::steady_clock::now();
+        m_renew_trackers_last_check_time      = std::chrono::steady_clock::now();
+        m_prev_renew_trigger_time    = m_database.get_last_ap_config_renew_time();
+        fsm_move_state(eState::MONITORING);
+        break;
+    }
+    case eState::MONITORING: {
+        // Dispatcher: each is_*_check_due() predicate gates its own detector's periodic check
+        // on its own dedicated timer/interval; work() itself does not gate on anything generic.
+        if (is_onboarding_trackers_check_due()) {
+            check_onboarding_trackers();
+        }
+        if (is_renew_trackers_check_due()) {
+            check_renew_trackers();
+        }
+        if (has_pending_agent_notifications()) {
+            send_pending_agent_notifications();
+        }
+
+        // Future detectors (e.g. channel-switch failure, steering failure) will add their own
+        // is_*_check_due()-gated check_*() calls here, each with its own dedicated
+        // interval/timer.
+        break;
+    }
+    }
+}
