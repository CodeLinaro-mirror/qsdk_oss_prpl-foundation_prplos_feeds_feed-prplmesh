+bool BackhaulManager::is_ethernet_gateway_reachable() const
+{
+#ifndef USE_PRPLMESH_NLHAL
+    // TODO: Implement is_ethernet_gateway_reachable logic for WHM HAL
+    return true;
+#else
+    auto db = AgentDB::get();
+    const std::string wan_iface    = db->ethernet.wan.iface_name;
+    const std::string bridge_iface = db->bridge.iface_name;
+
+    if (wan_iface.empty()) {
+        LOG(WARNING) << "WAN interface name is empty";
+        return false;
+    }
+
+    // Resolve default gateway IP
+    std::string gw_ip;
+    if (!resolve_gateway_ip(gw_ip)) {
+        return false;
+    }
+
+    // Verify the route egresses via the wired path (WAN or bridge containing WAN)
+    if (!verify_route_via_wan(gw_ip, wan_iface, bridge_iface)) {
+        return false;
     }
+
+    // If the default route device is the bridge, confirm MAC learned on WAN port
+    if (!bridge_iface.empty()) {
+        std::string gw_mac;
+        if (!resolve_gateway_mac(gw_ip, bridge_iface, gw_mac)) {
+            return false;
+        }
+        if (!verify_gateway_on_wan_port(gw_mac, wan_iface, bridge_iface)) {
+            return false;
+        }
+    }
+
+    // Final reachability check via ping
+    return ping_gateway(gw_ip);
+#endif
 }
