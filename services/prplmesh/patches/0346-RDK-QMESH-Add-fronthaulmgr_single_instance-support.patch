          */
         bool fh_vaps_state_control = false;
 
+#ifdef BEEROCKS_RDKB
+        /**
+         * @brief Fronthaul manager single-instance mode.
+         *
+         * When true, a single beerocks_fronthaul process is spawned with all fronthaul
