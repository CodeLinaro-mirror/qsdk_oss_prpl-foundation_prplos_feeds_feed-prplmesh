diff --git a/agent/src/beerocks/fronthaul_manager/fronthaul_manager_main.cpp b/agent/src/beerocks/fronthaul_manager/fronthaul_manager_main.cpp
index d58943d90..e7fe610cb 100644
--- a/agent/src/beerocks/fronthaul_manager/fronthaul_manager_main.cpp
+++ b/agent/src/beerocks/fronthaul_manager/fronthaul_manager_main.cpp
@@ -29,6 +29,9 @@ BEEROCKS_INIT_BEEROCKS_VERSION
 static bool g_running = true;
 static int s_signal   = 0;
 static std::string fronthaul_iface;
+#ifdef BEEROCKS_RDKB
+static std::vector<std::string> fronthaul_ifaces;
+#endif
 
 // Pointer to logger instance
 static std::shared_ptr<beerocks::logging> g_logger_ap_mananger;
@@ -104,6 +107,9 @@ static bool parse_arguments(int argc, char *argv[])
         switch (opt) {
         case 'i': {
             fronthaul_iface.assign(optarg);
+#ifdef BEEROCKS_RDKB
+            fronthaul_ifaces.push_back(optarg);
+#endif
             break;
         }
         case '?': {
@@ -203,7 +209,12 @@ int main(int argc, char *argv[])
 
     //get command line options
     if (!parse_arguments(argc, argv)) {
+#ifdef BEEROCKS_RDKB
+        std::cout << "Usage: " << argv[0] << " -i <fronthaul iface> [-i <iface2> ...]"
+                  << std::endl;
+#else
         std::cout << "Usage: " << argv[0] << " -i <fronthaul iface>" << std::endl;
+#endif
         return 1;
     }
 
@@ -224,6 +235,136 @@ int main(int argc, char *argv[])
         }
     }
 
+#ifdef BEEROCKS_RDKB
+    if (fronthaul_ifaces.empty()) {
+        std::cout << "Usage: " << argv[0] << " -i <fronthaul iface> [-i <iface2> ...]"
+                  << std::endl;
+        return 1;
+    }
+
+    if (fronthaul_ifaces.size() > 1) {
+        // Single-instance mode: one process managing all interfaces with a shared event loop.
+        auto event_loop = std::make_shared<beerocks::EventLoopImpl>();
+        LOG_IF(!event_loop, FATAL) << "Unable to create event loop!";
+
+        auto timer_factory = std::make_shared<beerocks::TimerFactoryImpl>();
+        LOG_IF(!timer_factory, FATAL) << "Unable to create timer factory!";
+
+        auto timer_manager =
+            std::make_shared<beerocks::TimerManagerImpl>(timer_factory, event_loop);
+        LOG_IF(!timer_manager, FATAL) << "Unable to create timer manager!";
+
+        std::string agent_uds_path =
+            beerocks_slave_conf.temp_path + std::string(BEEROCKS_AGENT_UDS);
+        std::shared_ptr<beerocks::CmduClientFactory> slave_cmdu_client_factory =
+            beerocks::create_cmdu_client_factory(agent_uds_path, event_loop);
+        LOG_IF(!slave_cmdu_client_factory, FATAL) << "Unable to create CMDU client factory!";
+
+        auto mlo_sta_registry = std::make_shared<beerocks::MloStaRegistry>();
+
+        struct FronthaulEntry {
+            std::string iface;
+            std::shared_ptr<beerocks::logging> logger_ap_manager;
+            std::shared_ptr<beerocks::logging> logger_monitor;
+            std::string pid_file_path;
+            std::unique_ptr<son::ApManager> ap_manager;
+            std::unique_ptr<son::Monitor> monitor;
+            bool monitor_is_running = false;
+        };
+
+        std::vector<FronthaulEntry> entries;
+        for (const auto &iface : fronthaul_ifaces) {
+            FronthaulEntry e;
+            e.iface = iface;
+
+            e.logger_ap_manager = init_logger(std::string(BEEROCKS_AP_MANAGER) + "_" + iface,
+                                              beerocks_slave_conf.sLog, argc, argv);
+            if (!e.logger_ap_manager) return 1;
+
+            e.logger_monitor =
+                init_logger(std::string(BEEROCKS_MONITOR) + "_" + iface,
+                            beerocks_slave_conf.sLog, argc, argv, BEEROCKS_MONITOR);
+            if (!e.logger_monitor) return 1;
+            g_logger_monitor = e.logger_monitor;
+
+            std::string base_fh = std::string(BEEROCKS_FRONTHAUL) + "_" + iface;
+            beerocks::os_utils::kill_pid(beerocks_slave_conf.temp_path + "pid/", base_fh);
+            remove_residual_fronthaul_files(beerocks_slave_conf.temp_path, base_fh);
+            beerocks::os_utils::write_pid_file(beerocks_slave_conf.temp_path, base_fh);
+            e.pid_file_path = beerocks_slave_conf.temp_path + "pid/" + base_fh;
+
+            e.ap_manager = std::make_unique<son::ApManager>(iface, *e.logger_ap_manager,
+                                                            slave_cmdu_client_factory,
+                                                            timer_manager, event_loop,
+                                                            mlo_sta_registry);
+            if (!e.ap_manager->start()) {
+                if (s_signal == SIGTERM) return 0;
+                LOG(ERROR) << "Unable to start AP manager for " << iface;
+                return 1;
+            }
+            entries.push_back(std::move(e));
+        }
+
+        // Redirect stdout/stderr to a single combined log file.
+        if (!entries.empty()) {
+            auto &log_config = beerocks_slave_conf.sLog;
+            beerocks::os_utils::redirect_console_std(log_config.files_path +
+                                                     std::string(BEEROCKS_FRONTHAUL) + "_std.log");
+        }
+
+        auto touch_time_stamp_timeout = std::chrono::steady_clock::now();
+        while (g_running) {
+            if (s_signal) { handle_signal(); continue; }
+
+            if (std::chrono::steady_clock::now() > touch_time_stamp_timeout) {
+                for (auto &e : entries) beerocks::os_utils::touch_pid_file(e.pid_file_path);
+                touch_time_stamp_timeout =
+                    std::chrono::steady_clock::now() +
+                    std::chrono::seconds(beerocks::TOUCH_PID_TIMEOUT_SECONDS);
+            }
+
+            if (event_loop->run() < 0) { LOG(ERROR) << "Event loop failure!"; break; }
+
+            for (auto &e : entries) {
+                if (!e.ap_manager->is_operational()) continue;
+                if (!e.monitor) {
+                    e.monitor = std::make_unique<son::Monitor>(e.iface, beerocks_slave_conf,
+                                                               *e.logger_monitor,
+                                                               e.ap_manager->is_radio_disabled(),
+                                                               mlo_sta_registry);
+                }
+                if (e.monitor_is_running || e.ap_manager->zwdfs_ap()) {
+                    if (!e.monitor->is_running()) {
+                        LOG(INFO) << "Restarting monitor thread for " << e.iface;
+                        e.monitor_is_running = false;
+                    }
+                } else if (e.monitor->start()) {
+                    e.monitor_is_running = true;
+                } else {
+                    CLOG(ERROR, e.logger_monitor->get_logger_id())
+                        << "Unable to start monitor for " << e.iface;
+                    g_running = false;
+                    break;
+                }
+            }
+        }
+
+        for (auto &e : entries) {
+            if (e.monitor_is_running && e.monitor) e.monitor->stop();
+            e.ap_manager->stop();
+        }
+
+        return 0;
+    }
+
+    // Single-interface mode (original path).
+    if (fronthaul_iface.empty()) {
+        std::cout << "Usage: " << argv[0] << " -i <fronthaul iface>" << std::endl;
+        return 1;
+    }
+
+#endif  /* BEEROCKS_RDKB */
+
     // Init logger ap_manager
     std::string base_ap_manager_name = std::string(BEEROCKS_AP_MANAGER) + "_" + fronthaul_iface;
     g_logger_ap_mananger = init_logger(base_ap_manager_name, beerocks_slave_conf.sLog, argc, argv);
