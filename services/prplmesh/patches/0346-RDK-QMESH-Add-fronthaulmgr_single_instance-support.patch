 bool cfg_get_fh_vaps_state_control(bool &fh_vaps_state_control);
 
+#ifdef BEEROCKS_RDKB
+/**
+ * @brief Returns whether fronthaul manager should run as a single multi-interface instance.
+ *
+ * When enabled, a single beerocks_fronthaul process is spawned with all fronthaul
+ * interfaces passed as '-i' arguments, sharing one event loop and timer manager.
+ *
+ * Reads the 'fronthaulmgr_single_instance' option from /etc/config/prplmesh.
+ * Default value is false (disabled).
+ *
+ * @param [out] fronthaulmgr_single_instance true if single-instance mode is enabled.
+ * @return true on success, otherwise false.
+ */
+bool cfg_get_fronthaulmgr_single_instance(bool &fronthaulmgr_single_instance);
+#endif
+
