+#endif
+
         /**
          * @brief Health monitoring task configuration.
          *
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index 4b624a39e..08bc1a1f2 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -768,6 +768,14 @@ bool slave_thread::read_platform_configuration()
                      << db->device_conf.fh_vaps_state_control;
     }
 
+#ifdef BEEROCKS_RDKB
+    if (!bpl::cfg_get_fronthaulmgr_single_instance(db->device_conf.fronthaulmgr_single_instance)) {
+        LOG(WARNING)
+            << "cfg_get_fronthaulmgr_single_instance() failed! using default configuration: "
+            << db->device_conf.fronthaulmgr_single_instance;
+    }
+#endif
+
     if (!bpl::cfg_get_best_channel_rank_threshold(db->device_conf.best_channel_rank_threshold)) {
         LOG(WARNING) << "cfg_get_best_channel_rank_threshold() failed!"
                      << " using default configuration ";
@@ -1356,7 +1364,18 @@ void slave_thread::handle_client_disconnected(int fd)
                 return true;
             }
             LOG(DEBUG) << "agent_reset!";
+#ifdef BEEROCKS_RDKB
+            if (AgentDB::get()->device_conf.fronthaulmgr_single_instance) {
+                m_radio_managers.do_on_each_radio_manager([&](sManagedRadio &rm, const std::string &) {
+                    rm.fronthaul_started = false;
+                    return true;
+                });
+            } else {
+                radio_manager.fronthaul_started = false;
+            }
+#else
             radio_manager.fronthaul_started = false;
+#endif
             agent_reset();
             return true;
         }
@@ -6697,14 +6716,48 @@ bool slave_thread::agent_fsm()
 #endif
                         LOG(DEBUG) << "iface " << base_interface << " exists - start fronthaul process";
                         fronthaul_stop(fronthaul_iface);
+#ifdef BEEROCKS_RDKB
+                        if (!AgentDB::get()->device_conf.fronthaulmgr_single_instance) {
+                            fronthaul_start(fronthaul_iface);
+                        }
+#else
                         fronthaul_start(fronthaul_iface);
+#endif
 #ifndef USE_PRPLMESH_NLHAL
                         }
 #endif
                 }
                 return true;
             });
-        
+
+#ifdef BEEROCKS_RDKB
+        if (AgentDB::get()->device_conf.fronthaulmgr_single_instance) {
+            std::string file_name = "./" + std::string(BEEROCKS_FRONTHAUL);
+            if (access(file_name.c_str(), F_OK) == -1) {
+                file_name = mapf::utils::get_install_path() + "bin/" + std::string(BEEROCKS_FRONTHAUL);
+            }
+            std::string cmd = file_name;
+            bool any_radio  = false;
+            m_radio_managers.do_on_each_radio_manager(
+                [&](sManagedRadio &rm, const std::string &iface) {
+                    auto db = AgentDB::get();
+                    if (!db->device_conf.front_radio.config.at(iface).band_enabled)
+                        return true;
+                    auto radio = db->radio(iface);
+                    if (radio && radio->front.zwdfs)
+                        return true;
+                    cmd += " -i " + iface;
+                    rm.fronthaul_started = true;
+                    any_radio            = true;
+                    return true;
+                });
+            if (any_radio) {
+                LOG(INFO) << "STATE_JOIN_INIT: spawning combined fronthaul: " << cmd;
+                SYSTEM_CALL(cmd, true);
+            }
+        }
+#endif
+
         LOG(TRACE) << "goto STATE_WAIT_FOR_FRONTHAUL_THREADS_JOINED";
         m_agent_state_timer_sec =
             std::chrono::steady_clock::now() + WAIT_FOR_FRONTHAUL_JOINED_TIMEOUT_SEC;
diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
index eb815afe9..337951c1f 100644
--- a/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg.cpp
@@ -1692,6 +1692,55 @@ bool cfg_get_fh_vaps_state_control(bool &fh_vaps_state_control)
     return true;
 }
 
+bool cfg_get_fronthaulmgr_single_instance(bool &fronthaulmgr_single_instance)
+{
+    fronthaulmgr_single_instance = false;
+
+    if (!config_file_path) {
+        LOG(ERROR) << "config_file_path is null";
+        return false;
+    }
+
+    std::ifstream config_file(config_file_path);
+    if (!config_file.is_open()) {
+        LOG(WARNING) << "Failed to open config file: " << config_file_path;
+        return false;
+    }
+
+    std::string config_content((std::istreambuf_iterator<char>(config_file)),
+                               std::istreambuf_iterator<char>());
+    config_file.clear();
+    config_file.close();
+    if (config_file.fail()) {
+        LOG(ERROR) << "unable to close config file: " << config_file_path;
+        return false;
+    }
+
+    cJSON *root = cJSON_Parse(config_content.c_str());
+    if (!root) {
+        const char *error_ptr = cJSON_GetErrorPtr();
+        LOG(ERROR) << "Failed to parse JSON config file: " << config_file_path
+                   << " Error: " << (error_ptr ? error_ptr : "unknown");
+        return false;
+    }
+
+    cJSON *config_obj = cJSON_GetObjectItem(root, "config");
+    if (!config_obj) {
+        cJSON_Delete(root);
+        return true;
+    }
+
+    cJSON *val = cJSON_GetObjectItem(config_obj, "fronthaulmgr_single_instance");
+    if (val && cJSON_IsBool(val)) {
+        fronthaulmgr_single_instance = cJSON_IsTrue(val);
+    } else if (val && cJSON_IsNumber(val)) {
+        fronthaulmgr_single_instance = (val->valueint != 0);
+    }
+
+    cJSON_Delete(root);
+    return true;
+}
+
 bool cfg_get_multi_chan_bcn_req_duration(uint16_t &duration)
 {
     duration = 10;
diff --git a/framework/platform/bpl/include/bpl/bpl_cfg.h b/framework/platform/bpl/include/bpl/bpl_cfg.h
