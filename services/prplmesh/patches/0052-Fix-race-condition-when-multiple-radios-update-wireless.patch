     }
 
 
+    // update radio_id in m_radio_info from prplmesh config
+    int prpl_radio_idx = -1;
+    switch (m_radio_info.frequency_band) {
+        case beerocks::FREQ_24G: prpl_radio_idx = 0; break;
+        case beerocks::FREQ_5G: prpl_radio_idx = 1;  break;
+        case beerocks::FREQ_6G: prpl_radio_idx = 2;  break;
