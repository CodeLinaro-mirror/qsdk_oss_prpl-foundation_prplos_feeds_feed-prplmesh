                                    const son::wireless_utils::sBssInfoConf &bss_conf,
-                                   prplmesh::hostapd::Configuration &conf)
+                                   prplmesh::hostapd::Configuration &conf,std::string &radio_id)
 {
+    int lock_fd = open("/var/lock/prplmesh-wireless.lock", O_CREAT | O_RDWR, 0644);
+    if (lock_fd < 0) {
+        LOG(ERROR) << "open lock failed: " << strerror(errno);
+        return;
+    }
+
+    // Block until exclusive write-lock is acquired
+    struct flock lk{};
+    lk.l_type   = F_WRLCK;
+    lk.l_whence = SEEK_SET;
+    lk.l_start  = 0;
+    lk.l_len    = 0;   // lock the whole file
+
+    if (fcntl(lock_fd, F_SETLKW, &lk) < 0) {
+        LOG(ERROR) << "fcntl(F_SETLKW) failed: " << strerror(errno);
+        close(lock_fd);
+        return;
+    }
+    LOG(INFO) << "Lock acquired for VAP[" << vap_id << "] radio[" << radio_id << "]";
+
     // In the hostapd config file, the first VAP uses the key "interface", while additional VAPs use the key "bss"
     const std::vector<std::string> bss_check = {"interface", "bss"};
 
@@ -1205,15 +1244,30 @@ void set_wifi_credentials_from_vap(const std::string &vap_id,
         std::string bss = conf.get_vap_value(vap_id, key);
         if (!bss.empty()) {
             LOG(INFO) << "bss is: " << bss;
-            beerocks::bpl::bpl_cfg_set_wifi_credentials(bss, bss_conf);
             LOG(INFO) << key << " found, UCI is set";
-            return;
+            const bool ret_val = beerocks::bpl::bpl_cfg_set_wifi_credentials(bss, bss_conf,radio_id);
+            if (!ret_val) {
+                LOG(ERROR) << "Failed to set UCI credential for vap_id: " << vap_id << " radio_id:" << radio_id;
+            } else {
+                LOG(INFO) << "Updated UCI credentials for vap_id: " << vap_id << " radio_id:" << radio_id;
+            }
+            break;
         } else {
             LOG(INFO) << key << " not found";
         }
     }
 
-    LOG(ERROR) << "Neither 'interface' nor 'bss' found for VAP ID: " << vap_id;
+    lk.l_type = F_UNLCK;
+
+    if (fcntl(lock_fd, F_SETLK, &lk) < 0) {
+        LOG(WARNING) << "fcntl(F_UNLCK) failed: " << strerror(errno);
+    }
+
+    if (close(lock_fd) < 0) {
+        LOG(WARNING) << "close lock_fd failed: " << strerror(errno);
+    }
+
+    LOG(INFO) << "Lock released for VAP[" << vap_id << "] radio[" << radio_id << "]";
 }
 
