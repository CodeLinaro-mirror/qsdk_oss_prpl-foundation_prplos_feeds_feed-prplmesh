diff --git a/create_rdk_default_config.sh b/create_rdk_default_config.sh
new file mode 100755
index 000000000..952eb7a51
--- /dev/null
+++ b/create_rdk_default_config.sh
@@ -0,0 +1,121 @@
+#!/bin/bash
+# SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+# SPDX-FileCopyrightText: 2022 the prplMesh contributors (see AUTHORS.md)
+#
+# This code is subject to the terms of the BSD+Patent license.
+# See LICENSE file for more details.
+#
+# create_rdk_default_config.sh
+#
+# Generates the default /etc/config/prplmesh.json for RDK-B platforms.
+# This is the JSON equivalent of the UCI defaults script at:
+#   etc/uci-defaults/prplmesh
+#
+# Usage:
+#   ./create_rdk_default_config.sh [output_file]
+#
+# If output_file is not specified, defaults to /etc/config/prplmesh.json.
+#
+# The generated JSON schema mirrors the UCI prplmesh config structure:
+#   - "config" section: global prplmesh settings
+#   - "radio0", "radio1", "radio2" sections: per-radio settings
+
+OUTPUT_FILE="${1:-/etc/config/prplmesh.json}"
+
+# Detect wired backhaul interface from /etc/board.json if available
+BH_IFACE="none"
+if [ -f /etc/board.json ]; then
+    # Try to extract the first LAN port from board.json using grep/awk
+    # (avoids dependency on jshn.sh which may not be present on RDK)
+    BH_IFACE=$(grep -A 20 '"lan"' /etc/board.json | grep '"ports"' -A 5 | grep -oP '"[a-z0-9]+"' | head -1 | tr -d '"')
+    if [ -z "$BH_IFACE" ]; then
+        BH_IFACE="none"
+    fi
+fi
+
+# If still not found, try to detect the first ethernet interface
+if [ "$BH_IFACE" = "none" ]; then
+    for iface in eth0 eth1 br-lan; do
+        if ip link show "$iface" > /dev/null 2>&1; then
+            BH_IFACE="$iface"
+            break
+        fi
+    done
+fi
+
+if [ "$BH_IFACE" = "none" ]; then
+    echo "WARNING: No default wired backhaul interface was detected. Please set 'config.backhaul_wire_iface' manually in $OUTPUT_FILE." >&2
+else
+    echo "INFO: Using $BH_IFACE as backhaul_wire_iface" >&2
+fi
+
+# Create output directory if needed
+mkdir -p "$(dirname "$OUTPUT_FILE")"
+
+# Do not overwrite if already exists
+if [ -f "$OUTPUT_FILE" ]; then
+    echo "INFO: $OUTPUT_FILE already exists, skipping creation." >&2
+    exit 0
+fi
+
+cat > "$OUTPUT_FILE" << JSONEOF
+{
+    "config": {
+        "management_mode": "Multi-AP-Agent",
+        "operating_mode": "WDS-Repeater",
+        "enable": 0,
+        "onboarding": 0,
+        "master": 0,
+        "gateway": 0,
+        "rdkb_extensions": 0,
+        "band_steering": 0,
+        "client_roaming": 0,
+        "dfs_reentry": 0,
+        "passive_mode": 1,
+        "wired_backhaul": 1,
+        "operational": 0,
+        "ssid": "test_ssid",
+        "mode_enabled": "WPA2-Personal",
+        "wep_key": "123456789a",
+        "key_passphrase": "test_passphrase",
+        "mem_only_psk": 0,
+        "backhaul_band": "auto",
+        "certification_mode": 0,
+        "stop_on_failure_attempts": 1,
+        "backhaul_wire_iface": "$BH_IFACE",
+        "TrafficSeparation_bridge_mapping_enable": 0,
+        "TrafficSeparation_persistence_enable": 0
+    },
+    "radio0": {
+        "hostap_iface": "wlan0",
+        "sta_iface": "wlan0",
+        "dcs_enable": 0,
+        "dcs_channel_pool": "1,6,11",
+        "dcs_interval_sec": 15,
+        "dcs_dwell_msec": 40,
+        "dcs_refresh_sec": 86400
+    },
+    "radio1": {
+        "hostap_iface": "wlan1",
+        "sta_iface": "wlan1",
+        "dcs_enable": 0,
+        "dcs_channel_pool": "36-48,149-165",
+        "dcs_interval_sec": 15,
+        "dcs_dwell_msec": 40,
+        "dcs_refresh_sec": 86400
+    },
+    "radio2": {
+        "hostap_iface": "wlan2",
+        "sta_iface": "wlan2",
+        "dcs_enable": 0,
+        "dcs_channel_pool": "2-233",
+        "dcs_interval_sec": 15,
+        "dcs_dwell_msec": 40,
+        "dcs_refresh_sec": 86400
+    }
+}
+JSONEOF
+
+echo "INFO: Created $OUTPUT_FILE" >&2
+exit 0
