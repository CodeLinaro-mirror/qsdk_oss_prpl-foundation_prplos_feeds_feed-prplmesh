diff --git a/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp b/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp
new file mode 100644
index 000000000..11a04f072
--- /dev/null
+++ b/framework/platform/bpl/cfg/rdk/bpl_cfg_helper.cpp
@@ -0,0 +1,328 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * SPDX-FileCopyrightText: 2022 the prplMesh contributors (see AUTHORS.md)
+ *
+ * This code is subject to the terms of the BSD+Patent license.
+ * See LICENSE file for more details.
+ */
+
+#include "bpl_cfg_helper.h"
+#include <mapf/common/logger.h>
+#include <mapf/common/utils.h>
+#include "../../common/utils/utils.h"
+
+#include <cJSON.h>
+#include <fstream>
+#include <sstream>
+
+#define MAX_JSON_BUF_LEN 256
+
+namespace beerocks {
+namespace bpl {
+
+static cJSON* load_json_config()
+{
+    std::ifstream file(PRPLMESH_JSON_PATH);
+    if (!file.is_open()) {
+        MAPF_ERR("Failed to open JSON config file: " << PRPLMESH_JSON_PATH);
+        return nullptr;
+    }
+
+    std::stringstream buffer;
+    buffer << file.rdbuf();
+
+    cJSON *json = cJSON_Parse(buffer.str().c_str());
+    if (!json) {
+        const char *error_ptr = cJSON_GetErrorPtr();
+        if (error_ptr != nullptr) {
+            MAPF_ERR("Error parsing JSON before: " << error_ptr);
+        }
+        return nullptr;
+    }
+
+    return json;
+}
+
+static bool save_json_config(cJSON *json)
+{
+    if (!json) return false;
+
+    char *string = cJSON_Print(json);
+    if (!string) {
+        MAPF_ERR("Failed to print JSON to string");
+        return false;
+    }
+
+    std::ofstream file(PRPLMESH_JSON_PATH);
+    if (!file.is_open()) {
+        MAPF_ERR("Failed to open JSON config file for writing: " << PRPLMESH_JSON_PATH);
+        free(string);
+        return false;
+    }
+
+    file << string;
+    file.close();
+    free(string);
+    return true;
+}
+
+int cfg_get_prplmesh_param(const std::string &param, char *buf, size_t buf_len)
+{
+    cJSON *json = load_json_config();
+    if (!json) return RETURN_ERR;
+
+    cJSON *config = cJSON_GetObjectItemCaseSensitive(json, "config");
+    if (!config) {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    cJSON *item = cJSON_GetObjectItemCaseSensitive(config, param.c_str());
+    if (!item) {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    if (cJSON_IsString(item)) {
+        mapf::utils::copy_string(buf, item->valuestring, buf_len);
+    } else if (cJSON_IsNumber(item)) {
+        snprintf(buf, buf_len, "%d", item->valueint);
+    } else if (cJSON_IsBool(item)) {
+        snprintf(buf, buf_len, "%d", cJSON_IsTrue(item) ? 1 : 0);
+    } else {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    cJSON_Delete(json);
+    return RETURN_OK;
+}
+
+int cfg_get_prplmesh_hostapd_ifaces(std::unordered_map<std::string, std::string> &hostapd_ifaces)
+{
+    cJSON *json = load_json_config();
+    if (!json) return RETURN_ERR;
+
+    cJSON *radios = cJSON_GetObjectItemCaseSensitive(json, "radios");
+    if (!radios || !cJSON_IsArray(radios)) {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    cJSON *radio = nullptr;
+    cJSON_ArrayForEach(radio, radios) {
+        cJSON *iface = cJSON_GetObjectItemCaseSensitive(radio, "hostap_iface");
+        cJSON *name = cJSON_GetObjectItemCaseSensitive(radio, "name"); // e.g. wlan0
+
+        if (iface && cJSON_IsString(iface) && name && cJSON_IsString(name)) {
+            hostapd_ifaces[name->valuestring] = iface->valuestring;
+        }
+    }
+
+    cJSON_Delete(json);
+    return RETURN_OK;
+}
+
+int cfg_get_prplmesh_radio_param(int radio_id, const std::string &radio_param, char *buf,
+                                 size_t buf_len)
+{
+    cJSON *json = load_json_config();
+    if (!json) return RETURN_ERR;
+
+    char radio_name[32];
+    snprintf(radio_name, sizeof(radio_name), "radio%d", radio_id);
+
+    cJSON *radio = cJSON_GetObjectItemCaseSensitive(json, radio_name);
+    if (!radio) {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    cJSON *item = cJSON_GetObjectItemCaseSensitive(radio, radio_param.c_str());
+    if (!item) {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    if (cJSON_IsString(item)) {
+        mapf::utils::copy_string(buf, item->valuestring, buf_len);
+    } else if (cJSON_IsNumber(item)) {
+        snprintf(buf, buf_len, "%d", item->valueint);
+    } else if (cJSON_IsBool(item)) {
+        snprintf(buf, buf_len, "%d", cJSON_IsTrue(item) ? 1 : 0);
+    } else {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    cJSON_Delete(json);
+    return RETURN_OK;
+}
+
+static int cfg_get_prplmesh_param_int_raw(const std::string &param, int *buf)
+{
+    int status;
+    char val[MAX_JSON_BUF_LEN] = "";
+
+    status = cfg_get_prplmesh_param(param, val, MAX_JSON_BUF_LEN);
+    if (status == RETURN_ERR)
+        return RETURN_ERR_NOT_FOUND;
+
+    status = sscanf(val, "%d", buf);
+    if (status != 1)
+        return RETURN_ERR_PARSE;
+
+    return RETURN_OK;
+}
+
+int cfg_get_prplmesh_param_int(const std::string &param, int *buf)
+{
+    int status = cfg_get_prplmesh_param_int_raw(param, buf);
+    return status == RETURN_OK ? RETURN_OK : RETURN_ERR;
+}
+
+int cfg_get_prplmesh_param_int_default(const std::string &param, int *buf, int default_value)
+{
+    int status = cfg_get_prplmesh_param_int_raw(param, buf);
+    switch (status) {
+    case RETURN_OK:
+        return RETURN_OK;
+    case RETURN_ERR_NOT_FOUND:
+        *buf = default_value;
+        MAPF_INFO(__FUNCTION__ << ": missing parameter '" << param
+                               << "', using default: " << default_value);
+        return RETURN_OK;
+    case RETURN_ERR_PARSE:
+        MAPF_ERR(__FUNCTION__ << ": can't parse value for '" << param << "'");
+        return RETURN_ERR;
+    default:
+        MAPF_ERR(__FUNCTION__ << ": cfg_get_prplmesh_param_int_raw returned unexpected value");
+        return RETURN_ERR;
+    }
+}
+
+int cfg_get_channel(const std::string &interface_name, int *channel)
+{
+    if (!channel) {
+        return RETURN_ERR;
+    }
+
+    cJSON *json = load_json_config();
+    if (!json) return RETURN_ERR;
+
+    cJSON *radios = cJSON_GetObjectItemCaseSensitive(json, "radios");
+    if (!radios || !cJSON_IsArray(radios)) {
+        cJSON_Delete(json);
+        return RETURN_ERR;
+    }
+
+    cJSON *radio = nullptr;
+    cJSON_ArrayForEach(radio, radios) {
+        cJSON *iface = cJSON_GetObjectItemCaseSensitive(radio, "name");
+        if (iface && cJSON_IsString(iface) && std::string(iface->valuestring) == interface_name) {
+            cJSON *chan = cJSON_GetObjectItemCaseSensitive(radio, "channel");
+            if (chan) {
+                if (cJSON_IsString(chan)) {
+                    std::string channel_str(chan->valuestring);
+                    if (channel_str == "auto") {
+                        *channel = 0;
+                    } else if (channel_str.find_first_not_of("0123456789") != std::string::npos) {
+                        *channel = 0;
+                    } else {
+                        *channel = utils::stoi(channel_str);
+                    }
+                } else if (cJSON_IsNumber(chan)) {
+                    *channel = chan->valueint;
+                }
+                cJSON_Delete(json);
+                return RETURN_OK;
+            }
+        }
+    }
+
+    cJSON_Delete(json);
+    return RETURN_ERR;
+}
+
+int cfg_get_wep_key(const std::string &interface_name, int keyIndex, char *key)
+{
+    /*TODO: implement using OneWifi/Rbus apis*/
+    return RETURN_OK;
+}
+
+int cfg_set_prplmesh_config(const std::string &option, const std::string &value)
+{
+    cJSON *json = load_json_config();
+    if (!json) {
+        // Create new JSON if it doesn't exist
+        json = cJSON_CreateObject();
+        if (!json) return RETURN_ERR;
+    }
+
+    cJSON *config = cJSON_GetObjectItemCaseSensitive(json, "config");
+    if (!config) {
+        config = cJSON_CreateObject();
+        cJSON_AddItemToObject(json, "config", config);
+    }
+
+    cJSON *item = cJSON_GetObjectItemCaseSensitive(config, option.c_str());
+    if (item) {
+        cJSON_ReplaceItemInObject(config, option.c_str(), cJSON_CreateString(value.c_str()));
+    } else {
+        cJSON_AddStringToObject(config, option.c_str(), value.c_str());
+    }
+
+    bool success = save_json_config(json);
+    cJSON_Delete(json);
+
+    return success ? RETURN_OK : RETURN_ERR;
+}
+
+int cfg_set_prplmesh_config_no_commit(const std::string &option, const std::string &value)
+{
+    // For JSON, we don't have a separate "commit" mechanism like UCI
+    // We just write it. Alternatively, we could hold it in memory, but that's complex.
+    return cfg_set_prplmesh_config(option, value);
+}
+
+bool cfg_update_prplmesh_option_commit(const std::string &package_name,
+                            const std::string &section_type,
+                            const std::string &option_name,
+                            const std::string &old_value,
+                            const std::string &new_value)
+{
+    // Not directly applicable to JSON without a matching schema mapping,
+    // but we can try to update under the specified section type if it's an array/object
+    cJSON *json = load_json_config();
+    if (!json) return false;
+
+    // Simplified: Just update under 'config' if section_type is empty or "config"
+    // Since this is a generic update, we'll try to find the old value and replace it
+    cJSON *section = nullptr;
+
+    if (section_type == "config" || section_type.empty()) {
+        section = cJSON_GetObjectItemCaseSensitive(json, "config");
+    } else {
+        section = cJSON_GetObjectItemCaseSensitive(json, section_type.c_str());
+    }
+
+    if (!section) {
+        cJSON_Delete(json);
+        return false;
+    }
+
+    cJSON *item = cJSON_GetObjectItemCaseSensitive(section, option_name.c_str());
+    if (item && cJSON_IsString(item) && std::string(item->valuestring) == old_value) {
+        cJSON_ReplaceItemInObject(section, option_name.c_str(), cJSON_CreateString(new_value.c_str()));
+        bool success = save_json_config(json);
+        cJSON_Delete(json);
+        return success;
+    }
+
+    cJSON_Delete(json);
+    return false;
+}
+
+
+} // namespace bpl
+} // namespace beerocks
