diff --git a/tools/qmesh_cli/qmesh_cli.c b/tools/qmesh_cli/qmesh_cli.c
new file mode 100644
index 000000000..c42c2605b
--- /dev/null
+++ b/tools/qmesh_cli/qmesh_cli.c
@@ -0,0 +1,348 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * SPDX-FileCopyrightText: 2022 the prplMesh contributors (see AUTHORS.md)
+ *
+ * This code is subject to the terms of the BSD+Patent license.
+ * See LICENSE file for more details.
+ */
+
+/*
+ * qmesh_cli - Lightweight CLI utility to read/modify /etc/config/prplmesh.json
+ *
+ * Usage:
+ *   qmesh_cli get <section>.<param>
+ *   qmesh_cli set <section>.<param> <value>
+ *   qmesh_cli show
+ *
+ * Examples:
+ *   qmesh_cli get config.management_mode
+ *   qmesh_cli set config.band_steering 1
+ *   qmesh_cli get radio0.hostap_iface
+ *   qmesh_cli set radio1.dcs_channel_pool "36-48,149-165"
+ *   qmesh_cli show
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+
+#include <cjson/cJSON.h>
+
+#define PRPLMESH_JSON_PATH "/etc/config/prplmesh.json"
+#define MAX_FILE_SIZE (64 * 1024)
+
+static char *read_file(const char *path)
+{
+    FILE *fp = fopen(path, "r");
+    char *buf = NULL;
+    long size = 0;
+
+    if (!fp) {
+        fprintf(stderr, "qmesh_cli: failed to open %s: %s\n", path, strerror(errno));
+        return NULL;
+    }
+
+    fseek(fp, 0, SEEK_END);
+    size = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+
+    if (size <= 0 || size > MAX_FILE_SIZE) {
+        fprintf(stderr, "qmesh_cli: invalid file size %ld for %s\n", size, path);
+        fclose(fp);
+        return NULL;
+    }
+
+    buf = malloc(size + 1);
+    if (!buf) {
+        fprintf(stderr, "qmesh_cli: out of memory\n");
+        fclose(fp);
+        return NULL;
+    }
+
+    if (fread(buf, 1, size, fp) != (size_t)size) {
+        fprintf(stderr, "qmesh_cli: failed to read %s\n", path);
+        free(buf);
+        fclose(fp);
+        return NULL;
+    }
+
+    buf[size] = '\0';
+    fclose(fp);
+    return buf;
+}
+
+static int write_file(const char *path, const char *content)
+{
+    FILE *fp = fopen(path, "w");
+
+    if (!fp) {
+        fprintf(stderr, "qmesh_cli: failed to open %s for writing: %s\n", path, strerror(errno));
+        return -1;
+    }
+
+    if (fputs(content, fp) == EOF) {
+        fprintf(stderr, "qmesh_cli: failed to write to %s\n", path);
+        fclose(fp);
+        return -1;
+    }
+
+    fclose(fp);
+    return 0;
+}
+
+static cJSON *load_json(void)
+{
+    char *content = read_file(PRPLMESH_JSON_PATH);
+    cJSON *json = NULL;
+
+    if (!content) {
+        return NULL;
+    }
+
+    json = cJSON_Parse(content);
+    free(content);
+
+    if (!json) {
+        const char *err = cJSON_GetErrorPtr();
+        if (err) {
+            fprintf(stderr, "qmesh_cli: JSON parse error near: %s\n", err);
+        }
+        return NULL;
+    }
+
+    return json;
+}
+
+static int save_json(cJSON *json)
+{
+    char *str = cJSON_Print(json);
+    int ret = 0;
+
+    if (!str) {
+        fprintf(stderr, "qmesh_cli: failed to serialize JSON\n");
+        return -1;
+    }
+
+    ret = write_file(PRPLMESH_JSON_PATH, str);
+    free(str);
+    return ret;
+}
+
+/*
+ * cmd_get: print the value of <section>.<param>
+ * e.g. "config.management_mode" or "radio0.hostap_iface"
+ */
+static int cmd_get(const char *key)
+{
+    char section[64] = {0};
+    char param[64] = {0};
+    const char *dot = strchr(key, '.');
+    cJSON *json = NULL;
+    cJSON *section_obj = NULL;
+    cJSON *item = NULL;
+
+    if (!dot) {
+        fprintf(stderr, "qmesh_cli: invalid key '%s', expected <section>.<param>\n", key);
+        return 1;
+    }
+
+    strlcpy(section, key, (size_t)(dot - key));
+    section[dot - key] = '\0';
+    strlcpy(param, dot + 1, sizeof(param) - 1);
+
+    json = load_json();
+    if (!json) {
+        return 1;
+    }
+
+    section_obj = cJSON_GetObjectItemCaseSensitive(json, section);
+    if (!section_obj) {
+        fprintf(stderr, "qmesh_cli: section '%s' not found\n", section);
+        cJSON_Delete(json);
+        return 1;
+    }
+
+    item = cJSON_GetObjectItemCaseSensitive(section_obj, param);
+    if (!item) {
+        fprintf(stderr, "qmesh_cli: param '%s' not found in section '%s'\n", param, section);
+        cJSON_Delete(json);
+        return 1;
+    }
+
+    if (cJSON_IsString(item)) {
+        printf("%s\n", item->valuestring);
+    } else if (cJSON_IsNumber(item)) {
+        /* Print as integer if it looks like one, else as double */
+        if (item->valuedouble == (double)(int)item->valuedouble) {
+            printf("%d\n", item->valueint);
+        } else {
+            printf("%g\n", item->valuedouble);
+        }
+    } else if (cJSON_IsBool(item)) {
+        printf("%s\n", cJSON_IsTrue(item) ? "true" : "false");
+    } else if (cJSON_IsNull(item)) {
+        printf("null\n");
+    } else {
+        char *str = cJSON_Print(item);
+        if (str) {
+            printf("%s\n", str);
+            free(str);
+        }
+    }
+
+    cJSON_Delete(json);
+    return 0;
+}
+
+/*
+ * cmd_set: set the value of <section>.<param> to <value>
+ * Tries to detect if value is an integer, boolean, or string.
+ */
+static int cmd_set(const char *key, const char *value)
+{
+    char section[64] = {0};
+    char param[64] = {0};
+    const char *dot = strchr(key, '.');
+    cJSON *json = NULL;
+    cJSON *section_obj = NULL;
+    cJSON *new_item = NULL;
+    char *endptr = NULL;
+    long int_val = 0;
+
+    if (!dot) {
+        fprintf(stderr, "qmesh_cli: invalid key '%s', expected <section>.<param>\n", key);
+        return 1;
+    }
+
+    strlcpy(section, key, (size_t)(dot - key));
+    section[dot - key] = '\0';
+    strlcpy(param, dot + 1, sizeof(param) - 1);
+
+    json = load_json();
+    if (!json) {
+        return 1;
+    }
+
+    section_obj = cJSON_GetObjectItemCaseSensitive(json, section);
+    if (!section_obj) {
+        /* Create the section if it doesn't exist */
+        section_obj = cJSON_CreateObject();
+        if (!section_obj) {
+            fprintf(stderr, "qmesh_cli: failed to create section '%s'\n", section);
+            cJSON_Delete(json);
+            return 1;
+        }
+        cJSON_AddItemToObject(json, section, section_obj);
+    }
+
+    /* Detect value type: boolean, integer, or string */
+    if (strcmp(value, "true") == 0) {
+        new_item = cJSON_CreateTrue();
+    } else if (strcmp(value, "false") == 0) {
+        new_item = cJSON_CreateFalse();
+    } else {
+        int_val = strtol(value, &endptr, 10);
+        if (endptr != value && *endptr == '\0') {
+            /* Pure integer */
+            new_item = cJSON_CreateNumber((double)int_val);
+        } else {
+            /* String */
+            new_item = cJSON_CreateString(value);
+        }
+    }
+
+    if (!new_item) {
+        fprintf(stderr, "qmesh_cli: failed to create JSON value for '%s'\n", value);
+        cJSON_Delete(json);
+        return 1;
+    }
+
+    /* Replace or add the item */
+    if (cJSON_GetObjectItemCaseSensitive(section_obj, param)) {
+        cJSON_ReplaceItemInObjectCaseSensitive(section_obj, param, new_item);
+    } else {
+        cJSON_AddItemToObject(section_obj, param, new_item);
+    }
+
+    if (save_json(json) != 0) {
+        cJSON_Delete(json);
+        return 1;
+    }
+
+    cJSON_Delete(json);
+    return 0;
+}
+
+/*
+ * cmd_show: pretty-print the entire JSON config
+ */
+static int cmd_show(void)
+{
+    cJSON *json = load_json();
+    char *str = NULL;
+
+    if (!json) {
+        return 1;
+    }
+
+    str = cJSON_Print(json);
+    if (str) {
+        printf("%s\n", str);
+        free(str);
+    }
+
+    cJSON_Delete(json);
+    return 0;
+}
+
+static void print_usage(const char *prog)
+{
+    fprintf(stderr,
+            "Usage:\n"
+            "  %s get <section>.<param>\n"
+            "  %s set <section>.<param> <value>\n"
+            "  %s show\n"
+            "\n"
+            "Examples:\n"
+            "  %s get config.management_mode\n"
+            "  %s set config.band_steering 1\n"
+            "  %s get radio0.hostap_iface\n"
+            "  %s set radio1.dcs_channel_pool \"36-48,149-165\"\n"
+            "  %s show\n",
+            prog, prog, prog, prog, prog, prog, prog, prog);
+}
+
+int main(int argc, char *argv[])
+{
+    if (argc < 2) {
+        print_usage(argv[0]);
+        return 1;
+    }
+
+    if (strcmp(argv[1], "get") == 0) {
+        if (argc < 3) {
+            fprintf(stderr, "qmesh_cli: 'get' requires a key argument\n");
+            print_usage(argv[0]);
+            return 1;
+        }
+        return cmd_get(argv[2]);
+    }
+
+    if (strcmp(argv[1], "set") == 0) {
+        if (argc < 4) {
+            fprintf(stderr, "qmesh_cli: 'set' requires a key and value argument\n");
+            print_usage(argv[0]);
+            return 1;
+        }
+        return cmd_set(argv[2], argv[3]);
+    }
+
+    if (strcmp(argv[1], "show") == 0) {
+        return cmd_show();
+    }
+
+    fprintf(stderr, "qmesh_cli: unknown command '%s'\n", argv[1]);
+    print_usage(argv[0]);
+    return 1;
+}
