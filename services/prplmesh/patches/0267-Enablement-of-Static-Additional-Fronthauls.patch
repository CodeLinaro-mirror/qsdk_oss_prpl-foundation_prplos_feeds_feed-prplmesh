 agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
index fd228d745..002bd478b 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.h
@@ -559,6 +559,9 @@ private:
      * based on deployment requirements. Access via get_mld_unit_from_lookup_table()
      * which handles the eVapType to index mapping.
      */
+    // TODO: NLHAL table has been handled (HOTSPOT/STAFF/ISOLATED rows populated for the
+    // additional fronthaul VAPs). WHM table below still needs to be handled - STAFF and
+    // ISOLATED rows are still DISABLED_MLDUNIT.
 #ifdef USE_PRPLMESH_NLHAL
     static constexpr int8_t m_mld_unit_lookup_table[8]
         [static_cast<uint8_t>(eRadioType::RADIO_TYPE_MAX)] = {
@@ -569,8 +572,8 @@ private:
         /* VIDEO */    {9, 25, 41, 57, 73},
         /* BACKHAUL */ {7, 23, 39, 55, 71},
         /* HOTSPOT */  {4, 20, 36, 52, 68},
-        /* STAFF */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
-        /* ISOLATED */ {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT},
+        /* STAFF */    {5, 21, 37, 53, 69},
+        /* ISOLATED */ {6, 22, 38, 54, 70},
         /* OTHER */    {DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT, DISABLED_MLDUNIT}
     };
 #else // USE_PRPLMESH_WHM
