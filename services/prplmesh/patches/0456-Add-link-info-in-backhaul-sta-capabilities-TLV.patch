From 7c1f9ceeda4fddfcc763b8bde913f5e6b6828832 Mon Sep 17 00:00:00 2001
From: Jain Roy <jambi@qti.qualcomm.com>
Date: Thu, 24 Sep 2026 14:19:23 +0530
Subject: [PATCH] Add link info in backhaul sta capabilities TLV

Signed-off-by: Jain Roy <jambi@qti.qualcomm.com>
---
 .../slave/tasks/capability_reporting_task.cpp | 20 +++++++++++++++----
 .../beerocks/slave/tasks/topology_task.cpp    | 20 +++++++++++++++----
 2 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
index 5f59aa21f..cc7652ddc 100644
--- a/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
+++ b/agent/src/beerocks/slave/tasks/capability_reporting_task.cpp
@@ -921,18 +921,30 @@ void CapabilityReportingTask::handle_backhaul_sta_capability_query(
 
         backhaul_sta_radio_cap_tlv->ruid() = radio->front.iface_mac;
 
-        sMacAddr backhaul_mac;
-        if (radio->back.iface_mac == net::network_utils::ZERO_MAC) {
+        sMacAddr backhaul_mac = net::network_utils::ZERO_MAC;
+
+        // For MLO backhaul, this radio may host an affiliated STA link even if
+        // its legacy back.iface_mac (single-link) was never populated.
+        if (db->bsta_mld_configuration) {
+            auto it = db->bsta_mld_configuration->affiliated_bstas.find(radio->front.iface_mac);
+            if (it != db->bsta_mld_configuration->affiliated_bstas.end()) {
+                backhaul_mac = it->second.mac_addr;
+            }
+        }
+
+        if (backhaul_mac == net::network_utils::ZERO_MAC) {
+            backhaul_mac = radio->back.iface_mac;
+        }
+
+        if (backhaul_mac == net::network_utils::ZERO_MAC) {
             // This case occurs in case of wired backhaul
             LOG(INFO) << "Radio STA Interface HAL is not initialized, iface="
                       << radio->back.iface_name;
             backhaul_sta_radio_cap_tlv->sta_mac_included() =
                 wfa_map::tlvBackhaulStaRadioCapabilities::eStaMacIncluded::FIELD_NOT_PRESENT;
-            backhaul_mac = net::network_utils::ZERO_MAC;
         } else {
             backhaul_sta_radio_cap_tlv->sta_mac_included() =
                 wfa_map::tlvBackhaulStaRadioCapabilities::eStaMacIncluded::FIELD_PRESENT;
-            backhaul_mac = radio->back.iface_mac;
 
             if (!backhaul_sta_radio_cap_tlv->set_sta_mac(backhaul_mac)) {
                 LOG(ERROR) << "Setting sta_mac for tlvBackhaulStaRadioCapabilities has failed";
diff --git a/agent/src/beerocks/slave/tasks/topology_task.cpp b/agent/src/beerocks/slave/tasks/topology_task.cpp
index 8e3649bb4..efc8b6add 100644
--- a/agent/src/beerocks/slave/tasks/topology_task.cpp
+++ b/agent/src/beerocks/slave/tasks/topology_task.cpp
@@ -1436,17 +1436,29 @@ bool TopologyTask::add_backhaul_sta_radio_capabilities()
 
         backhaul_sta_radio_cap_tlv->ruid() = radio->front.iface_mac;
 
-        sMacAddr backhaul_mac;
-        if (radio->back.iface_mac == net::network_utils::ZERO_MAC) {
+        sMacAddr backhaul_mac = net::network_utils::ZERO_MAC;
+
+        // For MLO backhaul, this radio may host an affiliated STA link even if
+        // its legacy back.iface_mac (single-link) was never populated.
+        if (db->bsta_mld_configuration) {
+            auto it = db->bsta_mld_configuration->affiliated_bstas.find(radio->front.iface_mac);
+            if (it != db->bsta_mld_configuration->affiliated_bstas.end()) {
+                backhaul_mac = it->second.mac_addr;
+            }
+        }
+
+        if (backhaul_mac == net::network_utils::ZERO_MAC) {
+            backhaul_mac = radio->back.iface_mac;
+        }
+
+        if (backhaul_mac == net::network_utils::ZERO_MAC) {
             LOG(INFO) << "Radio STA Interface HAL is not initialized, iface="
                       << radio->back.iface_name;
             backhaul_sta_radio_cap_tlv->sta_mac_included() =
                 wfa_map::tlvBackhaulStaRadioCapabilities::eStaMacIncluded::FIELD_NOT_PRESENT;
-            backhaul_mac = net::network_utils::ZERO_MAC;
         } else {
             backhaul_sta_radio_cap_tlv->sta_mac_included() =
                 wfa_map::tlvBackhaulStaRadioCapabilities::eStaMacIncluded::FIELD_PRESENT;
-            backhaul_mac = radio->back.iface_mac;
 
             if (!backhaul_sta_radio_cap_tlv->set_sta_mac(backhaul_mac)) {
                 LOG(ERROR) << "Setting sta_mac for tlvBackhaulStaRadioCapabilities has failed";
-- 
