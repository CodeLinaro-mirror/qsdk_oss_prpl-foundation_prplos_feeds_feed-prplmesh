From bf22296a585f109ddf1e6a8ceb84c1215c89d4d8 Mon Sep 17 00:00:00 2001
From: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
Date: Tue, 2 Dec 2025 16:41:45 +0530
Subject: [PATCH] hostapd local files compile

Signed-off-by: Suvidh Subodh Hegde <suvidhsu@qti.qualcomm.com>
---
 common/beerocks/bwl/CMakeLists.txt            | 32 ++++++++++++++-----
 .../enumAutoPrint/enum_auto_print_conf.json   |  3 +-
 2 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/common/beerocks/bwl/CMakeLists.txt b/common/beerocks/bwl/CMakeLists.txt
index 9bc6f599a..7ad5a5ba3 100644
--- a/common/beerocks/bwl/CMakeLists.txt
+++ b/common/beerocks/bwl/CMakeLists.txt
@@ -115,20 +115,38 @@ elseif(BWL_TYPE STREQUAL "DWPAL")
 
 elseif(BWL_TYPE STREQUAL "NL80211")
 
-    file(GLOB HOSTAPD_SEARCH_PATHS "${PLATFORM_BUILD_DIR}/hostapd*/hostapd-*")
-    find_path(HOSTAPD_INCLUDE_DIR NAMES "src/common/wpa_ctrl.h" PATHS ${HOSTAPD_SEARCH_PATHS} NO_CMAKE_FIND_ROOT_PATH)
-    set(HOSTAPD_DIR "${HOSTAPD_INCLUDE_DIR}")
+    file(GLOB PRPLMESH_BUILD_DIRS "${PLATFORM_BUILD_DIR}/prplmesh-*")
+
+    list(LENGTH PRPLMESH_BUILD_DIRS DIR_COUNT)
+    if(DIR_COUNT EQUAL 0)
+        message(FATAL_ERROR "No prplmesh build directory found in ${PLATFORM_BUILD_DIR}")
+    elseif(DIR_COUNT GREATER 1)
+        message(WARNING "Multiple prplmesh directories found: ${PRPLMESH_BUILD_DIRS}")
+        message(WARNING "Using first one")
+    endif()
+    
+    list(GET PRPLMESH_BUILD_DIRS 0 PRPLMESH_BUILD_DIR)
+    set(PRPLMESH_INCLUDE_DIR "${PRPLMESH_BUILD_DIR}/include")
+
+    message(STATUS "===================================")
+    message(STATUS "PRPLMESH_BUILD_DIR = ${PRPLMESH_BUILD_DIR}")
+    message(STATUS "PRPLMESH_INCLUDE_DIR = ${PRPLMESH_INCLUDE_DIR}")
+    message(STATUS "===================================")
 
     find_package(nl-genl-3 REQUIRED)
     list(APPEND BWL_LIBS nl-genl-3)
 
+    if(NOT EXISTS ${PRPLMESH_INCLUDE_DIR})
+        message(FATAL_ERROR "prplmesh inlcude directory not found: ${PRPLMESH_INCLUDE_DIR}")
+    endif()
+
     file(GLOB bwl_platform_sources
         ${MODULE_PATH}/shared/*.c*
         ${MODULE_PATH}/nl80211/*.c*
 
         # WPA Control Interface
-        ${HOSTAPD_DIR}/src/common/wpa_ctrl.c
-        ${HOSTAPD_DIR}/src/utils/os_unix.c
+        ${PRPLMESH_INCLUDE_DIR}/wpa_ctrl.c
+        ${PRPLMESH_INCLUDE_DIR}/os_unix.c
     )
 
     # Enable WPA control interface
@@ -139,9 +157,7 @@ elseif(BWL_TYPE STREQUAL "NL80211")
 
     # Hostapd/NL80211 include directories
     include_directories(
-        ${HOSTAPD_DIR}/src/utils
-        ${HOSTAPD_DIR}/src/common
-        ${HOSTAPD_DIR}/src/drivers
+        ${PRPLMESH_INCLUDE_DIR}
     )
 
     # Platform libraries
diff --git a/framework/external/enumAutoPrint/enum_auto_print_conf.json b/framework/external/enumAutoPrint/enum_auto_print_conf.json
index 645c8eb47..8a2ade06c 100644
--- a/framework/external/enumAutoPrint/enum_auto_print_conf.json
+++ b/framework/external/enumAutoPrint/enum_auto_print_conf.json
@@ -13,6 +13,7 @@
         "${workspaceRoot}/framework/external/",
         "${workspaceRoot}/common/",
         "${workspaceRoot}/agent/",
-        "${workspaceRoot}/controller/"
+        "${workspaceRoot}/controller/",
+        "${workspaceRoot}/include/"
     ]
 }
-- 
2.34.1

