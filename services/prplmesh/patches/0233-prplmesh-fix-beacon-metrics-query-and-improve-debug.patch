+    /* Parse optional ap_channel_reports parameter.
+     * Expected format: list of htable objects, each with "op_class" and "channel" keys.
+     * Example: [{"op_class":115,"channel":36},{"op_class":81,"channel":6}]
+     * When provided, channel=255 is used in the TLV and the agent paces the 802.11k
+     * BeaconRequests internally, returning a single BEACON_METRICS_RESPONSE with all
+     * measurements — ensuring a single dialog_token so the controller does not clear
+     * previous MeasurementReport instances when the second channel's response arrives. */
+    std::vector<std::pair<uint8_t,uint8_t>> ap_channel_reports;
+    {
+        amxc_var_t *ap_ch_list = GET_ARG(args, "ap_channel_reports");
+        if (ap_ch_list && amxc_var_type_of(ap_ch_list) == AMXC_VAR_ID_LIST) {
+            amxc_var_t *entry = nullptr;
+            amxc_llist_for_each(it, amxc_var_constcast(amxc_llist_t, ap_ch_list)) {
+                entry = amxc_var_from_llist_it(it);
+                if (!entry) continue;
+                uint32_t oc  = amxc_var_dyncast(uint32_t, GET_ARG(entry, "op_class"));
+                uint32_t ch  = amxc_var_dyncast(uint32_t, GET_ARG(entry, "channel"));
+                if (oc > 255 || ch > 255) {
+                    LOG(WARNING) << "SendBeaconMetricsQuery: ap_channel_reports entry out of range"
+                                 << " op_class=" << oc << " channel=" << ch << " — skipping";
+                    continue;
+                }
+                ap_channel_reports.emplace_back(static_cast<uint8_t>(oc),
+                                                static_cast<uint8_t>(ch));
+                LOG(DEBUG) << "SendBeaconMetricsQuery: ap_channel_reports entry"
+                           << " op_class=" << oc << " channel=" << ch;
+            }
+        }
+    }
