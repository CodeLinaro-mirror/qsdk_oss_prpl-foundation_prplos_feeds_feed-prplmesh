From f8784fb1eb5a6fdfda14812d78cdfcb7b248d2a2 Mon Sep 17 00:00:00 2001
From: Girija P <gpandiya@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 00:18:10 +0530
Subject: [PATCH 21/31] Added the new bss info to latest default conf

Signed-off-by: Girija P <gpandiya@qti.qualcomm.com>
---
 .../bwl/nl80211/ap_wlan_hal_nl80211.cpp        | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
index d037a8ab9..96185600f 100644
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1273,6 +1273,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
 
             LOG(INFO) << "BSS Addtion success:  " << " bss: " << new_vap_name << " bssid: " <<new_bssid;
 
+            prplmesh::hostapd::Configuration updated_base_conf = load_hostapd_config(m_radio_info.iface_name,"");
             // Add new bss configuration to default hostapd_config file
             if (!m_radio_info.hostapd_new_bss_config.empty()) {
                 auto& new_vap = m_radio_info.hostapd_new_bss_config.front();
@@ -1284,11 +1285,16 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                         break;
                     }
                 }
-                base_conf.add_new_vap_to_default_config(new_vap);
-                m_radio_info.hostapd_new_bss_config.clear();
-                // store the default config
-                if (!base_conf.store()) {
-                    LOG(ERROR) << "Autoconfiguration: failed to add new bss in default config file!";
+                if (updated_base_conf) {
+                    updated_base_conf.add_new_vap_to_default_config(new_vap);
+                    m_radio_info.hostapd_new_bss_config.clear();
+                    // store the default config
+                    if (!updated_base_conf.store()) {
+                        LOG(ERROR) << "Autoconfiguration: failed to add new bss in default config file!";
+                    }
+                } else {
+                    LOG(ERROR) << "Default config file is not updated!";
+
                 }
             }
 
@@ -1477,7 +1483,7 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
                     }
                     const std::string cmd_2("RELOAD_CONFIG");
                     if (!wpa_ctrl_send_msg(cmd_2,vap_info.bss)) {
-                        LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
+                        LOG(ERROR) << "Autoconfiguration: \"" << cmd_2 << "\" command to hostapd has failed";
                         continue;
                     }
                 }
