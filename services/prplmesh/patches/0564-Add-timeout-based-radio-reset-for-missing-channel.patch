             found_fd = true;
         }
         if (found_fd) {
+            if (m_radio_restarts_in_progress.erase(fronthaul_iface) > 0) {
+                radio_manager.fronthaul_started = false;
+                m_restarting_fronthaul_ifaces.insert(fronthaul_iface);
+                LOG(INFO) << "Fronthaul restart requested for " << fronthaul_iface
+                          << " - suppressing global agent reset";
+                return true;
+            }
+
             auto db = AgentDB::get();
             // During DPP BSS credential application, hostapd reloads which causes
             // the ap_manager to disconnect and reconnect. Suppressing agent_reset()
@@ -7272,6 +7280,29 @@ bool slave_thread::agent_fsm()
     return true;
 }
 
+void slave_thread::restart_fronthaul(const std::string &fronthaul_iface)
+{
+    auto radio_it = m_radio_managers.get().find(fronthaul_iface);
+    if (radio_it == m_radio_managers.get().end()) {
+        const auto &zwdfs_radio = m_radio_managers.get_zwdfs();
+        if (!zwdfs_radio || zwdfs_radio->first != fronthaul_iface) {
+            LOG(WARNING) << "Cannot restart unknown fronthaul " << fronthaul_iface;
+            return;
+        }
+        m_radio_restarts_in_progress.insert(fronthaul_iface);
+        m_restarting_fronthaul_ifaces.insert(fronthaul_iface);
+        fronthaul_stop(fronthaul_iface);
+        fronthaul_start(fronthaul_iface);
+        return;
+    }
+
+    m_radio_restarts_in_progress.insert(fronthaul_iface);
+    m_restarting_fronthaul_ifaces.insert(fronthaul_iface);
+    radio_it->second.fronthaul_started = false;
+    fronthaul_stop(fronthaul_iface);
+    fronthaul_start(fronthaul_iface);
+}
+
 void slave_thread::fronthaul_stop(const std::string &fronthaul_iface)
 {
     LOG(INFO) << "fronthaul stop " << fronthaul_iface;
