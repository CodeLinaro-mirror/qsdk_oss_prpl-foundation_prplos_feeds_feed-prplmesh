 static constexpr uint8_t AUTOCONFIG_DISCOVERY_TIMEOUT_SECONDS = 3;
+static constexpr uint8_t CHANNEL_INFO_WAIT_TIMEOUT_SECONDS    = 10;
 static constexpr uint8_t kMaxSequentialM2Retries              = 20;
 
 // Minimum spacing between two DPP BSS-configuration sends to ap_manager, so that
@@ -420,6 +421,30 @@ void ApAutoConfigurationTask::start_next_sequential_radio()
     m_sequential_active_radio.clear();
 }
 
+bool ApAutoConfigurationTask::wait_for_valid_channel(const std::string &radio_iface,
+                                                       sConfigurationParams &conf_params,
+                                                       const char *phase)
+{
+    const auto now = std::chrono::steady_clock::now();
+    if (conf_params.channel_wait_armed == false) {
+        conf_params.channel_wait_deadline =
+            now + std::chrono::seconds(CHANNEL_INFO_WAIT_TIMEOUT_SECONDS);
+        conf_params.channel_wait_armed = true;
+        LOG(DEBUG) << "Waiting for valid channel information before " << phase << " on "
+                   << radio_iface;
+        return false;
+    }
+    if (now >= conf_params.channel_wait_deadline &&
+        conf_params.channel_wait_reset_requested == false) {
+        conf_params.channel_wait_reset_requested = true;
+        LOG(WARNING) << "No valid channel information for " << CHANNEL_INFO_WAIT_TIMEOUT_SECONDS
+                     << " seconds on " << radio_iface << " during " << phase
+                     << "; restarting fronthaul";
+        m_btl_ctx.restart_fronthaul(radio_iface);
+    }
+    return false;
+}
