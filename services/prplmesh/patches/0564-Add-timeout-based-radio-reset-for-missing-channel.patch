             // hold M1 here. The early AP capability report must reach the controller
@@ -778,6 +805,10 @@ void ApAutoConfigurationTask::handle_event(uint8_t event_enum_value, const void
         }
         m_sequential_radio_order.clear();
         m_sequential_active_radio.clear();
+        for (auto &radio_conf : m_radios_conf_params) {
