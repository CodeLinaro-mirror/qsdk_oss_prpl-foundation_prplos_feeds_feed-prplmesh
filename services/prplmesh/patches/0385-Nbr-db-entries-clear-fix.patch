diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index f49c19bd7..3637f1ef5 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -541,9 +541,11 @@ bool slave_thread::thread_init()
     m_task_pool.add_task(
         std::make_shared<LinkMetricsCollectionTask>(*this, cmdu_tx, m_timer_manager));
     m_task_pool.add_task(std::make_shared<VbssTask>(*this, cmdu_tx));
-    m_task_pool.add_task(std::make_shared<NeighborDbAgentTask>(*this, cmdu_tx));
 
     auto db = AgentDB::get();
+    if (db->device_conf.enable_smd) {
+        m_task_pool.add_task(std::make_shared<NeighborDbAgentTask>(*this, cmdu_tx));
+    }
     if (db->device_conf.health_monitoring_enabled) {
         LOG(DEBUG) << "Health monitoring is enabled - adding HealthMonitoringTask to pool";
         m_task_pool.add_task(std::make_shared<HealthMonitoringTask>(*this, cmdu_tx));
@@ -8966,23 +8968,23 @@ bool slave_thread::hal_event_handler(bwl::base_wlan_hal::hal_event_ptr_t event_p
     }
     case Event::SMD_NbrDbSetResp: {
         LOG(DEBUG) << "Received SMD_NbrDbSetResp — routing to NeighborDbAgentTask";
-        task_pool_send_event(eTaskType::NEIGHBOR_DB,
-                             NeighborDbAgentTask::MQTT_NBR_DB_SET_RESP,
-                             event_ptr->second.get());
+        task_pool_try_send_event(eTaskType::NEIGHBOR_DB,
+                                 NeighborDbAgentTask::MQTT_NBR_DB_SET_RESP,
+                                 event_ptr->second.get());
         break;
     }
     case Event::SMD_NbrDbGetResp: {
         LOG(DEBUG) << "Received SMD_NbrDbGetResp — routing to NeighborDbAgentTask";
-        task_pool_send_event(eTaskType::NEIGHBOR_DB,
-                             NeighborDbAgentTask::MQTT_NBR_DB_GET_RESP,
-                             event_ptr->second.get());
+        task_pool_try_send_event(eTaskType::NEIGHBOR_DB,
+                                 NeighborDbAgentTask::MQTT_NBR_DB_GET_RESP,
+                                 event_ptr->second.get());
         break;
     }
     case Event::SMD_NbrDbClearResp: {
         LOG(DEBUG) << "Received SMD_NbrDbClearResp — routing to NeighborDbAgentTask";
-        task_pool_send_event(eTaskType::NEIGHBOR_DB,
-                             NeighborDbAgentTask::MQTT_NBR_DB_CLEAR_RESP,
-                             event_ptr->second.get());
+        task_pool_try_send_event(eTaskType::NEIGHBOR_DB,
+                                 NeighborDbAgentTask::MQTT_NBR_DB_CLEAR_RESP,
+                                 event_ptr->second.get());
         break;
     }
     case Event::Dpp_Frame_Received: {
diff --git a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
index ae20e710b..0ca6c5269 100644
--- a/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
+++ b/agent/src/beerocks/slave/tasks/ap_autoconfiguration_task.cpp
@@ -3481,8 +3481,11 @@ void ApAutoConfigurationTask::handle_multi_ap_policy_config_request(
     // Parse the Neighbor Information Reporting Policy TLV (Wi-Fi EasyMesh 6.1, §17.2.110).
     // If fBSS or bBSS reporting is enabled by the controller, trigger the NeighborDbAgentTask
     // to collect and send the local neighbor report to the controller.
+    // Only active when enable_smd=1; the controller does not send this TLV when disabled.
     auto neighbor_info_reporting_policy_tlv =
-        cmdu_rx.getClass<wfa_map::tlvWifi8NeighborInformationReportingPolicy>();
+        db->device_conf.enable_smd
+            ? cmdu_rx.getClass<wfa_map::tlvWifi8NeighborInformationReportingPolicy>()
+            : nullptr;
     if (neighbor_info_reporting_policy_tlv) {
         const uint8_t flags    = neighbor_info_reporting_policy_tlv->flags();
         const bool bssid_valid = (flags >> 7) & 0x01;
@@ -5301,7 +5304,7 @@ void ApAutoConfigurationTask::handle_vs_wifi_credentials_update_response(
     // so this is the guaranteed sync point that covers all cases.
     // The drop-if-COLLECTING guard in NeighborDbAgentTask deduplicates concurrent fires
     // from multiple radios; only the first one actually runs.
-    if (db->neighbor_info_reporting_policy.any_enabled()) {
+    if (db->device_conf.enable_smd && db->neighbor_info_reporting_policy.any_enabled()) {
         LOG(DEBUG) << "WIFI_CREDENTIALS_UPDATE_RESPONSE from " << radio->front.iface_name
                    << " — triggering neighbor DB collection (policy active)";
         NeighborDbAgentTask::sTriggerSendLocalNeighborInfoEvent ev;
@@ -5540,7 +5543,8 @@ void ApAutoConfigurationTask::handle_vs_ap_enabled_notification(
     // update while still reacting to genuine VAP changes (which arrive outside the window).
     {
         const auto &pol = db->neighbor_info_reporting_policy;
-        if (pol.should_trigger(vap_info.mac,
+        if (db->device_conf.enable_smd &&
+            pol.should_trigger(vap_info.mac,
                                vap_info.fronthaul_vap,
                                vap_info.backhaul_vap)) {
             LOG(DEBUG) << "AP_ENABLED for VAP " << vap_info.mac
diff --git a/controller/src/beerocks/master/controller.cpp b/controller/src/beerocks/master/controller.cpp
index d0281005b..78c08f67c 100755
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -447,11 +447,27 @@ void Controller::start_mandatory_tasks()
     // NOTE: DPP Configurator Task initialization moved to start() method
     // to ensure broker client is available for PTK installation
 
-    // Neighbor DB controller task (SMD Neighbor Update, Option 4) – currently a stub FSM with logs.
-    LOG_IF(
-        !m_task_pool.add_task(std::make_shared<NeighborDbCtrlTask>(database, cmdu_tx, m_task_pool)),
-        FATAL)
-        << "Failed adding NeighborDbCtrlTask!";
+    if (database.config.enable_smd) {
+        // Neighbor DB controller task (SMD Neighbor Update, Option 4) – currently a stub FSM with logs.
+        LOG_IF(
+            !m_task_pool.add_task(
+                std::make_shared<NeighborDbCtrlTask>(database, cmdu_tx, m_task_pool)),
+            FATAL)
+            << "Failed adding NeighborDbCtrlTask!";
+
+        // Wire up remove_agent() → NeighborDbCtrlTask so every removal path (topology_task,
+        // network_map 125s timer, etc.) fires AGENT_REMOVED and propagates the trimmed DB.
+        database.register_agent_removed_hook([this](const sMacAddr &al_mac) {
+            auto nbr_task_id = database.get_neighbor_db_ctrl_task_id();
+            if (nbr_task_id != db::TASK_ID_NOT_FOUND && m_task_pool.is_task_running(nbr_task_id)) {
+                auto ev        = std::make_unique<NeighborDbCtrlTask::sAgentRemovedEvent>();
+                ev->agent_alid = al_mac;
+                m_task_pool.push_event(nbr_task_id,
+                                       static_cast<int>(NeighborDbCtrlTask::eEvent::AGENT_REMOVED),
+                                       ev.release());
+            }
+        });
+    }
 
 }
 
diff --git a/controller/src/beerocks/master/db/db.cpp b/controller/src/beerocks/master/db/db.cpp
index 1fbfdb929..4e316416b 100644
--- a/controller/src/beerocks/master/db/db.cpp
+++ b/controller/src/beerocks/master/db/db.cpp
@@ -436,6 +436,10 @@ bool db::remove_agent(const sMacAddr &mac)
 
     m_agents.erase(mac);
 
+    if (m_agent_removed_hook) {
+        m_agent_removed_hook(mac);
+    }
+
     return dm_remove_device_element(mac);
 }
 
diff --git a/controller/src/beerocks/master/db/db.h b/controller/src/beerocks/master/db/db.h
index 54d51b0cd..e5048ab6b 100644
--- a/controller/src/beerocks/master/db/db.h
+++ b/controller/src/beerocks/master/db/db.h
@@ -3511,6 +3511,13 @@ public:
     bool assign_neighbor_db_ctrl_task_id(int new_task_id);
     int get_neighbor_db_ctrl_task_id();
 
+    /** Register a hook called every time remove_agent() erases an agent from the db.
+     *  The hook receives the erased agent's AL-MAC.  Only one hook is supported. */
+    void register_agent_removed_hook(std::function<void(const sMacAddr &)> hook)
+    {
+        m_agent_removed_hook = std::move(hook);
+    }
+
     void lock();
     void unlock();
 
@@ -3926,6 +3933,8 @@ private:
     int link_metrics_task_id                   = -1;
     int neighbor_db_ctrl_task_id               = -1;
 
+    std::function<void(const sMacAddr &)> m_agent_removed_hook;
+
     std::mutex db_mutex;
 
     /**
diff --git a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
index 90f390916..c2907ef85 100644
--- a/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
+++ b/controller/src/beerocks/master/tasks/agent_monitoring_task.cpp
@@ -721,23 +721,25 @@ bool agent_monitoring_task::send_multi_ap_policy_config_request(const sMacAddr &
         return false;
     }
 
-    // Add Neighbor Information Reporting Policy TLV
-    // Per Wi-Fi EasyMesh 6.1, §17.2.110 (Table 133):
-    //   BSSID_valid = 0 (bit7=0) → policy applies to all BSSes on the agent
-    //   bBSS reporting disabled  (bit6=0)
-    //   fBSS reporting enabled   (bit5=1)
-    //   num_bssid = 0            (required when BSSID_valid=0; bssid_list is omitted)
-    auto neighbor_info_reporting_policy_tlv =
-        cmdu_tx.addClass<wfa_map::tlvWifi8NeighborInformationReportingPolicy>();
-    if (!neighbor_info_reporting_policy_tlv) {
-        LOG(ERROR) << "addClass wfa_map::tlvWifi8NeighborInformationReportingPolicy has failed";
-        return false;
-    }
-    neighbor_info_reporting_policy_tlv->flags()     = 0x20; // bit5=1 (fBSS enabled)
-    neighbor_info_reporting_policy_tlv->num_bssid() = 0;    // BSSID_valid=0 → no BSSID list
+    if (database.config.enable_smd) {
+        // Add Neighbor Information Reporting Policy TLV
+        // Per Wi-Fi EasyMesh 6.1, §17.2.110 (Table 133):
+        //   BSSID_valid = 0 (bit7=0) → policy applies to all BSSes on the agent
+        //   bBSS reporting disabled  (bit6=0)
+        //   fBSS reporting enabled   (bit5=1)
+        //   num_bssid = 0            (required when BSSID_valid=0; bssid_list is omitted)
+        auto neighbor_info_reporting_policy_tlv =
+            cmdu_tx.addClass<wfa_map::tlvWifi8NeighborInformationReportingPolicy>();
+        if (!neighbor_info_reporting_policy_tlv) {
+            LOG(ERROR) << "addClass wfa_map::tlvWifi8NeighborInformationReportingPolicy has failed";
+            return false;
+        }
+        neighbor_info_reporting_policy_tlv->flags()     = 0x20; // bit5=1 (fBSS enabled)
+        neighbor_info_reporting_policy_tlv->num_bssid() = 0;    // BSSID_valid=0 → no BSSID list
 
-    LOG(DEBUG) << "Added Neighbor Information Reporting Policy TLV to agent " << dst_mac
-               << ": flags=0x20 (fBSS reporting enabled), num_bssid=0";
+        LOG(DEBUG) << "Added Neighbor Information Reporting Policy TLV to agent " << dst_mac
+                   << ": flags=0x20 (fBSS reporting enabled), num_bssid=0";
+    }
 
     return son_actions::send_cmdu_to_agent(dst_mac, cmdu_tx, database);
 }
diff --git a/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.cpp b/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.cpp
index 46e155aa3..0b17b9eca 100644
--- a/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.cpp
+++ b/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.cpp
@@ -91,6 +91,20 @@ void NeighborDbCtrlTask::handle_event(int event_type, void *obj)
         break;
     }
 
+    case AGENT_REMOVED: {
+        if (!obj) {
+            TASK_LOG(ERROR) << "AP_DEBUG: AGENT_REMOVED event received with null payload";
+            return;
+        }
+        std::unique_ptr<sAgentRemovedEvent> ev(static_cast<sAgentRemovedEvent *>(obj));
+        TASK_LOG(INFO) << "AP_DEBUG: Agent removed: " << ev->agent_alid
+                       << " — purging from neighbor DB";
+        m_neighbor_db.erase(ev->agent_alid);
+        // Re-propagate the trimmed DB to all remaining agents so they evict the stale entry.
+        propagate_neighbor_info_to_all_agents(ev->agent_alid);
+        break;
+    }
+
     default:
         TASK_LOG(WARNING) << "AP_DEBUG: Unknown event type " << event_type;
         break;
diff --git a/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.h b/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.h
index f05188874..8c441e0b2 100644
--- a/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.h
+++ b/controller/src/beerocks/master/tasks/neighbor_db_ctrl_task.h
@@ -77,6 +77,9 @@ public:
          *                    NeighborDbCtrlTask::TRIGGER_NEIGHBOR_UPDATE, &event);
          */
         TRIGGER_NEIGHBOR_UPDATE,
+
+        /** An agent has been removed (powered off / dead neighbor). */
+        AGENT_REMOVED,
     };
 
     // -----------------------------------------------------------------------
@@ -97,6 +100,11 @@ public:
         sMacAddr agent_alid; ///< Target agent ALID, or ZERO_MAC for all agents.
     };
 
+    /** Payload for AGENT_REMOVED. */
+    struct sAgentRemovedEvent {
+        sMacAddr agent_alid; ///< ALID of the removed agent.
+    };
+
     // -----------------------------------------------------------------------
     // Constructor / destructor
     // -----------------------------------------------------------------------
diff --git a/controller/src/beerocks/master/tasks/topology_task.cpp b/controller/src/beerocks/master/tasks/topology_task.cpp
index cf5412311..f8fd98c08 100644
--- a/controller/src/beerocks/master/tasks/topology_task.cpp
+++ b/controller/src/beerocks/master/tasks/topology_task.cpp
@@ -1162,6 +1162,8 @@ void topology_task::handle_dead_neighbors(const sMacAddr &src_mac, const sMacAdd
         son_actions::handle_dead_station(tlvf::mac_to_string(neighbor->parent_mac), true, database,
                                          tasks);
         database.remove_agent(neighbor->al_mac);
+        // AGENT_REMOVED event is now fired automatically by db::remove_agent() via the hook
+        // registered in controller.cpp — no manual push needed here.
     }
 }
 
