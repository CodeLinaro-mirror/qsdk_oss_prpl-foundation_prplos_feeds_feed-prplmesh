+void slave_thread::erase_pending_wds_notification(const sMacAddr &client_mac,
+                                                  const sMacAddr &bssid)
+{
+    auto pending_wds_it = m_pending_wds_iface_notifications.find(client_mac);
+    if (pending_wds_it == m_pending_wds_iface_notifications.end()) {
+        return;
+    }
+
+    auto &pending_links = pending_wds_it->second;
+    pending_links.erase(bssid);
+    if (pending_links.empty()) {
+        m_pending_wds_iface_notifications.erase(pending_wds_it);
+    }
+}
