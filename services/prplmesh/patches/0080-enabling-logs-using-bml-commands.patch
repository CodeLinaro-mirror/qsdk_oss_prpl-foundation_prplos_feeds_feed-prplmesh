From f2a9cb1761789b923e715e99243d09a69a6d6d89 Mon Sep 17 00:00:00 2001
From: Mahitha M <mmaddulu@qti.qualcomm.com>
Date: Mon, 22 Jun 2026 14:23:09 +0530
Subject: [PATCH] enabling logs using bml commands

Signed-off-by: Mahitha M <mmaddulu@qti.qualcomm.com>
---
 .../ap_manager/ap_manager.cpp                 | 14 ++++++++++
 agent/src/beerocks/slave/son_slave_thread.cpp | 26 ++++++++++++++++++-
 .../bcl/include/bcl/beerocks_defines.h        |  1 +
 .../beerocks/bcl/source/beerocks_logging.cpp  |  1 +
 .../tlvf/beerocks_message_action.yaml         |  3 ++-
 .../tlvf/beerocks_message_apmanager.yaml      |  4 +++
 .../beerocks/bml/internal/bml_internal.cpp    |  4 ++-
 7 files changed, 50 insertions(+), 3 deletions(-)

diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index 49ce7c8ab..70b8dea4f 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2518,6 +2518,20 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
         break;
     }
+    case beerocks_message::ACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL: {
+        LOG(TRACE) << "received ACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL";
+        auto request =
+            beerocks_header
+                ->addClass<beerocks_message::cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL>();
+        if (request == nullptr) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL failed";
+            return;
+        }
+
+        m_logger.set_log_level_state((eLogLevel)request->params().log_level,
+                                     request->params().enable);
+        break;
+    }
     case beerocks_message::ACTION_APMANAGER_PLATFORM_ACS: {
         auto request =
             beerocks_header->addClass<beerocks_message::cACTION_APMANAGER_PLATFORM_ACS>();
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index b93c121db..5a2a2db88 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -1305,7 +1305,31 @@ bool slave_thread::handle_cmdu_control_message(int fd,
                 return false;
             }
             request_out->params() = request_in->params();
-            send_cmdu(radio_manager.monitor_fd, cmdu_tx);
+            // Send to all Monitor instances (one per radio)
+            m_radio_managers.do_on_each_radio_manager(
+                [&](const sManagedRadio &rm, const std::string &iface) {
+                    if (rm.monitor_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+                        send_cmdu(rm.monitor_fd, cmdu_tx);
+                    }
+                    return true;
+                });
+        }
+        if (all || request_in->params().module_name == beerocks::BEEROCKS_PROCESS_APMANAGER) {
+            // Send to ALL ap_managers when 'all' is specified or specifically targeting ap_managers
+            m_radio_managers.do_on_each_radio_manager([&](const sManagedRadio &rm,
+                                                          const std::string &iface) -> bool {
+                if (rm.ap_manager_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+                    auto request_out = message_com::create_vs_message<
+                        beerocks_message::cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL>(cmdu_tx);
+                    if (request_out == nullptr) {
+                        LOG(ERROR) << "Failed building message for ap_manager " << iface;
+                        return true; // Continue to next ap_manager
+                    }
+                    request_out->params() = request_in->params();
+                    send_cmdu(rm.ap_manager_fd, cmdu_tx);
+                }
+                return true;
+            });
         }
         if (all || request_in->params().module_name == beerocks::BEEROCKS_PROCESS_PLATFORM) {
             auto request_out = message_com::create_vs_message<
diff --git a/common/beerocks/bcl/include/bcl/beerocks_defines.h b/common/beerocks/bcl/include/bcl/beerocks_defines.h
index f9decec94..e38000b49 100644
--- a/common/beerocks/bcl/include/bcl/beerocks_defines.h
+++ b/common/beerocks/bcl/include/bcl/beerocks_defines.h
@@ -193,6 +193,7 @@ enum eBeeRocksProcesses : uint8_t {
     BEEROCKS_PROCESS_SLAVE,
     BEEROCKS_PROCESS_MONITOR,
     BEEROCKS_PROCESS_PLATFORM,
+    BEEROCKS_PROCESS_APMANAGER,
 };
 
 enum eBeeRocksEntities : uint8_t {
diff --git a/common/beerocks/bcl/source/beerocks_logging.cpp b/common/beerocks/bcl/source/beerocks_logging.cpp
index 92c613170..af2cff0e6 100644
--- a/common/beerocks/bcl/source/beerocks_logging.cpp
+++ b/common/beerocks/bcl/source/beerocks_logging.cpp
@@ -443,6 +443,7 @@ bool logging::get_syslog_enabled() { return m_syslog_enabled; }
 void logging::set_log_level_state(const eLogLevel &log_level, const bool &new_state)
 {
     m_levels.set_log_level_state(log_level, new_state);
+    m_syslog_levels.set_log_level_state(log_level, new_state);
     apply_settings();
 }
 
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
index 504850264..76cc29f2d 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_action.yaml
@@ -276,7 +276,8 @@ eActionOp_APMANAGER:
   ACTION_APMANAGER_BSS_SET_QOS_MANAGEMENT_REQUEST: 81
 
   ACTION_APMANAGER_AFFILIATED_LINK_CHANGED_NOTIFICATION: 82
-  ACTION_APMANAGER_ENUM_END: 83
+  ACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL: 83
+  ACTION_APMANAGER_ENUM_END: 84
 
 ####################################################
 ####################################################
diff --git a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
index 255b74493..0d92f2cd4 100755
--- a/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
+++ b/common/beerocks/tlvf/yaml/beerocks/tlvf/beerocks_message_apmanager.yaml
@@ -396,3 +396,7 @@ cACTION_APMANAGER_BSS_SET_QOS_MANAGEMENT_REQUEST:
   bssid: sMacAddr
   mscs_enable: uint8_t
   scs_enable: uint8_t
+
+cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL:
+  _type: class
+  params: sLoggingLevelChange
diff --git a/controller/src/beerocks/bml/internal/bml_internal.cpp b/controller/src/beerocks/bml/internal/bml_internal.cpp
index e628291e2..f06fcc55f 100644
--- a/controller/src/beerocks/bml/internal/bml_internal.cpp
+++ b/controller/src/beerocks/bml/internal/bml_internal.cpp
@@ -3922,7 +3922,9 @@ int bml_internal::set_log_level(const std::string &module_name, const std::strin
     else if (module_name == "monitor")
         request->params().module_name = BEEROCKS_PROCESS_MONITOR;
     else if (module_name == "platform")
-        request->params().module_name = BEEROCKS_PROCESS_MONITOR;
+        request->params().module_name = BEEROCKS_PROCESS_PLATFORM;
+    else if (module_name == "apmanager")
+        request->params().module_name = BEEROCKS_PROCESS_APMANAGER;
     else if (module_name == "all")
         request->params().module_name = BEEROCKS_PROCESS_ALL;
     else {
