diff --git a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
index e8698e89b..d05b6b0b6 100644
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2273,6 +2273,20 @@ void ApManager::handle_cmdu(ieee1905_1::CmduMessageRx &cmdu_rx)
 
         break;
     }
+    case beerocks_message::ACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL: {
+        LOG(TRACE) << "received ACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL";
+        auto request =
+            beerocks_header
+                ->addClass<beerocks_message::cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL>();
+        if (request == nullptr) {
+            LOG(ERROR) << "addClass cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL failed";
+            return;
+        }
+
+        m_logger.set_log_level_state((eLogLevel)request->params().log_level,
+                                     request->params().enable);
+        break;
+    }
     case beerocks_message::ACTION_APMANAGER_PLATFORM_ACS: {
         auto request =
             beerocks_header->addClass<beerocks_message::cACTION_APMANAGER_PLATFORM_ACS>();
diff --git a/agent/src/beerocks/slave/son_slave_thread.cpp b/agent/src/beerocks/slave/son_slave_thread.cpp
index e2db01330..48a2134fc 100644
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -1260,7 +1260,31 @@ bool slave_thread::handle_cmdu_control_message(int fd,
                 return false;
             }
             request_out->params() = request_in->params();
-            send_cmdu(radio_manager.monitor_fd, cmdu_tx);
+            // Send to all Monitor instances (one per radio)
+            m_radio_managers.do_on_each_radio_manager(
+                [&](const sManagedRadio &rm, const std::string &iface) {
+                    if (rm.monitor_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+                        send_cmdu(rm.monitor_fd, cmdu_tx);
+                    }
+                    return true;
+                });
+        }
+        if (all || request_in->params().module_name == beerocks::BEEROCKS_PROCESS_APMANAGER) {
+            // Send to ALL ap_managers when 'all' is specified or specifically targeting ap_managers
+            m_radio_managers.do_on_each_radio_manager([&](const sManagedRadio &rm,
+                                                          const std::string &iface) -> bool {
+                if (rm.ap_manager_fd != beerocks::net::FileDescriptor::invalid_descriptor) {
+                    auto request_out = message_com::create_vs_message<
+                        beerocks_message::cACTION_APMANAGER_CHANGE_MODULE_LOGGING_LEVEL>(cmdu_tx);
+                    if (request_out == nullptr) {
+                        LOG(ERROR) << "Failed building message for ap_manager " << iface;
+                        return true; // Continue to next ap_manager
+                    }
+                    request_out->params() = request_in->params();
+                    send_cmdu(rm.ap_manager_fd, cmdu_tx);
+                }
+                return true;
+            });
         }
         if (all || request_in->params().module_name == beerocks::BEEROCKS_PROCESS_PLATFORM) {
             auto request_out = message_com::create_vs_message<
