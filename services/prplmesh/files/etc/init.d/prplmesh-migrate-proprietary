START=98

MARKER=/etc/prplmesh/.proprietary_migration_done
MIGRATION=/opt/prplmesh/scripts/script_to_pull_prop.sh
LOG_DIR=/overlay/var/log/prplmesh
LOG_FILE="$LOG_DIR/boot.log"

log_file_init()
{
        if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
                LOG_DIR=/tmp/prplmesh
                LOG_FILE="$LOG_DIR/boot.log"
                mkdir -p "$LOG_DIR" || return 1
        fi
        exec >>"$LOG_FILE" 2>&1
        printf '%s [INFO] migration check started\n' "$(date '+%Y-%m-%d %H:%M:%S')"
}

log()
{
        logger -t prplmesh-migrate -p "$1" "$2"
        printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2"
}

start()
{
        log_file_init || {
                logger -t prplmesh-migrate -p daemon.err "cannot initialize boot log"
                return 1
        }

        if [ -f "$MARKER" ]; then
                log daemon.info "migration marker exists; skipping migration"
                return 0
        fi

        if [ ! -f /etc/config/repacd ] || [ ! -f /etc/config/ezmesh ]; then
                log daemon.info "proprietary configuration incomplete; skipping migration"
                return 0
        fi

        # mkdir -p "${MARKER%/*}" || {
        #         log daemon.err "cannot create migration marker directory"
        #         return 1
        # }

        # log daemon.info "proprietary repacd/ezmesh configuration detected; migrating to prplMesh"

        # if [ ! -x "$MIGRATION" ]; then
        #         log daemon.err "migration script is not executable: $MIGRATION"
        #         return 1
        # fi

        log daemon.info "running $MIGRATION auto wireless in background"
        "$MIGRATION" auto wireless &
        log daemon.info "proprietary mesh migration worker started (pid=$!)"
        return 0
}
