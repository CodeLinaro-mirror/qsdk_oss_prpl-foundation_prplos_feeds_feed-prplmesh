#!/bin/sh /etc/rc.common

. /lib/functions/system.sh

START=99
NAME=prplmesh

#####################################
# Helper functions for wlan ready
#####################################

hostapd_ready()
{
	hostapd_path="/var/run/hostapd"
	if [ -d "$hostapd_path/$1" ]; then
	    hostapd_path="$hostapd_path/$1"
	fi
	echo "Interface $1: hostapd_path - $hostapd_path"
        hostapd_cli -i$1 -p$hostapd_path stat &>/dev/null || ubus call WiFi.Radio _get '{"depth":"0"}' &> /dev/null
}

wlan_reset()
{
        wifi down
        sleep 5
        local leftover_processes="$(ps | grep '[h]ostapd\|[s]upp')"
        if [ -n "$leftover_processes" ]; then
                logger -t "${NAME}" -p daemon.warn "Wlan procceses still running after wifi down: $leftover_processes"
                echo "Wlan procceses still running after wifi down: $leftover_processes"
                # STA interfaces/processes sometimes not closed properly (https://jira.prplfoundation.org/browse/PPM-1778)
                # This issue was spotted after wifi driver release update UGW8.5.2 in prplos.
                # Currently just log this event and continue.
                # In case wlan will not recover wlan_ready() will handle it.
        fi   
        wifi up
}

wlan_ready()
{
        for iface; do
                if ! hostapd_ready "$iface"; then
                        logger -t "${NAME}" -p daemon.warn "$0: wlan $iface not ready"
                        return 1
                fi
        done
}

get_hostap_iface() 
{
        local radio="$1"
        uci get "prplmesh.$radio.hostap_iface"
}

wlan_ready_poll()
{

        # load the prplmesh config to be able to get the radio iface:
        config_load prplmesh
        ifaces="$(config_foreach get_hostap_iface wifi-device)"

        start_time="$(date -u +%s)"
        logger -t "${NAME}" -p daemon.warn "$start_time"
        count=1
        while [ $count -le 60 ]; do
                if wlan_ready $ifaces; then
                        break
                fi
                logger -t "${NAME}" -p daemon.warn "Trying for WLAN ready status $count time"
                count=$((count + 1))

                sleep 1
        done
        if [ "$count" -gt 60 ]; then
            logger -t "${NAME}" -p daemon.err "Retry completed $count times and WLAN not ready"
            return 1
        fi

}

show_wireless_radio_disabled() 
{
        local radio="$1"
        config_get disabled $radio disabled
        if [ "$disabled" -eq 0 ]; then
                echo "$radio is enabled"
        else
                echo "$radio is disabled!"
        fi
}

####################
# main
####################

status_function() {
        # load the wireless config and show the disabled value of each radio
        config_load wireless
        config_foreach show_wireless_radio_disabled wifi-device

        echo "enable: $(uci get prplmesh.config.enable)"
        echo "management_mode: $(uci get prplmesh.config.management_mode)"
        echo "operating_mode: $(uci get prplmesh.config.operating_mode)"
        wlan_ready && echo "WLAN Ready" || echo "WLAN not ready"
        /opt/prplmesh/scripts/prplmesh_utils.sh status
}

get_prim_ifname() {
    if [ -z "$1" ]; then
        echo "Usage: $0 <frequency>"
        echo "Example: $0 5170"
        exit 1
    fi

    freq="$1"

# Step 1: Get idx based on frequency
    idx=$(iw phy | awk -v target="$freq" '
    /Idx/ {i=$3; gsub(":", "", i)}
    /Frequency Range:/ {
        start=$3
        gsub("MHz", "", start)
        if (start == target) {
            print i
        }
    }
    ')

# Check if idx was found
    if [ -z "$idx" ]; then
        echo "No matching frequency found."
        exit 1
    fi

# Step 2: Build config file path
    conf_file="/var/run/hostapd-phy00.$idx.conf"

# Check if file exists
    if [ ! -f "$conf_file" ]; then
        echo "Config file not found: $conf_file"
        exit 1
    fi

# Step 3: Extract the interface line
    interface_line=$(grep "^interface=" "$conf_file")

# Print only the interface value (after '=')
    ifname="${interface_line#interface=}"

    # Output: key=value pairs
    echo "$idx $ifname"


}

# Radio frequency definitions (in MHz)
FREQ_2G=2402
FREQ_5GL=5170
FREQ_6G=5945
FREQ_5GH=5490

update_radio_hostap_iface() {

    freq_list="$FREQ_2G $FREQ_5GL $FREQ_6G $FREQ_5GH"
    i=0

    prplmesh_radio_2g=0
    prplmesh_radio_5g=1
    prplmesh_radio_6g=2
    prplmesh_radio_5gh=3

    for freq in $freq_list; do

        #Call once; check exit status first
        if out="$(get_prim_ifname "$freq")"; then
            # Expecting space-separated: "<radio_id> <ifname>"
            set -- $out
            radio_id=$1
            ifname=$2
        else
            echo "get_prim_ifname failed for freq=$freq" >&2
            # Move to next frequency on failure
            i=$((i + 1))
            continue
        fi

        echo "radio_id=$radio_id, ifname=$ifname"

        eval "radio${i}_ifname=\"$ifname\""

        echo "radio${i}_ifname = $ifname (Frequency: $freq)"

        case "$ifname" in
            *)
                #Check if prplmesh.radioX section exists
                if [ -z "$(uci show "prplmesh.radio${i}" 2>/dev/null)" ]; then
                    echo "Creating prplmesh.radio${i} section"
                    uci set prplmesh.radio${i}=wifi-device
 
                # Add default options for new section
                uci set prplmesh.radio${i}.hostap_iface="$ifname"
                uci set prplmesh.radio${i}.sta_iface="dummy_sta"
                uci set prplmesh.radio${i}.dcs_enable="0"
                uci set prplmesh.radio${i}.dcs_interval_sec="15"
                uci set prplmesh.radio${i}.dcs_dwell_msec="40"
                uci set prplmesh.radio${i}.dcs_refresh_sec="86400"
 
                # Set channel pool based on band (example logic)
 
                case $i in
                    "$prplmesh_radio_2g") uci set prplmesh.radio${i}.dcs_channel_pool="1,6,11" ;;
                    "$prplmesh_radio_5g"|"$prplmesh_radio_5gh") uci set prplmesh.radio${i}.dcs_channel_pool="36-48,149-165" ;;
                    "$prplmesh_radio_6g") uci set prplmesh.radio${i}.dcs_channel_pool="2-233" ;;
                esac
            fi
 
            uci set prplmesh.radio${i}.hostap_iface="$ifname"
            uci set prplmesh.radio${i}.radio_id="$radio_id"
            ;;
        esac

        i=$((i+1))
    done

    uci commit prplmesh

}

update_radio_sta_iface() {

    num_of_bands=$(iw phy | awk '/Idx/ {count++} END {print count}')
    echo "Total available bands: $num_of_bands"
 
 
    if [ -z "$num_of_bands" ] || [ "$num_of_bands" -eq 0 ] 2>/dev/null; then
        echo "Total available bands: 0"
        echo "No bands detected. Exiting."
        return 0
    fi

    updated_radios=""

    for section in $(uci show wireless | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
        mode=$(uci get wireless.$section.mode 2>/dev/null)
        ifname=$(uci get wireless.$section.ifname 2>/dev/null)
        device=$(uci get wireless.$section.device 2>/dev/null)
        disabled=$(uci get wireless.$section.disabled 2>/dev/null)
 
        # Process only if mode=sta and disabled is NOT 1
        if [ "$mode" = "sta" ] && [ "$disabled" != "1" ] ; then
                # Get corresponding radio value from wifi-device section
                radio=$(uci get wireless.$device.radio 2>/dev/null)

                prpl_radio_idx="$(update_sta_iface_in_prplmesh_config "$radio" "$ifname")"

                if [ -n "$prpl_radio_idx" ]; then
                   echo "STA Interface: $ifname | Device: $device | Radio: $radio | Prpl_Radio: $prpl_radio_idx"
                   updated_radios="$updated_radios $prpl_radio_idx"
                fi
        fi
    done
 
 
    # Add dummy sta_iface for radios not updated
    for r in $(seq 0 $((num_of_bands-1))); do
        if ! echo "$updated_radios" | grep -qw "$r"; then
            uci set prplmesh.radio${r}.sta_iface="dummy_sta"
            echo "Added dummy STA for radio$r"
        fi
    done
    
    uci commit prplmesh
}

update_sta_iface_in_prplmesh_config()
{

    local radio="$1"
    local sta_iface="$2"

    echo "radio_id=$radio" >&2
    echo "sta_iface=$sta_iface" >&2

    for section in $(uci show prplmesh | grep "=wifi-device" | cut -d. -f2 | cut -d= -f1); do
        radio_id=$(uci get prplmesh.$section.radio_id 2>/dev/null)

        if [ "$radio_id" = "$radio" ]; then
            uci set "prplmesh.$section.sta_iface=$sta_iface"
            uci commit prplmesh
            echo "Updated prplmesh.$section.sta_iface=$sta_iface" >&2

            #Extract prplmesh radio id: radio0 -> 0
            local prpl_radio_idx="${section#radio}"
            echo "$prpl_radio_idx"
            break
        fi
    done
}

start_function() {
        if [ $(uci -q get prplmesh.config.enable) == "1" ]; then
                update_radio_hostap_iface
                wlan_ready_poll || {
                        logger -t "${NAME}" -p daemon.warn "Timeout waiting for WLAN ready!"
                        exit 1
                }

                update_radio_sta_iface 

                if [ "$(uci get prplmesh.config.operating_mode)" = "Gateway" ]; then
                        logger -t "${NAME}" -p daemon.info "Start prplMesh controller & agent"
			rm /tmp/beerocks/mld_pair_entrant.txt
                        /opt/prplmesh/scripts/prplmesh_utils.sh start
                else
                        logger -t "${NAME}" -p daemon.info "Start prplMesh agent"
                        /opt/prplmesh/scripts/prplmesh_utils.sh start -m A
                fi
        else
                logger -t "${NAME}" -p daemon.warn "prplMesh is disabled (prplmesh.config.enable=0), skipping..."
                exit 0
        fi
}

stop_function() {
        logger -t "${NAME}" -p daemon.info "Stop prplMesh"
        /opt/prplmesh/scripts/prplmesh_utils.sh stop
        # since prplmesh changes the wifi runtime configuration,
        # restart wifi when stopping prplmesh
        # unless using prplmesh wireless hardware manager
#        ubus call WiFi.Radio _get '{"depth":"0"}' &> /dev/null || wlan_reset
}

enable_function() {
        logger -t "${NAME}" -p daemon.info "Enable prplMesh (reboot required)"
        uci set prplmesh.config.enable=1
        uci commit prplmesh
}

disable_function() {
        logger -t "${NAME}" -p daemon.info "Disable prplMesh (reboot required)"
        uci set prplmesh.config.enable=0
        uci commit prplmesh
}

start() {
        start_function
}

stop() {
        stop_function
}

restart() {
        if [ $(uci -q get prplmesh.config.enable) == "1" ]; then
                update_radio_hostap_iface
                wlan_ready_poll || {
                        logger -t "${NAME}" -p daemon.warn "Timeout waiting for WLAN ready!"
                        exit 1
                }
                update_radio_sta_iface
                if [ "$(uci get prplmesh.config.operating_mode)" = "Gateway" ]; then
                        logger -t "${NAME}" -p daemon.info "Restart prplMesh controller & agent"
                        /opt/prplmesh/scripts/prplmesh_utils.sh restart
                else
                        logger -t "${NAME}" -p daemon.info "Restart prplMesh agent"
                        /opt/prplmesh/scripts/prplmesh_utils.sh restart -m A
                fi
        else
                logger -t "${NAME}" -p daemon.warn "prplMesh is disabled (prplmesh.config.enable=0), skipping..."
                exit 0
        fi
}

status() {
        status_function
}

__uci_set_repeater_mode__() {
        mode=${1-wired}
        uci set prplmesh.config.management_mode='Multi-AP-Agent'
        uci set prplmesh.config.operating_mode='WDS-Repeater'
        if [ "$mode" = "wireless" ]; then
                uci set prplmesh.config.wired_backhaul=0
        else
                uci set prplmesh.config.wired_backhaul=1
        fi
        uci set prplmesh.config.master=0
        uci set prplmesh.config.gateway=0
        uci commit prplmesh
}

repeater_mode() {
        stop
        __uci_set_repeater_mode__ $1
        start
        echo "prplmesh repeater mode set"
}

__uci_set_gateway_mode__() {
        uci commit network
        uci set prplmesh.config.management_mode='Multi-AP-Controller-and-Agent'
        uci set prplmesh.config.operating_mode='Gateway'
        uci set prplmesh.config.wired_backhaul=0
        uci set prplmesh.config.master=1
        uci set prplmesh.config.gateway=1
        uci commit prplmesh
}

gateway_mode() {
        stop
        __uci_set_gateway_mode__
        start
        echo "prplmesh gateway mode set"
}

__uci_set_certification_mode__() {
        uci set prplmesh.config.certification_mode=1
        uci commit prplmesh
}

certification_mode() {
        mode=${1-controller}

        stop
        case "$mode" in
        controller | gateway)
                __uci_set_gateway_mode__
                __uci_set_certification_mode__
                ;;
        agent | repeater)
                __uci_set_repeater_mode__
                __uci_set_certification_mode__
                ;;
        esac
        start
}

EXTRA_COMMANDS="status repeater_mode gateway_mode certification_mode"
EXTRA_HELP='''
	status                    show service status
	certification_mode <mode> set certification controller mode
	repeater_mode [backhaul]  set repeater mode with backhaul wired (default) or wireless
	gateway_mode              set gateway mode
'''
