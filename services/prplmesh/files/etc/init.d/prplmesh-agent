#SPDX-License-Identifier: ISC

. /lib/functions/system.sh

START=99
STOP=01
USE_PROCD=1

PRPLMESH_DIR="/opt/prplmesh/"
NAME="prplmesh-agent"
BEEROCKS_AGENT_BIN="/opt/prplmesh/bin/beerocks_agent"
AGENT_START_REQUEST="/tmp/beerocks/prplmesh-agent.start"
AGENT_READY_REQUEST="/tmp/beerocks/prplmesh-agent.ready"

hostapd_ready()
{
    hostapd_path="/var/run/hostapd"
    if [ -d "$hostapd_path/$1" ]; then
        hostapd_path="$hostapd_path/$1"
    fi
    echo "Interface $1: hostapd_path - $hostapd_path"

    if is_openwrt_os; then
        hostapd_stat_output="$(hostapd_cli -i "$1" -p "$hostapd_path" stat 2>&1)"
        hostapd_stat_rc=$?
        hostapd_status_output="$(hostapd_cli -i "$1" -p "$hostapd_path" status 2>&1)"
        hostapd_status_rc=$?
        hostapd_state="$(printf '%s\n' "$hostapd_status_output" | sed -n 's/^state=//p' | head -n 1)"
        ubus_output="$(ubus call WiFi.Radio _get '{"depth":"0"}' 2>&1)"
        ubus_rc=$?
        logger -t "${NAME}" -p daemon.debug \
            "hostapd_ready iface=$1 path=$hostapd_path stat_rc=$hostapd_stat_rc status_rc=$hostapd_status_rc state=${hostapd_state:-unknown} ubus_rc=$ubus_rc"

        [ "$hostapd_stat_rc" -eq 0 ] || [ "$ubus_rc" -eq 0 ]
    else
        hostapd_cli -i$1 -p$hostapd_path stat &>/dev/null || \
            ubus call WiFi.Radio _get '{"depth":"0"}' &> /dev/null
    fi
}

# Confirms hostapd's global control interface itself is up and responsive,
# before anything else in this script tries to read per-radio conf files or
# per-iface control sockets, which can otherwise briefly appear/disappear
# while hostapd is still starting up.
hostapd_global_ready()
{
        if is_openwrt_os; then
                hostapd_cli -p "/var/run/hostapd" -i global ping 2>/dev/null | grep -qx "PONG"
        else
                [ -e "/tmp/run/hostapd.lock" ]
        fi
}

hostapd_global_ready_poll()
{
        local count=1
        while [ $count -le 120 ]; do
                if hostapd_global_ready; then
                        if is_openwrt_os; then
                                logger -t "${NAME}" -p daemon.info "hostapd global control interface responded PONG after $count attempt(s)"
                        else
                                logger -t "${NAME}" -p daemon.info "hostapd lock file present after $count attempt(s)"
                        fi
                        return 0
                fi
                if is_openwrt_os; then
                        logger -t "${NAME}" -p daemon.warn "Waiting for hostapd global control interface PONG (attempt $count/120)"
                else
                        logger -t "${NAME}" -p daemon.warn "Waiting for /tmp/run/hostapd.lock to appear (attempt $count/120)"
                fi
                count=$((count + 1))
                sleep 1
        done
        if is_openwrt_os; then
                logger -t "${NAME}" -p daemon.err "hostapd global control interface did not respond PONG after $count attempts"
        else
                logger -t "${NAME}" -p daemon.err "/tmp/run/hostapd.lock did not appear after $count attempts"
        fi
        return 1
}

# The hostapd global control interface check is only meaningful on OpenWrt-based
# images; other distros using this same init script may not expose this socket.
is_openwrt_os()
{
        grep -q '^NAME="OpenWrt"' /etc/os-release 2>/dev/null
}

# Wait until the wireless driver exposes at least two usable frequency ranges.
# During boot, iw may exist and return success before the ath12k PHYs are fully
# registered; treating that output as ready causes stale hostap_iface values to
# reach wlan_ready_poll().
iw_phy_ready_poll()
{
        local count=1
        local iw_output
        local iw_rc
        local valid_frequency_count

        while [ "$count" -le 60 ]; do
                iw_output="$(iw phy 2>&1)"
                iw_rc=$?
                valid_frequency_count="$(printf '%s\n' "$iw_output" | awk '
                /Frequency Range:/ {
                        line = $0
                        sub(/.*Frequency Range: */, "", line)
                        start = line + 0
                        sub(/[^-]*- */, "", line)
                        end = line + 0
                        if (start > 0 && end > start) {
                                count++
                        }
                }
                END { print count + 0 }
                ')"

                logger -t "${NAME}" -p daemon.debug \
                        "iw_phy_ready_poll attempt=$count rc=$iw_rc valid_frequency_ranges=$valid_frequency_count"

                if [ "$iw_rc" -eq 0 ] && [ "$valid_frequency_count" -ge 2 ] 2>/dev/null; then
                        logger -t "${NAME}" -p daemon.info \
                                "iw phy ready after $count attempt(s): $valid_frequency_count valid frequency ranges"
                        return 0
                fi

                if [ "$iw_rc" -ne 0 ]; then
                        logger -t "${NAME}" -p daemon.warn \
                                "iw_phy_ready_poll: iw phy failed output=$(printf '%s' "$iw_output" | tr '\n' ' ' | cut -c1-240)"
                fi

                count=$((count + 1))
                sleep 1
        done

        logger -t "${NAME}" -p daemon.err \
                "iw phy did not expose at least 2 valid frequency ranges after 60 attempts"
        return 1
}

wlan_ready()
{
        for iface; do
                if ! hostapd_ready "$iface"; then
                        logger -t "${NAME}" -p daemon.warn "$0: wlan $iface not ready"
                        return 1
                fi
        done
}

get_hostap_iface()
{
        local radio="$1"
        uci get "prplmesh.$radio.hostap_iface"
}

hostapd_ctrl_path_valid()
{
        local iface="$1"
        [ -S "/var/run/hostapd/$iface" ] || [ -e "/var/run/hostapd/$iface" ]
}

wlan_ready_poll()
{

        # load the prplmesh config to be able to get the radio iface:
        config_load prplmesh
        ifaces="$(config_foreach get_hostap_iface wifi-device)"

        filtered_ifaces=""
        for iface in $ifaces; do
            [ "$iface" = "dummy_ap" ] && continue
            filtered_ifaces="$filtered_ifaces $iface"
        done

        ifaces="${filtered_ifaces# }"

        if [ -z "$ifaces" ]; then
            logger -t "${NAME}" -p daemon.warn \
                "All hostap_iface entries are dummy_ap, skipping WLAN readiness check"
            return 0
        fi

        start_time="$(date -u +%s)"
        logger -t "${NAME}" -p daemon.warn "$start_time"
        count=1
        while [ $count -le 60 ]; do
                if wlan_ready $ifaces; then
                        break
                fi
                logger -t "${NAME}" -p daemon.warn "Trying for WLAN ready status $count time"
                count=$((count + 1))

                sleep 1
        done
        if [ "$count" -gt 60 ]; then
            logger -t "${NAME}" -p daemon.err "Retry completed $count times and WLAN not ready"
            return 1
        fi

}

stop_agent() {
    killall beerocks_agent
}

get_prim_ifname() {
    if [ -z "$1" ]; then
        echo "Usage: $0 <frequency>"
        echo "Example: $0 5170"
        exit 1
    fi

    freq="$1"

# Step 1: Get idx based on frequency
# Match any Frequency Range that contains the target frequency (start <= target <= end).
# This avoids brittle exact-start matching: FREQ_* values only need to be a
# representative frequency within the band, not the exact range-start the driver reports.
    if is_openwrt_os; then
        iw_output="$(iw phy 2>&1)"
        iw_rc=$?
        iw_bytes="$(printf '%s\n' "$iw_output" | wc -c)"
        iw_idx_count="$(printf '%s\n' "$iw_output" | grep -c 'Idx' 2>/dev/null)"
        logger -t "${NAME}" -p daemon.debug \
            "get_prim_ifname freq=$freq: iw phy rc=$iw_rc bytes=$iw_bytes idx_lines=$iw_idx_count"
        if [ "$iw_rc" -ne 0 ]; then
            logger -t "${NAME}" -p daemon.warn \
                "get_prim_ifname freq=$freq: iw phy failed output=$(printf '%s' "$iw_output" | tr '\n' ' ' | cut -c1-240)"
        elif [ "$iw_idx_count" -eq 0 ] 2>/dev/null; then
            logger -t "${NAME}" -p daemon.warn \
                "get_prim_ifname freq=$freq: iw phy succeeded but returned no PHY index; output=$(printf '%s' "$iw_output" | tr '\n' ' ' | cut -c1-240)"
        fi

        idx="$(printf '%s\n' "$iw_output" | awk -v target="$freq" '
    /Idx/ {i=$3; gsub(":", "", i)}
    /Frequency Range:/ {
        # Use sub() to extract start/end robustly from the line, e.g.:
        #   "    Frequency Range: 2402 MHz - 2494 MHz"
        # This avoids brittle fixed-field indexing ($3/$6) that breaks if
        # the driver emits extra whitespace tokens or a different separator.
        # Note: 3-argument match() is gawk-only and unavailable in BusyBox awk.
        line = $0
        sub(/.*Frequency Range: */, "", line)   # line -> "2402 MHz - 2494 MHz"
        start = line + 0                        # leading number -> 2402
        sub(/[^-]*- */, "", line)               # line -> "2494 MHz"
        end = line + 0                          # leading number -> 2494
        if (start > 0 && end > 0 && target >= start && target <= end) {
            print i
        }
    }
        ')"
    else
        idx=$(iw phy | awk -v target="$freq" '
    /Idx/ {i=$3; gsub(":", "", i)}
    /Frequency Range:/ {
        line = $0
        sub(/.*Frequency Range: */, "", line)
        start = line + 0
        sub(/[^-]*- */, "", line)
        end = line + 0
        if (start > 0 && end > 0 && target >= start && target <= end) {
            print i
        }
    }
    ')
    fi

# Check if idx was found
    if [ -z "$idx" ]; then
        if is_openwrt_os; then
            logger -t "${NAME}" -p daemon.warn \
                "get_prim_ifname freq=$freq: no matching PHY index (iw_rc=$iw_rc idx_lines=$iw_idx_count); frequency parser did not match; ranges=$(printf '%s\n' "$iw_output" | grep 'Frequency Range:' | tr '\n' ' ' | cut -c1-240)"
        fi
        echo "No matching frequency found." >&2
        exit 1
    fi

# Step 2: Build config file path
    conf_file="/var/run/hostapd-phy00.$idx.conf"
	if is_openwrt_os; then
	if [ -f "$conf_file" ]; then
		logger -t "${NAME}" -p daemon.debug \
			"get_prim_ifname freq=$freq idx=$idx conf=$conf_file present"
	else
		logger -t "${NAME}" -p daemon.debug \
			"get_prim_ifname freq=$freq idx=$idx conf=$conf_file missing -> dummy_ap"
	fi
	fi

# If hostapd hasn't started yet (no runtime conf for this radio), fall back to
# the dummy_ap placeholder instead of failing, so radio config can still be applied.
    if [ ! -f "$conf_file" ]; then
        echo "Config file not found: $conf_file, defaulting ifname to dummy_ap" >&2
        echo "$idx dummy_ap"
        return 0
    fi
# Step 3: Extract the interface line
    interface_line=$(grep "^interface=" "$conf_file")

# Print only the interface value (after '=')
    ifname="${interface_line#interface=}"
    [ -z "$ifname" ] && ifname="dummy_ap"

    # Output: key=value pairs
    echo "$idx $ifname"


}

# Radio frequency definitions (in MHz)
FREQ_2G=2402
FREQ_5GL=5170
FREQ_6G=5945
FREQ_5GH=5490

derive_radio_macaddr() {
    local idx="$1"        # numeric phy sub-index, e.g. 0/1/2
    local section="$2"    # e.g. radio0

    local phy_name="phy00.${idx}"
    uci set "prplmesh.${section}.phy_name=${phy_name}"

    # Keep the MAC stable across restarts/reboots: only derive it once.
    if [ -n "$(uci -q get "prplmesh.${section}.macaddr")" ]; then
        return 0
    fi

    local mac
    mac="$(
        . /lib/functions.sh
        . /lib/netifd/wireless/mac80211.sh
        export macidx=0
        mac80211_generate_mac "phy00:${idx}" ap
    )"

    if [ -n "$mac" ]; then
        uci set "prplmesh.${section}.macaddr=${mac}"
    else
        logger -t "${NAME}" -p daemon.warn \
            "derive_radio_macaddr: failed to derive macaddr for ${section} (phy00:${idx})"
    fi
}

update_radio_hostap_iface() {
        if is_openwrt_os; then
        logger -t "${NAME}" -p daemon.debug \
            "update_radio_hostap_iface: before $(uci show prplmesh 2>/dev/null | grep '\.hostap_iface=' | tr '\n' ' ')"
        fi
        if _update_radio_hostap_iface_once; then
                if is_openwrt_os; then
                logger -t "${NAME}" -p daemon.debug \
                    "update_radio_hostap_iface: completed $(uci show prplmesh 2>/dev/null | grep '\.hostap_iface=' | tr '\n' ' ')"
                fi
                return 0
        fi

        logger -t "${NAME}" -p daemon.warn \
            "dummy_ap derived for one or more radios in update_radio_hostap_iface; polling every 5s (60s timeout) for hostapd to derive valid ifaces"

        elapsed=0
        while [ $elapsed -lt 60 ]; do
                sleep 5
                elapsed=$((elapsed + 5))

                if _update_radio_hostap_iface_once; then
                        logger -t "${NAME}" -p daemon.info \
                            "hostapd ifaces ready after ${elapsed}s, no dummy_ap remaining"
                        return 0
                fi
                logger -t "${NAME}" -p daemon.warn \
                    "Still dummy_ap after ${elapsed}s, retrying..."
        done

        logger -t "${NAME}" -p daemon.warn \
            "dummy_ap still derived for one or more radios after ${elapsed}s; confirming dummy_ap"
}

_update_radio_hostap_iface_once() {

    dummy_ap_derived=0

    freq_list="$FREQ_2G $FREQ_5GL $FREQ_6G $FREQ_5GH"
    i=0
    used_idx_list=""   # track phy indices already assigned to a band

    prplmesh_radio_2g=0
    prplmesh_radio_5g=1
    prplmesh_radio_6g=2
    prplmesh_radio_5gh=3

    for freq in $freq_list; do

        #Call once; check exit status first
        if out="$(get_prim_ifname "$freq")"; then
            # Expecting space-separated: "<radio_id> <ifname>"
            set -- $out
            radio_id=$1
            ifname=$2
            if is_openwrt_os; then
            logger -t "${NAME}" -p daemon.debug \
                "update_radio_hostap_iface: freq=$freq radio_id=$radio_id resolved_ifname=$ifname"
            fi
        else
            if is_openwrt_os; then
            current_ifname="$(uci -q get "prplmesh.radio${i}.hostap_iface" 2>/dev/null)"
            logger -t "${NAME}" -p daemon.warn \
                "update_radio_hostap_iface: freq=$freq discovery failed; radio${i}.hostap_iface remains ${current_ifname:-unset}"
            fi
            echo "Skipping freq=$freq: get_prim_ifname failed" >&2
            # Move to next frequency on failure
            i=$((i + 1))
            continue
        fi

        # Duplicate-idx check: on triband devices a single full-band 5G radio
        # covers both FREQ_5GL and FREQ_5GH ranges.  If this phy idx was already
        # claimed by an earlier band, skip this band entirely.
        if echo "$used_idx_list" | grep -qw "$radio_id"; then
            echo "freq=$freq maps to idx=$radio_id already assigned; skipping" >&2
            i=$((i + 1))
            continue
        fi
        used_idx_list="$used_idx_list $radio_id"

        echo "radio_id=$radio_id, ifname=$ifname"

        # No valid hostapd control interface for this ifname (hostapd not
        # actually up on it) means the radio can't be managed; treat it the
        # same as dummy_ap so radio_disable gets set below.
        if [ "$ifname" != "dummy_ap" ] && ! hostapd_ctrl_path_valid "$ifname"; then
            echo "No valid hostapd control path in /var/run/hostapd/ for $ifname, defaulting ifname to dummy_ap" >&2
            ifname="dummy_ap"
        fi

        [ "$ifname" = "dummy_ap" ] && dummy_ap_derived=1

        eval "radio${i}_ifname=\"$ifname\""

        echo "radio${i}_ifname = $ifname (Frequency: $freq)"

        #Check if prplmesh.radioX section exists
        if [ -z "$(uci show "prplmesh.radio${i}" 2>/dev/null)" ]; then
            echo "Creating prplmesh.radio${i} section"
            uci set prplmesh.radio${i}=wifi-device

            # Add default options for new section
            uci set prplmesh.radio${i}.hostap_iface="$ifname"
            uci set prplmesh.radio${i}.sta_iface="dummy_sta"
            uci set prplmesh.radio${i}.dcs_enable="0"
            uci set prplmesh.radio${i}.dcs_interval_sec="15"
            uci set prplmesh.radio${i}.dcs_dwell_msec="40"
            uci set prplmesh.radio${i}.dcs_refresh_sec="86400"
        fi

        # radio_disable reflects whether hostapd currently has a valid interface for
        # this radio: get_prim_ifname() already returns "dummy_ap" whenever the
        # hostapd-phy00.$idx.conf file is missing or has no usable interface= line.
        # Re-evaluated every run so it tracks hostapd's live state.
        case "$ifname" in
            dummy_ap) uci set prplmesh.radio${i}.radio_disable="1" ;;
            *)        uci set prplmesh.radio${i}.radio_disable="0" ;;
        esac

        # Set channel pool, freq_band, channel and bandwidth based on band (example logic).
        # Applied every run (not just on section creation) so pre-existing sections
        # created before these options existed still get backfilled.
        case $i in
            "$prplmesh_radio_2g")
                uci set prplmesh.radio${i}.dcs_channel_pool="1,6,11"
                uci set prplmesh.radio${i}.freq_band="2g"
                uci set prplmesh.radio${i}.channel="1"
                uci set prplmesh.radio${i}.bandwidth="20MHz"
                ;;
            "$prplmesh_radio_5g")
                uci set prplmesh.radio${i}.dcs_channel_pool="36-48,149-165"
                uci set prplmesh.radio${i}.freq_band="5g"
                uci set prplmesh.radio${i}.channel="36"
                uci set prplmesh.radio${i}.bandwidth="80MHz"
                ;;
            "$prplmesh_radio_5gh")
                uci set prplmesh.radio${i}.dcs_channel_pool="36-48,149-165"
                uci set prplmesh.radio${i}.freq_band="5g"
                uci set prplmesh.radio${i}.channel="149"
                uci set prplmesh.radio${i}.bandwidth="80MHz"
                ;;
            "$prplmesh_radio_6g")
                uci set prplmesh.radio${i}.dcs_channel_pool="2-233"
                uci set prplmesh.radio${i}.freq_band="6g"
                uci set prplmesh.radio${i}.channel="1"
                uci set prplmesh.radio${i}.bandwidth="80MHz"
                ;;
        esac

        uci set prplmesh.radio${i}.hostap_iface="$ifname"
        uci set prplmesh.radio${i}.radio_id="$radio_id"
        derive_radio_macaddr "$radio_id" "radio${i}"

        i=$((i+1))
    done

    uci commit prplmesh

    if is_openwrt_os; then
        logger -t "${NAME}" -p daemon.debug \
            "update_radio_hostap_iface: committed $(uci show prplmesh 2>/dev/null | grep '\.hostap_iface=' | tr '\n' ' ')"
    fi

    return $dummy_ap_derived

}

update_radio_sta_iface() {

    if is_openwrt_os; then
        iw_output="$(iw phy 2>&1)"
        iw_rc=$?
        iw_bytes="$(printf '%s\n' "$iw_output" | wc -c)"
        iw_idx_count="$(printf '%s\n' "$iw_output" | grep -c 'Idx' 2>/dev/null)"
        logger -t "${NAME}" -p daemon.debug \
            "update_radio_sta_iface: iw phy rc=$iw_rc bytes=$iw_bytes idx_lines=$iw_idx_count"
        if [ "$iw_rc" -ne 0 ]; then
            logger -t "${NAME}" -p daemon.warn \
                "update_radio_sta_iface: iw phy failed output=$(printf '%s' "$iw_output" | tr '\n' ' ' | cut -c1-240)"
        elif [ "$iw_idx_count" -eq 0 ] 2>/dev/null; then
            logger -t "${NAME}" -p daemon.warn \
                "update_radio_sta_iface: iw phy succeeded but returned no PHY index; output=$(printf '%s' "$iw_output" | tr '\n' ' ' | cut -c1-240)"
        fi
        num_of_bands="$(printf '%s\n' "$iw_output" | awk '/Idx/ {count++} END {print count}')"
    else
        num_of_bands=$(iw phy | awk '/Idx/ {count++} END {print count}')
    fi
    echo "Total available bands: $num_of_bands"


    if [ -z "$num_of_bands" ] || [ "$num_of_bands" -eq 0 ] 2>/dev/null; then
        echo "Total available bands: 0"
        echo "No bands detected. Exiting."
        return 0
    fi
    updated_radios=""

    for section in $(uci show wireless | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
        mode=$(uci get wireless.$section.mode 2>/dev/null)
        ifname=$(uci get wireless.$section.ifname 2>/dev/null)
        device=$(uci get wireless.$section.device 2>/dev/null)
        disabled=$(uci get wireless.$section.disabled 2>/dev/null)

        # Process only if mode=sta and disabled is NOT 1
        if [ "$mode" = "sta" ] && [ "$disabled" != "1" ] ; then
                # Get corresponding radio value from wifi-device section
                radio=$(uci get wireless.$device.radio 2>/dev/null)

                prpl_radio_idx="$(update_sta_iface_in_prplmesh_config "$radio" "$ifname")"

                if [ -n "$prpl_radio_idx" ]; then
                   echo "STA Interface: $ifname | Device: $device | Radio: $radio | Prpl_Radio: $prpl_radio_idx"
                   updated_radios="$updated_radios $prpl_radio_idx"
                fi
        fi
    done


    # Add dummy sta_iface for radios not updated
    for r in $(seq 0 $((num_of_bands-1))); do
        if ! echo "$updated_radios" | grep -qw "$r"; then
            uci set prplmesh.radio${r}.sta_iface="dummy_sta"
            echo "Added dummy STA for radio$r"
        fi
    done

    uci commit prplmesh
}

update_sta_iface_in_prplmesh_config()
{

    local radio="$1"
    local sta_iface="$2"

    echo "radio_id=$radio" >&2
    echo "sta_iface=$sta_iface" >&2

    for section in $(uci show prplmesh | grep "=wifi-device" | cut -d. -f2 | cut -d= -f1); do
        radio_id=$(uci get prplmesh.$section.radio_id 2>/dev/null)

        if [ "$radio_id" = "$radio" ]; then
            uci set "prplmesh.$section.sta_iface=$sta_iface"
            uci commit prplmesh
            echo "Updated prplmesh.$section.sta_iface=$sta_iface" >&2

            #Extract prplmesh radio id: radio0 -> 0
            local prpl_radio_idx="${section#radio}"
            echo "$prpl_radio_idx"
            break
        fi
    done
}

start_service() {
        readiness_done=0
        if is_openwrt_os; then
        # prplmesh-agent is an implementation detail of prplmesh_utils.  It is
        # installed with the package and may also have an old rc.d entry, but it
        # must not independently launch an agent during boot.  At that point
        # prplmesh has not updated the radio configuration yet and all entries
        # can still be dummy_ap.  That early instance races the real startup.
        if [ ! -e "$AGENT_START_REQUEST" ] && [ ! -e "$AGENT_READY_REQUEST" ]; then
                logger -t "$NAME" -p daemon.info \
                    "Ignoring unsolicited start; waiting for prplmesh_utils"
                return 0
        fi
        # Keep the handoff markers while procd may invoke start_service more
        # than once during the same startup.  The parent clears stale state
        # before beginning the next startup sequence.
        readiness_done=0
        if [ -e "$AGENT_READY_REQUEST" ]; then
                readiness_done=1
                logger -t "$NAME" -p daemon.info \
                        "Readiness completed by prplmesh; skipping duplicate checks"
        fi

        # Match both the launcher shell and the actual binary.  pidof with the
        # absolute binary path is not reliable on BusyBox and missed the active
        # launcher in the failing install sequence.
        if pgrep -f '[/]beerocks_agent_launcher.sh' >/dev/null 2>&1 || \
                pgrep -x beerocks_agent >/dev/null 2>&1; then
                logger -t "$NAME" -p daemon.info \
                    "beerocks_agent is already running, exiting..."
                return 0
        fi
        else
                if pidof "$BEEROCKS_AGENT_BIN" >/dev/null; then
                        logger -t "$NAME" -p daemon.info "$BIN is already running, exiting..."
                        exit 0
                fi
        fi

        if [ $(uci -q get prplmesh.config.enable) == "1" ]; then
                if [ "$readiness_done" -eq 0 ]; then
                        if is_openwrt_os; then
                                iw_phy_ready_poll || {
                                        logger -t "${NAME}" -p daemon.err "iw phy readiness failed, aborting start"
                                        exit 1
                                }
                                logger -t "${NAME}" -p daemon.info "Detected OpenWrt - running hostapd global ready poll"
                                hostapd_global_ready_poll || {
                                        logger -t "${NAME}" -p daemon.err "hostapd global ctrl interface never became ready, aborting start"
                                        exit 1
                                }

                                # prplmesh performs update_radio_hostap_iface() before
                                # starting the transport and invoking this service.
                                # Do not repeat its dummy_ap polling here; a radio
                                # intentionally left as dummy_ap must be accepted by
                                # the agent rather than delaying agent startup again.
                        else
                                logger -t "${NAME}" -p daemon.info "$(grep '^NAME=' /etc/os-release 2>/dev/null) - skipping hostapd global ready poll"
                        fi

                        wlan_ready_poll || {
                                logger -t "${NAME}" -p daemon.warn "Timeout waiting for WLAN ready!"
                                exit 1
                        }

                        update_radio_sta_iface
                fi

                rm /tmp/beerocks/mld_pair_entrant.txt

                procd_open_instance
                procd_set_param command "$PRPLMESH_DIR/scripts/beerocks_agent_launcher.sh"
                if ! is_openwrt_os; then
                        procd_set_param respawn
                fi
                procd_set_param stdout 1
                procd_set_param stderr 1
                procd_set_param term_timeout 1
                procd_close_instance
        else
                logger -t "${NAME}" -p daemon.warn "prplMesh is disabled (prplmesh.config.enable=0), skipping..."
                exit 0
        fi

}

stop_service(){
        stop_agent
}
