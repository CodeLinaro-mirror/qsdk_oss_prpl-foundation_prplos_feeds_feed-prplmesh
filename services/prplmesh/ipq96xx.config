# Bundle packages for prplMesh dependencies
CONFIG_PACKAGE_base-libs-bundle=y
CONFIG_PACKAGE_amx-libs-bundle=y
CONFIG_PACKAGE_net-services-bundle=y
CONFIG_PACKAGE_prplmesh=y
CONFIG_PACKAGE_qmesh-cs=y
# CONFIG_FEATURE_IPQ_IOT_SUPPORT is not set

CONFIG_PACKAGE_qmesh-steering-app=y
CONFIG_PACKAGE_qmesh_sub_system_handler=y
